/*
# San Francisco

Declare's own look — named for where Declare is made — and the theme a widget
renders when nothing provides one: `control.declare` defaults `theme` to
`SanFrancisco` (the light record), so an app that never mentions a theme is San
Francisco light, always. These declarations are the preset itself, written in the
language; the runtime serves them by name.

A record is **complete**, not a delta: every token the standard library consults is
stated, so a preset reads whole with nothing to chase. Hover and pressed step
darker in light and lighter in dark, for controls and the accent alike.
*/

theme SanFrancisco [
    background = #F4F6FA, surface = #FFFFFF, line = #DBE1E9,
    text = #1B2733, textMuted = #6C7A88, textFaint = #AAB4BE,
    accent = #2E6FE0, accentTextColor = #FFFFFF, accentHovered = #2A66CE, accentPressed = #275DBC,
    control = #E7EBF1, controlHovered = #DCE0E6, controlPressed = #CED2D7, controlSelected = #D3E2FC,
    focusRingStyle = "both", controlCornerRadius = 7,
    tooltipFill = #1B2733, tooltipTextColor = #F4F6FA,
    menuCornerRadius = 8, menuShadow = shadow(0, 10, 40, #00000038), menuHighlightFill = gradient(#3E79E8, #2563D6),
    scrimFill = #10151B, scrimOpacity = 0.32, error = #C23528
    ]


theme SanFranciscoDark [
    background = #0F1620, surface = #18212C, line = #2A3642,
    text = #E7EEF2, textMuted = #9DB0BC, textFaint = #556673,
    accent = #4C8DFF, accentTextColor = #FFFFFF, accentHovered = #5E98FF, accentPressed = #70A4FF,
    control = #223040, controlHovered = #2B3949, controlPressed = #364455, controlSelected = #1F3B54,
    focusRingStyle = "both", controlCornerRadius = 7,
    tooltipFill = #E7EEF2, tooltipTextColor = #0F1620,
    menuCornerRadius = 8, menuShadow = shadow(0, 10, 40, #00000066), menuHighlightFill = gradient(#5A97FF, #3F7FEF),
    scrimFill = #000000, scrimOpacity = 0.5, error = #FF7A6E
    ]
