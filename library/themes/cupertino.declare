/*
# Cupertino

The compact-desktop record — a preset is data riding one machinery, never a
code path: Cupertino metrics — compact controls, 6px
radii, the tight hairline focus halo hugging the control (gap 0), a muted
disabled treatment. A Mac control does not answer a passing pointer, so the
hover tones equal the rest tones (`controlHovered`, `accentHovered`); pressing
darkens a control in light and lightens it in dark. The type stack (the
platform UI face via -apple-system) is the consuming app's `fontFamily`, not a
theme token.
*/

theme Cupertino [
    background = #F5F5F7, surface = #FFFFFF, line = #C6C6C8,
    text = #1D1D1F, textMuted = #6E6E73, textFaint = #AAB4BE,
    accent = #007AFF, accentTextColor = #FFFFFF, accentHovered = #007AFF, accentPressed = #0066D6,
    control = #FFFFFF, controlHovered = #FFFFFF, controlPressed = #E5E5E5, controlSelected = #E8F0FE,
    focusRingStyle = "both",
    controlCornerRadius = 6, buttonCornerRadius = 6, fieldCornerRadius = 6, fieldPadding = 7,
    buttonHeight = 28, switchWidth = 40, switchHeight = 24,
    focusRingWidth = 3.5, focusRingGap = 0,
    checkboxSize = 14, checkboxCornerRadius = 3.5, disabledOpacity = 0.5,
    tooltipFill = #F0F0F0, tooltipTextColor = #1D1D1F, tooltipStrokeColor = #C6C6C8,
    tooltipPlacement = "pointer", tooltipDelay = 1000, tooltipFontSize = 11,
    menuCornerRadius = 13, menuRowHeight = 24, menuShadow = shadow(0, 12, 44, #00000040), menuHighlightFill = gradient(#1F86FF, #0068EE),
    menuFill = #F9F9FBDB, menuBackdrop = frost(24, 1.5), menuTitleHighlightFill = #FFFFFF24,   // frosted menu panel (true backdrop blur, saturation boosted for the material read) + the open/nav title highlight (subtle translucent shape so white title text stays legible)
    scrimFill = #000000, scrimOpacity = 0.12, error = #C93429,
    dialogWidth = 260, dialogButtonLayout = "stack", dialogTextAlign = "center", dialogTitleFontSize = 13, dialogBodyFontSize = 12,
    buttonStrokeColor = #C6C6C8
    ]


theme CupertinoDark [
    background = #1E1E1E, surface = #2C2C2E, line = #48484A,
    text = #F2F2F7, textMuted = #98989D, textFaint = #AAB4BE,
    accent = #0A84FF, accentTextColor = #FFFFFF, accentHovered = #0A84FF, accentPressed = #3B9DFF,
    control = #3A3A3C, controlHovered = #3A3A3C, controlPressed = #4F4F51, controlSelected = #1C3D5F,
    focusRingStyle = "both",
    controlCornerRadius = 6, buttonCornerRadius = 6, fieldCornerRadius = 6, fieldPadding = 7,
    buttonHeight = 28, switchWidth = 40, switchHeight = 24,
    focusRingWidth = 3.5, focusRingGap = 0,
    checkboxSize = 14, checkboxCornerRadius = 3.5, disabledOpacity = 0.5,
    tooltipFill = #2C2C2E, tooltipTextColor = #F2F2F7, tooltipStrokeColor = #48484A,
    tooltipPlacement = "pointer", tooltipDelay = 1000, tooltipFontSize = 11,
    menuCornerRadius = 13, menuRowHeight = 24, menuShadow = shadow(0, 12, 44, #00000073), menuHighlightFill = gradient(#2B8FFF, #0A6FEB),
    menuFill = #2C2C2EE6, menuBackdrop = frost(24, 1.5), menuTitleHighlightFill = #FFFFFF26,   // frosted dark menu panel (true backdrop blur) + title highlight
    scrimFill = #000000, scrimOpacity = 0.3, error = #FF6961,
    dialogWidth = 260, dialogButtonLayout = "stack", dialogTextAlign = "center", dialogTitleFontSize = 13, dialogBodyFontSize = 12,
    buttonStrokeColor = #5A5A5E
    ]
