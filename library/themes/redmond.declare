/*
# Redmond

The Fluent-fidelity record (Windows 11): 4px radii on everything, the
Windows accent blue (light-on-dark flips to the pale #4CC2FF with dark
text on it), compact 32px buttons, the 40×20 toggle with its 12px
off-thumb, the round slider grabber with the accent dot
(`sliderHandleStyle = "dot"`), and Fluent's two-tone focus **rectangle** — a 2px
outer stroke over a 1px inner separator (`focusRingInnerWidth`), black
over white in light, white over black in dark. Windows focus does not
fly: `focusRingStyle = "rest"` — the indicator appears in place and stays. An
accent button's hover and pressed tones are Fluent's secondary and tertiary
accent fills — the accent at 90% and 80% over the page.
Segoe UI is the consuming app's `fontFamily`, not a theme token.
*/

theme Redmond [
    background = #F3F3F3, surface = #FFFFFF, line = #D1D1D1,
    text = #1B1B1B, textMuted = #5D5D5D, textFaint = #9A9A9A,
    accent = #0067C0, accentTextColor = #FFFFFF, accentHovered = #1875C5, accentPressed = #3183CA,
    control = #FBFBFB, controlHovered = #EFEFEF, controlPressed = #E1E1E1, controlSelected = #C7DEF1,
    focusRingStyle = "rest",
    controlCornerRadius = 4, buttonCornerRadius = 4, fieldCornerRadius = 4, fieldPadding = 10,
    buttonHeight = 32, switchWidth = 40, switchHeight = 20, switchThumbOffSize = 12,
    focusRingWidth = 2, focusRingGap = 0, focusRingInnerWidth = 1,
    focusRingColor = #000000, focusRingInnerColor = #FFFFFF,
    sliderHandleStyle = "dot",
    checkboxSize = 20, checkboxCornerRadius = 4, disabledOpacity = 0.36,
    tooltipFill = #FBFBFB, tooltipTextColor = #1B1B1B, tooltipStrokeColor = #D1D1D1,
    tooltipPlacement = "above", tooltipDelay = 1000,
    menuCornerRadius = 8, menuShadow = shadow(0, 8, 16, #00000030), menuHighlightFill = #F0F0F0, menuHighlightTextColor = #1B1B1B,
    scrimFill = #000000, scrimOpacity = 0.3, error = #C42B1C,
    dialogWidth = 448, dialogButtonLayout = "fill", dialogTitleFontSize = 20, dialogBodyFontSize = 14,
    buttonStrokeColor = #D1D1D1
    ]


theme RedmondDark [
    background = #202020, surface = #2B2B2B, line = #404040,
    text = #FFFFFF, textMuted = #C5C5C5, textFaint = #8B8B8B,
    accent = #4CC2FF, accentTextColor = #000000, accentHovered = #48B2E9, accentPressed = #43A2D2,
    control = #343434, controlHovered = #3D3D3D, controlPressed = #484848, controlSelected = #2B4553,
    focusRingStyle = "rest",
    controlCornerRadius = 4, buttonCornerRadius = 4, fieldCornerRadius = 4, fieldPadding = 10,
    buttonHeight = 32, switchWidth = 40, switchHeight = 20, switchThumbOffSize = 12,
    focusRingWidth = 2, focusRingGap = 0, focusRingInnerWidth = 1,
    focusRingColor = #FFFFFF, focusRingInnerColor = #000000,
    sliderHandleStyle = "dot",
    checkboxSize = 20, checkboxCornerRadius = 4, disabledOpacity = 0.36,
    tooltipFill = #2C2C2C, tooltipTextColor = #FFFFFF, tooltipStrokeColor = #404040,
    tooltipPlacement = "above", tooltipDelay = 1000,
    menuCornerRadius = 8, menuShadow = shadow(0, 8, 16, #00000059), menuHighlightFill = #3D3D3D, menuHighlightTextColor = #FFFFFF,
    scrimFill = #000000, scrimOpacity = 0.5, error = #FF99A4,
    dialogWidth = 448, dialogButtonLayout = "fill", dialogTitleFontSize = 20, dialogBodyFontSize = 14,
    buttonStrokeColor = #505050
    ]
