/*
# ProgressBar

Display-only bounded number — the read-only sibling of Slider (same `value`/
`min`/`max` vocabulary, no interaction, no `input`). Restyle by theme; set
`width` at the use site (220 by default).

## value
Where the bar sits, in the units you choose. Clamped into `min`…`max` for display,
so a value outside the range renders full or empty rather than overflowing.

## min
The value that reads as empty. Defaults to 0.

## max
The value that reads as full. Defaults to 100 — set it to your own total and pass
raw counts as `value` rather than converting to a percentage yourself.

## indeterminate
Something is under way and how far along it is unknown — a request in flight, a
search running. The bar then sweeps a short segment across the track instead of
filling to `value`, and reports no value to assistive technology. Under the
person's reduced-motion setting the segment holds still, as a faint full bar.
Set it from the state that is under way: `indeterminate = { app.saving.loading }`.

## fill
The track wears the quiet control tint; the filled part is the bar's own child in the accent, so a theme restyles both at once.

## height
The bar's thickness, from the theme's `progressBarHeight` (8 by default).

## cornerRadius
Fully rounded: half the height, at any thickness.

## _sweep
**Internal.** Where the indeterminate segment is along its sweep, 0 to 1.

## _still
**Internal.** The person asks for reduced motion: the indeterminate bar holds still.

## accessibilityValue
Follows `value`; none while `indeterminate`.

## accessibilityMin
Follows `min`; none while `indeterminate`.

## accessibilityMax
Follows `max`; none while `indeterminate`.
*/

class ProgressBar [
    width = 220, height = { provided("theme").progressBarHeight }, cornerRadius = { height / 2 },
    value: number = 0,
    min:   number = 0,
    max:   number = 100,
    indeterminate: boolean = false,
    accessibilityRole = progress,
    accessibilityValue = { indeterminate ? null : value },
    accessibilityMin = { indeterminate ? null : min },
    accessibilityMax = { indeterminate ? null : max },

    fill = { provided("theme").trackFill ?? provided("theme").control },
    clip = true,

    // the sweep: 0 → 1 carries the segment from just off the start to just off the end

    _sweep: number = 0,
    _still: boolean = { provided("accessibilitySettings")?.reduceMotion === true },
    _sweeping: Animator [ attribute = _sweep, from = 0, to = 1, duration = 1400, motion = easeBoth,
        repeat = { Infinity }, started = { classroot.indeterminate && !classroot._still } ],

    _bar: View [ height = 100%, cornerRadius = { parent.height / 2 }, fill = { provided("theme").accent },
        opacity = { classroot.indeterminate && classroot._still ? 0.45 : 1 },
        width = { !classroot.indeterminate ? parent.width * Math.max(0, Math.min(1, (value - min) / ((max - min) || 1)))
            : classroot._still ? parent.width : parent.width * 0.3 },
        x = { classroot.indeterminate && !classroot._still ? parent.width * 1.3 * classroot._sweep - parent.width * 0.3 : 0 } ]
    ]
