/*
# Sheet

A modal panel attached to an edge of its context — a form, a detail, a set of choices. On
a phone-width screen it rises from the bottom, and a downward swipe on its handle puts it
away; on a wide screen it slides in from the end edge (`edge = "end"`) or, for a sheet whose
edge is the bottom, floats as a card in the middle. A sheet at the start edge
(`edge = "start"`) is a navigation drawer: it slides in from the start edge at every width,
and a swipe back toward that edge on its trailing edge puts it away. Behind it the context
dims; a press there closes the sheet, and nothing behind it scrolls while it is open. Tab stays inside it;
Esc closes it; focus goes to its first control when it opens and back when it closes.

```declare
App [ width = 640, height = 420,
    Button [ x = 20, y = 20, label = "New entry…", onClick() { app.entry.show() } ],
    entry: Sheet [ edge = "end",
        Text [ fontWeight = bold, text = "New entry" ],
        TextInput [ width = 100%, accessibilityLabel = "Title" ],
        Button [ label = "Save", primary = true, onClick() { app.entry.close() } ]
        ]
    ]
```

## edge
Which edge it belongs to: `"bottom"` (the default — on a wide screen it floats as a centered
card), `"end"` (on a wide screen it slides in at the end edge, full height), or `"start"` (it
slides in at the start edge, full height, at every width — a drawer). On a phone-width screen
a bottom or end sheet rises from the bottom.

## narrow
Whether the screen is phone-width — narrower than 600 by default.

## presentation
How it presents now: `"bottom"`, `"end"`, `"start"` or `"center"`.

## sheetWidth
Its width as a side sheet, a drawer or a floating card.

## dragY
How far its handle has been pulled down — a swipe past a quarter of its height puts it away.

## dragX
How far a drawer has been swiped back toward the start edge by its trailing edge — a swipe
past a quarter of its width puts it away.

## hostW
The width of the layer it paints in: its window's, or the browser window's — not the
App's, which on a page that scrolls is as tall as the page.

## hostH
The height of the layer it paints in: its window's, or the browser window's.

## width
The whole width at the bottom; `sheetWidth` at the end edge or as a card; `sheetWidth` at the
start edge too, leaving at least 56 of its context showing to press.

## height
Its content's height, kept inside its layer; the full height at the end or start edge.

## x
At the end or start edge as it slides in, a drawer less any swipe back; centered as a card.

## y
Risen from the bottom, less any pull on its handle; centered as a card; at the top at the
end or start edge.

## opacity
Its open blend, as a card; a sheet at an edge slides rather than fades.

## widePresentation
What the sheet is when the host has room to spare: an `edge = end` sheet stays at the end,
any other is centred. `presentation` takes it unless the sheet comes from the start or the host is
`narrow`.

## keyboardH
How far an on-screen keyboard reaches into this sheet's program (`app.keyboardHeight`), so a
bottom sheet rises above it; 0 for a sheet hosted in another program's layer.

## footY
Where the sheet's room ends: the host's height less the keyboard.

## presentationMargin
The room the sheet leaves beside it in its current `presentation`: more for a centred or start
sheet, none for an end or bottom one.

## restX
Where a sheet that does not slide in from a side rests across: centred, or 0 for a bottom
sheet.
*/

include [ "floating.declare" ]

class Sheet extends Floating [
    accessibilityRole = dialog,
    kind = "modal",
    sharesProgram = false,
    pressPolicy = "dismiss",
    scrollPolicy = "block",
    takesFocus = true,
    focusScope = modal,
    defaultPlacement = body,

    edge: "bottom" | "end" | "start" = "bottom",
    narrow: boolean = { this.hostW < 600 },
    widePresentation: string = { this.edge == "end" ? "end" : "center" },       // what it is with room to spare
    presentation: string = { this.edge == "start" ? "start" : this.narrow ? "bottom" : this.widePresentation },
    sheetWidth: number = { this.presentation == "end" ? 420 : this.presentation == "start" ? 320 : 520 },
    dragY: number = 0,
    dragX: number = 0,

    hostW: number = { this.host != null ? this.host.width : app.hostWidth > 0 ? app.hostWidth : app.width },     // a window's, else the browser window's
    hostH: number = { this.host != null ? this.host.height : app.hostHeight > 0 ? app.hostHeight : app.height },
    keyboardH: number = { this._hostedLayer ? 0 : app.keyboardHeight },     // a bottom sheet rises above an on-screen keyboard (its own program's)
    footY: number = { this.hostH - this.keyboardH },

    presentationMargin: number = { ({ center: 48, start: 56 })[this.presentation] ?? 0 },     // the room it leaves beside it
    width = { this.presentation == "bottom" ? this.hostW : Math.min(this.sheetWidth, this.hostW - this.presentationMargin) },
    height = { this.presentation == "end" || this.presentation == "start" ? this.hostH : Math.min(this.body.contentHeight + (this.presentation == "bottom" ? 20 : 0), this.presentation == "bottom" ? this.footY - 24 : this.hostH - 48) },
    restX: number = { this.presentation == "bottom" ? 0 : (this.hostW - this.width) / 2 },     // a sheet that does not slide in from a side
    x = { this.presentation == "end" ? this.hostW - this.width * this.openT
        : this.presentation == "start" ? this.width * (this.openT - 1) - this.dragX
        : this.restX },
    y = { this.presentation == "bottom" ? this.footY - this.height * this.openT + this.dragY
        : this.presentation == "center" ? (this.hostH - this.height) / 2 + 16 * (1 - this.openT) : 0 },
    opacity = { this.presentation == "center" ? this.openT : 1 },

    // a sheet put away by a swipe opens next time at rest: reset here, when it
    // closes, and not in `closed()`, which is the use site's to write

    _dragReset: Node [
        open: boolean = { classroot.shown },
        trackChanges = ["open"],
        onChange() { if (!open) { classroot.dragY = 0; classroot.dragX = 0 } }
        ],

    scrim: View [ pointerEvents = "none",
        x = { -classroot.x }, y = { -classroot.y },
        width = { classroot.hostW }, height = { classroot.hostH },
        fill = { provided("theme").scrimFill },
        opacity = { (provided("theme").scrimOpacity) * classroot.openT } ],

    panel: View [ width = 100%, height = { parent.height + (classroot.presentation == "bottom" ? 40 + classroot.keyboardH : 0) },
        cornerRadius = { classroot.presentation == "bottom" ? [(provided("theme").sheetCornerRadius), (provided("theme").sheetCornerRadius), 0, 0] : classroot.presentation == "end" || classroot.presentation == "start" ? 0 : (provided("theme").sheetCornerRadius) - 2 },
        fill = { provided("theme").surface },
        shadow = { provided("theme").sheetShadow } ],

    // the bottom sheet's handle: pull it down past a quarter of the sheet to put it away

    handle: View [ visible = { classroot.presentation == "bottom" }, width = 100%, height = 20, claim = y,
        bar: View [ x = center, y = 7, width = 36, height = 5, cornerRadius = 3, fill = { provided("theme").line } ],
        onPointerMove(e: PointerEvent) { if (e.deltaY != 0 || classroot.dragY != 0) classroot.dragY = Math.max(0, e.deltaY) },
        onPointerUp(e: PointerUpEvent) {
            if (!e.canceled && classroot.dragY > classroot.height / 4) classroot.close()
            else classroot.dragY = 0
            }
        ],

    body: View [ y = { classroot.presentation == "bottom" ? 20 : 0 }, width = 100%,
        height = { classroot.height - this.y },
        scrolls = y,
        padding = { classroot.presentation == "bottom" ? [4, 18, 24, 18] : 24 },
        layout: SimpleLayout [ axis = y, spacing = 12 ]
        ],

    // the drawer's grip, its trailing edge within the body's inset: swipe it back
    // toward the start edge past a quarter of the drawer to put it away

    grip: View [ visible = { classroot.presentation == "start" }, x = { classroot.width - 24 }, y = 0, width = 24, height = 100%, claim = x,
        onPointerMove(e: PointerEvent) { if (e.deltaX != 0 || classroot.dragX != 0) classroot.dragX = Math.max(0, -e.deltaX) },
        onPointerUp(e: PointerUpEvent) {
            if (!e.canceled && classroot.dragX > classroot.width / 4) classroot.close()
            else classroot.dragX = 0
            }
        ]
    ]
