/*
# Popover

A bubble anchored to a view, holding your own content — a picker, a few settings, an info
card. It opens next to its anchor (below, else above where there is no room), follows it as
it moves, and closes when you press anywhere outside it, the press going on to what you
pressed. On a phone-width screen it presents as a sheet rising from the bottom instead.

```declare
App [ width = 420, height = 240,
    b: Button [ x = 20, y = 20, label = "Font…", onClick() { app.pick.showFor(this) } ],
    pick: Popover [
        Text [ text = "Size" ],
        Slider [ width = 180 ]
        ]
    ]
```

It is a `Floating`: it takes focus on opening (its first control) and gives it back on
closing; Tab stays inside it; Esc closes it.

## anchorTo
What it opens next to when shown without one — `showFor(v)` names it per opening instead.

## placement
Which side it prefers: `"below"` (the default) or `"above"`; it takes the other side when
the preferred one has no room.

## gap
The space between the anchor and the bubble.

## asSheet
Whether it presents as a bottom sheet — by default when the screen is narrower than 560.
As a sheet, a press outside it closes it and goes no further.

## anchorView
The view it is anchored to now: the opener, else `anchorTo`.

## ab
The anchor's box in the popover's frame.

## below
Whether it sits below its anchor now.

## hostW
The width of the layer it paints in: its window's, or the browser window's — not the
App's, which on a page that scrolls is as tall as the page.

## hostH
The height of the layer it paints in: its window's, or the browser window's.

## roomBelow
Whether it fits below its anchor.

## roomAbove
Whether it fits above its anchor.

## pressPolicy
`dismissAndDeliver` — a press outside closes it and goes on; `dismiss` as a sheet.

## width
Its content's width; the whole width as a sheet.

## height
Its content's height.

## x
Centered on its anchor, kept inside its layer.

## y
Below its anchor, or above it; risen from the bottom as a sheet.

## opacity
Its open blend, as a bubble.

## scale
It grows from slightly small as it opens, as a bubble — at its program's scale where it opens
in a host's layer.

## rotation
Its program's turn where it opens in a host's layer; none as a sheet.

## pivotX
It grows from its middle.

## pivotY
It grows from its anchor's side.

## accessibilityRole
A dialog: it takes the focus and holds it while it is open, as a dialog does.

## accessibilityLabel
The name of what opened it, so a popover opened from "Text size" is the "Text size" dialog.
*/

include [ "floating.declare" ]

class Popover extends Floating [
    accessibilityRole = dialog,
    accessibilityLabel = { this.opener == null ? "" : "" + ((this.opener as any).accessibilityLabel || (this.opener as any).label || "") },
    kind = "floating",
    pressPolicy = { this.asSheet ? "dismiss" : "dismissAndDeliver" },
    scrollPolicy = "allow",
    takesFocus = true,
    focusScope = modal,
    defaultPlacement = body,

    anchorTo: View? = null,
    placement: string = "below",
    gap: number = 8,
    asSheet: boolean = { app.width < 560 },

    anchorView: View? = { this.opener != null ? this.opener : this.anchorTo },
    ab: object = { this.anchorBox(this.anchorView) },
    hostW: number = { this.host != null ? this.host.width : app.hostWidth > 0 ? app.hostWidth : app.width },     // a window's, else the browser window's
    hostH: number = { this.host != null ? this.host.height : app.hostHeight > 0 ? app.hostHeight : app.height },
    roomBelow: boolean = { this.ab.y + this.ab.h + this.gap + this.height <= this.hostH - 8 },
    roomAbove: boolean = { this.ab.y - this.gap - this.height >= 8 },
    below: boolean = { this.placement == "above" ? !this.roomAbove && this.roomBelow : this.roomBelow || !this.roomAbove },

    width = { this.asSheet ? this.hostW : this.body.width },
    height = { this.body.height },
    x = { this.asSheet ? 0 : Math.max(8, Math.min(this.hostW - this.width - 8, this.ab.x + this.ab.w / 2 - this.width / 2)) },
    y = { this.asSheet ? this.hostH - this.height * this.openT
        : this.below ? this.ab.y + this.ab.h + this.gap : this.ab.y - this.gap - this.height },

    // motion: a bubble grows from its anchor's side; a sheet rises

    opacity = { this.asSheet ? 1 : this.openT },
    scale = { this.asSheet ? 1 : this._baseScale * (0.92 + 0.08 * this.openT) },
    rotation = { this.asSheet ? 0 : this._baseRotation },
    pivotX = { this.width / 2 },
    pivotY = { this.asSheet || this.below ? 0 : this.height },

    scrim: View [ visible = { classroot.asSheet }, pointerEvents = "none",
        x = { -classroot.x }, y = { -classroot.y },
        width = { classroot.hostW }, height = { classroot.hostH },
        fill = { provided("theme").scrimFill },
        opacity = { (provided("theme").scrimOpacity) * classroot.openT } ],

    panel: View [ width = 100%, height = 100%,
        cornerRadius = { classroot.asSheet ? [(provided("theme").sheetCornerRadius) - 2, (provided("theme").sheetCornerRadius) - 2, 0, 0] : (provided("theme").popoverCornerRadius) },
        fill = { provided("theme").surface },
        stroke = { classroot.asSheet ? null : stroke(1, provided("theme").line) },
        shadow = { provided("theme").popoverShadow } ],

    body: View [ padding = { classroot.asSheet ? [18, 18, 28, 18] : 14 },
        width = { classroot.asSheet ? classroot.hostW : this.contentWidth },
        layout: SimpleLayout [ axis = y, spacing = 10 ]
        ]
    ]
