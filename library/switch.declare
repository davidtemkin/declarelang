/*
# Switch

A boolean control with a sliding thumb — same value contract as Checkbox (`checked`,
`input` owns the destination), different body language: the thumb **springs**
between its two rest points, so toggling moves rather than jumps.

## checked
Whether the switch is on. Constrain it (`checked = { app.muted }`) and override `input`
to own the destination, or leave it and read it back — a `Switch` works standalone
with no wiring.

## input()
Where the value goes. The default writes `checked`; override it and the switch
becomes a delivery mechanism for state you own. `press()` never writes `checked`
directly, so a constrained switch never fights its constraint.

## press()
Toggles, by delivering the flipped value through `input`. Called by a click and by
Space/Enter.

## claim
`x`: a finger drags the thumb sideways, while a vertical drag that starts on the switch
still scrolls the page.

## dragging
True from pointer-down until the release.

## dragged
True once the pointer has moved the thumb during a press: the thumb follows the pointer,
and the release settles on the side the thumb is nearer. A drag past the slop raises no
click, so it never also toggles.

## _x0
**Internal.** The root-space pointer x at pointer-down.

## _grab
**Internal.** The thumb's rest x at pointer-down, that the pointer delta is applied to.

## _restX()
**Internal.** The thumb's x at rest for a value.

## _dragX()
**Internal.** The thumb's x under the pointer, held to the track.

## onPointerDown
Latches the drag, and keeps Control's focus rule.
An override calls `super.onPointerDown(e)`.

## onPointerMove
Marks the press a drag once the pointer has moved.
An override calls `super.onPointerMove()`.

## onPointerUp
Ends a drag on the nearer side, delivering through `input` when that changes the value.
An override calls `super.onPointerUp()`: it is what ends the drag.

## width
A theme with a native switch size says so (`provided("theme").switchWidth`); otherwise 44, the common pill.

## height
A theme with a native switch size says so (`provided("theme").switchHeight`); otherwise 24.

## cornerRadius
Always a pill — half the height, whatever the height is.

## opacity
Disabled dims the whole control — every part alike, never a recolour — to the theme's `disabledOpacity`, or 0.45 when the theme states none: the one place the number lives.

## fill
The track's ladder for a toggle: checked takes the accent; unchecked shows the selected tint while hovered or pressed and the quiet control tint at rest — so the track answers the pointer before the value flips.

## stroke
A hairline in the accent when checked, in the theme's line colour otherwise, so the track keeps an edge on light and dark surfaces alike.

## accessibilityChecked
Follows `checked`. A switch shows no label of its own, so **its use site names it** with `accessibilityLabel` — unnamed, the compiler warns.

## accessibilityLabel
The caption of a `Field` around it, unless the use site names the switch: its name to a screen
reader.

## fieldValue
Follows `checked`: what `required` and `validate` judge (see `ValueControl`).
*/

include [ "valuecontrol.declare" ]

class Switch extends ValueControl [
    // a switch shows no label of its own, so its use site names it
    // (accessibilityLabel = "Wi-Fi"); it tells a screen reader whether it is on

    accessibilityRole = switch,
    accessibilityChecked = { checked },
    accessibilityLabel = { provided("fieldLabel", "") },
    width  = { provided("theme").switchWidth },
    height = { provided("theme").switchHeight },
    cornerRadius = { height / 2 },
    checked: boolean = false,
    fieldValue = { checked },

    input(v: boolean) { checked = v },

    press()   { input(!checked) },

    // a finger can also slide the thumb across, as on a phone: the thumb
    // follows the pointer and the release settles on the nearer side; a tap
    // still toggles through press()

    claim = x,
    dragging: boolean = false,
    dragged: boolean = false,
    _x0: number = 0,
    _grab: number = 0,
    _restX(on: boolean) -> number { return on ? width - thumb.width - 2 : 2 },
    _dragX() -> number { return Math.max(2, Math.min(width - thumb.width - 2, _grab + app.pointerX - _x0)) },

    onPointerDown(e: PointerEvent) {
        if (disabled) return
        focusVisible = false
        Focus.focus(this)
        dragging = true
        dragged = false
        _x0 = app.pointerX
        _grab = _restX(checked)
        },
    onPointerMove() { if (dragging && Math.abs(app.pointerX - _x0) > 3) dragged = true },
    onPointerUp() {
        if (dragged) {
            const on = _dragX() + thumb.width / 2 > width / 2
            if (on != checked) input(on)
            }
        dragging = false
        dragged = false
        },

    opacity = { disabled ? (provided("theme").disabledOpacity) : 1 },
    fill    = { checked ? provided("theme").accent : hovered || pressed ? provided("theme").controlSelected : ((provided("theme").trackFill ?? provided("theme").control)) },
    stroke  = { stroke(1, checked ? provided("theme").accent : provided("theme").line) },

    // the thumb derives from the track: inset 2 normally; a theme may say the
    // unchecked thumb is smaller (Mountain View's 16→24 grow-on-check)

    thumb: View [ cornerRadius = { this.width / 2 },
        width  = { checked || provided("theme").switchThumbOffSize == null ? classroot.height - 4 : provided("theme").switchThumbOffSize },
        height = { this.width },
        y = center,
        fill = { provided("theme").switchThumbFill ?? provided("theme").surface },
        slide: Spring [ attribute = x, to = { classroot.dragged ? classroot._dragX() : classroot._restX(classroot.checked) }, stiffness = 300, damping = 26 ]
        ]
    ]
