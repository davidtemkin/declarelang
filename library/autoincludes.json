{
  "$provide": [
    {
      "class": "FocusRing",
      "when": {
        "baseUsed": "Control"
      },
      "comment": "the traveling focus indicator \u2014 provided with the component library"
    },
    {
      "class": "Tooltip",
      "when": {
        "attributeUsed": "tip",
        "onBase": "View"
      },
      "comment": "the tooltip singleton \u2014 provided with the component library (tip = attribute)"
    }
  ],
  "Bar": "bar.declare",
  "Control": "control.declare",
  "Checkbox": "checkbox.declare",
  "Button": "button.declare",
  "Switch": "switch.declare",
  "Slider": "slider.declare",
  "RadioGroup": "radiogroup.declare",
  "Radio": "radiogroup.declare",
  "Field": "field.declare",
  "ProgressBar": "progressbar.declare",
  "FocusRing": "focusring.declare",
  "Accordion": "accordion.declare",
  "Pane": "accordion.declare",
  "Tooltip": "tooltip.declare",
  "Menu": "menu.declare",
  "MenuBar": "menubar.declare",
  "Dialog": "dialog.declare",
  "AppIsland": "appisland.declare",
  "SimpleLayout": "simplelayout.declare",
  "WrappingLayout": "wrappinglayout.declare",
  "ResponsiveLayout": "responsive.declare",
  "Spacer": "spacer.declare",
  "Table": "table.declare",
  "TableRow": "table.declare",
  "Combobox": "combobox.declare",
  "ContextMenu": "contextmenu.declare",
  "DataGrid": "datagrid.declare",
  "Column": "datagrid.declare",
  "GridRow": "datagrid.declare",
  "Segmented": "segmented.declare",
  "ChevronIcon": "icons/core.declare",
  "CheckIcon": "icons/core.declare",
  "CloseIcon": "icons/core.declare",
  "PlusIcon": "icons/core.declare",
  "MinusIcon": "icons/core.declare",
  "LightbulbIcon": "icons/core.declare",
  "SunIcon": "icons/appearance.declare",
  "MoonIcon": "icons/appearance.declare",
  "AutoIcon": "icons/appearance.declare",
  "Icon": "icons/icon.declare",
  "IconHost": "icons/icon.declare",
  "SegmentedItem": "segmented.declare",
  "ArrowIcon": "icons/core.declare"
}
