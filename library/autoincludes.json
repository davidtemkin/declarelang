{
  "$provide": [
    {
      "class": "FocusRing",
      "when": {
        "baseUsed": "Control"
      },
      "comment": "the traveling focus indicator \u2014 provided with the library"
    },
    {
      "class": "Tooltip",
      "when": {
        "attributeUsed": "tooltipLabel",
        "onBase": "View"
      },
      "comment": "the tooltip singleton \u2014 provided with the library (tooltipLabel = attribute)"
    },
    {
      "class": "ShortcutsPanel",
      "when": {
        "labelledKeyBindings": true
      },
      "comment": "the hold-\u2318 panel of the shortcuts in force \u2014 provided once the program labels a key binding"
    },
    {
      "class": "ShortcutsPanel",
      "when": {
        "tagUsed": "Shortcuts"
      },
      "comment": "the hold-\u2318 panel of the shortcuts in force \u2014 provided with Shortcuts"
    }
  ],
