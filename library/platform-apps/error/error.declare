// error — a program's error state, as a program. When a program fails to load,
// its host opens this in the program's place — the page in a browser, the
// window on the Mac — providing the diagnostics (`errors`), the failed
// program's address (`subject`), and optionally a line of host-specific advice
// (`hint`). It is non-modal: the host's own controls stay live, and a harness
// can read the state instead of hanging on a modal run loop. Dark ground, red
// heading, monospace diagnostics, one page for every host. Retry re-opens the
// subject; a fixed file simply loads and the program is running again.
//
// Dependency-light, not dependency-free. This page must come up when other
// programs cannot, so it leans on View, Text and HTMLText — plus the library's
// real `Button` for Retry. That is a safe lean: the library is baked into the
// app, so if it cannot compile the platform itself is broken — which is
// exactly the case the host's native last-resort alert exists for. The host's
// message is one diagnostic per line (a leading "N errors" count first), so
// each line becomes a wrapped, selectable row.

use [ Button ]

style err [ fontFamily = "ui-monospace, SFMono-Regular, Menlo, monospace" ]

App [ minWidth = 360,
    theme = SanFranciscoDark,                     // the Button styles from the provided theme; dark matches the page
    fill = #0B141B, textColor = #E7EEF2,

    // what the host provides, each with a default, so an unhosted open (a
    // person double-clicking this file) still renders a sensible page

    errors: string = { hostProvided("errors", "") || "No diagnostics were passed." },
    subject: string = { hostProvided("subject", "") },
    hint: string = { hostProvided("hint", "") || "Fix the file, then press Retry." },

    // HTML-escape a diagnostic so its own `<`/`&` render literally, then one
    // paragraph per line in the monospace style — a wrapped, selectable list.

    esc(s: string) -> string { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") },
    listHtml: string = { app.errors.split("\n").filter(l => l.trim() !== "").map(l => "<p><span class='err'>" + app.esc(l) + "</span></p>").join("") },

    body: View [ x = 0, y = 0, width = { app.width }, height = { app.height }, scrolls = y, clip = true,

        // the page margin is the scroller's own content box — and because a
        // scroller's extent counts its insets, the bottom one is the trailing
        // room a long diagnostic list scrolls into

        padding = [24, 24, 40, 24],

        col: View [ width = 100%,
            layout: SimpleLayout [ axis = y, spacing = 12 ],
            head: Text [ fontSize = 15, fontWeight = semibold, textColor = #FF6B6B, text = "Could not load this program" ],
            where: Text [ visible = { app.subject != "" }, width = 100%, wrap = true, fontSize = 12, textColor = #8FA3B0, text = { app.subject } ],

            // Retry sits up top, before a possibly long list — the action is what
            // a person came back for after fixing the file. The library's real
            // Button: label centered on its cap band, hover/press states, keyboard
            // activation. Sized subordinate to the 15px headline: the theme's
            // 40px control would outweigh the message it serves. The label takes
            // the ambient fontSize, so one number sets the type; height sets the
            // box.

            retry: Button [ visible = { app.subject != "" }, height = 34, fontSize = 13, label = "Retry", primary = true,
                onClick() { app.navigate(app.subject) }
                ],
            list: HTMLText [ width = 100%, fontSize = 13, lineHeight = 1.55, bodyColor = #E7EEF2, dark = true, selectable = true, html = { app.listHtml } ],
            advice: Text [ width = 100%, wrap = true, fontSize = 12, textColor = #8FA3B0,
                text = { app.hint } ]
            ]
        ]
    ]
