/*
# Accordion

OpenLaszlo's `basetabslider`, reborn — stacked pane headers, one
pane open at a time, panes SLIDING open and closed by a spring on height. The
load-bearing mechanic (docs/system-design/tabslider-gaps.md, verified
frame-by-frame against the original): a pane's content is PRESENT through the
whole open **and** close, revealed and concealed by the pane's own clip as its
height animates — never an instant pop, never a blank gap.

Value contract (components-baseline.md): the open pane is ONE attribute on the
group — `value`, the open pane's name — exactly RadioGroup's shape. Panes are
the group's direct children; each names itself (`name`, defaulting to its
`label`) and derives `open` from the group. Content is authored as the Pane's
ordinary children — the Pane stacks its header then the content, and clips.
*/

include [ "control.declare" ]

class Accordion extends View [
    value: string = "",

    // one open pane at a time, stacked flush — the sliding heights ARE the
    // arrangement; the group just stacks whatever heights the springs say

    layout: SimpleLayout [ axis = y, spacing = 2 ]
    ]


class Pane extends Control [ width = { parent.width }, clip = true,
    label: string = "",
    name:  string = { label },
    initial: boolean = false,                     // seed the open pane: first Pane sets initial = true

    open: boolean = { (parent as Accordion).value == name && name != "" },

    onInit() { if (initial && (parent as Accordion).value == "") (parent as Accordion).value = name },

    // the slide: height springs between the bare header and the content's own
    // wanted extent; `clip = true` is what carries the content through the
    // whole motion (the OL mechanic — concealed by the clip, never removed)

    slide: Spring [ attribute = height, to = { open ? contentHeight : classroot.header.height }, stiffness = 220, damping = 26, epsilon = 0.4 ],

    // a CLOSED pane is clip-occluded, not hidden — its content stays visible
    // so the slide can carry it (the OL mechanic), but focus must never
    // descend into it (the web's inert lesson; ARIA's inactive-panel rule).
    // The traversal protocol handles it: while closed, this Pane contributes
    // no members — the header stop (the Pane itself) remains.

    tabOrder() { return open ? this.tabDefault() : [] },

    press()   { (parent as Accordion).value = name },
    onClick() { if (!disabled) press() },

    layout: SimpleLayout [ axis = y, spacing = 0 ],

    // headers are FILLED, edgeless — an edge reads as an input field (David).
    // The one exception is the component channel of the focus model: while
    // THIS pane holds KEYBOARD focus (Control's focusVisible — the web's
    // :focus-visible rule), a darker-than-fill edge appears. A pointer click
    // focuses silently — the click is its own feedback, no edge.

    header: View [ width = { parent.width }, height = 34,
        cornerRadius = { theme.controlRadius },
        fill = { classroot.open || classroot.hot || classroot.down ? theme.controlActive : theme.control },
        stroke = { classroot.focusVisible ? stroke(1, theme.textMuted) : null },
        t: Text [ x = 12, y = center, fontSize = 14, fontWeight = { classroot.open ? "semibold" : "medium" },
            textColor = { theme.text }, text = { classroot.label } ]
        ]
    ]
