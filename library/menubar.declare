/*
# MenuBar

The record-driven menu bar: **whole menus are data** —

    menus = { [ ({ id, label, bold?, items: [ …menu records… ] }), … ] }

— and the component arranges. One internal Menu serves every title; its
`items` constraint derives from the open title's record, so item state
(enabled, checked, labels) stays live while the menu is up. Because the
records are the single declaration, an app can derive its key registry
from the same array the bar renders — nothing is declared twice.

Tracking is the classic desktop behavior: titles do not highlight on mere hover;
a click opens (and highlights) a title; while any menu is open, moving
across another title switches to it; clicking the open title closes.

Delivery is the one seam: `picked(id)` — override at the use site.

A dropped menu paints over the bar's later siblings: the bar raises itself when a menu
opens (stacking is source order, and `raise()` is the runtime verb for it). A bar nested
inside a container that sits under other content wants that container declared last,
or a menu hosted at the app layer as `Combobox` does.

```declare
App [ width = 380, height = 190, chose: string = "",
    bar: MenuBar [ x = 12, y = 8,
        menus = { [ ({ id: "file", label: "File", items: [ ({ id: "new", label: "New", key: "⌘N" }),
                                                          ({ id: "open", label: "Open…" }) ] }),
                    ({ id: "edit", label: "Edit", items: [ ({ id: "undo", label: "Undo" }),
                                                           ({ divider: true }),
                                                           ({ id: "cut", label: "Cut" }) ] }) ] },
        picked(id: string) { app.chose = id }
        ],
    Text [ x = 20, y = 70, text = { app.chose == "" ? "nothing picked" : "picked: " + app.chose } ]
    ]
```

## menus
The whole bar as **data**: `[ { id, label, bold?, kind?, items: [ …menu records… ] } ]`,
where `items` is exactly `Menu`'s record shape. **One internal `Menu` serves every
title**, deriving its rows from the open one — so item state stays live while a menu is
up, and there is nothing to keep in step. Because the records are the single
declaration, an app can derive its keyboard-shortcut registry from the same array the
bar renders.

## picked()
**The delivery seam — override it at the use site.** Receives the picked item's `id`
from any menu in the bar; the id is the whole message.

## ink
Overrides the *titles'* colour, for a bar drawn straight over a wallpaper where the
platform text turns light. `null` uses the theme's text colour. **The dropdown menus
stay themed either way** — this is the bar's own ink, not the menu's.

## openId
Which title's menu is open, by id — `""` when none is.

## shown
Whether any menu in the bar is currently open.

## openMenu()
Opens a title's menu and keeps the bar itself above the menu's backdrop, which is what
lets tracking continue while a menu is up.

## trackMenu()
Switches to another title while a menu is already open — **bar tracking**: titles do
not highlight on mere hover, but once a menu is open, crossing another title opens that
one.

## stepMenu()
Moves to the adjacent title's menu — Left/Right while a menu is open, yielding to the
open menu when a submenu is up or the rover sits on one.

## hasSub()
**Internal.** Whether a roved row cascades, so ArrowRight enters it rather than walking
the bar.

## rowsOf()
**Internal.** The bar's title views.

## width
Content-sized to its row of titles, so it sits in a chrome bar without a stated width.

## selectable
Chrome, never prose: the titles do not select, even inside a `selectable` region — the same provision every `Control` makes for its label.

## theme
The provided design-token record this widget styles off — a **provided value**
(the app provides it once with `App [ theme = { … } ]`; `Control` and the library
widgets read it). Reads `theme.accent` and its kin as typed members; defaults to the
house look. See `Control.theme`.
*/

include [ "menu.declare" ]

class MenuBar extends View [
    // The design-token record, a provided value: the app provides it once and
    // this widget reads it, so `theme.x` reads below are plain typed members.
    // Default = the house look.

    theme: Theme = { provided("theme", SanFrancisco) },
    height = 25,

    // chrome, not prose: the titles never select inside a `selectable` region

    selectable = false,

    // menu records: { id, label, bold?, kind?, items } — `kind` names an
    // author class rendered as the title (a brand mark in the leading
    // slot); behavior stays the title's (open, track). Keep kind-only
    // classes with `use [ Name ]`, exactly as Menu's kind rows do.

    menus: array = null,

    // optional title-ink override: when set, the menu titles render in this
    // color instead of `theme.text` — for a bar drawn straight over a
    // wallpaper (no background), where the platform text turns light. Null =
    // the theme's text color. The dropdown menus stay themed.

    ink: Color = null,

    // the delivery seam — the id is the whole message

    picked(id: string) { },

    openId: string = "",
    shown: boolean = { this.menu.shown },

    width = { this.row.contentWidth },

    // `t`/`r` below are typed `object` — a title is an anonymous replicated
    // template (the `datapath = :m[]` view); see menu.declare's same seam.

    openMenu(t: object) {
        openId = "" + t.mid
        this.menu.openFor(t)
        // the menu self-raises, which lifts its full-app backdrop over the
        // titles — but a tracking bar stays hot while a menu is open (that is
        // what tracking is). Promote the row back above the backdrop; the
        // panel drops below the bar, so nothing occludes visually.
        this.row.raise()
        // raise() is per parent: the menu is this bar's child, so it rose
        // above the bar's row and nothing else. A sibling declared after the
        // bar — a page's content, laid out under the chrome — would still
        // paint over the dropped panel and take its clicks. The bar is chrome:
        // while it drops a menu it belongs above its siblings, so it raises
        // itself too. (A bar nested in a container that is itself under other
        // content declares that container last — stacking is source order —
        // or hosts its menu at the app layer, the Combobox idiom.)
        this.raise()
        },

    // while open, crossing another title switches to it (menu tracking)

    trackMenu(t: object) { if (this.menu.shown && "" + t.mid != openId) this.openMenu(t) },

    // ── arrows walk the bar while a menu is open (the desktop rule): Left/Right move to
    // the adjacent title's menu. The open Menu keeps the keys when a submenu
    // is up (Left backs out of it) or when the rover sits on a submenu row
    // (Right enters it) — the guards below yield exactly those cases.

    rowsOf() { return this.row.children },

    hasSub(r: object) -> boolean { return r != null && r.sub == true },

    stepMenu(d: number) {
        const ms = menus || []
        const i = ms.findIndex((m) => "" + m.id == this.openId)
        if (i < 0 || ms.length < 2) return
        const nid = "" + ms[(i + d + ms.length) % ms.length].id
        const t = this.rowsOf().find((r) => "" + r.mid == nid)
        if (t != null) this.openMenu(t)
        },

    keys: Keys [
        onKeyDown(e: KeyEvent) {
            if (!classroot.menu.shown) return
            if (classroot.menu.subShown(classroot.menu.child)) return
            if (e.key == "ArrowLeft") classroot.stepMenu(-1)
            else if (e.key == "ArrowRight") { if (!classroot.hasSub(classroot.menu.activeRow)) classroot.stepMenu(1) }
            }
        ],

    menu: Menu [
        items = { ((classroot.menus || []).find((m) => "" + m.id == classroot.openId) || ({ })).items || [] },
        picked(id: string) { classroot.picked(id) }
        ],

    data: Dataset [ contents = { { m: classroot.menus || [] } } ],

    row: View [ height = 100%,
        layout: SimpleLayout [ axis = x, spacing = 2 ],
        datapath = { classroot.data.value },

        // the title highlight is the Mac's: inset above and below (the bar is
        // taller than the capsule), radius between rounded-rect and pill

        View [ datapath = :m[], height = { parent.height - 8 }, y = 4,
            mid: string = { "" + :id },
            kd: string = { typeof :kind == "string" ? "" + :kind : "" },
            open: boolean = { classroot.menu.shown && classroot.openId == this.mid },
            width = { (this.kd != "" ? this.host.contentWidth : this.t.width) + 20 },
            cornerRadius = 6,

            // the open/arrow-nav title highlight — a translucent frosted capsule
            // when the theme names one (Cupertino), else the solid controlSelected

            fill = { this.open ? (theme.menuTitleHl != null ? theme.menuTitleHl : theme.controlSelected) : null },
            onPointerOver() { classroot.trackMenu(this) },
            onClick() { if (this.open) classroot.menu.close(); else classroot.openMenu(this) },
            onInit() { if (this.kd != "") this.host.createView(this.kd, ({ })) },
            t: TextLabel [ x = 10, fontSize = 14,
                visible = { parent.kd == "" },

                // medium, not regular: the browser's grayscale antialiasing
                // renders 400 a shade thinner than platform menu text

                fontWeight = { :bold ? "bold" : "medium" },
                textColor = { classroot.ink != null ? classroot.ink : theme.text }, text = { "" + :label } ],
            host: View [ x = 10, y = center,
                visible = { parent.kd != "" },
                width = { this.contentWidth }, height = { this.contentHeight } ]
            ]
        ]
    ]
