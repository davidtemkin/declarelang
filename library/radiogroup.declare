/*
# RadioGroup

One-of-N. Radios are written as the group's **direct children** — the group's
layout arranges them, and each radio reaches its group as `parent`:

    RadioGroup [ value = "m", input(v: string) { app.size = v },
        Radio [ choice = "s", label = "Small" ],
        Radio [ choice = "m", label = "Medium" ],
        Radio [ choice = "l", label = "Large" ],
        ]

```declare
size: RadioGroup [ x = 20, y = 20, value = "m",
    Radio [ choice = "s", label = "Small" ],
    Radio [ choice = "m", label = "Medium" ],
    Radio [ choice = "l", label = "Large" ]
    ]
```

## value
**The group's value — the chosen `choice`, and the only value in the pair.** A
`Radio` has none of its own; it derives `on` from this. Standalone the group owns it;
constrained, override `input` beside it as with any control.

## input()
Where the choice goes. The default writes `value`; override it to own the destination
(`input(v: string) { app.size = v }`) and the radios keep working untouched, because
they deliver rather than store.

## pick()
Selects a choice by name — the seam a `Radio` calls on its group. Call it to move the
selection from code without bypassing `input`.

## focusScope
`stop`: the group is one Tab stop — Tab lands on the checked radio and the next Tab
leaves; the arrows move to the next radio and check it, as every platform's radio
group does.

## focusEntry()
The radio Tab lands on: the checked one, else the first that is enabled.

## radios()
The group's radios, for the Tab entry. A handler-only walk.


## fieldValue
Follows `value`, the chosen `choice`: what `required` and `validate` judge (see `ValueControl`).
*/

include [ "valuecontrol.declare" ]

class RadioGroup extends ValueControl [
    accessibilityRole = radioGroup,
    value: string = "",
    fieldValue = { value },

    // the radios are the stops, not the group (a ValueControl is otherwise one);
    // it is judged when the focus leaves its radios

    focusable = false,
    focusField() { const r = focusEntry(); if (r != null) Focus.focus(r) },

    input(v: string) { value = v },
    pick(v: string)  { input(v) },

    // one Tab stop, landing on the checked radio; the arrows move and check
    // (planes.md §13.6)

    focusScope = stop,
    focusEntry() -> View? {
        const rs = this.radios()
        return (rs.find((r) => (r as Radio).choice == this.value) ?? rs.find((r) => !(r as Radio).disabled) ?? null) as View | null
        },
    radios() -> array {
        const out = []
        for (const c of this.children) { if ((c as Radio).choice !== undefined) out.push(c) }
        return out
        },

    layout: SimpleLayout [ axis = y, spacing = 10 ]
    ]


/*
# Radio

One choice in a `RadioGroup`: a direct child of the group, naming itself with
`choice`. A radio stores nothing — it derives `on` from the group's `value` and
delivers its `choice` to the group when pressed, so turning one on can never leave
another stale.

```declare
App [ width = 300, height = 120, fill = white, textColor = black,
    size: string = "m",
    RadioGroup [ x = 20, y = 20, value = { app.size }, input(v: string) { app.size = v },
        Radio [ choice = "s", label = "Small" ],
        Radio [ choice = "m", label = "Medium" ]
        ],
    Text [ x = 160, y = 20, text = { "size: " + app.size } ]
    ]
```

## choice
This radio's identity within its group, compared against the group's `value` by string.
**Required and unique per group** — two radios sharing a `choice` light together.

## label
The text beside the dot. `""` renders the dot alone.

## baseline
The baseline a row aligns this radio by — its caption's, so a row of mixed controls and
text under `align = baseline` reads as one line.

## on
Whether this radio is the group's current choice. **Derived from the group, never
stored** — which is why turning one on cannot leave another stale.

## press()
Delivers this radio's `choice` to the group. Called by a click and by Space/Enter.

## onKeyDown
The arrows move to the next or previous radio in the group (the stop's) and check the one
they land on; Space and Enter press, as on any control.

## onBlur
Judges the group when the focus leaves a radio, as a field is judged on leaving. An override
calls `super.onBlur()`.

## focusShape()
Rings the round dot rather than the dot-plus-label row.

## width
Content-sized: the dot, then a gap and the label when there is one. A label-less radio is exactly its dot.

## opacity
Disabled dims the whole choice, dot and label alike — to the theme's `disabledOpacity`,
or 0.45 when the theme states none.

## height
Tall enough for the dot and a 2px margin either side: the theme's `radioSize` (18 by default) plus 4 —
and on a touch-first device at least 44, a finger's target, the dot unchanged.

## accessibilityChecked
Follows `on`: whether this choice is the group's `value`.
*/

class Radio extends Control [ height = { Math.max(this.dot.width + 4, app.touchFirst ? 44 : 0) },
    baseline: number = { this.cap.y + this.cap.baseline },   // a row aligns the control by its label

    // keyboard focus rings the round dot itself, not the dot-plus-label row

    focusShape() { return ({ x: this.dot.x, y: this.dot.y, w: this.dot.width, h: this.dot.height, rad: this.dot.width / 2 }) },
    choice: string = "",
    label:  string = "",
    accessibilityRole = radio,
    accessibilityChecked = { on },

    // a radio's parent is its group (the direct-child discipline above); the
    // cast informs the typecheck and is stripped for the runtime

    press()   { (parent as RadioGroup).pick(choice) },

    // the arrows move to the next radio and check it; Space and Enter as any control

    // leaving the group's radios is leaving the group

    onBlur() {
        super.onBlur()
        const g = parent as any
        if (g != null && g.judgeOn == "leave") g.judged = true
        },

    onKeyDown(e: KeyEvent) {
        super.onKeyDown(e)
        const to = Focus.getFocus() as any
        if (to != null && to != this && to.parent == this.parent && to.choice !== undefined) (parent as RadioGroup).pick(to.choice)
        },

    on: boolean = { (parent as RadioGroup).value == choice },

    width   = { this.dot.width + (label == "" ? 0 : 8 + this.cap.width) },
    opacity = { disabled ? (provided("theme").disabledOpacity) : 1 },

    dot: View [ width = { provided("theme").radioSize }, height = { this.width }, cornerRadius = { this.width / 2 }, y = { (parent.height - this.width) / 2 },
        fill   = { provided("theme").surface },
        stroke = { stroke(on ? 5 : 1, on ? provided("theme").accent : hovered || pressed ? provided("theme").textMuted : provided("theme").line) } ],
    cap: TextLabel [ x = 26, wrap = false, textColor = { provided("theme").text },
        visible = { label != "" }, text = { label } ]
    ]
