/* Browser document persistence: working data and recovery are separate. */

schema Note [ amount: number ]

App [ minWidth = 360, scrolls = y, fill = #101820, textColor = #E6EDF2,
    fontFamily = "system-ui", fontSize = 16,
    leaving: boolean = false,
    leaveRequest: number = 0,
    left: boolean = false,
    receipt: string = "No acknowledgement yet",
    db: Dataset [ schema = Note,
        disk: Persistence [ key = "persistence-lifecycle", save = "manual", restoreOn = "manual",
            onResult(r: PersistenceResult) {
                app.receipt = r.ok ? r.operation + " acknowledged" : r.operation + ": " + r.error?.code
                if (app.leaving && r.requestId === app.leaveRequest) {
                    app.leaving = false
                    if (r.ok) app.left = true
                }
                }
            ]
        ] { { "amount": 0 } },
    body: View [ x = 20, y = 20, width = { app.width - 40 },
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        Text [ text = "Persistence workbench", fontSize = 24, fontWeight = bold ],
        Text [ width = 100%, text = "Local browser storage. Not a backup.", wrap = true ],
        status: Text [ width = 100%, wrap = true,
            text = { app.db.disk.error ? app.db.disk.error.message : app.db.disk.pending ? "Storage pending" : app.db.disk.saved ? "Saved" : app.db.disk.recovery === "available" ? "Saved document available" : "Working document" } ],
        Text [ width = 100%, wrap = true, text = { "Recovery: " + app.db.disk.recovery + " / Revision: " + app.db.disk.revision } ],
        Text [ width = 100%, wrap = true, text = { app.receipt } ],
        form: View [ width = 100%, height = 76,
            layout: SimpleLayout [ axis = y, spacing = 8 ],
            datapath = { app.db.value },
            Text [ text = "Amount" ],
            amount: TextInput [ width = 100%, height = 44, text <-> :amount, commitOn = "input" ]
            ],
        Text [ width = 100%, wrap = true, text = { "Committed amount: " + app.db.value?.amount } ],
        save: Button [ width = 100%, height = 44, label = "Save",
            onClick() { app.db.disk.commit() }
            ],
        restore: Button [ width = 100%, height = 44, label = "Restore saved document",
            onClick() { app.db.disk.restore() }
            ],
        replaceSaved: Button [ width = 100%, height = 44, label = "Replace saved document",
            onClick() { app.db.disk.replace() }
            ],
        erase: Button [ width = 100%, height = 44, label = "Erase saved document",
            onClick() { app.db.disk.erase() }
            ],
        retry: Button [ width = 100%, height = 44, label = "Retry",
            onClick() { app.db.disk.retry() }
            ],
        reload: Button [ width = 100%, height = 44, label = "Check saved document",
            onClick() { app.db.disk.reload() }
            ],
        leave: Button [ width = 100%, height = 44, label = "Save and leave",
            onClick() { app.leaving = true; app.leaveRequest = app.db.disk.commit() }
            ],
        cancel: Button [ width = 100%, height = 44, label = "Cancel leaving",
            onClick() { app.leaving = false }
            ],
        Text [ width = 100%, wrap = true, text = { app.left ? "Leave approved by acknowledgement" : app.leaving ? "Waiting to leave" : "Staying here" } ]
        ]
    ]
