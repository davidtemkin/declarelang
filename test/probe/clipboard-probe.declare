App [ width = 600, height = 400, fill = white, textColor = black,
    word: string = "tomato",
    pasted: string = "",
    types: string = "",
    pastedFiles: number = 0,
    focusOn(v: View) { Focus.focus(v) },
    chip: View [ x = 20, y = 20, width = 120, height = 40, fill = gainsboro, focusable = true,
        onClipboardCopy(e: ClipboardEvent) {
            e.put(app.word)
            e.put("application/x-chip", JSON.stringify({ word: app.word }))
            },
        onClipboardCut(e: ClipboardEvent) { e.put(app.word); app.word = "" },
        inner: View [ x = 4, y = 4, width = 20, height = 20, fill = gray, focusable = true ]
        ],
    board: View [ x = 200, y = 20, width = 200, height = 100, fill = lavender, focusable = true,
        onClipboardPaste(e: ClipboardEvent) {
            app.types = e.types.join(",")
            app.pastedFiles = e.files.length
            const c = e.get("application/x-chip")
            app.pasted = c != null ? JSON.parse(c).word : e.text
            }
        ],
    plain: View [ x = 420, y = 20, width = 100, height = 40, fill = mistyrose, focusable = true ],
    field: TextInput [ x = 20, y = 200, width = 200 ],
    copyLink: Button [ x = 20, y = 300, label = "Copy link",
        onClick() { Clipboard.copy({ "text/plain": "https://example.test", "text/html": "<a href=\"https://example.test\">example</a>" }) }
        ]
    ]
