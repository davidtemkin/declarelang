// Text.maxLines — the line clamp, on every renderer: a two-line preview whose last
// line ends in an ellipsis that fits; a one-line clamp of a non-wrapping run; an
// over-long token cut by characters; and an unclamped twin for the height contrast.

App [ width = 420, height = 300, fill = #F4EFE7,
    a: Text [ x = 20, y = 20, width = 200, fontSize = 15, textColor = #222222, maxLines = 2,
        text = "Marco: mine is nicest and I will not be taking questions about it from anyone at all" ],
    b: Text [ x = 20, y = 90, width = 200, fontSize = 15, textColor = #222222, wrap = false, maxLines = 1,
        text = "Kwame: it was a good morning to be up there honestly" ],
    c: Text [ x = 20, y = 130, width = 120, fontSize = 15, textColor = #222222, maxLines = 1,
        text = "supercalifragilisticexpialidocious" ],
    d: Text [ x = 240, y = 20, width = 160, fontSize = 15, textColor = #222222,
        text = "Marco: mine is nicest and I will not be taking questions about it from anyone at all" ]
    ]
