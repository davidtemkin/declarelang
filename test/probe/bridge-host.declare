// Island-bridge probe, HOST side (test/island-browser.test.mjs): an AppIsland
// with a typed external surface — `volume` host-bound (the strict input),
// `pos` tenant-owned (`readonly external`) — plus the verb pair. Runs the
// same on the DOM backend and on canvas (surface composition).

App [ width = 400, height = 300, fill = #101820,
    vol: number = 0.7,
    log: string = "",

    player: AppIsland [ x = 10, y = 10, width = 200, height = 120,
        program = "../bridge-tenant",
        external volume: number = { app.vol },
        external readonly pos: number = 0,
        onPost(m: IslandPost) { app.log = app.log + m.topic + ";" }
        ],

    posOut: Text [ x = 10, y = 150, textColor = whitesmoke,
        text = { "pos=" + app.player.pos } ],

    // a FOREIGN island beside the Declare one: raw JS mounts here and speaks
    // through el.__declareIsland (the sanctioned handle) — the DOM run pins it

    note: DOMIsland [ x = 10, y = 180, width = 200, height = 40, slot = "note",
        external readonly txt: string = "",
        onPost(m: IslandPost) { app.log = app.log + "note:" + m.topic + ";" }
        ],
    noteOut: Text [ x = 10, y = 230, textColor = #9CB2C5, text = { app.note.txt } ]
    ]
