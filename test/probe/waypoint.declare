// The ENTRY PAIR, probed where history shows (test/history.test.mjs). An
// address (`location`) and a step (`waypoint`): the URL fragment carries only
// the first; the History entry's state object carries the second. The probe
// gives the tests a page-scrolling body (the App is the page) and one view
// per attribute so both halves are visible in the tree.

App [ fill = #16191E, location = "", waypoint = "",

    place: Text [ x = 20, y = 20, textColor = whitesmoke, text = { "at " + (app.location == "" ? "(home)" : app.location) } ],
    step:  Text [ x = 20, y = 44, textColor = #9CB2C5, text = { "step " + (app.waypoint == "" ? "(none)" : app.waypoint) } ],

    // enough content to give the page a real scroll range for the
    // per-entry scroll-restoration pin

    column: View [ x = 20, y = 80, width = 300, height = 2400, fill = #223344,
        marker: View [ x = 0, y = 1200, width = 300, height = 40, fill = #46586A ]
        ]
    ]
