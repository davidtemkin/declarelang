// FILTERBED — every road into the canvas `filter` FALLBACK (runtime/src/
// canvas-filter.ts), on one screen: what a high-polish app does with blur and
// colour, and what Safari (no ctx.filter) must do in software.
//
//   1. draw() filters (both renderers): a wide blurred gradient field — the
//      desktop wallpaper's case — then small blurs and every colour function.
//   2. view `filter = [ … ]` (canvas renderer): a view's own layer filtered.
//   3. `backdrop = frost(…)` (canvas renderer): glass over busy content.
// `phase` places the glass and the filtered views; a resize (the rig's stimulus)
// re-renders them, so a run sees the fallback in motion (approximate) and at
// rest (calibrated) alike.

class Swatch extends View [ width = 150, height = 110, cornerRadius = 12, clip = true,
    fx: string = "none",
    draw(d: Draw) {
        const g = d.createLinearGradient(0, 0, 150, 110)
        g.addColorStop(0, "#FF5E3A")
        g.addColorStop(0.5, "#FFD23F")
        g.addColorStop(1, "#3AA8FF")
        d.filter = fx
        d.fillStyle = g
        d.fillRect(0, 0, 150, 110)
        d.fillStyle = "#1B1B2F"
        d.fillRect(30, 30, 40, 40)
        d.beginPath()
        d.arc(105, 60, 24, 0, 6.2832)
        d.fillStyle = "#FFFFFF"
        d.fill()
        d.filter = "none"
        }
    ]


App [ width = 1200, height = 800, fill = #0B0710,
    phase: number = 0,

    // 1a. the wide field: five full-canvas radial fills under one big blur, lightened together

    field: View [ x = 0, y = 0, width = 1200, height = 800,
        draw(d: Draw) {
            d.fillStyle = "#120A1E"
            d.fillRect(0, 0, 1200, 800)
            const xs = [180, 980, 600, 240, 1000]
            const ys = [170, 150, 430, 650, 640]
            const rs = [520, 480, 600, 460, 500]
            const inks = ["#E0457B", "#5B6CFF", "#20C4A8", "#F2A33A", "#B04DFF"]
            d.save()
            d.filter = "blur(60px)"
            d.globalCompositeOperation = "lighten"
            for (let i = 0; i < 5; i++) {
                const g = d.createRadialGradient(xs[i], ys[i], 0, xs[i], ys[i], rs[i])
                g.addColorStop(0, inks[i])
                g.addColorStop(1, "rgba(0,0,0,0)")
                d.fillStyle = g
                d.fillRect(0, 0, 1200, 800)
                }
            d.restore()
            }
        ],

    // 1b. draw() filters, one per colour function and a few blurs

    swatches: View [ x = 40, y = 40, width = 1120, height = 260,
        Swatch [ x = 0, y = 0, fx = "blur(3px)" ],
        Swatch [ x = 160, y = 0, fx = "blur(12px)" ],
        Swatch [ x = 320, y = 0, fx = "saturate(2)" ],
        Swatch [ x = 480, y = 0, fx = "brightness(1.4) contrast(1.3)" ],
        Swatch [ x = 640, y = 0, fx = "grayscale(1)" ],
        Swatch [ x = 800, y = 0, fx = "sepia(0.8)" ],
        Swatch [ x = 960, y = 0, fx = "hue-rotate(120deg)" ],
        Swatch [ x = 0, y = 130, fx = "invert(1)" ],
        Swatch [ x = 160, y = 130, fx = "blur(6px) saturate(1.8)" ],
        Swatch [ x = 320, y = 130, fx = "contrast(0.6) brightness(1.2) hue-rotate(-40deg)" ],
        Swatch [ x = 480, y = 130, fx = "blur(24px)" ]
        ],

    // 2. view filters (the canvas renderer filters the view's layer)

    viewFilters: View [ x = { 40 + 30 * Math.sin(app.phase) }, y = 330, width = 700, height = 150,
        Swatch [ x = 0, y = 0, filter = [blur(4)] ],
        Swatch [ x = 170, y = 0, filter = [saturate(1.6), brightness(1.1)] ],
        Swatch [ x = 340, y = 0, filter = [grayscale(0.7), contrast(1.4)] ],
        Swatch [ x = 510, y = 0, filter = [blur(2), hueRotate(60)] ]
        ],

    // 3. frost: glass over the field and the swatches

    glassA: View [ x = { 760 + 60 * Math.cos(app.phase) }, y = 320, width = 380, height = 220, cornerRadius = 22,
        fill = #FFFFFF1E, backdrop = { frost(24, 1.4) } ],
    glassB: View [ x = { 80 + 120 * Math.sin(app.phase * 0.7) }, y = 520, width = 640, height = 220, cornerRadius = 26,
        fill = #0A1422A0, backdrop = { frost(30, 1.2) } ]

    ]
