// The person's files, end to end (test/files-browser.test.mjs): a picker for
// files and one for a folder, a drop zone that lights while files are over it,
// and an upload of the first file with a note beside it.

App [ width = 600, height = 400, fill = #f4f4f4,
    picked: File[] = [],
    hot: boolean = false,
    names: string = { app.picked.map((f) => (f.path != "" ? f.path : f.name) + " " + f.size).join("\n") },
    up: DataSource [ url = "", method = "POST" ],      // the test points it at its echo server
    choose: Button [ x = 20, y = 20, label = "Choose files",
        onClick() { FilePicker.pick({ multiple: true }).then((fs: File[]) => { app.picked = fs }) }
        ],
    folder: Button [ x = 180, y = 20, label = "Choose a folder",
        onClick() { FilePicker.pick({ folder: true }).then((fs: File[]) => { app.picked = fs }) }
        ],
    send: Button [ x = 360, y = 20, label = "Upload",
        onClick() { app.up.body = { note: "hi", file: app.picked[0] }; app.up.fetch() }
        ],
    zone: View [ x = 20, y = 70, width = 560, height = 150, fill = { app.hot ? 0xccddee : 0xffffff },
        onFilesOver(e: FilesOverEvent) { app.hot = true },
        onFilesOut() { app.hot = false },
        onFilesDrop(e: FilesDropEvent) { app.hot = false; app.picked = e.files },
        Text [ x = 10, y = 10, text = "Drop files or a folder here" ]
        ],
    list: Text [ x = 20, y = 240, width = 560, text = { app.names } ],
    preview: Image [ x = 400, y = 240, width = 180, height = 140, stretches = both,
        visible = { app.picked.length > 0 && app.picked[0].type.startsWith("image/") },
        source = { app.picked.length > 0 ? app.picked[0].url : "" } ]
    ]
