// hidden-pane — rows rebuilt inside a pane that was shown once and is hidden
// (deferred rendering files them under it), a context menu opened on a row by
// a right-click, and a Toast said from a row, each followed by a rebuild.
// Driven by hidden-pane.assert.mjs.

App [ width = 800, height = 600,
    seq: number = 0,
    paneOn: boolean = true,
    d: Dataset [ contents = { ({ rows: [0, 1, 2, 3, 4].map((i) => ({ k: "row " + i + "." + app.seq })) }) } ],
    pane: View [ x = 20, y = 20, width = 300, visible = { app.paneOn }, datapath = { app.d.value },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        View [ datapath = :rows[], width = 300, height = 24, fill = #eeeeee,
            Text [ x = 6, text = :k ],
            Button [ x = 200, label = "b" ]
            ]
        ],
    list: View [ x = 360, y = 20, width = 300, datapath = { app.d.value },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        Row [ datapath = :rows[] ]
        ]
    ]


class Row extends View [ width = 300, height = 30, fill = #f4f4f4,
    Text [ x = 6, y = 6, text = :k ],
    cm: ContextMenu [ items = { [{ id: "a", label: "Alpha" }, { id: "b", label: "Beta" }] } ],
    onContextMenu(e: PointerEvent) { classroot.cm.open(this, e) },
    toast: Toast [ ],
    say: Button [ x = 200, y = 2, label = "toast",
        onClick() { classroot.toast.say("hello from a row", null) }
        ]
    ]
