// a tenant with a Keys member and a Time (island-each.declare)

App [ width = 200, height = 100,
    n: number = 0,
    KeyListener [ onKeyDown(e: KeyEvent) { app.n = app.n + 1 }
        ],
    Time [ tick = 200,
        onTick(dt: number) { app.n = app.n + 1 }
        ],
    Text [ text = { "" + app.n } ]
    ]
