#!/bin/sh
# A MAIN OR TAG PUSH IS A PUBLICATION. Review branches carry source only; their
# artifacts are derived when landing on main (CONTRIBUTING.md). For publication,
# this hook asks two read-only questions and REFUSES if
# either answer is wrong. It regenerates nothing, stages nothing, commits
# nothing, and runs no tests.
#
# This repo IS the distro — bundles/, runtime/dist, the baked index.html stubs,
# the prewarm cache, the production builds — and the push is the deploy (GitHub
# Pages serves what lands). So a release whose artifacts disagree with its
# sources is broken on arrival, while a local checkpoint that disagrees is
# simply a checkpoint. That asymmetry is the whole design: pre-commit checks
# nothing about derivation, and the line is held here.
#
# WHY IT REFUSES INSTEAD OF FIXING. An earlier version derived, `git add`ed the
# result, and then refused anyway — because a commit made inside pre-push is
# NOT part of the push it is intercepting: git has already resolved the refs
# and hands them to this hook on stdin, so a hook-made commit lands after the
# pushed SHA and would deploy one commit behind, silently, forever. Since it
# had to refuse regardless, doing ~20s of writes to your working tree first
# bought nothing and cost you an unrequested rebuild. Now the developer runs
# derive; this hook only ever says no.
#
# THE TWO QUESTIONS, and why one is not enough:
#   1. `--dry` — has every rule RUN since its inputs last changed? (a hash
#      compare against derive's ledger, ~0.4s, writes nothing, runs no rule.
#      Note what this does and does not know: inputs moved, so the artifacts
#      are UNVERIFIED — not necessarily different; re-running may prove them
#      byte-identical and only restamp the ledger)
#   2. `git status` on the derived OUTPUTS — is what is on disk what you are
#      PUBLISHING? `--dry` inspects the working tree; a push publishes HEAD, so
#      "derived but never committed" passes (1) and still deploys stale files.
#      This also catches the content-hash trap: derive writes a NEW path
#      (app.<hash>.js) that `git commit -am` cannot stage, so the deployed
#      index.html would 404 on its own bundle.
#
# `--outputs`, not `--paths`: stamped files (README, declare.md, index.html) are
# hand-authored around their markers, so uncommitted prose there is ordinary
# work, not an uncommitted artifact. The gap that leaves — a regenerated stamp
# deliberately left out of the commit — is caught by (1) on disk and by CI after
# the fact, and is worth it against refusing every push with an edited README.
#
# WHAT THIS HOOK DOES NOT DO: it does not verify the artifacts are CORRECT, only
# that they are current and committed. `--dry` compares declared-input hashes,
# and a rule's input list can lie by omission (derivation.md §5.1). The content
# gates — `npm run test:derived` — are the answer to that, run by you after a
# derive, and by CI on what actually reached the remote.
#
# Publication refs must resolve to HEAD: checking this worktree for a different
# pushed commit would certify the wrong artifacts. Annotated tags are peeled.
#
# Escape hatch: git push --no-verify (you own the consequence — and CI is the
# net under it).

# Git supplies local ref, local object, remote ref, remote object for EVERY
# update. Classify the destination, not the current or source branch. A mixed
# push must satisfy publication checks if even one destination publishes.
PUBLICATION=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA EXTRA; do
  if [ -z "$LOCAL_REF" ] || [ -z "$LOCAL_SHA" ] || [ -z "$REMOTE_REF" ] ||
     [ -z "$REMOTE_SHA" ] || [ -n "$EXTRA" ]; then
    echo "pre-push: malformed ref update; refusing unchecked push."
    exit 1
  fi
  case "$REMOTE_REF" in
    refs/heads/main|refs/heads/master|refs/tags/*) PUBLICATION=1 ;;
    refs/heads/*) continue ;;
    *) echo "pre-push: unknown destination $REMOTE_REF; refusing unchecked push."; exit 1 ;;
  esac
  case "$LOCAL_SHA" in
    *[!0]*) ;;
    *) echo "pre-push: refusing deletion of publication ref $REMOTE_REF."; exit 1 ;;
  esac
  PUSHED_COMMIT=$(git rev-parse --verify "${LOCAL_SHA}^{commit}" 2>/dev/null) || exit 1
  CHECKED_COMMIT=$(git rev-parse --verify HEAD 2>/dev/null) || exit 1
  if [ "$PUSHED_COMMIT" != "$CHECKED_COMMIT" ]; then
    echo "pre-push: $REMOTE_REF does not point to HEAD."
    echo "  Check out the published commit before checking its artifacts and pushing."
    exit 1
  fi
done
if [ "$PUBLICATION" -eq 0 ]; then
  echo "pre-push: review-only refs; derive artifacts when landing on main."
  exit 0
fi

# (1) is a verdict about the LEDGER, and the message must not claim more: --dry
# knows a rule's inputs moved since that rule last ran, not whether re-running
# it would change a byte (a prose edit under docs/ re-runs `assemble` and often
# leaves the model identical). Both honesty measures below exist because their
# absence cost a real debugging session (2026-08-19): the rule names were
# swallowed by >/dev/null, and the prescribed `git commit` had nothing to
# commit — so the refusal read as a mystery instead of as "derive, then push".
DRYOUT=$(node tools/internal/derive.mjs --dry 2>&1)
if [ $? -ne 0 ]; then
  echo ""
  echo "pre-push: some rules' INPUTS have changed since their artifacts were last"
  echo "          derived, so what this push would publish is unverified:"
  echo ""
  echo "$DRYOUT" | sed 's/^/    /'
  echo ""
  echo "    npm run derive"
  echo ""
  echo "  If that regenerates anything it stages its own outputs — commit them"
  echo "  (git commit -m 'derived artifacts') and push again. If it reports"
  echo "  '0 derived file(s) regenerated', the artifacts were already current and"
  echo "  only the ledger was behind — just push again."
  echo ""
  echo "  (git push --no-verify to override)"
  echo ""
  exit 1
fi

DIRTY=$(git status --porcelain -- $(node tools/internal/derive.mjs --outputs) 2>/dev/null)
if [ -n "$DIRTY" ]; then
  echo ""
  echo "pre-push: derived artifacts are fresh on disk but NOT COMMITTED, so this"
  echo "          push would publish the previous ones:"
  echo ""
  echo "$DIRTY" | sed 's/^/    /'
  echo ""
  echo "    git add \$(node tools/internal/derive.mjs --paths)"
  echo "    git commit -m 'derived artifacts'"
  echo ""
  echo "  then push again.  (git push --no-verify to override)"
  echo ""
  exit 1
fi

# (3) A BUMP IS A RELEASE. If package.json's version has no tag, this push
# publishes a release (release.mjs, run after the push lands) — so the notes
# it will be projected from must be here, committed, now. And notes for a
# version package.json does not declare are a declaration with no bump behind
# it. Read-only like (1) and (2): release.mjs --check inspects, never writes.
# Silent when nothing is pending, which is most pushes. (Whether the notes'
# STAMPS are fresh is (1)'s question — releases/ is a stamp target.)
RELOUT=$(node tools/internal/release.mjs --check 2>&1)
if [ $? -ne 0 ]; then
  echo ""
  echo "pre-push: this push would publish a release, and its declaration is incomplete:"
  echo ""
  echo "$RELOUT" | sed 's/^/    /'
  echo ""
  echo "  (RELEASING.md has the flow; git push --no-verify to override)"
  echo ""
  exit 1
fi
[ -n "$RELOUT" ] && echo "$RELOUT"

exit 0
