#!/bin/sh
# A COMMIT CHECKS. It regenerates nothing, and it WRITES NOTHING.
#
# A commit is a local checkpoint; the derived artifacts are the DISTRO — this
# repo is what gets served — and a distro only has to be coherent when it is
# PUBLISHED. So a commit may leave every derived artifact stale, deliberately,
# and this hook does not mention it: staleness at commit time is the designed
# state, and a note that fires on the normal condition is noise that teaches
# people to stop reading hook output. pre-push is where staleness is a defect,
# and it says so there with the commands to fix it.
#
# The one thing checked here is CANON, because it is cheap and because a
# non-canon file that reaches a commit is only ever found later by
# format.test.mjs, at the far end of a test run. This hook REFUSES; it does not
# format. Formatting on your behalf would rewrite the file you just reviewed,
# and — worse — `git add`-ing the result would stage work you deliberately left
# unstaged (a `git add -p` hunk plus later edits becomes one whole-file add).
# The index is yours; a hook that edits it is a hook that loses work.
#
# Committed + shared (not the per-clone .git/hooks/ copy). `npm install` wires it up via the
# package.json "prepare" script; to activate by hand: git config core.hooksPath tools/internal/hooks

# the .declare files THIS COMMIT stages (staged only — the whole corpus is
# format.test.mjs's business, and holding an unrelated commit to it would be
# holding an author to files they never touched)
DECLARE_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.declare' | grep -v '^docs/system-design/')
if [ -n "$DECLARE_FILES" ]; then
  if ! OUT=$(node tools/format.mjs --check $DECLARE_FILES 2>&1); then
    # name only the files the formatter refused — listing every staged file sent
    # one commit (2026-09-15) toward reformatting 37 files when one was off
    BAD=$(printf '%s\n' "$OUT" | sed -n 's/^not canon: //p' | tr '\n' ' ')
    if [ -n "$BAD" ]; then
      echo "pre-commit: staged .declare file(s) are not canon. Run:"
      echo ""
      echo "    node tools/format.mjs --write $BAD"
      echo ""
      echo "  then stage them and commit again.  (git commit --no-verify to override)"
    else
      # the formatter failed without naming a file (a parse error, a crash): its own words
      echo "pre-commit: the canon check failed:"
      printf '%s\n' "$OUT"
    fi
    exit 1
  fi
fi
exit 0
