# dependencies
node_modules/

# TypeScript incremental build cache
*.tsbuildinfo

# server /prod/ on-demand build cache (regenerated per request; the committed prebuilt/ is the real artifact).
# one dir per backend/variant — .prod-cache/, .prod-cache-canvas/, … — all regenerated, none committed.
.prod-cache*/

# porting scratch area (OL5 references + comparison goldens): local-only, deletable
workshop/

# eval run artifacts: per-run transcripts/sandboxes/metrics are local — only the
# generated evals/RESULTS.md scoreboard (and the tasks) are committed.
evals/runs/

# internal dev tools compiled locally: the .swift source is tracked, the built
# binary is a per-machine build artifact (macOS-only, regenerated with swiftc).
tools/internal/pointer

# your own scratch apps: the getting-started home (operational:getting-started,
# guide:loop) is yours, local, and never part of the distro — the committed
# examples live in apps/.
my-apps/

# misc
*.log
.DS_Store

# NOTE: dist/ is intentionally committed (per-area compiler/dist, runtime/dist) so the
# whole tree hosts and runs as-is, no build step — the OpenLaszlo distribution model.

# the dev supervisor's per-port reload handle (server/dev.mjs; `npm run build:dev` signals it)
server/.dev-reload.*.pid

# Gesture-diagnostics capture (tools/internal/measure/probe.js) — raw event
# batches, megabytes per session. The curated results.jsonl IS tracked.
tools/internal/measure/probe.jsonl

# the native Mac host's SwiftPM build tree: per-machine, regenerated by
# `swift build` (which also dirties .lock/build.db on every run). The .swift
# source, Package.swift, bundle.sh and the icon are tracked; the output is not.
mac-host/.build/

# the window-finder the native rigs share: winb.swift is tracked, the compiled
# helper is per-machine (win.mjs rebuilds it on demand) — same split as pointer.
mac-host/winb

# the assembled native host (mac-host/bundle.sh). Its sources are tracked; the
# .app is a per-machine build product, and it lands here so it self-locates the
# tree it was built from (Bridge.distroRoot).
mac-host/Declare Mac.app/

# derive's rule manifest + intermediates (tools/internal/derive.mjs): per-clone
# skip state and the extract→assemble handoff — regenerated, never committed.
.derive/
