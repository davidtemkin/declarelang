// d12: a Field's label beside a ProgressBar, a TextInput and a Slider. Where does the label sit?
App [ width = 460, height = 200, fill = white,
    View [ x = 20, y = 20, layout: SimpleLayout [ axis = y, spacing = 16 ],
        a: Field [ label = "Elapsed time", labelWidth = 100, ProgressBar [ width = 240, min = 0, max = 10, value = 4 ] ],
        b: Field [ label = "Start", labelWidth = 100, TextInput [ width = 160, value = "Start 14.11" ] ],
        c: Field [ label = "Duration", labelWidth = 100, Slider [ width = 240, min = 0, max = 10, value = 4 ] ] ] ]
