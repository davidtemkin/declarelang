/*
# Flight Booker

A one-way or return flight, a start date and a return date, and Book.
Dates are written day.month.year (14.11.2026). Each date field's text is
the task's own state; whether it holds a date, and whether Book can be
pressed, are derived from those texts, so the rules are stated once:

- the return date is editable only for a return flight;
- a field that doesn't hold a valid date is marked red and disables Book;
- for a return flight, a return date before the start date disables Book.
*/

script {
    function pad2(n: number): string { return n < 10 ? "0" + n : "" + n }

    // A day as the fields show it: "14.11.2026".
    function formatDay(y: number, m: number, d: number): string { return pad2(d) + "." + pad2(m) + "." + y }

    // "14.11.2026" (or "14.11.2026" with single digits, "4.1.2026") as a
    // comparable day number, yyyymmdd, or null when it is not a real date.
    function parseDay(t: string): number | null {
        const m = /^\s*(\d{1,2})\.(\d{1,2})\.(\d{4})\s*$/.exec(t)
        if (m == null) return null
        const d = Number(m[1]), mo = Number(m[2]), y = Number(m[3])
        const dt = new Date(y, mo - 1, d)
        if (dt.getFullYear() != y || dt.getMonth() != mo - 1 || dt.getDate() != d) return null
        return y * 10000 + mo * 100 + d
    }
    }


// A date field: red while what it holds is not a date.

class DateInput extends TextInput [ width = 140, placeholder = "dd.mm.yyyy",
    invalid: boolean = { !this.disabled && parseDay(this.text) == null },
    State [ applied = { parent.invalid }, stroke = { stroke(1.5, provided("theme").error) } ]
    ]


class FlightTask [ padding = 32,

    // ── the state: the kind of flight and the two fields' texts. Both dates
    //    start as today (a computed default, which becomes the person's own
    //    once they type).

    clock: Time [ tick = day ],
    today: string = { formatDay(this.clock.year, this.clock.month, this.clock.day) },
    kind: "oneway" | "return" = "oneway",
    startText: string = { classroot.today },
    returnText: string = { classroot.today },

    // ── what follows from it

    isReturn: boolean = { classroot.kind == "return" },
    start: number? = { parseDay(classroot.startText) },
    back: number? = { parseDay(classroot.returnText) },
    startValid: boolean = { classroot.start != null },
    backValid: boolean = { classroot.back != null },
    bothValid: boolean = { classroot.startValid && classroot.backValid },
    backBeforeStart: boolean = { classroot.isReturn && classroot.bothValid && classroot.back! < classroot.start! },
    returnOk: boolean = { !classroot.isReturn || (classroot.backValid && !classroot.backBeforeStart) },
    canBook: boolean = { classroot.startValid && classroot.returnOk },

    book() {
        if (!canBook) return
        const what = isReturn
            ? "You have booked a return flight on " + startText.trim() + ", returning on " + returnText.trim() + "."
            : "You have booked a one-way flight on " + startText.trim() + "."
        confirm.notice("Flight booked", what)
        },

    kinds: Menu [
        items = { [ ({ id: "oneway", label: "one-way flight", checked: !classroot.isReturn }),
                    ({ id: "return", label: "return flight", checked: classroot.isReturn }) ] },
        picked(id: string) { classroot.kind = id == "return" ? "return" : "oneway" }
        ],
    confirm: Dialog [ ],

    form: View [ width = 260,
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        Button [ width = 100%, accessibilityLabel = "Flight type", menu = { classroot.kinds },
            label = { classroot.isReturn ? "return flight" : "one-way flight" } ],
        View [ layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
            Text [ width = 60, text = "Start" ],
            DateInput [ accessibilityLabel = "Start date",
                value = { classroot.startText },
                commit(t: string) { classroot.startText = t }
                ]
            ],
        View [ layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
            Text [ width = 60, text = "Return" ],
            DateInput [ accessibilityLabel = "Return date", disabled = { !classroot.isReturn },
                value = { classroot.returnText },
                commit(t: string) { classroot.returnText = t }
                ]
            ],
        Text [ width = 100%, fontSize = 12, wrap = true, visible = { classroot.backBeforeStart },
            textColor = { provided("theme").error }, text = "The return date is before the start date." ],
        Button [ label = "Book", primary = true, disabled = { !classroot.canBook },
            onClick() { classroot.book() }
            ]
        ]
    ]
