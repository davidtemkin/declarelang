// A form built only while its sheet is present; a script checks it is gone after Save.
class Entry [ width = 100%, height = 200,
    send: Button [ label = "Save", onClick() { app.open = false } ] ]

App [ width = 600, height = 400,
    open: boolean = false,
    Button [ label = "Log", onClick() { app.open = true } ],
    sheet: Sheet [ edge = "end", sheetWidth = 300, accessibilityLabel = "Log",
        shown = { app.open }, commit(v: boolean) { app.open = v },
        form: Entry [ exists = { app.sheet.present } ] ] ]
