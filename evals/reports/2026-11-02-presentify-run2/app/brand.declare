/*
# Presentify: the look

The palette, the drawn icons, the logo, and the small controls the screen is
made of. `presentify.declare` includes this file.

The identity: warm paper chrome so the slide is always the brightest thing on
screen; Presentify violet for everything the person is acting on (the tool,
the selection, its handles); tangerine for the brand itself (the mark, the
Present button). Type is Bricolage Grotesque for the brand and headings, the
system face for controls.
*/

use [ AlignLeftIcon, AlignCenterIcon, AlignRightIcon ]

// ── Colours ─────────────────────────────────────────────────────────────────

theme Presentify [
    background = #F4F1EC, surface = #FFFFFF, card = #FFFFFF, canvas = #E7E2DA, sunk = #EDE8E0,
    line = #E4DED4, lineStrong = #D3CBBE, hover = #ECE7DF, selection = #E9E4FF,
    text = #1E1A2B, textMuted = #676174, textFaint = #9790A3,
    accent = #5B3DF5, accentHovered = #4E30E8, accentPressed = #4123D1, accentTextColor = #FFFFFF,
    linkColor = #5B3DF5,
    control = #FFFFFF, controlHovered = #F3EFE9, controlPressed = #E9E3D9, controlSelected = #EEE9FF,
    brand = #FF5A3C, brandHovered = #F24A2B, brandPressed = #DB3E21, brandSoft = #FFE6DF,
    sun = #FFC23D, mint = #22B892, sky = #3D9BFF,
    handle = #5B3DF5, guide = #FF3D8B,
    danger = #E5484D, dangerSoft = #FDECEC, ok = #1F9D68, warn = #C26A00, warnSoft = #FFF3DC,
    tooltipFill = #1E1A2B, tooltipTextColor = #F7F5F2
    ]


// ── Icons ───────────────────────────────────────────────────────────────────
//
// One pen for every mark: a 1.6 stroke with round ends on a 16-unit grid,
// scaled by `Icon` to its size with the stroke kept crisp.

class Glyph extends Icon [
    shape: string = "",
    draw(d: DrawContext) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        if (shape == "select") {            // an arrow pointer
            d.moveTo(4, 2); d.lineTo(4, 13.5); d.lineTo(6.8, 10.8); d.lineTo(8.8, 14.6); d.lineTo(10.6, 13.7)
            d.lineTo(8.7, 10); d.lineTo(12.4, 10); d.closePath(); d.stroke()
        } else if (shape == "rect") {
            d.roundRect(2, 3.5, 12, 9, 1.6); d.stroke()
        } else if (shape == "ellipse") {
            d.ellipse(8, 8, 6, 5, 0, 0, 6.3); d.stroke()
        } else if (shape == "line") {
            d.moveTo(2.8, 13.2); d.lineTo(13.2, 2.8); d.stroke()
        } else if (shape == "text") {
            d.moveTo(3, 4); d.lineTo(3, 2.8); d.lineTo(13, 2.8); d.lineTo(13, 4)
            d.moveTo(8, 2.8); d.lineTo(8, 13.4); d.moveTo(6, 13.4); d.lineTo(10, 13.4); d.stroke()
        } else if (shape == "undo") {
            d.moveTo(5.5, 3); d.lineTo(2.5, 6); d.lineTo(5.5, 9)
            d.moveTo(2.5, 6); d.lineTo(10, 6); d.bezierCurveTo(12.5, 6, 14, 7.8, 14, 9.8); d.bezierCurveTo(14, 11.8, 12.5, 13.5, 10, 13.5)
            d.lineTo(7, 13.5); d.stroke()
        } else if (shape == "redo") {
            d.moveTo(10.5, 3); d.lineTo(13.5, 6); d.lineTo(10.5, 9)
            d.moveTo(13.5, 6); d.lineTo(6, 6); d.bezierCurveTo(3.5, 6, 2, 7.8, 2, 9.8); d.bezierCurveTo(2, 11.8, 3.5, 13.5, 6, 13.5)
            d.lineTo(9, 13.5); d.stroke()
        } else if (shape == "plus") {
            d.moveTo(8, 3); d.lineTo(8, 13); d.moveTo(3, 8); d.lineTo(13, 8); d.stroke()
        } else if (shape == "back") {
            d.moveTo(10, 3); d.lineTo(5, 8); d.lineTo(10, 13); d.stroke()
        } else if (shape == "play") {
            d.moveTo(4.5, 2.8); d.lineTo(13, 8); d.lineTo(4.5, 13.2); d.closePath(); d.fill(); d.stroke()
        } else if (shape == "trash") {
            d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(6, 4); d.lineTo(6.5, 2); d.lineTo(9.5, 2); d.lineTo(10, 4)
            d.moveTo(3.8, 4); d.lineTo(4.6, 14); d.lineTo(11.4, 14); d.lineTo(12.2, 4); d.stroke()
        } else if (shape == "copy") {
            d.roundRect(5, 5, 9, 9, 1.6); d.moveTo(11, 3.5); d.lineTo(11, 3); d.arcTo(11, 2, 10, 2, 1)
            d.lineTo(3, 2); d.arcTo(2, 2, 2, 3, 1); d.lineTo(2, 10); d.arcTo(2, 11, 3, 11, 1); d.lineTo(3.5, 11); d.stroke()
        } else if (shape == "more") {
            for (const x of [3.5, 8, 12.5]) { d.moveTo(x + 1.1, 8); d.arc(x, 8, 1.1, 0, 6.3) }
            d.fill()
        } else if (shape == "alignLeft") {
            d.moveTo(2.5, 2); d.lineTo(2.5, 14); d.stroke(); d.beginPath()
            d.roundRect(4.5, 4, 9, 3, 0.8); d.roundRect(4.5, 9, 5.5, 3, 0.8); d.fill()
        } else if (shape == "alignCenter") {
            d.moveTo(8, 2); d.lineTo(8, 14); d.stroke(); d.beginPath()
            d.roundRect(3, 4, 10, 3, 0.8); d.roundRect(5, 9, 6, 3, 0.8); d.fill()
        } else if (shape == "alignRight") {
            d.moveTo(13.5, 2); d.lineTo(13.5, 14); d.stroke(); d.beginPath()
            d.roundRect(2.5, 4, 9, 3, 0.8); d.roundRect(6, 9, 5.5, 3, 0.8); d.fill()
        } else if (shape == "alignTop") {
            d.moveTo(2, 2.5); d.lineTo(14, 2.5); d.stroke(); d.beginPath()
            d.roundRect(4, 4.5, 3, 9, 0.8); d.roundRect(9, 4.5, 3, 5.5, 0.8); d.fill()
        } else if (shape == "alignMiddle") {
            d.moveTo(2, 8); d.lineTo(14, 8); d.stroke(); d.beginPath()
            d.roundRect(4, 3, 3, 10, 0.8); d.roundRect(9, 5, 3, 6, 0.8); d.fill()
        } else if (shape == "alignBottom") {
            d.moveTo(2, 13.5); d.lineTo(14, 13.5); d.stroke(); d.beginPath()
            d.roundRect(4, 2.5, 3, 9, 0.8); d.roundRect(9, 6, 3, 5.5, 0.8); d.fill()
        } else if (shape == "distH") {
            d.moveTo(2, 2); d.lineTo(2, 14); d.moveTo(14, 2); d.lineTo(14, 14); d.stroke(); d.beginPath()
            d.roundRect(6.5, 4, 3, 8, 0.8); d.fill()
        } else if (shape == "distV") {
            d.moveTo(2, 2); d.lineTo(14, 2); d.moveTo(2, 14); d.lineTo(14, 14); d.stroke(); d.beginPath()
            d.roundRect(4, 6.5, 8, 3, 0.8); d.fill()
        } else if (shape == "front") {         // the front square solid, over an outline
            d.roundRect(2, 2, 8, 8, 1.4); d.stroke(); d.beginPath(); d.roundRect(6, 6, 8, 8, 1.4); d.fill()
        } else if (shape == "forward") {
            d.roundRect(2, 2, 8, 8, 1.4); d.stroke(); d.beginPath(); d.roundRect(6, 6, 8, 8, 1.4); d.stroke()
            d.beginPath(); d.moveTo(10, 8.5); d.lineTo(10, 12.5); d.moveTo(8, 10.5); d.lineTo(12, 10.5); d.stroke()
        } else if (shape == "backward") {
            d.roundRect(6, 6, 8, 8, 1.4); d.stroke(); d.beginPath(); d.roundRect(2, 2, 8, 8, 1.4); d.stroke()
            d.beginPath(); d.moveTo(4, 6); d.lineTo(8, 6); d.stroke()
        } else if (shape == "back2") {          // send to back: the back square solid
            d.roundRect(2, 2, 8, 8, 1.4); d.fill(); d.beginPath(); d.roundRect(6, 6, 8, 8, 1.4)
            d.stroke()
        } else if (shape == "group") {
            d.setLineDash([1.6, 1.8]); d.roundRect(1.5, 1.5, 13, 13, 2); d.stroke(); d.setLineDash([])
            d.beginPath(); d.roundRect(4, 4, 4.5, 4.5, 1); d.roundRect(8, 8, 4.5, 4.5, 1); d.stroke()
        } else if (shape == "ungroup") {
            d.roundRect(2, 2, 6, 6, 1.2); d.roundRect(8, 8, 6, 6, 1.2); d.stroke()
        } else if (shape == "chain") {          // keep proportions
            d.roundRect(1.8, 5.6, 7.4, 4.8, 2.4); d.roundRect(6.8, 5.6, 7.4, 4.8, 2.4); d.stroke()
        } else if (shape == "italic") {
            d.moveTo(7, 3); d.lineTo(12, 3); d.moveTo(4, 13); d.lineTo(9, 13); d.moveTo(9.6, 3); d.lineTo(6.4, 13); d.stroke()
        } else if (shape == "check") {
            d.moveTo(3, 8.5); d.lineTo(6.5, 12); d.lineTo(13, 4.5); d.stroke()
        } else if (shape == "cloudOff") {
            d.moveTo(4.5, 12.5); d.bezierCurveTo(2.5, 12.5, 1.5, 11, 1.5, 9.6); d.bezierCurveTo(1.5, 8, 2.8, 6.8, 4.4, 6.8)
            d.bezierCurveTo(5, 4.6, 6.6, 3.4, 8.6, 3.4); d.bezierCurveTo(11, 3.4, 12.6, 5.2, 12.8, 7.2)
            d.bezierCurveTo(14, 7.5, 14.6, 8.6, 14.6, 9.8); d.bezierCurveTo(14.6, 11.3, 13.4, 12.5, 11.8, 12.5); d.closePath()
            d.moveTo(2, 2); d.lineTo(14, 14); d.stroke()
        } else if (shape == "warn") {
            d.moveTo(8, 2); d.lineTo(14.5, 13.5); d.lineTo(1.5, 13.5); d.closePath(); d.stroke(); d.beginPath()
            d.moveTo(8, 6.2); d.lineTo(8, 9.2); d.stroke(); d.beginPath(); d.arc(8, 11.4, 0.9, 0, 6.3); d.fill()
        } else if (shape == "close") {
            d.moveTo(4, 4); d.lineTo(12, 12); d.moveTo(12, 4); d.lineTo(4, 12); d.stroke()
        } else if (shape == "none") {           // no colour: a slashed circle
            d.arc(8, 8, 6, 0, 6.3); d.moveTo(3.8, 12.2); d.lineTo(12.2, 3.8); d.stroke()
        }
        }
    ]


// The text-alignment marks, named as classes so a Segmented can show them.

class AlignLeftIcon extends Icon [
    draw(d: DrawContext) {
        d.scale(unit, unit); d.strokeStyle = ink; d.lineWidth = weight / unit; d.lineCap = "round"; d.beginPath()
        d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(2.5, 8); d.lineTo(10, 8); d.moveTo(2.5, 12); d.lineTo(12, 12); d.stroke()
        }
    ]


class AlignCenterIcon extends Icon [
    draw(d: DrawContext) {
        d.scale(unit, unit); d.strokeStyle = ink; d.lineWidth = weight / unit; d.lineCap = "round"; d.beginPath()
        d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(4.5, 8); d.lineTo(11.5, 8); d.moveTo(3.5, 12); d.lineTo(12.5, 12); d.stroke()
        }
    ]


class AlignRightIcon extends Icon [
    draw(d: DrawContext) {
        d.scale(unit, unit); d.strokeStyle = ink; d.lineWidth = weight / unit; d.lineCap = "round"; d.beginPath()
        d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(6, 8); d.lineTo(13.5, 8); d.moveTo(4, 12); d.lineTo(13.5, 12); d.stroke()
        }
    ]


// ── The mark ────────────────────────────────────────────────────────────────
//
// A tangerine slide, tilted, with a violet spark breaking out of its corner:
// a presentation with something in it.

class LogoMark [ width = 28, height = 28,
    draw(d: DrawContext) {
        const s = d.w / 28
        d.scale(s, s)
        d.save()
        d.translate(14, 15)
        d.rotate(-0.12)
        d.fillStyle = provided("theme").brand
        d.beginPath(); d.roundRect(-12, -9, 24, 17, 4.5); d.fill()
        d.fillStyle = 0xFFFFFF
        d.beginPath(); d.roundRect(-7.5, -4, 9, 2.6, 1.3); d.roundRect(-7.5, 0.6, 5.5, 2.6, 1.3); d.fill()
        d.restore()
        d.fillStyle = provided("theme").accent
        d.beginPath()
        d.moveTo(22, 1.5); d.lineTo(23.6, 6.4); d.lineTo(28, 8); d.lineTo(23.6, 9.6); d.lineTo(22, 14.5)
        d.lineTo(20.4, 9.6); d.lineTo(16, 8); d.lineTo(20.4, 6.4); d.closePath(); d.fill()
        }
    ]


// The wordmark: the mark and the name, in the brand face.

class Wordmark [ height = 28,
    size: number = 22,
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    LogoMark [ width = { classroot.size * 1.25 }, height = { classroot.size * 1.25 } ],
    TextLabel [ fontFamily = { app.brandFace }, fontSize = { classroot.size }, fontWeight = 800, letterSpacing = -0.4,
        textColor = { provided("theme").text }, text = "Presentify" ]
    ]


// ── Small controls ──────────────────────────────────────────────────────────

// A square icon button. `on` lights it as a chosen tool or a set toggle.

class IconButton extends Control [ width = 32, height = 32, cornerRadius = 8,
    shape: string = "",
    on: boolean = false,
    tone: Color = { provided("theme").text },
    tooltipLabel = { this.accessibilityLabel },
    accessibilityPressed = { on },
    cursor = "pointer",
    fill = { hovered || pressed ? provided("theme").hover : null },
    State [ applied = { classroot.on }, fill = { provided("theme").controlSelected } ],
    opacity = { disabled ? 0.35 : 1 },
    Glyph [ x = center, y = center, iconSize = 16, weight = 1.6, shape = { classroot.shape },
        ink = { classroot.on ? provided("theme").accent : classroot.tone } ]
    ]


// A tool in the toolbar: an icon, its name under the pointer, lit when chosen.

class ToolPick extends Control [ width = 40, height = 36, cornerRadius = 9,
    shape: string = "",
    choice: string = "",
    on: boolean = { (parent as RadioGroup).value == choice },
    press() { (parent as RadioGroup).pick(choice) },
    accessibilityRole = radio,
    accessibilityChecked = { on },
    tooltipLabel = { this.accessibilityLabel },
    cursor = "pointer",
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").hover : null },
    State [ applied = { classroot.on }, fill = { provided("theme").accent } ],
    Glyph [ x = center, y = center, iconSize = 18, weight = 1.7, shape = { classroot.shape },
        ink = { classroot.on ? 0xFFFFFF : provided("theme").text } ]
    ]


// A pill-shaped button with an icon and a word.

class PillButton extends Control [ height = 34, cornerRadius = 17, padding = [0, 14, 0, 11],
    label: string = "",
    shape: string = "",
    tone: "brand" | "accent" | "quiet" = "quiet",
    accessibilityLabel = { label },
    cursor = "pointer",
    base: Color = { tone == "brand" ? provided("theme").brand : tone == "accent" ? provided("theme").accent : provided("theme").control },
    fill = { classroot.base },
    State [ applied = { hovered }, fill = { classroot.tone == "brand" ? provided("theme").brandHovered
        : classroot.tone == "accent" ? provided("theme").accentHovered : provided("theme").controlHovered } ],
    State [ applied = { pressed }, fill = { classroot.tone == "brand" ? provided("theme").brandPressed
        : classroot.tone == "accent" ? provided("theme").accentPressed : provided("theme").controlPressed } ],
    stroke = { tone == "quiet" ? stroke(1, provided("theme").line) : null },
    shadow = { tone == "quiet" ? null : shadow(0, 2, 6, 0x1E1A2B33) },
    opacity = { disabled ? 0.45 : 1 },
    ink: Color = { tone == "quiet" ? provided("theme").text : 0xFFFFFF },
    layout: SimpleLayout [ axis = x, spacing = 7, align = center ],
    Glyph [ visible = { classroot.shape != "" }, iconSize = 14, weight = 1.8, shape = { classroot.shape }, ink = { classroot.ink } ],
    TextLabel [ fontSize = 13.5, fontWeight = semibold, wrap = false, textColor = { classroot.ink }, text = { classroot.label } ]
    ]


// A colour well: the colour, or a slashed circle for none, or a split for
// "these differ". Pressing it opens the shared colour picker.

class ColorWell extends Control [ width = 36, height = 28, cornerRadius = 7,
    color: string = "",          // "" for none
    mixed: boolean = false,
    allowNone: boolean = true,
    cursor = "pointer",
    tooltipLabel = { this.accessibilityLabel },
    fill = { provided("theme").control },
    stroke = { stroke(1, hovered ? provided("theme").lineStrong : provided("theme").line) },
    chip: View [ x = 4, y = 4, width = { parent.width - 8 }, height = { parent.height - 8 }, cornerRadius = 4,
        visible = { !classroot.mixed && classroot.color != "" },
        fill = { app.paint(classroot.color) },
        stroke = { stroke(1, 0x00000018) } ],
    none: Glyph [ x = center, y = center, iconSize = 15, weight = 1.4, shape = "none", ink = { provided("theme").danger },
        visible = { !classroot.mixed && classroot.color == "" } ],
    many: View [ x = 4, y = 4, width = { parent.width - 8 }, height = { parent.height - 8 }, cornerRadius = 4,
        visible = { classroot.mixed },
        fill = { gradient("135deg", 0xFF5A3C, 0xFFC23D, 0x22B892, 0x3D9BFF, 0x5B3DF5) } ]
    ]


// A label over a group of inspector controls.

class SectionTitle [ width = 100%, height = 18,
    label: string = "",
    note: string = "",
    layout: SimpleLayout [ axis = x, align = center ],
    TextLabel [ flexes = true, fontSize = 11, fontWeight = bold, letterSpacing = 0.6, wrap = false,
        textColor = { provided("theme").textFaint }, text = { classroot.label.toUpperCase() } ],
    TextLabel [ fontSize = 11.5, fontWeight = medium, wrap = false, textColor = { provided("theme").accent },
        text = { classroot.note } ]
    ]


// A row in the inspector: a word, then its controls.

class PropRow [ width = 100%, height = 32,
    label: string = "",
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    TextLabel [ width = 74, fontSize = 12.5, wrap = false, textColor = { provided("theme").textMuted }, text = { classroot.label } ]
    ]
