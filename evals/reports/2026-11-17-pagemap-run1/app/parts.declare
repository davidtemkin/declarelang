/*
# Pagemap: the look

Two themes laid over the library's SanFrancisco records, the drawn icons, and the small
pieces every panel is made of: a panel heading, a quiet text button, a chip, a color
swatch, an avatar. Nothing here knows about flatplans.
*/

use [ SunIcon, MoonIcon, AutoIcon ]

theme PagemapLight [
    background = #F3F2EF, surface = #FFFFFF, card = #FFFFFF, canvas = #E9E7E2, sunken = #F7F6F3,
    line = #E2DFD9, lineStrong = #CBC7BF, hover = #F0EEEA, selection = #E6ECFB,
    text = #1E1D1B, textMuted = #66635D, textFaint = #8E8A82,
    accent = #2F5BD8, linkColor = #2F5BD8, chosen = #2F5BD8, chosenSoft = #2F5BD833,
    paper = #FFFFFF, paperLine = #D9D5CD, open = #F4F3F0, openInk = #9A968E,
    adFill = #F6E4E1, adStripe = #E3B5AE, adInk = #8C3B30,
    danger = #C8372D, warn = #B26A00, good = #23855A, okSoft = #E3F3EA, badSoft = #FBE6E4, warnSoft = #FBF0DC,
    flash = #FFD84D, dropMark = #E0442F, dropOk = #23855A
    ]


theme PagemapDark [
    background = #161618, surface = #1F1F22, card = #252528, canvas = #111113, sunken = #1A1A1C,
    line = #2E2E32, lineStrong = #46464C, hover = #2A2A2E, selection = #23304F,
    text = #EDECEA, textMuted = #A6A39D, textFaint = #7D7A74,
    accent = #6E95FF, linkColor = #6E95FF, chosen = #7EA2FF, chosenSoft = #7EA2FF40,
    paper = #F4F2EE, paperLine = #4A4A50, open = #2A2A2E, openInk = #8E8A84,
    adFill = #3A2522, adStripe = #6A3A33, adInk = #F0B0A6,
    danger = #FF6F63, warn = #FFB547, good = #4CC38A, okSoft = #1D3328, badSoft = #3B2120, warnSoft = #3A2E17,
    flash = #FFD84D, dropMark = #FF6F63, dropOk = #4CC38A
    ]


// ── Icons: one pen, 16-unit grid ────────────────────────────────────────────

class Glyph extends Icon [
    shape: string = "",
    draw(d: DrawContext) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        if (shape == "panel") { d.roundRect(2, 3, 12, 10, 1.5); d.moveTo(6, 3); d.lineTo(6, 13); d.stroke() }
        else if (shape == "inspector") { d.roundRect(2, 3, 12, 10, 1.5); d.moveTo(10, 3); d.lineTo(10, 13); d.stroke() }
        else if (shape == "undo") { d.moveTo(5, 4); d.lineTo(2.5, 6.5); d.lineTo(5, 9); d.moveTo(2.5, 6.5); d.lineTo(10, 6.5); d.arc(10, 9.5, 3, -Math.PI / 2, Math.PI / 2); d.lineTo(7, 12.5); d.stroke() }
        else if (shape == "redo") { d.moveTo(11, 4); d.lineTo(13.5, 6.5); d.lineTo(11, 9); d.moveTo(13.5, 6.5); d.lineTo(6, 6.5); d.arc(6, 9.5, 3, -Math.PI / 2, Math.PI / 2, true); d.lineTo(9, 12.5); d.stroke() }
        else if (shape == "search") { d.arc(7, 7, 4.5, 0, 6.3); d.moveTo(10.4, 10.4); d.lineTo(14, 14); d.stroke() }
        else if (shape == "close") { d.moveTo(4, 4); d.lineTo(12, 12); d.moveTo(12, 4); d.lineTo(4, 12); d.stroke() }
        else if (shape == "more") { for (const x of [3.5, 8, 12.5]) { d.moveTo(x + 1.1, 8); d.arc(x, 8, 1.1, 0, 6.3) } d.fill() }
        else if (shape == "lock") { d.roundRect(3.5, 7, 9, 7, 1.5); d.moveTo(5.5, 7); d.lineTo(5.5, 5); d.arc(8, 5, 2.5, Math.PI, 0); d.lineTo(10.5, 7); d.stroke() }
        else if (shape == "unlock") { d.roundRect(3.5, 7, 9, 7, 1.5); d.moveTo(5.5, 7); d.lineTo(5.5, 5); d.arc(8, 5, 2.5, Math.PI, -0.3); d.stroke() }
        else if (shape == "note") { d.moveTo(3, 2.5); d.lineTo(10, 2.5); d.lineTo(13, 5.5); d.lineTo(13, 13.5); d.lineTo(3, 13.5); d.closePath(); d.moveTo(5.5, 8); d.lineTo(10.5, 8); d.moveTo(5.5, 10.5); d.lineTo(9, 10.5); d.stroke() }
        else if (shape == "comment") { d.moveTo(2.5, 3); d.lineTo(13.5, 3); d.lineTo(13.5, 10.5); d.lineTo(7, 10.5); d.lineTo(4, 13.5); d.lineTo(4, 10.5); d.lineTo(2.5, 10.5); d.closePath(); d.stroke() }
        else if (shape == "image") { d.roundRect(2, 3, 12, 10, 1.5); d.moveTo(2.5, 11.5); d.lineTo(6, 8); d.lineTo(9, 11); d.lineTo(10.5, 9.5); d.lineTo(13.5, 12.5); d.stroke(); d.beginPath(); d.arc(10.5, 6, 1.2, 0, 6.3); d.fill() }
        else if (shape == "plus") { d.moveTo(8, 3); d.lineTo(8, 13); d.moveTo(3, 8); d.lineTo(13, 8); d.stroke() }
        else if (shape == "chevron") { d.moveTo(5, 6.5); d.lineTo(8, 9.5); d.lineTo(11, 6.5); d.stroke() }
        else if (shape == "right") { d.moveTo(6.5, 4); d.lineTo(10.5, 8); d.lineTo(6.5, 12); d.stroke() }
        else if (shape == "left") { d.moveTo(9.5, 4); d.lineTo(5.5, 8); d.lineTo(9.5, 12); d.stroke() }
        else if (shape == "grip") { for (const y of [5, 8, 11]) for (const x of [6, 10]) { d.moveTo(x + 0.9, y); d.arc(x, y, 0.9, 0, 6.3) } d.fill() }
        else if (shape == "book") { d.moveTo(8, 4); d.lineTo(8, 13.5); d.moveTo(8, 4); d.quadraticCurveTo(5, 2.5, 2, 3.5); d.lineTo(2, 12.5); d.quadraticCurveTo(5, 11.5, 8, 13.5); d.quadraticCurveTo(11, 11.5, 14, 12.5); d.lineTo(14, 3.5); d.quadraticCurveTo(11, 2.5, 8, 4); d.stroke() }
        else if (shape == "upload") { d.moveTo(8, 11); d.lineTo(8, 2.5); d.moveTo(4.5, 6); d.lineTo(8, 2.5); d.lineTo(11.5, 6); d.moveTo(2.5, 10); d.lineTo(2.5, 13.5); d.lineTo(13.5, 13.5); d.lineTo(13.5, 10); d.stroke() }
        else if (shape == "share") { d.moveTo(8, 10); d.lineTo(8, 2.5); d.moveTo(5, 5.5); d.lineTo(8, 2.5); d.lineTo(11, 5.5); d.moveTo(5.5, 7.5); d.lineTo(3, 7.5); d.lineTo(3, 13.5); d.lineTo(13, 13.5); d.lineTo(13, 7.5); d.lineTo(10.5, 7.5); d.stroke() }
        else if (shape == "grid") { d.rect(2.5, 3, 5, 10); d.rect(8.5, 3, 5, 10); d.stroke() }
        else if (shape == "trash") { d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(6, 4); d.lineTo(6.5, 2); d.lineTo(9.5, 2); d.lineTo(10, 4); d.moveTo(3.8, 4); d.lineTo(4.6, 14); d.lineTo(11.4, 14); d.lineTo(12.2, 4); d.stroke() }
        else if (shape == "rotate") { d.arc(8, 8.5, 4.5, -2.4, 2.6); d.moveTo(4.2, 2.5); d.lineTo(4.4, 5.6); d.lineTo(7.4, 5.2); d.stroke() }
        else if (shape == "flip") { d.moveTo(8, 2); d.lineTo(8, 14); d.moveTo(6, 4); d.lineTo(2.5, 12); d.lineTo(6, 12); d.closePath(); d.moveTo(10, 4); d.lineTo(13.5, 12); d.lineTo(10, 12); d.closePath(); d.stroke() }
        else if (shape == "stack") { d.moveTo(2.5, 6); d.lineTo(8, 3); d.lineTo(13.5, 6); d.lineTo(8, 9); d.closePath(); d.moveTo(2.5, 9); d.lineTo(8, 12); d.lineTo(13.5, 9); d.stroke() }
        else if (shape == "print") { d.rect(4.5, 2.5, 7, 4); d.roundRect(2, 6.5, 12, 5.5, 1); d.rect(4.5, 10, 7, 4); d.stroke() }
        else { d.arc(8, 8, 5, 0, 6.3); d.stroke() }
        }
    ]


// A round icon control: toolbars, headers.

class IconButton extends Control [ width = { app.tap }, height = { app.tap }, cornerRadius = 7,
    shape: string = "",
    tone: Color = gray,
    on: boolean = false,
    tooltipLabel = { this.accessibilityLabel },
    fill = { pressed ? provided("theme").selection : hovered ? provided("theme").hover : null },
    State [ applied = { classroot.on }, fill = { provided("theme").selection } ],
    Glyph [ x = center, y = center, iconSize = 16, weight = 1.6, shape = { classroot.shape },
        ink = { classroot.disabled ? provided("theme").textFaint : classroot.tone } ]
    ]


// A small text button: the inspector's and the panels' actions.

class Act extends Control [ height = { app.tap }, cornerRadius = 7, padding = [0, 10, 0, 10],
    label: string = "",
    tone: string = "plain",
    accessibilityLabel = { classroot.label },
    stroke = { Stroke(1, provided("theme").line) },
    fill = { pressed ? provided("theme").selection : hovered ? provided("theme").hover : provided("theme").surface },
    State [ applied = { classroot.tone == "primary" }, stroke = null,
        fill = { pressed ? provided("theme").accentPressed : hovered ? provided("theme").accentHovered : provided("theme").accent } ],
    TextLabel [ y = center, x = center, fontSize = 13, fontWeight = medium, wrap = false, text = { classroot.label },
        textColor = { classroot.disabled ? provided("theme").textFaint : classroot.tone == "primary" ? 0xFFFFFF : classroot.tone == "danger" ? provided("theme").danger : provided("theme").text } ]
    ]


// A panel's small capital heading.

class Caps extends Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 0.6, wrap = false,
    textColor = { provided("theme").textFaint }
    ]


// A dot of color.

class Dot [ width = 10, height = 10, cornerRadius = { this.width / 2 },
    tone: string = "#888888",
    fill = { Color.from(classroot.tone) }
    ]


// A person, as initials in their color.

class Avatar [ width = 26, height = 26, cornerRadius = { this.width / 2 },
    initials: string = "",
    tone: string = "#888888",
    fill = { Color.from(classroot.tone) },
    TextLabel [ x = center, y = center, fontSize = { Math.max(9, classroot.width * 0.4) }, fontWeight = bold,
        textColor = 0x1E1D1B, text = { classroot.initials } ]
    ]


// A labelled row in the inspector: a caption above what it describes.

class Row [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 6 ],
    caption: string = "",
    Caps [ visible = { classroot.caption != "" }, text = { classroot.caption } ]
    ]


// A titled block of a panel.

class Block [ width = 100%, padding = [12, 14, 14, 14],
    title: string = "",
    stroke = { [null, null, Stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = y, spacing = 10 ],
    Caps [ visible = { classroot.title != "" }, text = { classroot.title } ]
    ]
