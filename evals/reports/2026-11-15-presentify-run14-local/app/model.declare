/*
# Presentify: the model

What a presentation is, and every write to one. Nothing here draws.

- **The shapes of the data** are the service's (task/api/API.md): a `Deck`, its
  `Slide`s, and the `El`ements on each. Field names and types are exactly the
  service's, because a slide is saved whole and the service refuses a field it
  does not define.
- **Geometry** is plain functions of their arguments, in `script`: the box of an
  element, moving and resizing one, grouping, aligning, ordering. Each takes an
  element tree and returns a new one; none of them keeps state.
- **`Doc`** is the open presentation: the deck and its slides in order. Every
  change to the presentation is one of its verbs, and each verb tells the save
  engine (`Sync`) which slide it touched.
- **`History`** is undo and redo: a list of steps, each the slide (or the slide
  list) as it was before and after one thing the person did.
- **`Sync`** gets every change to the service, one request at a time, and says
  which of the three save states is true.
*/

// ── The shapes of the data ──────────────────────────────────────────────────

schema Outline [ color: string, width: number ]
schema TextRun [ content: string, font: string, size: number, weight: number, italic: boolean,
    color: string, align: "left" | "center" | "right" ]

// One schema for every kind: a field one kind has and another lacks is optional.
// A group's `children` are elements again.

schema El [ id: string, kind: "rect" | "ellipse" | "line" | "text" | "group",
    x?: number, y?: number, width?: number, height?: number,
    fill?: string, stroke?: Outline, cornerRadius?: number, keepProportions?: boolean,
    x1?: number, y1?: number, x2?: number, y2?: number,
    text?: TextRun, children[]?: El ]

schema Slide [ id: string, deckId: string, version: number, background: string, elements[]: El ]
schema Deck [ id: string, title: string, version: number, updatedAt: string,
    slideOrder[]: string, thumbnailSlideId: string ]
schema DeckRow [ id: string, title: string, updatedAt: string, slideCount: number, thumbnailSlideId: string ]

// What the service sends back, and what it says when it refuses.

schema DeckList [ decks[]: DeckRow ]
schema SlideList [ slides[]: Slide ]
schema Opened [ deck: Deck, slides[]: Slide ]
schema Refusal [ error: string, message: string, field?: string ]

// The editor's own records.

schema Bounds [ x: number, y: number, w: number, h: number ]
schema Body [ background: string, elements[]: El ]
schema DocValue [ deck?: Deck, slides[]: Slide ]

// One undo step. "slide": a slide's content before and after. "insert" and
// "remove": a whole slide added or taken away at `index`. "order": the slide
// list's order before and after.

schema Step [ kind: "slide" | "insert" | "remove" | "order", slide: string,
    before?: Body, after?: Body, index?: number, data?: Slide,
    order[]?: string, orderAfter[]?: string,
    sel[]: string, selAfter[]: string, current: string ]


// ── Geometry ────────────────────────────────────────────────────────────────

script {
    type Elt = El
    type Bx = Bounds

    const W = 1280, H = 720

    let idSeed = 0
    function newId(prefix: string): string {
        idSeed = idSeed + 1
        return prefix + Date.now().toString(36).slice(-5) + Math.random().toString(36).slice(2, 6) + idSeed.toString(36)
    }

    function round1(n: number): number { return Math.round(n * 10) / 10 }

    // The box of an element: a line's is the box its ends span; a group's,
    // its children's together.
    function boxOf(e: Elt): Bx {
        if (e.kind == "line") {
            const x = Math.min(e.x1!, e.x2!), y = Math.min(e.y1!, e.y2!)
            return { x: x, y: y, w: Math.abs(e.x2! - e.x1!), h: Math.abs(e.y2! - e.y1!) }
        }
        if (e.kind == "group") return unionOf((e.children ?? []).map(boxOf))
        return { x: e.x ?? 0, y: e.y ?? 0, w: e.width ?? 0, h: e.height ?? 0 }
    }
    function unionOf(bs: Bx[]): Bx {
        if (bs.length == 0) return { x: 0, y: 0, w: 0, h: 0 }
        let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity
        for (const b of bs) { x0 = Math.min(x0, b.x); y0 = Math.min(y0, b.y); x1 = Math.max(x1, b.x + b.w); y1 = Math.max(y1, b.y + b.h) }
        return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
    }
    function touches(a: Bx, b: Bx): boolean {
        return a.x <= b.x + b.w && b.x <= a.x + a.w && a.y <= b.y + b.h && b.y <= a.y + a.h
    }

    // Every element, groups and their insides, depth first.
    function walk(els: Elt[], out: Elt[] = []): Elt[] {
        for (const e of els) { out.push(e); if (e.kind == "group") walk(e.children ?? [], out) }
        return out
    }
    function find(els: Elt[], id: string): Elt | null { return walk(els).find((e) => e.id == id) ?? null }

    // The chain of ids from the top of the slide down to `id`.
    function chainTo(els: Elt[], id: string): string[] {
        for (const e of els) {
            if (e.id == id) return [e.id]
            if (e.kind == "group") { const c = chainTo(e.children ?? [], id); if (c.length > 0) return [e.id, ...c] }
        }
        return []
    }
    // The list `id` sits in (the slide's, or a group's children).
    function siblingsOf(els: Elt[], id: string): Elt[] {
        if (els.some((e) => e.id == id)) return els
        for (const e of els) if (e.kind == "group") { const s = siblingsOf(e.children ?? [], id); if (s.length > 0) return s }
        return []
    }

    // A copy of the tree with `fn` applied to each element whose id is in `ids`.
    function mapIds(els: Elt[], ids: string[], fn: (e: Elt) => Elt): Elt[] {
        return els.map((e) => {
            if (ids.includes(e.id)) return fn(e)
            if (e.kind == "group") return { ...e, children: mapIds(e.children ?? [], ids, fn) }
            return e
        })
    }
    // The tree without the elements in `ids`; a group left with fewer than two
    // children dissolves into what is left of it.
    function removeIds(els: Elt[], ids: string[]): Elt[] {
        const out: Elt[] = []
        for (const e of els) {
            if (ids.includes(e.id)) continue
            if (e.kind == "group") {
                const kids = removeIds(e.children ?? [], ids)
                if (kids.length >= 2) out.push({ ...e, children: kids })
                else out.push(...kids)
            } else out.push(e)
        }
        return out
    }

    // Moving and resizing. `mapBox` carries an element from one box to another,
    // as a resize of the box around it does: positions and sizes scale, a
    // rectangle's corner radius and a text's type size do not.
    function moveEl(e: Elt, dx: number, dy: number): Elt {
        if (e.kind == "line") return { ...e, x1: round1(e.x1! + dx), y1: round1(e.y1! + dy), x2: round1(e.x2! + dx), y2: round1(e.y2! + dy) }
        if (e.kind == "group") return { ...e, children: (e.children ?? []).map((c) => moveEl(c, dx, dy)) }
        return { ...e, x: round1(e.x! + dx), y: round1(e.y! + dy) }
    }
    function mapBox(e: Elt, a: Bx, b: Bx): Elt {
        const sx = a.w == 0 ? 1 : b.w / a.w, sy = a.h == 0 ? 1 : b.h / a.h
        const fx = (x: number) => round1(b.x + (x - a.x) * sx)
        const fy = (y: number) => round1(b.y + (y - a.y) * sy)
        if (e.kind == "line") return { ...e, x1: fx(e.x1!), y1: fy(e.y1!), x2: fx(e.x2!), y2: fy(e.y2!) }
        if (e.kind == "group") return { ...e, children: (e.children ?? []).map((c) => mapBox(c, a, b)) }
        const x0 = fx(e.x!), y0 = fy(e.y!)
        const x1 = fx(e.x! + e.width!), y1 = fy(e.y! + e.height!)
        return { ...e, x: x0, y: y0, width: Math.max(1, round1(x1 - x0)), height: Math.max(1, round1(y1 - y0)) }
    }
    // A box resized by dragging one of its handles ("nw", "n", "ne", "e", …)
    // by (dx, dy); `lock` keeps its proportions.
    function resizeBox(a: Bx, handle: string, dx: number, dy: number, lock: boolean): Bx {
        let x0 = a.x, y0 = a.y, x1 = a.x + a.w, y1 = a.y + a.h
        if (handle.includes("w")) x0 = Math.min(x1 - 1, x0 + dx)
        if (handle.includes("e")) x1 = Math.max(x0 + 1, x1 + dx)
        if (handle.includes("n")) y0 = Math.min(y1 - 1, y0 + dy)
        if (handle.includes("s")) y1 = Math.max(y0 + 1, y1 + dy)
        let w = x1 - x0, h = y1 - y0
        if (lock && a.w > 0 && a.h > 0) {
            const ratio = a.w / a.h
            const horiz = handle.includes("e") || handle.includes("w")
            const vert = handle.includes("n") || handle.includes("s")
            if (horiz && vert) {
                // a corner: the larger change leads
                if (w / a.w > h / a.h) h = w / ratio
                else w = h * ratio
            } else if (horiz) h = w / ratio
            else w = h * ratio
            // keep the opposite edge (or the middle, for a side handle) still
            if (handle.includes("w")) x0 = x1 - w
            else if (!handle.includes("e")) x0 = a.x + (a.w - w) / 2
            x1 = x0 + w
            if (handle.includes("n")) y0 = y1 - h
            else if (!handle.includes("s")) y0 = a.y + (a.h - h) / 2
            y1 = y0 + h
        }
        return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
    }
    // A box drawn from one point to another; `lock` makes it a square.
    function dragBox(x0: number, y0: number, x1: number, y1: number, lock: boolean): Bx {
        let w = x1 - x0, h = y1 - y0
        if (lock) { const s = Math.max(Math.abs(w), Math.abs(h)); w = Math.sign(w || 1) * s; h = Math.sign(h || 1) * s }
        return { x: Math.min(x0, x0 + w), y: Math.min(y0, y0 + h), w: Math.abs(w), h: Math.abs(h) }
    }
    // A line's free end, kept to multiples of 45° when `lock` is held.
    function lineEnd(x0: number, y0: number, x1: number, y1: number, lock: boolean): number[] {
        if (!lock) return [x1, y1]
        const a = Math.round(Math.atan2(y1 - y0, x1 - x0) / (Math.PI / 4)) * (Math.PI / 4)
        const d = Math.hypot(x1 - x0, y1 - y0)
        return [round1(x0 + Math.cos(a) * d), round1(y0 + Math.sin(a) * d)]
    }

    // Snapping: the lines the moving box's edges and middle may stick to — the
    // slide's edges and middle, and every other element's.
    function snapLines(els: Elt[], skip: string[], axis: string): number[] {
        const out = axis == "x" ? [0, W / 2, W] : [0, H / 2, H]
        for (const e of els) {
            if (skip.includes(e.id)) continue
            const b = boxOf(e)
            if (axis == "x") out.push(b.x, b.x + b.w / 2, b.x + b.w)
            else out.push(b.y, b.y + b.h / 2, b.y + b.h)
        }
        return out
    }
    // The nudge (within `tol`) that puts one of `mine` on one of `lines`, and the
    // line it lands on; [0, NaN] when none is near.
    function snapBy(mine: number[], lines: number[], tol: number): number[] {
        let best = tol + 1, by = 0, at = NaN
        for (const m of mine) for (const l of lines) {
            const d = l - m
            if (Math.abs(d) < best) { best = Math.abs(d); by = d; at = l }
        }
        return best <= tol ? [by, at] : [0, NaN]
    }

    // A copy with fresh ids all the way down, moved by (dx, dy).
    function cloneEl(e: Elt, dx: number, dy: number): Elt {
        const c = moveEl(e, dx, dy)
        const fresh = (x: Elt): Elt => x.kind == "group"
            ? { ...x, id: newId("g"), children: (x.children ?? []).map(fresh) }
            : { ...x, id: newId("e") }
        return fresh(c)
    }

    // Grouping: the chosen siblings become one group, where the frontmost of them was.
    function groupIds(els: Elt[], ids: string[], gid: string): Elt[] {
        if (els.filter((e) => ids.includes(e.id)).length == ids.length) {
            const kids = els.filter((e) => ids.includes(e.id))
            const at = Math.max(...els.map((e, i) => ids.includes(e.id) ? i : -1))
            const out: Elt[] = []
            els.forEach((e, i) => {
                if (i == at) out.push({ id: gid, kind: "group", children: kids })
                else if (!ids.includes(e.id)) out.push(e)
            })
            return out
        }
        return els.map((e) => e.kind == "group" ? { ...e, children: groupIds(e.children ?? [], ids, gid) } : e)
    }
    function ungroupIds(els: Elt[], ids: string[]): Elt[] {
        const out: Elt[] = []
        for (const e of els) {
            if (e.kind == "group" && ids.includes(e.id)) out.push(...(e.children ?? []))
            else if (e.kind == "group") out.push({ ...e, children: ungroupIds(e.children ?? [], ids) })
            else out.push(e)
        }
        return out
    }

    // Stacking order, within the list the chosen elements share.
    function reorderIds(els: Elt[], ids: string[], how: string): Elt[] {
        if (els.some((e) => ids.includes(e.id))) {
            const mine = els.filter((e) => ids.includes(e.id))
            const rest = els.filter((e) => !ids.includes(e.id))
            if (how == "front") return [...rest, ...mine]
            if (how == "back") return [...mine, ...rest]
            const out = [...els]
            if (how == "forward") {
                for (let i = out.length - 2; i >= 0; i--)
                    if (ids.includes(out[i].id) && !ids.includes(out[i + 1].id)) { const t = out[i]; out[i] = out[i + 1]; out[i + 1] = t }
            } else {
                for (let i = 1; i < out.length; i++)
                    if (ids.includes(out[i].id) && !ids.includes(out[i - 1].id)) { const t = out[i]; out[i] = out[i - 1]; out[i - 1] = t }
            }
            return out
        }
        return els.map((e) => e.kind == "group" ? { ...e, children: reorderIds(e.children ?? [], ids, how) } : e)
    }

    // Aligning to the chosen elements' shared box, and spacing them evenly.
    function alignIds(els: Elt[], ids: string[], how: string): Elt[] {
        const all = unionOf(ids.map((i) => boxOf(find(els, i)!)))
        return mapIds(els, ids, (e) => {
            const b = boxOf(e)
            let dx = 0, dy = 0
            if (how == "left") dx = all.x - b.x
            if (how == "center") dx = all.x + all.w / 2 - (b.x + b.w / 2)
            if (how == "right") dx = all.x + all.w - (b.x + b.w)
            if (how == "top") dy = all.y - b.y
            if (how == "middle") dy = all.y + all.h / 2 - (b.y + b.h / 2)
            if (how == "bottom") dy = all.y + all.h - (b.y + b.h)
            return moveEl(e, dx, dy)
        })
    }
    function distributeIds(els: Elt[], ids: string[], axis: string): Elt[] {
        const items = ids.map((i) => ({ id: i, b: boxOf(find(els, i)!) }))
        const pos = (b: Bx) => axis == "x" ? b.x : b.y
        const size = (b: Bx) => axis == "x" ? b.w : b.h
        items.sort((p, q) => pos(p.b) - pos(q.b))
        const first = items[0].b, last = items[items.length - 1].b
        const span = pos(last) + size(last) - pos(first)
        const used = items.reduce((n, it) => n + size(it.b), 0)
        const gap = (span - used) / (items.length - 1)
        let at = pos(first)
        const target: Record<string, number> = {}
        for (const it of items) { target[it.id] = at; at = at + size(it.b) + gap }
        return mapIds(els, ids, (e) => {
            const b = boxOf(e)
            const d = target[e.id] - pos(b)
            return axis == "x" ? moveEl(e, d, 0) : moveEl(e, 0, d)
        })
    }

    // How light a colour is, 0 to 1: dark slides get light text.
    function lightness(hex: string): number {
        const n = parseInt(hex.slice(1, 7), 16)
        if (isNaN(n)) return 1
        return (0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255
    }
    function validHex(s: string): boolean { return /^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(s) }
    // a colour from the data, as paint: anything not "#RRGGBB" or "#RRGGBBAA" paints nothing
    function paintOf(c: string | null | undefined, fallback: string): string { return c != null && validHex(c) ? c : fallback }

    function sameJson(a: unknown, b: unknown): boolean { return JSON.stringify(a) == JSON.stringify(b) }

    // "3 minutes ago", "Yesterday", "12 Oct".
    function whenLabel(iso: string, nowMs: number): string {
        const t = Date.parse(iso)
        if (isNaN(t)) return ""
        const s = Math.max(0, (nowMs - t) / 1000)
        if (s < 60) return "Just now"
        if (s < 3600) return Math.floor(s / 60) + (Math.floor(s / 60) == 1 ? " minute ago" : " minutes ago")
        if (s < 86400) return Math.floor(s / 3600) + (Math.floor(s / 3600) == 1 ? " hour ago" : " hours ago")
        if (s < 172800) return "Yesterday"
        const d = new Date(t)
        const sameYear = d.getFullYear() == new Date(nowMs).getFullYear()
        return d.toLocaleDateString("en-GB", sameYear ? { day: "numeric", month: "short" } : { day: "numeric", month: "short", year: "numeric" })
    }

    function ellipsePath(w: number, h: number): string {
        const rx = w / 2, ry = h / 2
        return `M 0 ${ry} A ${rx} ${ry} 0 1 0 ${w} ${ry} A ${rx} ${ry} 0 1 0 0 ${ry} Z`
    }

    // Which view class shows an element of each kind.
    function elementClass(kind: string): string {
        return kind == "rect" ? "RectEl" : kind == "ellipse" ? "EllipseEl" : kind == "line" ? "LineEl"
            : kind == "text" ? "TextEl" : "GroupEl"
    }
    }


// ── The open presentation ───────────────────────────────────────────────────
//
// Its value is the deck and its slides, in order. Every verb that changes
// a slide tells `app.sync`, which saves it; the verbs `sync` uses when the
// service answers (a new version, a new id) change nothing the person made,
// so they say nothing.

class Doc extends Dataset [ schema = DocValue,

    deck() -> Deck? { return this.value?.deck ?? null },
    all() -> Slide[] { return this.value?.slides ?? [] },
    at(id: string) -> number { return this.all().findIndex((s) => s.id == id) },
    slide(id: string) -> Slide? { return this.all().find((s) => s.id == id) ?? null },
    elements(id: string) -> El[] { return this.slide(id)?.elements ?? [] },
    body(id: string) -> Body {
        const s = this.slide(id)
        return ({ background: s?.background ?? "#FFFFFF", elements: s?.elements ?? [] })
        },
    order() -> string[] { return this.all().map((s) => s.id) },

    open(deck: Deck, slides: Slide[]) { this.set([], ({ deck: deck, slides: slides })) },
    close() { this.set([], ({ slides: [] })) },

    // the person's changes

    write(id: string, b: Body) {
        const i = this.at(id)
        if (i < 0) return
        const s = this.all()[i]
        if (s.background != b.background) this.set(["slides", i, "background"], b.background)
        if (s.elements != b.elements) this.set(["slides", i, "elements"], b.elements)
        app.sync.touch(id)
        },
    insertSlide(index: number, s: Slide) {
        this.insert(["slides"], Math.max(0, Math.min(index, this.all().length)), s)
        app.sync.added(s.id)
        },
    removeSlide(id: string) {
        const i = this.at(id)
        if (i < 0) return
        this.removeAt(["slides"], i)
        app.sync.removed(id)
        },
    reorder(ids: string[]) {
        const now = this.all()
        const next = ids.map((id) => now.find((s) => s.id == id)).filter((s) => s != null) as Slide[]
        if (next.length != now.length) return
        this.set(["slides"], next)
        app.sync.touchOrder()
        },
    retitle(t: string) {
        if (this.deck() == null || this.deck()!.title == t) return
        this.set(["deck", "title"], t)
        app.sync.touchTitle()
        },

    // what the service tells us

    adopt(id: string, version: number) { const i = this.at(id); if (i >= 0) this.set(["slides", i, "version"], version) },
    renameSlide(from: string, to: string) { const i = this.at(from); if (i >= 0) this.set(["slides", i, "id"], to) },
    replaceSlide(s: Slide) { const i = this.at(s.id); if (i >= 0) this.set(["slides", i], s) },
    adoptDeck(d: Deck) {
        if (this.deck() == null) return
        this.set(["deck", "version"], d.version)
        this.set(["deck", "updatedAt"], d.updatedAt)
        }
    ]


// ── Undo and redo ───────────────────────────────────────────────────────────
//
// A step is recorded once a thing the person did is over: the drag released,
// the inspector's change made, the run of typing ended. Undoing writes the
// step's `before` back and puts the selection back as it was.

class History extends Node [
    done: Step[] = [],
    undone: Step[] = [],
    canUndo: boolean = { this.done.length > 0 },
    canRedo: boolean = { this.undone.length > 0 },

    record(s: Step) {
        done = [...done.slice(-199), s]
        undone = []
        },
    clear() { done = []; undone = [] },

    undo() {
        if (done.length == 0) return
        const s = done[done.length - 1]
        done = done.slice(0, -1)
        undone = [...undone, s]
        app.ed.replay(s, false)
        },
    redo() {
        if (undone.length == 0) return
        const s = undone[undone.length - 1]
        undone = undone.slice(0, -1)
        done = [...done, s]
        app.ed.replay(s, true)
        },

    // the service gave a slide made here its own id

    renameSlide(from: string, to: string) {
        const fix = (s: Step): Step => ({ ...s,
            slide: s.slide == from ? to : s.slide,
            current: s.current == from ? to : s.current,
            data: s.data != null && s.data.id == from ? ({ ...s.data, id: to }) : s.data,
            order: s.order?.map((x) => x == from ? to : x),
            orderAfter: s.orderAfter?.map((x) => x == from ? to : x) })
        done = done.map(fix)
        undone = undone.map(fix)
        }
    ]


// ── Saving ──────────────────────────────────────────────────────────────────
//
// Every change waits a moment for the next (so a burst of typing is one
// save), then goes to the service one request at a time through `req`: new
// slides first, then deleted ones, then each changed slide, then the deck's
// order and title. A request the service doesn't take is kept and tried again,
// sooner at first and then less often. A slide someone else changed is held
// back until the person decides (`conflicts`).

class Sync extends Node [
    base: string = "http://127.0.0.1:8360",
    deckId: string = "",

    revs: object = { {} },                // slide id → how many changes made here
    saved: object = { {} },               // slide id → how many of them the service has
    fresh: string[] = [],             // slides made here, not yet on the service
    gone: string[] = [],              // slides deleted here, not yet on the service
    serverOrder: string[] = [],       // the slide order the service last told us
    titleDirty: boolean = false,
    conflicts: object = { {} },           // slide id → the slide as the service has it now

    job: string = "",                 // what `req` is doing: "", "create", "delete", "put", "deck", "probe"
    jobSlide: string = "",
    jobRev: number = 0,
    failing: boolean = false,
    tries: number = 0,
    probeId: string = "",
    hold: boolean = false,            // a gesture is under way: wait for it to end
    timer: DelayHandle? = null,

    // which slides have changes the service doesn't have

    dirty: string[] = { Object.keys(this.revs).filter((id) => (this.revs[id] ?? 0) > (this.saved[id] ?? 0)) },
    blocked: string[] = { Object.keys(this.conflicts) },
    orderDirty: boolean = { this.fresh.length == 0 && this.gone.length == 0 && !sameJson(app.doc.order(), this.serverOrder) },

    // changes still to send: new or deleted slides, the deck's order or title,
    // a changed slide (one held back for the person's decision included), or a
    // request on its way

    slidesWaiting: boolean = { this.fresh.length > 0 || this.gone.length > 0 || this.dirty.length > 0 },
    deckWaiting: boolean = { this.titleDirty || this.orderDirty },
    sending: boolean = { this.job != "" && this.job != "probe" },
    pending: boolean = { this.slidesWaiting || this.deckWaiting || this.sending },

    // what can go now (a slide held back waits for the person, not the service)

    sendable: boolean = { this.fresh.length > 0 || this.gone.length > 0 || this.deckWaiting || this.sending
        || this.dirty.some((id) => !this.blocked.includes(id)) },
    status: "saved" | "saving" | "failed" = { !this.pending ? "saved" : this.failing ? "failed" : "saving" },
    statusText: string = { this.status == "saved" ? "All changes saved" : this.status == "saving" ? "Saving…" : "Not saved: can't reach the service" },

    // a fresh start for a newly opened presentation

    reset(deck: Deck) {
        timer?.cancel()
        deckId = deck.id
        revs = {}
        saved = {}
        fresh = []
        gone = []
        serverOrder = [...deck.slideOrder]
        titleDirty = false
        conflicts = {}
        failing = false
        tries = 0
        job = ""
        },

    // what the editor tells us

    touch(id: string) { revs = ({ ...revs, [id]: (revs[id] ?? 0) + 1 }); this.soon() },
    added(id: string) {
        if (gone.includes(id)) gone = gone.filter((g) => g != id)      // undone before the delete went out
        else if (!fresh.includes(id)) fresh = [...fresh, id]
        this.touch(id)
        },
    removed(id: string) {
        if (fresh.includes(id)) fresh = fresh.filter((f) => f != id)
        else gone = [...gone, id]
        const c = ({ ...conflicts }); delete c[id]; conflicts = c
        this.soon()
        },
    touchOrder() { this.soon() },
    touchTitle() { titleDirty = true; this.soon() },
    holdFor(on: boolean) { hold = on; if (!on) this.soon() },

    // the next request, after a moment's quiet; ⌘S sends at once

    soon() { this.later(failing ? this.backoff() : 900) },
    now() { tries = 0; this.later(0) },
    later(ms: number) {
        timer?.cancel()
        timer = afterDelay(ms, () => this.pump())
        },
    backoff() -> number { return Math.min(15000, 1000 * Math.pow(2, Math.min(tries, 4))) },

    // ⌘S, or "Try again": every change, now

    pump() {
        if (job != "" || deckId == "") return
        if (hold) { this.later(400); return }
        const doc = app.doc
        const order = doc.order()
        if (fresh.length > 0) {
            // the first new slide in order whose predecessor is on the service
            const id = order.find((s) => fresh.includes(s)) ?? fresh[0]
            const i = order.indexOf(id)
            let after: string? = null
            for (let k = i - 1; k >= 0; k--) if (!fresh.includes(order[k])) { after = order[k]; break }
            const b = doc.body(id)
            this.send("create", id, "POST", base + "/api/decks/" + deckId + "/slides",
                ({ after: after, background: b.background, elements: b.elements }))
            return
            }
        if (gone.length > 0) {
            this.send("delete", gone[0], "DELETE", base + "/api/slides/" + gone[0], null)
            return
            }
        const next = order.find((id) => dirty.includes(id) && !blocked.includes(id))
        if (next != null) {
            const s = doc.slide(next)!
            this.send("put", next, "PUT", base + "/api/slides/" + next,
                ({ version: s.version, background: s.background, elements: s.elements }))
            return
            }
        if (orderDirty || titleDirty) {
            const d = doc.deck()!
            this.send("deck", "", "PATCH", base + "/api/decks/" + deckId,
                titleDirty ? ({ version: d.version, title: d.title, slideOrder: order }) : ({ version: d.version, slideOrder: order }))
            return
            }
        if (probeId != "" && doc.at(probeId) >= 0 && !fresh.includes(probeId)) {
            const p = probeId
            probeId = ""
            this.send("probe", p, "GET", base + "/api/slides/" + p, null)
            }
        },
    send(kind: string, slide: string, method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE", url: string, body: object?) {
        job = kind
        jobSlide = slide
        jobRev = revs[slide] ?? 0
        if (kind == "deck") jobRev = titleDirty ? 1 : 0
        req.method = method
        req.url = url
        req.body = body
        req.fetch()
        },

    // ask the service whether someone else changed this slide

    check(id: string) { probeId = id; if (job == "") this.later(0) },

    req: DataSource [ errorSchema = Refusal, timeout = 12,
        onLoad() { classroot.landed() },
        onError() { classroot.refused() }
        ],

    landed() {
        const doc = app.doc
        const v = req.value
        const kind = job
        const id = jobSlide
        failing = false
        tries = 0
        job = ""
        if (kind == "create") {
            const s = v.slide as Slide
            doc.renameSlide(id, s.id)
            doc.adopt(s.id, s.version)
            app.renameSlide(id, s.id)
            app.history.renameSlide(id, s.id)
            fresh = fresh.filter((f) => f != id)
            revs = this.moved(revs, id, s.id)
            saved = ({ ...this.moved(saved, id, s.id), [s.id]: jobRev })
            serverOrder = [...(v.deck as Deck).slideOrder]
            doc.adoptDeck(v.deck as Deck)
            }
        else if (kind == "delete") {
            gone = gone.filter((g) => g != id)
            serverOrder = [...(v.deck as Deck).slideOrder]
            doc.adoptDeck(v.deck as Deck)
            }
        else if (kind == "put") {
            doc.adopt(id, (v as Slide).version)
            saved = ({ ...saved, [id]: jobRev })
            }
        else if (kind == "deck") {
            const d = v as Deck
            serverOrder = [...d.slideOrder]
            if (jobRev == 1 && doc.deck()?.title == d.title) titleDirty = false
            doc.adoptDeck(d)
            }
        else if (kind == "probe") this.compare(v as Slide)
        this.later(0)
        },

    refused() {
        const kind = job
        const id = jobSlide
        const code = req.statusCode
        job = ""
        if (code == 409 && req.errorBody?.error == "conflict") {
            const current = (req.errorBody as object).current
            if (kind == "deck") {
                // someone else renamed or reordered: keep ours, on top of their version
                const d = current as Deck
                app.doc.adoptDeck(d)
                const mine = app.doc.order()
                const theirs = d.slideOrder
                serverOrder = [...theirs]
                if (!sameJson([...mine].sort(), [...theirs].sort())) app.reloadOrder(theirs)
                this.later(0)
                return
                }
            conflicts = ({ ...conflicts, [id]: current })
            this.later(0)
            return
            }
        if (code == 409 && kind == "delete") { gone = gone.filter((g) => g != id); this.later(0); return }
        if (code == 404 && kind == "delete") { gone = gone.filter((g) => g != id); this.later(0); return }
        if (code == 404 && kind == "put") {
            // the slide was deleted somewhere else: make it again from what is here
            fresh = [...fresh, id]
            this.later(0)
            return
            }
        if (code == 422) {
            // the format refused something: a bug here, not something to retry forever
            console.warn("Presentify: the service refused", kind, id, req.errorBody)
            if (kind == "put" || kind == "create") saved = ({ ...saved, [id]: jobRev })
            if (kind == "create") fresh = fresh.filter((f) => f != id)
            if (kind == "deck") titleDirty = false
            this.later(0)
            return
            }
        if (kind == "probe") { this.later(this.backoff()); return }
        failing = true
        tries = tries + 1
        this.later(this.backoff())
        },

    // the service's copy of a slide is newer than the one here

    compare(remote: Slide) {
        const mine = app.doc.slide(remote.id)
        if (mine == null || remote.version <= mine.version) return
        conflicts = ({ ...conflicts, [remote.id]: remote })
        },

    // the person chose: theirs replaces this slide; or theirs is set aside and
    // this one is saved over it

    takeTheirs(id: string) {
        const remote = conflicts[id] as Slide?
        if (remote == null) return
        const c = ({ ...conflicts }); delete c[id]; conflicts = c
        app.ed.adoptRemote(remote)
        saved = ({ ...saved, [id]: revs[id] ?? 0 })
        },
    keepMine(id: string) {
        const remote = conflicts[id] as Slide?
        if (remote == null) return
        const c = ({ ...conflicts }); delete c[id]; conflicts = c
        app.doc.adopt(id, remote.version)
        this.touch(id)
        },

    moved(m: object, from: string, to: string) -> object {
        const out = ({ ...m })
        if (from in out) { out[to] = out[from]; delete out[from] }
        return out
        }
    ]
