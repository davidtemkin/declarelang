/*
# Presentify: a slide, drawn

`SlideArt` draws one slide at its own 1280 × 720 points, scaled to whatever
size it is shown at: the editor's stage, a thumbnail in the slide list or the
presentations, and the presenter's full screen all use it, so a slide looks
the same everywhere.

Each element is a view of the class its kind names (`elementClass`), reading
its own record. A group is a view holding its children's views; they keep their
own slide coordinates, as the format says.

On the stage the art is `live`: each element can be found under a press (an
ellipse only inside its outline, a line along a band around it), and the stage
hands what was pressed to the editor (`app.ed`). Everywhere else it is a
picture and takes nothing.
*/

use [ RectEl, EllipseEl, LineEl, TextEl, GroupEl ]

class SlideArt [ width = 1280, height = 720, pivotX = 0, pivotY = 0, clip = true,
    live: boolean = false,
    accessibilityHidden = { !this.live },
    pointerEvents = { this.live ? "auto" : "none" },
    fill = { paintOf(:background, "#FFFFFF") as Color },
    ElementView [ datapath = :elements[], classFor = { elementClass(:kind) } ]
    ]


class ElementView [ pointerEvents = { provided("live") ? "auto" : "none" } ]

// Every element knows its id and whether it is on the stage. The stage asks
// the tree which element is under a press (`viewAt`), so an element itself
// declares no handlers: elsewhere it is only a picture.

class Shape extends ElementView [
    live: boolean = { provided("live") },
    elId: string = { :id ?? "" },
    cursor = { classroot.live && app.tool == "select" ? "move" : "" }
    ]


class RectEl extends Shape [
    x = { :x ?? 0 }, y = { :y ?? 0 }, width = { :width ?? 0 }, height = { :height ?? 0 },
    fill = { :fill == null ? null : paintOf(:fill, "#00000000") as Color },
    stroke = { :stroke == null ? null : Stroke(:stroke.width, paintOf(:stroke.color, "#00000000") as Color) },
    cornerRadius = { Math.min(:cornerRadius ?? 0, (:width ?? 0) / 2, (:height ?? 0) / 2) }
    ]


// An ellipse is drawn, and takes presses only inside its outline (`clip`).
// Its outline is drawn inside the box, as a rectangle's is.

class EllipseEl extends Shape [
    x = { :x ?? 0 }, y = { :y ?? 0 }, width = { :width ?? 0 }, height = { :height ?? 0 },
    clip = { ellipsePath(this.width, this.height) },
    paint: string = { paintOf(:fill, "") },
    lineW: number = { :stroke?.width ?? 0 },
    lineC: string = { paintOf(:stroke?.color, "") },
    draw(d: DrawContext) {
        const w = this.width, h = this.height
        if (paint != "") {
            d.beginPath(); d.ellipse(w / 2, h / 2, w / 2, h / 2, 0, 0, Math.PI * 2)
            d.fillStyle = paint; d.fill()
            }
        if (lineW > 0 && lineC != "") {
            d.beginPath()
            d.ellipse(w / 2, h / 2, Math.max(0.1, w / 2 - lineW / 2), Math.max(0.1, h / 2 - lineW / 2), 0, 0, Math.PI * 2)
            d.strokeStyle = lineC; d.lineWidth = lineW; d.stroke()
            }
        }
    ]


// A line is a thin view turned along it: its band is at least 14 points tall
// so it can be pressed, and the stroke is drawn down its middle.

class LineEl extends Shape [
    dx: number = { (:x2 ?? 0) - (:x1 ?? 0) },
    dy: number = { (:y2 ?? 0) - (:y1 ?? 0) },
    lineW: number = { :stroke?.width ?? 1 },
    band: number = { Math.max(this.lineW, 14) },
    x = { :x1 ?? 0 }, y = { (:y1 ?? 0) - this.band / 2 },
    width = { Math.max(0.5, Math.hypot(this.dx, this.dy)) }, height = { this.band },
    rotation = { Math.atan2(this.dy, this.dx) * 180 / Math.PI },
    pivotX = 0, pivotY = { this.band / 2 },
    View [ y = center, width = 100%, height = { classroot.lineW }, cornerRadius = { classroot.lineW / 2 },
        fill = { paintOf(:stroke?.color, "#1F2328") as Color } ]
    ]


// A text box: one block, one style, wrapped to its width. It is as tall as its
// text, or as the box drawn for it if that is taller. While it is being
// edited, a field takes the text's place, in the same style.

class TextEl extends Shape [
    x = { :x ?? 0 }, y = { :y ?? 0 }, width = { :width ?? 0 },
    height = { Math.max(:height ?? 0, this.fits) },
    editing: boolean = { classroot.live && app.editingId == classroot.elId },
    fits: number = { classroot.editing && this.field != null ? this.field.height : this.body.height },
    cursor = { classroot.editing ? "text" : classroot.live && app.tool == "select" ? "move" : "" },

    // On the stage, a box whose text has outgrown it keeps the taller height
    // in its record, as the format asks ("as last laid out").

    trackChanges = ["fits"],
    onChange() { if (classroot.live && this.fits > (:height ?? 0) + 0.5) app.ed.grewText(classroot.elId, this.fits) },

    face: object = { [:text?.font ?? "Helvetica Neue", "Helvetica Neue", "Helvetica", "sans-serif"] },
    body: Text [ width = 100%, visible = { !classroot.editing },
        text = { (:text?.content ?? "") == "" ? " " : :text?.content ?? "" },
        fontFamily = { classroot.face }, fontSize = { :text?.size ?? 32 }, fontWeight = { :text?.weight ?? 400 },
        italic = { :text?.italic ?? false }, textColor = { paintOf(:text?.color, "#1F2328") as Color },
        textAlign = { :text?.align ?? "left" }, lineHeight = 1.2 ],
    field: TextInput [ exists = { classroot.editing }, width = 100%, multiline = true, wrap = true,
        padding = 0, fill = null, stroke = null, spellcheck = true,
        accessibilityLabel = "Text",
        fontFamily = { classroot.face }, fontSize = { :text?.size ?? 32 }, fontWeight = { :text?.weight ?? 400 },
        italic = { :text?.italic ?? false }, textColor = { paintOf(:text?.color, "#1F2328") as Color },
        textAlign = { :text?.align ?? "left" }, lineHeight = 1.2,
        value = { :text?.content ?? "" },
        commit(t: string) { app.ed.typed(classroot.elId, t) },
        keyBindings = { [ ({ key: "Escape", command: "done" }), ({ key: "Ctrl+Enter", command: "done" }) ] },
        done() { app.ed.endEdit() },
        onBlur() { if (app.editingId == classroot.elId) app.ed.endEdit() },
        onInit() { afterSettle(() => { Focus.focus(this); this.select((this.value ?? "").length, (this.value ?? "").length) }) }
        ]
    ]


// A group has no box of its own (its children keep their slide coordinates), so
// its view is sized 0: it holds its children without covering the slide.

class GroupEl extends ElementView [ width = 0, height = 0,
    ElementView [ datapath = :children[], classFor = { elementClass(:kind) } ]
    ]
