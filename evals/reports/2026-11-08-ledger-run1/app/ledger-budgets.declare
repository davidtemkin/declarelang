/*
# Ledger: Budgets

A monthly amount for any expense category. For the month in the date filter,
each budgeted category shows its budget, what has been spent and what remains,
a bar with a marker for where spending should be by today, and its state in
words. Amounts are edited in place; Return saves and moves down the list, the
arrows move between them. A month can be started from last month's spending.
*/


// One budget: its category, the bar and the pace marker, the figures, its state.

class BudgetRow [ width = 100%, padding = [12, 0, 12, 0],
    stroke = { [null, null, stroke(1, provided("theme").grid), null] },
    b: Budget = { :@ },
    pace: number = { app.monthPace },                               // how far through the month: 0…1
    expected: number = { Math.round(classroot.b.amount * classroot.pace) },
    over: boolean = { classroot.b.spent > classroot.b.amount },
    ahead: boolean = { !classroot.over && classroot.pace < 1 && classroot.b.spent > classroot.expected },
    state: string = { classroot.stateWords(classroot.b, classroot.over, classroot.ahead) },
    stateWords(b: Budget, over: boolean, ahead: boolean) -> string {
        if (over) return "Over by " + money(b.spent - b.amount)
        if (ahead) return money(b.spent - expected) + " over pace"
        if (pace >= 1) return "Within budget · " + money(b.remaining) + " left"
        return "On track · " + money(b.remaining) + " left"
        },
    tone: Color = { classroot.over ? provided("theme").bad : classroot.ahead ? provided("theme").warn : provided("theme").good },
    fillFrac: number = 0,
    Spring [ attribute = fillFrac, to = { Math.min(1, classroot.b.spent / Math.max(1, classroot.b.amount)) },
        stiffness = { app.springK }, damping = { app.springD } ],
    layout: SimpleLayout [ axis = y, spacing = 8 ],

    top: View [ width = 100%,
        layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
        open: Control [ flexes = true, height = 32, cornerRadius = 6, padding = [0, 6, 0, 6],
            fill = { hovered || focused ? provided("theme").rowHover : null },
            accessibilityLabel = { app.books.categoryName(classroot.b.categoryId) + ": " + classroot.state + ". Spent " + money(classroot.b.spent) +
                " of " + money(classroot.b.amount) + ". Opens the expenses." },
            press() { app.openBudget(classroot.b) },
            layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
            CategoryChip [ categoryId = { classroot.b.categoryId }, name = { app.books.categoryName(classroot.b.categoryId) },
                colour = { app.books.colourOf(classroot.b.categoryId) } ],
            Text [ fontSize = 13, fontWeight = semibold, wrap = false, textColor = { classroot.tone }, text = { classroot.state } ]
            ],
        Text [ fontSize = 12.5, wrap = false, textColor = { provided("theme").textMuted }, text = "Budget" ],
        amountField: TextInput [ width = 110, height = 32, fontSize = 13.5, textAlign = right, numeralWidth = tabular,
            purpose = decimal, accessibilityLabel = { "Monthly budget for " + app.books.categoryName(classroot.b.categoryId) },
            commitOn = "end",
            value = { moneyInput(classroot.b.amount) },
            validate(v: string) -> string { return parseMoney(v) > 0 ? "" : "Type an amount above zero" },
            commit(v: string) { const c = parseMoney(v); if (c > 0 && c != classroot.b.amount) app.setBudget(classroot.b.categoryId, c) },
            onEnter() { app.focusBudget(rowIndex + 1) },
            onKeyDown(e: KeyEvent) {
                if (e.key == "ArrowDown") app.focusBudget(rowIndex + 1)
                else if (e.key == "ArrowUp") app.focusBudget(rowIndex - 1)
                else super.onKeyDown(e)
                }
            ],
        Control [ width = 28, height = 28, cornerRadius = 6, accessibilityLabel = { "Stop budgeting " + app.books.categoryName(classroot.b.categoryId) },
            tooltipLabel = "Stop budgeting from this month",
            fill = { hovered ? provided("theme").controlHovered : null },
            press() { app.setBudget(classroot.b.categoryId, null) },
            CloseIcon [ x = center, y = center, iconSize = 10, ink = { provided("theme").textMuted } ]
            ]
        ],

    // the bar: spent so far, and a marker where spending should be by today

    bar: View [ width = 100%, height = 10, cornerRadius = 5, fill = { provided("theme").control },
        View [ height = 10, cornerRadius = 5, fill = { classroot.tone }, width = { Math.max(classroot.b.spent > 0 ? 4 : 0, parent.width * classroot.fillFrac) } ],
        marker: View [ visible = { classroot.pace > 0 && classroot.pace < 1 }, x = { parent.width * classroot.pace - 1 }, y = -3,
            width = 2, height = 16, cornerRadius = 1, fill = { provided("theme").text },
            tooltipLabel = { "Where spending should be by today: " + money(classroot.expected) } ]
        ],
    figures: View [ width = 100%,
        layout: SimpleLayout [ axis = x, spacing = 16 ],
        Text [ fontSize = 12, numeralWidth = tabular, textColor = { provided("theme").textMuted },
            text = { "Spent " + money(classroot.b.spent) + " of " + money(classroot.b.amount) } ],
        Text [ visible = { classroot.pace > 0 && classroot.pace < 1 }, fontSize = 12, numeralWidth = tabular, textColor = { provided("theme").textMuted },
            text = { "By today: " + money(classroot.expected) } ],
        Spacer [ ],
        Text [ fontSize = 12, numeralWidth = tabular, textColor = { classroot.b.remaining < 0 ? provided("theme").bad : provided("theme").textMuted },
            text = { classroot.b.remaining < 0 ? money(classroot.b.remaining) + " remaining" : money(classroot.b.remaining) + " remaining" } ]
        ]
    ]


class BudgetsScreen [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 16 ],

    panel: Panel [ width = 100%, title = { "Budgets for " + app.budgetMonthName },
        note = { app.budgetNote },
        loading = { app.figures.budgets.loading }, failed = { app.figures.budgets.failed },
        retry() { app.figures.budgets.fetch() },
        actions: View [ width = 100%,
            layout: WrappingLayout [ spacing = 8, rowSpacing = 8, align = center ],
            Button [ height = 32, fontSize = 13, label = "Add a budget", iconLeft = "PlusIcon", menu = { app.addBudgetMenu },
                disabled = { app.unbudgeted.length == 0 } ],
            Button [ height = 32, fontSize = 13, label = { "Start from " + app.lastMonthName + "’s spending" },
                disabled = { app.lastMonthSuggestions.length == 0 },
                tooltipLabel = "Budget each category at what it spent last month, where it has no budget yet",
                onClick() { app.startFromLastMonth() }
                ]
            ],
        list: View [ width = 100%, datapath = { app.figures.budgets.value },
            layout: SimpleLayout [ axis = y ],
            BudgetRow [ datapath = :budgets[] ]
            ],
        none: View [ visible = { app.figures.budgets.loaded && (app.figures.budgets.value?.budgets ?? []).length == 0 }, width = 100%,
            padding = [20, 0, 20, 0],
            layout: SimpleLayout [ axis = y, spacing = 6, align = center ],
            Text [ fontSize = 14, fontWeight = semibold, text = "No budgets for this month" ],
            Text [ fontSize = 12.5, textColor = { provided("theme").textMuted },
                text = "Add one for a category, or start from last month’s spending." ]
            ]
        ]
    ]
