/*
# The Venue: the tickets

What someone holds up at the door: one ticket at a time, large, with the
performance, the seat, when to arrive and a code to scan. The tickets sit in
a `Carousel`, so a finger swipes between them and the buttons below step.
*/

// The code to scan: Code 39 bars, drawn to the width they are given.

class Barcode [ height = 76,
    code: string = "",
    accessibilityHidden = true,
    draw(d: DrawContext) {
        const unit = width / barsWidth(code)
        d.fillStyle = provided("theme").ticketInk
        for (const b of barsOf(code)) d.fillRect(b[0] * unit, 0, b[1] * unit, height)
        }
    ]


// A labelled value on the ticket: SECTION over Orchestra.

class TicketFact [
    caption: string = "",
    value: string = "",
    big: boolean = false,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 1.6, textColor = { provided("theme").textMuted },
        text = { classroot.caption } ],
    Text [ fontSize = { classroot.big ? 34 : 22 }, fontWeight = bold, numeralWidth = tabular, text = { classroot.value } ]
    ]


class TicketCard [ cornerRadius = 18, clip = true,
    fill = { provided("theme").ticketPaper },
    shadow = { shadow(0, 10, 30, 0x2A1E1430) },
    section: string = { :section ?? "" },
    row: string = { :row ?? "" },
    number: number = { :number ?? 0 },
    barcode: string = { :barcode ?? "" },
    index: number = 0,
    perf: Performance? = { app.production.byId(app.order?.performanceId ?? "") },
    starts: string = { classroot.perf?.startsAt ?? "" },
    doors: string = { classroot.perf?.doorsAt ?? "" },

    accessibilityRole = group,
    accessibilityLabel = { "Ticket " + (classroot.index + 1) + " of " + app.ticketCount + ": "
        + seatName(classroot.section, classroot.row, classroot.number) + ". "
        + dayLabel(classroot.starts) + ", " + timeLabel(classroot.starts) + ". Doors open " + timeLabel(classroot.doors)
        + ". Code " + classroot.barcode },

    layout: SimpleLayout [ axis = y ],

    // the show

    head: View [ width = 100%, padding = [22, 24, 20, 24], fill = { provided("theme").ticketInk },
        layout: SimpleLayout [ axis = y, spacing = 6 ],
        Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 2, textColor = { provided("theme").accentTint },
            text = { "TICKET " + (classroot.index + 1) + " OF " + app.ticketCount } ],
        Text [ width = 100%, wrap = true, fontFamily = { app.displayFace }, fontSize = 26, fontWeight = semibold,
            textColor = { provided("theme").ticketPaper }, text = { app.production.value?.title ?? "" } ],
        Text [ fontSize = 14, textColor = { provided("theme").seatGone }, text = { app.production.value?.hall ?? "" } ]
        ],

    // when

    when: View [ width = 100%, padding = [20, 24, 0, 24],
        layout: SimpleLayout [ axis = x, spacing = 24 ],
        TicketFact [ caption = { weekday(classroot.starts).toUpperCase() }, value = { dayLabel(classroot.starts).split(" ").slice(1).join(" ") } ],
        TicketFact [ caption = "CURTAIN", value = { timeLabel(classroot.starts) } ],
        TicketFact [ caption = "DOORS", value = { timeLabel(classroot.doors) } ]
        ],

    // where

    seat: View [ width = 100%, padding = [18, 24, 20, 24],
        layout: SimpleLayout [ axis = x, spacing = 24, align = end ],
        TicketFact [ caption = "SECTION", value = { classroot.section } ],
        TicketFact [ caption = "ROW", value = { classroot.row }, big = true ],
        TicketFact [ caption = "SEAT", value = { "" + classroot.number }, big = true ]
        ],

    // the tear line

    tear: View [ width = 100%, height = 1, accessibilityHidden = true,
        draw(d: DrawContext) {
            d.strokeStyle = provided("theme").lineStrong
            d.lineWidth = 1.5
            d.setLineDash([6, 6])
            d.beginPath(); d.moveTo(16, 0.5); d.lineTo(width - 16, 0.5); d.stroke()
            }
        ],

    // the code at the door

    scan: View [ width = 100%, padding = [20, 28, 18, 28],
        layout: SimpleLayout [ axis = y, spacing = 8, align = center ],
        Barcode [ width = 100%, code = { classroot.barcode } ],
        Text [ fontSize = 15, fontWeight = semibold, letterSpacing = 3, numeralWidth = tabular, text = { classroot.barcode } ],
        Text [ width = 100%, textAlign = center, wrap = true, fontSize = 13, textColor = { provided("theme").textMuted },
            text = { "Arrive by " + timeLabel(classroot.doors) + ", when the doors open. Running time " + (app.production.value?.runningTime ?? "") + "." } ]
        ]
    ]


// One page of the carousel: a ticket, centred.

class TicketPage [
    TicketCard [ x = center, width = { Math.min(380, parent.width - 32) }, index = { classroot.rowIndex } ]
    ]
