/*
# A conversation

One pane per conversation, all of them standing, one shown. Each keeps its own
scroller, so its reading position survives leaving and coming back — nothing
is saved and restored, it simply never went anywhere.

The scroller holds the reader still. It remembers which line sits at the top
of the window and how far down; when anything above that line changes size —
a photograph arriving, a reaction growing a message, the unread marker moving
— it puts that line back where it was. When the reader is at the newest
message, it follows the conversation instead.
*/

class Conversation [ width = 100%, height = 100%,
    tid: string = { "" + :id },
    rec: Thread = { app.store.value.threads[rowIndex] },
    selected: boolean = { app.selId == tid },
    showing: boolean = { selected && (app.wide || app.inThread) },
    unread: number = { app.store.unread(this.rec) },

    // every pane stays standing so its scroller keeps its place; only the
    // selected one is seen

    fade: number = 0,
    Spring [ attribute = fade, to = { classroot.selected ? 1 : 0 }, stiffness = 520, damping = 46 ],
    opacity = { fade },

    // a pane not in use stands just out of frame: unseen, untouchable, and
    // with its scroller exactly where it was left

    x = { selected || fade > 0.01 ? 0 : parent.width + 40 },

    // the unread marker: the last message read when this visit began

    mark: string = "",
    visited: boolean = false,
    feed: Dataset [ schema = [ rows[]: Line ],
        contents = { { rows: app.store.lines(classroot.rec, classroot.mark, app.today) } } ],

    trackChanges = ["showing"],
    onChange() { if (showing) this.arrive() },

    arrive() {
        if (unread > 0 && rec != null) mark = rec.lastSeen
        const first = !visited
        visited = true
        afterSettle(() => { if (first) this.log.firstLook(); else this.log.note() })
        },

    head: ConversationHead [ rec = { classroot.rec } ],

    log: View [ y = { parent.head.height }, width = 100%,
        height = { parent.height - parent.head.height - parent.composer.height },
        scrolls = y,

        atEnd: boolean = true,       // the reader is at the newest message
        anchorId: string = "",       // the line at the top of the window…
        anchorTop: number = 0,       // …and where it sits there
        following: boolean = false,  // gliding to the end at our own request
        lastY: number = 0,

        trackChanges = ["scrollY", "contentHeight", "height"],
        onChange(e: ChangeEvent) {
            if (e.changed.some((c) => c.name != "scrollY")) this.keepPlace()
            else this.note()
            },

        // where the reader is: at the end, or reading from some line

        note() {
            const end = scrollY >= contentHeight - height - 48
            // our own glide on its way down is not the reader leaving the end;
            // a move back up is, and ends the glide's claim
            const gliding = following && !end && scrollY >= lastY
            following = gliding
            lastY = scrollY
            atEnd = end || gliding
            const top = this.col.y + this.col.lines.y
            for (const v of this.col.lines.childViews) {
                if (top + v.y + v.height > scrollY) {
                    anchorId = (v as Said).lid
                    anchorTop = top + v.y - scrollY
                    break
                    }
                }
            if (atEnd && classroot.showing) app.store.markRead(classroot.tid)
            },

        // something changed size: follow the conversation, or keep the reader's line still

        keepPlace() {
            if (atEnd && classroot.showing) {
                following = true
                this.scrollTo(Infinity, { duration: 220 })
                app.store.markRead(classroot.tid)
                return
                }
            const top = this.col.y + this.col.lines.y
            for (const v of this.col.lines.childViews) {
                if ((v as Said).lid == anchorId) { this.scrollTo(top + v.y - anchorTop); return }
                }
            },

        // the first visit: open at what is new, or at the end

        firstLook() {
            const top = this.col.y + this.col.lines.y
            for (const v of this.col.lines.childViews) {
                if ((v as Said).fresh) {
                    this.scrollTo(Math.max(0, top + v.y - 24))
                    atEnd = false
                    return
                    }
                }
            atEnd = true
            this.scrollTo(Infinity)
            app.store.markRead(classroot.tid)
            },

        toEnd() { atEnd = true; following = true; this.scrollTo(Infinity, { duration: 320 }) },

        col: View [ x = center, width = { Math.min(parent.width, 780) },
            layout: SimpleLayout [ axis = y ],
            top: View [ width = 100%, height = 14 ],
            lines: View [ width = 100%, datapath = { classroot.feed.value },
                layout: SimpleLayout [ axis = y ],
                Said [ datapath = :rows[],
                    classFor = { :m.kind == "photo" ? PhotoSaid : :m.kind == "voice" ? VoiceSaid : TextSaid } ]
                ],
            typing: Typing [ who = { app.store.typingNames(classroot.rec) },
                group = { app.store.isGroup(classroot.rec) },
                first = { app.store.typers(classroot.rec)[0] ?? "" } ],
            foot: View [ width = 100%, height = 10 ]
            ]
        ],

    // something new is below the reader

    below: NewBelow [ n = { classroot.unread },
        shown = { classroot.showing && !classroot.log.atEnd && (classroot.unread > 0
            || classroot.log.contentHeight - classroot.log.scrollY > classroot.log.height * 2) },
        y = { parent.log.y + parent.log.height - 54 + 12 * (1 - this.lift) },
        press() { classroot.log.toEnd() }
        ],

    composer: Composer [ y = { parent.height - this.height }, tid = { classroot.tid },
        willSend() { classroot.log.atEnd = true }
        ]
    ]


// the conversation's name, who is in it, and — on a phone — the way back

class ConversationHead [ width = 100%, height = { 64 + app.safeTop },
    rec: Thread = null,
    fill = { provided("theme").bg },
    stroke = { [null, null, stroke(1, provided("theme").line), null] },

    row: View [ y = { app.safeTop }, width = 100%, height = 64,
        back: BackButton [ x = 6, y = 10, visible = { !app.wide } ],
        face: ThreadFace [ y = 14, size = 36, rec = { classroot.rec },
            x = { app.wide ? 20 : 50 } ],
        names: View [ y = center,
            x = { parent.face.x + 48 },
            width = { parent.width - this.x - 20 },
            layout: SimpleLayout [ axis = y, spacing = 1 ],
            Text [ width = 100%, wrap = false, maxLines = 1, fontSize = 16.5, fontWeight = semibold, letterSpacing = -0.2,
                text = { classroot.rec == null ? "" : app.store.titleOf(classroot.rec) } ],
            sub: Text [ width = 100%, wrap = false, maxLines = 1, fontSize = 12.5,
                visible = { this.text != "" },
                textColor = { app.store.typingNames(classroot.rec) != "" ? provided("theme").accent : provided("theme").textMuted },
                text = { classroot.rec == null ? "" : app.store.typingNames(classroot.rec) != ""
                    ? (!app.store.isGroup(classroot.rec) ? "typing…"
                        : app.store.typingNames(classroot.rec) + (app.store.typers(classroot.rec).length > 1 ? " are" : " is") + " typing…")
                    : app.store.isGroup(classroot.rec) ? joinNames([...app.store.others(classroot.rec).map((p) => app.store.firstName(p)), "you"])
                    : "" } ]
            ]
        ]
    ]


class BackButton extends Control [ width = 40, height = 44, cornerRadius = 10,
    fill = { down ? theme.controlPressed : hot ? theme.control : null },
    press() { app.back() },
    ChevronIcon [ x = center, y = center, dir = "left", iconSize = 22, weight = 2.2, ink = { theme.accent } ]
    ]


// "3 new messages", below the reader, rising into view when there is something to go to

class NewBelow extends Control [ height = 36, cornerRadius = 18, x = center,
    n: number = 0,
    shown: boolean = false,
    lift: number = 0,
    Spring [ attribute = lift, to = { classroot.shown ? 1 : 0 }, stiffness = 420, damping = 32 ],
    opacity = { lift },
    disabled = { !shown },
    pointerEvents = { shown ? "auto" : "none" },
    width = { this.cap.width + 50 },
    fill = { down ? theme.accentPressed : theme.accent },
    shadow = { shadow(0, 4, 14, 0x00000030) },
    cap: Text [ x = 16, y = center, fontSize = 13.5, fontWeight = semibold, wrap = false,
        textColor = { classroot.theme.accentText },
        text = { classroot.n == 0 ? "Latest" : classroot.n == 1 ? "1 new message" : classroot.n + " new messages" } ],
    ChevronIcon [ y = center, x = { parent.cap.x + parent.cap.width + 6 }, dir = "down", iconSize = 14, weight = 2,
        ink = { classroot.theme.accentText } ]
    ]


// someone is writing: their face, and three dots breathing in turn

class Typing [ width = 100%, height = 48,
    who: string = "",
    group: boolean = false,
    first: string = "",
    visible = { who != "" },
    beat: number = 0,
    Animator [ attribute = beat, from = 0, to = 3, duration = 1200, repeat = { Infinity }, motion = linear,
        started = { classroot.who != "" } ],
    face: Avatar [ x = 12, y = 12, size = 28, visible = { classroot.group }, pid = { classroot.first } ],
    bubble: View [ y = 6, height = 36, width = 62, cornerRadius = 18,
        x = { classroot.group ? 48 : 12 },
        fill = { provided("theme").theirs },
        dots: View [ x = center, y = center,
            layout: SimpleLayout [ axis = x, spacing = 6 ],
            Dot [ phase = 0, beat = { classroot.beat } ],
            Dot [ phase = 1, beat = { classroot.beat } ],
            Dot [ phase = 2, beat = { classroot.beat } ]
            ]
        ]
    ]


class Dot [ width = 8, height = 8, cornerRadius = 4,
    phase: number = 0,
    beat: number = 0,
    fill = { provided("theme").textMuted },
    opacity = { 0.3 + 0.7 * Math.max(0, 1 - Math.abs((beat - phase + 3) % 3 - 0.5)) }
    ]
