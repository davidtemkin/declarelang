/*
# Marks

The few drawn marks Murmur needs beyond the library's chevron and cross,
authored in the Icon 16-box.
*/

// an arrow rising: send

class SendIcon extends Icon [
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(8, 13.5); d.lineTo(8, 2.5)
        d.moveTo(3.5, 7); d.lineTo(8, 2.5); d.lineTo(12.5, 7)
        d.stroke()
        }
    ]


// a framed picture with a hill and a sun: photographs

class PhotoIcon extends Icon [
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.roundRect(1.5, 2.5, 13, 11, 2.5)
        d.stroke()
        d.beginPath()
        d.moveTo(2, 12); d.lineTo(6, 8); d.lineTo(9, 11); d.lineTo(11, 9.5); d.lineTo(14, 12)
        d.stroke()
        d.beginPath()
        d.arc(10.5, 6, 1.3, 0, Math.PI * 2)
        d.stroke()
        }
    ]


// a face with a small plus: add a reaction

class SmileIcon extends Icon [
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.beginPath()
        d.arc(7, 9, 5.5, 0, Math.PI * 2)
        d.stroke()
        d.beginPath()
        d.arc(7, 9, 3, 0.2 * Math.PI, 0.8 * Math.PI)
        d.stroke()
        d.beginPath()
        d.moveTo(5.2, 7.4); d.lineTo(5.2, 7.6)
        d.moveTo(8.8, 7.4); d.lineTo(8.8, 7.6)
        d.moveTo(13, 1); d.lineTo(13, 5)
        d.moveTo(11, 3); d.lineTo(15, 3)
        d.stroke()
        }
    ]
