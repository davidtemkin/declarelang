/*
## Browse

A two-up grid of taped polaroids. The poster is a 4:5 cover crop with the
wordmark stamped top-left and a count pill top-right; the curator's name sits in
a small zine block across the bottom edge.
*/

class Polaroid extends View [ width = 192, height = 336, cursor = "pointer",

    onClick() { app.go(app.hrefSlug(:polaroidHref)) },

    mount: View [ width = 192, height = 240,

        face: View [ width = 192, height = 240, fill = #1A1A1A,
            shadow = { shadow(3, 4, 10, 0x17130F4D) },

            photo: Cover [ x = 2, y = 2, width = 188, height = 236,
                source = { :image },
                natW = { app.sizeOf(:image, true) },
                natH = { app.sizeOf(:image, false) } ],

            // The card with no portrait: lined stock, a marker-scrawled sticky
            // over its own offset shadow-note.

            noPhoto: View [ x = 2, y = 2, width = 188, height = 236, fill = #EFE9DC,
                visible = { :image == "" },
                shadowNote: View [ x = 44, y = 74, width = 120, height = 112, fill = #E9247F ],
                sticky: View [ x = 30, y = 62, width = 122, height = 114, fill = #F5E32A,
                    shadow = { shadow(4, 6, 8, 0x00000038) } ],
                cap: Text [ x = 30, y = 108, width = 122, textAlign = center, wrap = false,
                    fontFamily = [Display, "sans-serif"], fontSize = 16, letterSpacing = 0.8,
                    textColor = #17130F,
                    text = { app.upper(app.ellipsize(:browsePlaylistTitle, 12)) } ]
                ],
            shade: View [ y = 120, width = 192, height = 120, pointerEvents = "none",
                visible = { :image != "" },
                fill = { gradient("180deg", 0x00000000, 0x000000B3) } ],

            stamp: Wordmark [ x = 6, y = 6, width = 56, height = 17, white = true ],
            pill: CountPill [ y = 7, count = { shortCount(:viewCount) },
                x = { parent.width - this.width - 7 } ],

            // A photo card sets the name straight onto the picture; only the
            // portrait-less card gives it a torn block to sit on.

            nameplate: Text [ x = 8, width = 176, textAlign = center, wrap = false,
                visible = { :image != "" },
                y = { parent.height - 21 },
                fontFamily = [Zine, "monospace"], fontWeight = bold, fontSize = 10,
                letterSpacing = 0.8, textColor = #FFFFFF,
                textShadow = { shadow(0, 1, 3, 0x000000C4) },
                text = { app.upper(app.ellipsize(:curatorDisplayName, 20)) } ],
            nameBlock: ZineBlock [ x = center, size = 9, tilt = -0.7, maxText = 170, padY = 2,
                visible = { :image == "" },
                y = { parent.height - this.height - 6 },
                source = { app.upper(:curatorDisplayName) } ]
            ],

        tape1: Tape [ x = 8, y = -9, width = 53, height = 16, tilt = -7 ],
        tape2: Tape [ y = 229, width = 58, height = 13, tilt = 4, alpha = 0.72,
            x = { parent.width - 62 } ]
        ],

    title: Text [ y = 248, width = 192, textAlign = center, wrap = false,
        fontFamily = [Display, "sans-serif"], fontSize = 12, letterSpacing = 0.5,
        textColor = #3C443D, text = { app.upper(app.ellipsize(:browsePlaylistTitle, 34)) } ],

    updated: Text [ y = 266, width = 192, textAlign = center, wrap = false, italic = true,
        fontSize = 10, textColor = #3C443DB3,
        text = { "Updated: " + app.shortDate(:playlistUpdatedAt) } ],

    feat: Text [ x = 3, y = 285, width = 186, textAlign = center, fontSize = 11,
        textColor = #444841,
        text = { "FEAT: " + app.ellipsize(app.joinArtists(:featuredArtists), 78) } ]
    ]


class SortPill extends View [ height = 23, cursor = "pointer",

    label: string = "",
    sort: string = "featured",
    on: boolean = { app.sort == this.sort },
    width = { this.cap.width + 24 },

    onClick() { app.sort = this.sort },

    draw(d: Draw) {
        const tick = app.fontTick
        d.fillStyle = "rgba(23,19,15,1)"
        polyTrace(d, WONKY_PILL, 2, 2, this.width, this.height)
        d.fill()
        polyTrace(d, WONKY_PILL, 0, 0, this.width, this.height)
        d.fillStyle = this.on ? "#F5EA3C" : (this.hovered ? "#FFFFFF" : "#FFFAF5")
        d.fill()
        },

    cap: Text [ x = 12, y = center, wrap = false,
        fontFamily = [Display, "sans-serif"], fontSize = 10, letterSpacing = 0.42,
        textColor = #1F1B17, text = { classroot.label.toUpperCase() } ]
    ]


/*
## A curator's playlist

The hero photo with the name plate and visit count over it, then the deck —
follow button, updated line, playlist title, "Listen on" card, description — and
the tracks, each an index, a rule, art, title, artist, and the curator's note.
*/

class TrackRow extends View [ width = 416,

    height = { this.body.height + 24 },

    idx: Text [ x = 8, y = 20, width = 48, textAlign = right, wrap = false,
        fontFamily = [Display, "sans-serif"], fontSize = 34, letterSpacing = 1,
        textColor = #17130F26, text = { pad2(:n) } ],

    rule: View [ x = 56, y = 20, width = 2, fill = #E42B1F8C,
        height = { classroot.height - 20 } ],

    body: View [ x = 77, y = 20, width = 339,
        height = { this.note.y + this.note.height + 6 },

        art: View [ width = 160, height = 160, fill = #494454,
            shadow = { shadow(3, 3, 0, 0x17130FB8) },
            pic: Cover [ width = 160, height = 160, fy = 0.5,
                source = { :image }, natW = 300, natH = 300 ]
            ],

        tapeA: Tape [ x = 1, y = 48, width = 10, height = 28, tilt = 12, alpha = 0.6 ],
        tapeB: Tape [ x = 11, y = 152, width = 38, height = 15, tilt = -5, alpha = 0.6 ],
        tapeC: Tape [ x = 61, y = -7, width = 38, height = 10, tilt = 6, alpha = 0.55 ],

        title: Text [ x = 184, width = 155, wrap = false,
            fontFamily = [Display, "sans-serif"], fontSize = 19, letterSpacing = 0.8,
            textColor = #1F1B17, text = { app.upper(app.ellipsize(:title, 16)) } ],
        artist: Text [ x = 184, y = 23, width = 155, wrap = false, fontSize = 13, fontWeight = medium,
            textColor = #444841, text = { app.upper(app.ellipsize(:artist, 20)) } ],

        heart: View [ x = 184, y = 44, width = 20, height = 20,
            draw(d: Draw) {
                d.fillStyle = "#3C443D"
                d.beginPath()
                d.moveTo(10, 18)
                d.bezierCurveTo(-2, 10, 2, 1, 10, 6)
                d.bezierCurveTo(18, 1, 22, 10, 10, 18)
                d.closePath()
                d.fill()
                }
            ],
        bubble: View [ x = 208, y = 44, width = 20, height = 20,
            draw(d: Draw) {
                d.fillStyle = "#3C443D"
                d.beginPath()
                d.moveTo(2, 3)
                d.lineTo(18, 3)
                d.lineTo(18, 14)
                d.lineTo(9, 14)
                d.lineTo(5, 18)
                d.lineTo(5.5, 14)
                d.lineTo(2, 14)
                d.closePath()
                d.fill()
                d.strokeStyle = "#FFFAF5"
                d.lineWidth = 1.6
                d.beginPath()
                d.moveTo(10, 6)
                d.lineTo(10, 11)
                d.moveTo(7.5, 8.5)
                d.lineTo(12.5, 8.5)
                d.stroke()
                }
            ],

        note: Markdown [ y = 182, width = 339, fontSize = 16, fontWeight = medium,
            lineHeight = 1.625, bodyColor = #444841, text = { app.str(:annotation) } ]
        ]
    ]


class ListenCard extends View [ width = 144, height = 74,

    frame: WonkyBox [ width = 144, height = 74, lw = 2, dropX = 2, dropY = 2 ],

    cap: Text [ width = 144, y = 14, textAlign = center, wrap = false,
        fontFamily = [Station, "sans-serif"], fontWeight = bold, fontSize = 14,
        letterSpacing = 1.68, textColor = #17130F, text = "LISTEN ON" ],

    logos: View [ x = 16, y = 36, width = 112, height = 23,
        draw(d: Draw) {
            // Apple Music, Spotify, YouTube, and the overflow plus — drawn as
            // the site's three brand marks in a row.
            d.fillStyle = "#FA243C"
            d.beginPath()
            d.roundRect(0, 0, 23, 23, 6)
            d.fill()
            d.fillStyle = "#FFFFFF"
            d.beginPath()
            d.arc(8, 16, 3.2, 0, Math.PI * 2, false)
            d.fill()
            d.beginPath()
            d.arc(16, 14, 3.2, 0, Math.PI * 2, false)
            d.fill()
            d.fillRect(10.4, 5, 1.8, 11)
            d.fillRect(18.4, 3, 1.8, 11)
            d.fillRect(10.4, 5, 9.8, 2.4)

            d.fillStyle = "#1DB954"
            d.beginPath()
            d.arc(41.2, 11.6, 11.6, 0, Math.PI * 2, false)
            d.fill()
            d.strokeStyle = "#FFFFFF"
            d.lineCap = "round"
            for (let i = 0; i < 3; i++) {
                const half = 4.2 + i * 2.4
                const cy = 8.6 + i * 4.2
                d.lineWidth = 1.6 + i * 0.5
                d.beginPath()
                d.moveTo(41.2 - half, cy)
                d.quadraticCurveTo(41.2, cy - 3.4 - i, 41.2 + half, cy)
                d.stroke()
                }

            d.fillStyle = "#FF0000"
            d.beginPath()
            d.roundRect(59, 3.5, 23, 16.3, 4.6)
            d.fill()
            d.fillStyle = "#FFFFFF"
            d.beginPath()
            d.moveTo(67.5, 7.5)
            d.lineTo(75, 11.6)
            d.lineTo(67.5, 15.7)
            d.closePath()
            d.fill()

            d.strokeStyle = "#17130F"
            d.lineWidth = 1.3
            d.beginPath()
            d.arc(100.5, 11.6, 10.5, 0, Math.PI * 2, false)
            d.stroke()
            d.beginPath()
            d.moveTo(100.5, 6.6)
            d.lineTo(100.5, 16.6)
            d.moveTo(95.5, 11.6)
            d.lineTo(105.5, 11.6)
            d.stroke()
            }
        ]
    ]


/*
## The application
*/

App [ fill = #F5F5F1,
    fontFamily = [Body, "system-ui", "sans-serif"],
    textColor = #1C1C18,
    fontSize = 16,
    minWidth = 380,
    location = "",

    /* ------------------------------------------------------------ app state */

    slide: number = 0,
    slideTouched: boolean = false,
    menuOpen: boolean = false,
    sort: string = "featured",
    fontTick: number = 0,
    seeMore: boolean = false,

    /** The chrome sits over photography on home and curator pages, over paper
     *  on browse and the legal pages — which decides the wordmark's colour. */

    darkChrome: boolean = { app.route == "home" || app.route == "curator" },

    route: string = { app.routeOf(app.location) },
    slug: string = { app.slugOf(app.location) },
    heroH: number = { Math.max(420, app.hostHeight - 55) },

    /* ----------------------------------------------------------------- data */

    homeSrc: DataSource [ auto = true, url = { RELAY + "/api/home" } ],
    browseSrc: DataSource [ auto = true, url = { RELAY + "/api/browse?sort=" + app.sort } ],
    curSrc: DataSource [ auto = true,
        url = { RELAY + "/api/curator/" + (app.slug != "" ? app.slug : "allison") } ],

    slidesDs: Dataset [ contents = { app.buildSlides() } ],
    curatorsDs: Dataset [ contents = { app.buildCurators() } ],
    tracksDs: Dataset [ contents = { app.buildTracks() } ],

    valuePropsImage: string = { app.homeSrc.loaded ? ((app.homeSrc.value as any).valuePropsImage as string) : "" },

    /* -------------------------------------------------------------- methods */

    onInit() {
        // A recording measures nothing, so drawn text must be re-recorded once
        // the web faces have actually landed. Two ticks cover a cold cache.
        setTimeout(() => { app.fontTick = 1 }, 350)
        setTimeout(() => { app.fontTick = 2 }, 1500)
        app.tickSlide()
        },

    /** Advance the carousel on the site's own cadence, unless the visitor has
     *  taken the dial over. */

    tickSlide() {
        setTimeout(() => {
            if (!app.slideTouched && app.route == "home") app.slide = (app.slide + 1) % 5
            app.tickSlide()
            }, 6000)
        },

    go(where: string) {
        this.location = where
        this.menuOpen = false
        this.seeMore = false
        },

    routeOf(l: string) -> string {
        const head = l.split("/")[0]
        if (head == "") return "home"
        if (head == "browse") return "browse"
        if (head == "privacy" || head == "terms") return "legal"
        return "curator"
        },

    slugOf(l: string) -> string {
        const parts = l.split("/")
        if (parts[0] == "curator") return parts.length > 1 ? parts[1] : ""
        if (parts[0] == "" || parts[0] == "browse" || parts[0] == "privacy" || parts[0] == "terms") return ""
        return parts[0]
        },

    /** "/kayvanmd" and "/curator/kayvanmd" both address the same page. */

    hrefSlug(href: string) -> string {
        const parts = (href || "").split("/").filter((p) => p != "")
        if (parts.length == 0) return ""
        return "curator/" + parts[parts.length - 1]
        },

    upper(s: string) -> string {
        return s == null ? "" : ("" + s).toUpperCase()
        },

    /* ---- text helpers, on the App because a script function may not read
       through a parameter it was handed from data (DECLARE7001) ---- */

    /** Width of a run of Space Mono at `size`, tracking included. CSS adds the
     *  tracking after the last glyph too, and canvas letterSpacing matches. */

    monoWidth(text: string, size: number) -> number {
        return ("" + text).length * size * (MONO_ADV + ZINE_TRACK)
        },

    /** Greedy word wrap for a monospace run — draw() cannot measure, so the
     *  app owns its own line breaking. Returns the visual rows. */

    monoWrap(text: string, size: number, max: number) -> string[] {
        const rows = []
        for (const para of ("" + (text || "")).split("\n")) {
            const words = para.trim().split(/\s+/).filter((w) => w.length > 0)
            let line = ""
            for (const w of words) {
                const next = line == "" ? w : line + " " + w
                if (line != "" && this.monoWidth(next, size) > max) { rows.push(line); line = w }
                else line = next
                }
            if (line != "") rows.push(line)
            }
        return rows.length > 0 ? rows : [""]
        },

    widestRow(rows: string[], size: number) -> number {
        let w = 0
        for (const r of (rows || [])) w = Math.max(w, this.monoWidth(r, size))
        return w
        },

    /** "2026-08-02T18:33:23.190Z" → "Aug 2, 2026", read as a plain calendar
     *  date so the label never shifts by a timezone. */

    shortDate(iso: string) -> string {
        if (iso == null || iso == "") return ""
        const m = /^(\d{4})-(\d{2})-(\d{2})/.exec("" + iso)
        if (m == null) return ""
        return MONTHS[Number(m[2]) - 1] + " " + Number(m[3]) + ", " + m[1]
        },

    /** Clip to a character budget with the site's trailing ellipsis. */

    ellipsize(s: string, max: number) -> string {
        if (s == null) return ""
        const t = "" + s
        return t.length <= max ? t : t.slice(0, max - 1).trimEnd() + "…"
        },

    /** The featured-artist credit, joined for display. */

    joinArtists(list: string[]) -> string {
        return ((list || []) as string[]).join(", ")
        },

    /** A string, always. A `:path` that has not resolved yields null, and
     *  `Markdown` parses its text eagerly — so prose bound to data is coerced
     *  here rather than crashing the parser on the frame before it arrives. */

    str(v: string) -> string {
        return v == null ? "" : "" + v
        },

    /** One line, for the `fit-content` measurement a wrapped block needs. */

    flatten(s: string) -> string {
        return ("" + (s || "")).split("\n").join(" ")
        },

    headlineLine(headline: string, i: number) -> string {
        const parts = (headline || "").split("\n")
        return i < parts.length ? parts[i].trim() : ""
        },

    /** The site splits its "MUSIC FROM:" credit over two zine lines. */

    featLine(artists: string[], i: number) -> string {
        const list = (artists || []) as string[]
        if (list.length == 0) return ""
        const half = Math.ceil(list.length / 2)
        if (i == 0) return "MUSIC FROM: " + list.slice(0, Math.min(half, 3)).join(", ")
        const rest = list.slice(Math.min(half, 3), Math.min(half, 3) + 3)
        return rest.length > 0 ? rest.join(", ") : ""
        },

    /** The natural size the relay measured for a bitmap, so `Cover` can fit. */

    sizeOf(url: string, wantWidth: boolean) -> number {
        const fallback = wantWidth ? 600 : 900
        if (url == null || url == "") return fallback
        const packs = [ this.homeSrc, this.browseSrc, this.curSrc ]
        for (const p of packs) {
            if (!p.loaded) continue
            const sizes = (p.value as any).sizes
            if (sizes != null && sizes[url] != null) return wantWidth ? sizes[url].w : sizes[url].h
            }
        return fallback
        },

    buildSlides() {
        const rows = [ ({ id: "value-props", kind: "value" }) ]
        if (this.homeSrc.loaded) {
            const slides = ((this.homeSrc.value as any).slides || []) as any[]
            for (const s of slides) rows.push(({ id: s.href, kind: "promo", ...s }))
            }
        return ({ rows: rows })
        },

    buildCurators() {
        if (!this.browseSrc.loaded) return ({ rows: [] })
        const list = ((this.browseSrc.value as any).curators || []) as any[]
        return ({ rows: list.map((c) => ({ id: c.stationId, ...c })) })
        },

    buildTracks() {
        if (!this.curSrc.loaded) return ({ rows: [] })
        const pack = this.curSrc.value as any
        const list = (pack.tracks || []) as any[]
        return ({ rows: list.map((t, i) => ({ ...t, n: i + 1 })) })
        },

    cur() {
        return this.curSrc.loaded ? (this.curSrc.value as any) : null
        },

    curField(path: string) -> string {
        const c = this.cur()
        if (c == null) return ""
        if (path == "name") return c.curator == null ? "" : ("" + c.curator.name)
        if (path == "bio") return c.curator == null ? "" : ("" + (c.curator.bio || "")).trim()
        if (path == "portrait") return c.curator == null ? "" : ("" + (c.curator.portraitImage || ""))
        if (path == "title") return "" + (c.playlistTitle || "")
        if (path == "updated") return this.shortDate("" + (c.updatedAt || ""))
        if (path == "description") return ("" + (c.description || "")).trim()
        if (path == "views") return shortCount(c.curator == null ? 0 : c.curator.viewCount)
        return ""
        },

    /* ---------------------------------------------------------------- pages */

    /* ---- HOME */

    home: View [ visible = { app.route == "home" }, width = { COL }, x = center,
        height = { app.heroH + 335 },

        paper: View [ y = { app.heroH }, width = { COL }, height = 335, fill = #F5F5F1,
            film: PaperFilm [ width = { COL }, height = 335 ]
            ],

        hero: View [ width = { COL }, height = { app.heroH }, fill = #17130F,
            cursor = "pointer",
            clip = { heroClip(COL, app.heroH) },

            track: View [ height = { parent.height }, datapath = { app.slidesDs.value },
                // the destination is the spring's, not the slot's: an attribute
                // a spring drives must not also carry its own constraint

                glide: Spring [ attribute = x, to = { -app.slide * COL }, stiffness = 210, damping = 26 ],
                layout: SimpleLayout [ axis = x, spacing = 0 ],
                ValueSlide [ visible = true ],
                PromoSlide [ datapath = :rows[1:5][], key = :id ]
                ],

            dial: View [ height = 22, width = 84, cornerRadius = 11, fill = #00000080,
                x = { parent.width - 100 }, y = { parent.height - 36 },
                dots: View [ x = 10, y = 8,
                    layout: SimpleLayout [ axis = x, spacing = 6.4 ],
                    SlideDot [ index = 0 ],
                    SlideDot [ index = 1 ],
                    SlideDot [ index = 2 ],
                    SlideDot [ index = 3 ],
                    SlideDot [ index = 4 ]
                    ]
                ]
            ],

        browseBar: View [ x = center, width = 168, height = 31,
            y = { app.heroH + 12 },
            CyberCta [ label = "browse", dark = true, width = 168,
                onClick() { app.go("browse") }
                ]
            ],

        footRule: View [ x = 24, width = 400, height = 1, fill = #3C443D1A,
            y = { app.heroH + 88 } ],
        footNav: View [ x = center, y = { app.heroH + 121 },
            layout: SimpleLayout [ axis = x, spacing = 24 ],
            privacy: Text [ wrap = false, fontSize = 12, textColor = #3C443DCC, cursor = "pointer",
                text = "Privacy Policy",
                onClick() { app.go("privacy") }
                ],
            terms: Text [ wrap = false, fontSize = 12, textColor = #3C443DCC, cursor = "pointer",
                text = "Terms of Service",
                onClick() { app.go("terms") }
                ]
            ],
        copyright: Text [ x = 24, width = 400, textAlign = center, wrap = false,
            y = { app.heroH + 161 }, fontSize = 10, letterSpacing = 0.4, textColor = #3C443D99,
            text = "© 2026 discover.fm" ]
        ],

    /* ---- BROWSE */

    browse: View [ visible = { app.route == "browse" }, width = { COL }, x = center,
        height = { this.grid.height + 340 },

        bg: View [ width = { COL }, height = { parent.height }, fill = #F5F5F1,
            film: PaperFilm [ width = { COL }, height = { parent.height } ]
            ],

        heading: Text [ x = 24, y = 78, width = 400, wrap = false,
            fontFamily = [Display, "sans-serif"], fontSize = 20, letterSpacing = 0.84,
            textColor = #3C443D, text = "BROWSE CURATORS" ],
        sub: Text [ x = 24, y = 112, width = 400, wrap = false,
            fontFamily = [UI, "system-ui"], fontSize = 14, fontWeight = medium, textColor = #625E58,
            text = "Discover curators. Follow for updates." ],

        tabs: View [ x = 24, y = 144,
            layout: SimpleLayout [ axis = x, spacing = 8 ],
            SortPill [ label = "Featured", sort = "featured" ],
            SortPill [ label = "Top", sort = "top" ],
            SortPill [ label = "New", sort = "new" ]
            ],

        grid: View [ x = 24, y = 183, width = 400, datapath = { app.curatorsDs.value },
            layout: WrappingLayout [ spacing = 16, lineSpacing = 24 ],
            Polaroid [ datapath = :rows[], key = :id ]
            ],

        empty: Text [ x = 24, y = 200, width = 400, fontSize = 14, textColor = #6B6862,
            visible = { !app.browseSrc.loaded },
            text = { app.browseSrc.failed ? "Could not reach the relay — is task/relay.mjs running on 8330?" : "Loading curators…" } ]
        ],

    /* ---- CURATOR */

    curator: View [ visible = { app.route == "curator" }, width = { COL }, x = center,
        height = { this.deck.height + 400 },

        // The hero card is 396 tall but starts 64px above the page, under the
        // fixed header — so only its lower 332 is ever on screen.

        heroWrap: View [ width = { COL }, height = 331.6, clip = true, fill = #0A0A0A,
            photo: Cover [ y = -64, width = { COL }, height = 395.6, fy = 0.5,
                source = { app.curField("portrait") },
                natW = { app.sizeOf(app.curField("portrait"), true) },
                natH = { app.sizeOf(app.curField("portrait"), false) } ],

            plate: View [ x = 24, y = 232.6, height = 36,
                width = { this.nameInk.width + 10 },
                bg: View [ width = { parent.width }, height = 36, fill = #0000003D,
                    clip = { polyPath(PLATE, parent.width, 36) } ],
                nameRed: Text [ x = 7, y = 3, wrap = false, fontFamily = [Display, "sans-serif"],
                    fontSize = 32, letterSpacing = 1.36, textColor = #E42B1F8C,
                    text = { app.upper(app.curField("name")) } ],
                nameCyan: Text [ x = 3, y = 4, wrap = false, fontFamily = [Display, "sans-serif"],
                    fontSize = 32, letterSpacing = 1.36, textColor = #18D8FF73,
                    text = { app.upper(app.curField("name")) } ],
                nameInk: Text [ x = 5, y = 3, wrap = false, fontFamily = [Display, "sans-serif"],
                    fontSize = 32, letterSpacing = 1.36, textColor = #FFFFFF,
                    text = { app.upper(app.curField("name")) } ]
                ],

            visits: CountPill [ x = 24, y = 274, onDark = true,
                count = { app.curField("views") } ],

            dots: View [ x = center, y = 310.8,
                layout: SimpleLayout [ axis = x, spacing = 8 ],
                d1: View [ width = 9, height = 9, fill = #FFFFFFE6 ],
                d2: View [ width = 9, height = 9, stroke = { stroke(1.5, 0xFFFFFFB3) } ]
                ]
            ],

        deck: View [ y = 317.6, width = { COL },
            height = { this.tracks.y + this.tracks.height + 90 },

            bg: View [ width = { COL }, height = { parent.height }, fill = #F5F5F1,
                film: PaperFilm [ width = { COL }, height = { parent.height } ]
                ],

            follow: View [ x = 16, y = 24, width = 169, height = 40, cursor = "pointer",
                draw(d: Draw) {
                    d.fillStyle = "#17130F"
                    polyTrace(d, WONKY_PILL, 2, 2, 169, 40)
                    d.fill()
                    polyTrace(d, WONKY_PILL, 0, 0, 169, 40)
                    d.fillStyle = this.hovered ? "#F0362A" : "#E42B1F"
                    d.fill()
                    },
                cap: Text [ width = 169, y = center, textAlign = center, wrap = false,
                    fontFamily = [Display, "sans-serif"], fontSize = 14, letterSpacing = 0.59,
                    textColor = #FFFFFF, text = "FOLLOW FOR UPDATES" ]
                ],

            share: View [ x = 196, y = 24, width = 41, height = 41,
                draw(d: Draw) {
                    d.strokeStyle = "#1F1B17"
                    d.lineWidth = 1.5
                    d.beginPath()
                    d.arc(26, 9, 3.3, 0, Math.PI * 2, false)
                    d.moveTo(16, 20)
                    d.arc(12.5, 20, 3.3, 0, Math.PI * 2, false)
                    d.moveTo(29, 31)
                    d.arc(25.6, 31, 3.3, 0, Math.PI * 2, false)
                    d.stroke()
                    d.beginPath()
                    d.moveTo(15.5, 18.3)
                    d.lineTo(23, 11)
                    d.moveTo(15.5, 22)
                    d.lineTo(22.6, 29)
                    d.stroke()
                    }
                ],

            updated: Text [ x = 16, y = 74, wrap = false, fontFamily = [Station, "sans-serif"],
                fontWeight = bold, fontSize = 10, letterSpacing = 1.8, textColor = #6B6862,
                text = { "Updated · " + app.curField("updated") } ],

            title: Text [ x = 16, y = 92, width = 250, wrap = false,
                fontFamily = [Display, "sans-serif"], fontSize = 34, letterSpacing = 0.5,
                textColor = #1F1B17, text = { app.upper(app.curField("title")) } ],

            listen: ListenCard [ x = 288, y = 98.5 ],

            about: View [ x = 16, y = 179.7, width = 416, clip = true,
                height = { app.seeMore ? this.body.height : 52 },
                body: Markdown [ width = 416, lineHeight = 1.625, fontSize = 16, fontWeight = medium,
                    bodyColor = #444841,
                    text = { app.curField("description") } ]
                ],

            seeMoreScrim: View [ y = { parent.about.y + 28 }, x = 352, width = 80, height = 24,
                visible = { !app.seeMore },
                fill = { gradient("90deg", 0xF5F5F100, 0xF5F5F1) } ],
            seeMore: Text [ y = { parent.about.y + 32 }, x = 384, wrap = false,
                fontFamily = [Display, "sans-serif"], fontSize = 12, letterSpacing = 0.5,
                textColor = #EA341F, cursor = "pointer",
                visible = { !app.seeMore },
                text = "SEE MORE",
                onClick() { app.seeMore = true }
                ],

            tracks: View [ x = 16, width = 416,
                y = { parent.about.y + parent.about.height + 40 },
                datapath = { app.tracksDs.value },
                layout: SimpleLayout [ axis = y, spacing = 24 ],
                TrackRow [ datapath = :rows[], key = :id ]
                ],

            loading: Text [ x = 16, y = 200, width = 416, fontSize = 14, textColor = #6B6862,
                visible = { !app.curSrc.loaded },
                text = { app.curSrc.failed ? "Could not reach the relay — is task/relay.mjs running on 8330?" : "Loading…" } ]
            ]
        ],

    /* ---- LEGAL (a placeholder, per the brief) */

    legal: View [ visible = { app.route == "legal" }, width = { COL }, x = center, height = 620,

        bg: View [ width = { COL }, height = 620, fill = #F5F5F1,
            film: PaperFilm [ width = { COL }, height = 620 ]
            ],

        back: Text [ x = 24, y = 100, wrap = false, fontSize = 14, fontWeight = medium,
            textColor = #3C443DCC, cursor = "pointer", text = "Back to home",
            onClick() { app.go("") }
            ],

        heading: Text [ x = 24, y = 132, width = 400, wrap = false,
            fontFamily = [Display, "sans-serif"], fontSize = 30, letterSpacing = 0.6,
            textColor = #1C1C18,
            text = { app.location == "terms" ? "TERMS OF SERVICE" : "PRIVACY POLICY" } ],

        note: Text [ x = 24, y = 184, width = 400, fontSize = 15, textColor = #444841,
            text = """
                This client reproduces the signed-out browsing surface of
                discover.fm. The legal documents themselves are not mirrored
                here — read them on discover.fm, where they are authoritative.
                """ ],

        link: Text [ x = 24, y = 290, wrap = false, fontSize = 14, fontWeight = bold,
            textColor = #E42B1F, cursor = "pointer",
            text = { app.location == "terms" ? "discover.fm/terms" : "discover.fm/privacy" },
            onClick() { app.navigate("https://discover.fm/" + app.location) }
            ]
        ],

    /* ---- chrome, declared last so it paints over every page */

    chrome: Chrome [ ],
    menu: MenuPanel [ ]
    ]
