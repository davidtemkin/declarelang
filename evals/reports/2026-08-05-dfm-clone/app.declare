/*
# dfm — an alternative web client for discover.fm

The signed-out surface of discover.fm, rebuilt in Declare: a 448px paper column
centred on a crumpled-paper page, a full-bleed promo carousel, the browse grid,
and a curator's playlist — all reading live data from the site through a local
relay (`task/relay.mjs`, port 8330).

## How the distressed language is made

The site's zine look is CSS effects over a handful of real assets. Each one is
reproduced deliberately, and the choice is recorded here:

| the effect | on discover.fm | here |
|---|---|---|
| torn black label blocks | `clip-path` polygon + rotation on a `<span>` | **drawn** — `ZineBlock.draw()` records the same 23-point torn polygon, rotated, and sets the text inside the same transform |
| glitch fringe on zine type | three-colour `text-shadow` | **drawn** — three offset `fillText` passes (red, white, black) under the ink pass |
| the wordmark's torn edges | one PNG used as a CSS mask, filled `currentColor` | **the site's own asset**, recoloured once at build (`task/make-assets.mjs`) into a white and an ink variant, plus an offset dark copy behind |
| crumpled paper ground | a texture tiled at 128px under `mix-blend-mode: multiply` | **the site's own texture**, tiled by replication over a generated grid, alpha-blended (Declare has no blend modes) |
| notched red/dark buttons | `clip-path` polygon + two hard `box-shadow`s | **composed** — three views sharing one `clip` path (SVG), offset, with a real `Text` on top so the label stays selectable |
| taped-down polaroids | rotated gradient strips with `clip-path` | **drawn** — `Tape.draw()` |
| hand-drawn button outlines | a lopsided `border-radius` ellipse quartet | **drawn** — `WonkyBox.draw()` |
| cover-fit photography | `object-fit: cover` | **computed** — the relay reports each bitmap's natural size and the app does the cover arithmetic inside a clipped box |

## Where the data comes from

`task/relay.mjs` fetches a discover.fm page **once per run**, lifts the props
already embedded in its RSC payload, and returns plain JSON. All shaping is
here: `buildSlides`, `buildCurators`, `buildTracks` derive the datasets the
tree replicates over.

## Addresses

`location` is the app's slice of the URL, so a deep link is `#allison` (or
`#curator/allison`) rather than the site's `/allison` — same grammar, one
fragment along.
*/

font Zine [ Face [ src = "dfm/fonts/space-mono-700.woff2", weight = bold ]
    ]


font Display [ Face [ src = "dfm/fonts/anton-400.woff2" ]
    ]


font Body [ Face [ src = "dfm/fonts/work-sans-400.woff2" ],
    Face [ src = "dfm/fonts/work-sans-500.woff2", weight = medium ],
    Face [ src = "dfm/fonts/work-sans-700.woff2", weight = bold ]
    ]


font Station [ Face [ src = "dfm/fonts/space-grotesk-700.woff2", weight = bold ]
    ]


font UI [ Face [ src = "dfm/fonts/inter-500.woff2", weight = medium ]
    ]


script {
    /* ---------------------------------------------------------------- facts */

    const RELAY = "http://127.0.0.1:8330"

    /** The phone column: Tailwind's max-w-md, which is what the site uses. */
    const COL = 448

    /** Space Mono 700, measured from the shipped face: one advance, and the
     *  cap band the drawn text is positioned against. */
    const MONO_ADV = 0.612
    const MONO_CAP = 0.70

    /** The zine tracking the site sets on every headline: 0.08em. */
    const ZINE_TRACK = 0.08

    /* ------------------------------------------------------------- geometry */

    /** The site's torn-label silhouette, as SVG path data in view-local
     *  coordinates. The percentages are lifted verbatim from the live
     *  `clip-path: polygon(...)` on `.playlist-hero-zine-line`. */
    const TORN: number[][] = [
        [0, 2], [3, 0], [12, 1], [24, 0], [40, 2], [58, 0], [76, 2], [94, 0],
        [100, 4], [99, 22], [100, 48], [98, 72], [100, 88], [97, 96], [82, 100],
        [64, 98], [48, 100], [31, 97], [14, 100], [2, 96], [0, 82], [1, 58], [0, 32]
        ]

    /** The notched cyber-button silhouette, from `.playlist-hero-cyber-cta`. */
    const NOTCH: number[][] = [
        [0, 0], [100, 0], [100, 78], [93, 78], [93, 100], [8, 100], [0, 78]
        ]

    /** The lopsided pill the browse tabs and the follow button wear. */
    const WONKY_PILL: number[][] = [ [4, 0], [100, 8], [96, 100], [0, 90] ]

    /** The curator name plate's slight lozenge. */
    const PLATE: number[][] = [ [1, 2], [100, 0], [99, 97], [0, 100] ]

    /** The hero's cut-away bottom edge — `.playlist-hero-cyber-bottom-clip`,
     *  which is a 20px deep cut inset 8% from each side. Written in pixels
     *  against a concrete size, since the CSS mixes px and %. */
    function heroClip(w: number, h: number): string {
        const cut = 20
        const inset = w * 0.08
        return "M0 0L" + w + " 0L" + w + " " + (h - cut) +
            "L" + (w - inset) + " " + h + "L" + inset + " " + h + "L0 " + (h - cut) + "Z"
        }

    /** Percent polygon → SVG path data at a concrete size. */
    function polyPath(poly: number[][], w: number, h: number): string {
        let d = ""
        for (let i = 0; i < poly.length; i++) {
            d = d + (i == 0 ? "M" : "L") + (poly[i][0] * w / 100).toFixed(2) + " " + (poly[i][1] * h / 100).toFixed(2)
            }
        return d + "Z"
        }

    /** Record a percent polygon as a path on a draw context. */
    function polyTrace(d: any, poly: number[][], x: number, y: number, w: number, h: number): void {
        d.beginPath()
        for (let i = 0; i < poly.length; i++) {
            const px = x + poly[i][0] * w / 100
            const py = y + poly[i][1] * h / 100
            if (i == 0) d.moveTo(px, py)
            else d.lineTo(px, py)
            }
        d.closePath()
        }

    /* ---------------------------------------------------------- cover fitting */

    /** object-fit: cover — the scale that makes the bitmap fill the box. */
    function coverScale(bw: number, bh: number, iw: number, ih: number): number {
        if (iw <= 0 || ih <= 0) return 1
        return Math.max(bw / iw, bh / ih)
        }

    /* ------------------------------------------------------------ formatting */

    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

    /** Every helper that *reads through* a parameter — `.length`, `.split`,
     *  `.slice` — lives on the App instead of here. A `script { }` function is
     *  refused (DECLARE7001) the moment it touches a property of an argument
     *  the compiler cannot name, and a formatter called with `:artist` never
     *  can be. These two take only numbers, so they stay. */

    /** 1285 → "1.3K", the site's own count rounding. */
    function shortCount(n: number): string {
        if (n == null) return "0"
        if (n < 1000) return "" + n
        const k = n / 1000
        return (k < 10 ? k.toFixed(1) : "" + Math.round(k)) + "K"
        }

    /** Zero-padded track index, as the stencil sprites read. */
    function pad2(n: number): string {
        return n < 10 ? "0" + n : "" + n
        }
    }


/*
## The ground

`PaperFilm` is the crumpled-paper texture. The site tiles it at 128px under a
`multiply` blend; Declare has no blend modes and no image fill, so the tiles are
real `Image` children replicated over a generated grid and alpha-blended. The
grid is data, so the film re-tiles itself when the page grows.
*/

class PaperFilm extends View [ pointerEvents = "none", ignoreLayout = true, clip = true, opacity = 0.24,

    tileW: number = 128,
    tileH: number = 71.6,

    grid: Dataset [ contents = { classroot.cells() } ],

    cells() {
        const out = []
        const cols = Math.ceil(this.width / this.tileW)
        const rows = Math.ceil(this.height / this.tileH)
        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) out.push(({ id: r * cols + c, x: c * this.tileW, y: r * this.tileH }))
            }
        return ({ cells: out })
        },

    host: View [ datapath = { classroot.grid.value },
        Image [ datapath = :cells[],
            source = "dfm/paper-crumple.jpg",
            stretches = both,
            x = { :x },
            y = { :y },
            width = { classroot.tileW },
            height = { classroot.tileH } ]
        ]
    ]


/*
## Photography

`Cover` is `object-fit: cover` as arithmetic. Declare's `Image` scales to its
box (`stretches = both`) and cannot read a bitmap's natural size, so the relay
reports it and this class does the fitting: scale to fill, centre horizontally,
and — matching the site's `object-position: top` — pin to the top edge.
*/

class Cover extends View [ clip = true,

    source: string = "",
    natW: number = 600,
    natH: number = 900,

    /** `object-position`, as fractions. The site's default for photography is
     *  `50% 0%` (`object-top`); the home value-props panel carries its own
     *  focal point, `78% 58%`, and reading it off the live page was the one
     *  recon fact no amount of geometry could have been guessed. */

    fx: number = 0.5,
    fy: number = 0,

    s: number = { coverScale(this.width, this.height, this.natW, this.natH) },

    pic: Image [ stretches = both,
        source = { classroot.source },
        width = { classroot.natW * classroot.s },
        height = { classroot.natH * classroot.s },
        x = { (classroot.width - this.width) * classroot.fx },
        y = { (classroot.height - this.height) * classroot.fy } ]
    ]


/*
## The zine label

One torn black block carrying one line of a headline, wrapped to fit. Block and
type are recorded together in a single `draw` so the whole label can carry the
site's small rotation — a view cannot rotate, but a recording can. The three
offset passes under the ink are the site's chromatic `text-shadow`.

`app.fontTick` is read on purpose: a recording is a tracked computation, and a
web face that lands after first paint would otherwise leave the drawn glyphs
rendered in a fallback. Ticking the attribute re-records once the fonts are in.
*/

class ZineBlock extends View [

    source: string = "",
    size: number = 24,
    tilt: number = -1.25,
    maxText: number = 352,
    padX: number = 5.76,
    padY: number = 2.4,
    upper: boolean = true,

    /** The lead word — the first word of the block — is set a touch larger,
     *  which is `.playlist-hero-zine-word--lead` on the live page. */

    leadScale: number = 1.05,

    rows: string[] = { app.monoWrap(this.source, this.size, this.maxText) },
    lineH: number = { this.size * 1.2375 },

    /** `fit-content`: the block is as wide as the text would be *unwrapped*,
     *  clamped to what the container allows. That is why a one-line label hugs
     *  its text while a wrapped one runs the full column width. */

    blockW: number = { Math.min(app.monoWidth(app.flatten(this.source), this.size), this.maxText) + this.padX * 2 },
    blockH: number = { this.rows.length * this.lineH + this.padY * 2 },

    // slack so the rotated recording is never cut off by its own backing store

    width = { this.blockW + 8 },
    height = { this.blockH + 8 },

    draw(d: Draw) {
        const tick = app.fontTick
        const w = this.blockW
        const h = this.blockH
        const size = this.size
        const adv = size * (MONO_ADV + ZINE_TRACK)
        const leadSize = size * this.leadScale
        const leadAdv = leadSize * (MONO_ADV + ZINE_TRACK)
        d.save()
        d.translate(this.width / 2, this.height / 2)
        d.rotate(this.tilt * Math.PI / 180)
        polyTrace(d, TORN, -w / 2, -h / 2, w, h)
        d.fillStyle = "rgba(12,12,10,0.9)"
        d.fill()
        d.letterSpacing = (size * ZINE_TRACK).toFixed(2) + "px"
        d.textAlign = "left"
        d.textBaseline = "alphabetic"
        const rows = this.rows
        for (let i = 0; i < rows.length; i++) {
            const raw = this.upper ? rows[i].toUpperCase() : rows[i]
            // the lead word only ever begins the block's first row
            const lead = i == 0 ? raw.split(" ")[0] : ""
            const rest = i == 0 ? raw.slice(lead.length) : raw
            const rowW = lead.length * leadAdv + rest.length * adv
            const x0 = -rowW / 2
            const baseline = -h / 2 + this.padY + i * this.lineH + (this.lineH + size * MONO_CAP) / 2
            // the site's fringe: red right, white left, black below, then ink
            const passes = [ [1, 0, "rgba(234,52,31,0.75)"], [-1, 0, "rgba(255,255,255,0.22)"],
                             [0, 1, "rgba(0,0,0,0.35)"], [0, 0, "#FCF9F2"] ]
            for (const pass of passes) {
                d.fillStyle = pass[2]
                if (lead != "") {
                    d.font = "700 " + leadSize.toFixed(2) + "px Zine"
                    d.letterSpacing = (leadSize * ZINE_TRACK).toFixed(2) + "px"
                    d.fillText(lead, x0 + (pass[0] as number), baseline + (pass[1] as number))
                    }
                d.font = "700 " + size + "px Zine"
                d.letterSpacing = (size * ZINE_TRACK).toFixed(2) + "px"
                d.fillText(rest, x0 + lead.length * leadAdv + (pass[0] as number), baseline + (pass[1] as number))
                }
            }
        d.restore()
        }
    ]


/*
## The notched button

`.playlist-hero-cyber-cta` — a clipped red (or ink) slab with two hard offset
shadows. Three views share one `clip` path so the offsets are real geometry
rather than a shadow the clip would eat, and the label stays a real `Text`.
*/

class CyberCta extends View [

    label: string = "",
    dark: boolean = false,
    height = 31,
    width = 168,

    path: string = { polyPath(NOTCH, this.width, this.height) },

    // The site declares two hard box-shadows here and its own clip-path eats
    // both, so the rendered button is the clipped face alone. Reproduced as
    // seen, not as declared.

    face: View [ width = { parent.width }, height = { parent.height },
        fill = { classroot.dark ? 0x17130F : 0xF01414 },
        clip = { classroot.path },
        opacity = { classroot.pressed ? 0.86 : (classroot.hovered ? 0.92 : 1) } ],

    // The label's chromatic fringe is two colours, and `textShadow` carries
    // one — so the three passes are three real Texts, and the ink pass stays
    // selectable text rather than pixels.

    blue: Text [ x = -1, width = { parent.width }, y = 10, textAlign = center, wrap = false,
        fontFamily = [Zine, "monospace"], fontWeight = bold, fontSize = 11,
        letterSpacing = 2.64, textColor = #2B00FF, visible = { !classroot.dark },
        text = { classroot.label.toUpperCase() } ],
    cyan: Text [ x = 1, width = { parent.width }, y = 10, textAlign = center, wrap = false,
        fontFamily = [Zine, "monospace"], fontWeight = bold, fontSize = 11,
        letterSpacing = 2.64, textColor = #00E5FF, visible = { !classroot.dark },
        text = { classroot.label.toUpperCase() } ],
    cap: Text [ width = { parent.width }, y = 10, textAlign = center, wrap = false,
        fontFamily = [Zine, "monospace"], fontWeight = bold, fontSize = 11,
        letterSpacing = 2.64, textColor = #FFFEF0, text = { classroot.label.toUpperCase() } ],

    cursor = "pointer"
    ]


/*
## Hand-drawn chrome

The header's menu patch, the sign-in slab and the "Listen on" card all wear the
site's lopsided outline — a CSS `border-radius` written as four different
ellipse quartets. Drawn, because there is no such attribute and there should not
be one.
*/

class WonkyBox extends View [

    ink: number = 0x17130F,
    paper: number = 0xFFFAF5,
    lw: number = 2,
    dropX: number = 3,
    dropY: number = 3,
    squared: boolean = false,

    draw(d: Draw) {
        const w = this.width
        const h = this.height
        const r = this.squared ? 0 : 1
        d.fillStyle = "rgba(23,19,15,0.22)"
        this.trace(d, this.dropX, this.dropY, w, h, r)
        d.fill()
        this.trace(d, 0, 0, w, h, r)
        d.fillStyle = this.paper
        d.fill()
        d.lineWidth = this.lw
        d.strokeStyle = this.ink
        d.stroke()
        },

    /** A rounded rectangle whose four corners each take a different, slightly
     *  wrong radius — the wobble that reads as hand-inked. */

    trace(d: Draw, x: number, y: number, w: number, h: number, k: number) {
        const tl = 2 * k
        const tr = 9 * k
        const br = 3 * k
        const bl = 6 * k
        d.beginPath()
        d.moveTo(x + tl, y + 1)
        d.lineTo(x + w - tr, y)
        d.quadraticCurveTo(x + w, y, x + w - 1, y + tr)
        d.lineTo(x + w, y + h - br)
        d.quadraticCurveTo(x + w, y + h, x + w - br, y + h - 1)
        d.lineTo(x + bl, y + h)
        d.quadraticCurveTo(x, y + h, x + 1, y + h - bl)
        d.lineTo(x, y + tl)
        d.quadraticCurveTo(x, y, x + tl, y + 1)
        d.closePath()
        }
    ]


/*
## Tape

The strips holding the browse polaroids down: a rotated, torn, translucent
gradient over the poster's corner.
*/

class Tape extends View [ pointerEvents = "none", ignoreLayout = true,

    tilt: number = -7,
    alpha: number = 0.9,

    draw(d: Draw) {
        const w = this.width
        const h = this.height
        d.save()
        d.translate(w / 2, h / 2)
        d.rotate(this.tilt * Math.PI / 180)
        polyTrace(d, [ [3, 7], [98, 0], [100, 88], [0, 100] ], -w / 2, -h / 2, w, h)
        const g = d.createLinearGradient(-w / 2, 0, w / 2, 0)
        g.addColorStop(0, "rgba(240,228,196," + this.alpha + ")")
        g.addColorStop(0.18, "rgba(232,211,163," + this.alpha * 0.9 + ")")
        g.addColorStop(0.82, "rgba(232,211,163," + this.alpha * 0.9 + ")")
        g.addColorStop(1, "rgba(206,186,140," + this.alpha + ")")
        d.fillStyle = g
        d.fill()
        // the vertical fibre the site fakes with a repeating gradient
        d.strokeStyle = "rgba(124,104,72,0.16)"
        d.lineWidth = 1
        for (let x = -w / 2 + 3; x < w / 2; x = x + 6) {
            d.beginPath()
            d.moveTo(x, -h / 2 + 1)
            d.lineTo(x, h / 2 - 1)
            d.stroke()
            }
        d.restore()
        }
    ]


/*
## The count pill

The little eye-and-number chip on posters and the curator plate.
*/

class CountPill extends View [

    count: string = "0",
    onDark: boolean = true,

    width = { this.cap.width + 30 },
    height = 18,

    draw(d: Draw) {
        const tick = app.fontTick
        d.save()
        d.translate(this.width / 2, this.height / 2)
        d.rotate(-1 * Math.PI / 180)
        polyTrace(d, [ [2, 6], [99, 0], [100, 92], [0, 100] ], -this.width / 2, -this.height / 2, this.width, this.height)
        d.fillStyle = this.onDark ? "rgba(255,250,245,0.92)" : "rgba(255,250,245,0.86)"
        d.fill()
        // the eye
        const ex = -this.width / 2 + 10
        d.strokeStyle = "#17130F"
        d.lineWidth = 1.1
        d.beginPath()
        d.moveTo(ex - 5, 0)
        d.quadraticCurveTo(ex, -4.4, ex + 5, 0)
        d.quadraticCurveTo(ex, 4.4, ex - 5, 0)
        d.stroke()
        d.beginPath()
        d.arc(ex, 0, 1.7, 0, Math.PI * 2, false)
        d.fillStyle = "#17130F"
        d.fill()
        d.restore()
        },

    cap: Text [ x = 18, y = center, wrap = false,
        fontFamily = [Display, "sans-serif"], fontSize = 9, letterSpacing = 0.4,
        textColor = #17130F, text = { classroot.count } ]
    ]


/*
## The wordmark

The site paints one PNG as a mask filled with `currentColor`, over an offset
dark copy. Declare's `Image` has no tint, so the two fills are baked into two
PNGs at build time from the site's own asset; the offset copy is the ink one.
*/

class Wordmark extends View [

    white: boolean = true,
    width = 150,
    height = 45,

    shadowCopy: Image [ x = 2, y = 2, stretches = both,
        width = { parent.width }, height = { parent.height },
        source = "dfm/wordmark-ink.png",
        visible = { classroot.white } ],
    face: Image [ stretches = both,
        width = { parent.width }, height = { parent.height },
        source = { classroot.white ? "dfm/wordmark-white.png" : "dfm/wordmark-ink.png" } ]
    ]


/*
## Header chrome

Fixed to the frame (`ignoreScroll`), centred on the column: the menu patch, the
wordmark, and the sign-in slab. Sign-in is chrome only — the real one opens
Clerk, which is out of scope.
*/

class Chrome extends View [ ignoreScroll = true, width = { COL }, x = center, height = 64,

    menuBtn: View [ x = 16, y = 8, width = 40, height = 40, cursor = "pointer",
        onClick() { app.menuOpen = !app.menuOpen },
        box: WonkyBox [ width = 40, height = 40,
            paper = { classroot.menuBtn.hovered ? 0xFFFFFF : 0xFFFAF5 } ],
        bars: View [ width = 40, height = 40, pointerEvents = "none",
            draw(d: Draw) {
                d.strokeStyle = "#0A0A0A"
                d.lineWidth = 2
                d.lineCap = "round"
                for (let i = 0; i < 3; i++) {
                    d.beginPath()
                    d.moveTo(13.3, 14.2 + i * 5.83)
                    d.lineTo(26.7, 14.2 + i * 5.83)
                    d.stroke()
                    }
                }
            ]
        ],

    mark: View [ x = 129, y = 3, width = 150, height = 45, cursor = "pointer",
        onClick() { app.go("") },
        Wordmark [ white = { app.darkChrome } ]
        ],

    signIn: View [ y = 8, width = 116, height = 40, x = { parent.width - 132 }, cursor = "pointer",
        box: WonkyBox [ width = 116, height = 40, squared = true,
            paper = { classroot.signIn.hovered ? 0xFFFFFF : 0xFFFAF5 } ],
        cap: Text [ width = 116, y = center, textAlign = center, wrap = false,
            fontFamily = [Zine, "monospace"], fontWeight = bold, fontSize = 14,
            letterSpacing = 2.8, textColor = #17130F, text = "SIGN IN" ]
        ]
    ]


/*
## The menu

The panel the patch opens: a cream card of destinations, over a scrim that
takes the dismissing click.
*/

class MenuRow extends View [ width = 252, height = 33, cursor = "pointer",

    label: string = "",
    target: string = "",
    active: boolean = false,
    external: string = "",
    icon: string = "",

    onClick() {
        if (this.external != "") app.navigate(this.external)
        else app.go(this.target)
        app.menuOpen = false
        },

    hi: View [ width = { parent.width }, height = { parent.height },
        fill = #F2EDE4, visible = { classroot.hovered || classroot.active } ],

    // The row marks, drawn — a drawing is how a mark no font will give you
    // gets made here, and it re-records only when `icon` or `active` change.

    mark: View [ x = 14, y = 8, width = 17, height = 17,
        draw(d: Draw) {
            const k = classroot.icon
            const ink = classroot.active ? "#E4270F" : "#1C1C18"
            d.strokeStyle = ink
            d.fillStyle = ink
            d.lineWidth = 1.6
            d.lineCap = "round"
            d.lineJoin = "round"
            if (k == "home") {
                d.beginPath()
                d.moveTo(1.5, 8)
                d.lineTo(8.5, 1.5)
                d.lineTo(15.5, 8)
                d.lineTo(15.5, 15.5)
                d.lineTo(1.5, 15.5)
                d.closePath()
                d.fill()
                } else if (k == "search") {
                d.beginPath()
                d.arc(7.2, 7.2, 5.2, 0, Math.PI * 2, false)
                d.stroke()
                d.beginPath()
                d.moveTo(11, 11)
                d.lineTo(15.5, 15.5)
                d.stroke()
                } else if (k == "person") {
                d.beginPath()
                d.arc(8.5, 5, 3.6, 0, Math.PI * 2, false)
                d.fill()
                d.beginPath()
                d.moveTo(1.8, 16)
                d.quadraticCurveTo(8.5, 9.2, 15.2, 16)
                d.closePath()
                d.fill()
                } else if (k == "wrench") {
                d.beginPath()
                d.arc(5, 5, 3.8, Math.PI * 0.72, Math.PI * 0.36, false)
                d.stroke()
                d.beginPath()
                d.moveTo(7.2, 7.4)
                d.lineTo(15, 15.2)
                d.stroke()
                } else if (k == "mail") {
                d.beginPath()
                d.rect(1.5, 3.5, 14, 10)
                d.stroke()
                d.beginPath()
                d.moveTo(1.5, 4.2)
                d.lineTo(8.5, 9.6)
                d.lineTo(15.5, 4.2)
                d.stroke()
                } else if (k == "shield") {
                d.beginPath()
                d.moveTo(8.5, 1)
                d.lineTo(15, 3.6)
                d.lineTo(15, 9)
                d.quadraticCurveTo(15, 14, 8.5, 16.5)
                d.quadraticCurveTo(2, 14, 2, 9)
                d.lineTo(2, 3.6)
                d.closePath()
                d.fill()
                }
            }
        ],

    cap: Text [ x = 43, y = center, wrap = false, fontSize = 15, fontWeight = medium,
        textColor = { classroot.active ? 0xE4270F : 0x1C1C18 },
        text = { classroot.label } ]
    ]


class MenuPanel extends View [ ignoreScroll = true, width = { app.width }, height = { app.hostHeight },
    visible = { app.menuOpen },

    scrim: View [ width = { parent.width }, height = { parent.height }, fill = #0000001F,
        onClick() { app.menuOpen = false }
        ],

    card: View [ y = 9, width = 252, height = 226,
        x = { (app.width - COL) / 2 + 26 },

        frame: WonkyBox [ width = 252, height = 226, lw = 1, dropX = 4, dropY = 4 ],

        rows: View [ y = 12,
            layout: SimpleLayout [ axis = y, spacing = 0 ],
            MenuRow [ label = "Home", icon = "home", target = "", active = { app.route == "home" } ],
            MenuRow [ label = "Browse", icon = "search", target = "browse", active = { app.route == "browse" } ],
            MenuRow [ label = "Profile", icon = "person", target = "" ]
            ],

        rule: View [ x = 18, y = 122, width = 216, height = 1, fill = #17130F26 ],

        rows2: View [ y = 132,
            layout: SimpleLayout [ axis = y, spacing = 0 ],
            MenuRow [ label = "Curator Hub", icon = "wrench", target = "browse" ],
            MenuRow [ label = "Invites", icon = "mail", target = "browse" ],
            MenuRow [ label = "Privacy Policy", icon = "shield", target = "privacy", active = { app.route == "legal" } ]
            ],

        close: View [ x = 216, y = 6, width = 30, height = 30, cursor = "pointer",
            onClick() { app.menuOpen = false },
            draw(d: Draw) {
                d.strokeStyle = "#17130F"
                d.lineWidth = 2
                d.lineCap = "round"
                d.beginPath()
                d.moveTo(9, 9)
                d.lineTo(21, 21)
                d.moveTo(21, 9)
                d.lineTo(9, 21)
                d.stroke()
                }
            ]
        ]
    ]


/*
## Carousel

Five slides — the authored value-props panel, then one per promo record — on a
sprung track. The dial under the right edge advances on click; a timer advances
it on its own, exactly as the site does.
*/

class SlideDot extends View [ width = 8, height = 8, cornerRadius = 4, cursor = "pointer",

    index: number = 0,
    on: boolean = { app.slide == this.index },
    fill = { this.on ? 0xFFFFFFEB : 0x00000000 },
    stroke = { this.on ? null : stroke(1.4, 0xFFFFFFCC) },
    onClick() { app.slide = this.index; app.slideTouched = true }
    ]


class ValueSlide extends View [ width = { COL }, height = { parent.height }, clip = true,

    photo: Cover [ width = { parent.width }, height = { parent.height },
        source = { app.valuePropsImage },
