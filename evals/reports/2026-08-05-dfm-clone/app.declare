        ],

    body: View [ x = 48, width = 352,
        y = { parent.height * 0.4675 - this.height / 2 },
        layout: SimpleLayout [ axis = y, spacing = 13 ],
        l1: ZineBlock [ x = center, size = 24, tilt = -1.25, maxText = 325,
            source = "discover\nmusic curated\nby real people" ],
        l2: ZineBlock [ x = center, size = 24, tilt = 0.9, maxText = 325,
            source = "hear tomorrow's favorites first" ],
        l3: ZineBlock [ x = center, size = 24, tilt = -0.7, maxText = 325,
