        natW = { app.sizeOf(app.valuePropsImage, true) },
        natH = { app.sizeOf(app.valuePropsImage, false) } ],
    scrim: View [ width = { parent.width }, height = { parent.height },
        fill = { gradient("180deg", 0x0000001A, 0x0000004D, 0x000000B3) },
        pointerEvents = "none" ],

