/*
# The Venue

Tickets for *The Marriage of Figaro*, twenty performances in the Grand Hall:
pick a performance, choose seats in the hall, pay, and keep the tickets.

How it is put together:

- **The records come from the box office's service** (port 8350): the
  production, one performance's seats, the account, the order. Each is a
  `DataSource`; the seats are kept current by the service's stream of other
  people's purchases (`live`), which writes into the seat map itself.
- **Where the person is** is a few attributes on the App: the performance (in
  the URL, `location`), whether they are at checkout (`waypoint`, so Back
  returns to the hall), the seats they have chosen (`chosen`), and what they
  have typed. Screens derive from these; nothing is shown or hidden by hand.
- **The parts are in four files**: the formats and checks
  (`venue-format.declare`), the hall (`venue-hall.declare`), checkout
  (`venue-checkout.declare`) and the tickets (`venue-tickets.declare`).
*/

include [ "venue-format.declare" ]

include [ "venue-hall.declare" ]

include [ "venue-checkout.declare" ]

include [ "venue-tickets.declare" ]

// ── The look ────────────────────────────────────────────────────────────────
//
// Warm paper and ink, and one accent — the burgundy of a seat that is yours,
// and of the buttons that commit to it. The four sections' seats are drawn in
// four depths of ink, the best seats darkest.

theme House [
    background = #F6F2EA, surface = #FFFDF9, line = #E3DCD0, lineStrong = #CFC6B8,
    text = #1F1A17, textMuted = #6B625A, textFaint = #A0968B,
    accent = #7A1F3D, accentHovered = #6B1A35, accentPressed = #5A152C, accentTextColor = #FFFFFF,
    accentTint = #F2E3E8,
    linkColor = #7A1F3D,
    control = #EDE7DC, controlHovered = #E6DFD2, controlPressed = #DCD3C4, controlSelected = #F2E3E8,
    error = #B3261E,
    ink = #231D1A, paper = #F6F2EA, gold = #C9A86A,
    stage = #2B2420, stageText = #E9DFCF,
    seatFace = #FFFDF9, seatGone = #DCD4C8,
    tiers = [#231D1A, #54483F, #7D7065, #A3968A],
    buttonHeight = 44, controlCornerRadius = 10
    ]


// ── The shape of the data ───────────────────────────────────────────────────

schema Performance [ id: string, startsAt: string, doorsAt: string, priceFromCents: number, seatsLeft: number, seats: number ]
schema Production [ title: string, hall: string, runningTime: string, performances[]: Performance ]

schema SeatRec [ id: string, number: number, status: string ]
schema RowRec [ name: string, seats[]: SeatRec ]
schema Section [ key: string, name: string, priceCents: number, feeCents: number, rows[]: RowRec ]
schema SeatMap [ performanceId: string, sections[]: Section ]

schema SavedCard [ id: string, brand: string, last4: string, expMonth: number, expYear: number ]
schema Billing [ line1: string, line2?: string, city: string, postalCode: string, country: string ]
schema Account [ name: string, email: string, billing: Billing, cards[]: SavedCard ]

schema Ticket [ seatId: string, section: string, row: string, number: number, barcode: string ]
schema Order [ code: string, email: string, totalCents: number, brand: string, last4: string, performanceId: string, tickets[]: Ticket ]

// A seat in the person's choice, as the order shows it.

schema Line [ id: string, section: string, row: string, number: number, price: number, fee: number, order: number ]
schema Lines [ lines[]: Line ]


// ── The seats of one performance ────────────────────────────────────────────
//
// The service's seat map, and what is true of it: where a seat is, what it
// costs, and the one write it takes — a seat someone else has bought.

class SeatMapSource extends DataSource [ schema = SeatMap, credentials = include,
    sections() -> Section[] { return this.value?.sections ?? [] },

    // ORCH-C-14 → the section, row and seat

    where(id: string) -> number[] {
        const [key, row, num] = id.split("-")
        const s = this.sections().findIndex((x) => x.key == key)
        if (s < 0) return [-1, -1, -1]
        const r = this.sections()[s].rows.findIndex((x) => x.name == row)
        if (r < 0) return [s, -1, -1]
        return [s, r, this.sections()[s].rows[r].seats.findIndex((x) => x.number == Number(num))]
        },
    section(id: string) -> Section? { const w = this.where(id); return w[0] < 0 ? null : this.sections()[w[0]] },
    isFree(id: string) -> boolean {
        const w = this.where(id)
        return w[2] >= 0 && this.sections()[w[0]].rows[w[1]].seats[w[2]].status == "available"
        },
    markSold(id: string) {
        const w = this.where(id)
        if (w[2] >= 0) this.set(["sections", w[0], "rows", w[1], "seats", w[2], "status"], "sold")
        },
    nameOf(id: string) -> string {
        const [key, row, num] = id.split("-")
        return (this.section(id)?.name ?? key) + ", row " + row + ", seat " + num
        },
    line(id: string) -> Line {
        const [key, row, num] = id.split("-")
        const s = this.section(id)
        const order = this.sections().findIndex((x) => x.key == key)
        return ({ id: id, section: s?.name ?? key, row: row, number: Number(num),
            price: s?.priceCents ?? 0, fee: s?.feeCents ?? 0, order: order })
        },

    // The free seat in the row `dir` rows behind (or in front of) `id`
    // nearest the same place along it — for the arrow keys.

    rowStep(id: string, dir: number) -> string {
        const rows: RowRec[] = []
        this.sections().forEach((s) => s.rows.forEach((r) => rows.push(r)))
        const w = this.where(id)
        if (w[2] < 0) return ""
        let at = 0
        for (let i = 0; i < w[0]; i++) at = at + this.sections()[i].rows.length
        at = at + w[1]
        const along = (w[2] + 0.5) / rows[at].seats.length
        for (let r = at + dir; r >= 0 && r < rows.length; r = r + dir) {
            const free = rows[r].seats.map((s, i) => ({ s: s, d: Math.abs((i + 0.5) / rows[r].seats.length - along) }))
                .filter((x) => x.s.status == "available")
                .sort((a, b) => a.d - b.d)
            if (free.length > 0) return free[0].s.id
            }
        return ""
        }
    ]


// ── A performance in the list ───────────────────────────────────────────────

class PerformanceRow extends Control [ width = 100%, padding = { app.wide ? [16, 20, 16, 20] : [14, 16, 14, 16] },
    left: number = { :seatsLeft ?? 0 },
    of: number = { :seats ?? 1 },
    starts: string = { :startsAt ?? "" },
    soldOut: boolean = { classroot.left == 0 },
    scarce: boolean = { classroot.left > 0 && classroot.left <= classroot.of * 0.15 },
    disabled = { classroot.soldOut },
    accessibilityRole = button,
    accessibilityLabel = { dateLabel(classroot.starts) + ", " + timeLabel(classroot.starts) + ", "
        + (classroot.soldOut ? "sold out" : "from " + money(:priceFromCents ?? 0) + ", " + classroot.left + " of " + classroot.of + " seats left"
        + (classroot.scarce ? ", nearly sold out" : "")) },
    press() { app.openPerformance(:id ?? "") },
    cornerRadius = 14,
    fill = { provided("theme").surface },
    stroke = { stroke(1, provided("theme").line) },
    State [ applied = { classroot.hovered || classroot.pressed }, stroke = { stroke(1, provided("theme").lineStrong) },
        fill = { provided("theme").seatFace } ],
    layout: SimpleLayout [ axis = x, spacing = { app.wide ? 22 : 14 }, align = center ],

    // the date, as a calendar leaf

    View [ width = 52, accessibilityHidden = true,
        layout: SimpleLayout [ axis = y, align = center ],
        Text [ fontSize = 12, fontWeight = semibold, letterSpacing = 1, textColor = { provided("theme").textMuted },
            text = { dayName(classroot.starts).toUpperCase() } ],
        Text [ fontFamily = { app.serifFace }, fontSize = 28, numeralWidth = tabular, text = { dayOfMonth(classroot.starts) } ],
        Text [ fontSize = 12, textColor = { provided("theme").textMuted }, text = { monthLabel(classroot.starts) } ]
        ],

    // the time, and how full the house is

    View [ flexes = true, accessibilityHidden = true,
        layout: SimpleLayout [ axis = y, spacing = 7 ],
        View [ layout: SimpleLayout [ axis = x, spacing = 8, align = baseline ],
            Text [ fontSize = 17, fontWeight = semibold, text = { dateLabel(classroot.starts) + " · " + timeLabel(classroot.starts) } ],
            Text [ visible = { isMatinee(classroot.starts) && app.wide }, fontSize = 13, textColor = { provided("theme").textMuted }, text = "Matinee" ]
            ],
        Fullness [ width = { app.wide ? 240 : 150 }, left = { classroot.left }, of = { classroot.of } ],
        Text [ fontSize = 13, fontWeight = { classroot.scarce || classroot.soldOut ? "semibold" : "regular" },
            textColor = { classroot.scarce || classroot.soldOut ? provided("theme").text : provided("theme").textMuted },
            text = { classroot.soldOut ? "Sold out" : classroot.scarce ? "Nearly sold out · " + classroot.left + " left" : classroot.left + " seats left" } ]
        ],

    // the price

    View [ accessibilityHidden = true, visible = { !classroot.soldOut },
        layout: SimpleLayout [ axis = y, align = end ],
        Text [ fontSize = 12, textColor = { provided("theme").textMuted }, text = "from" ],
        Text [ fontSize = 17, fontWeight = semibold, numeralWidth = tabular, text = { money(:priceFromCents ?? 0) } ]
        ],
    Chevron [ accessibilityHidden = true, width = 10, height = 16 ]
    ]


// How full the house is: a bar of the seats taken, in ink, deepening as it fills.

class Fullness [ height = 6, cornerRadius = 3, fill = { provided("theme").control }, clip = true,
    left: number = 0,
    of: number = 1,
    taken: number = { 1 - classroot.left / Math.max(1, classroot.of) },
    View [ height = 6, cornerRadius = 3, width = { parent.width * classroot.taken },
        fill = { classroot.taken >= 0.85 ? provided("theme").ink : provided("theme").tiers[2] } ]
    ]


class Chevron [
    ink: Color = { provided("theme").textFaint },
    draw(d: DrawContext) {
        d.strokeStyle = ink
        d.lineWidth = 1.8
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(2, 2)
        d.lineTo(8, 8)
        d.lineTo(2, 14)
        d.stroke()
        }
    ]


// A back control in the header: an arrow and where it goes.

class BackButton extends Control [ height = 44, padding = [0, 10, 0, 4], cornerRadius = 10,
    terse: boolean = false,                   // the arrow alone, where room is short
    State [ applied = { classroot.terse }, width = 44, padding = [0, 0, 0, 14] ],
    label: string = "",
    accessibilityLabel = { "Back to " + classroot.label.toLowerCase() },
    fill = { hovered || pressed ? provided("theme").control : null },
    layout: SimpleLayout [ axis = x, spacing = 6, align = center ],
    View [ width = 16, height = 16, accessibilityHidden = true,
        draw(d: DrawContext) {
            d.strokeStyle = provided("theme").text
            d.lineWidth = 1.8
            d.lineCap = "round"
            d.lineJoin = "round"
            d.beginPath()
            d.moveTo(10, 2)
            d.lineTo(4, 8)
            d.lineTo(10, 14)
            d.stroke()
            }
        ],
    Text [ visible = { !classroot.terse }, fontSize = 15, fontWeight = medium, text = { classroot.label } ]
    ]


// ── The app ─────────────────────────────────────────────────────────────────

App [ appName = "The Venue", minWidth = 320,
    theme = { { ...SanFrancisco, ...House } },
    fill = { provided("theme").background },
    textColor = { provided("theme").text },

    // Two families: a book serif for the production's voice, the system face
    // for everything a person reads to act.

    serifFace: array = { ["Iowan Old Style", "Palatino Linotype", "Palatino", "Book Antiqua", "Georgia", "serif"] },
    fontFamily = { ["-apple-system", "system-ui", "Segoe UI", "Helvetica Neue", "sans-serif"] },

    wide: boolean = { app.width >= 820 },
    api: string = "http://127.0.0.1:8350",

    // ── the records

    production: DataSource [ url = { app.api + "/api/production" }, schema = Production, credentials = include, autoFetch = true,
        title: string = { this.value?.title ?? "The Marriage of Figaro" }
        ],
    seats: SeatMapSource [ url = { app.perfId == "" ? "" : app.api + "/api/performances/" + app.perfId + "/seats" } ],
    me: DataSource [ url = { app.api + "/api/me" }, schema = Account, credentials = include,
        onLoad() { app.fillFromAccount() }
        ],

    // Other people buying, while this person is choosing or paying.

    live: EventStream [ url = { app.perfId == "" ? "" : app.api + "/api/events?performance=" + app.perfId },
        active = { app.perfId != "" && !app.done }, listenTo = ["seatchanged"], retry = 2,
        onMessage(e: StreamMessage) {
            const m = JSON.parse(e.data)
            if (m.status == "sold") app.seatTaken(m.seatId)
            }
        ],

    onInit() { app.me.fetch() },

    // ── where the person is

    location = "",                                   // the performance, as its id
    waypoint = "",                                   // "checkout" while paying
    perfId: string = { /^p[0-9]+$/.test(app.location) ? app.location : "" },
    perf: Performance? = { (app.production.value?.performances ?? []).find((p) => p.id == app.perfId) ?? null },
    chosen: string[] = [],
    done: boolean = { app.orderSrc.loaded },
    paying: boolean = { app.waypoint == "checkout" && app.chosen.length > 0 },
    inHall: string = { app.perfId == "" ? "list" : app.paying ? "checkout" : "hall" },
    screen: string = { app.done ? "tickets" : app.inHall },

    // A new hall, and a return to it, starts from the service's own map.

    trackChanges = ["perfId", "screen"],
    onChange() {
        if (app.screen == "hall" && app.perfId != "") app.seats.fetch()
        app.scrollTo(0)
        afterSettle(() => app.focusScreen())
        },
    onReady() { if (app.perfId != "") app.seats.fetch() },

    openPerformance(id: string) {
        if (id != app.perfId) app.chosen = []
        app.notice = ""
        app.location = id
        app.waypoint = ""
        },
    toList() { app.location = ""; app.waypoint = "" },
    toCheckout() { if (app.chosen.length > 0) { app.notice = ""; app.waypoint = "checkout" } },
    toHall() { app.waypoint = "" },
    startAgain() {
        app.orderSrc.clear()
        app.chosen = []
        app.notice = ""
        app.cvc = ""
        app.cardNumber = ""
        app.expiry = ""
        app.location = ""
        app.waypoint = ""
        },

    // Each screen's heading takes the focus as the screen arrives, so a
    // screen reader says where the person now is and Tab goes on from there.

    focusScreen() {
        const h = app.screen == "list" ? app.listHeading : app.screen == "hall" ? app.hallHeading
            : app.screen == "checkout" ? app.checkoutHeading : app.ticketsHeading
        if (h != null) Focus.focus(h)
        },
    listHeading: View? = { app.body.listScreen.intro.heading },
    hallHeading: View? = { app.body.hallScreen.top.heading },
    checkoutHeading: View? = { app.body.checkoutScreen.main.pane.col.heading },
    phoneHall: ZoomSurface = { app.body.hallScreen.stagePart.phoneHall },
    ticketsHeading: View? = { app.body.ticketsScreen.tickets?.head.heading ?? null },

    // ── the choice

    toggleSeat(id: string) {
        app.pulse = 1
        if (app.chosen.includes(id)) { app.chosen = app.chosen.filter((s) => s != id); return }
        if (!app.seats.isFree(id)) return
        app.chosen = [...app.chosen, id]
        app.notice = ""
        },

    // The total answers a change of choice with a small beat: `pulse` is set
    // to 1 and springs back to rest.

    pulse: number = 0,
    Spring [ attribute = pulse, to = 0, stiffness = 380, damping = 14 ],

    // Someone else bought a seat. It is gone for everyone; if it was in this
    // person's choice, it leaves it and they are told which.
    // While this person's own payment is out, the seats it is buying are
    // announced as sold too: those are theirs, and stay in the choice (a seat
    // someone else got first comes back as the payment's refusal).

    seatTaken(id: string) {
        app.seats.markSold(id)
        if (!app.chosen.includes(id) || app.sending || app.done) return
        app.chosen = app.chosen.filter((s) => s != id)
        const said = app.seats.nameOf(id) + " was just taken by someone else."
        app.notice = said
        },

    // The payment found seats already sold: nothing was charged. They leave
    // the choice, and the person is back in the hall with the rest.

    seatsLost(ids: string[], message: string) {
        ids.forEach((id) => app.seats.markSold(id))
        app.chosen = app.chosen.filter((s) => !ids.includes(s))
        app.notice = message != "" ? message : ids.map((id) => app.seats.nameOf(id)).join(", ") + " has just been taken."
        app.waypoint = ""
        },
    notice: string = "",

    seatAbove(id: string, dir: number) -> string { return app.seats.rowStep(id, dir) },

    order: Dataset [ schema = Lines, contents = { app.lines() } ],
    lines() -> Lines {
        const ls = app.chosen.map((id) => app.seats.line(id))
        ls.sort((a, b) => a.order - b.order || a.row.localeCompare(b.row) || a.number - b.number)
        return ({ lines: ls })
        },
    seatsCents: number = { app.order.value.lines.reduce((n, l) => n + l.price, 0) },
    feesCents: number = { app.order.value.lines.reduce((n, l) => n + l.fee, 0) },
    totalCents: number = { app.seatsCents + app.feesCents },
    choiceLine: string = { seatCount(app.chosen.length) + " · " + money(app.seatsCents) },
    perfLine: string = { app.perf == null ? "" : dateLabel(app.perf.startsAt) + " · " + timeLabel(app.perf.startsAt) + " · Grand Hall" },

    // ── the account

    signedIn: boolean = { app.me.loaded },
    accountEmail: string = { app.me.value?.email ?? "" },
    signInOpen: boolean = false,
    signInEmail: string = "",
    signInPassword: string = "",
    showPassword: boolean = false,
    session: DataSource [ url = { app.api + "/api/session" }, method = "POST", credentials = include,
        body = { { email: app.signInEmail.trim(), password: app.signInPassword } },
        onLoad() {
            app.signInOpen = false
            app.signInPassword = ""
            app.me.fetch()
            }
        ],
    signOut: DataSource [ url = { app.api + "/api/session" }, method = "DELETE", credentials = include,
        onLoad() {
            app.me.clear()
            app.payWith = "new"
            Accessibility.announce("You’re signed out.")
            afterSettle(() => Focus.focus(app.bar.signInButton))
            }
        ],

    // Signed in: the account fills what the person has not typed.

    fillFromAccount() {
        const a = app.me.value
        if (a == null) return
        if (app.email.trim() == "") app.email = a.email
        if (app.cardName.trim() == "") app.cardName = a.name
        if (app.line1.trim() == "" && app.city.trim() == "" && app.postal.trim() == "") {
            app.line1 = a.billing.line1
            app.line2 = a.billing.line2 ?? ""
            app.city = a.billing.city
            app.postal = a.billing.postalCode
            app.country = a.billing.country
            }
        const usable = a.cards.find((c) => !cardExpired(c.expMonth, c.expYear))
        if (app.payWith == "new" && app.cardNumber == "" && usable != null) app.payWith = usable.id
        Accessibility.announce("Signed in as " + a.name + ".")
        },

    // ── paying

    payWith: string = "new",
    savedCard: SavedCard? = { (app.me.value?.cards ?? []).find((c) => c.id == app.payWith) ?? null },
    payingSaved: boolean = { app.signedIn && app.savedCard != null },
    email: string = "",
    cardName: string = "",
    cardNumber: string = "",
    expiry: string = "",
    cvc: string = "",
    line1: string = "",
    line2: string = "",
    city: string = "",
    postal: string = "",
    country: string = "US",
    newBrand: string = { cardBrand(digitsOf(app.cardNumber)) },
    codeLength: number = { codeLengthFor(app.payingSaved ? app.savedCard?.brand ?? "" : app.newBrand) },

    orderSrc: DataSource [ url = { app.api + "/api/orders" }, method = "POST", credentials = include, schema = Order,
        body = { app.orderBody() },
        onLoad() {
            app.chosen = []
            app.cvc = ""
            app.cardNumber = ""
            app.expiry = ""
            }
        ],
    orderBody() -> object {
        const base = ({ performanceId: app.perfId, seatIds: app.order.value.lines.map((l) => l.id) })
        if (app.payingSaved) return ({ ...base, email: app.accountEmail,
            payment: ({ savedCardId: app.payWith, cvc: app.cvc }) })
        const [m, y] = expiryParts(app.expiry)
        return ({ ...base, email: app.email.trim(),
            payment: ({ card: ({ number: digitsOf(app.cardNumber), expMonth: m, expYear: y, cvc: app.cvc, name: app.cardName.trim() }),
                billing: ({ line1: app.line1.trim(), line2: app.line2.trim() == "" ? null : app.line2.trim(), city: app.city.trim(),
                    postalCode: tidyPostal(app.postal, app.country), country: app.country }) }) })
        },
    sending: boolean = { app.payForm.pending },
    payError: string = { app.payForm.error },
    payForm: PayForm = { app.body.checkoutScreen.main.pane.col.form },

    // ── the tickets

    placed: Order? = { app.orderSrc.loaded ? app.orderSrc.value : null },
    ticketCount: number = { app.orderSrc.value?.tickets?.length ?? 0 },
    placedPerf: Performance? = { (app.production.value?.performances ?? []).find((p) => p.id == app.orderSrc.value?.performanceId) ?? null },
    ticketPerfLine: string = { app.placedPerf == null ? "" : dateLabel(app.placedPerf.startsAt) + " · " + timeLabel(app.placedPerf.startsAt) },
    ticketDoors: string = { app.placedPerf == null ? "" : timeLabel(app.placedPerf.doorsAt) },

    // ── the screen

    layout: SimpleLayout [ axis = y ],

    bar: View [ width = 100%, height = 60, padding = { [0, app.wide ? 28 : 12, 0, app.wide ? 28 : 16] },
        accessibilityRole = banner,
        stroke = { [null, null, stroke(1, provided("theme").line), null] },
        layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
        wordmark: View [ flexes = true,
            layout: SimpleLayout [ axis = x, spacing = 10, align = baseline ],
            Text [ fontFamily = { app.serifFace }, fontSize = 20, fontWeight = semibold, letterSpacing = 0.2, wrap = false, text = "The Grand Hall" ],
            Text [ visible = { app.wide }, fontSize = 13, textColor = { provided("theme").textMuted }, text = "Box office" ]
            ],
        Text [ visible = { app.signedIn && app.wide }, fontSize = 14, textColor = { provided("theme").textMuted },
            text = { app.me.value?.name ?? "" } ],
        signOutButton: Button [ visible = { app.signedIn }, label = "Sign out",
            onClick() { app.signOut.fetch() }
            ],
        signInButton: Button [ visible = { !app.signedIn }, label = "Sign in",
            onClick() { app.signInOpen = true }
            ]
        ],

    // The hall and checkout are frames the size of the window, with their own
    // panes; the list and the tickets are pages that scroll.

    framed: boolean = { app.screen == "hall" || app.screen == "checkout" },
    body: View [ width = 100%, accessibilityRole = main,
        State [ applied = { app.framed }, flexes = true ],

        // ── 1. the performances

        listScreen: View [ visible = { app.screen == "list" }, width = 100%,
            padding = { app.wide ? [48, 28, 64, 28] : [28, 16, 48, 16] },
            layout: SimpleLayout [ axis = y, spacing = 28, align = center ],
            intro: View [ width = { Math.min(760, parent.contentBox("width")) },
                layout: SimpleLayout [ axis = y, spacing = 8 ],
                Text [ fontSize = 13, fontWeight = semibold, letterSpacing = 1.4, textColor = { provided("theme").accent },
                    text = "THIS SEASON IN THE GRAND HALL" ],
                heading: Text [ width = 100%, focusable = quiet, accessibilityRole = heading, accessibilityLevel = 1,
                    fontFamily = { app.serifFace }, fontSize = { app.wide ? 48 : 34 }, letterSpacing = -0.5,
                    text = { app.production.title } ],
                Text [ width = 100%, fontSize = 16, textColor = { provided("theme").textMuted },
                    text = { "Mozart’s comedy in four acts · " + (app.production.value?.runningTime ?? "3h 10m") + " · twenty performances. Choose one to see the house." } ]
                ],
            perfs: View [ width = { Math.min(760, parent.contentBox("width")) }, datapath = { app.production.value },
                accessibilityRole = list, accessibilityLabel = "Performances",
                layout: SimpleLayout [ axis = y, spacing = 10 ],
                View [ datapath = :performances[], width = 100%, accessibilityRole = listItem,
                    PerformanceRow [ ]
                    ]
                ],
            Text [ visible = { app.production.failed }, fontSize = 15, textColor = { provided("theme").error },
                text = "The box office isn’t answering. Please reload in a moment." ]
            ],

        // ── 2. the hall

        hallScreen: View [ visible = { app.screen == "hall" }, width = 100%, height = 100%,
            layout: SimpleLayout [ axis = y ],
            top: View [ width = 100%, padding = { app.wide ? [12, 28, 8, 20] : [8, 12, 6, 6] },
                layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
                BackButton [ label = "Performances", terse = { !app.wide },
                    press() { app.toList() }
                    ],
                heading: Text [ flexes = true, focusable = quiet, accessibilityRole = heading, accessibilityLevel = 1,
                    fontFamily = { app.serifFace }, fontSize = { app.wide ? 24 : 19 }, wrap = false,
                    text = { app.perf == null ? "" : dateLabel(app.perf.startsAt) + " · " + timeLabel(app.perf.startsAt) } ],
                Legend [ visible = { app.wide } ],
                Button [ visible = { !app.wide && app.phoneHall.close }, label = "Whole house",
                    onClick() { app.phoneHall.wholeHouse() }
                    ]
                ],
            notice: View [ visible = { app.notice != "" }, width = 100%, padding = { app.wide ? [0, 28, 8, 28] : [0, 16, 6, 16] },
                Text [ width = 100%, wrap = true, fontSize = 15, fontWeight = medium, textColor = { provided("theme").error },
                    accessibilityRole = status, accessibilityLive = assertive, text = { app.notice } ]
                ],
            stagePart: View [ width = 100%, flexes = true,
                layout: SimpleLayout [ axis = x, align = stretch ],

                // At a desk: the whole house, drawn to fit.

                deskHall: View [ visible = { app.wide }, flexes = true, scrolls = both,
                    fitPitch: number = { Math.max(15, Math.min(30, (this.width - 48) / 36.5, (this.height - 28) / 40)) },
                    Hall [ x = center, y = 12, pitch = { parent.fitPitch } ]
                    ],

                // On a phone: the house at a finger's size, zoomed.

                phoneHall: ZoomSurface [ visible = { !app.wide }, flexes = true ],

                side: View [ visible = { app.wide }, width = 340, padding = [24, 28, 24, 24],
                    stroke = { [null, null, null, stroke(1, provided("theme").line)] },
                    layout: SimpleLayout [ axis = y, spacing = 18 ],
                    sideHeading: Text [ accessibilityRole = heading, accessibilityLevel = 2, focusable = quiet,
                        fontFamily = { app.serifFace }, fontSize = 20, text = "Your seats" ],
                    Text [ visible = { app.chosen.length == 0 }, width = 100%, wrap = true, fontSize = 15,
                        textColor = { provided("theme").textMuted },
                        text = "Choose seats in the hall. The darker the ring, the better the view; a small dot is taken." ],
                    View [ width = 100%, datapath = { app.order.value }, visible = { app.chosen.length > 0 },
                        restoresFocusTo = { parent.sideHeading },
                        layout: SimpleLayout [ axis = y ],
                        ChosenLine [ datapath = :lines[] ]
                        ],
                    Spacer [ ],
                    ChoiceBar [ visible = { app.chosen.length > 0 }, width = 100% ]
                    ]
                ],
            phoneFoot: View [ visible = { !app.wide }, width = 100%,
                padding = { [10, 16, 10 + app.safeBottom, 16] },
                stroke = { [stroke(1, provided("theme").line), null, null, null] },
                fill = { provided("theme").surface },
                layout: SimpleLayout [ axis = y, spacing = 8 ],
                Legend [ visible = { app.chosen.length == 0 } ],
                ChoiceBar [ visible = { app.chosen.length > 0 }, width = 100% ]
                ]
            ],

        // ── 3. checkout

        checkoutScreen: View [ visible = { app.screen == "checkout" }, width = 100%, height = 100%,
            padding = { [0, 0, app.keyboardHeight, 0] },
            layout: SimpleLayout [ axis = y ],
            main: View [ width = 100%, flexes = true,
                layout: SimpleLayout [ axis = x, align = stretch ],
                pane: View [ flexes = true, scrolls = y,
                    col: View [ x = center, width = { Math.min(560, parent.width - (app.wide ? 64 : 32)) },
                        padding = { app.wide ? [16, 0, 64, 0] : [8, 0, 40, 0] },
                        layout: SimpleLayout [ axis = y, spacing = 22 ],
                        BackButton [ label = "Seats",
                            press() { app.toHall() }
                            ],
                        heading: Text [ width = 100%, focusable = quiet, accessibilityRole = heading, accessibilityLevel = 1,
                            fontFamily = { app.serifFace }, fontSize = { app.wide ? 34 : 28 }, text = "Checkout" ],
                        Text [ visible = { app.notice != "" }, width = 100%, wrap = true, fontSize = 15, fontWeight = medium,
                            textColor = { provided("theme").error }, accessibilityRole = status, accessibilityLive = assertive,
                            text = { app.notice } ],
                        account: View [ visible = { !app.signedIn }, width = 100%, padding = [14, 16, 14, 16], cornerRadius = 12,
                            fill = { provided("theme").control },
                            layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
                            Text [ flexes = true, wrap = true, fontSize = 15,
                                text = "No account needed. Have one? Sign in to use your saved cards — nothing you’ve typed is lost." ],
                            Button [ label = "Sign in",
                                onClick() { app.signInOpen = true }
                                ]
                            ],
                        phoneOrder: View [ visible = { !app.wide }, width = 100%, padding = [16, 16, 16, 16], cornerRadius = 14,
                            fill = { provided("theme").surface }, stroke = { stroke(1, provided("theme").line) },
                            OrderSummary [ ]
                            ],
                        form: PayForm [ ]
                        ]
                    ],
                deskOrder: View [ visible = { app.wide }, width = 380, padding = [32, 28, 28, 28],
                    fill = { provided("theme").surface },
                    stroke = { [null, null, null, stroke(1, provided("theme").line)] },
                    layout: SimpleLayout [ axis = y, spacing = 18 ],
                    OrderSummary [ ],
                    PayError [ ],
                    PayButton [ width = 100% ],
                    Text [ width = 100%, wrap = true, fontSize = 13, textColor = { provided("theme").textMuted },
                        text = "Your card details go only to the box office’s payment service." ]
                    ]
                ],
            payBar: View [ visible = { !app.wide }, width = 100%,
                padding = { [10, 16, app.keyboardHeight > 0 ? 10 : 10 + app.safeBottom, 16] },
                fill = { provided("theme").surface },
                stroke = { [stroke(1, provided("theme").line), null, null, null] },
                layout: SimpleLayout [ axis = y, spacing = 8 ],
                PayError [ ],
                View [ width = 100%,
                    layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
                    View [ layout: SimpleLayout [ axis = y ],
                        Text [ fontSize = 12, textColor = { provided("theme").textMuted }, text = { seatCount(app.chosen.length) + " with fees" } ],
                        Text [ fontSize = 17, fontWeight = semibold, numeralWidth = tabular, text = { money(app.totalCents) } ]
                        ],
                    PayButton [ flexes = true ]
                    ]
                ]
            ],

        // ── 4. the tickets

        ticketsScreen: View [ visible = { app.screen == "tickets" }, width = 100%,
            tickets: TicketsScreen [ exists = { app.done } ]
            ]
        ],

    // ── layers

    // Signed in, the button that opened the sheet is gone: the focus goes to
    // what the person does next.

    signInSheet: Sheet [ edge = "end", accessibilityLabel = "Sign in", shown = { app.signInOpen },
        restoresFocusTo = { !app.signedIn ? null : app.screen == "checkout" ? app.payForm.payWithHeading : app.bar.signOutButton },
        commit(open: boolean) { app.signInOpen = open },
        SignIn [ exists = { app.signInSheet.present } ]
        ]
    ]


// A seat in the side panel's list.

class ChosenLine [ width = 100%, padding = [10, 0, 10, 0],
    stroke = { [null, null, stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        Text [ fontSize = 15, fontWeight = medium, text = { :section ?? "" } ],
        Text [ fontSize = 13, textColor = { provided("theme").textMuted }, text = { "Row " + (:row ?? "") + ", seat " + (:number ?? 0) } ]
        ],
    Text [ fontSize = 15, numeralWidth = tabular, text = { money(:price ?? 0) } ],
    Button [ label = "Remove", accessibilityLabel = { "Remove " + (:section ?? "") + ", row " + (:row ?? "") + ", seat " + (:number ?? 0) },
        onClick() { app.toggleSeat(:id ?? "") }
        ]
    ]


// The running summary — "3 seats · $240.00" — and the way on.

class ChoiceBar [
    layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 1 ],
        summary: Text [ fontSize = 18, fontWeight = semibold, numeralWidth = tabular, accessibilityLive = polite,
            scale = { 1 + 0.07 * app.pulse }, pivotX = 0, pivotY = { this.height / 2 },
            text = { app.choiceLine } ],
        Text [ fontSize = 12, textColor = { provided("theme").textMuted }, text = "Booking fees at checkout" ]
        ],
    Button [ primary = true, label = "Continue",
        onClick() { app.toCheckout() }
        ]
    ]


// ── Signing in ──────────────────────────────────────────────────────────────

class SignIn extends Form [ width = 100%, source = { app.session },
    failedMessage = "Signing in didn’t work. Please try again.",
    layout: SimpleLayout [ axis = y, spacing = 16 ],
    Text [ accessibilityRole = heading, accessibilityLevel = 2, fontFamily = { app.serifFace }, fontSize = 26, text = "Sign in" ],
    Text [ width = 100%, wrap = true, fontSize = 15, textColor = { provided("theme").textMuted },
        text = "Use your saved cards and address. Your seats and anything you’ve typed stay as they are." ],
    FormField [ label = "Email",
        Entry [ name = "email", purpose = email, required = "Enter your email address.", value <-> app.signInEmail,
            validate(v: string) -> string { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? "" : "Enter an email address like name@example.com." }
            ]
        ],
    FormField [ label = "Password",
        Entry [ name = "password", purpose = password, required = "Enter your password.",
            concealed = { !app.showPassword }, value <-> app.signInPassword ]
        ],
    Checkbox [ label = "Show password", checked <-> app.showPassword ],
    Text [ visible = { classroot.error != "" }, width = 100%, wrap = true, fontSize = 15, fontWeight = medium,
        accessibilityRole = status, accessibilityLive = assertive,
        textColor = { provided("theme").error }, text = { classroot.error } ],
    Button [ width = 100%, primary = true, label = { classroot.pending ? "Signing in…" : "Sign in" },
        onClick() { classroot.submit() }
        ],
    Button [ width = 100%, label = "Not now",
        onClick() { app.signInOpen = false }
        ]
    ]
