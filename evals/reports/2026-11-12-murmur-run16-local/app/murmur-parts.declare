/*
# Murmur: the parts

The look of Murmur, kept apart from how it works: the two palettes, the drawn
marks, and the small pieces the screens are made of (an avatar, a round icon
button, the waveform scrubber). `murmur.declare` includes this file.
*/

// ── Colors ──────────────────────────────────────────────────────────────────
//
// Paper and ink. The person using the app writes in ink (a deep blue-black
// bubble); everyone else writes on paper. One warm accent, vermilion, is kept
// for exactly one meaning: something here is new.
//
// `voices` are the inks other people's names are set in, in a group, and the
// grounds of a monogram when someone has no picture. A person keeps one for
// the whole app, picked by their place in the people list.

theme MurmurLight [
    background = #F4F1EC, surface = #FBFAF7, card = #FFFFFF,
    paper = #FFFFFF, paperLine = #E6E1D8, ink = #1F2A37, inkText = #F6F3EE,
    line = #E4DFD6, hover = #EEEAE3, selection = #E7E2D9,
    text = #1E1F22, textMuted = #6B6760, textFaint = #9A958C,
    accent = #D9472F, accentSoft = #FBE6E1, accentText = #FFFFFF,
    linkColor = #2F5D9E, scrim = #00000066, monogramText = #FFFFFF,
    voices = [#2F6FA3, #A34A6B, #3F7F5A, #9A6418, #6553B0, #237E86, #B04A2E, #5C6470]
    ]


theme MurmurDark [
    background = #16171A, surface = #1C1D21, card = #232429,
    paper = #26272C, paperLine = #303137, ink = #D9DEE6, inkText = #16171A,
    line = #2B2C31, hover = #24252A, selection = #2C2D33,
    text = #ECEAE6, textMuted = #A19D96, textFaint = #75726C,
    accent = #FF6A50, accentSoft = #3A221D, accentText = #16171A,
    linkColor = #8FB5F0, scrim = #000000AA, monogramText = #16171A,
    voices = [#7FB2DE, #E08AAA, #7CC49A, #E0A75A, #A897F0, #66C4CC, #F08A68, #A7AEBA]
    ]


// ── Marks ───────────────────────────────────────────────────────────────────
//
// Every mark is drawn by one pen on the library's 16-unit grid, so they read
// as one family at any size.

class Mark extends Icon [
    shape: string = "",
    filled: boolean = false,
    draw(d: DrawContext) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        if (shape == "back") {
            d.moveTo(10, 2.5); d.lineTo(4.5, 8); d.lineTo(10, 13.5); d.stroke()
        } else if (shape == "send") {
            d.moveTo(8, 13.5); d.lineTo(8, 2.8); d.moveTo(3.5, 7.3); d.lineTo(8, 2.8); d.lineTo(12.5, 7.3); d.stroke()
        } else if (shape == "down") {
            d.moveTo(8, 2.5); d.lineTo(8, 13.2); d.moveTo(3.5, 8.7); d.lineTo(8, 13.2); d.lineTo(12.5, 8.7); d.stroke()
        } else if (shape == "photo") {
            d.roundRect(1.8, 3, 12.4, 10, 2)
            d.moveTo(2.2, 11.5); d.lineTo(6, 7.6); d.lineTo(9, 10.4); d.lineTo(10.8, 8.8); d.lineTo(13.8, 11.6)
            d.stroke(); d.beginPath(); d.arc(10.6, 6, 1.1, 0, 6.3); d.fill()
        } else if (shape == "play") {
            d.moveTo(4.5, 2.6); d.lineTo(13, 8); d.lineTo(4.5, 13.4); d.closePath(); d.fill(); d.stroke()
        } else if (shape == "pause") {
            d.roundRect(3.6, 2.8, 2.8, 10.4, 0.8); d.roundRect(9.6, 2.8, 2.8, 10.4, 0.8); d.fill()
        } else if (shape == "react") {
            d.arc(8, 8, 6, 0, 6.3); d.stroke(); d.beginPath()
            d.arc(8, 8.4, 3.2, 0.35, Math.PI - 0.35); d.stroke(); d.beginPath()
            d.arc(5.9, 6.2, 0.8, 0, 6.3); d.arc(10.1, 6.2, 0.8, 0, 6.3); d.fill()
        } else if (shape == "close") {
            d.moveTo(3.5, 3.5); d.lineTo(12.5, 12.5); d.moveTo(12.5, 3.5); d.lineTo(3.5, 12.5); d.stroke()
        }
        }
    ]


// ── A person's face ─────────────────────────────────────────────────────────
//
// Their picture when they have one; otherwise their initials on their own
// color, so a person without a photograph is still recognisably someone.

class Avatar [ width = 36, height = { this.width }, cornerRadius = { this.width / 2 }, clip = true,
    person: string = "",
    name: string = { app.convos.nameOf(classroot.person) },
    picture: string = { app.convos.avatarOf(classroot.person) },
    accessibilityRole = image,
    accessibilityLabel = { classroot.name },
    fill = { app.voiceOf(classroot.person) },
    initials: TextLabel [ x = center, y = center, visible = { !(classroot.face?.loaded ?? false) },
        fontSize = { classroot.width * 0.38 }, fontWeight = semibold, textColor = { provided("theme").monogramText },
        text = { initialsOf(classroot.name) } ],
    face: Image [ exists = { classroot.picture != "" }, width = 100%, height = 100%, fit = cover,
        source = { app.api + classroot.picture } ]
    ]


// ── A round icon button ─────────────────────────────────────────────────────

class RoundButton extends Control [ width = { app.tap }, height = { this.width }, cornerRadius = { this.width / 2 },
    shape: string = "",
    tone: Color = { provided("theme").textMuted },
    size: number = 18,
    fill = { pressed ? provided("theme").selection : hovered ? provided("theme").hover : null },
    Mark [ x = center, y = center, iconSize = { classroot.size }, weight = 1.8,
        shape = { classroot.shape }, ink = { classroot.tone } ]
    ]


// ── The voice scrubber ──────────────────────────────────────────────────────
//
// The recording's own loudness, drawn as a row of bars, is the track. Its
// length is the clip's length (a longer message is a longer line, up to a
// cap), so how long it is shows before it plays. What has played is inked;
// what is still to come is faint. Press anywhere on it to go there, or drag
// along it; the arrow keys step five percent.

class Waveform extends Control [ height = 34, claim = x,
    peaks: number[] = [],
    progress: number = 0,           // 0–1, how far it has played
    lit: boolean = false,           // this clip is the one playing or paused
    played: Color = { provided("theme").text },
    unplayed: Color = { provided("theme").textFaint },
    seek(f: number) {},
    accessibilityRole = slider,
    accessibilityValue = { Math.round(progress * 100) },
    accessibilityMin = 0,
    accessibilityMax = 100,
    accessibilityIncrement() { seek(Math.min(1, progress + 0.05)) },
    accessibilityDecrement() { seek(Math.max(0, progress - 0.05)) },
    at(x: number) -> number { return Math.max(0, Math.min(1, x / width)) },
    onPointerDown(e: PointerEvent) { super.onPointerDown(); seek(at(e.x)) },
    onDrag(e: PointerEvent) { seek(at(e.x)) },

    // One bar every five points, each the loudest of the samples it covers.

    draw(d: DrawContext) {
        if (peaks.length == 0) return
        const bar = 2.5
        const step = 5
        const n = Math.max(1, Math.floor((d.w + step - bar) / step))
        const head = progress * d.w
        for (let i = 0; i < n; i++) {
            const a = Math.floor(i * peaks.length / n)
            const b = Math.max(a + 1, Math.floor((i + 1) * peaks.length / n))
            const loud = Math.max(...peaks.slice(a, b))
            const x = i * step
            const h = Math.max(3, loud * (d.h - 4))
            d.fillStyle = x + bar / 2 <= head ? played : unplayed
            d.beginPath()
            d.roundRect(x, (d.h - h) / 2, bar, h, bar / 2)
            d.fill()
        }
        if (lit) {
            d.fillStyle = played
            d.beginPath()
            d.roundRect(Math.min(d.w - 2, Math.max(0, head - 1)), 0, 2, d.h, 1)
            d.fill()
        }
        }
    ]
