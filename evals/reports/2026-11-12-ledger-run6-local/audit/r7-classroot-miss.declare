// Message check: `classroot.asTable` written in a child of a ChartFrame instance placed inside
// Page. classroot is Page (the class this is written in); the member is the ChartFrame's.
// Does the message say where asTable is?
class ChartFrame [ asTable: boolean = false ]
class Page [
    ChartFrame [ Text [ visible = { !classroot.asTable }, text = "chart" ] ]
    ]
App [ width = 200, height = 100, Page [ ] ]
