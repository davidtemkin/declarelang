// Repro: does `pointerEvents = "none"` stop a TextInput (and a Combobox) taking a press?
// Each field lies, invisible (opacity 0), over a pressable row. A press on the row's
// middle should count a row press; it should not put the caret in the field.
App [ width = 600, height = 260, fill = white,
    rowPresses: number = 0,
    fieldFocused: string = "",
    View [ x = 20, y = 20, width = 400, height = 60, fill = #EEF,
        onClick() { app.rowPresses = app.rowPresses + 1 },
        TextInput [ x = 2, y = 10, width = 396, height = 40, opacity = 0, pointerEvents = "none",
            accessibilityLabel = "Hidden text",
            onFocus() { app.fieldFocused = "text" } ]
        ],
    View [ x = 20, y = 100, width = 400, height = 60, fill = #EFE,
        onClick() { app.rowPresses = app.rowPresses + 1 },
        Combobox [ x = 2, y = 10, width = 396, height = 40, opacity = 0, pointerEvents = "none",
            accessibilityLabel = "Hidden combo", items = { [ ({ id: "a", label: "A" }) ] },
            onFocus() { app.fieldFocused = "combo" } ]
        ],
    Text [ x = 20, y = 200, text = { "row presses " + app.rowPresses + " · focused " + app.fieldFocused } ]
    ]
