/*
# 7GUIs

The seven tasks of the 7GUIs benchmark (Eugen Kiss), in one window: a sidebar
names them, and the page beside it shows the one that is open.

Each task is a class in a file of its own, holding its own state, and reads
on its own:

- `counter.declare`      — 1. Counter
- `temperature.declare`  — 2. Temperature Converter
- `flight.declare`       — 3. Flight Booker
- `timer.declare`        — 4. Timer
- `crud.declare`         — 5. CRUD
- `circles.declare`      — 6. Circle Drawer
- `cells.declare`        — 7. Cells, with its formula language in `formula.ts`

This file is the window around them. Which task is open is the App's
`location` — the URL's #fragment — so each task has an address, the sidebar's
items are links, and Back goes to the task before. Every task stays built while
another is open, so each keeps its state (and the timer keeps running).
*/

include [ "counter.declare" ]

include [ "temperature.declare" ]

include [ "flight.declare" ]

include [ "timer.declare" ]

include [ "crud.declare" ]

include [ "circles.declare" ]

include [ "cells.declare" ]

defaultFlags [ devices = desktop ]

// A task in the sidebar: its number and name, as a link to it.

class TaskLink [ width = 100%, height = 32, cornerRadius = 6, padding = [0, 10, 0, 10],
    id: string = "",
    name: string = "",
    here: boolean = { app.taskId == classroot.id },
    link = { "#" + classroot.id },
    fill = { hovered ? provided("theme").controlHovered : null },
    State [ applied = { classroot.here }, fill = { provided("theme").controlSelected } ],
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    Text [ width = 14, textAlign = end, fontSize = 13, textColor = { provided("theme").textMuted }, text = { "" + (classroot.rowIndex + 1) } ],
    Text [ fontSize = 14, text = { classroot.name },
        State [ applied = { classroot.here }, fontWeight = semibold ]
        ]
    ]


// A task's page: its name above it. Its children are the task.

class TaskPage [ width = 100%, height = 100%, defaultPlacement = body,
    title: string = "",
    layout: SimpleLayout [ axis = y, spacing = 20 ],
    Text [ fontSize = 22, fontWeight = semibold, text = { classroot.title } ],
    body: View [ width = 100%, flexes = true ]
    ]


App [ appName = "7GUIs", minWidth = 860, minHeight = 600, scrolls = none,
    theme = { app.systemDark ? SanFranciscoDark : SanFrancisco },
    fill = { provided("theme").background },
    textColor = { provided("theme").text },

    tasks: Dataset { { "tasks": [
        { "id": "counter", "name": "Counter" },
        { "id": "temperature", "name": "Temperature Converter" },
        { "id": "flight", "name": "Flight Booker" },
        { "id": "timer", "name": "Timer" },
        { "id": "crud", "name": "CRUD" },
        { "id": "circles", "name": "Circle Drawer" },
        { "id": "cells", "name": "Cells" } ] } },

    // ── where the person is: the open task, from the URL

    location = "counter",
    taskId: string = { app.location == "" ? "counter" : app.location },

    layout: SimpleLayout [ axis = x, align = stretch ],

    side: View [ width = 220, padding = [20, 12, 20, 12],
        fill = { provided("theme").surface }, stroke = { [null, stroke(1, provided("theme").line), null, null] },
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        Text [ padding = [0, 0, 0, 10], fontSize = 13, fontWeight = semibold, textColor = { provided("theme").textMuted },
            text = "7GUIs" ],
        list: View [ width = 100%, datapath = { app.tasks.value },
            layout: SimpleLayout [ axis = y, spacing = 2 ],
            TaskLink [ datapath = :tasks[], id = :id, name = :name ]
            ]
        ],

    page: View [ flexes = true, padding = [24, 32, 32, 32],
        TaskPage [ shows = "counter", title = "Counter",
            CounterTask [ ]
            ],
        TaskPage [ shows = "temperature", title = "Temperature Converter",
            TemperatureTask [ ]
            ],
        TaskPage [ shows = "flight", title = "Flight Booker",
            FlightTask [ ]
            ],
        TaskPage [ shows = "timer", title = "Timer",
            TimerTask [ ]
            ],
        TaskPage [ shows = "crud", title = "CRUD",
            CrudTask [ width = 100%, height = 100% ]
            ],
        TaskPage [ shows = "circles", title = "Circle Drawer",
            CircleTask [ width = 100%, height = 100% ]
            ],
        TaskPage [ shows = "cells", title = "Cells",
            CellsTask [ width = 100%, height = 100% ]
            ]
        ]
    ]
