/*
# Murmur

A place to read and take part in ongoing conversations, on a phone and on a
desk: the conversations, newest activity first; each one's whole history,
however long; text, photographs and voice; reactions.

How it is put together:

- **The records live in one place**, `app.convos`, an instance of the
  dataset class `Conversations`. It loads the whole history from the service
  once, and every change to it — a message arriving, one sent, a reaction, a
  conversation read — is one of its methods.
- **The live feed** is a `Socket` on the App. Each frame it hears becomes one
  call on `convos`, or a change to the few facts that are not history (who is
  composing, who has seen what). Nothing on screen is touched by it.
- **Where the person is** is the URL's fragment, `location`: the open
  conversation's id, or nothing. Back closes a conversation on a phone.
- **Each conversation is its own scrolling pane**, built once and kept, shown
  while it is the open one. Returning to a conversation is returning to that
  pane, so it is exactly where it was left; nothing saves or restores a
  scroll position. A pane is read from the bottom (`scrollAnchor = end`): at
  the latest message it follows new ones, scrolled back it holds still.
- **A message is a row of the class its kind names** (`TextMsg`, `PhotoMsg`,
  `VoiceMsg`), over one frame (`Msg`) that decides from its neighbours whether
  it starts a day or a run, and carries the name, face, reactions and time.
  Only the rows near the screen are built (`virtualize`), so a thirty-thousand
  message history costs what a screenful does.

The look (palette, avatars, glyphs, the scrubber) is in `murmur-parts.declare`.
*/

include [ "murmur-parts.declare" ]

script {
    type Who = Record<string, string[]>
    type Seen = Record<string, Record<string, string>>
    type Drafts = Record<string, string>
    type Aspects = Record<string, number>
    }


// ── The shape of the data ───────────────────────────────────────────────────

schema Person [ id: string, name: string, avatar?: string ]
schema Sendable [ src: string, alt: string ]
schema Reaction [ person: string, emoji: string ]

// One message of any kind. `serverId` and `pending` are this app's own: a
// message sent from here is shown at once under a local id, and learns the
// service's id when the service confirms it.

schema Message [ id: string, from: string, at: string, kind: "text" | "photo" | "voice",
    text?: string, src?: string, alt?: string, durationMs?: number, peaks[]?: number,
    reactions[]?: Reaction, serverId?: string, pending?: boolean ]

schema Thread [ id: string, title?: string, participants[]: string, lastSeen: string, messages[]: Message ]

// A conversation as the list shows it.

schema Summary [ id: string, title: string, preview: string, at: string, unread: number,
    typing: boolean, others[]: string ]
schema Inbox [ rows[]: Summary ]


// ── The records ─────────────────────────────────────────────────────────────

class Conversations extends DataSource [ autoFetch = true,
    schema = [ me: string, people[]: Person, sendable[]: Sendable, threads[]: Thread ],

    me() -> string { return this.value?.me ?? "" },
    people() -> Person[] { return this.value?.people ?? [] },
    threads() -> Thread[] { return this.value?.threads ?? [] },
    person(id: string) -> Person? { return this.people().find((p) => p.id == id) ?? null },
    firstName(id: string) -> string { return (this.person(id)?.name ?? "").split(" ")[0] },
    at(thread: string) -> number { return this.threads().findIndex((t) => t.id == thread) },
    thread(id: string) -> Thread? { return this.threads().find((t) => t.id == id) ?? null },
    others(t: Thread) -> string[] { return t.participants.filter((p) => p != this.me()) },

    // A message by either of its ids, searched from the newest end, where
    // anything the feed names almost always is.

    find(t: Thread, id: string) -> number {
        const ms = t.messages
        for (let j = ms.length - 1; j >= 0; j--) if (ms[j].id == id || ms[j].serverId == id) return j
        return -1
        },

    // ── what is true of a conversation, whoever is looking

    title(t: Thread) -> string {
        if (t.title != null && t.title != "") return t.title
        return this.others(t).map((p) => this.person(p)?.name ?? "").join(", ")
        },
    unread(t: Thread) -> number {
        const from = t.messages.findIndex((m) => m.id == t.lastSeen || m.serverId == t.lastSeen)
        let n = 0
        for (let j = from + 1; j < t.messages.length; j++) if (t.messages[j].from != this.me()) n = n + 1
        return n
        },
    preview(t: Thread) -> string {
        const m = t.messages[t.messages.length - 1]
        if (m == null) return ""
        const said = m.kind == "photo" ? "Photo" : m.kind == "voice" ? "Voice message · " + duration((m.durationMs ?? 0) / 1000) : m.text ?? ""
        if (m.from == this.me()) return "You: " + said
        return t.participants.length > 2 ? this.firstName(m.from) + ": " + said : said
        },
    summaries(typing: Who) -> Inbox {
        const rows = this.threads().map((t) => ({ id: t.id, title: this.title(t), preview: this.preview(t),
            at: t.messages[t.messages.length - 1]?.at ?? "", unread: this.unread(t),
            typing: (typing[t.id] ?? []).length > 0, others: this.others(t) }))
        rows.sort((a, b) => b.at.localeCompare(a.at))
        return ({ rows: rows })
        },

    // ── the writes

    append(thread: string, m: Message) {
        const i = this.at(thread)
        if (i >= 0) this.set(["threads", i, "messages", "-"], m)
        },

    // The service's answer to a send: the message keeps its local id (so
    // its row is not rebuilt) and learns the one the service gave it.

    confirm(ref: string, m: Message) {
        this.threads().forEach((t, i) => {
            const j = t.messages.findIndex((x) => x.id == ref)
            if (j < 0) return
            this.set(["threads", i, "messages", j, "serverId"], m.id)
            this.set(["threads", i, "messages", j, "at"], m.at)
            this.set(["threads", i, "messages", j, "pending"], false)
            })
        },

    // A reaction is attached once per person and mark; the echo of one this
    // app already showed changes nothing.

    react(thread: string, message: string, person: string, emoji: string) {
        const i = this.at(thread)
        if (i < 0) return
        const j = this.find(this.threads()[i], message)
        if (j < 0) return
        const had = this.threads()[i].messages[j].reactions ?? []
        if (had.some((r) => r.person == person && r.emoji == emoji)) return
        this.set(["threads", i, "messages", j, "reactions"], [...had, ({ person: person, emoji: emoji })])
        },

    markSeen(thread: string) {
        const i = this.at(thread)
        if (i < 0) return
        const t = this.threads()[i]
        const last = t.messages[t.messages.length - 1]
        if (last != null && t.lastSeen != last.id) this.set(["threads", i, "lastSeen"], last.id)
        }
    ]


// ── The conversation list ───────────────────────────────────────────────────
//
// The rows stack at one height, and glide to their new places when a
// conversation moves to the top. `TweenLayout` glides on its own whenever the
// rows reorder.

class Stack extends TweenLayout [ duration = 380,
    rowH: number = 76,
    place() {
        const w = this.contentExtent("width")
        return this.laid().map((c, i) => ({ x: 0, y: i * this.rowH, w: w, h: this.rowH }))
        }
    ]


class InboxRow [ padding = [0, 16, 0, 16],
    here: boolean = { app.openId == :id },
    unread: number = { :unread ?? 0 },
    link = { "#" + :id },
    accessibilityLabel = { :title + (classroot.unread > 0 ? ", " + classroot.unread + " unread" : "") },
    fill = { classroot.here ? provided("theme").selection : hovered ? provided("theme").hover : null },
    layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
    ThreadFace [ others = { :others ?? [] } ],
    words: View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 3 ],
        top: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 8, align = baseline ],
            Text [ flexes = true, maxLines = 1, fontSize = 16,
                fontWeight = { classroot.unread > 0 ? "bold" : "semibold" }, text = { :title ?? "" } ],
            Text [ fontSize = 12.5, wrap = false, numeralWidth = tabular,
                textColor = { classroot.unread > 0 ? provided("theme").unread : provided("theme").textFaint },
                text = { listStamp(:at ?? "", app.today) } ]
            ],
        bottom: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
            Text [ flexes = true, maxLines = 1, fontSize = 14, italic = { :typing ?? false },
                textColor = { (:typing ?? false) ? provided("theme").accent
                    : classroot.unread > 0 ? provided("theme").text : provided("theme").textMuted },
                text = { (:typing ?? false) ? "typing…" : :preview ?? "" } ],
            badge: View [ exists = { classroot.unread > 0 }, height = 20, cornerRadius = 10, padding = [0, 7, 0, 7],
                fill = { provided("theme").unread },
                TextLabel [ y = center, fontSize = 12, fontWeight = bold, textColor = white, numeralWidth = tabular,
                    text = { classroot.unread > 99 ? "99+" : "" + classroot.unread } ]
                ]
            ]
        ],
    rule: View [ ignoreLayout = true, x = 76, y = { parent.height - 1 }, width = { parent.width - 76 }, height = 1,
        visible = { !classroot.here }, fill = { provided("theme").line } ]
    ]


// ── A message ───────────────────────────────────────────────────────────────
//
// The frame every kind shares. It reads the message before and after it from
// the pane (`provided("rows")`) to decide whether it opens a day (a heading
// over it), opens a run (more room above, and the sender's name in a
// group), or closes one (the sender's face, and the time). A kind's own
// views go into `body`.

class Msg [ width = 100%, defaultPlacement = body,
    padding = { [classroot.runStart ? 12 : 2, app.gutter, 0, app.gutter] },

    all: Message[] = { provided("rows") },
    group: boolean = { provided("group") },
    threadId: string = { provided("threadId") },
    msgId: string = { :id ?? "" },
    from: string = { :from ?? "" },
    stampAt: string = { :at ?? "" },
    mine: boolean = { classroot.from == app.me },
    prev: Message? = { rowIndex > 0 ? classroot.all[rowIndex - 1] ?? null : null },
    next: Message? = { classroot.all[rowIndex + 1] ?? null },
    dayStart: boolean = { classroot.prev == null || dayKey(classroot.prev.at) != dayKey(classroot.stampAt) },

    // A run is one person's messages in a row, none more than eight
    // minutes after the one before it.

    joinsPrev: boolean = { classroot.prev != null && classroot.prev.from == classroot.from
        && minutesBetween(classroot.prev.at, classroot.stampAt) <= 8 },
    joinsNext: boolean = { classroot.next != null && classroot.next.from == classroot.from
        && minutesBetween(classroot.stampAt, classroot.next.at) <= 8 },
    nextDay: boolean = { classroot.next != null && dayKey(classroot.next.at) != dayKey(classroot.stampAt) },
    runStart: boolean = { classroot.dayStart || !classroot.joinsPrev },
    runEnd: boolean = { classroot.nextDay || !classroot.joinsNext },
    faced: boolean = { classroot.group && !classroot.mine },
    maxW: number = { Math.min(classroot.width * 0.74, 460) },

    // A bubble's corners: round, except where it meets the next of its run.

    corners: Radius = { classroot.mine
        ? [18, classroot.runStart ? 18 : 6, classroot.runEnd ? 18 : 6, 18]
        : [classroot.runStart ? 18 : 6, 18, 18, classroot.runEnd ? 18 : 6] },
    tone: Color = { classroot.mine ? provided("theme").mine : provided("theme").theirs },
    ink: Color = { classroot.mine ? provided("theme").mineText : provided("theme").text },

    tallies: Dataset [ schema = [ rows[]: Tally ], contents = { { rows: app.tally(:reactions ?? []) } } ],
    react() { app.openReactions(this.line.col.body, classroot.threadId, classroot.msgId) },

    layout: SimpleLayout [ axis = y ],
    day: DayHead [ exists = { classroot.dayStart }, label = { dayHead(classroot.stampAt, app.today) } ],
    name: Text [ exists = { classroot.faced && classroot.runStart }, padding = [0, 0, 3, 52],
        fontSize = 12.5, fontWeight = semibold, wrap = false, textColor = { app.inkOf(classroot.from) },
        text = { app.convos.person(classroot.from)?.name ?? "" } ],
    line: View [ width = 100%,
        face: Avatar [ exists = { classroot.faced && classroot.runEnd }, y = { parent.col.body.height - 30 },
            width = 30, person = { classroot.from } ],
        col: View [ x = { classroot.faced ? 40 : 0 },
            State [ applied = { classroot.mine }, x = end ],
            layout: SimpleLayout [ axis = y, spacing = 4, align = { classroot.mine ? "end" : "start" } ],
            body: View [
                onHold(e: PointerEvent) { classroot.react() },
                onContextMenu(e: PointerEvent) { classroot.react() }
                ],
            marks: View [ exists = { (classroot.tallies.value?.rows ?? []).length > 0 },
                datapath = { classroot.tallies.value },
                layout: SimpleLayout [ axis = x, spacing = 4 ],
                ReactionChip [ datapath = :rows[], emoji = :emoji, count = :count, mine = :mine, names = :names,
                    press() { app.react(classroot.threadId, classroot.msgId, :emoji) }
                    ]
                ],
            stamp: Text [ exists = { classroot.runEnd }, padding = [1, 4, 0, 4], fontSize = 11.5, wrap = false,
                numeralWidth = tabular, textColor = { provided("theme").textFaint },
                text = { (:pending ?? false) ? "Sending…" : clockOf(classroot.stampAt) } ]
            ],

        // On a desk, a reaction is also a button beside the bubble, shown
        // while the pointer is over the message.

        more: RoundButton [ visible = { app.wide && parent.hovered }, width = 30, shape = "react",
            tone = { provided("theme").textMuted }, accessibilityLabel = "React",
            x = { classroot.mine ? parent.col.x - 36 : parent.col.x + parent.col.body.width + 6 },
            y = { Math.max(0, parent.col.body.height / 2 - 15) },
            press() { classroot.react() }
            ]
        ]
    ]


class TextMsg extends Msg [
    bubble: View [ padding = [8, 13, 9, 13], cornerRadius = { classroot.corners }, fill = { classroot.tone },
        stroke = { classroot.mine ? null : Stroke(1, provided("theme").theirsLine) },
        Text [ width = { Math.min(this.contentWidth, classroot.maxW - 26) }, fontSize = 16, lineHeight = 1.32,
            textColor = { classroot.ink }, text = { :text ?? "" } ]
        ]
    ]


// A photograph is shown at its own shape. Its shape is not known until it
// loads, so until then it holds a 4:3 place in its tint, and the first
// picture of each source tells the App its shape for every row after.

class PhotoMsg extends Msg [
    src: string = { app.media(:src ?? "") },
    ar: number = { app.aspects[classroot.src] ?? 0 },
    known: boolean = { classroot.ar > 0 },
    shape: number = { classroot.known ? classroot.ar : 4 / 3 },
    w: number = { Math.min(classroot.maxW, app.wide ? 360 : 280, 320 * classroot.shape) },
    frame: Control [ width = { classroot.w }, height = { classroot.w / classroot.shape },
        cornerRadius = { classroot.corners }, clip = true, fill = { provided("theme").hover },
        accessibilityLabel = { "Photo: " + (:alt ?? "") },
        press() { app.viewPhoto(classroot.src, :alt ?? "", classroot.from, classroot.stampAt) },
        pic: Image [ width = 100%, height = 100%, fit = cover, source = { classroot.src },
            opacity = { classroot.known && this.loaded ? 1 : 0 },
            trackChanges = ["naturalWidth", "naturalHeight", "loaded", "source"],
            onChange() { if (this.loaded && this.naturalHeight > 0) app.noteAspect(this.source, this.naturalWidth / this.naturalHeight) }
            ],
        Glyph [ x = center, y = center, visible = { !classroot.frame.pic.loaded }, iconSize = 28, shape = "photo",
            ink = { provided("theme").textFaint } ]
        ]
    ]


// A voice message: play, the scrubber, and the time — its length before it
// plays, where it is while it plays.

class VoiceMsg extends Msg [
    secs: number = { (:durationMs ?? 0) / 1000 },
    active: boolean = { app.voiceId == classroot.msgId },
    running: boolean = { classroot.active && app.player.playing },
    progress: number = { classroot.active && classroot.secs > 0 ? Math.min(1, app.head / classroot.secs) : 0 },
    bubble: View [ padding = [8, 14, 8, 8], cornerRadius = { classroot.corners }, fill = { classroot.tone },
        stroke = { classroot.mine ? null : Stroke(1, provided("theme").theirsLine) },
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        RoundButton [ width = 40, solid = true, shape = { classroot.running ? "pause" : "play" },
            tone = { classroot.mine ? provided("theme").mineText : provided("theme").accent },
            glyphInk = { classroot.mine ? provided("theme").mine : 0xFFFFFF },
            accessibilityLabel = { classroot.running ? "Pause" : "Play voice message" },
            press() { app.toggleVoice(classroot.msgId, :src ?? "", classroot.secs) }
            ],
        Scrubber [ width = { Math.max(120, Math.min(200, classroot.maxW - 120)) },
            peaks = { :peaks ?? [] }, progress = { classroot.progress },
            played = { classroot.mine ? provided("theme").mineText : provided("theme").accent },
            rest = { classroot.mine ? provided("theme").waveMine : provided("theme").wave },
            seek(f: number) { app.seekVoice(classroot.msgId, :src ?? "", classroot.secs, f) }
            ],
        Text [ fontSize = 13, wrap = false, numeralWidth = tabular, textColor = { classroot.ink },
            text = { classroot.active ? duration(app.head) : duration(classroot.secs) } ]
        ]
    ]


// ── A conversation ──────────────────────────────────────────────────────────
//
// One pane per conversation, shown while it is the open one. It provides its
// messages (`rows`), whether it is a group, and its id to the rows inside.

class Pane [ scrolls = y, scrollAnchor = end,
    threadId: string = { :id ?? "" },
    rows: Message[] = { :messages ?? [] },
    group: boolean = { (:participants ?? []).length > 2 },
    open: boolean = { app.openId == classroot.threadId },

    // Away from the latest message: what arrives lands below, out of sight.

    away: boolean = { this.contentHeight - this.scrollY - this.height > 64 },
    unread: number = { app.convos.unread(:@) },

    // Reading at the latest message is reading it: the conversation's unread
    // mark moves up to it, for what is here and for what arrives.

    reading: boolean = { classroot.open && !classroot.away },
    newest: string = { classroot.rows[classroot.rows.length - 1]?.id ?? "" },
    sent: number = { app.sentCount },
    trackChanges = ["reading", "newest", "sent"],
    onChange(e: ChangeEvent) {
        if (e.changed.some((c) => c.name == "sent") && open) this.scrollTo(Infinity, ({ duration: 260 }))
        if (reading) app.convos.markSeen(threadId)
        },

    layout: SimpleLayout [ axis = y ],
    list: View [ width = 100%, padding = [6, 0, 4, 0],
        layout: SimpleLayout [ axis = y ],
        Msg [ datapath = :messages[], virtualize = true,
            classFor = { :kind == "photo" ? PhotoMsg : :kind == "voice" ? VoiceMsg : TextMsg } ]
        ],

    // Who is writing, as a bubble of its own where their message will land.

    composing: Murmuring [ exists = { app.typingIn(classroot.threadId).length > 0 },
        people = { app.typingIn(classroot.threadId) } ],

    footer: Text [ width = 100%, padding = { [2, app.gutter + 4, 16, app.gutter] }, textAlign = end,
        fontSize = 11.5, textColor = { provided("theme").textFaint },
        text = { app.seenLine(classroot.threadId) } ],

    // While scrolling back, the day being read, pinned at the top.

    dayChip: View [ ignoreScroll = true, ignoreLayout = true, x = center, y = 10, height = 28,
        padding = [0, 14, 0, 14], cornerRadius = 14, fill = { provided("theme").surface },
        shadow = { Shadow(0, 2, 8, 0x00000022) }, opacity = 0, pointerEvents = "none",
        Spring [ attribute = opacity, stiffness = 260, damping = 30,
            to = { classroot.userScrolling && classroot.scrollY > 80 ? 1 : 0 } ],
        TextLabel [ y = center, fontFamily = { app.serif }, fontSize = 14, italic = true,
            textColor = { provided("theme").textMuted },
            text = { dayHead(classroot.rows[classroot.list.firstVisibleRow]?.at ?? "", app.today) } ]
        ],

    // Away from the latest, a way back to it, saying how much is new there.

    dock: View [ ignoreScroll = true, ignoreLayout = true, width = 100%, height = 100%,
        padding = 16, pointerEvents = "none",
        jump: Control [ visible = { classroot.away }, x = end, y = end, height = 40, cornerRadius = 20,
            padding = { classroot.unread > 0 ? [0, 16, 0, 12] : [0, 12, 0, 12] },
            pointerEvents = "auto",
            fill = { classroot.unread > 0 ? provided("theme").accent : provided("theme").surface },
            stroke = { Stroke(1, provided("theme").line) },
            shadow = { Shadow(0, 3, 12, 0x0000002A) },
            accessibilityLabel = { classroot.unread > 0 ? classroot.unread + " new messages" : "Latest messages" },
            press() { classroot.scrollTo(Infinity, ({ duration: 320 })) },
            layout: SimpleLayout [ axis = x, spacing = 6, align = center ],
            Glyph [ iconSize = 16, shape = "down",
                ink = { classroot.unread > 0 ? 0xFFFFFF : provided("theme").textMuted } ],
            TextLabel [ exists = { classroot.unread > 0 }, fontSize = 14, fontWeight = semibold, textColor = white,
                text = { classroot.unread + " new" } ]
            ]
        ]
    ]


// Someone composing: three dots that rise and fall in turn, under their name.

class Murmuring [ width = 100%, padding = { [10, app.gutter, 0, app.gutter] },
    people: string[] = [],
    phase: number = 0,
    clock: Time [ tick = frame,
        onTick(dt: number) { classroot.phase = (classroot.phase + dt * 5.2) % (Math.PI * 2) }
        ],
    layout: SimpleLayout [ axis = y, spacing = 4 ],
    Text [ fontSize = 12.5, wrap = false, textColor = { provided("theme").textMuted }, italic = true,
        text = { classroot.people.map((p) => app.convos.firstName(p)).join(" and ") + (classroot.people.length > 1 ? " are" : " is") + " writing" } ],
    bubble: View [ height = 36, padding = [0, 14, 0, 14], cornerRadius = 18,
        fill = { provided("theme").theirs }, stroke = { Stroke(1, provided("theme").theirsLine) },
        layout: SimpleLayout [ axis = x, spacing = 5, align = center ],
        View [ width = 7, height = 7, cornerRadius = 4, fill = { provided("theme").textMuted },
            opacity = { 0.35 + 0.65 * Math.max(0, Math.sin(classroot.phase)) } ],
        View [ width = 7, height = 7, cornerRadius = 4, fill = { provided("theme").textMuted },
            opacity = { 0.35 + 0.65 * Math.max(0, Math.sin(classroot.phase - 0.9)) } ],
        View [ width = 7, height = 7, cornerRadius = 4, fill = { provided("theme").textMuted },
            opacity = { 0.35 + 0.65 * Math.max(0, Math.sin(classroot.phase - 1.8)) } ]
        ]
    ]


// The writing line at the foot of a conversation.

class Composer [ width = 100%,
    padding = { [8, 12, 8 + Math.max(app.safeBottom, app.keyboardHeight), 12] },
    fill = { provided("theme").surface }, stroke = { [Stroke(1, provided("theme").line), null, null, null] },
    blank: boolean = { app.draft.trim() == "" },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    photo: RoundButton [ width = 44, shape = "photo", accessibilityLabel = "Send a photo",
        press() { app.photoPicker.showFor(this) }
        ],
    field: TextInput [ flexes = true, height = 44, cornerRadius = 22, padding = [0, 16, 0, 16], fontSize = 16,
        placeholder = "Message", accessibilityLabel = "Message",
        fill = { provided("theme").background }, stroke = { Stroke(1, provided("theme").line) },
        value = { app.draft },
        commit(v: string) { app.setDraft(v) },
        onEnter() { app.sendText() }
        ],
    send: RoundButton [ width = 44, solid = true, shape = "send", accessibilityLabel = "Send",
        disabled = { classroot.blank },
        press() { app.sendText() }
        ]
    ]


// ── The app ─────────────────────────────────────────────────────────────────

App [ appName = "Murmur", minWidth = 320, scrolls = none,
    theme = { { ...SanFrancisco, ...Paper } },
    fill = { provided("theme").background },
    textColor = { provided("theme").text },
    uiFace: array = { ["-apple-system", "system-ui", "Segoe UI", "Helvetica Neue", "sans-serif"] },
    serif: array = { ["Iowan Old Style", "Charter", "Palatino", "Georgia", "serif"] },
    fontFamily = { app.uiFace },

    // ── the service. It serves the history, the media and the feed from one
    //    address; media paths in the history are relative to it.

    api: string = "http://localhost:8330/",
    media(path: string) -> string { return path == "" ? "" : app.api + path },

    convos: Conversations [ url = { app.api + "threads.json" } ],
    me: string = { app.convos.me() },

    live: Socket [ url = { app.api.replace("http", "ws") + "live" }, active = { app.convos.loaded }, retry = 2,
        onMessage(e: StreamMessage) { app.hear(JSON.parse(e.data)) }
        ],

    // ── sizes

    wide: boolean = { app.width >= 760 },
    gutter: number = { app.wide ? 28 : 12 },
    clock: Time [ tick = minute ],
    today: string = { new Date(app.clock.now).toISOString() },

    // ── where the person is: the open conversation, in the URL

    location = "",
    openId: string = { app.convos.thread(app.location) != null ? app.location : "" },
    openThread: Thread? = { app.convos.thread(app.openId) },

    // ── what the feed says that is not history

    typing: Who = { {} },
    seenBy: Seen = { {} },
    typingIn(thread: string) -> string[] { return app.typing[thread] ?? [] },
    setTyping(thread: string, person: string, on: boolean) {
        const now = (typing[thread] ?? []).filter((p) => p != person)
        typing = ({ ...typing, [thread]: on ? [...now, person] : now })
        },

    hear(f: any) {
        if (f.t == "message") {
            convos.append(f.thread, f.message)
            setTyping(f.thread, f.message.from, false)
        } else if (f.t == "sent") {
            convos.confirm(f.ref, f.message)
        } else if (f.t == "reaction") {
            convos.react(f.thread, f.message, f.person, f.emoji)
        } else if (f.t == "composing") {
            setTyping(f.thread, f.person, f.state == "start")
        } else if (f.t == "seen") {
            seenBy = ({ ...seenBy, [f.thread]: ({ ...(seenBy[f.thread] ?? {}), [f.person]: f.through }) })
        }
        },

    // Under the conversation: whether what was last sent from here is still
    // on its way, or who has read it.

    seenLine(thread: string) -> string {
        const t = app.convos.thread(thread)
        if (t == null) return ""
        let mine = -1
        for (let j = t.messages.length - 1; j >= 0; j--) if (t.messages[j].from == app.me) { mine = j; break }
        if (mine < 0) return ""
        const m = t.messages[mine]
        if (m.pending ?? false) return ""
        const seen = app.seenBy[thread] ?? {}
        const who = Object.keys(seen).filter((p) => app.convos.find(t, seen[p]) >= mine)
        if (who.length == 0) return ""
        return t.participants.length > 2 ? "Seen by " + who.map((p) => app.convos.firstName(p)).join(", ") : "Seen"
        },

    // ── the list on screen

    inbox: Dataset [ schema = Inbox, contents = { app.convos.summaries(app.typing) } ],
    unreadTotal: number = { (app.inbox.value?.rows ?? []).reduce((n, r) => n + (r.unread > 0 ? 1 : 0), 0) },

    // Each person's ink, by their place among the people.

    inkOf(person: string) -> Color {
        const inks = provided("theme").inks
        const i = Math.max(0, app.convos.people().findIndex((p) => p.id == person))
        return inks[i % inks.length]
        },

    // A message's reactions, gathered by mark.

    tally(rs: Reaction[]) -> Tally[] {
        const out: Tally[] = []
        rs.forEach((r) => {
            const name = r.person == app.me ? "You" : app.convos.firstName(r.person)
            const t = out.find((x) => x.emoji == r.emoji)
            if (t == null) out.push(({ id: r.emoji, emoji: r.emoji, count: 1, mine: r.person == app.me, names: name }))
            else { t.count = t.count + 1; t.mine = t.mine || r.person == app.me; t.names = t.names + ", " + name }
            })
        return out
        },

    // ── sending. What is sent appears at once, under a local id; the service
    //    answers `sent` with its own, and `confirm` records it.

    drafts: Drafts = { {} },
    draft: string = { app.drafts[app.openId] ?? "" },
    setDraft(v: string) { drafts = ({ ...drafts, [openId]: v }) },
    refs: number = 0,
    sentCount: number = 0,

    post(kind: "text" | "photo", text: string, src: string, alt: string) {
        if (openId == "" || !live.open) return
        refs = refs + 1
        const ref = "local-" + refs
        const m: Message = kind == "text"
            ? ({ id: ref, from: me, at: new Date().toISOString(), kind: "text", text: text, pending: true })
            : ({ id: ref, from: me, at: new Date().toISOString(), kind: "photo", src: src, alt: alt, pending: true })
        convos.append(openId, m)
        live.send(JSON.stringify(kind == "text"
            ? ({ t: "send", ref: ref, thread: openId, kind: "text", text: text })
            : ({ t: "send", ref: ref, thread: openId, kind: "photo", src: src })))
        sentCount = sentCount + 1
        },
    sendText() {
        const text = draft.trim()
        if (text == "") return
        post("text", text, "", "")
        setDraft("")
        },
    sendPhoto(src: string, alt: string) {
        post("photo", "", src, alt)
        photoPicker.close()
        },

    // ── reacting

    reactThread: string = "",
    reactMsg: string = "",
    openReactions(at: View, thread: string, message: string) {
        reactThread = thread
        reactMsg = message
        reactions.showFor(at)
        },
    react(thread: string, message: string, emoji: string) {
        convos.react(thread, message, me, emoji)
        const t = convos.thread(thread)
        const j = t == null ? -1 : convos.find(t, message)
        const id = j < 0 || t == null ? message : t.messages[j].serverId ?? t.messages[j].id
        if (live.open) live.send(JSON.stringify(({ t: "react", thread: thread, message: id, emoji: emoji })))
        },
    marks: Dataset { { "rows": [ { "id": "love", "emoji": "❤️" }, { "id": "laugh", "emoji": "😂" },
        { "id": "wow", "emoji": "😮" }, { "id": "yikes", "emoji": "😱" }, { "id": "yes", "emoji": "👍" },
        { "id": "fire", "emoji": "🔥" } ] } },

    // ── photographs: their shapes, learned as each loads, and the viewer

    aspects: Aspects = { {} },
    noteAspect(src: string, ar: number) {
        if (src != "" && Math.abs((aspects[src] ?? 0) - ar) > 0.001) aspects = ({ ...aspects, [src]: ar })
        },
    viewSrc: string = "",
    viewAlt: string = "",
    viewFrom: string = "",
    viewWhen: string = "",
    viewPhoto(src: string, alt: string, from: string, at: string) {
        viewSrc = src
        viewAlt = alt
        viewFrom = from
        viewWhen = at
        viewer.show()
        },

    // ── voice. One clip plays at a time: the App holds it. The playhead the
    //    scrubbers draw is the App's own number (`head`), advanced each frame
    //    while playing and corrected by the clip's own word.

    voiceId: string = "",
    voiceSrc: string = "",
    voiceSecs: number = 0,
    head: number = 0,
    pendingSeek: number = -1,
    player: Audio [ source = { app.media(app.voiceSrc) },
        trackChanges = ["duration", "ended"],
        onChange() {
            if (app.pendingSeek >= 0 && this.duration > 0) { this.position = app.pendingSeek; app.pendingSeek = -1 }
            if (this.ended) { app.head = 0; app.voiceId = "" }
            }
        ],
    playhead: Time [ tick = frame, running = { app.player.playing },
        onTick(dt: number) {
            const next = app.head + dt
            app.head = Math.abs(next - app.player.position) > 0.35 ? app.player.position : Math.min(next, app.voiceSecs)
            }
        ],
    load(id: string, src: string, secs: number, at: number) {
        const same = voiceSrc == src
        voiceId = id
        voiceSrc = src
        voiceSecs = secs
        head = at
        if (same && player.duration > 0) player.position = at
        else pendingSeek = at
        },
    toggleVoice(id: string, src: string, secs: number) {
        if (voiceId == id) { player.playing = !player.playing; return }
        load(id, src, secs, 0)
        player.playing = true
        },
    seekVoice(id: string, src: string, secs: number, f: number) {
        if (voiceId != id) { load(id, src, secs, f * secs); player.playing = true; return }
        head = f * secs
        player.position = head
        },

    // ── the screen: the list beside the conversation on a desk; on a phone,
    //    one or the other.

    body: View [ width = 100%, height = 100%,
        layout: ResponsiveLayout [ align = stretch, plan = { [
            ({ from: 1100, flow: "row", share: ({ inbox: 27, convo: 73 }) }),
            ({ from: 760, flow: "row", share: ({ inbox: 38, convo: 62 }) }),
            ({ from: 0, flow: "row",
               share: app.openId == "" ? ({ inbox: 100, convo: 0 }) : ({ inbox: 0, convo: 100 }) })
            ] } ],

        inbox: View [ accessibilityRole = navigation, accessibilityLabel = "Conversations",
            fill = { provided("theme").sidebar },
            stroke = { app.wide ? [null, Stroke(1, provided("theme").line), null, null] : null },
            layout: SimpleLayout [ axis = y ],
            head: View [ width = 100%, padding = { [18 + app.safeTop, 20, 12, 20] },
                layout: SimpleLayout [ axis = x, align = baseline, spacing = 10 ],
                Text [ flexes = true, fontFamily = { app.serif }, fontSize = 30, fontWeight = semibold,
                    letterSpacing = -0.4, accessibilityRole = heading, text = "Murmur" ],
                Text [ fontSize = 13, wrap = false, textColor = { provided("theme").textMuted },
                    text = { app.unreadTotal == 0 ? "All read" : app.unreadTotal + " with new" } ]
                ],
            scroller: View [ width = 100%, flexes = true, scrolls = y,
                rows: View [ width = 100%, datapath = { app.inbox.value },
                    layout: Stack [ rowH = { app.wide ? 74 : 78 } ],
                    InboxRow [ datapath = :rows[] ]
                    ]
                ]
            ],

        convo: View [ accessibilityRole = main,
            layout: SimpleLayout [ axis = y ],
            bar: View [ width = 100%, visible = { app.openId != "" },
                padding = { [10 + app.safeTop, 16, 10, app.wide ? 24 : 6] },
                fill = { provided("theme").surface }, stroke = { [null, null, Stroke(1, provided("theme").line), null] },
                layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
                RoundButton [ visible = { !app.wide }, width = 44, shape = "back", accessibilityLabel = "Conversations",
                    press() { app.location = "" }
                    ],
                ThreadFace [ scale = 0.84, pivotX = 0, pivotY = 0,
                    others = { app.openThread == null ? [] : app.convos.others(app.openThread) } ],
                View [ flexes = true,
                    layout: SimpleLayout [ axis = y, spacing = 1 ],
                    Text [ width = 100%, maxLines = 1, fontFamily = { app.serif }, fontSize = 20, fontWeight = semibold,
                        accessibilityRole = heading,
                        text = { app.openThread == null ? "" : app.convos.title(app.openThread) } ],
                    Text [ width = 100%, maxLines = 1, fontSize = 12.5,
                        italic = { app.typingIn(app.openId).length > 0 },
                        textColor = { app.typingIn(app.openId).length > 0 ? provided("theme").accent : provided("theme").textMuted },
                        text = { app.subtitle() } ]
                    ]
                ],
            stage: View [ width = 100%, flexes = true, datapath = { app.convos.value },
                Pane [ datapath = :threads[], width = 100%, height = 100%, visible = { app.openId == :id } ],

                // Nothing open, on a desk.

                none: View [ visible = { app.openId == "" }, x = center, y = center,
                    layout: SimpleLayout [ axis = y, spacing = 8, align = center ],
                    Text [ fontFamily = { app.serif }, fontSize = 26, italic = true,
                        textColor = { provided("theme").textMuted }, text = "Nothing open" ],
                    Text [ fontSize = 14, textColor = { provided("theme").textFaint },
                        text = "Choose a conversation to read it." ]
                    ]
                ],
            composer: Composer [ visible = { app.openId != "" } ]
            ]
        ],

    subtitle() -> string {
        const t = app.openThread
        if (t == null) return ""
        const writing = app.typingIn(t.id)
        if (writing.length > 0) return writing.map((p) => app.convos.firstName(p)).join(" and ") + (writing.length > 1 ? " are" : " is") + " writing…"
        if (t.participants.length <= 2) return ""
        return "You, " + app.convos.others(t).map((p) => app.convos.firstName(p)).join(", ")
        },

    // ── before anything has arrived

    splash: View [ exists = { !app.convos.loaded }, width = 100%, height = 100%,
        fill = { provided("theme").background },
        View [ x = center, y = center,
            layout: SimpleLayout [ axis = y, spacing = 10, align = center ],
            Text [ fontFamily = { app.serif }, fontSize = 40, fontWeight = semibold, letterSpacing = -0.6, text = "Murmur" ],
            Text [ fontSize = 14, textColor = { provided("theme").textMuted },
                text = { app.convos.failed ? "The conversations could not be reached." : "Gathering your conversations…" } ]
            ]
        ],

    // ── layers

    photoPicker: Popover [ accessibilityLabel = "Send a photo",
        Text [ fontSize = 13, fontWeight = semibold, textColor = { provided("theme").textMuted }, text = "Send a photo" ],
        grid: View [ width = { app.wide ? 360 : app.width - 48 }, datapath = { app.convos.value },
            layout: WrappingLayout [ columns = 4, spacing = 6, rowSpacing = 6 ],
            Control [ datapath = :sendable[], flexes = true, height = { app.wide ? 84 : 76 }, cornerRadius = 10, clip = true,
                fill = { provided("theme").hover }, accessibilityLabel = { "Send " + (:alt ?? "") },
                press() { app.sendPhoto(:src ?? "", :alt ?? "") },
                Image [ width = 100%, height = 100%, fit = cover, source = { app.media(:src ?? "") } ]
                ]
            ]
        ],

    reactions: Popover [ accessibilityLabel = "React",
        View [ datapath = { app.marks.value },
            layout: SimpleLayout [ axis = x, spacing = 2 ],
            ReactionPick [ datapath = :rows[], emoji = :emoji,
                press() { app.react(app.reactThread, app.reactMsg, :emoji ?? ""); app.reactions.close() }
                ]
            ]
        ],

    viewer: Dialog [ presentation = "full", fill = black, accessibilityLabel = "Photo",
        photo: Control [ width = 100%, height = 100%, accessibilityLabel = { app.viewAlt },
            press() { app.viewer.close() },
            Image [ width = 100%, height = 100%, fit = contain, source = { app.viewSrc } ]
            ],
        caption: View [ ignoreLayout = true, y = end, width = 100%,
            padding = { [40, 24, 20 + app.safeBottom, 24] },
            fill = { Gradient.linear(0x00000000, 0x000000AA) }, pointerEvents = "none",
            layout: SimpleLayout [ axis = y, spacing = 3 ],
            Text [ width = 100%, fontSize = 15, fontWeight = semibold, textColor = white, text = { app.viewAlt } ],
            Text [ width = 100%, fontSize = 13, textColor = 0xFFFFFFB0,
                text = { (app.convos.person(app.viewFrom)?.name ?? "") + " · " + dayHead(app.viewWhen, app.today) + ", " + clockOf(app.viewWhen) } ]
            ],
        shut: RoundButton [ ignoreLayout = true, x = { parent.width - 60 }, y = { 16 + app.safeTop }, width = 44,
            shape = "close", tone = white, solid = true, accessibilityLabel = "Close",
            fill = { 0x00000066 },
            press() { app.viewer.close() }
            ]
        ]
    ]
