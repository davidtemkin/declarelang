/*
# Pagemap: the dialogs

Every dialog is a step (`app.waypoint`), so Back closes it and Forward opens it
again (F-APP-02). `StepDialog` is that once: it is shown while its step is the
current one, and closing it any way goes Back. Content that would be taller
than the window scrolls inside it.

Each opening starts fresh: a dialog's working values are built while it is
open (`exists = { … present }`), so they start from their defaults each time.
*/

class StepDialog extends Dialog [ defaultPlacement = body,
    step: string = "",
    wide: number = 480,
    shown = { app.stepIs(classroot.step) },
    commit(open: boolean) { if (!open) app.closeStep() },
    width = { Math.min(app.width - 24, classroot.wide) },

    // A button does its work in act(); true goes Back (closing the step),
    // false leaves it open, or to a handler that has gone somewhere itself.

    pick(id: string) { if (this.shown && this.act(id)) app.closeStep() },
    act(id: string) -> boolean { return true },
    body: View [ width = 100%, height = { Math.min(this.contentHeight, app.height - 220) }, scrolls = y,
        layout: SimpleLayout [ axis = y, spacing = 10 ]
        ]
    ]


class Field2 [ width = 100%,
    label: string = "",
    layout: SimpleLayout [ axis = y, spacing = 4 ],
    Caption [ text = { classroot.label } ]
    ]


// ── All flatplans (F-WS-04, -05, -07) ───────────────────────────────────────

class PlanRow extends Control [ width = 100%, height = 46, cornerRadius = 6, padding = [0, 10, 0, 10],
    current: boolean = { (:id ?? "") == app.fp?.id },
    accessibilityPressed = { classroot.current },
    accessibilityLabel = { (:name ?? "") + ", " + (:edition ?? "") },
    fill = { classroot.current ? provided("theme").controlSelected : hovered ? provided("theme").controlHovered : null },
    press() { app.leaveStep(); app.location = :id ?? "" },
    layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 1 ],
        Text [ fontSize = 14, fontWeight = semibold, wrap = false, text = { :name ?? "" } ],
        Muted [ wrap = false, text = { (:edition ?? "") + " · " + (:pages ?? 0) + " pages" } ]
        ],
    Caption [ visible = { classroot.current }, textColor = { provided("theme").accent }, text = "OPEN" ]
    ]


class FlatplansDialog extends StepDialog [ step = "flatplans", title = "All flatplans",
    buttons = { [ ({ id: "new", label: "New flatplan…" }), ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    act(id: string) -> boolean { if (id == "new") { app.waypoint = "newplan"; return false } return true },
    View [ width = 100%,
        src: Dataset [ contents = { ({ rows: (app.flatplans.value?.rows ?? []).filter((r) => !(r.archived ?? false)) }) } ],
        datapath = { this.src.value },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        PlanRow [ datapath = :rows[] ]
        ],
    Caption [ visible = { (app.flatplans.value?.rows ?? []).some((r) => r.archived ?? false) }, text = "ARCHIVED" ],
    View [ width = 100%,
        src: Dataset [ contents = { ({ rows: (app.flatplans.value?.rows ?? []).filter((r) => r.archived ?? false) }) } ],
        datapath = { this.src.value },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        PlanRow [ datapath = :rows[], opacity = 0.75 ]
        ]
    ]


class NewFlatplanForm [ width = 100%,
    name: string = "",
    edition: string = "",
    start: string = "same",
    count: number = 96,
    layout: SimpleLayout [ axis = y, spacing = 10 ],
    Field2 [ label = "ISSUE NAME",
        TextInput [ width = 100%, height = 32, placeholder = "Issue 05", accessibilityLabel = "Issue name",
            value <-> classroot.name ]
        ],
    Field2 [ label = "EDITION",
        TextInput [ width = 100%, height = 32, placeholder = "Winter 2025", accessibilityLabel = "Edition",
            value <-> classroot.edition ]
        ],
    Field2 [ label = "START FROM",
        Segmented [ value = { classroot.start }, accessibilityLabel = "Start from",
            items = { [ ({ id: "same", label: "Same layout" }), ({ id: "copy", label: "A copy" }), ({ id: "empty", label: "Empty" }) ] },
            commit(v: string) { classroot.start = v }
            ]
        ],
    Muted [ width = 100%, text = { classroot.start == "same" ? "This flatplan's pages, sections, templates and region kinds, with every story, ad, artwork, tag, note and lock taken off."
        : classroot.start == "copy" ? "Everything in this flatplan, duplicated." : "Blank pages in this flatplan's first section, with its sections, statuses and tags." } ],
    Field2 [ visible = { classroot.start == "empty" }, label = "PAGES",
        Stepper [ min = 4, max = 600, step = 2, value = { classroot.count }, accessibilityLabel = "Pages",
            commit(v: number) { classroot.count = v }
            ]
        ]
    ]


class NewFlatplanDialog extends StepDialog [ step = "newplan", title = "New flatplan",
    buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "make", label: "Create", default: true }) ] },
    f: NewFlatplanForm [ exists = { classroot.present } ],
    act(id: string) -> boolean {
        if (id != "make") return true
        const f = this.f as NewFlatplanForm
        if (f == null) return false
        if (f.name.trim() == "") { app.say("Give the issue a name."); return false }
        app.makeFlatplan(f.name.trim(), f.edition.trim(), f.start, f.count)
        app.leaveStep()
        return false
        }
    ]


// ── Flatplan settings (F-PRINT-01 to -05, F-WS-06, -07) ─────────────────────

class SettingsDialog extends StepDialog [ step = "settings", title = "Flatplan settings", wide = 520,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    fp: Flatplan? = { app.fp },
    ro: boolean = { app.readOnly },
    set(label: string, field: string, v: any) {
        const id = app.fp?.id ?? ""
        if (app.plan.apply(label, (fp: Flatplan) => { (fp as any)[field] = v; return "" }, true)) {
            if (field == "name" || field == "edition" || field == "archived") updateIndex(app.fpWs, id, ({ [field]: v })).catch(() => { })
            }
        },
    Field2 [ label = "PUBLICATION",
        TextInput [ width = 100%, height = 32, disabled = { classroot.ro }, commitOn = "end", accessibilityLabel = "Publication",
            value = { classroot.fp?.publication ?? "" },
            commit(v: string) { if (v != classroot.fp?.publication) classroot.set("Rename publication", "publication", v.trim()) }
            ]
        ],
    Row [ Field2 [ flexes = true, label = "ISSUE",
            TextInput [ width = 100%, height = 32, disabled = { classroot.ro }, commitOn = "end", accessibilityLabel = "Issue",
                value = { classroot.fp?.name ?? "" },
                commit(v: string) { if (v.trim() == "") { app.say("The issue needs a name."); return } if (v.trim() != classroot.fp?.name) classroot.set("Rename issue", "name", v.trim()) }
                ]
            ],
        Field2 [ flexes = true, label = "EDITION",
            TextInput [ width = 100%, height = 32, disabled = { classroot.ro }, commitOn = "end", accessibilityLabel = "Edition",
                value = { classroot.fp?.edition ?? "" },
                commit(v: string) { if (v != classroot.fp?.edition) classroot.set("Rename edition", "edition", v.trim()) }
                ]
            ]
        ],
    Field2 [ label = "TRIM (INCHES)",
        Row [ TextInput [ width = 70, height = 32, disabled = { classroot.ro }, commitOn = "end", accessibilityLabel = "Trim width", purpose = decimal,
                value = { String(classroot.fp?.trimW ?? 9) },
                commit(v: string) { const n = Number(v); if (!(n > 0)) { app.say("Trim width must be more than zero."); return } if (n != classroot.fp?.trimW) classroot.set("Trim width " + n, "trimW", n) }
                ],
            Muted [ text = "×" ],
            TextInput [ width = 70, height = 32, disabled = { classroot.ro }, commitOn = "end", accessibilityLabel = "Trim height", purpose = decimal,
                value = { String(classroot.fp?.trimH ?? 12) },
                commit(v: string) { const n = Number(v); if (!(n > 0)) { app.say("Trim height must be more than zero."); return } if (n != classroot.fp?.trimH) classroot.set("Trim height " + n, "trimH", n) }
                ]
            ],
        Segmented [ disabled = { classroot.ro }, accessibilityLabel = "Page shape",
            value = { (classroot.fp?.trimW ?? 9) < (classroot.fp?.trimH ?? 12) ? "portrait" : (classroot.fp?.trimW ?? 9) == (classroot.fp?.trimH ?? 12) ? "square" : "landscape" },
            items = { [ ({ id: "portrait", label: "Portrait 9 × 12" }), ({ id: "square", label: "Square 10 × 10" }), ({ id: "landscape", label: "Landscape 12 × 9" }) ] },
            commit(v: string) {
                const w = v == "portrait" ? 9 : v == "square" ? 10 : 12, h = v == "portrait" ? 12 : v == "square" ? 10 : 9
                app.plan.apply(v == "portrait" ? "Make pages portrait" : v == "square" ? "Make pages square" : "Make pages landscape",
                    (fp: Flatplan) => { fp.trimW = w; fp.trimH = h; return "" }, true)
                }
            ]
        ],
    Checkbox [ label = "Facing pages (spreads)", disabled = { classroot.ro }, checked = { classroot.fp?.facing ?? true },
        commit(v: boolean) { classroot.set(v ? "Show spreads" : "Show single pages", "facing", v) }
        ],
    Checkbox [ label = "Separate covers (FC, IFC, IBC, BC)", disabled = { classroot.ro }, checked = { classroot.fp?.numbering == "covers" },
        commit(v: boolean) { app.plan.apply(v ? "Separate the covers" : "Number the covers", (fp: Flatplan) => app.plan.opCovers(fp, v), true) }
        ],
    Row [ Caption [ text = "NUMBERING STARTS AT" ],
        Stepper [ min = -999, max = 9999, disabled = { classroot.ro }, value = { classroot.fp?.firstFolio ?? 1 }, accessibilityLabel = "Numbering starts at",
            commit(v: number) { const n = Math.round(v); classroot.set("Number from " + n, "firstFolio", n) }
            ]
        ],
    Row [ Caption [ text = { "PHYSICAL PAGES · " + app.plan.pages.length } ],
        Act [ visible = { !classroot.ro }, label = "Add 2",
            press() { app.plan.apply("Add 2 pages", (fp: Flatplan) => app.plan.opAddPages(fp, 2)) }
            ],
        Act [ visible = { !classroot.ro }, label = "Add 4",
            press() { app.plan.apply("Add 4 pages", (fp: Flatplan) => app.plan.opAddPages(fp, 4)) }
            ],
        Act [ visible = { !classroot.ro }, label = "Remove 2",
            press() { app.plan.apply("Remove 2 pages", (fp: Flatplan) => app.plan.opRemoveLast(fp, 2)) }
            ]
        ],
    Act [ visible = { !classroot.ro }, label = { (classroot.fp?.archived ?? false) ? "Bring back from the archive" : "Archive this flatplan" },
        press() {
            const on = !(classroot.fp?.archived ?? false)
            classroot.set(on ? "Archive this flatplan" : "Bring back from the archive", "archived", on)
            if (on) app.say("Archived. It stays in the list of flatplans.")
            }
        ]
    ]


// ── Sections, statuses and tags (F-SEC-02) ──────────────────────────────────

class NamedRow [ width = 100%, height = 34,
    list: string = "sections",
    nid: string = { :id ?? "" },
    count: string = "",
    ro: boolean = { app.readOnly },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    rename(v: string) {
        const id = this.nid, list = this.list
        app.plan.apply(list == "sections" ? "Rename section" : list == "statuses" ? "Rename status" : "Rename tag",
            (fp: Flatplan) => { const it = ((fp as any)[list] as Named[]).find((x) => x.id == id); if (it != null) it.name = v; return "" }, true)
        },
    recolor() {
        const id = this.nid, list = this.list
        app.plan.apply("Recolor", (fp: Flatplan) => { const it = ((fp as any)[list] as Named[]).find((x) => x.id == id); if (it != null) it.color = nextColor(it.color); return "" }, true)
        },
    remove() {
        const id = this.nid, list = this.list, plan = app.plan
        if (list == "sections") plan.apply("Remove a section", (fp: Flatplan) => plan.opRemoveSection(fp, id), true)
        else if (list == "statuses") plan.apply("Remove a status", (fp: Flatplan) => plan.opRemoveStatus(fp, id), true)
        else plan.apply("Remove a tag", (fp: Flatplan) => plan.opRemoveTag(fp, id), true)
        },
    Swatch [ color = { :color ?? "#888888" }, disabled = { classroot.ro }, accessibilityLabel = "Recolor",
        press() { classroot.recolor() }
        ],
    TextInput [ flexes = true, height = 30, disabled = { classroot.ro }, commitOn = "end", accessibilityLabel = "Name", value = { :name ?? "" },
        commit(v: string) { if (v.trim() != "" && v.trim() != (:name ?? "")) classroot.rename(v.trim()) }
        ],
    Muted [ width = 90, textAlign = end, wrap = false, text = { classroot.count } ],
    IconAct [ visible = { !classroot.ro }, shape = "close", accessibilityLabel = "Remove",
        press() { classroot.remove() }
        ]
    ]


class VocabularyDialog extends StepDialog [ step = "vocab", title = "Sections, statuses and tags", wide = 560,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    add(list: string, name: string) {
        const after = list == "sections" ? (app.page?.sectionId ?? "") : ""
        app.plan.apply(list == "sections" ? "Add a section" : list == "statuses" ? "Add a status" : "Add a tag",
            (fp: Flatplan) => app.plan.opAddNamed(fp, list, name, after), true)
        },
    Caption [ text = "SECTIONS" ],
    View [ width = 100%, datapath = { app.plan.value?.open },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        NamedRow [ datapath = :sections[], list = "sections",
            count = { app.plan.sectionCount(:id ?? "") + " pages" } ]
        ],
    Act [ visible = { !app.readOnly }, label = "Add a section",
        press() { classroot.add("sections", "New section") }
        ],
    Caption [ text = "STATUSES" ],
    View [ width = 100%, datapath = { app.plan.value?.open },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        NamedRow [ datapath = :statuses[], list = "statuses",
            count = { pagesNum(app.plan.statusShare(:id ?? "")) + " pp · " + pct(app.plan.statusShare(:id ?? ""), app.plan.pages.length) } ]
        ],
    Act [ visible = { !app.readOnly }, label = "Add a status",
        press() { classroot.add("statuses", "New status") }
        ],
    Caption [ text = "TAGS" ],
    View [ width = 100%, datapath = { app.plan.value?.open },
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        NamedRow [ datapath = :tags[], list = "tags",
            count = { app.plan.pages.filter((p) => p.tags.includes(:id ?? "")).length + " pp" } ]
        ],
    Act [ visible = { !app.readOnly }, label = "Add a tag",
        press() { classroot.add("tags", "New tag") }
        ]
    ]


// ── Ads and content to place (F-ADS-01 to -05) ──────────────────────────────

class BookingRow [ width = 100%, padding = [6, 0, 6, 0],
    bid: string = { :id ?? "" },
    on: string[] = { app.plan.bookingPages(classroot.bid) },
    stroke = { [null, null, Stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        Text [ width = 100%, fontSize = 13, fontWeight = semibold, text = { :text ?? "" } ],
        Muted [ width = 100%, text = { [(:ref ?? "") == "" ? "" : :ref ?? "", (:size ?? "") == "" ? "any size" : :size ?? "", (:shape ?? "") == "" ? "" : :shape ?? "",
            ((:want ?? []).length == 0 ? "" : "wants " + (:want ?? []).join(", "))].filter((x) => x != "").join(" · ") } ]
        ],
    Control [ visible = { classroot.on.length > 0 }, height = 28, padding = [0, 6, 0, 6],
        press() { const first = classroot.on[0]; app.leaveStep(); app.goPage(first) },
        TextLabel [ y = center, fontSize = 12, textColor = { provided("theme").linkColor }, text = { "on " + app.plan.rangeOf(classroot.on) } ]
        ],
    Muted [ visible = { classroot.on.length == 0 }, text = "Not placed" ],
    IconAct [ visible = { !app.readOnly }, shape = "close", accessibilityLabel = "Remove a booking",
        press() { const id = classroot.bid; app.plan.apply("Remove a booking", (fp: Flatplan) => app.plan.opRemoveBooking(fp, id), true) }
        ]
    ]


class BookingForm [ width = 100%,
    text: string = "",
    size: string = "",
    shape: string = "",
    want: string = "",
    add() {
        if (text.trim() == "") { app.say("Give the booking its text."); return }
        const b: Booking = ({ id: makeId("b-"), ref: "", text: text.trim(), size: size.trim(), shape: shape.trim().toLowerCase(),
            want: want.split(/[;,]/).map((w) => w.trim()).filter((w) => w != "") })
        if (app.plan.apply("Add " + b.text, (fp: Flatplan) => { fp.bookings.push(b); return "" }, true)) { text = ""; size = ""; shape = ""; want = "" }
        },
    layout: SimpleLayout [ axis = y, spacing = 6 ],
    TextInput [ width = 100%, height = 32, placeholder = "What's booked (an ad, a promo)", accessibilityLabel = "Booking text",
        value <-> classroot.text,
        onEnter() { classroot.add() }
        ],
    Row [ TextInput [ width = 80, height = 32, placeholder = "Size 1/2", accessibilityLabel = "Size", value <-> classroot.size,
            onEnter() { classroot.add() }
            ],
        TextInput [ width = 110, height = 32, placeholder = "Shape", accessibilityLabel = "Shape", value <-> classroot.shape,
            onEnter() { classroot.add() }
            ],
        TextInput [ flexes = true, height = 32, placeholder = "Pages it wants: 3; IBC", accessibilityLabel = "Wanted pages", value <-> classroot.want,
            onEnter() { classroot.add() }
            ],
        Button [ label = "Add",
            onClick() { classroot.add() }
            ]
        ]
    ]


class BookingsDialog extends StepDialog [ step = "bookings", title = "Ads and content to place", wide = 600,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    Muted [ visible = { (app.fp?.bookings.length ?? 0) == 0 }, text = "Nothing booked yet." ],
    View [ width = 100%, datapath = { app.plan.value?.open },
        layout: SimpleLayout [ axis = y ],
        BookingRow [ datapath = :bookings[] ]
        ],
    BookingForm [ visible = { !app.readOnly }, exists = { classroot.present } ],
    Row [ visible = { !app.readOnly },
        Act [ label = "Import CSV or TSV…",
            press() { app.importBookings() }
            ],
        Act [ label = "Download a template",
            press() {
                FilePicker.save("identifier,text,pages,size,shape\nAD-101,Acme Watches,3;IBC,1,full\nAD-102,Northwind Travel,12,1/2,horizontal\nPR-7,Subscribe promo,,1/4,square\n",
                    ({ name: "ads-to-place.csv", type: "text/csv" }))
                }
            ]
        ]
    ]


// ── Print sections (F-PRINT-07) ─────────────────────────────────────────────

class SigList [ width = 100%,
    which: string = "body",
    sizes: number[] = { classroot.which == "cover" ? app.fp?.signatures.cover ?? [] : app.fp?.signatures.body ?? [] },
    edit(label: string, f: (l: number[]) => number[]) {
        const which = this.which
        app.plan.apply(label, (fp: Flatplan) => {
            if (which == "cover") fp.signatures.cover = f([...fp.signatures.cover])
            else fp.signatures.body = f([...fp.signatures.body])
            return ""
            }, true)
        },
    layout: SimpleLayout [ axis = y, spacing = 6 ],
    Row [ Caption [ flexes = true, text = { (classroot.which == "cover" ? "COVER SECTIONS" : "CONTENT SECTIONS") + " · " + classroot.sizes.reduce((a, b) => a + b, 0) + " PAGES" } ]
        ],
    View [ width = 100%,
        src: Dataset [ contents = { ({ rows: classroot.sizes.map((n, i) => ({ id: "s" + i, n: n, i: i })) }) } ],
        datapath = { this.src.value },
        layout: WrappingLayout [ spacing = 6, rowSpacing = 6 ],
        Act [ datapath = :rows[], label = { (:n ?? 0) + " ×" }, accessibilityLabel = "Remove a print section", disabled = { app.readOnly },
            press() { const i = :i ?? 0; classroot.edit("Remove a print section", (l: number[]) => l.filter((x, k) => k != i)) }
            ]
        ],
    Row [ visible = { !app.readOnly },
        Muted [ text = "Add" ],
        Act [ label = "4", accessibilityLabel = "Add a 4-page section",
            press() { classroot.edit("Add a 4-page section", (l: number[]) => [...l, 4]) }
            ],
        Act [ label = "8", accessibilityLabel = "Add an 8-page section",
            press() { classroot.edit("Add an 8-page section", (l: number[]) => [...l, 8]) }
            ],
        Act [ label = "16", accessibilityLabel = "Add a 16-page section",
            press() { classroot.edit("Add a 16-page section", (l: number[]) => [...l, 16]) }
            ],
        Act [ label = "24", accessibilityLabel = "Add a 24-page section",
            press() { classroot.edit("Add a 24-page section", (l: number[]) => [...l, 24]) }
            ],
        Act [ label = "32", accessibilityLabel = "Add a 32-page section",
            press() { classroot.edit("Add a 32-page section", (l: number[]) => [...l, 32]) }
            ]
        ]
    ]


class PrintDialog extends StepDialog [ step = "print", title = "Print sections", wide = 520,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    total: number = { app.printTotal },
    have: number = { app.plan.pages.length + (app.fp?.holding.length ?? 0) },
    diff: number = { classroot.total - classroot.have },
    Muted [ width = 100%, text = "A calculator for the signatures the printer binds the book from. It never changes a page." ],
    SigList [ which = "cover" ],
    SigList [ which = "body" ],
    Row [ Caption [ width = 220, text = "TOTAL PAGES, BY SECTIONS" ],
        Text [ text = { "" + classroot.total } ]
        ],
    Row [ Caption [ width = 220, text = "PAGES ON THE FLATPLAN AND HELD" ],
        Text [ text = { "" + classroot.have } ]
        ],
    Row [ Caption [ width = 220, text = "DIFFERENCE" ],
        Text [ text = { (classroot.diff > 0 ? "+" : "") + classroot.diff } ]
        ],
    Text [ width = 100%, fontWeight = semibold,
        textColor = { classroot.diff == 0 ? provided("theme").ok : provided("theme").warn },
        text = { classroot.diff == 0 ? "The pages fit the sections exactly."
            : classroot.diff < 0 ? "Remove " + (-classroot.diff) + " pages from the flatplan, or add sections."
            : "Add " + classroot.diff + " pages to the flatplan, or remove sections." } ]
    ]


// ── Stitch-ins (F-PRINT-08) ─────────────────────────────────────────────────

class StitchRow [ width = 100%, padding = [6, 0, 6, 0],
    sid: string = { :id ?? "" },
    edit(f: (s: StitchIn) => void) {
        const id = this.sid
        app.plan.apply("Edit stitch-in", (fp: Flatplan) => { const s = fp.stitchIns.find((x) => x.id == id); if (s != null) f(s); return "" }, true)
        },
    stroke = { [null, null, Stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = y, spacing = 6 ],
    Row [ Text [ flexes = true, fontWeight = semibold, text = { "After " + app.plan.nameOf(:after ?? "").replace("Page", "page") } ],
        IconAct [ visible = { !app.readOnly }, shape = "close", accessibilityLabel = "Remove a stitch-in",
            press() { const id = classroot.sid; app.plan.apply("Remove a stitch-in", (fp: Flatplan) => { fp.stitchIns = fp.stitchIns.filter((x) => x.id != id); return "" }, true) }
            ]
        ],
    TextInput [ width = 100%, height = 30, placeholder = "Front", accessibilityLabel = "Front", disabled = { app.readOnly }, commitOn = "end", value = { :front ?? "" },
        commit(v: string) { if (v != (:front ?? "")) classroot.edit((s: StitchIn) => { s.front = v }) }
        ],
    TextInput [ width = 100%, height = 30, placeholder = "Back", accessibilityLabel = "Back", disabled = { app.readOnly }, commitOn = "end", value = { :back ?? "" },
        commit(v: string) { if (v != (:back ?? "")) classroot.edit((s: StitchIn) => { s.back = v }) }
        ]
    ]


class StitchDialog extends StepDialog [ step = "stitch", title = "Stitch-ins",
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    Muted [ visible = { (app.fp?.stitchIns.length ?? 0) == 0 }, text = "Nothing is bound in yet." ],
    View [ width = 100%, datapath = { app.plan.value?.open },
        layout: SimpleLayout [ axis = y ],
        StitchRow [ datapath = :stitchIns[] ]
        ],
    Act [ visible = { !app.readOnly }, disabled = { app.pageId == "" },
        label = { app.pageId == "" ? "Choose a page first" : "Add after " + app.plan.nameOf(app.pageId).replace("Page", "page") },
        press() {
            const after = app.pageId
            if (after == "") return
            app.plan.apply("Add a stitch-in", (fp: Flatplan) => { fp.stitchIns.push(({ id: makeId("x-"), after: after, front: "", back: "" })); return "" }, true)
            }
        ]
    ]


