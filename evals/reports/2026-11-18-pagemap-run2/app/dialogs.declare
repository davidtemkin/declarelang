class NumberDialog extends StepDialog [ step = "number", title = "Start numbering here",
    buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "go", label: "Renumber", default: true }) ] },
    f: NumberForm [ exists = { classroot.present } ],
    act(id: string) -> boolean {
