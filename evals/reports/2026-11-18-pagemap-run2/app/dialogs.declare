    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 1 ],
        Text [ fontSize = 13, fontWeight = semibold, wrap = false, text = { (:name ?? "") + ((:uid ?? "") == app.uid ? " (you)" : "") } ],
        Muted [ fontSize = 11, wrap = false, text = { :email ?? "" } ]
        ],
    Caption [ text = { (:role ?? "") == "admin" ? "ADMIN" : (:role ?? "") == "editor" ? "CAN EDIT" : "CAN VIEW" } ]
    ]


class ShareDialog extends StepDialog [ step = "share", title = "Share", wide = 540,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    email: string = "",
    inviteRole: string = "editor",
    valid: boolean = { /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(classroot.email.trim()) },
    isAdmin: boolean = { app.role == "admin" },
    viewLink: string = { appAddress() + "#view/" + (app.fp?.id ?? "") },
    invite() {
        if (!isAdmin) { app.say("Only an admin can invite people."); return }
        if (!valid) return
        const e = email.trim().toLowerCase()
        writeMany(({ ["invites/" + emailKey(e)]: ({ ws: app.ws, role: inviteRole, by: app.uid, at: "__now__" }) })).then(() => {
            app.say(e + " is invited. Tell them to create an account with that address at " + appAddress())
            email = ""
            }, (err: any) => { app.say("The invitation wasn't saved: " + authMessage(err)) })
        },
    copyLink() {
        const ws = app.ws, id = app.fp?.id ?? ""
        Clipboard.copy(viewLink)
        turnOnLink(ws, id).then(() => { app.say("Link copied.") }, (err: any) => { app.say("The link couldn't be turned on: " + authMessage(err)) })
        },
    Caption [ text = "PEOPLE IN THE WORKSPACE" ],
    View [ width = 100%, datapath = { app.members.value },
        layout: SimpleLayout [ axis = y ],
        PersonRow [ datapath = :rows[] ]
        ],
    Caption [ text = "INVITE" ],
    Row [ TextInput [ flexes = true, height = 32, placeholder = "name@example.com", accessibilityLabel = "Email to invite", purpose = email,
            value <-> classroot.email,
            onEnter() { classroot.invite() }
            ],
        Segmented [ value = { classroot.inviteRole }, accessibilityLabel = "Role",
            items = { [ ({ id: "editor", label: "Can edit" }), ({ id: "viewer", label: "Can view" }) ] },
            commit(v: string) { classroot.inviteRole = v }
            ],
        Button [ label = "Invite", disabled = { !classroot.isAdmin || !classroot.valid },
            onClick() { classroot.invite() }
            ]
        ],
    Muted [ visible = { !classroot.isAdmin }, text = "Only an admin can invite people." ],
    Caption [ text = "VIEW-ONLY LINK" ],
    Muted [ width = 100%, text = "Copying the link turns it on. Anyone with it can read and export the live flatplan, but not change it." ],
    Row [ TextInput [ flexes = true, height = 32, accessibilityLabel = "View-only link", value = { classroot.viewLink },
            commit(v: string) { }
            ],
        Button [ label = "Copy", disabled = { app.readOnly },
            onClick() { classroot.copyLink() }
            ]
        ],
    Caption [ text = "EMAIL THE FLATPLAN TO THE TEAM" ],
    Muted [ width = 100%, text = "Pagemap doesn't send email yet. Copy the view-only link, or print or save the flatplan as a PDF." ],
    Row [ Act [ label = "Print or save as PDF",
            press() { app.leaveStep(); app.printPlan() }
            ],
        Act [ label = "Export a backup",
            press() { app.exportBackup() }
            ]
        ]
    ]


