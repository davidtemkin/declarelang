class MoveForm [ width = 100%,
    ids: string[] = { app.moveGroupIds },
    how: string = "before",
    target: string = "",
    layout: SimpleLayout [ axis = y, spacing = 10 ],
    Text [ width = 100%, fontSize = 13,
        text = { "Move " + classroot.ids.length + (classroot.ids.length == 1 ? " physical page (" : " physical pages (") + app.plan.rangeOf(classroot.ids) + ") as one group. Placements, artwork and notes travel with them." } ],
    Segmented [ value = { classroot.how }, accessibilityLabel = "How",
        items = { [ ({ id: "before", label: "Insert before" }), ({ id: "after", label: "Insert after" }), ({ id: "swap", label: "Swap" }) ] },
        commit(v: string) { classroot.how = v }
        ],
    Field2 [ label = "TARGET PAGE",
        Button [ width = 100%, menu = { classroot.targets },
            label = { classroot.target == "" ? "Choose a page" : app.plan.nameOf(classroot.target) + " — " + app.pageTitle(app.plan.page(classroot.target)) } ]
        ],
    targets: Menu [
        items = { app.plan.pages.map((p) => ({ id: p.id, label: app.plan.nameOf(p.id) + " — " + app.pageTitle(p), group: "t", checked: classroot.target == p.id })) },
        picked(id: string) { classroot.target = id }
        ]
    ]


class MoveDialog extends StepDialog [ step = "move", title = "Move pages",
    buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "move", label: "Move", default: true }) ] },
    f: MoveForm [ exists = { classroot.present } ],
    act(id: string) -> boolean {
        if (id != "move") return true
        const f = this.f as MoveForm
        if (f == null) return false
        const ids = f.ids, t = f.target
        if (t == "") { app.say("Choose a target page first."); return false }
        const ok = f.how == "swap"
            ? app.plan.apply("Swap " + app.pagesWord(ids.length), (fp: Flatplan) => app.plan.opSwap(fp, ids, t))
            : app.plan.apply("Move " + app.pagesWord(ids.length), (fp: Flatplan) => app.plan.opMove(fp, ids, t, f.how == "after", app.moveMode == "spread"))
        if (ok) app.say(f.how == "swap" ? "Swapped. Folios updated." : "Moved. Folios updated automatically.")
        return ok
        }
    ]


// ── Insert pages, copy across, numbering (F-PAGE-11, -12, -13) ──────────────

class CountForm [ width = 100%,
    n: number = 2,
    note: string = "",
    layout: SimpleLayout [ axis = y, spacing = 8 ],
    Stepper [ min = 1, max = 200, value = { classroot.n }, accessibilityLabel = "How many",
        commit(v: number) { classroot.n = Math.max(1, Math.round(v)) }
        ],
    Muted [ width = 100%, text = { classroot.note } ]
    ]


class InsertDialog extends StepDialog [ step = "insert", title = "Insert pages after",
    buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "go", label: "Insert", default: true }) ] },
    f: CountForm [ exists = { classroot.present }, n = 2, note = "Blank pages, in this page's section. An even number keeps the spreads as they are." ],
    act(id: string) -> boolean {
        if (id != "go") return true
        const f = this.f as CountForm
        const after = app.pageId
        if (f == null || after == "") return false
        const n = f.n
        return app.plan.apply("Insert " + app.pagesWord(n), (fp: Flatplan) => app.plan.opInsert(fp, after, n))
        }
    ]


class AcrossDialog extends StepDialog [ step = "across", title = "Copy content across next pages",
    buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "go", label: "Copy", default: true }) ] },
    f: CountForm [ exists = { classroot.present }, n = 1, note = "This page's layout and regions go onto the next pages, skipping cover faces." ],
    act(id: string) -> boolean {
        if (id != "go") return true
        const f = this.f as CountForm
        const from = app.pageId
        if (f == null || from == "") return false
        const n = f.n
        return app.plan.apply("Copy content across " + n + " pages", (fp: Flatplan) => app.plan.opCopyAcross(fp, from, n))
        }
    ]


class NumberForm [ width = 100%,
    n: number = { app.plan.fact(app.pageId)?.num ?? 1 },
    layout: SimpleLayout [ axis = y, spacing = 8 ],
    Muted [ width = 100%, text = "The count starts again at this page, and goes on from there." ],
    Stepper [ min = -999, max = 9999, value = { classroot.n }, accessibilityLabel = "Number from",
        commit(v: number) { classroot.n = Math.round(v) }
        ],
    Act [ visible = { (app.page?.restart ?? 0) > 0 }, label = "Remove the restart",
        press() {
            const id = app.pageId
            if (app.plan.apply("Continue numbering", (fp: Flatplan) => app.plan.opPages(fp, [id], (q: Page) => { q.restart = null }))) app.closeStep()
            }
        ]
