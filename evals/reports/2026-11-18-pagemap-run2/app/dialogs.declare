        const f = this.f as NumberForm
        const pid = app.pageId
        if (f == null || pid == "") return false
        const n = f.n
        return app.plan.apply("Number from " + n, (fp: Flatplan) => app.plan.opPages(fp, [pid], (q: Page) => { q.restart = n }))
        }
    ]


// ── New story (F-STORY-01, -02, -03) ────────────────────────────────────────

class StoryForm [ width = 100%,
    where: string = { app.stepArg.split(":")[0] ?? "hold" },
    fixedSection: string = { app.stepArg.split(":")[1] ?? "" },
    title: string = "",
    section: string = { classroot.fixedSection != "" ? classroot.fixedSection : app.page?.sectionId ?? (app.fp?.sections[1] ?? app.fp?.sections[0])?.id ?? "" },
    pages: number = { classroot.where == "here" ? 1 : 4 },
    editor: string = { app.uid },
    advert: boolean = false,
    layout: SimpleLayout [ axis = y, spacing = 10 ],
    Field2 [ label = "TITLE",
        TextInput [ width = 100%, height = 32, accessibilityLabel = "Title", value <-> classroot.title,
            onEnter() { app.storyDlg.pick("go") }
            ]
        ],
    Row [ Field2 [ flexes = true, label = "SECTION",
            Button [ disabled = { classroot.fixedSection != "" }, menu = { classroot.secMenu }, label = { app.plan.section(classroot.section)?.name ?? "" } ]
            ],
        Field2 [ width = 120, label = "PLANNED PAGES",
            Stepper [ min = 1, max = 400, value = { classroot.pages }, accessibilityLabel = "Planned pages",
                commit(v: number) { classroot.pages = Math.max(1, Math.round(v)); app.storyDlg.endPages = classroot.pages }
                ]
            ]
        ],
    Field2 [ visible = { !classroot.advert }, label = "EDITOR",
        Button [ menu = { classroot.edMenu }, label = { classroot.editor == "" ? "Unassigned" : app.personName(classroot.editor) } ]
        ],
    Checkbox [ label = "It's an advertisement", checked = { classroot.advert },
        commit(v: boolean) { classroot.advert = v }
        ],
    secMenu: Menu [ items = { (app.fp?.sections ?? []).map((s) => ({ id: s.id, label: s.name, group: "s", checked: classroot.section == s.id })) },
        picked(id: string) { classroot.section = id }
        ],
    edMenu: Menu [ items = { [ ({ id: "", label: "Unassigned", group: "e", checked: classroot.editor == "" }),
            ...app.editors.map((m) => ({ id: m.uid, label: m.name, group: "e", checked: classroot.editor == m.uid })) ] },
        picked(id: string) { classroot.editor = id }
        ]
    ]


class NewStoryDialog extends StepDialog [ step = "story",
    where: string = { app.stepArg.split(":")[0] ?? "hold" },
    title = { classroot.where == "end" ? "New story at the end of " + (app.plan.section(app.stepArg.split(":")[1] ?? "")?.name ?? "") : classroot.where == "here" ? "New story on this page" : "Add a story" },
    buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }),
        ({ id: "go", default: true, label: classroot.where == "here" ? "Add and place here"
            : classroot.where == "end" ? "Add " + classroot.endPages + " pages at the end of " + (app.plan.section(app.stepArg.split(":")[1] ?? "")?.name ?? "")
            : "Add story" }) ] },
    endPages: number = 4,
    form: StoryForm [ exists = { classroot.present } ],
    act(id: string) -> boolean {
        if (id != "go") return true
        const f = this.form as StoryForm
        if (f == null) return false
        if (f.title.trim() == "") { app.say("A story needs a title."); return false }
        const s: Story = ({ id: makeId("s-"), title: f.title.trim(), sectionId: f.section, kind: f.advert ? "advertising" : "editorial",
            pages: Math.max(1, f.pages), editor: f.advert ? "" : f.editor, status: app.fp?.statuses[0]?.id ?? "", notes: "", rightStart: false })
        const plan = app.plan
        if (f.where == "here") {
            const pid = app.pageId, idx = app.regionIdx
            return plan.apply("New story " + s.title, (fp: Flatplan) => {
                fp.stories.push(s)
                return plan.opRegion(fp, pid, idx, (r: Region) => { r.storyId = s.id; r.kind = s.kind == "advertising" ? "advertising" : "editorial"; r.bookingId = null; r.label = ""; return "" })
                })
            }
        if (f.where == "end") {
            const sec = f.section, n = s.pages
            let first = ""
            const ok = plan.apply("Add " + n + " pages at the end of " + (plan.section(sec)?.name ?? ""), (fp: Flatplan) => {
                fp.stories.push(s)
                let last = -1
                fp.pages.forEach((p, i) => { if (p.sectionId == sec && !(fp.numbering == "covers" && p.cover != null)) last = i })
                if (last < 0) return "That section has no interior page to add after."
                const fresh: Page[] = []
                for (let k = 0; k < n; k++) fresh.push(plan.blankPage(sec))
                for (const p of fresh) { p.regions[0].kind = s.kind == "advertising" ? "advertising" : "editorial"; p.regions[0].storyId = s.id }
                fp.pages.splice(last + 1, 0, ...fresh)
                first = fresh[0].id
                return ""
                })
            if (!ok) return false
            app.leaveStep()
            app.goPage(first)
            return false
            }
        if (!plan.apply("New story " + s.title, (fp: Flatplan) => { fp.stories.push(s); return "" })) return false
        app.leaveStep()
        app.chooseHeld(s.id)
        return false
        }
    ]


// ── Artwork: upload, map, library (F-ART-01 to -05) ─────────────────────────

class MapLine [ width = 100%, height = 32,
    k: number = { :k ?? 0 },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    Text [ width = 90, fontSize = 12, text = { "PDF page " + (classroot.k + 1) } ],
    Muted [ text = "→" ],
    Button [ flexes = true, menu = { app.artDlg.lineMenu },
        onClick() { app.artDlg.line = classroot.k },
        label = { (:pid ?? "") == "" ? "Keep unmapped" : app.plan.nameOf(:pid ?? "") }
        ],
    Glyph [ visible = { app.artDlg.otherArt(:pid ?? "") }, iconSize = 13, shape = "art", ink = { provided("theme").warn },
        tooltipLabel = "This page already has other artwork; saving replaces it there." ]
    ]


class AssetRow [ width = 100%, padding = [6, 0, 6, 0],
    aid: string = { :id ?? "" },
    on: number = { app.plan.pages.filter((p) => p.art?.assetId == classroot.aid).length },
    stroke = { [null, null, Stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        Text [ width = 100%, fontSize = 13, fontWeight = semibold, text = { :name ?? "" } ],
        Muted [ text = { (:pages ?? 0) + " PDF pages · on " + classroot.on + " physical pages" } ]
        ],
    Act [ visible = { (:url ?? "") != "" }, label = "View",
        press() { app.openStep("pdf:" + classroot.aid + ":1") }
        ],
    Act [ visible = { !app.readOnly }, label = "Remap",
        press() { app.artDlg.remap(classroot.aid) }
        ],
    Act [ visible = { !app.readOnly }, label = "Remove", danger = true,
        press() { const id = classroot.aid; app.plan.apply("Remove a PDF", (fp: Flatplan) => app.plan.opRemoveAsset(fp, id)) }
        ]
    ]


class ArtworkDialog extends StepDialog [ step = "art", title = "Upload artwork", wide = 600,

    // the mapping in progress: a file (or an asset being remapped) and one page id per PDF page

    mapping: boolean = false,
    fileUrl: string = "",
    fileName: string = "",
    fileSize: number = 0,
    pdfPages: number = 0,
    assetId: string = "",
    existing: Asset? = null,
    lines: string[] = [],
    line: number = 0,
    progress: number = -1,
    problem: string = "",
    dropping: boolean = false,
    unmapped: number = { classroot.lines.filter((x) => x == "").length },

    closed() { mapping = false; lines = []; progress = -1; problem = ""; existing = null },

    otherArt(pid: string) -> boolean {
        if (pid == "") return false
        const p = app.plan.page(pid)
        return p != null && p.art != null && p.art.assetId != classroot.assetId
        },

    /** Where the mapping starts: the chosen pages, else the chosen region's story's, else from the chosen page on. */

    startLines(n: number) -> string[] {
        let targets: string[] = []
        if (app.chosen.length > 1) targets = app.chosenPages.map((p) => p.id)
        else if ((app.region?.storyId ?? "") != "") targets = app.plan.storyPages(app.region?.storyId ?? "")
        else targets = classroot.fromChosen(n)
        const out: string[] = []
        for (let i = 0; i < n; i++) out.push(targets[i] ?? "")
        return out
        },
    fromChosen(n: number) -> string[] {
        const pages = app.plan.pages
        const at = Math.max(0, app.pageId == "" ? 0 : app.plan.indexOf(app.pageId))
        return pages.slice(at, at + n).map((p) => p.id)
        },

    choose() {
        FilePicker.pick(({ accept: ["application/pdf", ".pdf"] })).then((files: File[]) => { if (files.length > 0) classroot.take(files[0]) })
        },
    take(f: File) {
        problem = ""
        if (!(f.type == "application/pdf" || f.name.toLowerCase().endsWith(".pdf"))) { problem = "That isn't a PDF."; app.say("That isn't a PDF."); return }
        pdfPageCount(f.url).then((n: number) => {
            fileUrl = f.url
            fileName = f.name
            fileSize = f.size
            pdfPages = n
            assetId = makeId("a-")
            existing = null
            lines = classroot.startLines(n)
            mapping = true
            }, (e: any) => { problem = "Couldn't read that PDF: " + String(e?.message ?? e) })
        },
    remap(id: string) {
        const a = app.plan.asset(id)
        if (a == null) return
        const out: string[] = []
        for (let i = 0; i < a.pages; i++) out.push(app.plan.pages.find((p) => p.art?.assetId == id && p.art?.page == i + 1)?.id ?? "")
        existing = a
        assetId = a.id
        fileName = a.name
        fileSize = a.size
        pdfPages = a.pages
        fileUrl = ""
        lines = out
        mapping = true
        },
    setLine(k: number, pid: string) {
        const next = lines.map((x, i) => (i != k && x == pid && pid != "") ? "" : x)
        next[k] = pid
        lines = next
        },
    consecutive() {
        const ids = classroot.fromChosen(pdfPages)
        lines = lines.map((x, i) => ids[i] ?? "")
        },

    buttons = { classroot.mapping ? [ ({ id: "back", label: "Back" }), ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "save", label: "Save mapping", default: true }) ]
        : [ ({ id: "cancel", label: "Close", default: true, cancel: true }) ] },
    act(id: string) -> boolean {
        if (id == "back") { mapping = false; lines = []; problem = ""; existing = null; return false }
        if (id != "save" || !mapping) return true
        if (lines.every((x) => x == "")) { app.say("Map at least one PDF page onto a page first."); return false }
        const mapped = [...lines]
        const name = fileName
        const finish = (asset: Asset) => {
            if (app.plan.apply("Attach " + name, (fp: Flatplan) => app.plan.opAttach(fp, asset, mapped))) {
                app.viewMode = "art"
                app.say("Attached. The artwork follows its pages wherever they move.")
                app.closeStep()
                }
            }
        if (existing != null) { finish(existing); return false }
        const aid = assetId, size = fileSize, pages = pdfPages
        progress = 0
        uploadPdf(app.uid, aid, fileUrl, (f: number) => { classroot.progress = f }).then((url: string) => {
            classroot.progress = -1
            finish(({ id: aid, name: name, pages: pages, size: size, url: url }))
            }, (e: any) => {
            classroot.progress = -1
            classroot.problem = "The PDF didn't upload: " + authMessage(e)
            app.say(classroot.problem)
            })
        return false
        },

    lineMenu: Menu [
        items = { [ ({ id: "", label: "Keep unmapped" }), ({ divider: true }),
            ...app.plan.pages.map((p) => ({ id: p.id, label: app.plan.nameOf(p.id), group: "m", checked: classroot.lines[classroot.line] == p.id })) ] },
        picked(id: string) { classroot.setLine(classroot.line, id) }
        ],

    // nothing being mapped: the drop place and the library

    pickPart: View [ visible = { !classroot.mapping }, width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        well: Control [ visible = { !app.readOnly }, width = 100%, height = 110, cornerRadius = 10,
            accessibilityLabel = "Choose a PDF, or drop one here",
            stroke = { Stroke(1.5, classroot.dropping ? provided("theme").accent : provided("theme").lineStrong) },
            fill = { classroot.dropping ? provided("theme").controlSelected : hovered ? provided("theme").controlHovered : null },
            press() { classroot.choose() },
            onFilesOver() { classroot.dropping = true },
            onFilesOut() { classroot.dropping = false },
            onFilesDrop(e: FilesDropEvent) { classroot.dropping = false; if (e.files.length > 0) classroot.take(e.files[0]) },
            View [ x = center, y = center,
                layout: SimpleLayout [ axis = y, spacing = 6, align = center ],
                Glyph [ iconSize = 22, weight = 1.6, shape = "upload", ink = { provided("theme").textMuted } ],
                Text [ fontSize = 13, fontWeight = semibold, text = "Choose a PDF, or drop one here" ]
                ]
            ],
        Text [ visible = { classroot.problem != "" }, width = 100%, fontSize = 13, textColor = { provided("theme").danger }, text = { classroot.problem } ],
        Caption [ text = "THIS FLATPLAN'S PDFS" ],
        Muted [ visible = { (app.fp?.assets.length ?? 0) == 0 }, text = "No PDFs yet." ],
        View [ width = 100%, datapath = { app.plan.value?.open },
            layout: SimpleLayout [ axis = y ],
            AssetRow [ datapath = :assets[] ]
            ]
        ],

    // mapping

    mapPart: View [ visible = { classroot.mapping }, width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 8 ],
        Text [ fontSize = 14, fontWeight = semibold, text = { classroot.fileName } ],
        Muted [ text = { classroot.pdfPages + " PDF pages · " + (Math.round(classroot.fileSize / 1024 / 102.4) / 10) + " MB" } ],
        Row [ Act [ label = "From the chosen page on",
                press() { classroot.consecutive() }
                ],
            Act [ label = "Clear all",
                press() { classroot.lines = classroot.lines.map((x) => "") }
                ]
            ],
        Muted [ visible = { classroot.unmapped > 0 }, width = 100%,
            text = { classroot.unmapped + (classroot.unmapped == 1 ? " PDF page stays" : " PDF pages stay") + " unmapped. Unmapped pages change nothing." } ],
        Text [ visible = { classroot.lines.some((x) => classroot.otherArt(x)) }, width = 100%, fontSize = 12, textColor = { provided("theme").warn },
            text = "Some of these pages already have other artwork. Saving replaces it there." ],
        lines: View [ width = 100%,
            src: Dataset [ contents = { ({ rows: classroot.lines.map((pid, k) => ({ id: "l" + k, k: k, pid: pid })) }) } ],
            datapath = { this.src.value },
            layout: SimpleLayout [ axis = y, spacing = 2 ],
            MapLine [ datapath = :rows[] ]
            ],
        ProgressBar [ visible = { classroot.progress >= 0 }, width = 100%, min = 0, max = 1, accessibilityLabel = "Upload", value = { Math.max(0, classroot.progress) } ],
        Text [ visible = { classroot.problem != "" }, width = 100%, fontSize = 13, textColor = { provided("theme").danger }, text = { classroot.problem } ]
        ]
    ]


// ── Site admins (F-ADMIN-01 to -04) ─────────────────────────────────────────

schema Account [ uid: string, name: string, email: string, ws?: string, wsName?: string, bytes?: number, created?: number, cleared?: number, blocked?: boolean ]

class AccountRow [ width = 100%, padding = [6, 0, 6, 0],
    auid: string = { :uid ?? "" },
    mine: boolean = { classroot.auid == app.uid },
    armed: boolean = false,
    stroke = { [null, null, Stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        Row [ Text [ fontSize = 13, fontWeight = semibold, wrap = false, text = { (:name ?? "") + (classroot.mine ? " (you)" : "") } ],
            Caption [ visible = { :blocked ?? false }, textColor = { provided("theme").danger }, text = "BLOCKED" ]
            ],
        Muted [ width = 100%, text = { (:email ?? "") + " · " + ((:cleared ?? 0) > 0 ? "Cleared" : (:wsName ?? "") != "" ? :wsName ?? "" : (:ws ?? "") != "" ? "Workspace " + (:ws ?? "") : "No workspace")
            + " · " + (Math.round((:bytes ?? 0) / 1024 / 102.4) / 10).toFixed(1) + " MB · joined " + dateLabel(:created ?? 0) } ]
        ],
    Act [ visible = { !classroot.mine }, label = { (:blocked ?? false) ? "Unblock" : "Block" },
        press() { app.accountsDlg.block(classroot.auid, !(:blocked ?? false)) }
        ],
    Act [ visible = { !classroot.mine }, danger = true, label = { classroot.armed ? "Press again to clear" : "Clear data" },
        press() {
            if (!classroot.armed) { classroot.armed = true; afterDelay(4000, () => { classroot.armed = false }); return }
            classroot.armed = false
            app.accountsDlg.clear(classroot.auid)
            }
        ]
    ]


class AccountsDialog extends StepDialog [ step = "accounts", title = "Manage accounts", wide = 680,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    rows: Dataset [ schema = [ rows[]: Account ] ] { { "rows": [] } },
    loading: boolean = false,
    load() {
        loading = true
        Promise.all([readPath("accounts"), readPath("blocked")]).then((r: any[]) => {
            const acc = r[0] ?? {}, bl = r[1] ?? {}
            const rows = Object.keys(acc).map((k) => ({ uid: k, name: acc[k].name ?? "", email: acc[k].email ?? "", ws: acc[k].ws ?? "", wsName: acc[k].wsName ?? "",
                bytes: acc[k].bytes ?? 0, created: acc[k].created ?? 0, cleared: acc[k].cleared ?? 0, blocked: bl[k] === true }))
            rows.sort((a, b) => (b.created ?? 0) - (a.created ?? 0))
            classroot.rows.set(["rows"], rows)
            classroot.loading = false
            }, () => { classroot.loading = false })
        },
    trackChanges = ["present"],
    onChange() { if (this.present) this.load() },
    block(uid: string, on: boolean) {
        (on ? writeMany(({ ["blocked/" + uid]: true })) : removeAt("blocked/" + uid)).then(() => {
            app.say(on ? "Blocked. They're signed out the next time Pagemap checks." : "Unblocked.")
            classroot.load()
            }, (e: any) => app.say(authMessage(e)))
        },
    clear(uid: string) {
        clearAccount(uid).then(() => { app.say("Cleared. Their workspace, flatplans and files are gone."); classroot.load() },
            (e: any) => { app.say("Not cleared: " + authMessage(e)) })
        },
    Muted [ width = 100%, text = "Clearing removes an account's workspace (if they founded it), flatplans and files. Their sign-in stays: block it too." ],
    Muted [ visible = { classroot.loading }, text = "Loading…" ],
    View [ width = 100%, datapath = { classroot.rows.value },
        layout: SimpleLayout [ axis = y ],
        AccountRow [ datapath = :rows[] ]
        ]
    ]


// ── A quick guide (F-APP-05) ────────────────────────────────────────────────

class GuidePart [ width = 100%,
    head: string = "",
    body: string = "",
    layout: SimpleLayout [ axis = y, spacing = 4 ],
    Text [ fontSize = 14, fontWeight = bold, text = { classroot.head } ],
    Text [ width = 100%, fontSize = 13, textColor = { provided("theme").textMuted }, text = { classroot.body } ]
    ]


class GuideDialog extends StepDialog [ step = "guide", title = "A quick guide", wide = 560,
    buttons = { [ ({ id: "done", label: "Done", default: true, cancel: true }) ] },
    GuidePart [ head = "Find the rhythm",
        body = "Pages sit in spreads, left and right, as the book opens. With separate covers on, FC, IFC, IBC and BC stand outside the numbering. Zoom from Overview to Detail, or Fit the whole issue in the window. Press a section's heading to fold it." ],
    GuidePart [ head = "Move with intention",
        body = "Drag a page and its whole story comes with it; choose Move single page, Move facing spread or Move section block beside the map. Hold ⌥ as you start to swap instead. ⇧-click chooses a run, ⌘-click adds a page; drag any chosen page to carry them all." ],
    GuidePart [ head = "Make room",
        body = "Give a page a layout from fourteen divisions, rotate and flip it, and set each region editorial, advertising or open. Place booked ads on advertising regions and see how well they fit. Unplaced stories and held pages wait in the holding area." ],
    GuidePart [ head = "See the artwork",
        body = "Upload a PDF, map its pages onto physical pages, and switch to Artwork to see them. The artwork follows its pages wherever they move. Read from any page spread by spread." ],
    GuidePart [ head = "Work together",
        body = "Everyone's changes appear live. Initials show who is here and which pages they have chosen. Comment on a page; Undo and Redo step through your own edits." ],
    GuidePart [ head = "Keys",
        body = "⌘Z undo · ⇧⌘Z redo · ⌘C copy page · ⌘V paste · ⌘A choose all matching · ⌫ delete · / find · P planning · A artwork · = and − zoom · ← → previous and next · Space read · Esc clear. Hold ⌘ to see them all." ]
    ]


// ── The reader (F-ART-08) ───────────────────────────────────────────────────

class ReaderPage [ width = { app.reader.pageW }, height = { app.reader.pageW * app.aspect }, clip = true,
    fill = { provided("theme").page },
    p: Page? = { :@ ?? null },
    showArt: boolean = { classroot.p?.art != null },
    PageRegion [ visible = { !classroot.showArt }, datapath = :regions[], pageLayout = { classroot.p?.layout ?? "full" }, pageTurn = { classroot.p?.turn ?? 0 },
        pageFlip = { classroot.p?.flip ?? false }, sectionTint = { app.plan.sectionColor(classroot.p?.sectionId ?? "") }, pageId = { classroot.p?.id ?? "" } ],
    Image [ exists = { classroot.showArt }, width = 100%, height = 100%, fit = contain, source = { app.pictureOf(classroot.p?.art ?? null, 1200) } ],
    want: string = { app.pictureWant(classroot.p?.art ?? null, 1200) },
    trackChanges = ["want"],
    onChange() { app.requestWanted(classroot.want) },
    onInit() { afterSettle(() => app.requestWanted(classroot.want)) }
    ]


class Reader extends Dialog [ presentation = "full", fill = { provided("theme").canvas },
    shown = { app.reading && app.fp != null },
    commit(open: boolean) { if (!open) app.closeReader() },
    singles: boolean = false,
    at: number = { classroot.indexOfPage(app.readerAt != "" ? app.readerAt : app.pageId) },
    groups: array = { classroot.singles || !app.plan.facing ? app.plan.pages.map((p) => [p.id]) : app.plan.facts.spreads },
    indexOfPage(id: string) -> number { return Math.max(0, this.groups.findIndex((g: string[]) => g.includes(id))) },
    current: string[] = { (classroot.groups[classroot.at] ?? []) as string[] },
    go(i: number) {
        const j = Math.max(0, Math.min(this.groups.length - 1, i))
        app.readerAt = (this.groups[j] as string[])[0] ?? ""
        },
    pageW: number = { Math.max(80, Math.min((app.width - 120) / Math.max(1, classroot.current.length), (app.height - 200) / app.aspect)) },
    keyBindings = { [ ({ key: "ArrowRight", command: "next" }), ({ key: "Space", command: "next" }), ({ key: "ArrowLeft", command: "prev" }) ] },
    next() { this.go(this.at + 1) },
    prev() { this.go(this.at - 1) },
    layout: SimpleLayout [ axis = y, spacing = 12, align = center ],
    bar: View [ width = 100%, height = 50, padding = [0, 16, 0, 16],
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        Text [ fontSize = 13, fontWeight = bold, letterSpacing = 0.6, wrap = false,
            text = { classroot.current.map((id) => upper(app.plan.nameOf(id))).join(" · ") } ],
        Spacer [ ],
        Segmented [ value = { classroot.singles ? "pages" : "spreads" }, accessibilityLabel = "Show",
            items = { [ ({ id: "spreads", label: "Spreads" }), ({ id: "pages", label: "Pages" }) ] },
            commit(v: string) { classroot.singles = v == "pages" }
            ],
        IconAct [ shape = "left", accessibilityLabel = "Previous", disabled = { classroot.at <= 0 },
            press() { classroot.prev() }
            ],
        IconAct [ shape = "right", accessibilityLabel = "Next", disabled = { classroot.at >= classroot.groups.length - 1 },
            press() { classroot.next() }
            ],
        IconAct [ shape = "close", accessibilityLabel = "Close the reader",
            press() { app.closeReader() }
            ]
        ],
    stage: View [ flexes = true,
        src: Dataset [ contents = { ({ rows: classroot.current.map((id) => app.plan.page(id)).filter((p) => p != null) }) } ],
        datapath = { this.src.value },
        layout: SimpleLayout [ axis = x, spacing = 0, align = center ],
        ReaderPage [ datapath = :rows[] ]
        ],
    strip: View [ width = 100%, height = 64, scrolls = x, padding = [6, 16, 6, 16],
        src: Dataset [ contents = { ({ rows: classroot.groups.map((g: string[], i: number) => ({ id: "g" + i, i: i, label: g.map((x) => app.plan.folioOf(x)).join("–") })) }) } ],
        datapath = { this.src.value },
        layout: SimpleLayout [ axis = x, spacing = 4 ],
        Control [ datapath = :rows[], height = 40, padding = [0, 8, 0, 8], cornerRadius = 4,
            accessibilityLabel = { "Spread " + (:label ?? "") },
            fill = { (:i ?? 0) == classroot.at ? provided("theme").accent : hovered ? provided("theme").controlHovered : provided("theme").control },
            press() { classroot.go(:i ?? 0) },
            TextLabel [ y = center, fontSize = 11, wrap = false, textColor = { (:i ?? 0) == classroot.at ? 0xFFFFFF : provided("theme").text }, text = { :label ?? "" } ]
            ]
        ]
    ]


// ── The PDF viewer (F-ART-09) ───────────────────────────────────────────────

class PdfPage [ width = { app.viewer.pageW }, height = { app.viewer.pageW * 1.3 },
    url: string = { app.viewer.url },
    n: number = { :n ?? 1 },
    pic: string = "",
    fill = { provided("theme").page },
    onInit() { renderPdfPage(classroot.url, classroot.n, 1200).then((d: string) => { classroot.pic = d }, () => { }) },
    Image [ width = 100%, height = 100%, fit = contain, source = { classroot.pic } ]
    ]


class PdfViewer extends Dialog [ presentation = "full", fill = { provided("theme").canvas },
    shown = { app.stepIs("pdf") },
    commit(open: boolean) { if (!open) app.closeStep() },
    assetId: string = { app.stepArg.split(":")[0] ?? "" },
    startAt: number = { Number(app.stepArg.split(":")[1] ?? "1") },
    asset: Asset? = { app.plan.asset(classroot.assetId) },
    url: string = { classroot.asset?.url ?? "" },
    fitting: string = "width",
    pageW: number = { classroot.fitting == "fit" ? Math.min(app.width - 80, (app.height - 120) / 1.3) : classroot.fitting == "100" ? 612
        : classroot.fitting == "200" ? 1224 : app.width - 80 },
    layout: SimpleLayout [ axis = y, align = stretch ],
    bar: View [ height = 50, padding = [0, 16, 0, 16],
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        Text [ fontSize = 14, fontWeight = bold, wrap = false, shrinks = true, text = { classroot.asset?.name ?? "" } ],
        Muted [ visible = { app.desk }, text = { "PAGE " + Math.min(classroot.asset?.pages ?? 1, 1 + Math.floor(classroot.pane.scrollY / (classroot.pageW * 1.3 + 12))) + " / " + (classroot.asset?.pages ?? 0) } ],
        Spacer [ ],
        Segmented [ value = { classroot.fitting }, accessibilityLabel = "Zoom",
            items = { app.phone ? [ ({ id: "width", label: "Width" }), ({ id: "200", label: "200%" }) ]
                : [ ({ id: "fit", label: "Fit" }), ({ id: "width", label: "Width" }), ({ id: "100", label: "100%" }), ({ id: "200", label: "200%" }) ] },
            commit(v: string) { classroot.fitting = v }
            ],
        IconAct [ shape = "close", accessibilityLabel = "Close the viewer",
            press() { app.closeStep() }
            ]
        ],
    pane: View [ flexes = true, scrolls = both, padding = 20,
        src: Dataset [ contents = { ({ rows: Array.from({ length: classroot.asset?.pages ?? 0 }, (_, i) => ({ id: "n" + (i + 1), n: i + 1 })) }) } ],
        datapath = { this.src.value },
        layout: SimpleLayout [ axis = y, spacing = 12, align = center ],
        trackChanges = ["contentHeight"],
        onChange() { if (classroot.startAt > 1) this.scrollTo((classroot.startAt - 1) * (classroot.pageW * 1.3 + 12)) },
        PdfPage [ datapath = :rows[] ]
        ]
    ]
