/*
# Presentify: a slide, drawn

One slide at its own size, 1280 × 720 points, built from its record. The
editor, every thumbnail and the presenter use the same `SlideArt`, scaled, so
a slide looks the same wherever it is seen.

Each element is a view of its own class, picked by its `kind`. A group is a
view that holds its children's views; it has no box of its own, so it takes
no presses — its children do, and say which group they are in.

Only the editor's slide is `editable`: there each element reports presses and
drags to the editor (`app.ed`, `app.drag`). Thumbnails and the presenter take
no presses at all (`pointerEvents = "none"` where they are placed).
*/

use [ GroupEl, RectEl, EllipseEl, LineEl, TextEl ]

class SlideArt [ width = 1280, height = 720, clip = true, pivotX = 0, pivotY = 0,
    editable: boolean = false,
    slideKey: string = { :key ?? "" },
    fill = { paint(:background, "#FFFFFF") },
    ElView [ datapath = :elements[], classFor = { elClass(:kind ?? "rect") } ]
    ]


script {
    // Which view class draws an element of a kind.
    function elClass(kind: string) {
        switch (kind) {
            case "group": return "GroupEl"
            case "ellipse": return "EllipseEl"
            case "line": return "LineEl"
            case "text": return "TextEl"
            default: return "RectEl"
        }
    }
    }

// The common base, so one replicated child can be any kind.

class ElView [
    elId: string = { :id ?? "" }
    ]


class GroupEl extends ElView [
    ElView [ datapath = :children[], classFor = { elClass(:kind ?? "rect") } ]
    ]


// Something a person can press on the editor's slide.

class Leaf extends ElView [
    editable: boolean = { provided("editable", false) },
    cursor = { this.editable ? app.ed.leafCursor : "" },
    onPointerDown(e: PointerEvent) { if (this.editable) app.ed.pressEl(this.elId, e) },
    onDragStart(e: PointerEvent) { if (this.editable) app.drag.start(e) },
    onDrag(e: PointerEvent) { if (this.editable) app.drag.move(e) },
    onDragEnd(e: DragEndEvent) { if (this.editable) app.drag.end(e.canceled) },
    onClick(e: PointerEvent) { if (this.editable) app.drag.clicked(e) },
    onDoubleClick(e: PointerEvent) { if (this.editable) app.ed.doubleEl(this.elId) },
    onContextMenu(e: PointerEvent) { if (this.editable) app.ed.menuAt(this, e, this.elId) }
    ]


class RectEl extends Leaf [
    x = { :x ?? 0 }, y = { :y ?? 0 }, width = { :width ?? 0 }, height = { :height ?? 0 },
    fill = { paint(:fill, null) },
    stroke = { :stroke == null ? null : Stroke(:stroke.width, paint(:stroke.color, "#1F2328")) },
    cornerRadius = { Math.max(0, Math.min(:cornerRadius ?? 0, this.width / 2, this.height / 2)) }
    ]


// An ellipse is drawn, and takes presses only inside its outline.

class EllipseEl extends Leaf [
    x = { :x ?? 0 }, y = { :y ?? 0 }, width = { :width ?? 0 }, height = { :height ?? 0 },
    ink: string = { hexOk(:fill ?? "") ? :fill ?? "" : "" },
    line: string = { hexOk(:stroke?.color ?? "") ? :stroke?.color ?? "" : "" },
    lineW: number = { :stroke?.width ?? 0 },
    clip = { ellipsePath(Math.max(1, this.width), Math.max(1, this.height)) },
    draw(d: DrawContext) {
        const w = d.w, h = d.h
        if (w <= 0 || h <= 0) return
        if (ink != "") {
            d.fillStyle = ink
            d.beginPath()
            d.ellipse(w / 2, h / 2, w / 2, h / 2, 0, 0, Math.PI * 2)
            d.fill()
        }
        if (line != "" && lineW > 0) {
            const i = lineW / 2
            d.strokeStyle = line
            d.lineWidth = lineW
            d.beginPath()
            d.ellipse(w / 2, h / 2, Math.max(0.5, w / 2 - i), Math.max(0.5, h / 2 - i), 0, 0, Math.PI * 2)
            d.stroke()
        }
        }
    ]


// A line is a thin view turned along it, thick enough to aim at.

class LineEl extends Leaf [
    ax: number = { :x1 ?? 0 },
    ay: number = { :y1 ?? 0 },
    bx: number = { :x2 ?? 0 },
    by: number = { :y2 ?? 0 },
    lineW: number = { :stroke?.width ?? 2 },
    grab: number = { Math.max(this.lineW, 18) },
    x = { this.ax }, y = { this.ay - this.grab / 2 },
    width = { Math.max(1, Math.hypot(this.bx - this.ax, this.by - this.ay)) }, height = { this.grab },
    rotation = { Math.atan2(this.by - this.ay, this.bx - this.ax) * 180 / Math.PI },
    pivotX = 0, pivotY = { this.grab / 2 },
    View [ y = center, width = 100%, height = { classroot.lineW }, fill = { paint(:stroke?.color, "#1F2328") } ]
    ]


// A text box: one block in one style, wrapping within its width, as tall as
// its lines. While it is edited, a native field lies exactly over the text.

class TextEl extends Leaf [
    x = { :x ?? 0 }, y = { :y ?? 0 }, width = { Math.max(8, :width ?? 0) },
    content: string = { :text?.content ?? "" },
    face: array = { [:text?.font ?? "Helvetica Neue", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] },
    size: number = { :text?.size ?? 32 },
    weight: number = { :text?.weight ?? 400 },
    slant: boolean = { :text?.italic ?? false },
    ink: string = { hexOk(:text?.color ?? "") ? :text?.color ?? "" : "#1F2328" },
    side: "left" | "center" | "right" = { :text?.align ?? "left" },
    editing: boolean = { this.editable && app.ed.editingId == this.elId },

    run: Text [ width = 100%, wrap = true,
        fontFamily = { classroot.face }, fontSize = { classroot.size }, fontWeight = { classroot.weight },
        italic = { classroot.slant }, textColor = { paint(classroot.ink, "#1F2328") }, textAlign = { classroot.side },
        opacity = { classroot.editing ? 0 : 1 },
        text = { classroot.content == "" ? " " : classroot.content } ],

    field: TextInput [ exists = { classroot.editing }, ignoreLayout = true, x = 0, y = 0,
        width = 100%, height = { classroot.run.height },
        multiline = true, wrap = true, enterSubmits = false, spellcheck = false, padding = 0,
        fill = null, stroke = null, cornerRadius = 0,
        fontFamily = { classroot.face }, fontSize = { classroot.size }, fontWeight = { classroot.weight },
        italic = { classroot.slant }, textColor = { paint(classroot.ink, "#1F2328") }, textAlign = { classroot.side },
        accessibilityLabel = "Text box",
        value = { classroot.content },
        commit(v: string) { app.ed.typeText(classroot.elId, v) },
        onInit() { afterSettle(() => { Focus.focus(this); this.select("end") }) },
        onBlur() { app.ed.endTextEdit() },
        keyBindings = { [ ({ key: "Escape", command: "finish" }) ] },
        finish() { app.ed.endTextEdit() }
        ],

    // The height the format keeps is the height last laid out — written back
    // only for the text being worked on, so opening a presentation changes nothing.

    trackChanges = ["height"],
    onChange() {
        if (this.editable && (this.editing || app.ed.leaves.some((e) => e.id == this.elId)))
            app.doc.syncHeight(provided("slideKey", ""), this.elId, this.height)
        }
    ]
