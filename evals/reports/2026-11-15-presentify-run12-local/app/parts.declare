/*
# Presentify: the parts

The look, kept apart from how it works: the palette, the drawn icons, the
wordmark, and the small controls the screens are made of.

Presentify's identity is a grape violet with a coral spark, on soft lilac
greys that stay quieter than any slide. Its marks are drawn with one pen —
a 1.6 stroke with round ends on a 16-unit grid — so every icon, from the
toolbar to the smallest handle, is one family.
*/

theme Presentify [
    background = #F4F2F8, surface = #FFFFFF, card = #FFFFFF, panel = #FBFAFD, workspace = #E8E5EF,
    text = #1B1530, textMuted = #676179, textFaint = #9C97AC,
    line = #E3DFEB, lineStrong = #CEC8DA,
    accent = #6B4EFF, accentHovered = #5D40F2, accentPressed = #4E31DE, accentTextColor = #FFFFFF,
    linkColor = #5D40F2,
    control = #F1EEF7, controlHovered = #E9E5F2, controlPressed = #DED9EA, controlSelected = #E6E0FF,
    hover = #F1EEF7, selectionTint = #EEE9FF,
    brand = #6B4EFF, brandDeep = #3A22B8, coral = #FF5A3C, coralPressed = #E8462A, sun = #FFC23D, mint = #22C3A0, sky = #4BA8FF,
    ink = #1B1530, danger = #D93A2B, dangerTint = #FDECEA, warnTint = #FFF5DC, warnInk = #8A5A00,
    tooltipFill = #1B1530, tooltipTextColor = #F6F4FA
    ]


// The colours a person picks from: the brand's, then neutrals.

script {
    const PALETTE = [
        "#6B4EFF", "#3A22B8", "#4BA8FF", "#0E6BD8", "#22C3A0", "#0E8A6E", "#FFC23D", "#F28C1E",
        "#FF5A3C", "#E0335E", "#C147D6", "#8C5A3C", "#0E3B43", "#2F6F8F", "#E9DFC9", "#F6F4EF",
        "#FFFFFF", "#F2F2F5", "#D6D5DC", "#A3A1AD", "#6E6C78", "#3C3A45", "#1F2328", "#000000"
        ]
    }


// ── Icons ───────────────────────────────────────────────────────────────────

class Glyph extends Icon [
    shape: string = "",
    draw(d: DrawContext) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        switch (shape) {
            case "select":      // an arrow pointer
                d.moveTo(4, 2.5); d.lineTo(4, 13); d.lineTo(6.8, 10.4); d.lineTo(8.7, 14.2); d.lineTo(10.4, 13.4)
                d.lineTo(8.6, 9.7); d.lineTo(12.3, 9.5); d.closePath(); d.stroke(); break
            case "rect": d.roundRect(2.5, 3.5, 11, 9, 1.6); d.stroke(); break
            case "ellipse": d.ellipse(8, 8, 5.8, 5, 0, 0, Math.PI * 2); d.stroke(); break
            case "line": d.moveTo(3, 13); d.lineTo(13, 3); d.stroke(); break
            case "text": d.moveTo(3.5, 4.5); d.lineTo(3.5, 3); d.lineTo(12.5, 3); d.lineTo(12.5, 4.5); d.moveTo(8, 3); d.lineTo(8, 13.2)
                d.moveTo(6.2, 13.2); d.lineTo(9.8, 13.2); d.stroke(); break
            case "undo": d.moveTo(5.5, 3.5); d.lineTo(2.5, 6.5); d.lineTo(5.5, 9.5); d.moveTo(2.8, 6.5); d.lineTo(9.5, 6.5)
                d.bezierCurveTo(12, 6.5, 13.5, 8.2, 13.5, 10); d.bezierCurveTo(13.5, 11.8, 12, 13, 9.5, 13); d.lineTo(7, 13); d.stroke(); break
            case "redo": d.moveTo(10.5, 3.5); d.lineTo(13.5, 6.5); d.lineTo(10.5, 9.5); d.moveTo(13.2, 6.5); d.lineTo(6.5, 6.5)
                d.bezierCurveTo(4, 6.5, 2.5, 8.2, 2.5, 10); d.bezierCurveTo(2.5, 11.8, 4, 13, 6.5, 13); d.lineTo(9, 13); d.stroke(); break
            case "play": d.moveTo(5, 3); d.lineTo(13, 8); d.lineTo(5, 13); d.closePath(); d.fill(); break
            case "plus": d.moveTo(8, 3); d.lineTo(8, 13); d.moveTo(3, 8); d.lineTo(13, 8); d.stroke(); break
            case "minus": d.moveTo(3, 8); d.lineTo(13, 8); d.stroke(); break
            case "duplicate": d.roundRect(5.5, 5.5, 8, 8, 1.5); d.moveTo(3.5, 10.5); d.lineTo(2.5, 10.5); d.lineTo(2.5, 2.5)
                d.lineTo(10.5, 2.5); d.lineTo(10.5, 3.5); d.stroke(); break
            case "trash": d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(6, 4); d.lineTo(6.5, 2); d.lineTo(9.5, 2); d.lineTo(10, 4)
                d.moveTo(3.8, 4); d.lineTo(4.6, 14); d.lineTo(11.4, 14); d.lineTo(12.2, 4); d.stroke(); break
            case "back": d.moveTo(10, 3); d.lineTo(5, 8); d.lineTo(10, 13); d.stroke(); break
            case "more": for (const x of [3.5, 8, 12.5]) { d.moveTo(x + 1.1, 8); d.arc(x, 8, 1.1, 0, Math.PI * 2) } d.fill(); break
            case "check": d.moveTo(3, 8.5); d.lineTo(6.5, 12); d.lineTo(13, 4.5); d.stroke(); break
            case "cloud": d.moveTo(4.5, 12.5); d.bezierCurveTo(2.2, 12.5, 1.5, 9.5, 3.8, 8.6); d.bezierCurveTo(3.8, 5.5, 7.5, 3.8, 9.4, 6.2)
                d.bezierCurveTo(11.5, 5.2, 13.6, 6.8, 13, 9); d.bezierCurveTo(15, 9.6, 14.5, 12.5, 12.4, 12.5); d.closePath(); d.stroke(); break
            case "offline": d.moveTo(4.5, 12.5); d.bezierCurveTo(2.2, 12.5, 1.5, 9.5, 3.8, 8.6); d.bezierCurveTo(3.8, 5.5, 7.5, 3.8, 9.4, 6.2)
                d.bezierCurveTo(11.5, 5.2, 13.6, 6.8, 13, 9); d.bezierCurveTo(15, 9.6, 14.5, 12.5, 12.4, 12.5); d.closePath()
                d.moveTo(2, 2); d.lineTo(14, 14); d.stroke(); break
            case "warn": d.moveTo(8, 2.2); d.lineTo(14.2, 13.3); d.lineTo(1.8, 13.3); d.closePath(); d.moveTo(8, 6.2); d.lineTo(8, 9.2)
                d.stroke(); d.beginPath(); d.arc(8, 11.4, 0.8, 0, Math.PI * 2); d.fill(); break
            case "alignLeft": d.moveTo(2.5, 2); d.lineTo(2.5, 14); d.stroke(); d.beginPath(); d.roundRect(4.5, 4, 9, 3, 0.8); d.roundRect(4.5, 9, 6, 3, 0.8); d.fill(); break
            case "alignCenter": d.moveTo(8, 2); d.lineTo(8, 14); d.stroke(); d.beginPath(); d.roundRect(3, 4, 10, 3, 0.8); d.roundRect(4.5, 9, 7, 3, 0.8); d.fill(); break
            case "alignRight": d.moveTo(13.5, 2); d.lineTo(13.5, 14); d.stroke(); d.beginPath(); d.roundRect(2.5, 4, 9, 3, 0.8); d.roundRect(5.5, 9, 6, 3, 0.8); d.fill(); break
            case "alignTop": d.moveTo(2, 2.5); d.lineTo(14, 2.5); d.stroke(); d.beginPath(); d.roundRect(4, 4.5, 3, 9, 0.8); d.roundRect(9, 4.5, 3, 6, 0.8); d.fill(); break
            case "alignMiddle": d.moveTo(2, 8); d.lineTo(14, 8); d.stroke(); d.beginPath(); d.roundRect(4, 3, 3, 10, 0.8); d.roundRect(9, 4.5, 3, 7, 0.8); d.fill(); break
            case "alignBottom": d.moveTo(2, 13.5); d.lineTo(14, 13.5); d.stroke(); d.beginPath(); d.roundRect(4, 2.5, 3, 9, 0.8); d.roundRect(9, 5.5, 3, 6, 0.8); d.fill(); break
            case "distX": d.moveTo(2, 2.5); d.lineTo(2, 13.5); d.moveTo(14, 2.5); d.lineTo(14, 13.5); d.stroke(); d.beginPath(); d.roundRect(6.5, 4.5, 3, 7, 0.8); d.fill(); break
            case "distY": d.moveTo(2.5, 2); d.lineTo(13.5, 2); d.moveTo(2.5, 14); d.lineTo(13.5, 14); d.stroke(); d.beginPath(); d.roundRect(4.5, 6.5, 7, 3, 0.8); d.fill(); break
            case "front": d.roundRect(2.5, 2.5, 7, 7, 1.2); d.stroke(); d.beginPath(); d.roundRect(6.5, 6.5, 7, 7, 1.2); d.fill(); break
            case "back2": d.roundRect(6.5, 6.5, 7, 7, 1.2); d.stroke(); d.beginPath(); d.roundRect(2.5, 2.5, 7, 7, 1.2); d.fill(); break
            case "forward": d.moveTo(8, 13); d.lineTo(8, 4); d.moveTo(4.5, 7.5); d.lineTo(8, 4); d.lineTo(11.5, 7.5); d.moveTo(3, 2); d.lineTo(13, 2); d.stroke(); break
            case "backward": d.moveTo(8, 3); d.lineTo(8, 12); d.moveTo(4.5, 8.5); d.lineTo(8, 12); d.lineTo(11.5, 8.5); d.moveTo(3, 14); d.lineTo(13, 14); d.stroke(); break
            case "group": d.setLineDash([1.6, 2]); d.roundRect(1.8, 1.8, 12.4, 12.4, 2); d.stroke(); d.setLineDash([]); d.beginPath()
                d.roundRect(4.2, 4.2, 4.5, 4.5, 0.8); d.roundRect(7.8, 7.8, 4, 4, 0.8); d.fill(); break
            case "ungroup": d.roundRect(2.5, 2.5, 5, 5, 0.8); d.roundRect(8.5, 8.5, 5, 5, 0.8); d.stroke(); break
            case "lock": d.roundRect(3.5, 7, 9, 7, 1.5); d.moveTo(5.5, 7); d.lineTo(5.5, 5); d.arc(8, 5, 2.5, Math.PI, 0); d.lineTo(10.5, 7); d.stroke(); break
            case "present": d.roundRect(1.8, 2.5, 12.4, 8.5, 1.2); d.moveTo(8, 11); d.lineTo(8, 13.8); d.moveTo(5.5, 13.8); d.lineTo(10.5, 13.8); d.stroke()
                d.beginPath(); d.moveTo(6.8, 4.6); d.lineTo(10, 6.75); d.lineTo(6.8, 8.9); d.closePath(); d.fill(); break
            case "slides": d.roundRect(4.5, 2.5, 9, 6, 1); d.roundRect(2.5, 7.5, 9, 6, 1); d.stroke(); break
            case "close": d.moveTo(4, 4); d.lineTo(12, 12); d.moveTo(12, 4); d.lineTo(4, 12); d.stroke(); break
            case "chevron": d.moveTo(4.5, 6.5); d.lineTo(8, 10); d.lineTo(11.5, 6.5); d.stroke(); break
            case "left": d.moveTo(10, 3.5); d.lineTo(5.5, 8); d.lineTo(10, 12.5); d.stroke(); break
            case "right": d.moveTo(6, 3.5); d.lineTo(10.5, 8); d.lineTo(6, 12.5); d.stroke(); break
            case "rename": d.moveTo(3, 13); d.lineTo(3.5, 10.5); d.lineTo(11, 3); d.lineTo(13, 5); d.lineTo(5.5, 12.5); d.closePath(); d.stroke(); break
            default: d.roundRect(3, 3, 10, 10, 2); d.stroke()
        }
        }
    ]


// ── The mark and the wordmark ───────────────────────────────────────────────
//
// The mark is three slides fanned like a hand of cards, the front one with a
// play notch: a deck, about to be shown.

class Mark [ width = 28, height = 28,
    draw(d: DrawContext) {
        const s = d.w / 28
        d.scale(s, s)
        const th = provided("theme")
        d.fillStyle = th.sun
        d.beginPath(); d.roundRect(9, 2, 17, 13, 3.5); d.fill()
        d.fillStyle = th.coral
        d.beginPath(); d.roundRect(5.5, 6.5, 17, 13, 3.5); d.fill()
        d.fillStyle = th.brand
        d.beginPath(); d.roundRect(2, 11, 17, 13, 3.5); d.fill()
        d.fillStyle = "#FFFFFF"
        d.beginPath(); d.moveTo(8.6, 14.4); d.lineTo(13.8, 17.5); d.lineTo(8.6, 20.6); d.closePath(); d.fill()
        }
    ]


class Wordmark [ size: number = 22,
    layout: SimpleLayout [ axis = x, spacing = { classroot.size * 0.36 }, align = center ],
    accessibilityRole = image, accessibilityLabel = "Presentify",
    Mark [ width = { classroot.size * 1.3 }, height = { this.width } ],
    TextLabel [ fontFamily = { app.brandFace }, fontSize = { classroot.size }, fontWeight = 750, letterSpacing = { -0.02 * classroot.size },
        textColor = { provided("theme").ink }, text = "presentify" ]
    ]


// ── Small controls ──────────────────────────────────────────────────────────

// A round-cornered icon button: quiet until hovered, lit when `on`.

class IconButton extends Control [ width = 34, height = 34, cornerRadius = 9,
    shape: string = "",
    on: boolean = false,
    tone: Color = { provided("theme").text },
    iconSize: number = 17,
    accessibilityPressed = { this.on },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    State [ applied = { classroot.on }, fill = { provided("theme").controlSelected } ],
    opacity = { disabled ? 0.35 : 1 },
    Glyph [ x = center, y = center, iconSize = { classroot.iconSize }, weight = 1.6, shape = { classroot.shape },
        ink = { classroot.on ? provided("theme").accent : classroot.tone } ]
    ]


// A tool on the drawing toolbar: an icon and its name beneath.

class ToolTile extends Control [ width = 52, height = 46, cornerRadius = 10,
    shape: string = "",
    label: string = "",
    tool: "select" | "rect" | "ellipse" | "line" | "text" = "select",
    on: boolean = { app.ed.tool == classroot.tool },
    accessibilityLabel = { classroot.label },
    accessibilityRole = button,
    accessibilityPressed = { classroot.on },
    tooltipLabel = { classroot.label + " (" + classroot.key + ")" },
    key: string = "",
    press() { app.ed.tool = classroot.tool },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    State [ applied = { classroot.on }, fill = { provided("theme").controlSelected } ],
    Glyph [ x = center, y = 6, iconSize = 18, weight = 1.6, shape = { classroot.shape },
        ink = { classroot.on ? provided("theme").accent : provided("theme").text } ],
    TextLabel [ x = center, y = 29, fontSize = 10.5, fontWeight = { classroot.on ? 650 : 500 },
        textColor = { classroot.on ? provided("theme").accent : provided("theme").textMuted }, text = { classroot.label } ]
    ]


// A labelled pill button for the bars.

class PillButton extends Control [ height = 34, cornerRadius = 17, padding = [0, 16, 0, 12],
    label: string = "",
    shape: string = "",
    tone: Color = { provided("theme").brand },
    toneDown: Color = { provided("theme").brandDeep },
    accessibilityLabel = { classroot.label },
    fill = { pressed ? classroot.toneDown : classroot.tone },
    opacity = { hovered && !pressed ? 0.92 : 1 },
    shadow = { Shadow(0, 2, 6, 0x1B153029) },
    layout: SimpleLayout [ axis = x, spacing = 7, align = center ],
    Glyph [ iconSize = 15, weight = 1.8, shape = { classroot.shape }, ink = white, visible = { classroot.shape != "" } ],
    TextLabel [ fontSize = 14, fontWeight = 650, textColor = white, text = { classroot.label } ]
    ]


// A small quiet text button.

class QuietButton extends Control [ height = 30, cornerRadius = 8, padding = [0, 10, 0, 10],
    label: string = "",
    tone: Color = { provided("theme").accent },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    TextLabel [ y = center, fontSize = 13, fontWeight = 600, textColor = { classroot.tone }, text = { classroot.label } ]
    ]


// ── Colour ──────────────────────────────────────────────────────────────────

// A swatch: the colour itself, a slash for none, stripes for mixed.

class Chip [ width = 22, height = 22, cornerRadius = 6, clip = true,
    color: string = "",       // "#RRGGBB", "none" or "mixed"
    stroke = { Stroke(1, 0x1B153026) },
    fill = { paint(classroot.color, 0xFFFFFF) },
    draw(d: DrawContext) {
        if (color == "none") {
            d.strokeStyle = 0xE0335E
            d.lineWidth = 1.6
            d.beginPath(); d.moveTo(4, d.h - 4); d.lineTo(d.w - 4, 4); d.stroke()
        } else if (color == "mixed") {
            d.strokeStyle = 0xB9B3C8
            d.lineWidth = 1.4
            d.beginPath()
            for (let i = -d.h; i < d.w; i = i + 5) { d.moveTo(i, d.h); d.lineTo(i + d.h, 0) }
            d.stroke()
        }
        }
    ]


// A colour property in the inspector: press it for the palette.

class ColorWell extends Control [ height = 32, cornerRadius = 8, padding = [0, 10, 0, 6],
    value: string = "",       // a colour, "none" or "mixed"
    allowNone: boolean = true,
    what: string = "Colour",
    accessibilityLabel = { classroot.what + ": " + classroot.words },
    tooltipLabel = { classroot.what },
    words: string = { value == "none" ? "None" : value == "mixed" ? "Mixed" : value.toUpperCase() },
    choose(c: string?) { },
    press() { app.colors.showFor(this) },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : provided("theme").control },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    Chip [ color = { classroot.value } ],
    TextLabel [ fontSize = 12.5, fontWeight = 500, numeralWidth = tabular, textColor = { provided("theme").text }, text = { classroot.words } ],
    Spacer [ ],
    Glyph [ iconSize = 12, weight = 1.6, shape = "chevron", ink = { provided("theme").textMuted } ]
    ]


class SwatchButton extends Control [ width = 24, height = 24, cornerRadius = 7,
    color: string = "",
    current: boolean = false,
    accessibilityLabel = { classroot.color },
    accessibilityPressed = { classroot.current },
    tooltipLabel = { classroot.color },
    fill = { paint(classroot.color, null) },
    stroke = { classroot.current ? Stroke(2, provided("theme").accent) : Stroke(1, 0x1B15301F) },
    scale = { hovered ? 1.12 : 1 }, pivotX = 12, pivotY = 12
    ]


// The palette, shared by every colour well and opened at the one pressed.

class Palette extends Popover [
    well: ColorWell? = { this.opener as ColorWell | null },
    current: string = { this.well?.value ?? "" },
    pick(c: string?) { this.well?.choose(c); this.close() },
    accessibilityLabel = "Colours",
    View [ width = 236,
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        TextLabel [ fontSize = 12, fontWeight = 650, textColor = { provided("theme").textMuted }, text = { classroot.well?.what ?? "Colour" } ],
        grid: View [ width = 100%, datapath = { app.paletteData.value },
            layout: WrappingLayout [ columns = 8, spacing = 5, rowSpacing = 5 ],
            SwatchButton [ datapath = :colors[], color = { :@ }, current = { classroot.current.toUpperCase() == (:@ as string) },
                press() { classroot.pick(:@) }
                ]
            ],
        row: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
            hex: TextInput [ flexes = true, height = 30, fontSize = 13, placeholder = "#RRGGBB", accessibilityLabel = "Hex colour",
                value = { classroot.current.startsWith("#") ? classroot.current.toUpperCase() : "" },
                commitOn = "end",
                commit(v: string) {
                    const t = v.trim().startsWith("#") ? v.trim() : "#" + v.trim()
                    if (hexOk(t)) classroot.pick(t.toUpperCase())
                    }
                ],
            none: QuietButton [ label = "None", visible = { classroot.well?.allowNone ?? false },
                press() { classroot.pick(null) }
                ]
            ]
        ]
    ]


// ── Inspector furniture ─────────────────────────────────────────────────────

class Section [ width = 100%, padding = [14, 16, 16, 16],
    title: string = "",
    stroke = { [null, null, Stroke(1, provided("theme").line), null] },
    defaultPlacement = body,
    layout: SimpleLayout [ axis = y, spacing = 10 ],
    TextLabel [ fontSize = 11, fontWeight = 700, letterSpacing = 0.6, textColor = { provided("theme").textFaint },
        text = { classroot.title.toUpperCase() } ],
    body: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 8 ]
        ]
    ]


class Row [ width = 100%, height = 32,
    label: string = "",
    gap: number = 6,
    defaultPlacement = slot,
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    TextLabel [ width = 64, fontSize = 12.5, textColor = { provided("theme").textMuted }, text = { classroot.label } ],
    slot: View [ flexes = true, height = 32,
        layout: SimpleLayout [ axis = x, spacing = { classroot.gap }, align = center ]
        ]
    ]


// A number field that can say "Mixed".

class NumberField extends TextInput [ width = 64, height = 30, fontSize = 13, numeralWidth = tabular, textAlign = right,
    amount: number = 0,             // -1 for mixed
    lo: number = 0,
    hi: number = 1000,
    set(v: number) { },
    placeholder = { this.amount < 0 ? "Mixed" : "" },
    tooltipLabel = { this.accessibilityLabel },
    value = { this.amount < 0 ? "" : "" + Math.round(this.amount * 10) / 10 },
    commitOn = "end",
    admit(t: string) -> string | null { return /^[0-9]*\.?[0-9]*$/.test(t) ? t : null },
    commit(t: string) { const n = Number(t); if (t != "" && !isNaN(n)) this.set(Math.max(this.lo, Math.min(this.hi, n))) }
    ]
