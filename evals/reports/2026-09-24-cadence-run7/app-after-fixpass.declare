        TextLabel [ x = center, fontSize = 15, fontWeight = bold, textColor = { cEffInk(:effort) }, text = { "" + :effort } ]
        ],
    sport: Text [ x = 48, y = 11, fontSize = 19, fontWeight = bold, wrap = false, text = :sport ],
    when: Text [ x = 48, y = 36, fontSize = 13, wrap = false, textColor = #7A7468, text = :when ],
    sum: Text [ x = end, y = 20, fontSize = 17, fontWeight = medium, numeralWidth = tabular, wrap = false, text = :summary ],
    press() { app.openDetail(:id) },
    onClick() { press() }
    ]


class YearColumn extends View [
