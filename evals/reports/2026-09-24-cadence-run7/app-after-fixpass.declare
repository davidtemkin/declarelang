                Fact [ label = "Distance", value = { cKm(app.sel?.distanceKm ?? 0) }, visible = { app.sel?.distanceKm != null } ],
                Fact [ label = "Heart", value = { (app.sel?.heartAvg ?? 0) + " bpm" }, visible = { app.sel?.heartAvg != null } ],
                Fact [ label = { app.sel?.sport == "run" || app.sel?.sport == "swim" ? "Pace" : "Speed" },
                    value = { app.sel == null ? "" : cPace(app.sel.sport, app.sel.minutes, app.sel.distanceKm ?? 0) },
                    visible = { app.sel?.distanceKm != null } ]
                ],

            note: View [ width = 100%, padding = [26, 0, 0, 0], visible = { (app.sel?.note ?? "") != "" },
                Text [ width = 100%, wrap = true, fontSize = 20, lineHeight = 1.35, textColor = #16140F,
                    text = { "“" + (app.sel?.note ?? "") + "”" } ]
                ],

            against: View [ width = 100%, padding = [28, 0, 0, 0],
                layout: SimpleLayout [ axis = y, spacing = 6 ],
                Label [ text = "Against everything else" ],
                Text [ width = 100%, wrap = true, fontSize = 18, lineHeight = 1.35,
                    text = { app.placeLine } ],
                PlaceStrip [ ]
                ]
            ]
        ],

    actions: View [ y = { parent.height - app.actionH }, width = 100%, height = { app.actionH }, fill = #FBFAF6,
        padding = { [12, 24, 12 + app.safeBottom, 24] },
        rule: View [ x = -24, y = -12, width = { parent.width }, height = 1, fill = #E0DBD0 ],
        edit: Btn [ width = { (parent.width - 60) / 2 }, height = 52, strong = true, label = "Edit",
            press() { app.editSelected() }
            ],
        del: Btn [ x = end, width = { (parent.width - 60) / 2 }, height = 52, danger = true,
            label = { app.confirmDelete ? "Tap again to delete" : "Delete" }, disabled = { app.busy },
            press() { app.deleteSelected() }
            ]
        ]
    ]


