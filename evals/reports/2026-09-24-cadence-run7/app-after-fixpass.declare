                Label [ y = 12, text = { app.sel == null ? "" : cDateY(cDay(app.sel.date))
                    + (app.todayN - cDay(app.sel.date) < 7 ? " · " + cRel(cDay(app.sel.date), app.todayN) : "") } ],
