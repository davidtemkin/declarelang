        text = { app.touchDevice ? "Drag to move through the months · pinch to open or close · tap a bar" : "Drag or scroll sideways to move · scroll or pinch to zoom · click a bar · N logs a session" } ],

    listHead: View [ width = 100%, padding = [30, 0, 8, 0],
