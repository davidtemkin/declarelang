                    ]
                ],

            felt: View [ width = 100%, padding = [18, 0, 0, 0],
                layout: SimpleLayout [ axis = y, spacing = 8 ],
                head: View [ width = 100%,
                    Label [ text = "How it felt" ],
                    Label [ x = end, textColor = #16140F, text = { app.eEff + " · " + cEffWord(app.eEff) } ]
                    ],
                cells: View [ width = 100%, datapath = { app.effortModel.value },
                    layout: SimpleLayout [ axis = x, spacing = 4 ],
                    EffortCell [ datapath = :cells[], key = :e ]
                    ]
                ],

            noteBox: View [ width = 100%, padding = [18, 0, 0, 0], datapath = { app.draft.value },
                note: TextInput [ width = 100%, height = 48, fontSize = 16, padding = 12, cornerRadius = 12,
                    fill = #EFEBE3, stroke = { stroke(1, this.focused ? INK : 0xE0DBD0) },
                    placeholder = "Add a note — optional", text <-> :note ]
                ],

            hint: Label [ width = 100%, wrap = true, lineHeight = 1.5, padding = [14, 0, 0, 0], textTransform = none, letterSpacing = 0.2, fontSize = 12,
                visible = { !app.touchDevice },
                text = "R B L S sport · ↑ ↓ time · ← → day · 1–0 effort · Enter saves · Esc closes" ]
            ]
        ],

    // saving is always one tap away and always says exactly what it will save

    actions: View [ y = { parent.height - app.actionH }, width = 100%, height = { app.actionH }, fill = #FBFAF6,
        padding = { [12, 20, 12 + app.safeBottom, 20] },
        rule: View [ x = -20, y = -12, width = { parent.width }, height = 1, fill = #E0DBD0 ],
        err: Text [ y = -38, width = 100%, fontSize = 14, fontWeight = semibold, textColor = #C23A0A, wrap = false,
            visible = { app.saveError != "" }, text = { app.saveError } ],
        save: Btn [ width = 100%, height = 56, strong = true, disabled = { app.busy },
            label = { app.busy ? "Saving…" : "Save  ·  " + app.draftSummary },
            press() { app.save() }
            ]
        ]
    ]


class EffortCell extends Control [ height = 50, width = { (parent.width - 36) / 10 }, cornerRadius = 10,
    fill = { :e <= app.eEff ? cEff(:e) : (this.down ? HAIR : WASH) },
    t: TextLabel [ x = center, fontSize = 16, fontWeight = bold, textColor = { :e <= app.eEff ? cEffInk(:e) : MUTED }, text = { "" + :e } ],
    press() { app.setEffort(:e) },
    onClick() { press() }
    ]


// the round thumb button that starts a new entry

class AddButton extends Control [ width = 68, height = 68, cornerRadius = 34,
    fill = { classroot.down ? 0x000000 : INK },
    shadow = { shadow(0, 8, 22, 0x16140F55) },
    scale = { classroot.down ? 0.94 : 1 },
    pivotX = 34, pivotY = 34,
    draw(d: Draw) {
        d.strokeStyle = 0xFFFFFF
        d.lineWidth = 3
        d.lineCap = "round"
        d.beginPath()
        d.moveTo(34, 22)
        d.lineTo(34, 46)
        d.moveTo(22, 34)
        d.lineTo(46, 34)
        d.stroke()
        },
    press() { app.openEntry() },
    onClick() { press() }
    ]


// ── the app ───────────────────────────────────────────────────────────────

App [ appName = "Cadence", fill = #F2EFE8, textColor = #16140F, minWidth = 320,
    fontFamily = ["SF Pro Display", "system-ui", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"],
    theme = { { ...SanFrancisco, accent: ACCENT, text: INK, textMuted: MUTED, surface: SHEET, line: HAIR, focusRing: INK } },

    // ── the room it is in ──

    narrow: boolean = { app.width < 760 },
    twoCol: boolean = { app.width >= 1000 },
    heroSize: number = { Math.round(Math.max(64, Math.min(118, app.page.now.width / 4.15))) },
    panelW: number = { Math.min(480, app.width) },
    actionH: number = { 80 + app.safeBottom },
    entryH: number = { Math.min(app.hostHeight - 24, 800) },

    heroStyles: object = { {
        Word: { fontSize: app.narrow ? 19 : 22, fontWeight: 600, letterSpacing: 0, textColor: MUTED },
        Unit: { fontSize: Math.round(app.heroSize * 0.5), fontWeight: 800, letterSpacing: -1 },
        Mid: { fontSize: Math.round(app.heroSize * 0.5), fontWeight: 800, letterSpacing: -1, textColor: MUTED } } },
    statStyles: object = { {
        Word: { fontSize: 14, fontWeight: 600, letterSpacing: 0, textColor: MUTED },
        Unit: { fontSize: app.narrow ? 18 : 22, fontWeight: 700, letterSpacing: 0 } } },

    // ── the truth ──

    // The service's frozen "today", and the whole history. `db` is the source
    // *and* the truth: it loads once, and every later save or delete is written
    // into it with the Dataset verbs, so everything derived from it follows.

    todaySrc: DataSource [ url = { API + "/api/today" }, schema = [ today: string ] ],
    db: DataSource [ url = { API + "/api/sessions" }, schema = [ sessions[]: Session ] ],

    todayStr: string = { app.todaySrc.value?.today ?? "" },
    todayN: number = { cDay(app.todayStr) },
    ss: Session[] = { app.db.value?.sessions ?? [] },
    ready: boolean = { app.todaySrc.loaded && app.db.loaded },
    busy: boolean = { app.saveSrc.loading || app.delSrc.loading },

    onInit() {
        this.todaySrc.fetch()
        this.db.fetch()
        this.liveSrc.fetch()
        },

    // Both documents in: aim the year at the latest weeks and land the first
    // figures where they are, so that only later changes travel.

    trackChanges = ["ready"],
    onChange(e: ChangeEvent) {
        for (const c of e.changed) if (c.name == "ready" && c.currentValue) this.adopt()
        },

    adopt() {
        const sessions = this.ss
        const today = this.todayStr
        const len = cSeries(sessions, cDay(today)).len
        this.vSpan = this.narrow ? 56 : 105
        this.vStart = len + 1 - this.vSpan
        const wk = cWeek(sessions, cDay(today))
        this.countShown = wk.count
        this.minShown = wk.min
        this.streakShown = cStreak(sessions, cDay(today))
        const first = cSeries(sessions, cDay(today)).first
        const p = cPeriod(sessions, first + Math.floor(this.vStart + 0.5), cDay(today), cDay(today))
        this.pCountShown = p.count
        this.pMinShown = p.min
        this.pKmShown = p.km
        },

    // the session in progress: re-read every fifth second; its clock runs between reads

    tick: Time [ tick = second,
        onTick() { if (Math.floor(this.now / 1000) % 5 == 0 && !app.liveSrc.loading) app.liveSrc.fetch() }
        ],
    liveAt: number = 0,
    liveSrc: DataSource [ url = { API + "/api/live" }, schema = [ session?: LiveSession ],
        onLoad() { app.liveAt = Date.now() }
        ],
    live: LiveSession = { app.liveSrc.value?.session ?? null },
    liveSecs: number = { app.live == null ? 0 : app.live.startedSecondsAgo + Math.max(0, (app.tick.now - app.liveAt) / 1000) },

    // ── today, derived ──

    weekModel: Dataset [ contents = { cWeek(app.ss, app.todayN) } ],
    weekScale: number = { Math.max(150, (app.weekModel.value as any).peak ?? 0) },
    streak: number = { cStreak(app.ss, app.todayN) },
    lastS: Session = { cLast(app.ss) as Session },

    // the figures travel to their new values rather than cutting

    countShown: number = 0,
    Spring [ attribute = countShown, to = { (app.weekModel.value as any).count ?? 0 }, stiffness = 90, damping = 18 ],
    minShown: number = 0,
    Spring [ attribute = minShown, to = { (app.weekModel.value as any).min ?? 0 }, stiffness = 90, damping = 18 ],
    streakShown: number = 0,
    Spring [ attribute = streakShown, to = { app.streak }, stiffness = 90, damping = 18 ],

    weekHtml: string = { Math.round(app.countShown) + "<span class='Word'> " + (Math.round(app.countShown) == 1 ? "session" : "sessions")
        + " · </span>" + cDurHtml(app.minShown) },
    streakHtml: string = { app.ready && app.streak == 0 ? "<span class='Mid'>no streak</span>"
        : Math.round(app.streakShown) + "<span class='Word'> " + (Math.round(app.streakShown) == 1 ? "day" : "days") + "</span>" },

    // ── the year, derived from two numbers ──

    series: Dataset [ contents = { cSeries(app.ss, app.todayN) } ],
    seriesLen: number = { (app.series.value as any).len ?? 1 },
    sFirst: number = { (app.series.value as any).first ?? 0 },
    maxSpan: number = { app.seriesLen + 4 },

    vStart: number = 0,
    vSpan: number = 91,
    glideStart: Animator [ attribute = vStart, duration = 520, motion = quartOut ],
    glideSpan: Animator [ attribute = vSpan, duration = 520, motion = quartOut ],

    pFrom: number = { app.sFirst + Math.max(0, Math.floor(app.vStart + 0.5)) },
    pTo: number = { app.sFirst + Math.min(app.seriesLen - 1, Math.ceil(app.vStart + app.vSpan - 0.5) - 1) },
    period: Dataset [ contents = { cPeriod(app.ss, app.pFrom, app.pTo, app.todayN) } ],
    periodCount: number = { (app.period.value as any).count ?? 0 },

    pCountShown: number = 0,
    Spring [ attribute = pCountShown, to = { app.periodCount }, stiffness = 120, damping = 20 ],
    pMinShown: number = 0,
    Spring [ attribute = pMinShown, to = { (app.period.value as any).min ?? 0 }, stiffness = 120, damping = 20 ],
    pKmShown: number = 0,
    Spring [ attribute = pKmShown, to = { (app.period.value as any).km ?? 0 }, stiffness = 120, damping = 20 ],
    periodHtml: string = { Math.round(app.pCountShown) + "<span class='Word'> " + (Math.round(app.pCountShown) == 1 ? "session" : "sessions") + " · </span>"
        + cDurHtml(app.pMinShown) + "<span class='Word'> · </span>" + Math.round(app.pKmShown) + "<span class='Unit'> km</span>"
        + "<span class='Word'> · avg\u00A0effort\u00A0</span>" + ((app.period.value as any).eff ?? 0).toFixed(1) },

    // the hand, on the surface

    grabX: number = 0,
    grabStart: number = 0,
    grabW: number = 1,
    pinching: boolean = false,
    pinchSpan: number = 0,
    pinchAnchor: number = 0,

    clampSpan(v: number) -> number { return Math.max(7, Math.min(this.maxSpan, v)) },
    clampStart(v: number, span: number) -> number { return Math.max(-2, Math.min(this.seriesLen + 2 - span, v)) },

    grab(x: number, w: number) {
        this.glideStart.stop()
        this.glideSpan.stop()
        this.grabX = x
        this.grabW = Math.max(1, w)
        this.grabStart = this.vStart
        },
    pan(x: number) {
        if (this.pinching) return
        this.vStart = this.clampStart(this.grabStart - (x - this.grabX) * this.vSpan / this.grabW, this.vSpan)
        },
    pinchBegin(cx: number, w: number) {
        this.glideStart.stop()
        this.glideSpan.stop()
        this.pinching = true
        this.grabW = Math.max(1, w)
        this.pinchSpan = this.vSpan
        this.pinchAnchor = this.vStart + cx / this.grabW * this.vSpan
        },
    pinchTo(scale: number, cx: number) {
        const span = this.clampSpan(this.pinchSpan / Math.max(0.05, scale))
        this.vSpan = span
        this.vStart = this.clampStart(this.pinchAnchor - cx / this.grabW * span, span)
        },
    pinchDone() {
        this.pinching = false
        this.grabX = this.pointerX
        this.grabStart = this.vStart
        },
    wheelAt(x: number, dx: number, dy: number, pinch: boolean, w: number) {
        this.glideStart.stop()
        this.glideSpan.stop()
        if (pinch || Math.abs(dy) > Math.abs(dx)) {
            const fx = x / Math.max(1, w)
            const anchor = this.vStart + fx * this.vSpan
            const span = this.clampSpan(this.vSpan * Math.exp(dy * (pinch ? 0.012 : 0.0025)))
            this.vSpan = span
            this.vStart = this.clampStart(anchor - fx * span, span)
            }
        else this.vStart = this.clampStart(this.vStart + dx * this.vSpan / Math.max(1, w), this.vSpan)
        },
    glideTo(start: number, span: number) {
        const sp = this.clampSpan(span)
        this.glideSpan.stop()
        this.glideStart.stop()
        this.glideSpan.from = this.vSpan
        this.glideSpan.to = sp
        this.glideStart.from = this.vStart
        this.glideStart.to = this.clampStart(start, sp)
        this.glideSpan.start()
        this.glideStart.start()
        },
    zoomTo(span: number) {
        const sp = this.clampSpan(span)
        const end = Math.min(this.seriesLen + 1, this.vStart + this.vSpan)
        const mid = this.vStart + this.vSpan / 2
        this.glideTo(end >= this.seriesLen ? this.seriesLen + 1 - sp : mid - sp / 2, sp)
        },
    toNow() { this.glideTo(this.seriesLen + 1 - this.vSpan, this.vSpan) },
    pickAt(x: number, w: number) {
        const s = this.series.value as any
        if (s == null || !s.len) return
        const pxd = w / this.vSpan
        const at = this.vStart + x / pxd - 0.5
        const reach = Math.max(0.5, 10 / pxd)
        let best = "", dist = 1e9
        for (let i = Math.max(0, Math.floor(at - reach)); i <= Math.min(s.len - 1, Math.ceil(at + reach)); i++) {
            for (const ss of s.days[i]) { const k = Math.abs(i - at); if (k <= reach && k < dist) { dist = k; best = ss.id } }
            }
        if (best != "") this.openDetail(best)
        },

    // ── a session, whole ──

    selId: string = "",
    detailOpen: boolean = false,
    confirmDelete: boolean = false,
    detT: number = 0,
    Spring [ attribute = detT, to = { app.detailOpen ? 1 : 0 }, stiffness = 260, damping = 30 ],
    sel: Session = { app.ss.find(s => s.id == app.selId) ?? null },
    place: object = { cPlace(app.ss, app.selId) },
    placeLine: string = { app.placeText(app.place) },
    placeText(p: object) -> string {
        const q = p as any
        if (!q.ok) return ""
        return "Longer than " + q.longer + "% of your " + q.n + " " + cSport(q.sport).toLowerCase() + "s — the "
            + cOrdinal(q.rank) + " longest. " + (q.harder >= 50 ? "Harder than " + q.harder + "% of everything you have logged."
                : "Easier than " + q.easier + "% of everything you have logged.")
        },

    openDetail(id: string) { this.selId = id; this.confirmDelete = false; this.entryOpen = false; this.detailOpen = true },
    closeDetail() { this.detailOpen = false; this.confirmDelete = false },

    // deleting is a source aimed at the open session; a 404 means it is already gone

    delSrc: DataSource [ method = "DELETE", url = { API + "/api/sessions/" + app.selId },
        onLoad() { app.dropSession(app.selId) },
        trackChanges = { ["failed"] },
        onChange(e: ChangeEvent) { if (this.failed && this.statusCode == 404) app.dropSession(app.selId) }
        ],

    deleteSelected() {
        if (!this.confirmDelete) { this.confirmDelete = true; return }
        if (!this.busy) this.delSrc.fetch()
        },
    dropSession(id: string) {
        const i = this.ss.findIndex(s => s.id == id)
        if (i >= 0) this.db.removeAt(["sessions"], i)
        this.closeDetail()
        },

    // ── recording one ──

    entryOpen: boolean = false,
    entT: number = 0,
    Spring [ attribute = entT, to = { app.entryOpen ? 1 : 0 }, stiffness = 260, damping = 30 ],
    editId: string = "",

    // the draft: what they touched, and otherwise what they usually do

    dSport: string = "run",
    dDay: number = 0,
    dMin: number = 45,
    minTouched: boolean = false,
    dKm: number = 0,
    kmTouched: boolean = false,
    dEffort: number = 5,
    effTouched: boolean = false,
    draft: Dataset { { "note": "" } },

    typ: object = { cTypical(app.ss, app.dSport) },
    eMin: number = { app.minTouched ? app.dMin : (app.typ as any).min },
    eKm: number = { app.dSport == "lift" ? 0 : app.kmTouched ? app.dKm : Math.round((app.typ as any).kmPerMin * app.eMin * 10) / 10 },
    eEff: number = { app.effTouched ? app.dEffort : (app.typ as any).effort },
    eMinShown: number = 45,
    Spring [ attribute = eMinShown, to = { app.eMin }, stiffness = 300, damping = 28 ],
    eKmShown: number = 0,
    Spring [ attribute = eKmShown, to = { app.eKm }, stiffness = 300, damping = 28 ],

    chipModel: Dataset [ contents = { { chips: cChips(app.dSport).map(m => ({ m: m, label: cDur(m) })) } } ],
    effortModel: Dataset { { "cells": [ { "e": 1 }, { "e": 2 }, { "e": 3 }, { "e": 4 }, { "e": 5 },
                                         { "e": 6 }, { "e": 7 }, { "e": 8 }, { "e": 9 }, { "e": 10 } ] } },

    draftSummary: string = { cSport(app.dSport) + " · " + cDur(app.eMin) + (app.dSport == "lift" ? "" : " · " + cKm(app.eKm))
        + " · effort " + app.eEff + (app.dDay == app.todayN ? "" : " · " + cDayWord(app.dDay, app.todayN).toLowerCase()) },

    openEntry() {
        const ss = this.ss
        this.editId = ""
        this.dSport = cLikely(ss, this.todayN)
        this.dDay = this.todayN
        this.minTouched = false
        this.kmTouched = false
        this.effTouched = false
        this.draft.set(["note"], "")
        this.saveSrc.clear()
        this.detailOpen = false
        this.entryOpen = true
        },
    editSelected() {
        const s = this.sel
        if (s == null) return
        this.editId = s.id
        this.dSport = s.sport
        this.dDay = cDay(s.date)
        this.dMin = s.minutes
        this.minTouched = true
        this.dKm = s.distanceKm ?? 0
        this.kmTouched = true
        this.dEffort = s.effort
        this.effTouched = true
        this.draft.set(["note"], s.note ?? "")
        this.saveSrc.clear()
        this.detailOpen = false
        this.entryOpen = true
        },
    closeEntry() { this.entryOpen = false },

    setSport(s: string) { this.dSport = s; this.clearRefusal() },
    shiftDay(k: number) { this.dDay = Math.min(this.todayN, this.dDay + k); this.clearRefusal() },
    clearRefusal() { if (this.saveSrc.failed) this.saveSrc.clear() },
    nudgeMin(k: number) { this.dMin = Math.max(5, this.eMin + k); this.minTouched = true },
    setMin(m: number) { this.dMin = m; this.minTouched = true },
    nudgeKm(k: number) {
        const step = cKmStep(this.dSport)
        this.dKm = Math.max(0, Math.round((this.eKm + k * step) * 10) / 10)
        this.kmTouched = true
        },
    setEffort(e: number) { this.dEffort = e; this.effTouched = true },

    // Saving is one source whose verb, address and payload all derive from the
    // draft: a new session POSTs, a correction PUTs. What it returns is the stored
    // session, written into `db`; what it refuses is shown above the button.

    saveSrc: DataSource [ schema = Session,
        method = { app.editId == "" ? "POST" : "PUT" },
        url = { API + "/api/sessions" + (app.editId == "" ? "" : "/" + app.editId) },
        body = { app.draftBody() },
        onLoad() { app.adoptSaved(this.value, app.editId != "") }
        ],
    draftBody() -> object {
        const note = ("" + ((app.draft.value as any)?.note ?? "")).trim()
        return { sport: app.dSport, date: cStr(app.dDay), minutes: app.eMin,
                 distanceKm: app.dSport == "lift" ? null : app.eKm, effort: app.eEff, note: note == "" ? null : note }
        },
    saveError: string = { !app.saveSrc.failed ? ""
        : app.saveSrc.statusCode == 0 ? "The service didn't answer — try again."
        : (app.saveSrc.errorBody as any)?.message ?? "The service refused that session." },

    save() { if (!this.busy) this.saveSrc.fetch() },
    adoptSaved(s: object, editing: boolean) {
        const rec = s as any
        const ss = this.ss
        if (editing) {
            const i = ss.findIndex(x => x.id == rec.id)
            if (i >= 0) this.db.set(["sessions", i], rec)
            }
        else this.db.insert(["sessions"], 0, rec)
        this.entryOpen = false
        // bring the new or corrected session into view on the surface
        const day = cDay(rec.date) - this.sFirst
        if (day < this.vStart || day > this.vStart + this.vSpan - 1) this.glideTo(day - this.vSpan / 2, this.vSpan)
        },

    // ── the keyboard, for someone at a desk ──

    keys: Keys [
        onKeyDown(e: KeyEvent) { app.handleKey(e.key, e.meta || e.ctrl) }
        ],
    handleKey(k: string, mod: boolean) {
        if (mod) return
        if (this.entryOpen) {
            if (k == "Escape") { this.closeEntry(); return }
            if (k == "Enter") { this.save(); return }
            if (this.layer.entry.body.col.noteBox.note.focused) return
            const lk = k.toLowerCase()
            if (lk == "r") this.setSport("run")
            else if (lk == "b") this.setSport("ride")
            else if (lk == "l") this.setSport("lift")
            else if (lk == "s") this.setSport("swim")
            else if (k == "ArrowUp") this.nudgeMin(5)
            else if (k == "ArrowDown") this.nudgeMin(-5)
            else if (k == "ArrowLeft") this.shiftDay(-1)
            else if (k == "ArrowRight") this.shiftDay(1)
            else if (k >= "0" && k <= "9") this.setEffort(k == "0" ? 10 : Number(k))
            return
            }
        if (this.detailOpen) {
            if (k == "Escape") this.closeDetail()
            else if (k.toLowerCase() == "e") this.editSelected()
            return
            }
        if (k.toLowerCase() == "n") this.openEntry()
        else if (k == "ArrowLeft") this.glideTo(this.vStart - this.vSpan * 0.5, this.vSpan)
        else if (k == "ArrowRight") this.glideTo(this.vStart + this.vSpan * 0.5, this.vSpan)
        else if (k == "-") this.zoomTo(this.vSpan * 1.6)
        else if (k == "=" || k == "+") this.zoomTo(this.vSpan / 1.6)
        },

    // ── the page ──

    page: View [ width = { app.width }, padding = { app.narrow ? [14, 18, 120, 18] : [26, 44, 64, 44] },
        layout: ResponsiveLayout [ gap = 56, plan = { [
            ({ from: 1000, flow: "row", share: ({ now: 36, year: 64 }) }),
            ({ from: 0, flow: "stack", share: ({ now: 100, year: 100 }) }) ] } ],
        now: TodayColumn [ ],
        year: YearColumn [ ]
        ],

    // ── above the page ──

    add: AddButton [ ignoreScroll = true, visible = { app.ready && app.narrow },
        x = { app.hostWidth - 68 - (app.narrow ? 20 : 36) - app.safeRight },
        y = { app.hostHeight - 68 - (app.narrow ? 22 : 36) - app.safeBottom } ],

    layer: View [ ignoreScroll = true, width = { app.hostWidth }, height = { app.hostHeight },
        visible = { app.detT > 0.002 || app.entT > 0.002 },
        scrim: View [ width = 100%, height = 100%, fill = #16140F, opacity = { 0.38 * Math.max(app.detT, app.entT) },
            onClick() { app.closeDetail(); app.closeEntry() }
            ],
        detail: DetailSheet [ ],
        entry: EntrySheet [ ]
        ]
    ]
