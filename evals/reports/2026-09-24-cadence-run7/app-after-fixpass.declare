// ── a session, whole ──────────────────────────────────────────────────────

// where it sits: every session of the same sport on one duration line, this one struck in effort colour

class PlaceStrip extends View [ width = 100%, height = 64,
    draw(d: Draw) {
        const p = app.place as any
        if (!p.ok) return
        const w = d.w, pad = 8
        const xo = (m) => pad + (m - p.lo) / Math.max(1, p.hi - p.lo) * (w - 2 * pad)
        d.fillStyle = HAIR
        d.fillRect(pad, 32, w - 2 * pad, 1)
        d.fillStyle = FAINT
        for (const m of p.mins) {
            d.beginPath()
            d.arc(xo(m), 32, 3.5, 0, Math.PI * 2)
            d.fill()
            }
        const x = xo(p.min)
        d.fillStyle = cEff(p.effort)
        d.beginPath()
        d.arc(x, 32, 9, 0, Math.PI * 2)
        d.fill()
        d.strokeStyle = INK
        d.lineWidth = 2
        d.stroke()
        const mono = { fontSize: 10, fontFamily: MONO, textColor: MUTED }
        d.fillText(cDur(p.lo), pad, 60, mono)
        const hiT = cDur(p.hi)
        d.fillText(hiT, w - pad - measureText(hiT, mono).width, 60, mono)
        }
    ]


class DetailSheet extends View [ clip = true, fill = #FBFAF6,
