/*
# Cadence

A training log: where am I (this week, the streak, the week's shape, the last
session — and a session in progress, if there is one), the whole history as one
surface the hand pushes and pinches, a session seen up close, and recording one
in a few taps.

Ink on paper. One accent, and it means **effort**: every mark of a session is
drawn from the same ramp — pale for an easy hour, the accent for a hard one — so
a hard week, a hard month and a hard session all read at a glance.

The truth is `db` — the service's sessions, held in memory. Everything on screen
derives from it, so a save or a delete is one data write and every figure moves.
*/

schema Session [ id: string, date: string, sport: "run" | "ride" | "lift" | "swim", minutes: number,
    distanceKm?: number, effort: number, heartAvg?: number, note?: string ]

schema LiveSession [ id: string, sport: string, startedSecondsAgo: number, minutes: number,
    distanceKm?: number, heartNow: number, effort: number ]


script {
    const API = "http://127.0.0.1:8320"

    // the palette — ink, paper, and the one accent
    const PAPER = 0xF2EFE8
    const SHEET = 0xFBFAF6
    const INK = 0x16140F
    const MUTED = 0x7A7468
    const FAINT = 0xB9B2A4
    const HAIR = 0xE0DBD0
    const WASH = 0xE9E5DC
    const ACCENT = 0xFF4A12

    const SANS = ["SF Pro Display", "system-ui", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"]
    const MONO = ["SF Mono", "ui-monospace", "Menlo", "Consolas", "monospace"]

    const DAYMS = 86400000
    const DOW = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    const SPORTS = ["run", "ride", "lift", "swim"]

    type S = { id: string, date: string, sport: string, minutes: number, distanceKm?: number | null,
               effort: number, heartAvg?: number | null, note?: string | null }

    // ── dates, as day numbers (days since the epoch, UTC — the person's own dates, no zones) ──

    function cDay(s: string): number {
        if (!s) return 0
        const p = s.split("-").map(Number)
        return Math.round(Date.UTC(p[0], p[1] - 1, p[2]) / DAYMS)
    }
    function cStr(n: number): string { return new Date(n * DAYMS).toISOString().slice(0, 10) }
    function cDow(n: number): number { return (new Date(n * DAYMS).getUTCDay() + 6) % 7 }
    function cDate(n: number): string {
        const d = new Date(n * DAYMS)
        return DOW[cDow(n)] + " " + d.getUTCDate() + " " + MON[d.getUTCMonth()]
    }
    function cDateY(n: number): string { return cDate(n) + " " + new Date(n * DAYMS).getUTCFullYear() }
    function cRel(n: number, today: number): string {
        const k = today - n
        return k == 0 ? "today" : k == 1 ? "yesterday" : k > 1 && k < 7 ? k + " days ago" : cDate(n)
    }
    function cDayWord(n: number, today: number): string {
        const k = today - n
        return k == 0 ? "Today" : k == 1 ? "Yesterday" : DOW[cDow(n)]
    }
    function cRange(a: number, b: number): string {
        const da = new Date(a * DAYMS), db = new Date(b * DAYMS)
        const ya = da.getUTCFullYear(), yb = db.getUTCFullYear()
        const left = da.getUTCDate() + " " + MON[da.getUTCMonth()] + (ya != yb ? " " + ya : "")
        return left + " – " + db.getUTCDate() + " " + MON[db.getUTCMonth()] + " " + yb
    }
    function cSpanWords(days: number): string {
        const d = Math.round(days)
        if (d <= 10) return d + " days"
        if (d < 50) return Math.round(d / 7) + " weeks"
        if (d < 340) return Math.round(d / 30.4) + " months"
        return Math.round(d / 30.4) + " months — everything"
    }

    // ── the house formats ──

    function cDur(m: number): string {
        const t = Math.max(0, Math.round(m)), h = Math.floor(t / 60), r = t % 60
        return h == 0 ? r + "m" : r == 0 ? h + "h" : h + "h " + r + "m"
    }
    // the same duration with its unit letters set small — one run of text
    function cDurHtml(m: number): string {
        const t = Math.max(0, Math.round(m)), h = Math.floor(t / 60), r = t % 60
        const u = (x: string) => "<span class='Unit'>" + x + "</span>"
        return h == 0 ? r + u("m") : r == 0 ? h + u("h") : h + u("h") + "\u00A0" + r + u("m")
    }
    function cKm(k: number): string { return (Math.round(k * 10) / 10).toFixed(1) + " km" }
    function cClock(secs: number): string {
        const s = Math.max(0, Math.floor(secs)), h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60, x = s % 60
        const p = (v: number) => (v < 10 ? "0" : "") + v
        return h > 0 ? h + ":" + p(m) + ":" + p(x) : m + ":" + p(x)
    }
    function cSport(s: string): string { return s == "run" ? "Run" : s == "ride" ? "Ride" : s == "lift" ? "Lift" : s == "swim" ? "Swim" : "" }
    function cPace(s: string, min: number, km: number): string {
        if (!km || km <= 0) return ""
        if (s == "run") { const p = min / km; return Math.floor(p) + ":" + String(Math.round((p % 1) * 60)).padStart(2, "0") + " /km" }
        if (s == "swim") { const p = min / (km * 10); return Math.floor(p) + ":" + String(Math.round((p % 1) * 60)).padStart(2, "0") + " /100m" }
        return (km / (min / 60)).toFixed(1) + " km/h"
    }

    // ── effort: the one accent, as a ramp ──

    function cMix(a: number, b: number, t: number): number {
        const c = (x: number, y: number) => Math.round(x + (y - x) * t)
        return (c((a >> 16) & 255, (b >> 16) & 255) << 16) | (c((a >> 8) & 255, (b >> 8) & 255) << 8) | c(a & 255, b & 255)
    }
    function cEff(e: number): number { return cMix(0xCDC6B8, ACCENT, Math.max(0, Math.min(1, (e - 2) / 6.5))) }
    function cEffInk(e: number): number { return e >= 6 ? 0xFFFFFF : INK }
    function cEffWord(e: number): string {
        return e <= 2 ? "very easy" : e <= 4 ? "easy" : e <= 5 ? "steady" : e <= 7 ? "hard" : e <= 9 ? "very hard" : "all out"
    }

    // ── derivations over the history ──

    function cWeek(ss: S[], today: number) {
        const days = []
        let count = 0, min = 0, peak = 0
        for (let i = 6; i >= 0; i--) {
            const n = today - i
            const on = ss.filter(s => cDay(s.date) == n)
            const m = on.reduce((a, s) => a + s.minutes, 0)
            const e = on.reduce((a, s) => Math.max(a, s.effort), 0)
            count += on.length; min += m; peak = Math.max(peak, m)
            days.push({ key: cStr(n), letter: DOW[cDow(n)].slice(0, 1), min: m, effort: e, n: on.length, today: i == 0,
                        sport: on.length ? cSport(on[0].sport) : "" })
        }
        return { days, count, min, peak }
    }

    function cStreak(ss: S[], today: number): number {
        const have = new Set(ss.map(s => cDay(s.date)))
        let d = have.has(today) ? today : today - 1, n = 0
        while (have.has(d)) { n++; d-- }
        return n
    }

    function cLast(ss: S[]): S | null {
        let best: S | null = null
        for (const s of ss) if (best == null || s.date > best.date || (s.date == best.date && s.id > best.id)) best = s
        return best
    }

    // every day from the Monday before the first session through today, each
    // holding its sessions; and the weekly totals the season view reads
    function cSeries(ss: S[], today: number) {
        let first = today
        for (const s of ss) first = Math.min(first, cDay(s.date))
        first -= cDow(first)
        const len = today - first + 1
        const days: any[] = Array.from({ length: len }, () => [])
        for (const s of ss) {
            const i = cDay(s.date) - first
            if (i >= 0 && i < len) days[i].push({ id: s.id, m: s.minutes, e: s.effort, sp: s.sport })
        }
        const weeks: number[] = []
        for (let i = 0; i < len; i += 7) {
            let t = 0
            for (let k = i; k < Math.min(len, i + 7); k++) for (const x of days[k]) t += x.m
            weeks.push(t)
        }
        return { first, len, days, weeks, maxWeek: Math.max(60, ...weeks) }
    }

    function cPeriod(ss: S[], from: number, to: number, today: number) {
        const inside = ss.filter(s => { const n = cDay(s.date); return n >= from && n <= to })
            .sort((a, b) => a.date < b.date ? 1 : a.date > b.date ? -1 : a.id < b.id ? 1 : -1)
        let min = 0, km = 0, eff = 0
        for (const s of inside) { min += s.minutes; km += s.distanceKm ?? 0; eff += s.effort }
        const rows = inside.map(s => ({
            id: s.id, effort: s.effort, sport: cSport(s.sport),
            when: cRel(cDay(s.date), today) == cDate(cDay(s.date)) ? cDateY(cDay(s.date)) : cRel(cDay(s.date), today) + " · " + cDate(cDay(s.date)),
            summary: cDur(s.minutes) + (s.distanceKm != null ? "  ·  " + cKm(s.distanceKm) : "")
        }))
        return { rows, count: inside.length, min, km, eff: inside.length ? eff / inside.length : 0 }
    }

    function median(xs: number[]): number {
        if (!xs.length) return 0
        const a = [...xs].sort((p, q) => p - q), h = Math.floor(a.length / 2)
        return a.length % 2 ? a[h] : (a[h - 1] + a[h]) / 2
    }

    // what this person usually does in this sport — the defaults a new entry starts from
    function cTypical(ss: S[], sport: string) {
        const xs = ss.filter(s => s.sport == sport).sort((a, b) => a.date < b.date ? 1 : -1).slice(0, 12)
        const min = Math.max(5, Math.round(median(xs.map(s => s.minutes)) / 5) * 5 || 45)
        const withKm = xs.filter(s => s.distanceKm != null && s.minutes > 0)
        const kmPerMin = withKm.length ? median(withKm.map(s => (s.distanceKm as number) / s.minutes)) : 0
        const effort = Math.round(median(xs.map(s => s.effort))) || 5
        return { min, kmPerMin, effort }
    }

    // the sport most likely meant right now: what they usually do on this weekday,
    // else what they have been doing lately
    function cLikely(ss: S[], today: number): string {
        const tally = (list: S[]) => {
            const c: Record<string, number> = {}
            for (const s of list) c[s.sport] = (c[s.sport] ?? 0) + 1
            let best = "", n = 0
            for (const k of SPORTS) if ((c[k] ?? 0) > n) { best = k; n = c[k] }
            return best
        }
        const dow = cDow(today)
        const same = ss.filter(s => { const n = cDay(s.date); return today - n <= 84 && cDow(n) == dow })
        return tally(same) || tally(ss.slice(0, 14)) || "run"
    }

    // where one session sits against the rest
    function cPlace(ss: S[], id: string) {
        const s = ss.find(x => x.id == id)
        if (!s) return { ok: false, mins: [], min: 0, lo: 0, hi: 1, longer: 0, harder: 0, easier: 0, n: 0, sport: "", effort: 0, rank: 0 }
        const same = ss.filter(x => x.sport == s.sport)
        const mins = same.map(x => x.minutes)
        const longer = Math.round(100 * same.filter(x => x.minutes < s.minutes).length / Math.max(1, same.length))
        const harder = Math.round(100 * ss.filter(x => x.effort < s.effort).length / Math.max(1, ss.length))
        const easier = Math.round(100 * ss.filter(x => x.effort > s.effort).length / Math.max(1, ss.length))
        const rank = 1 + same.filter(x => x.minutes > s.minutes).length
        return { ok: true, mins, min: s.minutes, lo: Math.min(...mins), hi: Math.max(...mins), longer, harder, easier,
                 n: same.length, sport: s.sport, effort: s.effort, rank }
    }

    function cOrdinal(n: number): string {
        const t = n % 100, u = n % 10
        return n + (t >= 11 && t <= 13 ? "th" : u == 1 ? "st" : u == 2 ? "nd" : u == 3 ? "rd" : "th")
    }

    function cChips(sport: string): number[] {
        return sport == "ride" ? [45, 60, 90, 120, 180] : sport == "run" ? [30, 45, 60, 75, 90] : [30, 40, 45, 60, 75]
    }
    function cKmStep(sport: string): number { return sport == "swim" ? 0.1 : sport == "run" ? 0.5 : 1 }
    }


// ── small type ────────────────────────────────────────────────────────────

// the one small voice: mono capitals, muted — every caption in the app

class Label extends Text [ fontFamily = ["SF Mono", "ui-monospace", "Menlo", "Consolas", "monospace"],
    fontSize = 11, fontWeight = medium, letterSpacing = 1.3, textTransform = uppercase, textColor = #7A7468, wrap = false
    ]


// a figure over the words that name it

class Fact extends View [
    value: string = "",
    label: string = "",
    big: number = 34,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    v: Text [ fontSize = { classroot.big }, fontWeight = bold, letterSpacing = { -0.03 * classroot.big }, numeralWidth = tabular,
        wrap = false, text = { classroot.value } ],
    l: Label [ text = { classroot.label } ]
    ]


// ── controls ──────────────────────────────────────────────────────────────

// the app's one button shape: ink when it is the thing to do, a wash when it is not

class Btn extends Control [ height = 48, cornerRadius = 12,
    label: string = "",
    strong: boolean = false,
    danger: boolean = false,
    width = { this.t.width + 40 },
    fill = { classroot.strong ? (classroot.down ? 0x000000 : INK) : classroot.danger ? (classroot.down ? 0xFFD9CC : 0xFBE5DC) : classroot.down ? HAIR : classroot.hot ? 0xE4DFD4 : WASH },
    opacity = { classroot.disabled ? 0.4 : 1 },
    t: TextLabel [ x = center, fontSize = 16, fontWeight = semibold, wrap = false,
        textColor = { classroot.strong ? 0xFFFFFF : classroot.danger ? 0xC23A0A : INK }, text = { classroot.label } ],
    onClick() { if (!disabled) press() }
    ]


// a square nudge — − and + — sized for a thumb

class Nudge extends Control [ width = 56, height = 56, cornerRadius = 14,
    sign: number = 1,
    fill = { classroot.down ? HAIR : classroot.hot ? 0xE4DFD4 : WASH },
    opacity = { classroot.disabled ? 0.35 : 1 },
    draw(d: Draw) {
        d.strokeStyle = INK
        d.lineWidth = 2.5
        d.lineCap = "round"
        d.beginPath()
        d.moveTo(20, 28)
        d.lineTo(36, 28)
        if (sign > 0) { d.moveTo(28, 20); d.lineTo(28, 36) }
        d.stroke()
        },
    onClick() { if (!disabled) press() }
    ]


// a chevron step — ‹ and › — for the date

class Step extends Control [ width = 56, height = 56, cornerRadius = 14,
    dir: number = 1,
    fill = { classroot.down ? HAIR : classroot.hot ? 0xE4DFD4 : WASH },
    opacity = { classroot.disabled ? 0.3 : 1 },
    draw(d: Draw) {
        d.strokeStyle = INK
        d.lineWidth = 2.5
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(28 - 4 * dir, 20)
        d.lineTo(28 + 4 * dir, 28)
        d.lineTo(28 - 4 * dir, 36)
        d.stroke()
        },
    onClick() { if (!disabled) press() }
    ]


// a choice among a few — selected is ink, the rest a quiet wash

class Choice extends Control [ height = 52, cornerRadius = 12,
    label: string = "",
    on: boolean = false,
    fill = { classroot.on ? INK : classroot.down ? HAIR : classroot.hot ? 0xE4DFD4 : WASH },
    t: TextLabel [ x = center, fontSize = 16, fontWeight = semibold, wrap = false,
        textColor = { classroot.on ? 0xFFFFFF : INK }, text = { classroot.label } ],
    onClick() { if (!disabled) press() }
    ]


// ── today ─────────────────────────────────────────────────────────────────

// the session in progress — the one inverted block in the app, and the only
// thing that ticks: its clock runs, and its dot beats at the heart rate reported

class LiveBand extends View [ width = 100%, cornerRadius = 18, fill = #16140F, padding = [18, 20, 20, 20],
    beat: Time [ tick = frame, running = { app.live != null } ],
    layout: SimpleLayout [ axis = y, spacing = 4 ],
    head: View [
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        dot: View [ width = 10, height = 10, cornerRadius = 5, fill = #FF4A12,
            opacity = { app.live == null ? 1 : 0.3 + 0.7 * Math.pow(Math.max(0, Math.cos(classroot.beat.now / 60000 * app.live.heartNow * Math.PI)), 6) } ],
        Label [ textColor = #FF4A12, text = { "Recording now · " + cSport(app.live?.sport ?? "") } ]
        ],
    clock: Text [ fontSize = { app.heroSize * (app.narrow ? 0.82 : 0.7) }, fontWeight = 800, letterSpacing = { -0.04 * fontSize }, numeralWidth = tabular,
        textColor = #FBFAF6, wrap = false, text = { cClock(app.liveSecs) } ],
    Text [ fontSize = 20, fontWeight = semibold, textColor = #D9D3C7, numeralWidth = tabular, wrap = false,
        text = { app.live == null ? "" : cKm(app.live.distanceKm ?? 0) + "  ·  " + app.live.heartNow + " bpm  ·  effort " + app.live.effort } ]
    ]


// one day of the week's shape: a bar whose height is the time done that day,
// coloured by the hardest thing in it

class DayBar extends View [ width = { (parent.width - 6 * 8) / 7 }, height = 150,
    barH: number = { Math.min(1, :min / app.weekScale) * (this.height - 50) },
    Spring [ attribute = barH, to = { Math.min(1, :min / app.weekScale) * (classroot.height - 50) }, stiffness = 170, damping = 21 ],
    bar: View [ width = 100%, cornerRadius = 4,
        y = { classroot.height - 24 - Math.max(classroot.barH, 3) },
        height = { Math.max(classroot.barH, 3) },
        fill = { :n > 0 ? cEff(:effort) : HAIR } ],
    mins: Text [ width = 100%, textAlign = center, fontSize = 11, wrap = false, numeralWidth = tabular,
        fontFamily = ["SF Mono", "ui-monospace", "Menlo", "monospace"], textColor = #7A7468,
        y = { classroot.height - 42 - classroot.barH }, text = { :n > 0 ? cDur(:min) : "" } ],
    letter: Text [ width = 100%, textAlign = center, y = { classroot.height - 17 }, fontSize = 12, wrap = false,
        fontFamily = ["SF Mono", "ui-monospace", "Menlo", "monospace"],
        textColor = { :today ? INK : MUTED }, text = :letter,
        isToday: State [ applied = { :today }, fontWeight = bold ]
        ]
    ]


class TodayColumn extends View [
    layout: SimpleLayout [ axis = y, spacing = 0 ],

    head: View [ width = 100%, height = 40,
        Label [ y = 12, textColor = #16140F, fontWeight = bold, text = "Cadence" ],
        Label [ x = end, y = 12, text = { app.todayN > 0 ? cDate(app.todayN) : "" } ]
        ],

    live: LiveBand [ visible = { app.live != null } ],

    // this week — "4 sessions · 3h 40m", figures large and words small, one run

    week: View [ width = 100%, padding = [26, 0, 0, 0],
        layout: SimpleLayout [ axis = y, spacing = 0 ],
        Label [ text = "This week · last 7 days" ],
        HTMLText [ width = 100%, fontSize = { app.heroSize }, fontWeight = 800, letterSpacing = { -0.045 * app.heroSize },
            lineHeight = 1.0, bodyColor = #16140F, textStyles = { app.heroStyles },
            html = { app.weekHtml } ]
        ],

    streak: View [ width = 100%, padding = [18, 0, 0, 0],
        layout: SimpleLayout [ axis = y, spacing = 0 ],
        Label [ text = "Streak" ],
        HTMLText [ width = 100%, fontSize = { app.heroSize }, fontWeight = 800, letterSpacing = { -0.045 * app.heroSize },
            lineHeight = 1.0, bodyColor = #16140F, textStyles = { app.heroStyles },
            html = { app.streakHtml } ]
        ],

    shape: View [ width = 100%, padding = [26, 0, 0, 0],
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        Label [ text = "The week's shape" ],
        bars: View [ width = 100%, datapath = { app.weekModel.value },
            layout: SimpleLayout [ axis = x, spacing = 8 ],
            DayBar [ datapath = :days[], key = :key ]
            ]
        ],

    // the last session — tap it to see it whole

    last: Control [ width = 100%, padding = [26, 0, 18, 0], visible = { app.lastS != null },
        layout: SimpleLayout [ axis = y, spacing = 4 ],
        Label [ text = "Last session" ],
        row: View [
            layout: SimpleLayout [ axis = x, spacing = 12, align = end ],
            Text [ fontSize = 44, fontWeight = 800, letterSpacing = -1.6, wrap = false, text = { cSport(app.lastS?.sport ?? "") } ],
            Text [ fontSize = 18, fontWeight = medium, textColor = #7A7468, wrap = false,
                text = { app.lastS == null ? "" : cRel(cDay(app.lastS.date), app.todayN) } ]
            ],
        line: View [
            layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
            eff: View [ width = 34, height = 34, cornerRadius = 17, fill = { cEff(app.lastS?.effort ?? 1) },
                TextLabel [ x = center, fontSize = 15, fontWeight = bold, textColor = { cEffInk(app.lastS?.effort ?? 1) },
                    text = { "" + (app.lastS?.effort ?? "") } ]
                ],
            Text [ fontSize = 18, fontWeight = medium, numeralWidth = tabular, wrap = false,
                text = { app.lastS == null ? "" : cDur(app.lastS.minutes)
                    + (app.lastS.distanceKm != null ? " · " + cKm(app.lastS.distanceKm) : "")
                    + (app.lastS.heartAvg != null ? " · " + app.lastS.heartAvg + " bpm" : "")
                    + " · " + cEffWord(app.lastS.effort) } ]
            ],
        opacity = { this.down ? 0.6 : 1 },
        onClick() { if (app.lastS != null) app.openDetail(app.lastS.id) }
        ]
    ]


// ── the year ──────────────────────────────────────────────────────────────

/*
The whole history as one surface. Two numbers say what is on screen — `vStart`,
the day at the left edge, and `vSpan`, how many days fit across — and the
drawing, the period title, its totals and the list below all derive from them.
The hand writes those two numbers directly (a drag pans, a pinch or a wheel
zooms about the point under it), so the surface never lags the finger; only a
chosen jump (a zoom chip, "Now") glides.
*/

class YearSurface extends View [ clip = true, cornerRadius = 14, fill = #EBE7DE, claim = x,

    onPointerDown(e: PointerEvent) { app.grab(app.pointerX, this.width) },
    onPointerMove(e: PointerEvent) { app.pan(e.x) },
    onPinchStart(e: PinchEvent) { app.pinchBegin(e.center.x - this.rootTransform().x, this.width) },
    onPinch(e: PinchEvent) { app.pinchTo(e.scale, e.center.x - this.rootTransform().x) },
    onPinchEnd(e: PinchEvent) { app.pinchDone() },
    onWheel(e: WheelEvent) { app.wheelAt(e.x, e.deltaX, e.deltaY, e.pinch, this.width) },
    onClick(e: PointerEvent) { app.pickAt(e.x, this.width) },

    draw(d: Draw) {
        const s = app.series.value as any
        if (s == null || !s.len) return
        const w = d.w, h = d.h
        const span = app.vSpan, start = app.vStart
        const pxd = w / span
        const axisH = 30, top = 30
        const base = h - axisH, plotH = base - top
        const mono = { fontSize: 10, fontFamily: MONO, textColor: MUTED }
        const monoInk = { fontSize: 10, fontFamily: MONO, textColor: INK, fontWeight: 700 }
        const i0 = Math.max(0, Math.floor(start) - 1), i1 = Math.min(s.len - 1, Math.ceil(start + span) + 1)

        // the season: weekly volume, a quiet backdrop that fades out as you zoom in
        const season = Math.max(0, Math.min(1, (span - 28) / 80))
        if (season > 0) {
            d.globalAlpha = season
            d.fillStyle = 0xDCD6CA
            for (let wk = 0; wk < s.weeks.length; wk++) {
                const x0 = (wk * 7 - start) * pxd
                if (x0 > w || x0 + 7 * pxd < 0) continue
                const hh = s.weeks[wk] / s.maxWeek * plotH
                d.fillRect(x0 + 0.5, base - hh, 7 * pxd - 1, hh)
                }
            d.globalAlpha = 1
            }

        // month boundaries and names
        for (let i = i0; i <= i1; i++) {
            const dt = new Date((s.first + i) * DAYMS)
            const x = (i - start) * pxd
            if (dt.getUTCDate() == 1) {
                d.fillStyle = FAINT
                d.fillRect(x, top - 8, 1, base - top + 14)
                const name = MON[dt.getUTCMonth()] + (dt.getUTCMonth() == 0 || pxd > 5 ? " " + dt.getUTCFullYear() : "")
                const tw = measureText(name.toUpperCase(), monoInk).width
                // zoomed in, the axis carries day numbers, so the month's name rides the top of its line
                if (pxd >= 16) d.fillText(name.toUpperCase(), Math.min(x + 5, w - tw - 6), top - 2, monoInk)
                else d.fillText(name.toUpperCase(), Math.min(x + 5, w - tw - 6), base + 18, monoInk)
                }
            if (pxd >= 16 && dt.getUTCDate() == 1) {
                d.fillText("1", x + pxd / 2 - 3, base + 18, monoInk)
                }
            else if (pxd >= 16) {
                d.fillText("" + dt.getUTCDate(), x + pxd / 2 - (dt.getUTCDate() >= 10 ? 6 : 3), base + 18, mono)
                }
            else if (pxd >= 3 && cDow(s.first + i) == 0) {
                d.fillStyle = HAIR
                d.fillRect(x, base, 1, 5)
                }
            }

        // today
        const tx = (s.len - 1 - start) * pxd
        d.fillStyle = INK
        d.fillRect(tx + pxd / 2 - 0.5, top - 14, 1, base - top + 14)
        d.fillText("NOW", tx + pxd / 2 - 24, top - 18, monoInk)

        // the session in progress: an open outline at today, growing as it runs
        if (app.live != null) {
            const lh = Math.max(3, Math.min(1, app.liveSecs / 60 / 180) * plotH)
            const lw = Math.max(1.6, Math.min(pxd * 0.66, 44))
            d.strokeStyle = ACCENT
            d.lineWidth = 1.5
            d.strokeRect((s.len - 1 - start) * pxd + (pxd - lw) / 2, base - lh, lw, lh)
            }

        // sessions: a bar per session, height its duration, colour its effort
        const bw = Math.max(1.6, Math.min(pxd * 0.66, 44))
        const labels = pxd >= 38
        for (let i = i0; i <= i1; i++) {
            const day = s.days[i]
            if (!day.length) continue
            const x = (i - start) * pxd + (pxd - bw) / 2
            let y = base
            for (const ss of day) {
                const hh = Math.max(3, Math.min(1, ss.m / 180) * plotH / (day.length > 1 ? 1.4 : 1))
                d.fillStyle = cEff(ss.e)
                d.fillRect(x, y - hh, bw, hh)
                if (ss.id == app.selId && app.detailOpen) {
                    d.strokeStyle = INK
                    d.lineWidth = 2
                    d.strokeRect(x - 2, y - hh - 2, bw + 4, hh + 4)
                    }
                if (labels) {
                    d.fillText(cSport(ss.sp).toUpperCase() + " " + cDur(ss.m), x, y - hh - 6, mono)
                    }
                y -= hh + 3
                }
            }
        }
    ]


// one session in the list under the surface

class SessionRow extends Control [ width = 100%, height = 64,
    fill = { this.down ? HAIR : this.hot ? 0xECE8DF : PAPER },
    rule: View [ y = { parent.height - 1 }, width = 100%, height = 1, fill = #E0DBD0 ],
