/*
# Presentify: the look

Presentify's identity, kept apart from how it works: the palette, the mark,
the drawn icons, and the small controls every screen is made of. The App lays
`PresentifyTheme` over the library's `SanFrancisco`, so library controls (menus,
buttons, steppers) speak the same colours as ours.

The identity in one breath: a deep violet (`brand`) with a coral and a
sunflower beside it, warm paper for the chrome, a quiet stone backdrop so the
slide is always the brightest thing on screen, Bricolage Grotesque for the
wordmark and headings, Instrument Sans for everything else, and icons drawn
with one round pen.
*/

theme PresentifyTheme [
    // the brand

    brand = #6C4CF1, brandHovered = #5D3DE6, brandPressed = #4C2FCF, brandTint = #EFEBFE, brandInk = #3B2A8C,
    coral = #FF6B4A, sun = #FFC23D, mint = #2FBF8F,

    // the library's roles, in our colours

    accent = #6C4CF1, accentHovered = #5D3DE6, accentPressed = #4C2FCF, accentTextColor = #FFFFFF,
    background = #FBFAF7, surface = #FFFFFF, line = #E7E3DC,
    text = #1E1B2E, textMuted = #676376, textFaint = #9C98A8,
    control = #F2EFEA, controlHovered = #EAE6DF, controlPressed = #E0DBD2, controlSelected = #E6E0FB,
    linkColor = #6C4CF1,
    tooltipFill = #1E1B2E, tooltipTextColor = #F7F5FF,

    // our own surfaces

    chrome = #FBFAF7, chromeEdge = #E7E3DC, backdrop = #E9E6DF, well = #F2EFEA, hover = #F2EFEA,
    danger = #D93D2E, dangerTint = #FDECEA, warn = #B5720B, warnTint = #FFF5E0, ok = #23936B,

    // editing marks: one violet for anything selected, a pink for guides

    selection = #6C4CF1, handleFill = #FFFFFF, guide = #FF2E88, ghostFill = #6C4CF126, marqueeFill = #6C4CF114,

    // slide colours offered by the palette (light to deep, then brights)

    swatches = ["#FFFFFF", "#F6F4EF", "#E9DFC9", "#C9D6DF", "#8C9AA6", "#4A5560", "#1F2328", "#000000",
        "#0E3B43", "#24596F", "#2F6F8F", "#6C4CF1", "#3B2A8C", "#E07A5F", "#FF6B4A", "#D93D2E",
        "#FFC23D", "#F2CC8F", "#81B29A", "#2FBF8F", "#3D9BE9", "#9B5DE5", "#F15BB5", "#FEE440"]
    ]


// ── The mark ────────────────────────────────────────────────────────────────
//
// A slide, tilted forward a touch, with a sun and a play mark on it: making
// a slide and showing it, in one picture.

class PresentifyMark [ width = 28, height = 28,
    draw(d: DrawContext) {
        const s = d.w / 28
        d.scale(s, s)
        d.fillStyle = provided("theme").brand
        d.beginPath(); d.roundRect(2, 4, 24, 20, 6); d.fill()
        d.fillStyle = provided("theme").sun
        d.beginPath(); d.arc(9.5, 11, 3.2, 0, Math.PI * 2); d.fill()
        d.fillStyle = provided("theme").coral
        d.beginPath(); d.moveTo(14, 10); d.lineTo(21.5, 14.5); d.lineTo(14, 19); d.closePath(); d.fill()
        d.fillStyle = 0xFFFFFF
        d.globalAlpha = 0.9
        d.beginPath(); d.roundRect(6.5, 17.5, 5.5, 2, 1); d.fill()
        }
    ]


// The wordmark: the mark and the name.

class Wordmark [ layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    size: number = 22,
    PresentifyMark [ width = { classroot.size * 1.25 }, height = { classroot.size * 1.25 } ],
    Text [ fontFamily = { app.displayFace }, fontSize = { classroot.size }, fontWeight = 780, letterSpacing = -0.4,
        textColor = { provided("theme").text }, text = "Presentify" ]
    ]


// ── Icons ───────────────────────────────────────────────────────────────────
//
// One pen: a 1.6px round stroke on a 16-unit grid (`Icon` scales it). Fills
// only where the shape is a solid thing (the play mark).

class Glyph extends Icon [
    shape: string = "",
    draw(d: DrawContext) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        if (shape == "select") {
            d.moveTo(4, 2.5); d.lineTo(4, 13); d.lineTo(6.8, 10.4); d.lineTo(8.8, 14.2); d.lineTo(10.6, 13.3); d.lineTo(8.7, 9.6); d.lineTo(12.4, 9.4); d.closePath(); d.stroke()
        } else if (shape == "rect") {
            d.roundRect(2.5, 3.5, 11, 9, 1.5); d.stroke()
        } else if (shape == "ellipse") {
            d.ellipse(8, 8, 5.8, 4.8, 0, 0, Math.PI * 2); d.stroke()
        } else if (shape == "line") {
            d.moveTo(3, 13); d.lineTo(13, 3); d.stroke()
        } else if (shape == "text") {
            d.moveTo(3.5, 4.5); d.lineTo(3.5, 3); d.lineTo(12.5, 3); d.lineTo(12.5, 4.5); d.moveTo(8, 3); d.lineTo(8, 13); d.moveTo(6, 13); d.lineTo(10, 13); d.stroke()
        } else if (shape == "undo") {
            d.moveTo(5.5, 3.5); d.lineTo(2.5, 6.5); d.lineTo(5.5, 9.5); d.moveTo(2.5, 6.5); d.lineTo(9.5, 6.5); d.bezierCurveTo(14.5, 6.5, 14.5, 13, 9.5, 13); d.lineTo(6.5, 13); d.stroke()
        } else if (shape == "redo") {
            d.moveTo(10.5, 3.5); d.lineTo(13.5, 6.5); d.lineTo(10.5, 9.5); d.moveTo(13.5, 6.5); d.lineTo(6.5, 6.5); d.bezierCurveTo(1.5, 6.5, 1.5, 13, 6.5, 13); d.lineTo(9.5, 13); d.stroke()
        } else if (shape == "minus") {
            d.moveTo(3, 8); d.lineTo(13, 8); d.stroke()
        } else if (shape == "plus") {
            d.moveTo(8, 3); d.lineTo(8, 13); d.moveTo(3, 8); d.lineTo(13, 8); d.stroke()
        } else if (shape == "duplicate") {
            d.roundRect(5.5, 5.5, 8, 8, 1.5); d.moveTo(10.5, 3.5); d.lineTo(10.5, 3); d.arcTo(10.5, 2.5, 10, 2.5, 0.5); d.lineTo(3.5, 2.5); d.arcTo(2.5, 2.5, 2.5, 3.5, 1); d.lineTo(2.5, 10); d.arcTo(2.5, 10.5, 3, 10.5, 0.5); d.lineTo(3.5, 10.5); d.stroke()
        } else if (shape == "trash") {
            d.moveTo(2.5, 4.5); d.lineTo(13.5, 4.5); d.moveTo(6, 4.5); d.lineTo(6.5, 2.5); d.lineTo(9.5, 2.5); d.lineTo(10, 4.5)
            d.moveTo(4, 4.5); d.lineTo(4.8, 13.5); d.lineTo(11.2, 13.5); d.lineTo(12, 4.5); d.stroke()
        } else if (shape == "play") {
            d.moveTo(5, 3); d.lineTo(13, 8); d.lineTo(5, 13); d.closePath(); d.fill(); d.stroke()
        } else if (shape == "back") {
            d.moveTo(10, 3); d.lineTo(5, 8); d.lineTo(10, 13); d.stroke()
        } else if (shape == "more") {
            for (const x of [3.5, 8, 12.5]) { d.moveTo(x + 1.1, 8); d.arc(x, 8, 1.1, 0, Math.PI * 2) }
            d.fill()
        } else if (shape == "group") {
            d.setLineDash([1.5, 2]); d.roundRect(1.5, 1.5, 13, 13, 2); d.stroke(); d.setLineDash([])
            d.beginPath(); d.roundRect(4, 4, 5, 4, 1); d.moveTo(12, 10.2); d.arc(10, 10.2, 2, 0, Math.PI * 2); d.stroke()
        } else if (shape == "ungroup") {
            d.roundRect(2, 2.5, 6, 5, 1); d.moveTo(14, 10.5); d.arc(11, 10.5, 3, 0, Math.PI * 2); d.stroke()
        } else if (shape.startsWith("align-")) {
            const k = shape.slice(6)
            if (k == "left" || k == "center" || k == "right") {
                const lx = k == "left" ? 2.5 : k == "center" ? 8 : 13.5
                d.moveTo(lx, 1.5); d.lineTo(lx, 14.5); d.stroke(); d.beginPath()
                const a = k == "left" ? 4.5 : k == "center" ? 4 : 5.5, b = k == "left" ? 4.5 : k == "center" ? 5.5 : 9.5
                d.roundRect(a, 3.5, 7, 3.5, 1); d.roundRect(b, 9, 4, 3.5, 1); d.stroke()
            } else {
                const ly = k == "top" ? 2.5 : k == "middle" ? 8 : 13.5
                d.moveTo(1.5, ly); d.lineTo(14.5, ly); d.stroke(); d.beginPath()
                const a = k == "top" ? 4.5 : k == "middle" ? 4 : 5.5, b = k == "top" ? 4.5 : k == "middle" ? 5.5 : 9.5
                d.roundRect(3.5, a, 3.5, 7, 1); d.roundRect(9, b, 3.5, 4, 1); d.stroke()
            }
        } else if (shape == "dist-x") {
            d.moveTo(1.5, 2); d.lineTo(1.5, 14); d.moveTo(14.5, 2); d.lineTo(14.5, 14); d.stroke(); d.beginPath(); d.roundRect(6, 4.5, 4, 7, 1); d.stroke()
        } else if (shape == "dist-y") {
            d.moveTo(2, 1.5); d.lineTo(14, 1.5); d.moveTo(2, 14.5); d.lineTo(14, 14.5); d.stroke(); d.beginPath(); d.roundRect(4.5, 6, 7, 4, 1); d.stroke()
        } else if (shape == "front" || shape == "forward") {
            d.roundRect(2, 2, 7, 7, 1); d.stroke(); d.fillStyle = ink; d.beginPath(); d.roundRect(6.5, 6.5, 7.5, 7.5, 1.2); d.fill()
        } else if (shape == "back-order" || shape == "backward") {
            d.roundRect(6.5, 6.5, 7.5, 7.5, 1.2); d.stroke(); d.beginPath(); d.roundRect(2, 2, 7, 7, 1); d.fill()
        } else if (shape == "link") {
            d.moveTo(7, 9); d.lineTo(9, 7); d.stroke(); d.beginPath()
            d.moveTo(6.2, 5.8); d.lineTo(7.6, 4.4); d.arc(9.8, 6.6, 3.1, -2.36, 0.78); d.lineTo(10.2, 9.8); d.stroke(); d.beginPath()
            d.moveTo(9.8, 10.2); d.lineTo(8.4, 11.6); d.arc(6.2, 9.4, 3.1, 0.78, 3.93); d.lineTo(5.8, 6.2); d.stroke()
        } else if (shape == "check") {
            d.moveTo(3, 8.5); d.lineTo(6.5, 12); d.lineTo(13, 4.5); d.stroke()
        } else if (shape == "cloud-off") {
            d.moveTo(4.5, 12.5); d.bezierCurveTo(1, 12.5, 1, 7.5, 4.5, 7.5); d.bezierCurveTo(5, 3.5, 11, 3, 12, 7); d.bezierCurveTo(15.5, 7.5, 15, 12.5, 11.5, 12.5); d.closePath(); d.stroke()
            d.beginPath(); d.moveTo(2, 2); d.lineTo(14, 14); d.stroke()
        } else if (shape == "cloud") {
            d.moveTo(4.5, 12.5); d.bezierCurveTo(1, 12.5, 1, 7.5, 4.5, 7.5); d.bezierCurveTo(5, 3.5, 11, 3, 12, 7); d.bezierCurveTo(15.5, 7.5, 15, 12.5, 11.5, 12.5); d.closePath(); d.stroke()
        } else if (shape == "panel") {
            d.roundRect(1.5, 2.5, 13, 11, 2); d.moveTo(10, 2.5); d.lineTo(10, 13.5); d.stroke()
        } else if (shape == "slides") {
            d.roundRect(1.5, 2.5, 13, 11, 2); d.moveTo(6, 2.5); d.lineTo(6, 13.5); d.stroke()
        } else if (shape == "none") {
            d.arc(8, 8, 5.5, 0, Math.PI * 2); d.moveTo(4.1, 11.9); d.lineTo(11.9, 4.1); d.stroke()
        } else if (shape == "warning") {
            d.moveTo(8, 2); d.lineTo(14.5, 13.5); d.lineTo(1.5, 13.5); d.closePath(); d.stroke(); d.beginPath()
            d.moveTo(8, 6.5); d.lineTo(8, 9.5); d.moveTo(8, 11.6); d.lineTo(8, 11.7); d.stroke()
        } else if (shape == "rename") {
            d.moveTo(3, 13); d.lineTo(3.6, 10.4); d.lineTo(11, 3); d.lineTo(13, 5); d.lineTo(5.6, 12.4); d.closePath(); d.stroke()
        } else if (shape == "italic") {
            d.moveTo(7, 3); d.lineTo(12, 3); d.moveTo(4, 13); d.lineTo(9, 13); d.moveTo(9.5, 3); d.lineTo(6.5, 13); d.stroke()
        } else if (shape.startsWith("talign-")) {
            const k = shape.slice(7)
            const rows = [[2.5, 13.5], k == "left" ? [2.5, 10] : k == "center" ? [4.5, 11.5] : [6, 13.5], [2.5, 13.5], k == "left" ? [2.5, 8.5] : k == "center" ? [5.5, 10.5] : [7.5, 13.5]]
            rows.forEach((r, i) => { d.moveTo(r[0], 3.5 + i * 3); d.lineTo(r[1], 3.5 + i * 3) })
            d.stroke()
        } else if (shape == "close") {
            d.moveTo(4, 4); d.lineTo(12, 12); d.moveTo(12, 4); d.lineTo(4, 12); d.stroke()
        }
        }
    ]


// ── Small controls ──────────────────────────────────────────────────────────
//
// Everything a person presses is a `Control`: focus, Space and Enter, and
// `disabled` come with it; each use site writes its own `press()`. Each says
// what it does to a pointer resting on it (`tooltipLabel`) and to a screen
// reader (`accessibilityLabel`).

// A square icon button, quiet until hovered; `on` lights it in the brand.

class IconButton extends Control [ width = 34, height = 34, cornerRadius = 9,
    shape: string = "",
    label: string = "",
    hint: string = "",                // the shortcut, shown in the tip
    on: boolean = false,
    size: number = 17,
    accessibilityLabel = { classroot.label },
    accessibilityPressed = { classroot.on },
    tooltipLabel = { classroot.hint == "" ? classroot.label : classroot.label + "  " + classroot.hint },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    opacity = { disabled ? 0.35 : 1 },
    State [ applied = { classroot.on }, fill = { provided("theme").brandTint } ],
    Glyph [ x = center, y = center, iconSize = { classroot.size }, weight = 1.7, shape = { classroot.shape },
        ink = { classroot.on ? provided("theme").brand : provided("theme").text } ]
    ]


// One of the drawing tools: a radio in the toolbar's group of them, so a
// screen reader hears "one of five" and the arrows move between them.

class ToolChoice extends IconButton [
    choice: string = "",
    accessibilityRole = radio,
    accessibilityChecked = { classroot.on },
    on = { (parent as RadioGroup).value == classroot.choice },
    press() { (parent as RadioGroup).pick(classroot.choice) }
    ]


// A pill button with a glyph and words: the toolbar's main actions.

class PillButton extends Control [ height = 34, cornerRadius = 17, padding = [0, 14, 0, 11],
    label: string = "",
    shape: string = "",
    primary: boolean = false,
    hint: string = "",
    accessibilityLabel = { classroot.label },
    tooltipLabel = { classroot.hint },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : provided("theme").control },
    State [ applied = { classroot.primary },
        fill = { pressed ? provided("theme").brandPressed : hovered ? provided("theme").brandHovered : provided("theme").brand } ],
    opacity = { disabled ? 0.4 : 1 },
    layout: SimpleLayout [ axis = x, spacing = 7, align = center ],
    Glyph [ visible = { classroot.shape != "" }, iconSize = 15, weight = 1.8, shape = { classroot.shape },
        ink = { classroot.primary ? 0xFFFFFF : provided("theme").text } ],
    TextLabel [ fontSize = 14, fontWeight = semibold, wrap = false,
        textColor = { classroot.primary ? 0xFFFFFF : provided("theme").text }, text = { classroot.label } ]
    ]


// A colour, shown as a chip; "none" is a chip with a slash. Pressing it
// opens the palette.

class ColorChip [ width = 22, height = 22, cornerRadius = 6,
    color: string = "",
    mixed: boolean = false,
    fill = { classroot.color == "" || classroot.mixed ? provided("theme").surface : app.paint(classroot.color) },
    stroke = { stroke(1, 0x1E1B2E2E) },
    Glyph [ x = center, y = center, iconSize = 14, weight = 1.5, shape = "none", visible = { classroot.color == "" && !classroot.mixed },
        ink = { provided("theme").danger } ],
    TextLabel [ x = center, fontSize = 12, fontWeight = bold, visible = { classroot.mixed },
        textColor = { provided("theme").textMuted }, text = "–" ]
    ]


class ColorButton extends Control [ height = 32, cornerRadius = 8, padding = [0, 10, 0, 5],
    color: string = "",
    mixed: boolean = false,
    label: string = "",
    accessibilityLabel = { classroot.label },
    tooltipLabel = { classroot.label },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : provided("theme").control },
    opacity = { disabled ? 0.4 : 1 },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    ColorChip [ color = { classroot.color }, mixed = { classroot.mixed } ],
    TextLabel [ fontSize = 13, wrap = false, textColor = { provided("theme").text },
        text = { classroot.mixed ? "Mixed" : classroot.color == "" ? "None" : classroot.color } ]
    ]


// One swatch in the palette.

class Swatch extends Control [ width = 26, height = 26, cornerRadius = 7,
    color: string = "",
    chosen: boolean = false,
    accessibilityLabel = { classroot.color },
    accessibilityPressed = { classroot.chosen },
    fill = { app.paint(classroot.color) },
    stroke = { classroot.chosen ? stroke(2, provided("theme").brand) : stroke(1, 0x1E1B2E24) },
    scale = { pressed ? 0.9 : hovered ? 1.08 : 1 },
    pivotX = 13, pivotY = 13
    ]


// A section of the inspector: a heading, then its rows.

class Section [ width = 100%, padding = [16, 16, 16, 16],
    stroke = { [null, null, stroke(1, provided("theme").line), null] },
    heading: string = "",
    defaultPlacement = body,
    layout: SimpleLayout [ axis = y, spacing = 9 ],
    Text [ fontSize = 11, fontWeight = bold, letterSpacing = 0.8, textTransform = uppercase,
        textColor = { provided("theme").textFaint }, text = { classroot.heading } ],
    body: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 8 ]
        ]
    ]


// A labelled row in the inspector: the label at the left, the control after.

class Row [ width = 100%, height = 30,
    label: string = "",
    defaultPlacement = slot,
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    TextLabel [ width = 64, fontSize = 13, textColor = { provided("theme").textMuted }, text = { classroot.label } ],
    slot: View [ flexes = true, height = 32,
        layout: SimpleLayout [ axis = x, spacing = 6, align = center ]
        ]
    ]


// A pop-up button: the current choice and a chevron; its menu opens under it.

class MenuButton extends Control [ height = 30, cornerRadius = 7, padding = [0, 8, 0, 10],
    label: string = "",
    accessibilityLabel = { classroot.label },
    fill = { pressed || menuOpen ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : provided("theme").control },
    opacity = { disabled ? 0.4 : 1 },
    layout: SimpleLayout [ axis = x, spacing = 6, align = center ],
    TextLabel [ flexes = true, fontSize = 13, wrap = false, maxLines = 1, textColor = { provided("theme").text }, text = { classroot.label } ],
    ChevronIcon [ iconSize = 11, ink = { provided("theme").textMuted } ]
    ]


// A thin upright rule between groups of toolbar buttons.

class Rule [ width = 1, height = 22, fill = { provided("theme").line } ]
