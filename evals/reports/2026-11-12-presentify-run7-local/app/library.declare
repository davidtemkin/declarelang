/*
# Presentify: the presentations

The first screen: every presentation, most recently changed first, each a
card with its first slide, its title and when it was last changed. A card
opens its presentation (which grows out of the card, see the App's
`editorFrame`); its ⋯ menu, or a right-click, renames or deletes it.
*/

// Cards in as many equal columns as fit, each as tall as a 16:9 cover and
// its caption.

class CardGrid extends Layout [
    minCard: number = 250,
    gap: number = 24,
    place() {
        const w = this.contentExtent("width")
        const cols = Math.max(1, Math.floor((w + this.gap) / (this.minCard + this.gap)))
        const cw = (w - (cols - 1) * this.gap) / cols
        const ch = cw * 9 / 16 + 64
        return this.laid().map((c, i) => ({ x: (i % cols) * (cw + this.gap), y: Math.floor(i / cols) * (ch + this.gap), w: cw, h: ch }))
        }
    ]


class DeckCard [
    did: string = { :id ?? "" },
    title: string = { :title ?? "" },
    name: string = { classroot.title == "" ? "Untitled presentation" : classroot.title },

    // Its cover: the first slide, read again whenever the deck has changed.

    cover: DataSource [ url = { app.api + "/api/slides/" + (:thumbnailSlideId ?? "") + "?at=" + encodeURIComponent(:updatedAt ?? "") },
        autoFetch = true, schema = ServerSlide ],

    menuFor(at: View) { app.menuDeck = did; app.menuTitle = title; app.deckMenu.showFor(at) },
    onContextMenu(e: PointerEvent) { app.menuDeck = did; app.menuTitle = title; app.deckMenu.showAt(this, e) },

    // The card opens its presentation; the ⋯ beside the caption is its own
    // button, not part of the card's.

    opener: Control [ width = 100%, height = 100%, cornerRadius = 14,
        accessibilityLabel = { "Open " + classroot.name },
        press() { app.openDeck(classroot.did, this.coverFrame) },
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        coverFrame: View [ width = 100%, height = { this.width * 9 / 16 }, cornerRadius = 12, clip = true,
            fill = { provided("theme").raised },
            stroke = { parent.focused && parent.focusVisible ? stroke(2.5, provided("theme").accent) : stroke(1, provided("theme").line) },
            shadow = { parent.hovered ? provided("theme").shadowLift : provided("theme").shadowRest },
            SlideThumb [ width = 100%, visible = { classroot.cover.loaded }, datapath = { classroot.cover.value } ],
            Shimmer [ width = 100%, height = 100%, visible = { !classroot.cover.loaded }, active = { !classroot.cover.loaded } ]
            ],
        caption: View [ width = 100%, padding = [0, 44, 0, 4],
            layout: SimpleLayout [ axis = y, spacing = 3 ],
            Text [ width = 100%, maxLines = 1, fontSize = 15, fontWeight = 650, textColor = { provided("theme").text },
                text = { classroot.name } ],
            Text [ width = 100%, maxLines = 1, fontSize = 12.5, textColor = { provided("theme").textMuted },
                text = { whenEdited(:updatedAt ?? "", app.clock.now) + " · " + (:slideCount ?? 0) + ((:slideCount ?? 0) == 1 ? " slide" : " slides") } ]
            ]
        ],
    more: IconBtn [ x = { parent.width - this.width }, y = { parent.width * 9 / 16 + 14 },
        shape = "more", label = { "More for " + classroot.name },
        press() { classroot.menuFor(this) }
        ]
    ]


// A placeholder that breathes while a cover or a list is on its way.

class Shimmer [ cornerRadius = 10,
    t: number = 0,
    active: boolean = true,         // breathing only while it is what's shown
    Time [ tick = frame, running = { classroot.active },
        onTick(dt: number) { classroot.t = (classroot.t + dt / 1400) % 1 }
        ],
    fill = { provided("theme").quiet },
    opacity = { 0.55 + 0.45 * Math.abs(Math.sin(this.t * Math.PI)) }
    ]


// What the empty list shows: a small stack of slides, about to begin.

class EmptyArt [ width = 220, height = 150,
    draw(d: DrawContext) {
        const th = provided("theme")
        d.fillStyle = th.accentTint
        d.beginPath(); d.roundRect(46, 18, 150, 96, 12); d.fill()
        d.fillStyle = th.sparkTint
        d.beginPath(); d.roundRect(26, 32, 150, 96, 12); d.fill()
        d.fillStyle = 0xFFFFFF
        d.shadowColor = 0x1B18302A; d.shadowBlur = 18; d.shadowOffsetY = 8
        d.beginPath(); d.roundRect(8, 46, 160, 100, 12); d.fill()
        d.shadowBlur = 0; d.shadowOffsetY = 0
        d.fillStyle = th.accent
        d.beginPath(); d.roundRect(26, 66, 70, 10, 5); d.fill()
        d.fillStyle = th.line
        d.beginPath(); d.roundRect(26, 86, 120, 7, 3.5); d.roundRect(26, 100, 96, 7, 3.5); d.fill()
        d.fillStyle = th.spark
        d.beginPath(); d.arc(166, 46, 15, 0, Math.PI * 2); d.fill()
        d.fillStyle = 0xFFFFFF
        d.beginPath(); d.moveTo(161, 39); d.lineTo(173, 46); d.lineTo(161, 53); d.closePath(); d.fill()
        }
    ]


class Library [ scrolls = y, fill = { provided("theme").background },
    count: number = { app.decks.value?.decks.length ?? 0 },
    howMany: string = { classroot.count + (classroot.count == 1 ? " presentation" : " presentations") + ", most recently changed first" },
    summary: string = { !app.decks.loaded ? "Gathering your work…" : classroot.count == 0 ? "Nothing here yet." : classroot.howMany },
    layout: SimpleLayout [ axis = y, align = center ],

    bar: View [ width = { Math.min(1240, parent.width - 72) }, height = 76,
        layout: SimpleLayout [ axis = x, align = center ],
        Wordmark [ big = true ],
        Spacer [ ],
        PillBtn [ height = 40, cornerRadius = 12, padding = [0, 18, 0, 14], shape = "plus", label = "New presentation", tone = "spark",
            press() { app.newDeck(this) }
            ]
        ],

    page: View [ width = { Math.min(1240, parent.width - 72) }, padding = [24, 0, 64, 0],
        layout: SimpleLayout [ axis = y, spacing = 26 ],
        intro: View [ width = 100%,
            layout: SimpleLayout [ axis = y, spacing = 6 ],
            Text [ fontFamily = { app.brandFace }, fontSize = 38, fontWeight = 800, letterSpacing = -1,
                textColor = { provided("theme").text }, accessibilityRole = heading, text = "Your presentations" ],
            Text [ fontSize = 15, textColor = { provided("theme").textMuted }, text = { classroot.summary } ]
            ],

        grid: View [ width = 100%, visible = { app.decks.loaded && classroot.count > 0 }, datapath = { app.decks.value },
            layout: CardGrid [ ],
            DeckCard [ datapath = :decks[] ]
            ],

        // On the way.

        waiting: View [ width = 100%, visible = { !app.decks.loaded && !app.decks.failed },
            layout: CardGrid [ ],
            Shimmer [ active = { !app.decks.loaded } ],
            Shimmer [ active = { !app.decks.loaded } ],
            Shimmer [ active = { !app.decks.loaded } ],
            Shimmer [ active = { !app.decks.loaded } ]
            ],

        // Nothing yet.

        empty: View [ width = 100%, visible = { app.decks.loaded && classroot.count == 0 }, padding = [40, 0, 0, 0],
            layout: SimpleLayout [ axis = y, spacing = 14, align = center ],
            EmptyArt [ ],
            Text [ fontFamily = { app.brandFace }, fontSize = 24, fontWeight = 750, textColor = { provided("theme").text },
                text = "Your first presentation starts here" ],
            Text [ width = 380, textAlign = center, fontSize = 14.5, textColor = { provided("theme").textMuted },
                text = "Start one, draw a few shapes, type a title. Everything saves as you go." ],
            PillBtn [ height = 40, cornerRadius = 12, padding = [0, 18, 0, 14], shape = "plus", label = "New presentation", tone = "spark",
                press() { app.newDeck(this) }
                ]
            ],

        // Couldn't reach the service.

        failed: View [ width = 100%, visible = { !app.decks.loaded && app.decks.failed }, padding = [40, 0, 0, 0],
            layout: SimpleLayout [ axis = y, spacing = 12, align = center ],
            Glyph [ iconSize = 34, weight = 1.6, shape = "cloudOff", ink = { provided("theme").textMuted } ],
            Text [ fontFamily = { app.brandFace }, fontSize = 22, fontWeight = 750, textColor = { provided("theme").text },
                text = "Can't reach your presentations" ],
            Text [ width = 400, textAlign = center, fontSize = 14.5, textColor = { provided("theme").textMuted },
                text = "The Presentify service isn't answering. Your presentations are safe there; try again in a moment." ],
            PillBtn [ label = "Try again", tone = "accent",
                press() { app.decks.fetch() }
                ]
            ]
        ]
    ]
