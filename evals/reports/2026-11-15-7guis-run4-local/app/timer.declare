/*
# 4. Timer

Elapsed time `elapsed` and a duration `duration`, both in seconds. The clock
runs exactly while elapsed < duration — that is its `running` gate, a
constraint — and each frame adds the step it reports, capped at the duration.
So raising the slider past the elapsed time starts it again, lowering it
below stops it with the gauge full, and Reset only has to write zero: the
gate opens on its own. It also waits while its task isn't the one shown, so
a person who opens it later finds it running from where they left it.
*/

class TimerTask [ width = 360,
    elapsed: number = 0,
    duration: number = 15,
    maxDuration: number = 30,

    clock: Time [ tick = frame, running = { classroot.visible && classroot.elapsed < classroot.duration },
        onTick(dt: number) { classroot.elapsed = Math.min(classroot.duration, classroot.elapsed + dt) }
        ],

    layout: SimpleLayout [ axis = y, spacing = 12 ],

    gaugeRow: View [ width = 100%,
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        Text [ width = 100, text = "Elapsed time" ],
        ProgressBar [ flexes = true, accessibilityLabel = "Elapsed time",
            min = 0, max = { Math.max(classroot.duration, 0.001) },
            value = { Math.min(classroot.elapsed, classroot.duration) } ]
        ],
    seconds: Text [ padding = [0, 0, 0, 110], numeralWidth = tabular,
        text = { classroot.elapsed.toFixed(1) + " s" } ],

    durationRow: View [ width = 100%,
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        Text [ width = 100, text = "Duration" ],
        Slider [ flexes = true, accessibilityLabel = "Duration", min = 0, max = { classroot.maxDuration }, step = 0.1,
            value = { classroot.duration },
            commit(v: number) { classroot.duration = v }
            ],
        Text [ width = 52, textAlign = end, numeralWidth = tabular, text = { classroot.duration.toFixed(1) + " s" } ]
        ],

    Button [ width = 100%, label = "Reset",
        onClick() { classroot.elapsed = 0 }
        ]
    ]
