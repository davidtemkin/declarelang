/*
# Ledger: the data

The shapes the service answers in, and `Books`: the one class that talks to
the service about anything but a read of the filtered figures. It holds the
lookups every screen names things by (categories, channels, products,
contacts, today), the data's revision, and every write.

**The revision.** Every read of the books puts `v=<rev>` in its URL. A write
that lands bumps `rev`, so every source showing the books re-reads them: the
list, the totals, the charts. Nothing calls a refresh; a read's address names
the version of the data it shows, and the version changed.

**Writes and undo.** Each kind of write is its own `DataSource`, so writes of
different kinds never cancel one another. A write that lands reports its
`changeId` to `changed()`, which bumps the revision and remembers the change
for Undo; the toast and ⌘Z both undo the last one.
*/

// ── Shapes the service answers in ───────────────────────────────────────

schema Category [ id: string, name: string, kind: "income" | "expense", colour: number, archived: boolean ]
schema Channel [ id: string, name: string ]
schema Product [ id: string, name: string, price: number, unitCost: number, archived: boolean ]
schema Contact [ id: string, name: string, type: "customer" | "vendor", usualCategoryId?: string,
    transactionCount: number, lastDate?: string ]

schema Summary [ count: number, in: number, out: number, net: number ]
schema Split [ parts: number, categoryIds[]: string ]

// One transaction as a row of the list. `inFilter` is the signed amount it
// counts for under the filter (a split's parts in the filtered categories).

schema Txn [ id: string, kind: "sale" | "refund" | "expense", date: string, description: string,
    contactId?: string, contactName?: string, categoryId?: string, split?: Split, channel?: string,
    amount: number, signed: number, inFilter: number, lineCount: number, refundOf?: string, refunded?: number ]
schema TxnPage [ total: number, summary: Summary, rows[]: Txn ]

schema TxnLine [ id: string, productId?: string, description: string, quantity: number, unitPrice: number,
    amount: number, unitCost?: number, refunded?: number, refundedQuantity?: number,
    refundable?: number, refundableQuantity?: number, saleLineId?: string ]
schema Part [ categoryId: string, amount: number ]
schema RefundRef [ id: string, date: string, amount: number, description: string ]
schema SaleRef [ id: string, date: string, description: string, amount: number, channel?: string ]

// One transaction in full: its lines or parts, and what it is linked to.

schema TxnDetail [ id: string, kind: "sale" | "refund" | "expense", date: string, description: string,
    contactId?: string, contactName?: string, categoryId?: string, channel?: string,
    amount: number, signed: number, refundOf?: string, refunded?: number,
    parts[]?: Part, lines[]: TxnLine, refunds[]?: RefundRef, sale?: SaleRef,
    refundable?: number, cost?: number, margin?: number ]
schema Saved [ transaction: TxnDetail, changeId: string ]

schema Measure [ amount: number, count: number ]
schema Margin [ amount: number, percent?: number, count: number ]
schema Period [ period: string, start: string, end: string, from: string, to: string, partial: boolean,
    revenue: Measure, sales: Measure, refunds: Measure, expenses: Measure, net: Measure,
    cogs: number, grossMargin: Margin ]
schema PeriodTotal [ revenue: Measure, sales: Measure, refunds: Measure, expenses: Measure, net: Measure,
    cogs: number, grossMargin: Margin ]
schema Periods [ by: string, from: string, to: string, periods[]: Period, total: PeriodTotal ]

schema CatAgg [ categoryId?: string, amount: number, count: number ]
schema CatAggs [ side: string, categories[]: CatAgg, total: Measure ]
schema ProdAgg [ productId?: string, units: number, revenue: number, cost: number, margin: number,
    marginPercent?: number, count: number ]
schema ProdAggs [ products[]: ProdAgg ]
schema ContactAgg [ contactId?: string, contactName?: string, amount: number, count: number ]
schema ContactAggs [ side: string, contacts[]: ContactAgg, total: Measure ]
schema Bucket [ min: number, max?: number, count: number ]
schema Amounts [ buckets[]: Bucket, count: number, lowest?: number, highest?: number ]
schema CatCount [ categoryId?: string, count: number ]
schema CatCounts [ categories[]: CatCount, total: number ]
schema Budget [ categoryId: string, amount: number, spent: number, remaining: number, count: number ]
schema Budgets [ month: string, from: string, to: string, budgets[]: Budget ]

schema Problem [ field?: string, message: string, remaining?: number ]
schema Refusal [ error: string, message: string, problems[]?: Problem ]

// ── Where the user is looking: the one filter every screen shares ───────
//
// `preset` names a date range ("this-month"…, "all") that follows today, or
// "custom" for `from`/`to` as written. Amounts are cents; `max` null is "no
// upper limit". `products` is set only by opening a product's figure.

schema Filter [ preset: string, from: string, to: string, compare: "previous" | "year" | "none",
    q: string, min?: number, max?: number,
    kinds[]: string, cats[]: string, contacts[]: string, products[]: string ]

schema Range [ from: string, to: string ]

// A choice in a picker: what it is, and what it says.

schema Choice [ id: string, label: string ]

// A budget to set: in a queue, since several go one after another.

schema BudgetPlan [ month: string, categoryId: string, amount?: number ]

// A name that already exists comes back with the contact it names.

schema Conflict [ error: string, contact?: Contact ]

// What Undo needs: the change, and the sentence that said what it did.

schema Change [ id: string, said: string ]


// ── The books ────────────────────────────────────────────────────────────

class Books extends Node [

    api: string = "http://127.0.0.1:8370",

    // the version of the data every read names (see the header)

    rev: number = 0,
    v: string = { "v=" + this.rev },

    // ── lookups

    clock: DataSource [ url = { classroot.api + "/api/today" }, autoFetch = true, schema = [ today: string ] ],
    cats: DataSource [ url = { classroot.api + "/api/categories?" + classroot.v }, autoFetch = true,
        schema = [ categories[]: Category ] ],
    chans: DataSource [ url = { classroot.api + "/api/channels" }, autoFetch = true, schema = [ channels[]: Channel ] ],
    prods: DataSource [ url = { classroot.api + "/api/products?" + classroot.v }, autoFetch = true,
        schema = [ products[]: Product ] ],
    people: DataSource [ url = { classroot.api + "/api/contacts?" + classroot.v }, autoFetch = true,
        schema = [ contacts[]: Contact ] ],

    lookups() -> DataSource[] { return [this.clock, this.cats, this.chans, this.prods, this.people] },
    ready: boolean = { this.lookups().every((s) => s.loaded) },
    failed: boolean = { this.lookups().some((s) => s.failed) },
    retry() { for (const s of this.lookups()) if (!s.loaded) s.fetch() },

    // ── what the owner hears: each a method the App's instance writes

    say(sentence: string, undoable: boolean) { },      // a change landed, or didn't
    patched(id: string) { },                           // one transaction's edit was saved
    patchRefused(id: string, why: Refusal?) { },       // …or refused
    bulkLanded() { },                                  // a bulk change was made

    today: string = { this.clock.value?.today ?? "" },

    // the first day there are books for: the history is two years up to today

    first: string = { this.today == "" ? "" : addDays(addMonths(this.today, -24), 1) },

    categories() -> Category[] { return this.cats.value?.categories ?? [] },
    channels() -> Channel[] { return this.chans.value?.channels ?? [] },
    products() -> Product[] { return this.prods.value?.products ?? [] },
    contacts() -> Contact[] { return this.people.value?.contacts ?? [] },

    category(id: string?) -> Category? { return id == null ? null : this.categories().find((c) => c.id == id) ?? null },

    // each category's stable colour index, by id: the same colour everywhere

    colours: object = { Object.fromEntries(this.categories().map((c) => [c.id, c.colour])) },
    colourOf(id: string?) -> number { return id == null ? 10 : (this.colours[id] ?? 10) },
    categoryName(id: string?) -> string { return id == null ? "Uncategorised" : this.category(id)?.name ?? id },
    expenseCategories() -> Category[] { return this.categories().filter((c) => c.kind == "expense" && !c.archived) },
    incomeCategories() -> Category[] { return this.categories().filter((c) => c.kind == "income" && !c.archived) },
    channelName(id: string?) -> string { return id == null ? "" : this.channels().find((c) => c.id == id)?.name ?? id },
    product(id: string?) -> Product? { return id == null ? null : this.products().find((p) => p.id == id) ?? null },
    productName(id: string?) -> string { return id == null ? "Other items" : this.product(id)?.name ?? id },
    contact(id: string?) -> Contact? { return id == null ? null : this.contacts().find((c) => c.id == id) ?? null },
    contactName(id: string?) -> string { return id == null ? "No contact" : this.contact(id)?.name ?? id },

    // ── changes, and undoing them

    lastChange: Change? = null,

    // A write landed: every read re-reads, and the change can be undone.

    changed(changeId: string?, said: string) {
        rev = rev + 1
        if (changeId == null) return
        lastChange = ({ id: changeId, said: said })
        this.say(said, true)
        },

    undoing: Change? = null,
    undoWrite: DataSource [ method = "POST",
        url = { classroot.undoing == null ? "" : classroot.api + "/api/changes/" + classroot.undoing.id + "/undo" },
        onLoad() {
            classroot.rev = classroot.rev + 1
            classroot.say("Undone: " + (classroot.undoing?.said ?? "the last change"), false)
            classroot.undoing = null
            },
        onError() {
            const why = (this.errorBody as Refusal)?.message ?? this.error
            classroot.say("Couldn’t undo — " + why, false)
            classroot.undoing = null
            }
        ],
    canUndo: boolean = { this.lastChange != null && !this.undoWrite.loading },

    undo() {
        if (lastChange == null) return
        undoing = lastChange
        lastChange = null
        undoWrite.fetch()
        },

    // ── one transaction's fields, changed in place
    //
    // `patching` names the record and carries the fields; a refusal stays on
    // `patchProblem` until the next try, so the row can say it wasn't saved.

    patching: object = null,
    patchId: string = "",
    patchWrite: DataSource [ method = "PATCH",
        url = { classroot.patchId == "" ? "" : classroot.api + "/api/transactions/" + classroot.patchId },
        body = { classroot.patching },
        schema = Saved,
        onLoad() {
            const id = classroot.patchId
            classroot.patchId = ""
            classroot.patched(id)
            classroot.changed(this.value?.changeId ?? null, "Saved " + (this.value?.transaction?.description ?? "the change"))
            },
        onError() { classroot.patchRefused(classroot.patchId, this.errorBody as Refusal) }
        ],

    patch(id: string, fields: object) {
        patchId = id
        patching = fields
        patchWrite.fetch()
        },

    // ── many at once: categorise, set contact, delete

    bulkBody: object = null,
    bulkSaid: string = "",
    bulkWrite: DataSource [ method = "POST", url = { classroot.api + "/api/transactions/bulk" },
        body = { classroot.bulkBody },
        schema = [ action: string, matched: number, count: number, changeId?: string ],
        onLoad() {
            const n = this.value?.count ?? 0
            const said = classroot.bulkSaid.replace("{n}", count(n) + " transaction" + (n == 1 ? "" : "s"))
            if (n == 0) { classroot.say("Nothing to change — they already were.", false); classroot.rev = classroot.rev + 1; return }
            classroot.changed(this.value?.changeId ?? null, said)
            classroot.bulkLanded()
            },
        onError() {
            const refusal = this.errorBody as Refusal
            classroot.say("Not changed — " + (refusal?.message ?? this.error), false)
            classroot.rev = classroot.rev + 1
            }
        ],

    // `said` is the toast's sentence, with {n} for how many changed.

    bulk(body: object, said: string) {
        bulkBody = body
        bulkSaid = said
        bulkWrite.fetch()
        },

    // ── a new contact, made on the spot from what was typed

    contactBody: object = null,
    contactWrite: DataSource [ method = "POST", url = { classroot.api + "/api/contacts" },
        body = { classroot.contactBody }, schema = Contact ],

    // ── budgets

    budgetBody: object = null,
    budgetAt: string = "",
    budgetFailed: boolean = false,
    budgetWrite: DataSource [ method = "PUT",
        url = { classroot.budgetAt == "" ? "" : classroot.api + "/api/budgets/" + classroot.budgetAt },
        body = { classroot.budgetBody },
        onLoad() { classroot.budgetFailed = false; classroot.nextBudget() },
        onError() {
            classroot.budgetFailed = true
            }
        ],

    setBudget(month: string, categoryId: string, cents: number?) {
        this.queueBudgets([({ month: month, categoryId: categoryId, amount: cents ?? undefined })])
        },

    // several at once go one after another: a later fetch would stop an earlier one

    budgetQueue: BudgetPlan[] = [],
    queueBudgets(items: BudgetPlan[]) {
        const idle = budgetQueue.length == 0 && !budgetWrite.loading
        budgetQueue = [...budgetQueue, ...items]
        if (idle) this.nextBudget()
        },
    nextBudget() {
        if (budgetQueue.length == 0) { rev = rev + 1; return }
        const b = budgetQueue[0]
        budgetQueue = budgetQueue.slice(1)
        budgetAt = b.month + "/" + b.categoryId
        budgetBody = ({ amount: b.amount ?? null })
        budgetWrite.fetch()
        },
    retryBudget() { budgetWrite.fetch() }
    ]
