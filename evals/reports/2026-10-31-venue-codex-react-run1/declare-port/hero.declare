// The Codex React Venue's header and hero, ported to Declare to see what it takes.

style Accent [ textColor = #A43B27, italic = true ]

class Eyebrow extends Text [ fontSize = 10, letterSpacing = 1.9, fontWeight = 600 ]

// an arch's face: a rounded top over a square foot, the size of the arch it is part of

class ArchFace [ width = { parent.width }, height = { parent.height },
    cornerRadius = { [width / 2, width / 2, 0, 0] }
    ]


// an arch, turned as a whole: its stacked offset faces are the CSS's box-shadows

class Arch [ rotation = -13, pivotX = { width / 2 }, pivotY = { height / 2 } ]

class Poster [ clip = true, fill = #A8402C, textColor = #F2D9AF,
    accessibilityRole = image, accessibilityLabel = "Abstract theatrical artwork: red curtains framing an illuminated arch",
    curtain: View [ width = 100%, height = 100%,
        fill = { gradient("110deg", stop(0, 0x491D17), stop(0.21, 0xB64D32), stop(0.28, 0x6D231B), stop(0.40, 0xAE472C),
            stop(0.51, 0x6D231B), stop(0.65, 0xBC5435), stop(0.84, 0x562017), stop(1, 0x913723)) } ],
    back: Arch [ x = { parent.width * 0.22 }, y = { parent.height + 25 - 360 }, width = { parent.width * 0.6 }, height = 360,
        ArchFace [ x = -44, y = -18, fill = #5F2419 ],
        ArchFace [ x = -32, y = -12, fill = #C36640 ],
        ArchFace [ x = -16, y = -5, fill = #491E16 ],
        ArchFace [ fill = #D39D63 ]
        ],
    front: Arch [ x = { parent.width * 0.34 }, y = { parent.height + 25 - 285 }, width = { parent.width * 0.38 }, height = 285,
        ArchFace [ x = -22, y = -10, fill = #E6BB7C ],
        ArchFace [ x = -11, y = -5, fill = #8A442B ],
        ArchFace [ fill = { gradient("110deg", 0xF5DFAB, 0xD9AC6C) } ]
        ],
    floor: View [ x = { -parent.width * 0.2 }, y = { parent.height + 42 - 113 }, width = { parent.width * 1.45 }, height = 113,
        rotation = -13, pivotX = { width / 2 }, pivotY = { height / 2 }, fill = #AE7647,
        draw(d: DrawContext) { d.fillStyle = "#51271C"; for (let x = 0; x < this.width; x += 50) d.fillRect(x, 0, 3, this.height) }
        ],
    Text [ x = 26, y = 24, fontSize = 10, letterSpacing = 2, text = "A LITTLE CHAOS.\nA LOT OF MOZART." ],
    View [ x = 26, y = end, padding = [0, 0, 25, 0],
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        Text [ fontFamily = { app.playfair }, fontSize = 48, letterSpacing = 1, text = "FIGARO" ],
        Text [ fontSize = 8, letterSpacing = 3, text = "THE GRAND HALL" ]
        ],
    View [ x = { parent.width - 24 - 73 }, y = 24, width = 73, height = 73, cornerRadius = 36.5, stroke = { stroke(1, 0xDCB58B) },
        Text [ x = center, y = center, fontSize = 9, textAlign = center, text = "13 NOV\n—\n16 DEC" ]
        ],

    // the weave over everything: near-vertical threads, 13 apart

    View [ width = 100%, height = 100%, opacity = 0.16,
        draw(d: DrawContext) {
            d.strokeStyle = "#36170E"; d.lineWidth = 2
            const lean = this.height * Math.tan(2 * Math.PI / 180)
            for (let x = -lean; x < this.width; x += 13) { d.beginPath(); d.moveTo(x, 0); d.lineTo(x + lean, this.height); d.stroke() }
            }
        ]
    ]


App [ fill = #F5F3ED, textColor = #282820, fontSize = 15,
    dm: Font [ FontFace [ src = "https://fonts.gstatic.com/s/dmsans/v17/rP2Yp2ywxg089UriI5-g4vlH9VoD8Cmcqbu0-K6z9mXg.woff2", weight = range(400, 700) ]
        ],
    playfair: Font [
        FontFace [ src = "https://fonts.gstatic.com/s/playfairdisplay/v40/nuFiD-vYSZviVYUb_rj3ij__anPXDTzYgEM86xQ.woff2", weight = range(400, 600) ],
        FontFace [ src = "https://fonts.gstatic.com/s/playfairdisplay/v40/nuFkD-vYSZviVYUb_rj3ij__anPXDTnogkk7yRZrPA.woff2", weight = range(400, 600), italic = true ]
        ],
    fontFamily = { [app.dm, "sans-serif"] },
    padding = { [0, app.width * 0.05, 0, app.width * 0.05] },
    layout: SimpleLayout [ axis = y ],

    header: View [ width = 100%, height = 96, stroke = { [null, null, stroke(1, 0xDCD9CF), null] },
        layout: SimpleLayout [ axis = x, align = center ],
        wordmark: View [ layout: SimpleLayout [ axis = x, align = baseline, spacing = 5 ],
            Text [ fontSize = 24, fontWeight = 700, letterSpacing = -1.3, text = "THE VENUE" ],
            Text [ fontSize = 13, textColor = #A43B27, text = "●" ]
            ],
        Spacer [ ],
        Text [ fontSize = 10, letterSpacing = 2, text = "A SEASON TO BE HERE · 2026 / 27" ],
        Spacer [ ],
        Text [ fontSize = 14, text = "Sign in  ↗" ]
        ],

    hero: View [ width = 100%, padding = [65, 0, 62, 0],
        layout: SimpleLayout [ axis = x, align = center, spacing = { app.width * 0.064 } ],
        copy: View [ flexes = 1.1,
            layout: SimpleLayout [ axis = y ],
            Eyebrow [ text = "OPERA · WOLFGANG AMADEUS MOZART" ],
            View [ height = 25 ],
            title: HTMLText [ width = 100%, fontFamily = { app.playfair }, fontSize = { Math.min(80, Math.max(42, app.width * 0.056)) },
                letterSpacing = -2.8, lineHeight = 1.08, html = "The Marriage<br>of <span class='Accent'>Figaro.</span>" ],
            View [ height = 25 ],
            Text [ fontSize = 15, lineHeight = 1.8, textColor = #696B60, text = "One house. One wedding.\nA glorious tangle of hearts." ],
            View [ height = 36 ],
            View [ layout: SimpleLayout [ axis = x, spacing = 14, align = baseline ],
                Text [ fontSize = 11, text = "Grand Hall" ],
                Text [ fontSize = 11, textColor = #A43B27, text = "·" ],
                Text [ fontSize = 11, text = "3h 10m" ],
                Text [ fontSize = 11, textColor = #A43B27, text = "·" ],
                Text [ fontSize = 11, text = "2026 / 27 season" ]
                ]
            ],
        poster: Poster [ flexes = 1, height = 440 ]
        ]
    ]
