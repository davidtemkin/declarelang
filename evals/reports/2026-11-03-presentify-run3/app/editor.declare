/*
# Presentify: the editor

The screen a presentation is edited on: the slides down the left, the slide
being edited in the middle (the stage), the inspector on the right, and the bar
across the top.

- **`Gesture`** is the pointer on the stage, as a class with no view: what a
  press began (a move, a marquee, a drawing, a resize), where it began, and
  what the slide was then. It writes the slide live through `Doc.live` and makes
  one step of history when the pointer lifts.
- **`Stage`** shows the slide at the size that fits, and turns presses into
  slide points for the gesture. The selection's frame and handles, the snapping
  guides and the text field for typing in place are drawn over it in the
  stage's own coordinates, so nothing on the slide itself takes the pointer.
- **`SlideList`** is the slides in order, as live pictures. A tile is dragged
  to reorder; the others hold still until it lands, then glide to their places.
- **`Inspector`** shows and changes the selection's style, or the slide's
  background when nothing is selected. Its sections never move: what doesn't
  apply to the selection is dimmed, so the panel keeps its shape.
*/

// ── The pointer on the stage ────────────────────────────────────────────────
//
// Every position here is in slide points. `mode` is what the press began:
//   pending   pressed on something; a move once the pointer travels
//   move      dragging the selection
//   marquee   dragging out a box on bare slide
//   draw      dragging out a new shape with a drawing tool
//   resize    dragging one of the selection's handles
//   radius    dragging a rectangle's corner-radius knob
//   end1/end2 dragging one end of a line

schema Box [ x: number, y: number, w: number, h: number ]

class Gesture extends Node [
    mode: string = "",
    sx: number = 0,
    sy: number = 0,
    k: number = 1,
    startEls: El[] = [],
    box0: Box = { ({ x: 0, y: 0, w: 0, h: 0 }) },
    handle: string = "",
    keep: boolean = false,
    baseSel: string[] = [],
    drawId: string = "",
    hitId: string = "",
    guidesX: number[] = [],
    guidesY: number[] = [],
    marquee: Box? = null,

    els() -> El[] { return app.doc.elementsOf(app.currentKey) },

    // A press on the stage, at slide point (px, py).

    down(px: number, py: number, k: number, shift: boolean) {
        app.finishEditing()
        this.k = k
        this.sx = px
        this.sy = py
        this.startEls = this.els()
        this.guidesX = []
        this.guidesY = []
        if (app.tool != "select") {
            this.mode = "draw"
            this.drawId = freshId(allIds(this.startEls))
            app.doc.begin(app.currentKey)
            return
        }
        const path = hitPath(this.startEls, px, py, 5 / k)
        if (path.length == 0) {
            if (!shift) { app.scope = ""; app.select([]) }
            this.baseSel = shift ? app.selection : []
            this.mode = "marquee"
            this.marquee = ({ x: px, y: py, w: 0, h: 0 })
            return
        }
        const id = app.pick(path)
        this.hitId = id
        if (shift) {
            app.select(app.selection.includes(id) ? app.selection.filter((s) => s != id) : [...app.selection, id])
            if (!app.selection.includes(id)) { this.mode = ""; return }
        } else if (!app.selection.includes(id)) app.select([id])
        this.mode = "pending"
        this.box0 = boundsOfIds(this.startEls, app.selection)
        app.doc.begin(app.currentKey)
        },

    // A press on one of the selection's handles.

    grab(which: string, k: number) {
        app.finishEditing()
        this.k = k
        this.startEls = this.els()
        this.box0 = boundsOfIds(this.startEls, app.selection)
        this.handle = which
        this.guidesX = []
        this.guidesY = []
        const items = app.selection.map((id) => findEl(this.startEls, id)).filter((e) => e != null)
        this.keep = items.length > 0 && items.every((e) => keepsProportions(e))
        this.mode = which == "radius" ? "radius" : which == "end1" || which == "end2" ? which : "resize"
        app.doc.begin(app.currentKey)
        },

    // The pointer has travelled (dx, dy) slide points since the press.

    move(dx: number, dy: number, shift: boolean) {
        if (this.mode == "pending" && Math.hypot(dx, dy) * this.k > 3) this.mode = "move"
        if (this.mode == "move") this.moving(dx, dy, shift)
        else if (this.mode == "marquee") this.marqueeTo(dx, dy, shift)
        else if (this.mode == "draw") this.drawing(dx, dy, shift)
        else if (this.mode == "resize") this.resizing(dx, dy, shift)
        else if (this.mode == "radius") this.rounding(dx)
        else if (this.mode == "end1" || this.mode == "end2") this.ending(dx, dy, shift)
        },

    up(canceled: boolean) {
        const m = this.mode
        this.mode = ""
        this.guidesX = []
        this.guidesY = []
        this.marquee = null
        if (canceled) { app.doc.cancelLive(); return }
        if (m == "pending") {
            // A click on something already in a larger selection picks it alone.
            if (app.selection.length > 1 && this.hitId != "" && !Keys.isDown("ShiftLeft") && !Keys.isDown("ShiftRight")) app.select([this.hitId])
            app.doc.end("", app.selection)
        } else if (m == "move") app.doc.end("Move", app.selection)
        else if (m == "resize" || m == "end1" || m == "end2") app.doc.end("Resize", app.selection)
        else if (m == "radius") app.doc.end("Corner Radius", app.selection)
        else if (m == "draw") this.finishDrawing()
        },

    // ── moving, with snapping
    //
    // The moving box's left, centre and right (and top, middle, bottom) snap
    // to the slide's edges and centre and to everything else's, within six
    // screen pixels; the lines it lands on show as guides.

    moving(dx0: number, dy0: number, shift: boolean) {
        let dx = dx0, dy = dy0
        if (shift) { if (Math.abs(dx) > Math.abs(dy)) dy = 0; else dx = 0 }
        const b = this.box0
        const tol = 6 / this.k
        const sxn = snapAxis([b.x + dx, b.x + dx + b.w / 2, b.x + dx + b.w], snapTargets(this.startEls, app.selection, "x"), tol)
        const syn = snapAxis([b.y + dy, b.y + dy + b.h / 2, b.y + dy + b.h], snapTargets(this.startEls, app.selection, "y"), tol)
        if (!(shift && dx == 0)) dx = dx + sxn.d
        if (!(shift && dy == 0)) dy = dy + syn.d
        this.guidesX = shift && dx0 == 0 ? [] : sxn.guides
        this.guidesY = shift && dy0 == 0 ? [] : syn.guides
        const fx = round(dx), fy = round(dy)
        app.doc.live(updateEach(this.startEls, app.selection, (e) => translate(e, fx, fy)))
        },

    marqueeTo(dx: number, dy: number, shift: boolean) {
        const x0 = Math.min(this.sx, this.sx + dx), y0 = Math.min(this.sy, this.sy + dy)
        const box = ({ x: x0, y: y0, w: Math.abs(dx), h: Math.abs(dy) })
        this.marquee = box
        const hit = idsTouching(this.startEls, box, app.scope)
        app.select(shift ? [...this.baseSel, ...hit.filter((id) => !this.baseSel.includes(id))] : hit)
        },

    // ── drawing a new shape

    drawn(dx: number, dy: number, shift: boolean, click: boolean) -> El {
        const kind = app.tool
        const id = this.drawId
        const st = app.style
        if (kind == "line") {
            let ex = dx, ey = dy
            if (click) { ex = 240; ey = 0 }
            else if (shift) {
                const a = Math.round(Math.atan2(ey, ex) / (Math.PI / 4)) * (Math.PI / 4)
                const len = Math.hypot(ex, ey)
                ex = Math.cos(a) * len; ey = Math.sin(a) * len
            }
            return ({ id: id, kind: "line", x1: round(this.sx), y1: round(this.sy), x2: round(this.sx + ex), y2: round(this.sy + ey),
                stroke: ({ color: st.line, width: 4 }) })
        }
        let w = Math.abs(dx), h = Math.abs(dy)
        if (shift) { const m = Math.max(w, h); w = m; h = m }
        let x = dx < 0 ? this.sx - w : this.sx
        let y = dy < 0 ? this.sy - h : this.sy
        if (click) {
            w = kind == "text" ? 420 : 200
            h = kind == "text" ? 60 : 200
            x = kind == "text" ? this.sx : this.sx - w / 2
            y = kind == "text" ? this.sy - 30 : this.sy - h / 2
        }
        const box = ({ x: round(x), y: round(y), width: round(Math.max(w, 1)), height: round(Math.max(h, 1)) })
        if (kind == "text") {
            return ({ id: id, kind: "text", ...box, width: round(Math.max(w, 60)), keepProportions: false,
                text: ({ content: "", font: st.font, size: st.size, weight: 400, italic: false, color: st.ink, align: "left" }) })
        }
        if (kind == "ellipse") {
            return ({ id: id, kind: "ellipse", ...box, fill: st.fill, stroke: null, keepProportions: shift })
        }
        return ({ id: id, kind: "rect", ...box, fill: st.fill, stroke: null, cornerRadius: 0, keepProportions: shift })
        },

    drawing(dx: number, dy: number, shift: boolean) {
        app.doc.live([...this.startEls, this.drawn(dx, dy, shift, false)])
        this.lastDx = dx
        this.lastDy = dy
        this.lastShift = shift
        },
    lastDx: number = 0,
    lastDy: number = 0,
    lastShift: boolean = false,

    finishDrawing() {
        const click = Math.hypot(this.lastDx, this.lastDy) * this.k < 4
        const kind = app.tool
        const el = this.drawn(click ? 0 : this.lastDx, click ? 0 : this.lastDy, this.lastShift, click)
        this.lastDx = 0
        this.lastDy = 0
        app.doc.live([...this.startEls, el])
        app.tool = "select"
        if (kind == "text") {
            // A new text box starts empty, ready to type in. It becomes a step
            // when typing ends, and vanishes if nothing was typed.
            app.select([el.id])
            app.startTyping(el.id, true)
        } else {
            app.doc.end("Draw " + app.toolName(kind), [el.id])
        }
        },

    // ── resizing
    //
    // The handle's edges follow the pointer; the opposite edges stay. Keeping
    // proportions scales the other side with it (about the middle, from an
    // edge handle). Shift lets proportions go when they are kept, and keeps
    // them when they aren't.

    resizing(dx: number, dy: number, shift: boolean) {
        const b = this.box0
        const h = this.handle
        const keep = this.keep != shift
        const tol = 6 / this.k
        let x0 = b.x, y0 = b.y, x1 = b.x + b.w, y1 = b.y + b.h
        if (h.includes("l")) x0 = x0 + dx
        if (h.includes("r")) x1 = x1 + dx
        if (h.includes("t")) y0 = y0 + dy
        if (h.includes("b")) y1 = y1 + dy
        // snap the edges that move
        const tx = snapTargets(this.startEls, app.selection, "x"), ty = snapTargets(this.startEls, app.selection, "y")
        this.guidesX = []
        this.guidesY = []
        if (!keep) {
            if (h.includes("l")) { const s = snapAxis([x0], tx, tol); x0 = x0 + s.d; this.guidesX = s.guides }
            if (h.includes("r")) { const s = snapAxis([x1], tx, tol); x1 = x1 + s.d; this.guidesX = s.guides }
            if (h.includes("t")) { const s = snapAxis([y0], ty, tol); y0 = y0 + s.d; this.guidesY = s.guides }
            if (h.includes("b")) { const s = snapAxis([y1], ty, tol); y1 = y1 + s.d; this.guidesY = s.guides }
        }
        let w = x1 - x0, hh = y1 - y0
        if (keep && b.w > 0 && b.h > 0) {
            const ratio = b.w / b.h
            const horiz = h.includes("l") || h.includes("r")
            const vert = h.includes("t") || h.includes("b")
            if (horiz && vert) {
                const s = Math.max(Math.abs(w) / b.w, Math.abs(hh) / b.h)
                const nw = b.w * s * Math.sign(w || 1), nh = b.h * s * Math.sign(hh || 1)
                if (h.includes("l")) x0 = x1 - nw; else x1 = x0 + nw
                if (h.includes("t")) y0 = y1 - nh; else y1 = y0 + nh
            } else if (horiz) {
                const nh = Math.abs(w) / ratio
                const cy = b.y + b.h / 2
                y0 = cy - nh / 2; y1 = cy + nh / 2
            } else {
                const nw = Math.abs(hh) * ratio
                const cx = b.x + b.w / 2
                x0 = cx - nw / 2; x1 = cx + nw / 2
            }
            w = x1 - x0
            hh = y1 - y0
        }
        const to = ({ x: Math.min(x0, x1), y: Math.min(y0, y1), w: Math.max(1, Math.abs(w)), h: Math.max(1, Math.abs(hh)) })
        app.doc.live(updateEach(this.startEls, app.selection, (e) => remap(e, b, to)))
        },

    rounding(dx: number) {
        const id = app.selection[0] ?? ""
        const e = findEl(this.startEls, id)
        if (e == null || e.kind != "rect") return
        const max = Math.min(e.width ?? 0, e.height ?? 0) / 2
        const r0 = Math.min(e.cornerRadius ?? 0, max)
        const r = Math.round(Math.max(0, Math.min(max, r0 + dx)))
        app.doc.live(updateEl(this.startEls, id, (x) => ({ ...x, cornerRadius: r })))
        },

    ending(dx: number, dy: number, shift: boolean) {
        const id = app.selection[0] ?? ""
        const e = findEl(this.startEls, id)
        if (e == null || e.kind != "line") return
        const first = this.mode == "end1"
        const ax = first ? (e.x2 ?? 0) : (e.x1 ?? 0), ay = first ? (e.y2 ?? 0) : (e.y1 ?? 0)
        let px = (first ? (e.x1 ?? 0) : (e.x2 ?? 0)) + dx, py = (first ? (e.y1 ?? 0) : (e.y2 ?? 0)) + dy
        if (shift) {
            const a = Math.round(Math.atan2(py - ay, px - ax) / (Math.PI / 4)) * (Math.PI / 4)
            const len = Math.hypot(px - ax, py - ay)
            px = ax + Math.cos(a) * len
            py = ay + Math.sin(a) * len
        } else {
            const tol = 6 / this.k
            const s1 = snapAxis([px], snapTargets(this.startEls, [id], "x"), tol)
            const s2 = snapAxis([py], snapTargets(this.startEls, [id], "y"), tol)
            px = px + s1.d; py = py + s2.d
            this.guidesX = s1.guides
            this.guidesY = s2.guides
        }
        const fx = round(px), fy = round(py)
        app.doc.live(updateEl(this.startEls, id, (x) => first ? ({ ...x, x1: fx, y1: fy }) : ({ ...x, x2: fx, y2: fy })))
        }
    ]


// ── A handle on the selection ───────────────────────────────────────────────
//
// A white dot ringed in the accent, on a larger target that is easy to hit.
// The pointer shows what it does before anything is pressed.

class Handle [ width = 22, height = 22,
    which: string = "",
    k: number = 1,
    cursor = { classroot.which == "radius" ? "ew-resize" : classroot.which == "end1" || classroot.which == "end2" ? "crosshair"
        : classroot.which == "t" || classroot.which == "b" ? "ns-resize" : classroot.which == "l" || classroot.which == "r" ? "ew-resize"
        : classroot.which == "tl" || classroot.which == "br" ? "nwse-resize" : "nesw-resize" },
    onPointerDown(e: PointerEvent) { app.g.grab(classroot.which, classroot.k) },
    onPointerMove(e: PointerEvent) { if (app.g.mode != "") app.g.move(e.deltaX / classroot.k, e.deltaY / classroot.k, e.shift) },
    onPointerUp(e: PointerUpEvent) { app.g.up(e.canceled) },
    dot: View [ x = center, y = center, width = { classroot.which == "radius" ? 11 : 10 }, height = { this.width },
        cornerRadius = { classroot.which == "radius" ? 2 : this.width / 2 },
        rotation = { classroot.which == "radius" ? 45 : 0 }, pivotX = { this.width / 2 }, pivotY = { this.height / 2 },
        fill = { classroot.which == "radius" ? provided("theme").coral : provided("theme").halo },
        stroke = { stroke(1.6, classroot.which == "radius" ? provided("theme").halo : provided("theme").handle) },
        shadow = { shadow(0, 1, 3, 0x1E1A2E40) },
        scale = { classroot.hovered || app.g.handle == classroot.which && app.g.mode != "" ? 1.25 : 1 } ]
    ]


// ── The stage ───────────────────────────────────────────────────────────────

class Stage [ clip = true,
    fill = { provided("theme").stage },
    pad: number = 44,
    slideW: number = { Math.max(160, Math.min(this.width - 2 * classroot.pad, (this.height - 2 * classroot.pad - 24) * 16 / 9)) },
    slideH: number = { classroot.slideW * 9 / 16 },
    k: number = { classroot.slideW / 1280 },
    ox: number = { Math.round((this.width - classroot.slideW) / 2) },
    oy: number = { Math.round((this.height - classroot.slideH) / 2) },

    // slide points ↔ stage pixels

    sx(v: number) -> number { return classroot.ox + v * classroot.k },
    sy(v: number) -> number { return classroot.oy + v * classroot.k },

    cursor = { app.tool != "select" ? (app.tool == "text" ? "text" : "crosshair")
        : app.g.mode == "move" ? "grabbing" : app.hoverId != "" ? "move" : "default" },

    onPointerDown(e: PointerEvent) {
        Focus.blur()
        app.g.down((e.x - this.ox) / this.k, (e.y - this.oy) / this.k, this.k, e.shift)
        },
    onPointerMove(e: PointerEvent) {
        if (app.g.mode != "") app.g.move(e.deltaX / this.k, e.deltaY / this.k, e.shift)
        else app.hoverAt((e.x - this.ox) / this.k, (e.y - this.oy) / this.k, this.k)
        },
    onPointerUp(e: PointerUpEvent) { app.g.up(e.canceled) },
    onPointerOut() { app.hoverId = "" },
    onDblClick(e: PointerEvent) { app.dive((e.x - this.ox) / this.k, (e.y - this.oy) / this.k, this.k) },
    onContextMenu(e: PointerEvent) {
        const px = (e.x - this.ox) / this.k, py = (e.y - this.oy) / this.k
        const path = hitPath(app.els, px, py, 5 / this.k)
        if (path.length > 0) { const id = app.pick(path); if (!app.selection.includes(id)) app.select([id]) }
        else app.select([])
        app.stageMenu.open(this, e)
        },

    // the slide, with a soft shadow to lift it off the stage

    page: SlideView [ x = { classroot.ox }, y = { classroot.oy }, w = { classroot.slideW },
        accessibilityLabel = "Slide",
        datapath = { app.current },
        hideId = { app.editingId },
        shadow = { shadow(0, 8, 30, 0x2B243A2E) } ],

    // While a presentation loads, a quiet placeholder holds the slide's place.

    loadingCard: View [ visible = { !app.ready }, x = { classroot.ox }, y = { classroot.oy },
        width = { classroot.slideW }, height = { classroot.slideH }, fill = { provided("theme").panel },
        cornerRadius = 2, opacity = { 0.6 + 0.4 * app.pulse },
        Text [ x = center, y = center, fontSize = 14, textColor = { provided("theme").textMuted }, text = "Opening…" ]
        ],

    // A first slide with nothing on it says how to begin.

    hint: View [ visible = { app.ready && app.els.length == 0 && app.g.mode == "" && app.editingId == "" },
        pointerEvents = "none", x = center, y = { classroot.oy + classroot.slideH / 2 - 34 },
        layout: SimpleLayout [ axis = y, spacing = 8, align = center ],
        opacity = { app.slideIsDark ? 0.75 : 0.6 },
        Text [ fontFamily = { app.brandFace }, fontSize = 19, fontWeight = 650,
            textColor = { app.slideIsDark ? 0xFFFFFF : provided("theme").textMuted }, text = "An empty slide" ],
        Text [ fontSize = 13.5, textColor = { app.slideIsDark ? 0xFFFFFF : provided("theme").textMuted },
            text = "Pick Rectangle, Ellipse, Line or Text above, then drag on the slide." ]
        ],

    // Guides, the marquee, the outline of what the pointer is over, and the
    // outlines of each thing in a selection of several.

    marks: View [ width = 100%, height = 100%, pointerEvents = "none",
        draw(d: DrawContext) {
            const st = classroot
            const t = provided("theme")
            const els = app.els
            if (app.hoverId != "" && !app.selection.includes(app.hoverId) && app.g.mode == "") {
                const e = findEl(els, app.hoverId)
                if (e != null) {
                    d.beginPath()
                    if (e.kind == "line") { d.moveTo(st.sx(e.x1 ?? 0), st.sy(e.y1 ?? 0)); d.lineTo(st.sx(e.x2 ?? 0), st.sy(e.y2 ?? 0)) }
                    else { const b = boundsOf(e); d.rect(st.sx(b.x), st.sy(b.y), b.w * st.k, b.h * st.k) }
                    d.strokeStyle = "#FFFFFFB0"; d.lineWidth = 3; d.stroke()
                    d.strokeStyle = t.accent; d.lineWidth = 1.2; d.stroke()
                }
            }
            if (app.selection.length > 1 || app.scope != "") {
                for (const id of app.selection) {
                    const e = findEl(els, id)
                    if (e == null) continue
                    const b = boundsOf(e)
                    d.beginPath(); d.rect(st.sx(b.x), st.sy(b.y), b.w * st.k, b.h * st.k)
                    d.strokeStyle = t.accentLine; d.lineWidth = 1; d.stroke()
                }
            }
            if (app.scope != "") {
                const g = findEl(els, app.scope)
                if (g != null) {
                    const b = boundsOf(g)
                    d.beginPath(); d.setLineDash([4, 3]); d.rect(st.sx(b.x) - 4, st.sy(b.y) - 4, b.w * st.k + 8, b.h * st.k + 8)
                    d.strokeStyle = t.accent; d.lineWidth = 1; d.stroke(); d.setLineDash([])
                }
            }
            d.strokeStyle = t.guide
            d.lineWidth = 1
            for (const gx of app.g.guidesX) { d.beginPath(); d.moveTo(st.sx(gx), st.oy - 12); d.lineTo(st.sx(gx), st.oy + st.slideH + 12); d.stroke() }
            for (const gy of app.g.guidesY) { d.beginPath(); d.moveTo(st.ox - 12, st.sy(gy)); d.lineTo(st.ox + st.slideW + 12, st.sy(gy)); d.stroke() }
            const m = app.g.marquee
            if (m != null) {
                d.beginPath(); d.rect(st.sx(m.x), st.sy(m.y), m.w * st.k, m.h * st.k)
                d.fillStyle = "#5B3DF51F"; d.fill()
                d.strokeStyle = t.accent; d.lineWidth = 1; d.stroke()
            }
            }
        ],

    // The selection: a frame with a white halo, so it reads on any slide,
    // and its handles. A single line has a handle at each end instead.

    frame: View [ visible = { app.selection.length > 0 && app.editingId == "" && !app.selIsLine },
        pointerEvents = "none",
        bx: number = { classroot.sx(app.selBox.x) },
        by: number = { classroot.sy(app.selBox.y) },
        bw: number = { app.selBox.w * classroot.k },
        bh: number = { app.selBox.h * classroot.k },
        x = { this.bx - 1 }, y = { this.by - 1 }, width = { this.bw + 2 }, height = { this.bh + 2 },
        stroke = { stroke(3.5, colorWithAlpha(0xFFFFFF, 200)) },
        inner: View [ x = 1, y = 1, width = { parent.width - 2 }, height = { parent.height - 2 },
            stroke = { stroke(1.5, provided("theme").handle) } ]
        ],
    handles: View [ visible = { app.selection.length > 0 && app.editingId == "" && app.tool == "select" && app.g.mode != "move" && app.g.mode != "marquee" },
        width = 100%, height = 100%,
        bx: number = { classroot.sx(app.selBox.x) },
        by: number = { classroot.sy(app.selBox.y) },
        bw: number = { app.selBox.w * classroot.k },
        bh: number = { app.selBox.h * classroot.k },
        box: boolean = { !app.selIsLine },
        small: boolean = { this.bw < 36 || this.bh < 36 },
        Handle [ which = "tl", k = { classroot.k }, visible = { parent.box }, x = { parent.bx - 11 }, y = { parent.by - 11 } ],
        Handle [ which = "tr", k = { classroot.k }, visible = { parent.box }, x = { parent.bx + parent.bw - 11 }, y = { parent.by - 11 } ],
        Handle [ which = "bl", k = { classroot.k }, visible = { parent.box }, x = { parent.bx - 11 }, y = { parent.by + parent.bh - 11 } ],
        Handle [ which = "br", k = { classroot.k }, visible = { parent.box }, x = { parent.bx + parent.bw - 11 }, y = { parent.by + parent.bh - 11 } ],
        Handle [ which = "t", k = { classroot.k }, visible = { parent.box && !parent.small && !app.selIsText }, x = { parent.bx + parent.bw / 2 - 11 }, y = { parent.by - 11 } ],
        Handle [ which = "b", k = { classroot.k }, visible = { parent.box && !parent.small && !app.selIsText }, x = { parent.bx + parent.bw / 2 - 11 }, y = { parent.by + parent.bh - 11 } ],
        Handle [ which = "l", k = { classroot.k }, visible = { parent.box && !parent.small }, x = { parent.bx - 11 }, y = { parent.by + parent.bh / 2 - 11 } ],
        Handle [ which = "r", k = { classroot.k }, visible = { parent.box && !parent.small }, x = { parent.bx + parent.bw - 11 }, y = { parent.by + parent.bh / 2 - 11 } ],
        Handle [ which = "end1", k = { classroot.k }, visible = { app.selIsLine }, x = { classroot.sx(app.lineSel?.x1 ?? 0) - 11 }, y = { classroot.sy(app.lineSel?.y1 ?? 0) - 11 } ],
        Handle [ which = "end2", k = { classroot.k }, visible = { app.selIsLine }, x = { classroot.sx(app.lineSel?.x2 ?? 0) - 11 }, y = { classroot.sy(app.lineSel?.y2 ?? 0) - 11 } ],
        Handle [ which = "radius", k = { classroot.k }, tooltipLabel = "Corner radius",
            visible = { app.rectSel != null && parent.bw > 70 && parent.bh > 50 },
            x = { parent.bx + Math.max(18, Math.min(parent.bw / 2, (app.rectSel?.cornerRadius ?? 0) * classroot.k)) - 11 },
            y = { parent.by + Math.max(18, Math.min(parent.bh / 2, (app.rectSel?.cornerRadius ?? 0) * classroot.k)) - 11 } ]
        ],

    // Typing in place: a field over the text box, in its own font and size.

    field: TextInput [ exists = { app.editingId != "" && app.editEl != null },
        x = { classroot.sx(app.editEl?.x ?? 0) }, y = { classroot.sy(app.editEl?.y ?? 0) },
        width = { (app.editEl?.width ?? 100) * classroot.k },
        height = { Math.max(20, (app.editEl?.height ?? 40) * classroot.k + 2) },
        multiline = true, wrap = true, padding = 0, fill = null, stroke = null, spellcheck = true,
        accessibilityLabel = "Text",
        fontSize = { (app.editEl?.text?.size ?? 24) * classroot.k },
        fontFamily = { fontStack(app.editEl?.text?.font ?? "Helvetica Neue") },
        fontWeight = { app.editEl?.text?.weight ?? 400 },
        italic = { app.editEl?.text?.italic ?? false },
        textAlign = { app.editEl?.text?.align ?? "left" },
        textColor = { colorWithAlpha(rgbOf(app.editEl?.text?.color ?? "#000000"), alphaOf(app.editEl?.text?.color ?? "#000000")) },
        text = { app.editEl?.text?.content ?? "" },
        onInput(v: string) { app.typeLive(v) },
        onKeyDown(e: KeyEvent) { if (e.key == "Escape") app.finishEditing() },
        onBlur() { app.finishEditing() },
        onInit() { afterSettle(() => { Focus.focus(this); if (app.selectAllOnEdit) this.select("all") }) }
        ],

    // Someone else changed this slide.

    banner: ConflictBanner [ x = center, y = 14 ]
    ]


// ── Another window changed this slide ───────────────────────────────────────

class ConflictBanner [ visible = { app.conflict != null }, width = 660, cornerRadius = 14, padding = [12, 14, 12, 14],
    fill = { provided("theme").surface }, stroke = { stroke(1, provided("theme").line) },
    shadow = { shadow(0, 10, 28, 0x2B243A33) },
    accessibilityRole = status, accessibilityLive = assertive,
    layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
    theirs: SlideView [ w = 96, datapath = { app.conflict }, cornerRadius = 4, stroke = { stroke(1, provided("theme").line) } ],
    words: View [ flexes = true,
        layout: SimpleLayout [ axis = y, spacing = 3 ],
        Text [ width = 100%, fontSize = 14, fontWeight = 650, textColor = { provided("theme").text },
            text = "This slide was changed in another window." ],
        Text [ width = 100%, fontSize = 12.5, textColor = { provided("theme").textMuted },
            text = "Nothing was saved over it. Use theirs, shown here, or keep yours." ]
        ],
    PillButton [ label = "Keep mine",
        press() { app.sync.keepMine(app.currentKey, app.doc.deckId) }
        ],
    PillButton [ label = "Use this version", strong = true,
        press() { app.sync.takeTheirs(app.currentKey) }
        ]
    ]


// ── The slide list ──────────────────────────────────────────────────────────
//
// Tiles stacked down the list. While a tile is dragged it follows the pointer
// and the others hold still, with a bar where it will land; when it lands the
// slides reorder and every tile glides to its place.

class TileStack extends TweenLayout [ duration = 320,
    pitch: number = 118,
    place() {
        const w = this.contentExtent("width")
        const drag = app.listDrag
        return this.laid().map((c, i) => {
            const y = (drag != null && drag.from == i) ? drag.y : i * this.pitch
            return ({ x: 0, y: y, w: w, h: this.pitch - 8 })
            })
        }
    ]


schema ListDrag [ from: number, y: number, to: number, y0: number ]

class SlideTile extends Control [ cornerRadius = 12,
    slideKey: string = { :id ?? "" },
    num: number = { rowIndex + 1 },
    here: boolean = { app.currentKey == classroot.slideKey },
    dragged: boolean = { app.listDrag != null && app.listDrag.from == rowIndex },
    changed: boolean = { app.sync.conflictOf(classroot.slideKey) != null },
    accessibilityLabel = { "Slide " + classroot.num },
    accessibilityRole = tab,
    accessibilitySelected = { classroot.here },
    fill = { classroot.here ? provided("theme").accentSoft : hovered ? provided("theme").hover : null },
    shadow = { classroot.dragged ? shadow(0, 12, 28, 0x2B243A40) : null },
    press() { app.goTo(classroot.slideKey) },
    onContextMenu(e: PointerEvent) { app.goTo(classroot.slideKey); app.slideMenu.open(this, e) },

    // Dragging to reorder: past a few pixels the tile lifts and follows.

    grabY: number = 0,
    onPointerDown(e: PointerEvent) { this.grabY = rowIndex * 118 },
    onPointerMove(e: PointerEvent) {
        if (app.listDrag == null && Math.abs(e.deltaY) < 5) return
        app.dragTile(rowIndex, this.grabY, e.deltaY)
        },
    onPointerUp(e: PointerUpEvent) { if (app.listDrag != null) app.dropTile(e.canceled) },

    num_: TextLabel [ x = 6, width = 20, height = 22, fontSize = 12, fontWeight = 650, textAlign = right,
        numeralWidth = tabular,
        textColor = { classroot.here ? provided("theme").accent : provided("theme").textMuted }, text = { "" + classroot.num } ],
    ring: View [ x = 32, y = 7, width = { parent.width - 40 }, height = { this.width * 9 / 16 + 6 }, cornerRadius = 7,
        stroke = { classroot.here ? stroke(2.5, provided("theme").accent) : stroke(1, provided("theme").line) },
        pic: SlideView [ x = 3, y = 3, w = { parent.width - 6 }, cornerRadius = 4 ]
        ],
    badge: View [ visible = { classroot.changed }, x = { parent.width - 26 }, y = 2, width = 20, height = 20, cornerRadius = 10,
        fill = { provided("theme").warn }, tooltipLabel = "Changed in another window",
        Glyph [ x = center, y = center, iconSize = 12, weight = 1.8, shape = "alert", ink = white ]
        ]
    ]


class SlideList [ fill = { provided("theme").panel },
    stroke = { [null, stroke(1, provided("theme").line), null, null] },
    layout: SimpleLayout [ axis = y ],
    head: View [ width = 100%, height = 44, padding = [0, 10, 0, 16],
        layout: SimpleLayout [ axis = x, align = center ],
        TextLabel [ fontSize = 12, fontWeight = 700, letterSpacing = 0.6, textTransform = uppercase,
            textColor = { provided("theme").textMuted }, text = { app.doc.count == 1 ? "1 slide" : app.doc.count + " slides" } ],
        Spacer [ ],
        IconButton [ shape = "plus", label = "New slide (⇧⌘N)", size = 16,
            press() { app.newSlide() }
            ],
        IconButton [ shape = "more", label = "Slide actions", size = 16,
            press() { app.slideMenu.openFor(this) }
            ]
        ],
    scroller: View [ width = 100%, flexes = true, scrolls = y, padding = [2, 10, 24, 6],
        datapath = { app.doc.value },
        layout: TileStack [ ],
        keys: Shortcuts [ title = "Slides",
            items = { [ ({ id: "prev", key: "↑", label: "Previous slide" }), ({ id: "next", key: "↓", label: "Next slide" }),
                ({ id: "del", key: "⌫", label: "Delete slide" }), ({ id: "del", key: "⌦", label: "Delete slide" }) ] },
            picked(id: string) {
                if (id == "prev") app.stepSlide(-1)
                else if (id == "next") app.stepSlide(1)
                else if (id == "del") app.deleteSlide()
                }
            ],
        SlideTile [ datapath = :slides[] ],

        // where a dragged tile will land

        bar: View [ ignoreLayout = true, visible = { app.listDrag != null }, x = 32, width = { parent.width - 48 }, height = 3,
            cornerRadius = 2, fill = { provided("theme").accent },
            y = { (app.listDrag?.to ?? 0) * 118 + ((app.listDrag?.to ?? 0) > (app.listDrag?.from ?? 0) ? 110 : -5) } ]
        ]
    ]


// ── The inspector ───────────────────────────────────────────────────────────

class Inspector [ fill = { provided("theme").panel }, scrolls = y,
    stroke = { [null, null, null, stroke(1, provided("theme").line)] },
    layout: SimpleLayout [ axis = y ],

    // What is selected, in words.

    head: View [ width = 100%, height = 52, padding = [0, 16, 0, 16],
        stroke = { [null, null, stroke(1, provided("theme").line), null] },
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        View [ width = 28, height = 28, cornerRadius = 8, fill = { provided("theme").accentSoft },
            Glyph [ x = center, y = center, iconSize = 15, weight = 1.7, shape = { app.selIcon }, ink = { provided("theme").accent } ]
            ],
        TextLabel [ flexes = true, fontSize = 14, fontWeight = 650, maxLines = 1, textColor = { provided("theme").text },
            text = { app.selTitle } ]
        ],

    // Fill — or, with nothing selected, the slide's background.

    fillSec: Section [ title = { app.selection.length == 0 ? "Background" : "Fill" },
        Row [ label = "Colour", visible = { app.selection.length == 0 || app.fillInfo.applies },
            Swatch [ accessibilityLabel = { app.selection.length == 0 ? "Background colour" : "Fill colour" },
                tooltipLabel = { app.selection.length == 0 ? "Background colour" : "Fill colour" },
                color = { app.selection.length == 0 ? (app.current?.background ?? "#FFFFFF") : app.fillInfo.value },
                mixed = { app.selection.length > 0 && app.fillInfo.mixed },
                press() { app.openColour(app.selection.length == 0 ? "bg" : "fill", this) }
                ],
            TextLabel [ flexes = true, fontSize = 12.5, maxLines = 1, textColor = { provided("theme").textMuted },
                text = { app.selection.length == 0 ? app.colourName(app.current?.background ?? "") : app.fillInfo.mixed ? "Mixed" : app.colourName(app.fillInfo.value) } ]
            ],

        // in the same room, so the panel keeps its shape

        View [ width = 100%, height = 30, visible = { app.selection.length > 0 && !app.fillInfo.applies },
            Note [ y = center, maxLines = 1, text = { app.selIsLine ? "A line has an outline only." : "Text has no fill — its colour is under Text." } ]
            ]
        ],

    strokeSec: Section [ title = "Outline",
        opacity = { app.strokeInfo.applies ? 1 : 0.45 },
        Row [ label = "Colour",
            Swatch [ accessibilityLabel = "Outline colour", tooltipLabel = "Outline colour",
                disabled = { !app.strokeInfo.applies }, color = { app.strokeInfo.value }, mixed = { app.strokeInfo.mixed },
                press() { app.openColour("stroke", this) }
                ],
            TextLabel [ flexes = true, fontSize = 12.5, maxLines = 1, textColor = { provided("theme").textMuted },
                text = { !app.strokeInfo.applies ? "—" : app.strokeInfo.mixed ? "Mixed" : app.colourName(app.strokeInfo.value) } ]
            ],
        Row [ label = "Width",
            Stepper [ width = 110, min = 0, max = 60, step = 1, accessibilityLabel = "Outline width",
                disabled = { !app.strokeInfo.applies || app.strokeInfo.value == "" },
                value = { app.strokeInfo.width },
                input(v: number) { app.setStrokeWidth(v) }
                ],
            TextLabel [ fontSize = 12.5, textColor = { provided("theme").textMuted },
                text = { app.strokeInfo.widthMixed ? "Mixed" : "pt" } ]
            ]
        ],

    cornerSec: Section [ title = "Corners",
        opacity = { app.radiusInfo.applies ? 1 : 0.45 },
        Row [ label = "Radius",
            Slider [ width = 112, min = 0, max = { Math.max(1, app.radiusInfo.max) }, step = 1, accessibilityLabel = "Corner radius",
                disabled = { !app.radiusInfo.applies }, value = { app.radiusInfo.value },
                input(v: number) { app.setRadius(v) }
                ],
            TextLabel [ flexes = true, fontSize = 12.5, numeralWidth = tabular, textColor = { provided("theme").textMuted },
                text = { !app.radiusInfo.applies ? "—" : app.radiusInfo.mixed ? "Mixed" : Math.round(app.radiusInfo.value) + " pt" } ]
            ]
        ],

    textSec: Section [ title = "Text",
        opacity = { app.textInfo.applies ? 1 : 0.45 },
        Row [ label = "Font",
            Button [ flexes = true, height = 30, disabled = { !app.textInfo.applies }, accessibilityLabel = "Font",
                label = { app.textInfo.fontMixed ? "Mixed" : app.textInfo.font }, menu = { app.fontMenu } ]
            ],
        Row [ label = "Size",
            Stepper [ width = 110, min = 6, max = 400, step = 2, accessibilityLabel = "Text size",
                disabled = { !app.textInfo.applies }, value = { app.textInfo.size },
                input(v: number) { app.setTextField("size", Math.round(v), "Text Size") }
                ],
            TextLabel [ fontSize = 12.5, textColor = { provided("theme").textMuted }, text = { app.textInfo.sizeMixed ? "Mixed" : "pt" } ]
            ],
        Row [ label = "Style",
            Button [ width = 110, height = 30, disabled = { !app.textInfo.applies }, accessibilityLabel = "Weight",
                label = { app.textInfo.weightMixed ? "Mixed" : app.weightName(app.textInfo.weight) }, menu = { app.weightMenu } ],
            IconButton [ width = 30, height = 30, shape = "", label = "Italic", disabled = { !app.textInfo.applies },
                on = { app.textInfo.italic && !app.textInfo.italicMixed },
                press() { app.setTextField("italic", !app.textInfo.italic, "Italic") },
                TextLabel [ x = center, fontFamily = "Georgia", fontSize = 16, italic = true, fontWeight = 700,
                    textColor = { parent.on ? provided("theme").accent : provided("theme").text }, text = "I" ]
                ]
            ],
        Row [ label = "Colour",
            Swatch [ accessibilityLabel = "Text colour", tooltipLabel = "Text colour",
                disabled = { !app.textInfo.applies }, color = { app.textInfo.color }, mixed = { app.textInfo.colorMixed },
                press() { app.openColour("text", this) }
                ],
            TextLabel [ flexes = true, fontSize = 12.5, maxLines = 1, textColor = { provided("theme").textMuted },
                text = { !app.textInfo.applies ? "—" : app.textInfo.colorMixed ? "Mixed" : app.colourName(app.textInfo.color) } ]
            ],
        Row [ label = "Align",
            RadioGroup [ accessibilityLabel = "Text alignment", disabled = { !app.textInfo.applies },
                value = { app.textInfo.align },
                input(v: string) { app.setTextField("align", v, "Text Alignment") },
                layout: SimpleLayout [ axis = x, spacing = 2 ],
                Choice [ width = 32, height = 30, choice = "left", shape = "textLeft", label = "Align left" ],
                Choice [ width = 32, height = 30, choice = "center", shape = "textCenter", label = "Align centre" ],
                Choice [ width = 32, height = 30, choice = "right", shape = "textRight", label = "Align right" ]
                ]
            ]
        ],

    sizeSec: Section [ title = "Proportions",
        opacity = { app.keepInfo.applies ? 1 : 0.45 },
        Checkbox [ label = "Keep proportions", disabled = { !app.keepInfo.applies },
            checked = { app.keepInfo.on },
            input(v: boolean) { app.keepShape(v) }
            ],
        Note [ text = { app.keepInfo.on ? "Shift while resizing changes it once." : "Or hold Shift while resizing." } ]
        ],

    arrangeSec: Section [ title = "Arrange",
        View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 2 ],
            IconButton [ shape = "alignLeft", label = "Align left edges", disabled = { app.selection.length < 2 },
                press() { app.align("left") }
                ],
            IconButton [ shape = "alignCenter", label = "Align centres", disabled = { app.selection.length < 2 },
                press() { app.align("center") }
                ],
            IconButton [ shape = "alignRight", label = "Align right edges", disabled = { app.selection.length < 2 },
                press() { app.align("right") }
                ],
            IconButton [ shape = "alignTop", label = "Align tops", disabled = { app.selection.length < 2 },
                press() { app.align("top") }
                ],
            IconButton [ shape = "alignMiddle", label = "Align middles", disabled = { app.selection.length < 2 },
                press() { app.align("middle") }
                ],
            IconButton [ shape = "alignBottom", label = "Align bottoms", disabled = { app.selection.length < 2 },
                press() { app.align("bottom") }
                ]
            ],
        View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 2 ],
            IconButton [ shape = "distAcross", label = "Distribute across", disabled = { app.selection.length < 3 },
                press() { app.distribute("across") }
                ],
            IconButton [ shape = "distDown", label = "Distribute down", disabled = { app.selection.length < 3 },
                press() { app.distribute("down") }
                ],
            View [ width = 12, height = 34 ],
            IconButton [ shape = "group", label = "Group (⌘G)", disabled = { app.selection.length < 2 },
                press() { app.group() }
                ],
            IconButton [ shape = "ungroup", label = "Ungroup (⇧⌘G)", disabled = { !app.selHasGroup },
                press() { app.ungroup() }
                ]
            ],
        View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 2 ],
            IconButton [ shape = "front", label = "Bring to front", disabled = { app.selection.length == 0 },
                press() { app.restackSel("front") }
                ],
            IconButton [ shape = "forward", label = "Bring forward", disabled = { app.selection.length == 0 },
                press() { app.restackSel("forward") }
                ],
            IconButton [ shape = "backward", label = "Send backward", disabled = { app.selection.length == 0 },
                press() { app.restackSel("backward") }
                ],
            IconButton [ shape = "back", label = "Send to back", disabled = { app.selection.length == 0 },
                press() { app.restackSel("back") }
                ]
            ]
        ]
    ]


// ── The colour picker ───────────────────────────────────────────────────────

class ColourWell extends Control [ width = 26, height = 26, cornerRadius = 7,
    hex: string = "",
    chosen: boolean = false,
    accessibilityLabel = { app.colourName(classroot.hex) },
    accessibilityPressed = { classroot.chosen },
    fill = { colorWithAlpha(rgbOf(classroot.hex), 255) },
    stroke = { classroot.chosen ? stroke(2, provided("theme").accent) : lightness(classroot.hex) > 0.9 ? stroke(1, provided("theme").lineStrong) : null },
    scale = { hovered ? 1.12 : 1 }, pivotX = 13, pivotY = 13,
    press() { app.pickColour(classroot.hex) }
    ]


class ColourPicker [ width = 256,
    layout: SimpleLayout [ axis = y, spacing = 12 ],
    Text [ fontSize = 12, fontWeight = 700, letterSpacing = 0.6, textTransform = uppercase, textColor = { provided("theme").textMuted },
        text = { app.colourTargetName } ],
    wells: View [ width = 100%, datapath = { app.palette.value },
        layout: WrappingLayout [ columns = 8, spacing = 5, rowSpacing = 5 ],
        ColourWell [ datapath = :rows[], hex = { :@ }, chosen = { app.colourNow.slice(0, 7) == :@ } ]
        ],
    row: View [ width = 100%,
        layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
        TextInput [ width = 112, height = 30, fontSize = 13, accessibilityLabel = "Hex colour", placeholder = "#RRGGBB",
            text = { app.colourNow == "" ? "" : app.colourNow.slice(0, 7) },
            commitOn = "enter",
            onInput(v: string) { const c = parseHex(v); if (c != null) app.pickColour(c) }
            ],
        Spacer [ ],
        Button [ height = 30, label = "None", visible = { app.colourTarget == "fill" || app.colourTarget == "stroke" },
            onClick() { app.pickColour("") }
            ]
        ],
    alpha: View [ width = 100%, visible = { app.colourNow != "" },
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        TextLabel [ width = 58, fontSize = 12.5, textColor = { provided("theme").textMuted }, text = "Opacity" ],
        Slider [ flexes = true, min = 0, max = 100, step = 1, accessibilityLabel = "Opacity",
            value = { Math.round(alphaOf(app.colourNow) / 255 * 100) },
            input(v: number) { app.pickAlpha(v) }
            ],
        TextLabel [ width = 40, fontSize = 12.5, textAlign = right, numeralWidth = tabular, textColor = { provided("theme").textMuted },
            text = { Math.round(alphaOf(app.colourNow) / 255 * 100) + "%" } ]
        ]
    ]


// ── The bar across the top ──────────────────────────────────────────────────

class SaveState [ height = 28, cornerRadius = 14, padding = [0, 11, 0, 9],
    status: string = { app.sync.status },
    fill = { classroot.status == "offline" ? provided("theme").dangerSoft : null },
    accessibilityRole = status,
    accessibilityLabel = { classroot.words },
    words: string = { classroot.status == "offline" ? "Not saved: can't reach the service" : classroot.status == "saving" ? "Saving…" : "All changes saved" },
    layout: SimpleLayout [ axis = x, spacing = 6, align = center ],
    Glyph [ iconSize = 14, weight = 1.7, shape = { classroot.status == "offline" ? "alert" : classroot.status == "saving" ? "cloud" : "check" },
        ink = { classroot.status == "offline" ? provided("theme").danger : classroot.status == "saving" ? provided("theme").textMuted : provided("theme").ok },
        opacity = { classroot.status == "saving" ? 0.55 + 0.45 * app.pulse : 1 } ],
    TextLabel [ fontSize = 12.5, fontWeight = 550, wrap = false,
        textColor = { classroot.status == "offline" ? provided("theme").danger : provided("theme").textMuted }, text = { classroot.words } ]
    ]


class TopBar [ height = 56, padding = [0, 12, 0, 10],
    fill = { provided("theme").background },
    stroke = { [null, null, stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = x, spacing = 6, align = center ],

    home: Control [ height = 36, cornerRadius = 10, padding = [0, 10, 0, 6], accessibilityLabel = "All presentations",
        tooltipLabel = "All presentations",
        fill = { pressed ? provided("theme").pressedFill : hovered ? provided("theme").hover : null },
        press() { app.goHome() },
        layout: SimpleLayout [ axis = x, spacing = 6, align = center ],
        Glyph [ iconSize = 14, weight = 2, shape = "chevronLeft", ink = { provided("theme").textMuted } ],
        BrandMark [ width = 24, height = 24 ]
        ],
    titleBox: View [ width = { Math.max(150, Math.min(320, parent.width * 0.21)) }, height = 36,
        title: TextInput [ width = 100%, height = 36, fontSize = 15, fontWeight = 650, padding = [0, 10, 0, 10],
            accessibilityLabel = "Presentation title", placeholder = "Untitled presentation",
            fill = { this.focused ? provided("theme").surface : hovered ? provided("theme").hover : null },
            stroke = { this.focused ? stroke(1.5, provided("theme").accent) : null },
            cornerRadius = 9,
            text = { app.titleDraft },
            onInput(v: string) { app.titleDraft = v },
            onEnter() { Focus.blur() },
            onKeyDown(e: KeyEvent) { if (e.key == "Escape") { app.titleDraft = app.doc.title; Focus.blur() } },
            onBlur() { app.doc.rename(app.titleDraft); app.titleDraft = app.doc.title }
            ]
        ],
    SaveState [ ],
    Spacer [ ],
    tools: RadioGroup [ height = 40, cornerRadius = 12, padding = 3, fill = { provided("theme").control },
        accessibilityLabel = "Tools",
        value = { app.tool },
        input(v: string) { app.useTool(v as "select" | "rect" | "ellipse" | "line" | "text") },
        layout: SimpleLayout [ axis = x, spacing = 2, align = center ],
        Choice [ choice = "select", shape = "select", label = "Select" ],
        Choice [ choice = "rect", shape = "rect", label = "Rectangle" ],
        Choice [ choice = "ellipse", shape = "ellipse", label = "Ellipse" ],
        Choice [ choice = "line", shape = "line", label = "Line" ],
        Choice [ choice = "text", shape = "text", label = "Text" ]
        ],
    Spacer [ ],
    IconButton [ shape = "undo", label = { app.doc.undoLabel + " (⌘Z)" }, accessibilityLabel = "Undo",
        disabled = { !app.doc.canUndo },
        press() { app.doc.undo() }
        ],
    IconButton [ shape = "redo", label = { app.doc.redoLabel + " (⇧⌘Z)" }, accessibilityLabel = "Redo",
        disabled = { !app.doc.canRedo },
        press() { app.doc.redo() }
        ],
    View [ width = 6, height = 20 ],
    MenuButton [ label = "Edit", menu = { app.editMenu } ],
    MenuButton [ label = "Arrange", menu = { app.arrangeMenu } ],
    View [ width = 6, height = 20 ],
    PillButton [ label = "Present", shape = "play", strong = true, tooltipLabel = "Present from this slide (⌘↩)",
        disabled = { !app.ready },
        press() { app.present() }
        ]
    ]
