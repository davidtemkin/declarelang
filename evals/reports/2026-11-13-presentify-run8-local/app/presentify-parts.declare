/*
# Presentify: the parts

The look of Presentify, kept apart from how it works: the palette, the type,
the drawn marks (the logo, the tool and command icons), and the small controls
every screen is made of. `presentify.declare` includes this file.

The identity in one line: a warm coral spark on deep aubergine ink, set in
Bricolage Grotesque, with soft lilac-grey around the slide so the slide is
always the brightest thing on screen.
*/

// ── Colours ─────────────────────────────────────────────────────────────────
//
// Laid over the library's San Francisco preset, so library controls (menus,
// buttons, dialogs, the focus ring) wear the same palette. Views read the
// tokens by name: `provided("theme").spark`.

theme Presentify [
    background = #F3F1F7, surface = #FFFFFF, panel = #FFFFFF, canvas = #E6E2EE,
    line = #E4E0EC, lineStrong = #CFC9DB,
    text = #1B1530, textMuted = #625B78, textFaint = #9891AC,
    accent = #6246EA, accentHovered = #5537DD, accentPressed = #482CC4, accentTextColor = #FFFFFF,
    linkColor = #6246EA,
    control = #F1EEF7, controlHovered = #E8E4F2, controlPressed = #DCD6EA, controlSelected = #E7E1FF,
    controlCornerRadius = 8,
    spark = #FF5C39, sparkHovered = #F04A27, sparkPressed = #D63F1E, sparkTint = #FFE9E3,
    ink = #1B1530, inkSoft = #2C2445,
    select = #6246EA, selectTint = #EEEAFF, handle = #FFFFFF, guide = #FF3D8B,
    ok = #1E9E6A, warn = #C2410C, warnTint = #FFF1E8, danger = #D92D20,
    hover = #F4F1FA, quiet = #F7F5FB,
    tooltipFill = #1B1530, tooltipTextColor = #FFFFFF,
    menuHighlightFill = #6246EA,
    scrimFill = #140F24, scrimOpacity = 0.4
    ]


// ── Marks ───────────────────────────────────────────────────────────────────
//
// Every icon is drawn by one pen: a round-ended stroke on the library's 16-unit
// grid, scaled to `iconSize`, with the stroke kept at `weight` real pixels.

class Mark extends Icon [ weight = 1.6,
    shape: string = "",
    draw(d: DrawContext) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.fillStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        const s = shape
        if (s == "select") {                 // a pointer
            d.moveTo(4, 2); d.lineTo(4, 13); d.lineTo(6.8, 10.4); d.lineTo(8.8, 14.2); d.lineTo(10.6, 13.3)
            d.lineTo(8.7, 9.6); d.lineTo(12.4, 9.4); d.closePath(); d.stroke()
        } else if (s == "rect") {
            d.roundRect(2, 3.5, 12, 9, 1.6); d.stroke()
        } else if (s == "ellipse") {
            d.ellipse(8, 8, 6.2, 5.2, 0, 0, Math.PI * 2); d.stroke()
        } else if (s == "line") {
            d.moveTo(2.5, 13.5); d.lineTo(13.5, 2.5); d.stroke()
        } else if (s == "text") {            // a T
            d.moveTo(3, 3.5); d.lineTo(13, 3.5); d.moveTo(8, 3.5); d.lineTo(8, 13.5); d.moveTo(6, 13.5); d.lineTo(10, 13.5); d.stroke()
        } else if (s == "undo") {
            d.moveTo(5.5, 3); d.lineTo(2.5, 6); d.lineTo(5.5, 9); d.moveTo(2.5, 6); d.lineTo(10, 6)
            d.bezierCurveTo(12.5, 6, 14, 7.8, 14, 9.8); d.bezierCurveTo(14, 11.8, 12.5, 13.5, 10, 13.5); d.lineTo(7, 13.5); d.stroke()
        } else if (s == "redo") {
            d.moveTo(10.5, 3); d.lineTo(13.5, 6); d.lineTo(10.5, 9); d.moveTo(13.5, 6); d.lineTo(6, 6)
            d.bezierCurveTo(3.5, 6, 2, 7.8, 2, 9.8); d.bezierCurveTo(2, 11.8, 3.5, 13.5, 6, 13.5); d.lineTo(9, 13.5); d.stroke()
        } else if (s == "plus") {
            d.moveTo(8, 3); d.lineTo(8, 13); d.moveTo(3, 8); d.lineTo(13, 8); d.stroke()
        } else if (s == "duplicate") {
            d.roundRect(5, 5, 9, 9, 1.6); d.moveTo(11, 2.5); d.lineTo(3.8, 2.5); d.arcTo(2.5, 2.5, 2.5, 3.8, 1.3); d.lineTo(2.5, 11); d.stroke()
        } else if (s == "trash") {
            d.moveTo(2.5, 4); d.lineTo(13.5, 4); d.moveTo(6, 4); d.lineTo(6.5, 2); d.lineTo(9.5, 2); d.lineTo(10, 4)
            d.moveTo(3.8, 4); d.lineTo(4.6, 14); d.lineTo(11.4, 14); d.lineTo(12.2, 4); d.stroke()
        } else if (s == "play") {
            d.moveTo(4.5, 2.8); d.lineTo(13, 8); d.lineTo(4.5, 13.2); d.closePath(); d.fill()
        } else if (s == "back") {
            d.moveTo(10, 3); d.lineTo(5, 8); d.lineTo(10, 13); d.stroke()
        } else if (s == "more") {
            for (const x of [3.5, 8, 12.5]) { d.moveTo(x + 1.1, 8); d.arc(x, 8, 1.1, 0, 6.3) }
            d.fill()
        } else if (s == "alignLeft") {
            d.moveTo(2.5, 2); d.lineTo(2.5, 14); d.stroke(); d.beginPath()
            d.roundRect(4.5, 4, 9, 3, 0.8); d.roundRect(4.5, 9, 5.5, 3, 0.8); d.fill()
        } else if (s == "alignCenter") {
            d.moveTo(8, 2); d.lineTo(8, 14); d.stroke(); d.beginPath()
            d.roundRect(3, 4, 10, 3, 0.8); d.roundRect(5, 9, 6, 3, 0.8); d.fill()
        } else if (s == "alignRight") {
            d.moveTo(13.5, 2); d.lineTo(13.5, 14); d.stroke(); d.beginPath()
            d.roundRect(2.5, 4, 9, 3, 0.8); d.roundRect(6, 9, 5.5, 3, 0.8); d.fill()
        } else if (s == "alignTop") {
            d.moveTo(2, 2.5); d.lineTo(14, 2.5); d.stroke(); d.beginPath()
            d.roundRect(4, 4.5, 3, 9, 0.8); d.roundRect(9, 4.5, 3, 5.5, 0.8); d.fill()
        } else if (s == "alignMiddle") {
            d.moveTo(2, 8); d.lineTo(14, 8); d.stroke(); d.beginPath()
            d.roundRect(4, 3, 3, 10, 0.8); d.roundRect(9, 5, 3, 6, 0.8); d.fill()
        } else if (s == "alignBottom") {
            d.moveTo(2, 13.5); d.lineTo(14, 13.5); d.stroke(); d.beginPath()
            d.roundRect(4, 2.5, 3, 9, 0.8); d.roundRect(9, 6, 3, 5.5, 0.8); d.fill()
        } else if (s == "distributeH") {
            d.moveTo(2, 2); d.lineTo(2, 14); d.moveTo(14, 2); d.lineTo(14, 14); d.stroke(); d.beginPath()
            d.roundRect(6.5, 4.5, 3, 7, 0.8); d.fill()
        } else if (s == "distributeV") {
            d.moveTo(2, 2); d.lineTo(14, 2); d.moveTo(2, 14); d.lineTo(14, 14); d.stroke(); d.beginPath()
            d.roundRect(4.5, 6.5, 7, 3, 0.8); d.fill()
        } else if (s == "front") {
            d.roundRect(2, 2, 8, 8, 1.2); d.stroke(); d.beginPath(); d.roundRect(6, 6, 8, 8, 1.2); d.fill()
        } else if (s == "back2") {
            d.roundRect(6, 6, 8, 8, 1.2); d.stroke(); d.beginPath(); d.roundRect(2, 2, 8, 8, 1.2); d.fill()
        } else if (s == "forward") {
            d.moveTo(8, 13.5); d.lineTo(8, 4); d.moveTo(4.5, 7.5); d.lineTo(8, 4); d.lineTo(11.5, 7.5); d.moveTo(3, 2); d.lineTo(13, 2); d.stroke()
        } else if (s == "backward") {
            d.moveTo(8, 2.5); d.lineTo(8, 12); d.moveTo(4.5, 8.5); d.lineTo(8, 12); d.lineTo(11.5, 8.5); d.moveTo(3, 14); d.lineTo(13, 14); d.stroke()
        } else if (s == "group") {
            d.setLineDash([1.6, 1.8]); d.roundRect(1.5, 1.5, 13, 13, 2); d.stroke(); d.setLineDash([]); d.beginPath()
            d.roundRect(4, 4, 4.5, 4.5, 0.8); d.roundRect(7.5, 7.5, 4.5, 4.5, 0.8); d.fill()
        } else if (s == "ungroup") {
            d.roundRect(2, 2, 6, 6, 1); d.roundRect(8, 8, 6, 6, 1); d.stroke()
        } else if (s == "slide") {
            d.roundRect(1.5, 3.5, 13, 9, 1.6); d.stroke()
        } else if (s == "check") {
            d.moveTo(3, 8.5); d.lineTo(6.5, 12); d.lineTo(13, 4.5); d.stroke()
        } else if (s == "sync") {             // two arcs chasing
            d.arc(8, 8, 5.5, Math.PI * 1.1, Math.PI * 1.9); d.moveTo(13.2, 5.6); d.lineTo(13.4, 2.8); d.moveTo(13.2, 5.6); d.lineTo(10.6, 5.2)
            d.moveTo(13.5, 8); d.arc(8, 8, 5.5, Math.PI * 0.1, Math.PI * 0.9); d.moveTo(2.8, 10.4); d.lineTo(2.6, 13.2); d.moveTo(2.8, 10.4); d.lineTo(5.4, 10.8)
            d.stroke()
        } else if (s == "offline") {          // a cloud, struck through
            d.moveTo(4.5, 12.5); d.bezierCurveTo(2.4, 12.5, 1.5, 11, 1.5, 9.8); d.bezierCurveTo(1.5, 8.2, 2.8, 7, 4.3, 7.1)
            d.bezierCurveTo(4.8, 4.7, 6.6, 3.5, 8.5, 3.5); d.bezierCurveTo(11, 3.5, 12.6, 5.4, 12.6, 7.4)
            d.bezierCurveTo(13.9, 7.6, 14.5, 8.7, 14.5, 9.9); d.bezierCurveTo(14.5, 11.4, 13.3, 12.5, 11.8, 12.5); d.closePath()
            d.moveTo(2.5, 2); d.lineTo(14, 14.5); d.stroke()
        } else if (s == "lock") {             // linked proportions
            d.roundRect(3, 7, 10, 7, 1.6); d.moveTo(5.2, 7); d.lineTo(5.2, 5); d.arc(8, 5, 2.8, Math.PI, 0); d.lineTo(10.8, 7); d.stroke()
        } else if (s == "italic") {
            d.moveTo(7, 3); d.lineTo(12, 3); d.moveTo(4, 13); d.lineTo(9, 13); d.moveTo(9.5, 3); d.lineTo(6.5, 13); d.stroke()
        } else if (s == "textLeft") {
            for (const [y, w] of [[3.5, 12], [6.5, 8], [9.5, 12], [12.5, 7]]) { d.moveTo(2, y); d.lineTo(2 + w, y) }
            d.stroke()
        } else if (s == "textCenter") {
            for (const [y, w] of [[3.5, 12], [6.5, 8], [9.5, 12], [12.5, 7]]) { d.moveTo(8 - w / 2, y); d.lineTo(8 + w / 2, y) }
            d.stroke()
        } else if (s == "textRight") {
            for (const [y, w] of [[3.5, 12], [6.5, 8], [9.5, 12], [12.5, 7]]) { d.moveTo(14 - w, y); d.lineTo(14, y) }
            d.stroke()
        } else if (s == "warn") {
            d.moveTo(8, 2); d.lineTo(14.5, 13.5); d.lineTo(1.5, 13.5); d.closePath(); d.moveTo(8, 6.5); d.lineTo(8, 9.5); d.stroke()
            d.beginPath(); d.arc(8, 11.6, 0.9, 0, 6.3); d.fill()
        } else if (s == "none") {             // no colour: a slash in a box
            d.roundRect(2, 2, 12, 12, 2); d.moveTo(3, 13); d.lineTo(13, 3); d.stroke()
        } else if (s == "chevronDown") {
            d.moveTo(4, 6); d.lineTo(8, 10); d.lineTo(12, 6); d.stroke()
        } else {
            d.roundRect(3, 3, 10, 10, 2); d.stroke()
        }
        }
    ]


// The logo: a coral tile holding a slide whose corner is a play mark — making
// a presentation, and giving it.

class Logo [ width = 32, height = 32,
    draw(d: DrawContext) {
        const s = d.w / 32
        d.scale(s, s)
        d.fillStyle = provided("theme").spark
        d.beginPath(); d.roundRect(0, 0, 32, 32, 9); d.fill()
        d.fillStyle = 0xFFFFFF
        d.beginPath(); d.roundRect(6, 8.5, 20, 13.5, 2.6); d.fill()
        d.fillStyle = provided("theme").spark
        d.beginPath(); d.moveTo(13.2, 11.6); d.lineTo(20.2, 15.25); d.lineTo(13.2, 18.9); d.closePath(); d.fill()
        d.fillStyle = 0xFFFFFF
        d.beginPath(); d.roundRect(11, 24.2, 10, 2.4, 1.2); d.fill()
        }
    ]


// The wordmark: the logo and the name, in the brand face.

class Wordmark [
    size: number = 22,
    layout: SimpleLayout [ axis = x, spacing = { classroot.size * 0.38 }, align = center ],
    Logo [ width = { classroot.size * 1.35 }, height = { this.width } ],
    Text [ fontFamily = { app.brandFace }, fontSize = { classroot.size }, fontWeight = 800, letterSpacing = { -classroot.size * 0.03 },
        textColor = { provided("theme").ink }, text = "Presentify" ]
    ]


// ── Small controls ──────────────────────────────────────────────────────────
//
// Something a person presses is a `Control`: focus, Space and Enter, and
// `disabled` come with it. Each use site says what pressing does in `press()`.

// An icon button: the top bar's undo and redo, the inspector's arrange row.
// `tooltipLabel` names it to a pointer resting on it; `accessibilityLabel`
// to a screen reader. They are the same words.

class IconButton extends Control [ width = 32, height = 32, cornerRadius = 8,
    shape: string = "",
    tip: string = "",
    on: boolean = false,
    tone: Color = { provided("theme").text },
    tooltipLabel = { tip },
    accessibilityLabel = { tip },
    opacity = { disabled ? 0.35 : 1 },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    accessibilityPressed = { on },
    State [ applied = { classroot.on }, fill = { provided("theme").controlSelected } ],
    Mark [ x = center, y = center, iconSize = 16, shape = { classroot.shape },
        ink = { classroot.on ? provided("theme").accent : classroot.tone } ]
    ]


// A tool in the top bar: an icon over its name, lit while chosen. The tools
// are the choices of one ChoiceControl, so a screen reader hears one of five.

class ToolChoice extends ChoiceItem [ width = { app.compactTools ? 40 : 54 }, height = 44, cornerRadius = 10,
    shape: string = "",
    name: string = "",
    key: string = "",
    chosen: boolean = { classroot.on },
    tooltipLabel = { name + "  (" + key + ")" },
    accessibilityLabel = { name },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").hover : null },
    State [ applied = { classroot.chosen }, fill = { provided("theme").controlSelected } ],
    layout: SimpleLayout [ axis = y, spacing = 2, align = center ],
    padding = { [app.compactTools ? 13 : 6, 0, 0, 0] },
    Mark [ iconSize = 18, shape = { classroot.shape },
        ink = { classroot.chosen ? provided("theme").accent : provided("theme").text } ],
    Text [ visible = { !app.compactTools }, fontSize = 10.5, fontWeight = { classroot.chosen ? 600 : 500 }, wrap = false,
        textColor = { classroot.chosen ? provided("theme").accent : provided("theme").textMuted }, text = { classroot.name } ]
    ]


// A labelled pill button: "Slide" in the bar, "Present" in coral.

class Pill extends Control [ height = 34, cornerRadius = 17, padding = [0, 14, 0, 11],
    label: string = "",
    shape: string = "",
    tip: string = "",
    loud: boolean = false,
    tooltipLabel = { tip },
    accessibilityLabel = { label },
    opacity = { disabled ? 0.45 : 1 },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : provided("theme").control },
    State [ applied = { classroot.loud },
        fill = { pressed ? provided("theme").sparkPressed : hovered ? provided("theme").sparkHovered : provided("theme").spark } ],
    layout: SimpleLayout [ axis = x, spacing = 7, align = center ],
    Mark [ iconSize = 14, weight = 1.9, shape = { classroot.shape }, visible = { classroot.shape != "" },
        ink = { classroot.loud ? 0xFFFFFF : provided("theme").text } ],
    TextLabel [ fontSize = 13.5, fontWeight = 600, wrap = false,
        textColor = { classroot.loud ? 0xFFFFFF : provided("theme").text }, text = { classroot.label } ]
    ]


// A pop-up menu's button in the top bar: a word and a chevron.

class MenuWord extends Control [ height = 30, cornerRadius = 7, padding = [0, 6, 0, 8],
    label: string = "",
    accessibilityLabel = { label },
    fill = { pressed || menuOpen ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    layout: SimpleLayout [ axis = x, spacing = 4, align = center ],
    TextLabel [ fontSize = 13.5, fontWeight = 500, wrap = false, textColor = { provided("theme").text }, text = { classroot.label } ],
    Mark [ iconSize = 12, weight = 1.7, shape = "chevronDown", ink = { provided("theme").textMuted } ]
    ]


// A colour, shown: a swatch with the value beside it, or "None", or "Mixed"
// when the selection's things differ. Pressing it opens the shared colour
// popover for whichever colour it shows (`which`).

class ColorWell extends Control [ height = 32, cornerRadius = 8, padding = [0, 10, 0, 5],
    which: "fill" | "stroke" | "text" | "background" = "fill",
    value: string = "",
    mixed: boolean = false,
    noneAllowed: boolean = true,
    label: string = "",
    accessibilityLabel = { label + ": " + classroot.words },
    tooltipLabel = { label },
    words: string = { mixed ? "Mixed" : value == "" ? "None" : value.toUpperCase() },
    opacity = { disabled ? 0.4 : 1 },
    stroke = { stroke(1, provided("theme").line) },
    fill = { hovered ? provided("theme").hover : provided("theme").surface },
    press() { app.openColors(this) },
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    chip: View [ width = 22, height = 22, cornerRadius = 6, clip = true,
        stroke = { stroke(1, 0x00000022) },
        fill = { classroot.mixed ? null : col(classroot.value) },

        // none: a red slash; mixed: two halves

        draw(d: DrawContext) {
            if (classroot.mixed) {
                d.fillStyle = 0xFF5C39; d.beginPath(); d.moveTo(0, 0); d.lineTo(d.w, 0); d.lineTo(0, d.h); d.closePath(); d.fill()
                d.fillStyle = 0x6246EA; d.beginPath(); d.moveTo(d.w, 0); d.lineTo(d.w, d.h); d.lineTo(0, d.h); d.closePath(); d.fill()
            } else if (classroot.value == "") {
                d.strokeStyle = 0xD92D20; d.lineWidth = 1.6; d.beginPath(); d.moveTo(3, d.h - 3); d.lineTo(d.w - 3, 3); d.stroke()
            }
            }
        ],
    TextLabel [ fontSize = 12.5, fontWeight = 500, wrap = false, numeralWidth = tabular,
        textColor = { classroot.mixed ? provided("theme").textMuted : provided("theme").text }, text = { classroot.words } ]
    ]


// One colour in the popover's grid.

class Swatch extends Control [ width = 26, height = 26, cornerRadius = 7,
    hex: string = "",
    on: boolean = false,
    accessibilityLabel = { hex },
    accessibilityPressed = { on },
    tooltipLabel = { hex },
    fill = { col(hex) },
    stroke = { on ? stroke(2, provided("theme").accent) : hovered ? stroke(2, provided("theme").lineStrong) : stroke(1, 0x0000001A) },
    scale = { pressed ? 0.9 : 1 },
    pivotX = 13, pivotY = 13
    ]


// An inspector section: a small caps heading over its rows. `off` dims the
// section and says why, without the panel changing shape.

class Section [ width = 100%, padding = [14, 16, 14, 16],
    title: string = "",
    off: boolean = false,
    why: string = "",
    stroke = { [null, null, stroke(1, provided("theme").line), null] },
    layout: SimpleLayout [ axis = y, spacing = 10 ],
    defaultPlacement = body,
    head: View [ width = 100%, height = 16,
        Text [ fontSize = 11, fontWeight = 700, letterSpacing = 0.6, textTransform = uppercase, wrap = false,
            textColor = { provided("theme").textMuted }, text = { classroot.title } ],
        Text [ x = end, fontSize = 11, wrap = false, visible = { classroot.off && classroot.why != "" },
            textColor = { provided("theme").textFaint }, text = { classroot.why } ]
        ],
    body: View [ width = 100%, opacity = { classroot.off ? 0.45 : 1 }, pointerEvents = { classroot.off ? "none" : "auto" },
        layout: SimpleLayout [ axis = y, spacing = 10 ]
        ]
    ]


// A row in a section: a label, then its controls.

class Row [ width = 100%, height = 32,
    label: string = "",
    layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
    defaultPlacement = slot,
    Text [ width = 64, visible = { classroot.label != "" }, fontSize = 12.5, wrap = false, textColor = { provided("theme").textMuted }, text = { classroot.label } ],
    slot: View [ flexes = true, height = 32,
        layout: SimpleLayout [ axis = x, spacing = 6, align = center ]
        ]
    ]


// A number typed in the inspector: X, Y, size, outline width. It says
// "Mixed" when the selection's values differ, and "—" when there is none,
// and commits once, when the person leaves it or presses Return, so a typed
// number is one step of undo. Each use site's `commit` says where it goes.

class NumberBox extends TextInput [ height = 30, padding = [0, 8, 0, 8], fontSize = 12.5, numeralWidth = tabular,
    cornerRadius = 7, commitOn = "end",
    num: number = 0,
    mixed: boolean = false,
    nothing: boolean = false,
    value = { mixed || nothing ? "" : String(Math.round(num * 10) / 10) },
    placeholder = { mixed ? "Mixed" : nothing ? "—" : "" },
    admit(t: string) -> string | null { return /^-?[0-9]*\.?[0-9]*$/.test(t) ? t : null },
    commit(t: string) { }
    ]
