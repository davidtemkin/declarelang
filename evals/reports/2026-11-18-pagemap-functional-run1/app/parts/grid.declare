/*
# Pagemap: the plan of pages

Every page of the issue in book order, in its spreads, as one surface. A page is a `PageCell`,
one per record of the App's `cells` dataset; `PlanLayout` places them, a spread to a pair of
slots, as many spreads to a row as fit. It glides: when pages change places — by anyone's
hand — each page travels from where it was to where it now is, which is how a person sees
what moved and where it went.

How close the plan is drawn is one number, `app.pageW`; what a page says grows with it.
*/

// ── The layout ──────────────────────────────────────────────────────────────────────────────

class PlanLayout extends TweenLayout [ duration = 520,
    cellW: number = 80,
    cellH: number = 140,
    gap: number = 22,
    rowGap: number = 10,
    pair: boolean = true,
    place() {
        const w = this.contentExtent("width")
        const spreadW = this.pair ? 2 * this.cellW : this.cellW
        const per = Math.max(1, Math.floor((w + this.gap) / (spreadW + this.gap)))
        const used = per * spreadW + (per - 1) * this.gap
        const left = Math.max(0, Math.floor((w - used) / 2))
        let ordinal = -1
        let last = -1
        return this.laid().map((c) => {
            const cell = c as PageCell
            if (cell.hidden) return ({ x: left, y: 0, vis: false })
            if (cell.spread != last) { ordinal = ordinal + 1; last = cell.spread }
            const col = ordinal % per
            const row = Math.floor(ordinal / per)
            const inner = this.pair && cell.side != "left" ? this.cellW : 0
            return ({ x: left + col * (spreadW + this.gap) + inner, y: row * (this.cellH + this.rowGap), vis: true })
            })
        }
    ]


// ── A page ──────────────────────────────────────────────────────────────────────────────────
//
// Above the sheet, the section's color, and its name where the section begins; on the sheet,
// its regions, or its artwork; below it, the folio and the page's marks. A page is a control:
// a click or Return works on it, Shift extends to a run, ⌘ (Ctrl) adds or takes away one.

class PageCell extends Control [
    pid: string = { :id ?? "" },
    page: Page? = { :page },
    folio: string = { :folio ?? "" },
    side: string = { :side ?? "" },
    spread: number = { :spread ?? 0 },
    hidden: boolean = { :hidden ?? false },
    match: boolean = { :match ?? true },
    sectionColor: Color = { Color.from(:sectionColor ?? "#999999") },
    selected: boolean = { app.sel.includes(classroot.pid) },
    current: boolean = { app.pageId == classroot.pid },
    moving: boolean = { app.movingIds.includes(classroot.pid) },
    target: boolean = { app.moveTarget == classroot.pid },
    peer: boolean = { (:peer ?? "") != "" },
    pw: number = { app.pageW },
    ph: number = { app.pageH },
    detail: number = { app.pageW < 70 ? 0 : app.pageW < 150 ? 1 : 2 },
    rects: array = { regionRects(:page.layout, :page.turn, :page.flip) },
    showArt: boolean = { app.artMode && (:page.art ?? null) != null },
    width = { classroot.pw },
    height = { app.cellH },
    opacity = { classroot.match || classroot.moving ? 1 : 0.28 },
    accessibilityRole = button,
    accessibilityLabel = { app.describePage(:@) },
    accessibilityPressed = { classroot.selected },
    press() { app.pressPage(classroot.pid) },
    onDoubleClick() { app.read(classroot.pid) },
    onContextMenu(e: PointerEvent) { app.pressPage(classroot.pid); app.pageMenu.showAt(this, e) },
    onHold(e: PointerEvent) { app.selectOnly(classroot.pid); app.pageMenu.showAt(this, e) },
    keyBindings = { [
        ({ key: "ArrowRight", command: "step", args: [1] }),
        ({ key: "ArrowLeft", command: "step", args: [-1] }),
        ({ key: "Shift+ArrowRight", command: "extend", args: [1] }),
        ({ key: "Shift+ArrowLeft", command: "extend", args: [-1] }),
        ({ key: "Space", command: "toggle" })
        ] },
    step(d: number) { app.stepFocus(classroot.pid, d, false) },
    extend(d: number) { app.stepFocus(classroot.pid, d, true) },
    toggle() { app.toggleSel(classroot.pid) },

    // ── the section strip: its color, and its name where it begins

    strip: View [ width = 100%, height = 14,
        bar: View [ y = 9, width = 100%, height = 4, fill = { classroot.sectionColor },
            cornerRadius = { [(:starts ?? false) ? 2 : 0, (:ends ?? false) ? 2 : 0, (:ends ?? false) ? 2 : 0, (:starts ?? false) ? 2 : 0] } ],
        name: Text [ visible = { :starts ?? false }, y = -3, width = { classroot.side == "left" ? classroot.pw * 2 : classroot.pw }, fontSize = 10, fontWeight = semibold,
            wrap = false, maxLines = 1, textColor = { provided("theme").textMuted }, text = { :sectionName ?? "" } ]
        ],

    // ── the sheet

    sheet: View [ y = 14, width = { classroot.pw }, height = { classroot.ph }, clip = true,
        fill = { provided("theme").sheet },
        stroke = { Stroke(1, provided("theme").sheetLine) },

        // How the sheet is outlined says what is happening to it; a later state wins.

        State [ applied = { :fresh ?? false }, stroke = { Stroke(2, provided("theme").fresh) } ],
        State [ applied = { classroot.moving }, stroke = { Stroke(2, provided("theme").moving) } ],
        State [ applied = { classroot.target }, stroke = { Stroke(2, provided("theme").landing) } ],
        State [ applied = { classroot.selected }, stroke = { Stroke(2, provided("theme").picked) } ],
        State [ applied = { classroot.current }, stroke = { Stroke(2.5, provided("theme").picked) } ],

        // the regions, as the layout divides the page

        regions: View [ visible = { !classroot.showArt }, width = 100%, height = 100%,
            View [ datapath = :page.regions[],
                rect: object = { classroot.rects[rowIndex] ?? ({ x: 0, y: 0, w: 1, h: 1 }) },
                kind: string = { :kind ?? "unassigned" },
                words: string = { app.regionWords(:@) },
                x = { this.rect.x * classroot.pw + 1.5 }, y = { this.rect.y * classroot.ph + 1.5 },
                width = { Math.max(0, this.rect.w * classroot.pw - 3) }, height = { Math.max(0, this.rect.h * classroot.ph - 3) },
                cornerRadius = 2, clip = true,
                fill = { this.kind == "editorial" ? provided("theme").editorial : this.kind == "advertising" ? provided("theme").advert : null },
                stroke = { this.kind == "unassigned" ? Stroke(1, provided("theme").openLine) : null },
                Text [ x = 3, y = 2, width = { Math.max(0, parent.width - 6) }, visible = { classroot.detail > 0 && parent.height > 14 },
                    fontSize = { classroot.detail == 2 ? 11 : 9 }, fontWeight = { parent.kind == "unassigned" ? "regular" : "medium" },
                    maxLines = { Math.max(1, Math.floor((parent.height - 4) / (classroot.detail == 2 ? 14 : 11))) },
                    textColor = { parent.kind == "editorial" ? provided("theme").editorialInk : parent.kind == "advertising" ? provided("theme").advertInk : provided("theme").openInk },
                    text = { parent.words } ]
                ]
            ],

        // the artwork, when it is shown and the page has some

        art: Image [ exists = { classroot.showArt }, width = 100%, height = 100%, fit = cover,
            source = { app.artSource(:page.art, classroot.pw, classroot.artUrl) } ],

        // someone else is working on this page

        peerBadge: View [ visible = { classroot.peer }, x = { parent.width - this.width - 2 }, y = 2, height = 14, cornerRadius = 7,
            padding = [0, 4, 0, 4], fill = { Color.from(:peerColor ?? "#80a7ff") },
            TextLabel [ y = center, fontSize = 8, fontWeight = bold, textColor = #1E1D1A, text = { :peer ?? "" } ]
            ]
        ],

    // ── the folio on the page's outer edge, as a printed book has it; the marks on the inner

    outer: boolean = { classroot.side != "left" },
    foot: View [ y = { 14 + classroot.ph + 2 }, width = 100%, height = 16,
        folioText: Text [ x = { classroot.outer ? parent.width - this.width : 0 }, y = center, fontSize = { classroot.pw < 56 ? 9 : 11 },
            fontWeight = bold, wrap = false,
            textColor = { classroot.current || classroot.selected ? provided("theme").picked : provided("theme").text },
            text = { classroot.folio } ],
        marks: View [ x = { classroot.outer ? 0 : parent.width - this.width }, y = center,
            layout: SimpleLayout [ axis = x, spacing = 2, align = center ],
            Glyph [ visible = { :page.locked ?? false }, shape = "lock", iconSize = 10, weight = 1.3, ink = { provided("theme").textMuted } ],
            Glyph [ visible = { app.hasAd(:page) }, shape = "ad", iconSize = 10, weight = 1.3, ink = { provided("theme").advertInk } ],
            Glyph [ visible = { (:page.art ?? null) != null && classroot.pw >= 56 }, shape = "art", iconSize = 10, weight = 1.3, ink = { provided("theme").textMuted } ],
            Glyph [ visible = { (:page.notes ?? "") != "" }, shape = "note", iconSize = 10, weight = 1.3, ink = { provided("theme").textMuted } ],
            Glyph [ visible = { (:comments ?? 0) > 0 }, shape = "comment", filled = true, iconSize = 10, weight = 1.3, ink = { provided("theme").accent } ],
            tags: View [ layout: SimpleLayout [ axis = x, spacing = 1 ],
                Dot [ datapath = :page.tags[], width = 6, height = 6, cornerRadius = 3, tone = { app.tagHex(:@) } ]
                ]
            ]
        ],

    // ── a stitch-in follows this page: a tab past its outer edge

    stitchMark: View [ visible = { :stitch ?? false }, x = { classroot.pw - 3 }, y = { 14 + classroot.ph * 0.25 }, width = 6,
        height = { classroot.ph * 0.5 }, cornerRadius = 3, fill = { provided("theme").warn }, tooltipLabel = "A stitch-in follows this page" ],

    // ── where moving pages would land

    landBefore: View [ visible = { classroot.target && app.moveWhere == "before" }, x = -5, y = 12, width = 4,
        height = { classroot.ph + 4 }, cornerRadius = 2, fill = { provided("theme").landing } ],
    landAfter: View [ visible = { classroot.target && app.moveWhere == "after" }, x = { classroot.pw + 1 }, y = 12, width = 4,
        height = { classroot.ph + 4 }, cornerRadius = 2, fill = { provided("theme").landing } ],

    // ── a PDF page's picture, drawn once it is asked for

    artUrl: string = "",
    artKey: string = { app.artKey(:page.art, classroot.pw) },
    trackChanges = ["artKey"],
    onChange() { app.loadArt(this) },
    onInit() { app.loadArt(this) }
    ]
