/*
# The Venue: the tickets

What someone holds up at the door with a queue behind them: one ticket at a
time, its seat in the largest type on it, the performance and when to
arrive above, and a barcode the scanner reads below. `venue.declare`
includes this file.
*/

// The barcode, drawn bar by bar from the ticket's code (Code 39, see
// `code39` in venue-model.declare), filling the width it is given. Black on
// white whatever the theme: a scanner wants contrast.

class Barcode [ height = 84,
    code: string = "",
    accessibilityRole = image,
    accessibilityLabel = { "Barcode " + classroot.code },
    draw(d: DrawContext) {
        const runs = code39(code)
        const units = runs.reduce((n, r) => n + r[1], 0)
        const u = width / units
        let x = 0
        d.fillStyle = 0x111111
        for (const r of runs) {
            if (r[0] == 1) d.fillRect(x, 0, r[1] * u, height)
            x = x + r[1] * u
            }
        }
    ]


// A fact on the ticket: a small caption over its value.

class TicketFact [
    caption: string = "",
    value: string = "",
    big: boolean = false,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 1.4, textTransform = uppercase,
        textColor = { provided("theme").ticketMuted }, text = { classroot.caption } ],
    Text [ fontFamily = { classroot.big ? app.display : app.ui }, fontSize = { classroot.big ? 40 : 19 },
        fontWeight = semibold, numeralWidth = tabular, wrap = false,
        textColor = { provided("theme").ticketInk }, text = { classroot.value } ]
    ]


// One ticket. The perforation between its two halves is drawn: two notches
// and a dashed line, where a paper ticket would tear.

class TicketCard [ width = { Math.min(360, app.width - 40) },
    index: number = 0,
    count: number = 1,
    cornerRadius = 22,
    fill = { provided("theme").ticket },
    shadow = { shadow(0, 18, 40, 0x00000047) },
    accessibilityRole = group,
    accessibilityLabel = { "Ticket " + (classroot.index + 1) + " of " + classroot.count + ", "
        + (:section ?? "") + ", row " + (:row ?? "") + ", seat " + (:number ?? 0) },
    layout: SimpleLayout [ axis = y ],

    top: View [ width = 100%, padding = [22, 24, 20, 24],
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        View [ width = 100%,
            layout: SimpleLayout [ axis = x, align = baseline ],
            Text [ flexes = true, fontSize = 11, fontWeight = semibold, letterSpacing = 1.6, textTransform = uppercase,
                textColor = { provided("theme").accent }, text = { app.production.value?.hall ?? "" } ],
            Text [ fontSize = 12, numeralWidth = tabular, textColor = { provided("theme").ticketMuted },
                text = { (classroot.index + 1) + " of " + classroot.count } ]
            ],
        Text [ width = 100%, wrap = true, fontFamily = { app.display }, fontSize = 27, fontWeight = semibold,
            lineHeight = 1.1, textColor = { provided("theme").ticketInk },
            text = { app.production.value?.title ?? "" } ],
        when: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 22 ],
            TicketFact [ caption = "Date", value = { dayLabel(app.receiptPerf?.startsAt ?? "") } ],
            TicketFact [ caption = "Curtain", value = { timeLabel(app.receiptPerf?.startsAt ?? "") } ],
            TicketFact [ caption = "Arrive by", value = { timeLabel(app.receiptPerf?.doorsAt ?? "") } ]
            ]
        ],

    tear: View [ width = 100%, height = 22,
        draw(d: DrawContext) {
            const t = provided("theme")
            d.fillStyle = t.ticketNotch
            d.beginPath(); d.arc(0, 11, 11, -1.58, 1.58); d.fill()
            d.beginPath(); d.arc(width, 11, 11, 1.56, 4.72); d.fill()
            d.strokeStyle = t.ticketRule
            d.lineWidth = 1.5
            for (let x = 20; x < width - 20; x = x + 10) { d.beginPath(); d.moveTo(x, 11); d.lineTo(x + 5, 11); d.stroke() }
            }
        ],

    seat: View [ width = 100%, padding = [12, 24, 6, 24],
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        Text [ fontSize = 13, fontWeight = semibold, letterSpacing = 1.4, textTransform = uppercase,
            textColor = { provided("theme").ticketInk }, text = { :section ?? "" } ],
        View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 28 ],
            TicketFact [ caption = "Row", value = { :row ?? "" }, big = true ],
            TicketFact [ caption = "Seat", value = { "" + (:number ?? 0) }, big = true ]
            ]
        ],

    code: View [ width = 100%, padding = [16, 24, 22, 24],
        layout: SimpleLayout [ axis = y, spacing = 8, align = center ],
        Barcode [ width = 100%, code = { :barcode ?? "" } ],
        Text [ fontSize = 13, letterSpacing = 2.4, numeralWidth = tabular, textColor = { provided("theme").ticketMuted },
            text = { :barcode ?? "" } ]
        ]
    ]
