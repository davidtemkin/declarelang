/*
# The compiler's trace

One line from the homepage's spring demo, as the compiler leaves it: the
source, the resolved form, the read-paths, and the kernel code — copied
verbatim from the compiled artifact, not reconstructed. It sits inline in the
reading column, as a specimen the prose points at.
*/

// one row of the trace: what it is, and the text in a well

class TraceRow extends View [
    what: string = "",
    hue: Color = gray,
    html: string = "",
    layout: ResponsiveLayout [ plan = { [({ from: 640, flow: "row", gap: 16, share: ({ tag: 20, code: 80 }) }),
        ({ from: 0, flow: "stack", gap: 8, share: ({ tag: 100, code: 100 }) })] } ],

    tag: Eyebrow [ text = { classroot.what }, textColor = { classroot.hue } ],
    code: Well [
        HTMLText [ fontSize = 13, lineHeight = 1.45,
            fontFamily = ["SF Mono", "ui-monospace", "Menlo", "monospace"],
            bodyColor = { provided("theme").ink }, html = { classroot.html },
            textStyles = { { p: { textColor: provided("theme").accent, fontWeight: "semibold" },
                n: { textColor: provided("theme").faint } } } ]
        ]
    ]


class Trace extends Plate [ width = 100%, gap = 14,
    TraceRow [ what = "You wrote", hue = { provided("theme").muted },
        html = "to = { on ? lane.width - ball.width : 0 }" ],
    TraceRow [ what = "Resolved", hue = { provided("theme").muted },
        html = "to = { <span class='p'>this.root.on</span> ? <span class='p'>parent.parent.parent.lane.width</span> - <span class='p'>parent.parent.ball.width</span> : 0 }" ],
    TraceRow [ what = "Read-paths", hue = { provided("theme").muted },
        html = "<span class='n'>0</span> <span class='p'>this.root.on</span><br><span class='n'>1</span> <span class='p'>parent.parent.parent.lane.width</span><br><span class='n'>2</span> <span class='p'>parent.parent.ball.width</span>" ],
    TraceRow [ what = "Kernel code", hue = { provided("theme").ker },
        html = "&quot;=E<span class='p'>L0</span> <span class='p'>L1</span> <span class='p'>L2</span> - K0 ?&quot; <span class='n'>— load 0, 1, 2 · subtract · push 0 · select</span>" ]
    ]
