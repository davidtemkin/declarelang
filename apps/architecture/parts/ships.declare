/*
# Fig. 4 — one program, three hosts

The stack of Fig. 1 drawn to scale: each block's AREA is its share of the
gzipped production bundle. The layer bands keep Fig. 1's order (app, library,
runtime, kernel) with heights proportional to bytes; the runtime band is
subdivided into its subsystems as a squarified treemap. A switch exchanges the
backend — the one block that differs between hosts — and every other block
holds still; on the Mac the kernel also leaves the bundle, linked into the
executable as C. Beneath, the same desktop program captured on all three hosts.

The arrangement is a `TweenLayout`. The sizes are a `Dataset` on the figure,
and the build on screen is one value beside it: each block reads its own size
from the two, the dimension column its bands, and the layout places the blocks
by the sizes they carry. A tween is the one
arrangement that does not re-place on its own, so the only imperative step is
the re-snapshot: the arranged view tracks the build and asks for a
`retarget(true)` once the settle has landed, and every block glides from where
it is to where the new numbers put it.

Figures: the DOM and canvas builds measured 2026-09-18 from `declarec`
production builds, gzip default level; per-subsystem bytes attributed through
source maps (two methods agree within ~1 KB per group). The Mac host loads a
platform runtime bundle rather than a per-app build, so its column reuses the
DOM build's attribution for the modules the two share and measures its own
backend the same way — minified and gzipped alone (the DOM backend so measured
lands within 0.2 KB of its attributed figure). Its kernel is native and not in
the JavaScript at all.
*/

// a layer's band in the plan, and one rect of the runtime's treemap

schema LayerBand [ layer: string, y: number, h: number, kb: number ]
schema Tile [ x: number, y: number, w: number, h: number ]

script {
    // the four layer bands, top to bottom, from each layer's KB in that order —
    // used by the layout (to place blocks) and by the dimension column (to
    // label them)
    const LAYERS = ["app", "lib", "run", "ker"]
    function bandsOf(kb: number[], H: number, gap: number): LayerBand[] {
        const order = LAYERS
        const all = kb.reduce((a, b) => a + b, 0)
        const usable = H - gap * 3
        let y = 0
        return order.map((L, i) => {
            const h = all <= 0 ? 0 : usable * kb[i] / all
            const band: LayerBand = { layer: L, y: y, h: h, kb: kb[i] }
            y = y + h + gap
            return band
            })
        }

    // squarified treemap (Bruls, Huizing, van Wijk) over a rectangle —
    // values in, one rect per value out, in the input order
    function squarify(values: number[], x: number, y: number, w: number, h: number): Tile[] {
        const out: Tile[] = values.map(() => ({ x: x, y: y, w: 0, h: 0 }))
        const idx = values.map((v, i) => i).filter((i) => values[i] > 0).sort((a, b) => values[b] - values[a])
        const total = idx.reduce((s, i) => s + values[i], 0)
        if (total <= 0 || w <= 0 || h <= 0) return out
        const scale = (w * h) / total
        let rx = x, ry = y, rw = w, rh = h
        let row: number[] = []
        const worst = (r: number[], side: number) => {
            const areas = r.map((i) => values[i] * scale)
            const s = areas.reduce((a, b) => a + b, 0)
            const mx = Math.max(...areas), mn = Math.min(...areas)
            return Math.max((side * side * mx) / (s * s), (s * s) / (side * side * mn))
            }
        const lay = (r: number[]) => {
            const s = r.reduce((a, i) => a + values[i] * scale, 0)
            if (rw >= rh) {
                const cw = s / rh
                let cy = ry
                for (const i of r) { const ch = (values[i] * scale) / cw; out[i] = { x: rx, y: cy, w: cw, h: ch }; cy += ch }
                rx += cw; rw -= cw
                }
            else {
                const ch = s / rw
                let cx = rx
                for (const i of r) { const cw = (values[i] * scale) / ch; out[i] = { x: cx, y: ry, w: cw, h: ch }; cx += cw }
                ry += ch; rh -= ch
                }
            }
        for (const i of idx) {
            const side = Math.min(rw, rh)
            if (row.length == 0 || worst(row.concat([i]), side) <= worst(row, side)) row.push(i)
            else { lay(row); row = [i] }
            }
        if (row.length > 0) lay(row)
        return out
        }
    }

// the arrangement: layer bands by bytes, the runtime band as a treemap

class Floorplan extends TweenLayout [
    gap: number = 3,
    place() {
        // the room this arrangement has — the arranged view's content box, not
        // its box: a strategy that reads `this.view.width` lays out at the
        // wrong number the moment anyone pads that view
        const W = this.contentExtent("width")
        const H = this.contentExtent("height")
        // each block carries its own size and layer, so the bands are the
        // blocks' sums and no table is kept here
        const kids = this.laid()
        const layerOf = kids.map((c) => (c as Block).layer)
        const vals = kids.map((c) => (c as Block).kb)
        const g = this.gap
        const bands = bandsOf(LAYERS.map((L) => vals.reduce((s, v, i) => layerOf[i] == L ? s + v : s, 0)), H, g)
        const boxes = kids.map(() => ({ x: 0, y: 0, w: W, h: 0, vis: true }))
        for (const b of bands) {
            const members = kids.map((c, i) => i).filter((i) => layerOf[i] == b.layer)
            if (b.layer == "run") {
                const rects = squarify(members.map((i) => vals[i]), 0, b.y, W, b.h + g)
                members.forEach((i, j) => {
                    const r = rects[j]
                    boxes[i] = { x: r.x, y: r.y, w: Math.max(0, r.w - g), h: Math.max(0, r.h - g), vis: true }
                    })
                }
            else {
                for (const i of members) boxes[i] = { x: 0, y: b.y, w: W - g, h: Math.max(1, b.h), vis: true }
                }
            }
        return boxes
        }
    ]


class Block [ cornerRadius = 5, clip = true,
    layer: string = "run",
    name: string = "",
    kb: number = 0,
    hue: Color = { this.layer == "app" ? provided("theme").app : this.layer == "lib" ? provided("theme").lib : this.layer == "ker" ? provided("theme").ker : provided("theme").run },
    fill = { this.hovered ? provided("theme").sunk : this.layer == "app" ? provided("theme").appSoft : this.layer == "lib" ? provided("theme").libSoft : this.layer == "ker" ? provided("theme").kerSoft : provided("theme").runSoft },
    stroke = { stroke(1, this.hue) },
    flat: boolean = { this.height < 58 && this.width > 280 },
    roomy: boolean = { !this.flat && this.width > 40 && this.height > 32 },
    n: Label [ x = 10, y = { classroot.flat ? (classroot.height - this.height) / 2 : 8 },
        fontSize = { classroot.width > 160 ? 14 : classroot.width > 70 ? 12 : 11 }, visible = { (classroot.roomy || classroot.flat) && classroot.height > 16 },
        width = { classroot.flat ? this.contentWidth : classroot.width - 16 }, wrap = { !classroot.flat },
        text = { classroot.name } ],
    v: Mono [ fontSize = 12, visible = { classroot.flat ? classroot.height > 16 : classroot.roomy && classroot.height > 58 },
        x = { classroot.flat ? classroot.width - this.width - 12 : 10 },
        y = { classroot.flat ? (classroot.height - this.height) / 2 : classroot.height - 22 },
        textColor = { provided("theme").lead },
        text = { classroot.kb.toFixed(1) + " KB" } ]
    ]


// the dimension column: one bracket per layer band, its name and its total

class Dim [ width = 100%,
    name: string = "",
    kb: number = 0,
    hue: Color = gray,
    ty: number = 0,
    draw(d: Draw) {
        d.strokeStyle = this.hue
        d.lineWidth = 1.5
        d.beginPath()
        d.moveTo(0, 1)
        d.lineTo(6, 1)
        d.moveTo(6, 1)
        d.lineTo(6, Math.max(1, d.h - 1))
        d.moveTo(0, Math.max(1, d.h - 1))
        d.lineTo(6, Math.max(1, d.h - 1))
        d.stroke()
        },

    // the label sits where the column's collision pass put it (ty, in the
    // column's coordinates), so a thin band's label never lands on its neighbour's

    t: View [ x = 16, y = { classroot.ty - classroot.y },
        layout: SimpleLayout [ axis = y, spacing = 1 ],
        Label [ fontSize = 13, textColor = { classroot.hue }, text = { classroot.name } ],
        Mono [ fontSize = 11.5, textColor = { provided("theme").muted }, text = { classroot.kb.toFixed(1) + " KB" } ]
        ]
    ]


// A band of the dimension column, following its band in the floorplan. Its
// label, its top and its height each ride a spring, so a band that changes
// size travels there rather than jumping; the floor under the height keeps a
// thin band legible, and a band held up by that floor is pulled up so its
// bracket never reaches below the floorplan.

class DimBand extends Dim [
    toTy: number = 0,
    toY: number = 0,
    toH: number = 0,
    shownH: number = { Math.max(12, this.toH) },
    Spring [ attribute = ty, to = { classroot.toTy }, stiffness = 120, damping = 20 ],
    Spring [ attribute = y, to = { Math.min(classroot.toY, classroot.parent.height - classroot.shownH) }, stiffness = 120, damping = 20 ],
    Spring [ attribute = height, to = { classroot.shownH }, stiffness = 120, damping = 20 ]
    ]


// one screenshot above its caption

class Shot [ cornerRadius = 8, clip = true,
    src: string = "",
    aspect: number = 0.7067,
    height = { this.width * this.aspect },
    stroke = { stroke(1, provided("theme").line) },
    shadow = { shadow(0, 4, 14, 0x00000024) },
    Image [ width = 100%, height = 100%, stretches = both, source = { classroot.src } ]
    ]


class ShotCol [
    src: string = "",
    caption: string = "",
    layout: Run [ spacing = 8 ],
    Shot [ src = { classroot.src } ],
    Note [ fontSize = 13, text = { classroot.caption } ]
    ]


class ShipsFig [
    build: string = "calDom",
    shown: number = 108.4,

    // gz KB per block, per build. The app/library split of the program literal
    // is by class name; `boot` folds in the 0.3 KB seam module.

    sizes: Dataset { {
        "calDom":    { "app": 11.1, "lib": 7.0, "core": 34.9, "view": 7.8, "backend": 10.5, "input": 7.1, "draw": 5.7,
                       "anim": 3.5, "text": 3.4, "boot": 2.5, "layout": 1.8, "themes": 1.7, "ker": 11.5 },
        "calCanvas": { "app": 11.1, "lib": 7.0, "core": 34.9, "view": 7.8, "backend": 14.2, "input": 9.6, "draw": 8.4,
                       "anim": 3.5, "text": 3.6, "boot": 2.5, "layout": 1.8, "themes": 1.7, "ker": 11.5 },
        "calMac":    { "app": 11.1, "lib": 7.0, "core": 34.9, "view": 7.8, "backend": 7.0, "input": 7.1, "draw": 5.7,
                       "anim": 3.5, "text": 3.4, "boot": 2.5, "layout": 1.8, "themes": 1.7, "ker": 0 },
        "totals":    { "calDom": 108.4, "calCanvas": 117.7, "calMac": 93.4 },
        "layers":    { "app": ["app"], "lib": ["lib"], "ker": ["ker"],
                       "run": ["core", "view", "backend", "input", "draw", "anim", "text", "boot", "layout", "themes"] } } },

    sizeOf(part: string) -> number { return this.sizes.value[this.build]?.[part] ?? 0 },
    layerKb(layer: string) -> number { return (this.sizes.value.layers[layer] as string[]).reduce((s, p) => s + this.sizeOf(p), 0) },

    layout: Run [ spacing = 14 ],

    head: View [
        Segmented [ x = center, width = { Math.min(420, parent.width) }, height = 32, value = { classroot.build },
            choices = { [ ({ id: "calDom", label: "DOM" }), ({ id: "calCanvas", label: "Canvas" }), ({ id: "calMac", label: "Mac host" }) ] },
            input(v: object) { classroot.build = "" + v }
            ]
        ],
    Spring [ attribute = shown, to = { classroot.sizes.value.totals[classroot.build] ?? 0 }, stiffness = 90, damping = 18 ],

    planH: number = { Math.max(300, Math.min(440, this.width * 0.46)) },
    bands: LayerBand[] = { bandsOf(LAYERS.map((L) => this.layerKb(L)), this.planH, 3) },

    // label tops for the dimension column: each at its band's centre, pushed
    // down past the one above, then back up from the bottom edge

    labelTops() -> number[] {
        const L = 34
        const c = [0, 1, 2, 3].map((i) => this.bands[i].y + this.bands[i].h / 2 - L / 2)
        c[0] = Math.max(0, c[0])
        for (let i = 1; i < 4; i++) c[i] = Math.max(c[i], c[i - 1] + L)
        c[3] = Math.min(c[3], this.planH - L)
        for (let i = 2; i >= 0; i--) c[i] = Math.min(c[i], c[i + 1] - L)
        c[0] = Math.max(0, c[0])
        return c
        },
    labelAt(i: number) -> number { return this.labelTops()[i] },

    stage: View [ height = { classroot.planH },
        // the floorplan centred on the figure, its dimension labels to the right:
        // an empty column on the left balances the label column on the right

        layout: ResponsiveLayout [ plan = { [({ from: 700, flow: "row", gap: 12, share: ({ balance: 11, plan: 78, dimcol: 11 }) }),
            ({ from: 0, flow: "row", gap: 0, share: ({ balance: 0, plan: 100, dimcol: 0 }) })] } ],

        balance: View [ height = 1 ],

        plan: View [ height = { classroot.planH },
            layout: Floorplan [ duration = 520 ],

            // The build the floorplan draws, as a plain constraint down the
            // tree, so a change of build is a change this view can see.
            //
            // A TweenLayout samples place() only when it is retargeted, which is
            // the one thing a constraint cannot do for it, so the re-snapshot is
            // asked for here: after the settle that changed the blocks' sizes,
            // which place() reads. A new build glides to its new arrangement; a new size is
            // simply a new snapshot, taken without animation.

            build: string = { classroot.build },
            trackChanges = ["width", "height", "build"],
            onChange(e: ChangeEvent) { this.layout.retarget(e.changed.some((c) => c.name == "build")) },

            Block [ layer = "app", kb = { classroot.sizeOf("app") }, name = "Your program",
                tooltipLabel = "The compiled program: tree, attributes, dependency lists, kernel code." ],
            Block [ layer = "lib", kb = { classroot.sizeOf("lib") }, name = "Library classes it uses",
                tooltipLabel = "Library classes compiled into the same program JSON as yours." ],
            Block [ layer = "run", kb = { classroot.sizeOf("core") }, name = "Reactive core, instantiation & data",
                tooltipLabel = "reactive, attributes, bind, instantiate, replicate, data, value, schema — the graph and the tree." ],
            Block [ layer = "run", kb = { classroot.sizeOf("backend") },
                name = { classroot.build == "calCanvas" ? "Canvas backend & compositor" : classroot.build == "calMac" ? "Mac backend — the bridge to the Swift host" : "DOM backend" },
                tooltipLabel = { classroot.build == "calMac" ? "Batches Surface calls into one op buffer per settle for the Swift host to apply." : "The renderer: one of two ships, chosen at build time." } ],
            Block [ layer = "run", kb = { classroot.sizeOf("view") }, name = "View",
                tooltipLabel = "view.ts — the element every visual thing extends." ],
            Block [ layer = "run", kb = { classroot.sizeOf("input") }, name = "Input, focus, gestures, scrolling",
                tooltipLabel = "Click resolution, hover chain, focus & keys, gesture claims; scroll physics on canvas." ],
            Block [ layer = "run", kb = { classroot.sizeOf("draw") }, name = "Draw & compositing",
                tooltipLabel = "Display lists, box paint, filters, the compositing pipeline." ],
            Block [ layer = "run", kb = { classroot.sizeOf("anim") }, name = "Springs & animators",
                tooltipLabel = "Spring, Animator, the frame clock." ],
            Block [ layer = "run", kb = { classroot.sizeOf("text") }, name = "Text & fonts",
                tooltipLabel = "Measurement, wrapping, font loading." ],
            Block [ layer = "run", kb = { classroot.sizeOf("boot") }, name = "Boot",
                tooltipLabel = "Entry, host wiring, the Surface interface." ],
            Block [ layer = "run", kb = { classroot.sizeOf("layout") }, name = "Layout",
                tooltipLabel = "1.8 KB: the strategies themselves are Declare, in the library." ],
            Block [ layer = "run", kb = { classroot.sizeOf("themes") }, name = "Themes",
                tooltipLabel = "Preset token records, when a program uses library widgets." ],
            Block [ layer = "ker", kb = { classroot.sizeOf("ker") },
                name = { classroot.build == "calMac" ? "Kernel — linked into the host as C" : "Kernel — WebAssembly + loader" },
                tooltipLabel = { classroot.build == "calMac" ? "The same C source, compiled into the executable: 36 KB of native code, none of it JavaScript." : "kernel.wasm (17 KB raw) inlined as base64, plus its 2.3 KB loader." } ]
            ],

        dimcol: View [ height = { classroot.planH },
            DimBand [ name = "App", hue = { provided("theme").app }, kb = { classroot.bands[0].kb },
                toTy = { classroot.labelAt(0) }, toY = { classroot.bands[0].y }, toH = { classroot.bands[0].h } ],
            DimBand [ name = "Library", hue = { provided("theme").lib }, kb = { classroot.bands[1].kb },
                toTy = { classroot.labelAt(1) }, toY = { classroot.bands[1].y }, toH = { classroot.bands[1].h } ],
            DimBand [ name = "Runtime", hue = { provided("theme").run }, kb = { classroot.bands[2].kb },
                toTy = { classroot.labelAt(2) }, toY = { classroot.bands[2].y }, toH = { classroot.bands[2].h } ],
            DimBand [ name = "Kernel", hue = { provided("theme").ker }, kb = { classroot.bands[3].kb },
                toTy = { classroot.labelAt(3) }, toY = { classroot.bands[3].y }, toH = { classroot.bands[3].h } ]
            ]
        ],

    // the same desktop, three hosts, window chrome and all — set off from the
    // floorplan by a spacer, and from each other by the row's gap

    View [ height = 14 ],

    shots: View [
        layout: ResponsiveLayout [ plan = { [({ from: 700, flow: "row", gap: 28, share: ({ sd: 33.33, sc: 33.33, sm: 33.33 }) }),
            ({ from: 0, flow: "stack", gap: 22, share: ({ sd: 100, sc: 100, sm: 100 }) })] } ],
        sd: ShotCol [ src = "resources/desktop-dom.webp", caption = "Browser · DOM" ],
        sc: ShotCol [ src = "resources/desktop-canvas.webp", caption = "Browser · drawn to pixels (?render=canvas)" ],
        sm: ShotCol [ src = "resources/desktop-mac.webp", caption = "Mac host · no browser in the process" ]
        ]
    ]
