/*
# Fig. 9 — the conformance oracle

The same behavioral questions put to all three renderers; the answers must be
byte-identical. Drawn as a small table: the question, the three answers, and
the verdict. The answers shown are illustrative paths of the kind the oracle
compares (view paths, offsets), not a recorded run.
*/

class Ans extends View [ height = 30, cornerRadius = 6,
    text: string = "",
    fill = { provided("theme").sunk },
    Mono [ x = 10, y = center, fontSize = 12, text = { classroot.text } ]
    ]


class Check extends View [ width = 24, height = 24, cornerRadius = 12, fill = { provided("theme").ink },
    draw(d: Draw) {
        d.strokeStyle = provided("theme").panel
        d.lineWidth = 2.2
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(7, 12.5)
        d.lineTo(10.5, 16)
        d.lineTo(17, 8.5)
        d.stroke()
        }
    ]


// The column model, once: the head and the rows divide the run by the same
// shares, which is what makes the table a table.

script {
    const ORACLE_COLS = { qc: 30, d: 20, c: 20, m: 20, ok: 6 }
    }

class OracleCols extends View [
    layout: ResponsiveLayout [ plan = { [({ from: 0, flow: "row", gap: 10, share: ORACLE_COLS })] } ]
    ]


// one row of the table: the question, the three answers, the verdict

class OracleRow extends OracleCols [ height = 46,
    q: string = "",
    a: string = "",
    qc: TextLabel [ fontSize = 14, fontWeight = medium, textColor = { provided("theme").ink }, text = { classroot.q } ],
    d: Ans [ y = 8, text = { classroot.a } ],
    c: Ans [ y = 8, text = { classroot.a } ],
    m: Ans [ y = 8, text = { classroot.a } ],
    ok: View [ Check [ x = center, y = 11 ]
        ]
    ]


class OracleHead extends OracleCols [ height = 30,
    qc: Eyebrow [ y = 8, text = "the question" ],
    d: Eyebrow [ y = 8, text = "DOM" ],
    c: Eyebrow [ y = 8, text = "Canvas" ],
    m: Eyebrow [ y = 8, text = "Mac" ],
    ok: Eyebrow [ y = 8, text = "same" ]
    ]


// the table scrolls sideways on a phone rather than crushing its columns

class OracleFig extends Plate [ gap = 0, scrolls = x,
    table: View [ atLeast: number = 760,
        layout: Run [ spacing = 0 ],
        OracleHead [ ],
        OracleRow [ q = "Where does this press land?", a = "app.dock.row.calIcon" ],
        Hair [ ],
        OracleRow [ q = "What does this scroll move?", a = "app.wins.1.body · y 320" ],
        Hair [ ],
        OracleRow [ q = "Who claims this wheel?", a = "app.board (onWheel)" ],
        Hair [ ],
        OracleRow [ q = "Where does Tab go next?", a = "app.form.email" ]
        ]
    ]
