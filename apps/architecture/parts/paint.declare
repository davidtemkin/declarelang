/*
# Fig. 7 — one recording, three realizations

A live `draw()` (a gauge), the display list it records — shown with its live
numbers, derived from the same value the drawing reads — and the three ways a
renderer consumes that one list. Then the compositing order every renderer
shares, as a strip.
*/

script {
    // the gauge's geometry, shared by the drawing and by the op listing so the
    // two can never disagree
    function sweep(level: number): number { return Math.PI * (1 + level / 100) }
    function r2(v: number): string { return (Math.round(v * 100) / 100).toString() }
    }

class Gauge extends View [ width = 200, height = 118,
    level: number = 62,
    hot: boolean = { this.level > 80 },
    draw(d: Draw) {
        d.lineWidth = 14
        d.lineCap = "round"
        d.strokeStyle = provided("theme").line
        d.beginPath()
        d.arc(100, 104, 78, Math.PI, Math.PI * 2, false)
        d.stroke()
        d.strokeStyle = this.hot ? provided("theme").ker : provided("theme").app
        d.beginPath()
        d.arc(100, 104, 78, Math.PI, sweep(this.level), false)
        d.stroke()
        },
    Text [ x = center, y = 70, fontSize = 26, fontWeight = semibold, textColor = { provided("theme").ink },
        text = { Math.round(classroot.level) + "%" } ]
    ]


// one realization: a lane with its host, what happens, and where it lives

class Realize extends View [
    host: string = "",
    what: string = "",
    file: string = "",
    layout: ResponsiveLayout [ plan = { [({ from: 0, flow: "row", gap: 14, share: ({ tag: 16, body: 84 }) })] } ],
    tag: View [ y = 2,
        chip: View [ width = 70, height = 26, cornerRadius = 6, fill = { provided("theme").hostSoft },
            stroke = { stroke(1, provided("theme").hostLine) },
            TextLabel [ x = center, fontSize = 13, fontWeight = semibold,
                fontFamily = ["Avenir Next Condensed", "Avenir Next", "Arial Narrow", "sans-serif"], text = { classroot.host } ]
            ]
        ],
    body: View [ layout: Run [ spacing = 4 ],
        Text [ fontSize = 14, lineHeight = 1.45, textColor = { provided("theme").body }, text = { classroot.what } ],
        Mono [ fontSize = 11.5, textColor = { provided("theme").faint }, text = { classroot.file } ]
        ]
    ]


// a stage of the compositing order

class Stage extends View [ height = 30, cornerRadius = 15,
    label: string = "",
    padding = [0, 13, 0, 13],
    fill = { provided("theme").panel }, stroke = { stroke(1, provided("theme").run) },
    t: Label [ y = center, fontSize = 13, text = { classroot.label } ]
    ]


class Arrow extends View [ width = 18, height = 30,
    draw(d: Draw) {
        d.strokeStyle = provided("theme").faint
        d.lineWidth = 1.5
        d.lineCap = "round"
        d.beginPath()
        d.moveTo(3, 15)
        d.lineTo(15, 15)
        d.moveTo(10, 10)
        d.lineTo(15, 15)
        d.lineTo(10, 20)
        d.stroke()
        }
    ]


class PaintFig extends View [
    level: number = 62,
    layout: Run [ spacing = 16 ],

    // the op list, as recorded — live numbers from the same level

    ops() -> string {
        const end = r2(sweep(this.level))
        const col = this.level > 80 ? "theme.ker" : "theme.app"
        return "lineWidth = 14<br>lineCap = &quot;round&quot;<br>strokeStyle = theme.line<br>beginPath()<br>arc(100, 104, 78, 3.14, 6.28)<br>stroke()<br>"
            + "strokeStyle = <span class='hi'>" + col + "</span><br>beginPath()<br>arc(100, 104, 78, 3.14, <span class='hi'>" + end + "</span>)<br>stroke()"
        },

    plate: Plate [
        cols: View [
            layout: ResponsiveLayout [ plan = { [({ from: 900, flow: "row", gap: 24, share: ({ c1: 23, c2: 29, c3: 48 }) }),
                ({ from: 0, flow: "stack", gap: 24, share: ({ c1: 100, c2: 100, c3: 100 }) })] } ],

            c1: View [ layout: Run [ spacing = 12 ],
                Eyebrow [ text = "1 · your draw()" ],
                box: View [ height = 150, cornerRadius = 10, fill = { provided("theme").sunk },
                    Gauge [ x = center, y = 18, level = { classroot.level } ]
                    ],
                Slider [ min = 0, max = 100, value = { classroot.level },
                    input(v: number) { classroot.level = v }
                    ],
                Note [ fontSize = 12.5, text = "Drag it. The drawing re-records because it read level; nothing redraws on a timer." ]
                ],

            c2: View [ layout: Run [ spacing = 12 ],
                Eyebrow [ text = "2 · the display list, abridged" ],
                Well [ pad = 14,
                    HTMLText [ fontSize = 12, lineHeight = 1.55,
                        fontFamily = ["SF Mono", "ui-monospace", "Menlo", "monospace"], bodyColor = { provided("theme").ink },
                        textStyles = { { hi: { textColor: provided("theme").accent, fontWeight: "semibold" } } },
                        html = { classroot.ops() } ]
                    ],
                Note [ fontSize = 12.5, text = "Plain data: every op can be copied, sent to a worker, or serialized to another process." ]
                ],

            c3: View [ layout: Run [ spacing = 12 ],
                Eyebrow [ text = "3 · three realizations" ],
                Hair [ ],
                Realize [ host = "DOM", file = "dom-backend.ts",
                    what = "Rasterized into the view’s own <canvas> element, sized to the recording’s bounds and the screen’s pixel density. Boxes, text and images stay native elements beside it." ],
                Hair [ ],
                Realize [ host = "Canvas", file = "canvas-backend.ts · raster-worker.ts",
                    what = "Replayed into the one shared canvas during the composite walk, or turned into a bitmap off the main thread by a raster worker." ],
                Hair [ ],
                Realize [ host = "Mac", file = "DrawReplay.swift",
                    what = "Replayed through Core Graphics into the view’s CALayer. Nearly mechanical: the canvas API was born at Apple, on top of Quartz." ]
                ]
            ]
        ],

    // the compositing order, identical on all three

    order: View [
        layout: WrappingLayout [ spacing = 4, lineSpacing = 8, align = center ],
        Note [ fontSize = 13, text = "Every renderer composites a view in one order:", textColor = { provided("theme").lead } ],
        View [ width = 6, height = 2 ],
        Stage [ label = "backdrop, sampled beneath" ],
        Arrow [ ],
        Stage [ label = "paint" ],
        Arrow [ ],
        Stage [ label = "filter" ],
        Arrow [ ],
        Stage [ label = "clip" ],
        Arrow [ ],
        Stage [ label = "mask" ],
        Arrow [ ],
        Stage [ label = "opacity" ],
        Arrow [ ],
        Stage [ label = "blend" ]
        ]
    ]
