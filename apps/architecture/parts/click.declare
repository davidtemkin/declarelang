/*
# Fig. 4 — one click, end to end

Left, a live control: a level meter the reader clicks. Right, a swimlane of
what that click set in motion, slowed down about a thousandfold. Four lanes
in the layer code (host, runtime, your code, kernel); nine steps; a phase
scalar `ph` that an Animator runs 0 → 9 on each click. Every node's lit state
and the travelling dot derive from `ph`. At rest the diagram shows the whole
sequence, fully drawn.

The nine steps are a `Dataset`, and every view that shows one is replicated
from it — the discs on the lanes, and the two columns of the key below, each
over its own slice of the same rows. Nothing here is a list written out nine
times.
*/

// one step: a numbered disc on its lane

class StepNode extends View [ width = 30, height = 30, cornerRadius = 15,
    idx: number = 0,
    head: string = "",
    ph: number = 9,
    hue: Color = gray,
    lit: boolean = { this.ph >= this.idx + 0.5 },
    fill = { this.lit ? this.hue : provided("theme").panel },
    stroke = { stroke(1.5, this.hue) },
    scale = { this.lit && this.ph < this.idx + 1.5 && this.ph < 8.99 ? 1.18 : 1 },
    pivotX = 15, pivotY = 15,
    n: Mono [ x = center, y = center, fontSize = 12, fontWeight = semibold,
        textColor = { classroot.lit ? provided("theme").panel : classroot.hue }, text = { "" + (classroot.idx + 1) } ],
    heads: boolean = true,
    h: Label [ y = 36, x = center, visible = { classroot.heads }, fontSize = 12.5, fontWeight = medium,
        textColor = { classroot.lit ? provided("theme").ink : provided("theme").faint }, text = { classroot.head } ]
    ]


class Lanes extends View [ height = 330,
    ph: number = 9,
    gutter: number = 92,
    laneH: number = { this.height / 4 },

    // the step table, as the rows this view was pointed at: the drawing and
    // the dot need a lane by index, which a replicated child cannot hand back

    steps: object[] = [],
    laneOf(i: number) -> number { const s = this.steps[i] as any; return s == null ? 0 : s.lane },

    colX(i: number) -> number { return this.gutter + 22 + i * (this.width - this.gutter - 60) / 8 },
    laneY(l: number) -> number { return l * this.laneH + this.laneH / 2 - 12 },
    hueOf(l: number) -> Color { return l == 0 ? provided("theme").hostLine : l == 1 ? provided("theme").run : l == 2 ? provided("theme").app : provided("theme").ker },

    // lane grounds, names and the path through the steps

    draw(d: Draw) {
        const soft = [provided("theme").hostSoft, provided("theme").runSoft0, provided("theme").appSoft, provided("theme").kerSoft]
        for (let l = 0; l < 4; l++) {
            d.fillStyle = soft[l]
            d.fillRect(0, l * this.laneH + 2, d.w, this.laneH - 4)
            }
        d.strokeStyle = provided("theme").faint
        d.lineWidth = 1.5
        d.setLineDash([3, 4])
        d.beginPath()
        for (let i = 0; i < 9; i++) {
            const x = this.colX(i) + 15
            const y = this.laneY(this.laneOf(i)) + 15
            if (i == 0) d.moveTo(x, y)
            else d.lineTo(x, y)
            }
        d.stroke()
        },

    Label [ x = 12, y = { classroot.laneY(0) + 7 }, fontSize = 13, textColor = { classroot.hueOf(0) }, text = "Host" ],
    Label [ x = 12, y = { classroot.laneY(1) + 7 }, fontSize = 13, textColor = { classroot.hueOf(1) }, text = "Runtime" ],
    Label [ x = 12, y = { classroot.laneY(2) + 7 }, fontSize = 13, textColor = { classroot.hueOf(2) }, text = "Your code" ],
    Label [ x = 12, y = { classroot.laneY(3) + 7 }, fontSize = 13, textColor = { classroot.hueOf(3) }, text = "Kernel" ],

    // the travelling dot: between the step it has passed and the next

    dot: View [ width = 12, height = 12, cornerRadius = 6, fill = { provided("theme").ink },
        visible = { classroot.ph > 0.02 && classroot.ph < 8.98 },
        seg: number = { Math.min(7, Math.floor(classroot.ph)) },
        f: number = { unit(classroot.ph - this.seg) },
        x = { mix(classroot.colX(this.seg), classroot.colX(this.seg + 1), this.f) + 9 },
        y = { mix(classroot.laneY(classroot.laneOf(this.seg)), classroot.laneY(classroot.laneOf(this.seg + 1)), this.f) + 9 }
        ],

    // one disc per step, over the dot

    StepNode [ datapath = :rows[], idx = :i, head = :head, ph = { classroot.ph },
        heads = { classroot.width > 620 }, hue = { classroot.hueOf(:lane) },
        x = { classroot.colX(:i) }, y = { classroot.laneY(:lane) } ]
    ]


// one line of the step key, lit with its node

class StepLine extends View [
    idx: number = 0,
    gloss: string = "",
    ph: number = 9,
    lit: boolean = { this.ph >= this.idx + 0.5 },
    opacity = { this.lit ? 1 : 0.45 },
    layout: ResponsiveLayout [ plan = { [({ from: 0, flow: "row", gap: 10, share: ({ n: 4, g: 96 }) })] } ],
    n: Mono [ y = 2, fontSize = 12, fontWeight = semibold, textColor = { provided("theme").muted },
        text = { "" + (classroot.idx + 1) } ],
    g: Text [ fontSize = 14, lineHeight = 1.45,
        textColor = { provided("theme").body }, text = { classroot.gloss } ]
    ]


// the live control: the reader's click is the one being traced

class Meter extends Plate [ pad = 18, gap = 14, cornerRadius = 12, fill = { provided("theme").sunk }, stroke = null,
    level: number = 3,
    t: number = 3,
    Spring [ attribute = t, to = { classroot.level }, stiffness = 170, damping = 20 ],
    raise() { level = level >= 5 ? 1 : level + 1 },

    Eyebrow [ text = "live · click it" ],
    Text [ fontSize = 30, fontWeight = semibold, textColor = { provided("theme").ink },
        text = { "level " + classroot.level } ],
    track: View [ height = 12, cornerRadius = 6, fill = { provided("theme").line },
        bar: View [ height = 12, cornerRadius = 6, fill = { provided("theme").app },
            width = { parent.width * classroot.t / 5 } ]
        ],

    // A library Button, not a View with an onClick: the figure traces a real
    // activation, and a Control brings focus, Space and Enter with it. It sits
    // in a slot of its own because a Button derives its own width from its
    // content, and `Run` claims `w` on every child it places — one slot, one
    // owner — so the row is what the layout sizes and the button fills it.

    btn: View [ height = 36,
        Button [ width = 100%, height = 100%, cornerRadius = 8, label = "Raise the level", primary = true,
            onClick() { classroot.raise() }
            ]
        ]
    ]


class ClickFig extends View [
    ph: number = 9,
    run: Animator [ attribute = ph, from = 0, to = 9, duration = 3200, motion = linear ],
    layout: Run [ spacing = 18 ],

    // the nine steps: which lane, what happens, and the one-line gloss

    steps: Dataset { { "rows": [
        { "i": 0, "lane": 0, "head": "Pointer arrives",
          "gloss": "A pointerdown and pointerup from the host: a DOM event, or an NSEvent on the Mac." },
        { "i": 1, "lane": 1, "head": "Hit walk",
          "gloss": "Which view is under the point. The canvas and Mac walks are the runtime’s own; in the DOM the browser names the element and the runtime resolves it." },
        { "i": 2, "lane": 1, "head": "It was a click",
          "gloss": "Same view, pointer never wandered past the slop: the runtime resolves the gesture." },
        { "i": 3, "lane": 2, "head": "onClick()",
          "gloss": "Your handler runs: level = level + 1. The write is queued; nothing updates yet." },
        { "i": 4, "lane": 3, "head": "Settle opens",
          "gloss": "The kernel invalidates exactly the edges that read level, in dependency order." },
        { "i": 5, "lane": 3, "head": "bar.width",
          "gloss": "track.width × level ÷ 5: pure arithmetic, so it runs as kernel bytecode." },
        { "i": 6, "lane": 2, "head": "label.text",
          "gloss": "A template string is not arithmetic: the kernel calls back into the compiled JavaScript body." },
        { "i": 7, "lane": 1, "head": "Surface calls",
          "gloss": "What changed goes through the render seam: setWidth, setText. Only the views that moved." },
        { "i": 8, "lane": 0, "head": "Pixels",
          "gloss": "One element style, one canvas repaint, or one CATransaction per settle." } ] } },

    datapath = { classroot.steps.value },

    top: Plate [
        row: View [
            layout: ResponsiveLayout [ plan = { [({ from: 800, flow: "row", gap: 24, share: ({ meter: 25, lanes: 75 }) }),
                ({ from: 0, flow: "stack", gap: 20, share: ({ meter: 100, lanes: 100 }) })] } ],
            meter: Meter [
                raise() {
                    super.raise()
                    classroot.run.start()
                    }
                ],
            lanes: Lanes [ ph = { classroot.ph }, steps = :rows ]
            ]
        ],

    // the key, in two columns: each takes its own slice of the same rows

    key: View [
        layout: ResponsiveLayout [ plan = { [({ from: 760, flow: "row", gap: 28, share: ({ k1: 50, k2: 50 }) }),
            ({ from: 0, flow: "stack", gap: 8, share: ({ k1: 100, k2: 100 }) })] } ],
        k1: View [ layout: Run [ spacing = 8 ],
            StepLine [ datapath = :rows[0:5][], idx = :i, gloss = :gloss, ph = { classroot.ph } ]
            ],
        k2: View [ layout: Run [ spacing = 8 ],
            StepLine [ datapath = :rows[5:9][], idx = :i, gloss = :gloss, ph = { classroot.ph } ]
            ]
        ]
    ]
