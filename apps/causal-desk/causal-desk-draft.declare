// The platform owns I/O, coalescing and acknowledgement. This coordinator owns
// only the boundary between a saved envelope and the live Working scenario.

class CausalDraft extends Node [
    savedRecord: Dataset [
        disk: Persistence [ key = "causal-desk/airline-operating-margin/working-scenario",
            restoreOn = "manual", save = "auto", conflict = "overwrite",
            onResult(r: PersistenceResult) { classroot.received(r) }
            ]
        ] { null },

    workingGeneration: number = 0,
    stagedWorkingGeneration: number = 0,
    stageQueued: boolean = false,
    stagingError: string = "",
    eraseIntent: string = "",
    eraseRequest: number = 0,
    checking: boolean = { savedRecord.disk.loadStatus == "loading" },
    hasCandidate: boolean = { savedRecord.disk.recovery != "none" },
    validation: object = { validateSavedScenarioRecord(
        savedRecord.disk.candidate as object, app.modelDocument.value, app.scenarioDocument.value) },
    canRestore: boolean = { savedRecord.disk.recovery == "available" && (validation as SavedScenarioValidation).ok },
    canKeep: boolean = { canRestore && workingGeneration > 0 },
    failureCode: string = { savedRecord.disk.error?.code ?? (stagingError != "" ? stagingError
        : hasCandidate && !canRestore ? (validation as SavedScenarioValidation).code : "") },
    failureText: string = { savedRecord.disk.error != null
        ? savedRecord.disk.error.message + " Current-session analysis is still available."
        : stagingError != "" ? "The Working draft cannot be saved. Correct its assumptions and try again." : "" },
    canRetry: boolean = { savedRecord.disk.error?.retryable == true && !savedRecord.disk.pending
        && (!hasCandidate || eraseIntent != "") },
    hasWorkingOverrides: boolean = { Object.keys(buildSavedScenarioRecord(app.modelDocument.value,
        app.scenarioDocument.value, app.workingScenario.value, app.workingSourceId,
        "2000-01-01T00:00:00.000Z").overrides).length > 0 },
    canClear: boolean = { !hasCandidate && (savedRecord.disk.exists || hasWorkingOverrides) },
    recoveryText: string = { canRestore
        ? "Saved Working scenario from " + (validation as SavedScenarioValidation).record!.savedAt
            + ". Restore it, or discard the saved copy."
        : savedRecord.disk.recovery == "invalid" ? "Saved draft could not be read. Nothing has been restored."
        : (validation as SavedScenarioValidation).message + " Nothing has been restored." },
    editingLocked: boolean = { eraseIntent == "clear" && savedRecord.disk.pending },
    held: boolean = { savedRecord.disk.loadStatus != "loaded" || hasCandidate || eraseIntent != "" },
    saved: boolean = { savedRecord.disk.saved && workingGeneration == stagedWorkingGeneration },
    state: string = { checking ? "checking" : savedRecord.disk.failed || stagingError != "" ? "failed"
        : hasCandidate ? "recovery" : saved ? "saved"
        : savedRecord.disk.pending || workingGeneration != stagedWorkingGeneration ? "saving" : "none" },
    statusText: string = { checking ? "Checking for a local draft…"
        : editingLocked ? "Clearing local work… waiting for confirmation"
        : savedRecord.disk.failed ? "Local saving unavailable · changes remain in this session"
        : stagingError != "" ? "Working draft is invalid · changes remain in this session"
        : hasCandidate ? "Saved Working scenario available"
        : saved ? "Saved on this device · " + (savedRecord.disk.savedAt ?? "").slice(11, 19) + " UTC"
        : state == "saving" ? "Saving locally…" : "Local draft · none" },

    saveWorkingScenario() {
        workingGeneration = workingGeneration + 1
        queueStage()
        },
    queueStage() {
        if (stageQueued) return
        stageQueued = true
        afterSettle(this.stageLatest)
        },
    stageEnvelope() -> boolean {
        const record = buildSavedScenarioRecord(app.modelDocument.value, app.scenarioDocument.value,
            app.workingScenario.value, app.workingSourceId, new Date().toISOString())
        const checked = validateSavedScenarioRecord(record, app.modelDocument.value, app.scenarioDocument.value)
        stagingError = checked.ok ? "" : checked.code
        if (!checked.ok) return false
        savedRecord.set([], record)
        stagedWorkingGeneration = workingGeneration
        return true
        },
    stageLatest() {
        stageQueued = false
        if (held || workingGeneration == stagedWorkingGeneration) return
        if (stageEnvelope() && savedRecord.disk.autosavePaused) savedRecord.disk.commit()
        },
    received(r: PersistenceResult) {
        if (r.operation == "load" && r.ok) queueStage()
        if (r.operation == "erase" && r.requestId == eraseRequest && r.ok) {
            const cleared = eraseIntent == "clear"
            eraseIntent = ""
            if (cleared) {
                app.resetWorkingToBase()
                workingGeneration = 0
                stagedWorkingGeneration = 0
                stagingError = ""
            } else if (workingGeneration > 0) {
                if (stageEnvelope()) savedRecord.disk.commit()
            }
            afterSettle(this.focusScenario)
        }
        },
    focusScenario() {
        const picker = app.header.scenarioPicker
        const index = (picker.choices as any[]).findIndex(c => c.id == app.activeScenarioId)
        const choices = picker.segs()
        if (index >= 0) Focus.focus(choices[index] as View)
        },
    requestRestore() {
        if (!canRestore || savedRecord.disk.pending) return
        if (workingGeneration == 0) { restoreSavedScenario(); return }
        app.draftDialog.open("Replace current work?",
            "Restoring this saved draft replaces the Working edits made in this session.",
            [({ id: "cancel", label: "Cancel", cancel: true, default: true }),
                ({ id: "restore", label: "Restore" })], "",
            (id) => { if (id == "restore") this.restoreSavedScenario() })
        },
    restoreSavedScenario() {
        const checked = validateSavedScenarioRecord(savedRecord.disk.candidate as object,
            app.modelDocument.value, app.scenarioDocument.value)
        if (!checked.ok || checked.record == null || !savedRecord.disk.restore()) return
        app.workingScenario.set([], workingScenarioFromSavedRecord(app.modelDocument.value,
            app.scenarioDocument.value, checked.record))
        app.workingSourceId = checked.record.workingSourceId
        app.activeScenarioId = "working"
        app.comparisonScenarioId = "base"
        app.selectedContributionFactorId = ""
        if (!visibleFactorIds(app.modelDocument.value).includes(app.selectedFactorId))
            app.selectedFactorId = "operatingMargin"
        const generation = workingGeneration + 1
        workingGeneration = generation
        stagedWorkingGeneration = generation
        stagingError = ""
        app.syncAssumptionDraft()
        afterSettle(this.focusScenario)
        },
    requestDiscard() {
        if (!hasCandidate || savedRecord.disk.pending) return
        app.draftDialog.open("Discard saved draft?",
            "Remove the saved copy from this device? This cannot be undone. Current-session work is kept.",
            [({ id: "cancel", label: "Cancel", cancel: true, default: true }),
                ({ id: "discard", label: "Discard" })], "",
            (id) => { if (id == "discard") this.discardSavedScenario() })
        },
    discardSavedScenario() {
        if (!hasCandidate || savedRecord.disk.pending) return
        eraseIntent = "discard"
        eraseRequest = savedRecord.disk.erase()
        },
    keepCurrentWork() {
        if (!canKeep || savedRecord.disk.pending || eraseIntent != "") return
        if (stageEnvelope()) savedRecord.disk.replace()
        },
    retryStorage() {
        if (!canRetry) return
        if (eraseIntent != "") { eraseRequest = savedRecord.disk.retry(); return }
        if (savedRecord.disk.error?.operation == "commit" && !stageEnvelope()) return
        savedRecord.disk.retry()
        },
    requestClear() {
        if (!canClear || checking || editingLocked || eraseIntent != "") return
        app.draftDialog.open("Clear saved work?",
            "Remove saved and current Working changes from this device? This cannot be undone. Bundled scenarios are kept.",
            [({ id: "cancel", label: "Cancel", cancel: true, default: true }),
                ({ id: "clear", label: "Clear work" })], "",
            (id) => { if (id == "clear") this.clearSavedWork() })
        },
    clearSavedWork() {
        if (savedRecord.disk.loadStatus != "loaded" || editingLocked || eraseIntent != "") return
        eraseIntent = "clear"
        eraseRequest = savedRecord.disk.erase()
        }
    ]
