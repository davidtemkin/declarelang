/*
# Rain or Shine?

OpenLaszlo's weather sample: a splash where you enter a zip code, and a report
with three sliding tabs — current conditions, a radar map, and a five-day
forecast. Its data is the bundled file data/weather.json, the same for any zip.

Where the person is comes down to two facts on the App: whether they have asked
for the weather (`asked`), and which tab is open (`tab`). Everything else follows
from those and from the data source's own facts (`loading`, `loaded`, `failed`):
which screen shows, where the zip button and the top bar sit, which tab is open.
The motion between those places is timed, each `Animator` gated by the fact it
shows.

The art is the original's: the backdrop, the splash, the top bar, the tab bars
and the zip button are its images.
*/

// a 240×320 desktop window, its zip field at the original's size

defaultFlags [ devices = desktop ]

/*
## Building blocks
*/

// Text as the original sets it: inset 2px on every side of its box, its lines
// 1.2 times the font size, and on the Mac a hundredth of an em between letters.
// So a line of 9px Tahoma stands 15 tall, and a stack of them one pixel apart
// steps by 16.

class Label extends Text [ padding = 2, lineHeight = 1.2, letterSpacing = { this.fontSize * 0.01 } ]

// One tab of the report: a 25-tall bar over its content. It opens to
// `openHeight`, wiping its content into view from the top, and closes to its bare
// bar; the use site says when it is open, and what choosing it, a press on its
// bar, does. The open tab's bar fades to a third over 333ms and its title turns
// white.
//
// To a screen reader it is a group named by its bar, the bar a button that says
// whether the tab is open, and the content is there only while it is open or
// moving.

class WeatherTab [ width = 100%,
    label: string = "default title",
    openHeight: number = 255,
    open: boolean = false,
    choose() { },

    accessibilityRole = group,
    accessibilityLabel = { label },

    // how far open it is, in pixels: open at once for the tab open at the start,
    // then moved over 300ms whenever it opens or closes. It is pixels, not a 0–1
    // blend, because the Laszlo easing's curve is set by the distance travelled

    extent: number = { open ? openHeight : 25 },
    opening: Animator [ attribute = extent, to = { classroot.openHeight }, duration = 300, easing = laszloBoth, started = { classroot.open } ],
    closing: Animator [ attribute = extent, to = 25, duration = 300, easing = laszloBoth, started = { !classroot.open } ],

    // how strongly the bar shows: dimmed while the tab is open

    barOpacity: number = { open ? 0.33 : 1 },
    dimming: Animator [ attribute = barOpacity, to = 0.33, duration = 333, easing = laszloBoth, started = { classroot.open } ],
    brightening: Animator [ attribute = barOpacity, to = 1, duration = 333, easing = laszloBoth, started = { !classroot.open } ],

    height = { extent },
    clip = true,

    // Tab reaches the content only while the tab is open

    tabOrder() { return open ? this.tabDefault() : [bar] },

    defaultPlacement = body,

    bar: Control [ width = 100%, height = 25,
        accessibilityLabel = { classroot.label },
        accessibilityExpanded = { classroot.open },
        press() { classroot.choose() },
        bg: Image [ width = 100%, height = 25, fit = both, imageRendering = pixelated, source = "resources/tab.png", opacity = { classroot.barOpacity } ],
        icon: Image [ source = "resources/slider_icon2.png", x = 2, y = 3 ],
        title: Label [ text = { classroot.label }, x = 15, y = 4, textShadow = Shadow(1, 1, 0, #3B4057),
            textColor = { classroot.open ? 0xFFFFFF : 0xCAD0EC } ]
        ],

    body: View [ y = 25, width = 100%,
        visible = { classroot.open || classroot.height > 25.5 } ]
    ]


// One forecast day: its icon on a black square, the day, the sky, and the high
// and low. The words run past the square to the right.

class WeatherSummary [ fill = #000000, width = 34, height = 34, x = 10,
    fontFamily = { app.body }, fontSize = 12,
    icon: Image [ x = 1, y = 1, width = 32, height = 32, fit = both,
        accessibilityLabel = :text,
        source = { :code != null ? `resources/icons/${:code}.gif` : "" } ],
    day: Label [ x = 42, width = 140, text = :day ],
    desc: Label [ x = 42, y = 14, width = 120, fontSize = 11, fontWeight = normal, wrap = true, text = :text ],
    hiLabel: Label [ x = 165, text = "Hi:" ],
    loLabel: Label [ x = 165, y = 14, text = "Lo:" ],
    hi: Label [ x = 188, width = 60, text = :high ],
    lo: Label [ x = 188, y = 14, width = 60, text = :low ]
    ]


/*
## The app

A 240×320 window over a background photo, with two screens: the splash with the
zip button, shown until the weather has loaded, and the report.
*/

App [ width = 240, height = 320, fill = #EAEAEA,
    chrome: Font [ family = "Tahoma, Geneva, sans-serif" ],
    body: Font [ family = "Helvetica, Arial, sans-serif" ],
    fontFamily = { app.chrome }, fontSize = 9,
    fontWeight = bold, textColor = #FFFFFF,

    // the zip as typed; the top bar shows it once the weather is asked for

    zip: string = "94403",

    // where the person is: whether they have asked for the weather, and which tab
    // of the report is open

    asked: boolean = false,
    tab: string = "conditions",

    weatherData: DataSource [ url = "data/weather.json" ],

    // the zip button is away while the weather is asked for and has not failed

    zipAway: boolean = { app.asked && !app.weatherData.failed },

    ask() {
        app.asked = true
        app.weatherData.fetch()
        },

    // back to the splash: the request is withdrawn, the report emptied, and the
    // zip field cleared for the next one

    changeZip() {
        app.asked = false
        app.zip = ""
        app.weatherData.clear()
        },

    // the up and down arrows step the focus through the controls, as Tab does

    keyBindings = { [ ({ key: "ArrowDown", command: "stepFocus", args: [1] }),
                      ({ key: "ArrowUp", command: "stepFocus", args: [-1] }) ] },
    stepFocus(dir: number) { if (dir > 0) Focus.next(); else Focus.prev() },

    bg: Image [ source = "resources/weather_bg.jpg" ],

    /* ## The splash
       Shown until the weather loads: the art, a status line while it loads or
       after it fails, and the zip button, which slides away while the weather is
       asked for. */

    splash: View [ width = 100%, height = 100%, visible = { !app.weatherData.loaded },

        // the art carries the title, "Rain or Shine?", painted in

        art: Image [ source = "resources/weather_splash2.jpg",
            accessibilityLabel = "Rain or Shine? A sample weather application" ],

        status: Label [ x = 15, y = 230, width = 240, textColor = #000099, accessibilityLive = polite,
            text = { app.weatherData.failed ? "Server error: the weather could not be fetched"
                   : app.weatherData.loading ? "Loading weather data..." : "" } ],

        zipBar: View [ y = 245, x = 0,
            slideOut: Animator [ attribute = x, to = -2000, duration = 333, easing = laszloBoth, started = { app.zipAway } ],
            slideIn:  Animator [ attribute = x, to = 0, duration = 333, easing = laszloBoth, started = { !app.zipAway } ],

            // The button: its art and words, sinking a pixel down and right, onto
            // its pressed frame, while held. Releasing it asks for the weather.

            button: Control [ x = { pressed ? 1 : 0 }, y = { pressed ? 1 : 0 },
                accessibilityLabel = "Get the weather",
                press() { app.ask() },
                art: Image [ opacity = 0.7,
                    source = { parent.pressed ? "resources/zipbutton0002.png" : "resources/zipbutton0001.png" } ],
                caption: Label [ text = "Enter Zip Code:", x = 15, y = 7, accessibilityHidden = true,
                    textShadow = Shadow(1, 0, 0, #222222) ],
                ok: Label [ text = "OK", x = 205, y = 7, accessibilityHidden = true,
                    textShadow = Shadow(1, 0, 0, #222222) ]
                ],

            // The zip field, beside the words and moving with them: a white face
            // in a bevel of two rings, grey and black above and to the left, light
            // below and, on the outer ring, to the right. Return in it asks for
            // the weather too.

            field: View [ x = { 120 + (parent.button.pressed ? 1 : 0) }, y = { 5 + (parent.button.pressed ? 1 : 0) },
                width = 80, height = 20, fill = #FFFFFF,
                stroke = [Stroke(1, #989898), Stroke(1, #E1E1E1), Stroke(1, #E1E1E1), Stroke(1, #989898)],
                input: TextInput [ x = 1, y = 1, width = 78, height = 18,
                    fill = #FFFFFF, cornerRadius = 0, padding = [0, 2, 4, 3],
                    stroke = [Stroke(1, #262626), null, Stroke(1, #EFEFEF), Stroke(1, #262626)],
                    textColor = #000000, accessibilityLabel = "Zip code", purpose = postalCode,
                    value <-> app.zip,
                    onEnter() { app.ask() }
                    ]
                ]
            ]
        ],

    /* ## The report
       Shown once the weather loads, its subtree pointed at the loaded channel; the
       :paths below (:location.city, :item.condition.temp, …) read fields of it. */

    report: View [ width = 100%, height = 100%, visible = { app.weatherData.loaded },
        datapath = { app.weatherData.value?.rss?.channel },

        // the top bar comes down with the report and goes back up without it; its
        // art carries the title and "Zipcode:", and the zip is written beside them

        topBar: Image [ source = "resources/weather_topbar2.gif", y = -16, opacity = 0,
            down: AnimatorGroup [ process = simultaneous, duration = 333, easing = laszloBoth,
                started = { app.weatherData.loaded },
                Animator [ attribute = y, to = 0 ],
                Animator [ attribute = opacity, to = 1 ]
                ],
            up: AnimatorGroup [ process = simultaneous, duration = 333, easing = laszloBoth,
                started = { !app.weatherData.loaded },
                Animator [ attribute = y, to = -16 ],
                Animator [ attribute = opacity, to = 0 ]
                ],

            zip: Label [ x = 194, width = 100, text = { app.zip },
                textColor = { parent.back.focused ? 0xFFFFFF : 0xCAD0EC } ],

            // the whole bar is the way back to the splash

            back: Control [ width = 100%, height = 100%, accessibilityLabel = "Change the zip code",
                press() { app.changeZip() }
                ]
            ],

        tabs: View [ y = 15, width = 100%, height = 305,
            layout: SimpleLayout [ axis = y ],

            conditions: WeatherTab [ open = { app.tab == "conditions" },
                choose() { app.tab = "conditions" },
                label = "Current Conditions",

                currentData: View [ y = 10, width = 240,
                    layout: SimpleLayout [ axis = y, spacing = 10 ],

                    now: View [ width = 240, fontFamily = { app.body }, fontSize = 14,
                        where: Label [ x = 15, width = 240,
                            text = { :location.city + ", " + :location.region } ],
                        iconBox: View [ x = 26, y = 28, width = 52, height = 52, fill = #FFFFFF ],
                        icon: Image [ x = 26, y = 28, width = 64, height = 64,
                            accessibilityLabel = :item.condition.text,
                            source = { :item.condition.code != null
                                     ? `resources/icons/${:item.condition.code}.gif` : "" } ],
                        temp: Label [ x = 95, y = 20, width = 240, fontSize = 60, text = :item.condition.temp ],
                        desc: Label [ x = 15, y = 90, width = 240, text = :item.condition.text ]
                        ],

                    // the labels and their values, two columns ten pixels into
                    // each other; the values run one line longer, with the time of
                    // the report, which the tab below covers

                    more: View [ x = 15,
                        layout: SimpleLayout [ axis = x, spacing = -10 ],
                        labels: View [
                            layout: SimpleLayout [ axis = y, spacing = 1 ],
                            Label [ width = 90, text = "Humidity:" ],
                            Label [ text = "Barometer:" ],
                            Label [ text = "Windspeed:" ],
                            Label [ text = "Sunrise:" ],
                            Label [ text = "Sunset:" ],
                            Label [ text = "Wind Chill:" ]
                            ],
                        values: View [ fontWeight = normal,
                            layout: SimpleLayout [ axis = y, spacing = 1 ],
                            Label [ width = 160, text = :atmosphere.humidity ],
                            Label [ width = 160, text = :atmosphere.pressure ],
                            Label [ width = 160, text = :wind.speed ],
                            Label [ width = 160, text = :astronomy.sunrise ],
                            Label [ width = 160, text = :astronomy.sunset ],
                            Label [ width = 160, text = :wind.chill ],
                            Label [ width = 160, text = :item.condition.date ]
                            ]
                        ]
                    ]
                ],

            radar: WeatherTab [ open = { app.tab == "radar" },
                choose() { app.tab = "radar" },
                label = "Radar Maps",
                radarData: View [ y = 10, width = 240, height = 162,
                    dropShadow: View [ x = 23, y = 23, width = 200, height = 135, fill = #000000, opacity = 0.33 ],
                    scan: Image [ x = 20, y = 20, width = 200, height = 135, fit = both,
                        source = "resources/radar_us.png", accessibilityLabel = "Radar map of the United States" ]
                    ]
                ],

            forecast: WeatherTab [ open = { app.tab == "forecast" },
                choose() { app.tab = "forecast" },
                label = "Forecast",
                forecastData: View [ y = 10,
                    layout: SimpleLayout [ axis = y, spacing = 10 ],
                    WeatherSummary [ datapath = :item.forecast[] ]
                    ]
                ]
            ]
        ]
    ]
