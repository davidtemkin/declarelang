/*
# Laszlo Calendar

OpenLaszlo's calendar sample: a month of days that becomes a week or a single
day, events you select, drag to another day or another time, and edit in an
info panel that slides in at the right. Its events are the bundled
data/events.json.

Where the person is comes down to a few facts on the App: the month shown, the
selected day, the open day (the one grown to show its hours, if any), the view
(month, week or day), the selected event, and whether the info panel is open.
Everything on screen derives from those.

The grid is the one part that moves. Each day cell carries its own place and
size, and `arrange()` sends every cell to where the facts put it, gliding over
half a second or placing it at once: changing the view glides; opening or
closing a day glides in the week and day views and snaps in the month view;
paging a month or opening the info panel snaps. A cell that leaves the view
vanishes at once, and one that comes back is placed and shows when the glide is
done.

The art is the original's: the toolbar, the buttons and their icons, the day
names, the selected day's frame, the selected event's bar, the info panel's
frame, the hour grid and the scrollbar.
*/

// a fixed 835×600 desktop window, its fields at the design's sizes

defaultFlags [ devices = desktop ]

script {
    const MONTHS = ["January", "February", "March", "April", "May", "June", "July",
        "August", "September", "October", "November", "December"]

    function monthName(m: number): string { return MONTHS[m] }

    // an hour as the cells write it: 12a, 9a, 12p, 4p
    function hourLabel(h: number): string {
        const ap = h < 12 ? "a" : "p"
        const hh = h > 12 ? h - 12 : h == 0 ? 12 : h
        return hh + ap
        }

    // a time of day as the info panel writes it: 9:00a, 12:30p, 0:15a
    function longTime(minutes: number): string {
        let h = Math.floor(minutes / 60)
        const m = minutes % 60
        const ap = h > 11 ? "p" : "a"
        if (h > 12) h -= 12
        return h + ":" + (m < 10 ? "0" + m : "" + m) + ap
        }

    function keyOf(d: Date): string { return d.getFullYear() + "-" + (d.getMonth() + 1) + "-" + d.getDate() }

    // a color as the original's default component style lifts it: each channel
    // times (0xF2 + 0x33) / 255, clipped at white (the scrollbar's art in
    // resources/ol/scrollbar-styled is lifted the same way)
    function styled(c: number): number {
        const k = (0xF2 + 0x33) / 255
        const ch = (s: number) => Math.min(255, Math.round(((c >> s) & 255) * k))
        return (ch(16) << 16) | (ch(8) << 8) | ch(0)
        }

    // The room a label takes as the original measures it: its words in bold
    // Verdana 10, tracked by 0.01em between letters, and 2px either side, to the
    // nearest pixel. Where a label's room decides a layout (the buttons, the hour
    // before a title, the month centered in the toolbar), this is that room.
    function roomOf(text: string): number {
        if (text == "") return 0
        const words = measureText(text, { fontFamily: ["Verdana", "Vera", "sans-serif"], fontSize: 10, fontWeight: "bold" }).width
        return Math.round(words + 0.1 * (text.length - 1) + 4)
        }

    // an event's colors by its kind: its face, its face under the pointer, and the
    // strip down its time in an open day
    const KINDS: Record<string, { dim: number, bright: number, strip: number }> = {
        holiday:   { dim: 0xCBD1C5, bright: 0xD4DAC8, strip: 0x587457 },
        astro:     { dim: 0xC5C3D5, bright: 0xCDC6DC, strip: 0x4C5E7E },
        milestone: { dim: 0xBBC6D1, bright: 0xC6CEDC, strip: 0x4C5E7E },
        "":        { dim: 0xC6CEDC, bright: 0xDDDDDD, strip: 0x5D84CB } }
    function kindOf(category: string) { return KINDS[category] ?? KINDS[""] }
    }


/*
## The events
*/

schema CalEvent [ id: number, y: number, m: number, d: number, start: number, end: number,
    title: string, notes?: string, location?: string, attendees?: string, category?: string ]

// Every event, fetched once. Each write to them is a method here, with the
// original's rules for times: a new start keeps the event's length, an end that
// would cross midnight stopping at 23:45; the end moves in quarter hours and the
// event never empties or fills the day.

class Events extends DataSource [ url = "data/events.json", autoFetch = true,
    schema = [ events[]: CalEvent ],

    all() -> CalEvent[] { return value?.events ?? [] },
    find(id: number) -> CalEvent? { return this.all().find((e) => e.id == id) ?? null },
    indexOf(id: number) -> number { return this.all().findIndex((e) => e.id == id) },

    // the events of one day, earliest first

    on(key: string) -> CalEvent[] {
        return this.all().filter((e) => e.y + "-" + e.m + "-" + e.d == key).sort((a, b) => a.start - b.start)
        },

    setDay(id: number, day: Date) {
        const i = this.indexOf(id)
        if (i < 0) return
        this.set(["events", i, "y"], day.getFullYear())
        this.set(["events", i, "m"], day.getMonth() + 1)
        this.set(["events", i, "d"], day.getDate())
        },

    setStart(id: number, start: number) {
        const e = this.find(id), i = this.indexOf(id)
        if (e == null || start < 0 || start >= 1440) return
        const len = e.end - e.start <= 0 ? 15 : e.end - e.start
        this.set(["events", i, "start"], start)
        this.set(["events", i, "end"], start + len >= 1440 ? 1425 : start + len)
        },

    stepEnd(id: number, dir: number) {
        const e = this.find(id), i = this.indexOf(id)
        if (e == null) return
        const len = e.end - e.start + 15 * dir
        if (len > 0 && len < 1440 && e.end + 15 * dir < 1440) this.set(["events", i, "end"], e.end + 15 * dir)
        },

    setText(id: number, field: string, text: string) {
        const i = this.indexOf(id)
        if (i >= 0) this.set(["events", i, field], text)
        },

    // a 9–10a "New Event" on a day; answers its id

    add(day: Date) -> number {
        const id = 1 + this.all().reduce((mx, e) => Math.max(mx, e.id), 0)
        this.insert(["events"], this.all().length, ({ id: id, y: day.getFullYear(), m: day.getMonth() + 1, d: day.getDate(),
            start: 540, end: 600, title: "New Event", notes: "", location: "", attendees: "", category: "" }))
        return id
        },

    remove(id: number) {
        const i = this.indexOf(id)
        if (i >= 0) this.removeAt(["events"], i)
        }
    ]


/*
## Building blocks
*/

// Text as the original sets it: inset 2px on every side of its box, its lines 1.2
// times the font size, and on the Mac a hundredth of an em between letters.

class Label extends Text [ padding = 2, lineHeight = 1.2, letterSpacing = { this.fontSize * 0.01 } ]

// A button's art: a left cap, a stretched middle and a right cap, each end oval
// or slanted, in its up, over or down frame.

class ButtonArt [ height = 21,
    leftCap: string = "oval",
    rightCap: string = "oval",
    frame: string = "up",
    left: Image [ source = { "resources/ol/btn_rsrcs/" + classroot.leftCap + "btn_" + classroot.frame + "_lft.png" } ],
    middle: Image [ x = { parent.left.width }, height = 21, fit = both,
        width = { parent.width - parent.left.width - parent.right.width },
        source = { "resources/ol/btn_rsrcs/btn_" + classroot.frame + "_mid.png" } ],
    right: Image [ x = { parent.width - this.width },
        source = { "resources/ol/btn_rsrcs/" + classroot.rightCap + "btn_" + classroot.frame + "_rt.png" } ]
    ]


// The toolbar's and the panel's button: its art, under the pointer and held in
// their frames; an icon, a label, or both; sized to what it holds. The label is white over a faint dark copy, which
// rests a pixel high until the button is first pressed and just under the label
// after; the icon and the label sink a pixel while the button is held.

class CalButton extends Control [ height = 21,
    label: string = "",
    icon: string = "",
    leftCap: string = "oval",
    rightCap: string = "oval",
    leftInset: number = { leftCap == "shear" ? 3 : 8 },
    rightInset: number = { rightCap == "shear" ? 5 : 12 },
    labelRoom: number = { roomOf(label) },
    natural: number = { leftInset + (icon != "" ? iconArt.width + (label != "" ? 3 : 0) : 0) + labelRoom + rightInset },
    width = { natural },
    accessibilityLabel = { label },
    frame: string = { pressed ? "dn" : hovered ? "mo" : "up" },
    sunk: number = { pressed ? 1 : 0 },
    touched: boolean = false,
    onPointerDown() { touched = true },

    art: ButtonArt [ width = { parent.width }, leftCap = { classroot.leftCap }, rightCap = { classroot.rightCap }, frame = { classroot.frame } ],
    iconArt: Image [ x = { classroot.leftInset }, visible = { classroot.icon != "" },
        y = { Math.floor((21 - this.height) / 2) + classroot.sunk },
        source = { classroot.icon != "" ? "resources/ol/images/buttons/" + classroot.icon + ".png" : "" } ],
    hilite: Label [ x = { classroot.icon != "" ? parent.title.x : parent.title.x - 1 },
        y = { classroot.pressed ? 3.7 : classroot.touched ? 2.7 : 1 }, opacity = 0.4,
        visible = { classroot.label != "" }, textColor = #143B45, fontSize = 10, fontWeight = bold,
        text = { classroot.label } ],
    title: Label [ y = { 2 + classroot.sunk }, visible = { classroot.label != "" },
        x = { classroot.icon != "" ? classroot.leftInset + parent.iconArt.width + 3 : classroot.leftInset },
        textColor = #FFFFFF, fontSize = 10, fontWeight = bold, text = { classroot.label } ]
    ]


// A button drawn by three images: at rest, under the pointer, and held down.

class ArtButton extends Control [
    upArt: string = "",
    overArt: string = "",
    downArt: string = "",
    face: Image [ source = { parent.pressed ? classroot.downArt : parent.hovered ? classroot.overArt : classroot.upArt } ]
    ]


/*
## The open day's hours

An open day shows its hours on the original's grid of hour lines, and its box
scrolls them: the platform's own scrolling, its scrollbar hidden and the classic
one drawn in its place: an arrow at each end steps 10px, the track pages by
the view, and either repeats while held; the thumb is as long as the share in
view, never under 14px, with its gripper in the middle. While everything fits, the
bar shows its disabled art over the day's color. The whole bar, ground and art,
wears the original's default component style, a little lighter than its art.
*/

// one part of the bar that acts while held; the bar is for the pointer, so its
// parts are not stops for Tab

class Repeater extends Control [ focusable = false,
    act() { },
    onPointerDown() { act(); afterDelay(500, () => again()) },
    again() { if (pressed) { act(); afterDelay(50, () => again()) } }
    ]


class HourScrollbar [ width = 14,
    pane: View = { parent as View },
    hoursHeight: number = 527,
    idleGround: Color = #9BA9B1,
    on: boolean = { hoursHeight > height },
    fill = { styled(on ? 0x595959 : idleGround) },

    // where the hours stand, and a step on from where the last one sent them: the
    // platform reports where the pane is once a frame, so notches faster than
    // that still add up

    at: number = { pane.scrollY },
    sent: number = -1,
    trackChanges = ["at"],
    onChange() { sent = -1 },
    go(v: number) { sent = Math.max(0, Math.min(hoursHeight - height, v)); pane.scrollTo(sent) },
    step(dir: number) { go((sent >= 0 ? sent : at) + dir * 10) },
    page(dir: number) { go((sent >= 0 ? sent : at) + dir * height) },

    piece(name: string) -> string { return "resources/ol/scrollbar-styled/" + name + ".png" },
    frame(base: string, held: boolean, over: boolean) -> string {
        return piece(base + (!on ? "_dsbl" : held ? "_dn" : over ? "_mo" : "_up")) },

    up: Repeater [ x = 1, y = 1, width = 12, height = 13, accessibilityLabel = "Scroll up",
        act() { classroot.step(-1) },
        Image [ source = { classroot.frame("scrollbtn_y_top", parent.pressed, parent.hovered) } ]
        ],
    track: View [ x = 1, y = 14, width = 12, height = { parent.height - 28 },
        thumbH: number = { Math.max(14, Math.floor(classroot.height / classroot.hoursHeight * this.height)) },
        thumbY: number = { Math.min(Math.ceil(classroot.at / classroot.hoursHeight * this.height), this.height - this.thumbH) },
        above: Repeater [ width = 12, height = { classroot.on ? parent.thumbY : parent.height }, accessibilityLabel = "Page up",
            act() { classroot.page(-1) },
            Image [ width = 12, height = 100%, fit = both,
                source = { classroot.piece(!classroot.on ? "y_scrolltrack_dsbl" : parent.pressed ? "y_scrolltrack_dn" : "y_scrolltrack") } ]
            ],
        below: Repeater [ y = { parent.thumbY + parent.thumbH }, width = 12, visible = { classroot.on },
            height = { parent.height - parent.thumbY - parent.thumbH }, accessibilityLabel = "Page down",
            act() { classroot.page(1) },
            Image [ width = 12, height = 100%, fit = both,
                source = { classroot.piece(parent.pressed ? "y_scrolltrack_dn" : "y_scrolltrack") } ]
            ],
        thumb: View [ y = { parent.thumbY }, width = 12, height = { parent.thumbH }, visible = { classroot.on },
            grabY: number = 0,
            onPointerDown(e: PointerEvent) { grabY = e.y },
            onDrag(e: PointerEvent) {
                const track = parent as View
                classroot.go((e.rootY - track.rootOrigin().y - grabY) / Math.max(1, track.height) * classroot.hoursHeight)
                },
            cap: Image [ source = { classroot.piece("scrollthumb_y_top") } ],
            middle: Image [ y = 1, width = 12, height = { parent.height - 3 }, fit = both, source = { classroot.piece("scrollthumb_y_mid") } ],
            foot: Image [ y = { parent.height - 2 }, source = { classroot.piece("scrollthumb_y_bot") } ],
            gripper: View [ x = 1, width = 11, clip = true, height = { Math.min(200, parent.height - 16) },
                y = { Math.round((parent.height - this.height) / 2) },
                Image [ source = { classroot.piece("thumb_y_gripper") } ]
                ]
            ]
        ],
    down: Repeater [ x = 1, y = { parent.height - 14 }, width = 12, height = 13, accessibilityLabel = "Scroll down",
        act() { classroot.step(1) },
        Image [ source = { classroot.frame("scrollbtn_y_bot", parent.pressed, parent.hovered) } ]
        ]
    ]


/*
## An event in a day

Closed, a day lists its events one under another, earliest first, each a 22px
line as wide as the window, so the day's box cuts its title off: the hour, then
the title. Open, each sits on the hour grid at its start, 22px an hour, as tall
as it lasts, with a tinted strip down its time to the left. Under the pointer it
lightens.

Pressing an event selects it; pressing and moving drags it. Return on the
selected event opens the info panel, as a double click does.
*/

class EventLine extends Control [
    eventId: number = 0,
    category: string = "",
    start: number = 0,
    end: number = 0,
    title: string = "",
    opened: boolean = false,
    reopened: boolean = false,
    order: number = 0,

    selected: boolean = { app.selectedEvent == eventId },

    x = { opened ? 24 : 0 },
    y = { opened ? start * 22 / 60 + 11 : order * 22 },
    height = { opened ? Math.max(22, (end - start) * 22 / 60) : 22 },
    width = 835,
    fill = { hovered ? kindOf(category).bright : kindOf(category).dim },

    pointerEvents = "auto",
    focusable = { app.selectedKey == app.keyOfEvent(eventId) },
    accessibilityLabel = { hourLabel(Math.floor(start / 60)) + " " + title },
    accessibilityPressed = { selected },
    press() { app.selectEvent(eventId) },
    onKeyDown(e: KeyEvent) {
        if (e.key == "Enter" && selected && !e.repeat) app.openInfo()
        else super.onKeyDown(e)
        },
    onPointerDown(e: PointerEvent) { app.selectEvent(eventId); app.drag.begin(this, e) },
    onDrag(e: PointerEvent) { app.drag.follow(e) },
    onDragEnd(e: DragEndEvent) { app.drag.drop(e.canceled) },
    onDoubleClick() { app.openInfo() },

    timeStrip: View [ x = -29, width = 29, height = { parent.height }, fill = { kindOf(classroot.category).strip }, opacity = 0.3,
        visible = { classroot.opened } ],
    topLine: View [ width = { parent.width }, height = 1, fill = #FFFFFF ],
    bottomLine: View [ y = { parent.height - 1 }, width = { parent.width }, height = 1, fill = #555555 ],
    hour: Label [ x = 2, y = 3, visible = { !classroot.opened }, textColor = #4B5D6C,
        text = { hourLabel(Math.floor(classroot.start / 60)) } ],
    words: Label [ y = 3, height = 20, textColor = #4B5D6C, text = { classroot.title },
        x = { classroot.opened ? 10 : classroot.reopened ? 25 : roomOf(parent.hour.text) + 5 } ]
    ]


/*
## A day cell

A day's frame and its box of events, the date at its top left: the box grey-blue
for the month's weekdays, a little darker on weekends, darker still for the days
of the months beside it; light grey while the day is selected. Open, the box
shows the day's hours and its events on them, with the scrollbar at its right.

A press on a day selects it and opens it. Its place and size are its own: the
grid's `arrange()` moves them, all four together over half a second, or at once.
*/

class DayCell [ fill = #7A949E, width = 3, height = 10,
    index: number = 0,
    date: Date = { app.dateAt(index) },
    key: string = { keyOf(date) },
    inMonth: boolean = { date.getMonth() == app.month },
    weekend: boolean = { date.getDay() == 0 || date.getDay() == 6 },
    selected: boolean = { app.started && key == app.selectedKey },
    opened: boolean = { app.started && key == app.openKey },
    row: number = { Math.floor(index / 7) },
    col: number = { index % 7 },

    // once a day has been opened and closed, its titles sit a little further in;
    // the selected day is the one the frame and the grid's focus are on

    wasOpened: boolean = false,
    onInit() { if (selected) app.activeDay = this },
    onChange(e: ChangeEvent) {
        for (const c of e.changed) {
            if (c.name == "opened" && !opened) { wasOpened = true; box.scrollTo(0) }
            if (c.name == "selected" && selected) app.activeDay = this
            }
        },
    trackChanges = ["opened", "selected"],

    accessibilityRole = group,
    accessibilityLabel = { date.toDateString() + (selected ? ", selected" : "") },

    onClick() { app.openDay(key) },

    // where the grid sends it, and the motion that takes it there

    tx: number = 0,
    ty: number = 0,
    tw: number = 3,
    th: number = 10,
    shown: boolean = true,
    visible = { shown },
    showsAt: number = 0,
    motion: AnimatorGroup [ process = simultaneous, duration = 500, easing = laszloBoth,
        Animator [ attribute = x, to = { classroot.tx } ],
        Animator [ attribute = y, to = { classroot.ty } ],
        Animator [ attribute = width, to = { classroot.tw } ],
        Animator [ attribute = height, to = { classroot.th } ]
        ],

    // Send it to `b`, gliding if it is showing and the change glides, else at
    // once; a cell coming back into view shows when the glide is done. A cell
    // leaving the view lets its selected event go. The top row keeps its columns
    // moving even hidden, for the day names over them.

    arrange(b: Box, glide: boolean) {
        if (!b.vis) {
            if (app.selectedEvent >= 0 && app.keyOfEvent(app.selectedEvent) == key) app.leaveEvent()
            tx = b.x; ty = y; tw = b.w; th = height
            if (row == 0 && glide) motion.start()
            else if (row == 0) { x = b.x; width = b.w }
            shown = false
            return
            }
        tx = b.x; ty = b.y; tw = b.w; th = b.h
        if (glide && shown) { motion.start(); return }
        motion.stop()
        x = b.x; y = b.y; width = b.w; height = b.h
        if (glide) {
            const stamp = ++showsAt
            afterDelay(600, () => { if (showsAt == stamp) shown = true })
            } else { shown = true }
        },

    inner: View [ x = 1, y = 1, width = { parent.width - 2 }, height = { parent.height - 2 }, fill = #526C7B ],
    corner: Image [ source = "resources/ol/images/day/top_lft_dslct2.png" ],
    dayNumber: Label [ x = 3, y = 1, width = 35, visible = { app.started },
        textColor = { classroot.inMonth ? 0xDAE3E8 : 0x7E929F }, text = { "" + classroot.date.getDate() } ],

    box: View [ x = 3, y = 19, width = { parent.width - 8 }, height = { parent.height - 26 }, clip = true,
        fill = { classroot.boxColor },
        scrolls = { classroot.opened ? "y" : "none" }, hideScrollbars = true,

        // a wheel notch steps the open day's hours ten pixels. Closed, the box lets
        // a press through to the day, its events taking their own

        onWheel(e: WheelEvent) { if (classroot.opened && e.deltaY != 0) scroller.step(Math.sign(e.deltaY)) },
        pointerEvents = { classroot.opened ? "auto" : "none" },

        hours: View [ visible = { classroot.opened },
            grid: Image [ x = -2, source = "resources/ol/images/day/cal_timegrid.png" ]
            ],

        events: View [ visible = { app.started },
            datapath = { classroot.dayEvents.value },
            EventLine [ datapath = :list[],
                eventId = :id, category = { :category ?? "" }, start = :start, end = :end, title = :title,
                order = { rowIndex }, opened = { classroot.opened }, reopened = { classroot.wasOpened } ]
            ],

        scroller: HourScrollbar [ x = { parent.width - 14 }, height = { parent.height }, visible = { classroot.opened }, ignoreScroll = true,
            idleGround = { classroot.boxColor } ]
        ],

    // the box's color: light grey while selected, or, in a drag, while the dragged
    // event is over it; else by whose month and what day it is

    boxColor: Color = { boxColorOf(app.started, app.drag.moving ? app.drag.over === this : selected, inMonth, weekend) },
    boxColorOf(on: boolean, sel: boolean, mine: boolean, wkend: boolean) -> Color {
        if (on && sel) return 0xD3D3D3
        if (on && !mine) return 0x768A97
        if (on && wkend) return 0x879BA8
        return 0x9BA9B1
        },

    // this day's events, earliest first

    dayEvents: Dataset [ contents = { { list: app.events.on(classroot.key) } } ],

    // the width a selected event's bar takes in this day

    eventWidth: number = { box.width - (opened ? 38 : 0) }
    ]


/*
## The selected day's frame

A bevelled frame laid over the selected day, following it as it moves: its date
at the top left, and at the top right a button that opens the day (+) or, open,
closes it (−).
*/

class DayLook [
    cell: DayCell? = { app.activeDay },
    x = { cell != null ? cell.x + app.grid.x : 0 },
    y = { cell != null ? cell.y + app.grid.y : 0 },
    width = { cell != null ? cell.width : 150 },
    height = { cell != null ? cell.height : 23 },
    opened: boolean = { cell != null && cell.opened },

    topLeft: Image [ x = -1, y = -1, source = "resources/ol/images/day-grab-bar/top_lft2.png" ],
    topMiddle: Image [ x = 5, width = { parent.width - 22 }, fit = both, source = "resources/ol/images/day-grab-bar/top_mdl2.png" ],
    toggle: Control [ x = { 5 + parent.width - 22 - 1 }, y = -1, width = 19, height = 21,
        accessibilityLabel = { classroot.opened ? "Close the day" : "Open the day" },
        press() { if (classroot.opened) app.closeDay(); else if (classroot.cell != null) app.openDay(classroot.cell.key) },
        Image [ source = { "resources/ol/images/day-grab-bar/top_rt_slct_" + (classroot.opened ? "-" : "+") + "_"
            + (parent.pressed ? "dn" : parent.hovered ? "mo" : "up") + ".png" } ]
        ],
    day: Label [ x = 3, y = 2, width = 60, textColor = #DAE3E8,
        text = { classroot.cell != null ? "" + classroot.cell.date.getDate() : "0" } ],

    leftSide: Image [ x = -2, y = 19, height = { parent.height - 26 }, fit = both, source = "resources/ol/images/day-grab-bar/lft_mid_slct.png" ],
    rightSide: Image [ x = { parent.width - 5 }, y = 19, height = { parent.height - 26 }, fit = both,
        source = "resources/ol/images/day-grab-bar/rt_mid_slct.png" ],
    bottomLeft: Image [ y = { parent.height - 7 }, source = "resources/ol/images/day-grab-bar/bot_lft_slct.png" ],
    bottomMiddle: Image [ x = 6, y = { parent.height - 7 }, width = { parent.width - 12 }, fit = both,
        source = "resources/ol/images/day-grab-bar/bot_mid_slct.png" ],
    bottomRight: Image [ x = { parent.width - 6 }, y = { parent.height - 7 }, source = "resources/ol/images/day-grab-bar/bot_rt_slct.png" ]
    ]


/*
## The selected event's bar

A white bar laid over the selected event, its hour and title, with a gripper
along its top and a foot along its bottom, both tinted for the event's kind, and
the info button hanging off its left end. It follows its event; while the event
is dragged it follows the pointer instead.
*/

class EventBar [
    line: EventLine? = { app.selectedLine },
    cell: DayCell? = { app.selectedCell },
    art: string = { line == null || line.category == "" ? "none" : line.category },
    visible = { line != null && cell != null && cell.visible },
    x = { app.drag.moving ? app.drag.barX
        : line != null && cell != null ? app.grid.x + cell.x + cell.box.x + line.x : 0 },

    // where it stands in the window; its band may start lower

    top: number = { app.drag.moving ? app.drag.barY
        : line != null && cell != null ? app.grid.y + cell.y + cell.box.y + line.y - cell.box.scrollY : 0 },
    y = { top - parent.y },

    // as wide as its day's events, or, floating free in a drag, the day it is over

    width = { app.drag.moving && !app.drag.snapped && app.drag.over != null ? app.drag.over.eventWidth
            : cell != null ? cell.eventWidth : 0 },
    height = { line != null ? line.height : 22 },
    fill = #FFFFFF,

    hour: Label [ x = 2, y = 5, textColor = #4B5D6C,
        text = { app.drag.moving && app.drag.snapped ? hourLabel(app.drag.hour)
               : classroot.line != null ? hourLabel(Math.floor(classroot.line.start / 60)) : "" } ],
    wordsClip: View [ width = { parent.width }, height = { parent.height }, clip = true,
        Label [ x = { roomOf(classroot.hour.text) + 5 }, y = 5, textColor = #4B5D6C,
            text = { classroot.line != null ? classroot.line.title : "" } ]
        ],
    gripTop: View [ x = -2, width = { parent.width + 2 }, height = 7, clip = true,
        Image [ source = { "resources/ol/tinted/" + classroot.art + "/gripper.png" } ]
        ],
    gripFoot: Image [ y = { parent.height - 3 }, width = { parent.width }, height = 7, fit = both,
        source = { "resources/ol/tinted/" + classroot.art + "/selector_btm3.png" } ],
    info: Control [ x = -21, y = -1, width = 21, height = 24, accessibilityLabel = "Event info",
        press() { app.openInfo() },
        ground: Image [ source = { "resources/ol/tinted/" + classroot.art + "/event_infobtn_"
            + (parent.pressed ? "dn" : parent.hovered ? "mo" : "up") + ".png" } ],
        mark: Image [ source = "resources/ol/images/buttons/event_infobtn_icon.png" ]
        ]
    ]


// A drag of the selected event: where the pointer took the bar; the day under the
// pointer, which lights up while the bar is over it; and, over the event's own
// open day near its column, the quarter hour the bar is on. A drop moves the event
// to that time, or to the lit day; off the grid, it is let go where it was.

class Drag extends Node [
    line: EventLine? = null,
    over: DayCell? = null,
    moving: boolean = false,
    grabX: number = 0,
    grabY: number = 0,
    startX: number = 0,
    barX: number = 0,
    barY: number = 0,
    snapped: boolean = false,
    hour: number = 0,
    minute: number = 0,

    begin(l: EventLine, e: PointerEvent) {
        line = l
        const o = l.rootOrigin()
        startX = o.x
        grabX = e.rootX - o.x; grabY = e.rootY - o.y
        },
    follow(e: PointerEvent) {
        if (line == null) return
        moving = true
        snapped = false
        over = app.dayUnder(e.rootX, e.rootY)
        const cell = app.selectedCell
        if (cell != null && cell.opened && Math.abs(e.rootX - grabX - startX) < 30) {
            const boxY = app.grid.y + cell.y + cell.box.y
            const top = e.rootY - grabY
            const lowest = boxY + cell.box.height - app.band.bar.height
            if (top > boxY - 30 && top < lowest + 30) {
                snapped = true
                barX = startX
                barY = Math.max(boxY, Math.min(lowest, top))
                // the quarter hour nearest where the bar stands: an event is drawn
                // 11 down from its hour's line, 22 to the hour
                const quarters = Math.max(0, Math.min(95, Math.round((barY - boxY + cell.box.scrollY - 11) / 22 * 4)))
                hour = Math.floor(quarters / 4)
                minute = (quarters % 4) * 15
                return
                }
            }
        barX = e.rootX - grabX
        barY = e.rootY - grabY
        },
    drop(canceled: boolean) {
        if (moving && !canceled && line != null) {
            if (snapped) app.events.setStart(line.eventId, hour * 60 + minute)
            else if (over != null && over.key != app.keyOfEvent(line.eventId)) app.moveSelectedTo(over.date)
            }
        moving = false
        snapped = false
        over = null
        line = null
        }
    ]


/*
## The info panel

The selected event's details in a framed panel: its title, its day and times,
each with arrows that step it, and three sections, Notes, Location and
Attendees, one open at a time. Apply keeps what was typed; Delete removes the
event. A new event closed without Apply is removed.
*/

// A value shown in a box, its top and left edges dark and its bottom and right
// edges white, as if pressed into the panel.

class InfoValue [ height = 14,
    text: string = "",
    edge: View [ width = { parent.width }, height = 1, fill = #333333 ],
    side: View [ y = 1, width = 1, height = { parent.height - 1 }, fill = #333333 ],
    under: View [ y = { parent.height }, width = { parent.width }, height = 1, fill = #FFFFFF ],
    after: View [ x = { parent.width }, y = { parent.height }, width = 1, height = 1, fill = #FFFFFF ],
    value: Label [ x = 2, width = { parent.width - 4 }, textColor = #000000, text = { classroot.text } ]
    ]


// A field of the panel: white, with a dark top and left edge. What is typed is
// kept when the field is left.

class InfoField extends TextInput [ fill = #FFFFFF, cornerRadius = 0, padding = [0, 3, 2, 1],
    textColor = #000000,
    stroke = [Stroke(1, #000000), null, null, Stroke(1, #000000)],
    commitOn = "end"
    ]


// One of the panel's arrows, stepping something back or on.

class StepArrow extends ArtButton [ width = 14,
    back: boolean = true,
    upArt = { "resources/ol/images/infopanel/" + (back ? "larrow" : "rarrow") + ".png" },
    overArt = { "resources/ol/images/infopanel/" + (back ? "larrow" : "rarrow") + "_bright.png" },
    downArt = { "resources/ol/images/infopanel/" + (back ? "larrow" : "rarrow") + "_dim.png" }
    ]


// A section of the panel: a 21px bar with its name, and under it, while open, a
// field. Opening one closes the open one, over 200ms.

class InfoSection [ width = 100%, clip = true, fill = #EEF0EB,
    label: string = "",
    field: string = "notes",
    open: boolean = { app.infoSection == field },
    extent: number = { open ? 323 : 21 },
    opening: Animator [ attribute = extent, to = 323, duration = 200, easing = laszloBoth, started = { classroot.open } ],
    closing: Animator [ attribute = extent, to = 21, duration = 200, easing = laszloBoth, started = { !classroot.open } ],
    height = { extent },
    accessibilityRole = group, accessibilityLabel = { label },

    bar: Control [ width = { parent.width }, height = 21, fill = { classroot.open ? 0xE2E4DF : 0xEEF0EB },
        accessibilityLabel = { classroot.label }, accessibilityExpanded = { classroot.open },
        press() { app.infoSection = classroot.field },
        lightLine: View [ width = { parent.width }, height = 1, fill = { classroot.open ? 0xB8B9B5 : 0xFDFFFF } ],
        darkLine: View [ y = 20, width = { parent.width }, height = 1, fill = { classroot.open ? 0xFDFFFF : 0xC6C7C4 } ],
        name: Label [ x = 5, y = 1, width = 150, textColor = #898B86, text = { classroot.label } ],
        mark: Image [ x = { parent.width - 15 }, y = 10, source = "resources/ol/images/infopanel/tabarrow.png" ]
        ],
    entry: InfoField [ x = 10, y = 31, width = 175, height = 280, multiline = true, visible = { classroot.height > 21 },
        accessibilityLabel = { classroot.label },
        value = { app.textOf(classroot.field) },
        commit(v: string) { app.keepText(classroot.field, v) }
        ]
    ]


class InfoPanel [ width = 203, height = 516, clip = true,
    topLeft: Image [ x = -1, y = -1, source = "resources/ol/images/day-grab-bar/top_lft2.png" ],
    topMiddle: Image [ x = 5, width = { parent.width - 22 }, fit = both, source = "resources/ol/images/day-grab-bar/top_mdl2.png" ],
    closeBtn: ArtButton [ x = { 5 + parent.width - 22 - 1 }, y = -1, accessibilityLabel = "Close",
        upArt = "resources/ol/images/day-grab-bar/top_rt_infoclose_up.png",
        overArt = "resources/ol/images/day-grab-bar/top_rt_infoclose_mo.png",
        downArt = "resources/ol/images/day-grab-bar/top_rt_infoclose_dn.png",
        press() { app.closeInfo() }
        ],
    leftRail: Image [ x = -2, y = 19, height = { parent.height - 26 }, fit = both, source = "resources/ol/images/day-grab-bar/lft_mid_slct.png" ],
    rightRail: Image [ x = { parent.width - 7 }, y = 19, height = { parent.height - 26 }, fit = both,
        source = "resources/ol/images/day-grab-bar/rt_mid_slct.png" ],
    footLeft: Image [ y = { parent.height - 7 }, source = "resources/ol/images/day-grab-bar/bot_lft_slct.png" ],
    footMiddle: Image [ x = 6, y = { parent.height - 7 }, width = { parent.width - 12 }, fit = both,
        source = "resources/ol/images/day-grab-bar/bot_mid_slct.png" ],
    footRight: Image [ x = { parent.width - 6 }, y = { parent.height - 7 }, source = "resources/ol/images/day-grab-bar/bot_rt_slct.png" ],
    heading: Label [ x = 5, y = 1, width = { parent.width - 30 }, textColor = #DAE3E8, text = "Event Info", accessibilityRole = heading ],

    contents: View [ x = 3, y = 19, width = { parent.width - 6 }, height = { parent.height - 27 }, fill = #9BA9B1,
        textColor = #000000,

        summary: View [ width = 198, height = 83, fill = #EEF0EB,
            content: View [ x = 10, y = 10, width = 178,
                layout: SimpleLayout [ axis = y, spacing = 5 ],
                title: InfoField [ width = 178, height = 20, accessibilityLabel = "Title",
                    value = { app.textOf("title") },
                    commit(v: string) { app.keepText("title", v) }
                    ],
                day: View [ height = 16,
                    InfoValue [ y = 1, width = 150, text = { app.selectedInfo != null ? app.longDate(app.selectedInfo) : "" } ],
                    StepArrow [ x = 149, back = true, accessibilityLabel = "A day earlier",
                        press() { app.stepDay(-1) }
                        ],
                    StepArrow [ x = 163, back = false, accessibilityLabel = "A day later",
                        press() { app.stepDay(1) }
                        ]
                    ],
                times: View [ height = 16,
                    InfoValue [ y = 1, width = 45, text = { app.selectedInfo != null ? longTime(app.selectedInfo.start) : "" } ],
                    StepArrow [ x = 49, back = true, accessibilityLabel = "Start earlier",
                        press() { app.stepStart(-1) }
                        ],
                    StepArrow [ x = 63, back = false, accessibilityLabel = "Start later",
                        press() { app.stepStart(1) }
                        ],
                    Label [ x = 81, width = 20, text = "to" ],
                    InfoValue [ x = 100, y = 1, width = 45, text = { app.selectedInfo != null ? longTime(app.selectedInfo.end) : "" } ],
                    StepArrow [ x = 149, back = true, accessibilityLabel = "End earlier",
                        press() { app.stepEnd(-1) }
                        ],
                    StepArrow [ x = 163, back = false, accessibilityLabel = "End later",
                        press() { app.stepEnd(1) }
                        ]
                    ],
                rule: View [ x = 5, width = { parent.width - 10 }, height = 1, fill = #EEF0EB ]
                ]
            ],

        gutterTop: View [ y = 83, width = { parent.width - 7 }, height = 4, fill = #EEF0EB,
            View [ width = { parent.width }, height = 1, fill = #B8B9B5 ],
            View [ y = 3, width = { parent.width }, height = 1, fill = #FDFFFF ]
            ],

        sections: View [ y = 87, width = 100%, height = 365,
            layout: SimpleLayout [ axis = y ],
            InfoSection [ label = "Notes", field = "notes" ],
            InfoSection [ label = "Location", field = "location" ],
            InfoSection [ label = "Attendees", field = "attendees" ]
            ],

        gutterFoot: View [ y = 452, width = { parent.width - 7 }, height = 3, fill = #EEF0EB,
            View [ width = { parent.width }, height = 1, fill = #B8B9B5 ],
            View [ y = 3, width = { parent.width }, height = 1, fill = #FDFFFF ],
            apply: CalButton [ x = 15, y = 13, label = "Apply",
                press() { app.applied = true }
                ],
            remove: CalButton [ x = { parent.width - this.width - 15 }, y = 13, label = "Delete",
                press() { app.deleteSelected() }
                ]
            ]
        ]
    ]


// One day name over its column, centered on the column's top cell as it moves;
// in the day view, only the open day's.

class DayName extends Image [
    col: number = 0,
    cell: DayCell? = { app.grid.childViews.length > col ? app.grid.childViews[col] as DayCell : null },
    x = { cell != null ? cell.x + (cell.width - 63) / 2 : 0 },
    visible = { app.view != "day" || col == (app.openIndex >= 0 ? app.openIndex : app.selectedIndex) % 7 }
    ]


/*
## The app
*/

schema Box [ x: number, y: number, w: number, h: number, vis: boolean ]

App [ width = 835, height = 600, fill = #1E3A49,
    fontFamily = ["Verdana", "Vera", "sans-serif"], fontSize = 11, textColor = #FFFFFF,

    events: Events [ ],
    clock: Time [ tick = day ],

    // ── where the person is ────────────────────────────────────────────────

    // the calendar comes up once the toolbar has slid in, its selection frame a
    // second after

    started: boolean = false,
    framed: boolean = false,

    year: number = { new Date(app.clock.now).getFullYear() },
    month: number = { new Date(app.clock.now).getMonth() },
    view: string = "month",
    selectedKey: string = "",
    openKey: string = "",
    selectedEvent: number = -1,
    infoOpen: boolean = false,
    infoUsed: boolean = false,
    infoSection: string = "notes",
    applied: boolean = true,

    // ── the month ─────────────────────────────────────────────────────────

    // the Sunday on or before the 1st, and five rows or six

    firstShown: Date = { new Date(app.year, app.month, 1 - new Date(app.year, app.month, 1).getDay()) },
    rows: number = { new Date(app.year, app.month, 1).getDay() + new Date(app.year, app.month + 1, 0).getDate() > 35 ? 6 : 5 },
    dateAt(i: number) -> Date { return new Date(firstShown.getFullYear(), firstShown.getMonth(), firstShown.getDate() + i) },
    indexOfKey(key: string) -> number {
        for (let i = 0; i < rows * 7; i++) if (keyOf(dateAt(i)) == key) return i
        return -1
        },
    keyOfEvent(id: number) -> string { const e = app.events.find(id); return e != null ? e.y + "-" + e.m + "-" + e.d : "" },

    selectedIndex: number = { app.indexOfKey(app.selectedKey) },
    openIndex: number = { app.indexOfKey(app.openKey) },

    activeDay: DayCell? = null,
    selectedCell: DayCell? = { app.activeDay != null && app.activeDay.key == app.keyOfEvent(app.selectedEvent) ? app.activeDay : null },
    selectedLine: EventLine? = { app.lineOf(app.selectedCell, app.selectedEvent) },
    lineOf(cell: DayCell?, id: number) -> EventLine? {
        if (cell == null) return null
        for (const l of cell.box.events.childViews) if ((l as EventLine).eventId == id) return l as EventLine
        return null
        },

    // the day under a point of the window, the gap after a day counting as that
    // day, as the original counts it; none off the grid. It is measured from the
    // cells' places rather than asked of viewAt, which would answer the gap's
    // background, or the dragged bar under the pointer

    dayUnder(rx: number, ry: number) -> DayCell? {
        const gx = rx - grid.x, gy = ry - grid.y
        if (gx < 0 || gx > grid.width || gy < 0 || gy > grid.height) return null
        for (const c of grid.childViews) {
            const cell = c as DayCell
            if (cell.visible && gx >= cell.x && gx < cell.x + cell.width + 4 && gy >= cell.y && gy < cell.y + cell.height + 4) return cell
            }
        return null
        },

    selectedInfo: CalEvent? = { app.events.find(app.selectedEvent) },
    longDate(e: CalEvent) -> string { return monthName(e.m - 1) + " " + e.d + ", " + e.y },
    textOf(field: string) -> string {
        const e = selectedInfo
        if (e == null) return ""
        return field == "title" ? e.title : field == "notes" ? e.notes ?? "" : field == "location" ? e.location ?? "" : e.attendees ?? ""
        },

    // ── the grid's arrangement ────────────────────────────────────────────

    gridWidth: number = 808,
    gridHeight: number = 516,

    // where cell i goes, for the facts as they stand

    boxOf(i: number) -> Box {
        const sp = 4
        const rowOnly = view != "month"
        const colOnly = view == "day"
        const openRow = openIndex < 0 ? -1 : Math.floor(openIndex / 7)
        const openCol = openIndex < 0 ? -1 : openIndex % 7
        const fr = openRow < 0 ? Math.floor(selectedIndex / 7) : openRow
        const fc = openCol < 0 ? selectedIndex % 7 : openCol
        const cw = Math.floor((gridWidth - sp * 6) / 7)
        const ch = Math.floor((gridHeight - sp * (rows - 1)) / rows)
        const k = openCol < 0 ? 0 : 1
        const cellW = cw - Math.floor(k * 150 / 6)
        const cellH = ch - Math.floor(k * 170 / (rows - 1))
        const hOf = (ri: number) => rowOnly ? (ri == fr ? gridHeight : 0) : ri != openRow ? cellH : ch + 170
        const wOf = (ci: number) => colOnly ? (ci == fc ? gridWidth - sp : 0) : ci != openCol ? cellW : cw + 150
        const r = Math.floor(i / 7), c = i % 7
        let x = 0, y = 0
        for (let cc = 0; cc < c; cc++) x += wOf(cc) + (colOnly ? 0 : sp)
        for (let rr = 0; rr < r; rr++) y += hOf(rr) + (rowOnly ? 0 : sp)
        const w = wOf(c), h = hOf(r)
        return ({ x: x, y: y, w: w, h: h, vis: w > 0 && h > 0 && r < rows })
        },

    // send every cell where the facts put it, gliding or at once

    arrange(glide: boolean) {
        afterSettle(() => {
            for (const c of grid.childViews) { const cell = c as DayCell; cell.arrange(boxOf(cell.index), glide) }
            })
        },
    onInit() { arrange(false) },

    // Tab: the toolbar, the selected day's open button, the grid and its events,
    // the selected event's info button, the panel. The frame is declared after the
    // grid so that it paints over it, but it is reached before the day's events.

    tabOrder() { return [top, look, grid, band, interior] },

    // ── what the person does ──────────────────────────────────────────────

    // a month, in the month view, its 1st selected; the selected event is let go
    // unless it is the one being moved there

    show(month: number, year: number, keepEvent: boolean) {
        if (month == app.month && year == app.year) return
        app.month = month; app.year = year
        openKey = ""; view = "month"
        if (!keepEvent) leaveEvent()
        selectedKey = keyOf(new Date(year, month, 1))
        arrange(false)
        },
    step(dir: number) {
        const d = new Date(year, month + dir, 1)
        show(d.getMonth(), d.getFullYear(), false)
        },

    // open a day: in the month view at once, in the week and day views gliding

    openDay(key: string) {
        selectedKey = key
        openKey = key
        arrange(view != "month")
        },
    closeDay() {
        openKey = ""
        if (view == "day") { view = "month"; arrange(true); return }
        arrange(view != "month")
        },

    showDay() { openKey = selectedKey; view = "day"; arrange(true) },
    showWeek() {
        const row = Math.floor(selectedIndex / 7)
        if (view == "week" || openIndex < 0 || Math.floor(openIndex / 7) != row) openKey = ""
        view = "week"
        arrange(true)
        },
    showMonth() {
        if (view == "month") { if (openKey != "") { openKey = ""; arrange(false) } return }
        view = "month"
        arrange(true)
        },

    selectEvent(id: number) {
        selectedEvent = id
        const key = keyOfEvent(id)
        if (key != "") selectedKey = key
        },

    // the bar goes, and the info panel half a second later

    leaveEvent() {
        selectedEvent = -1
        if (infoOpen) afterDelay(500, () => { if (selectedEvent < 0) closeInfo() })
        },

    drag: Drag [ ],

    moveSelectedTo(day: Date) {
        if (selectedEvent < 0) return
        events.setDay(selectedEvent, day)
        selectedKey = keyOf(day)
        },

    // ── the info panel ────────────────────────────────────────────────────

    addEvent() {
        const day = selectedIndex >= 0 ? dateAt(selectedIndex) : new Date(year, month, 1)
        selectedEvent = events.add(day)
        openInfo()
        applied = false
        },

    // the title takes the keyboard with its words selected, ready to be typed over

    focusTitle() {
        const t = interior.info.contents.summary.content.title
        Focus.focus(t)
        t.select(0, t.value.length)
        },
    openInfo() {
        if (infoOpen) { focusTitle(); return }
        if (selectedInfo != null && selectedInfo.title != "New Event") applied = true
        gridWidth = 602
        arrange(false)
        infoUsed = true
        infoOpen = true
        },
    closeInfo() {
        if (!applied) deleteSelected()
        if (!infoOpen) return
        infoOpen = false
        applied = true
        },

    // once the panel has slid away, the grid takes the room back, two pixels more
    // than it started with

    infoGone() { gridWidth = 810; arrange(false) },

    keepText(field: string, text: string) { if (selectedEvent >= 0) events.setText(selectedEvent, field, text) },
    deleteSelected() {
        if (selectedEvent < 0) return
        const id = selectedEvent
        leaveEvent()
        events.remove(id)
        },
    stepStart(dir: number) {
        const e = selectedInfo
        if (e == null) return
        const s = e.start + 15 * dir
        if (s >= 0 && s < 1440) events.setStart(e.id, s)
        },
    stepEnd(dir: number) { if (selectedEvent >= 0) events.stepEnd(selectedEvent, dir) },

    // the event a day earlier or later; the selection follows, paging the month
    // at its ends, and the view stays as it is

    stepDay(dir: number) {
        const e = selectedInfo
        if (e == null) return
        const day = new Date(e.y, e.m - 1, e.d + dir)
        events.setDay(e.id, day)
        const key = keyOf(day)
        if (indexOfKey(key) < 0) show(day.getMonth(), day.getFullYear(), true)
        selectedKey = key
        if (view == "day") showDay()
        else if (view == "week") showWeek()
        },

    // ── the toolbar, sliding down from above at the start ──────────────────

    top: View [ x = 20, y = -50, width = 806, fontSize = 10,
        slideIn: Animator [ attribute = y, to = 0, duration = 500, easing = laszloBoth, started = true,
            onStop() {
                app.started = true
                app.selectedKey = keyOf(new Date(app.year, app.month, 1))
                app.arrange(false)
                afterDelay(1000, () => { app.framed = true })
                }
            ],

        weekBar: View [ y = 26, width = 808, height = 26, fill = #354D5B,
            names: View [ y = 11, width = 792,
                DayName [ col = 0, source = "resources/ol/images/days-of-week/sun.png" ],
                DayName [ col = 1, source = "resources/ol/images/days-of-week/mon.png" ],
                DayName [ col = 2, source = "resources/ol/images/days-of-week/tues.png" ],
                DayName [ col = 3, source = "resources/ol/images/days-of-week/wed.png" ],
                DayName [ col = 4, source = "resources/ol/images/days-of-week/thurs.png" ],
                DayName [ col = 5, source = "resources/ol/images/days-of-week/fri.png" ],
                DayName [ col = 6, source = "resources/ol/images/days-of-week/sat.png" ]
                ],
            rule: View [ y = 25, width = { parent.width }, height = 1, fill = #708A94 ]
            ],

        bar: View [ width = { parent.width }, height = 32, fill = #354D5B,
            art: Image [ source = "resources/ol/images/menubar/mainbar-overlay.png" ],
            logo: Image [ source = "resources/ol/images/menubar/logo.png", accessibilityLabel = "Laszlo Calendar" ],

            views: View [ x = 141, y = 4,
                layout: SimpleLayout [ axis = x ],
                CalButton [ rightCap = "shear", icon = "iconday", label = "day", accessibilityLabel = "Day view",
                    press() { app.showDay() }
                    ],
                CalButton [ leftCap = "shear", rightCap = "shear", icon = "iconweek", label = "week", accessibilityLabel = "Week view",
                    press() { app.showWeek() }
                    ],
                CalButton [ leftCap = "shear", icon = "iconmonth", label = "month", accessibilityLabel = "Month view",
                    press() { app.showMonth() }
                    ]
                ],

            pager: View [ x = 321, y = 8, width = 161,
                back: CalButton [ rightCap = "shear", icon = "iconleftarrow", accessibilityLabel = "Previous month",
                    press() { app.step(-1) }
                    ],
                plate: ButtonArt [ x = { parent.back.width }, leftCap = "shear", rightCap = "shear",
                    width = { parent.width - parent.back.width - parent.next.width } ],
                next: CalButton [ x = { parent.width - this.width }, leftCap = "shear", leftInset = 5, rightInset = 9,
                    icon = "iconrightarrow", accessibilityLabel = "Next month",
                    press() { app.step(1) }
                    ]
                ],

            titleShadow: Label [ x = { parent.title.x - 0.3 }, y = 9, opacity = 0.5, fontWeight = bold,
                textColor = #143B45, text = { parent.title.text }, accessibilityHidden = true ],
            title: Label [ y = 10, x = { Math.round((parent.width - roomOf(this.text)) / 2) - 2 }, fontWeight = bold,
                accessibilityLive = polite, text = { monthName(app.month) + " " + app.year } ],

            addEvent: CalButton [ x = 496, y = 5, label = "Add Event",
                press() { app.addEvent() }
                ]
            ]
        ],

    // ── the grid ───────────────────────────────────────────────────────────

    cells: Dataset [ contents = { { cells: [...Array(42).keys()].map((i) => ({ i: i })) } } ],

    grid: View [ x = 20, y = 57, width = { app.gridWidth }, height = { app.gridHeight },
        focusable = true,
        accessibilityRole = grid,
        accessibilityLabel = { monthName(app.month) + " " + app.year },
        accessibilityActiveItem = { app.activeDay },
        keyBindings = { [ ({ key: "ArrowLeft", command: "moveSelection", args: [-1] }),
                          ({ key: "ArrowRight", command: "moveSelection", args: [1] }),
                          ({ key: "ArrowUp", command: "moveSelection", args: [-7] }),
                          ({ key: "ArrowDown", command: "moveSelection", args: [7] }),
                          ({ key: "Enter", command: "toggleSelected" }) ] },
        moveSelection(d: number) {
            const i = Math.max(0, Math.min(app.rows * 7 - 1, app.selectedIndex + d))
            app.selectedKey = keyOf(app.dateAt(i))
            },
        toggleSelected() { if (app.openKey == app.selectedKey) app.closeDay(); else app.openDay(app.selectedKey) },
        focusShape() {
            const c = app.activeDay
            return c != null ? ({ x: c.x, y: c.y, w: c.width, h: c.height, rad: 0 }) : ({ x: 0, y: 0, w: this.width, h: this.height, rad: 0 })
            },
        datapath = { app.cells.value },
        DayCell [ datapath = :cells[], index = :i ]
        ],

    look: DayLook [ visible = { app.started && app.activeDay != null }, opacity = { app.framed ? 1 : 0 } ],

    // the selected event's bar rides in a band: the whole window while the event
    // floats free, its open day's hours while it sits in one, so that scrolling the
    // day carries the bar out of sight with its event rather than past the day. The
    // band itself lets presses through to the grid; only the bar takes them

    band: View [ width = 100%, clip = { held }, pointerEvents = "none",
        held: boolean = { app.selectedCell != null && app.selectedCell.opened && !(app.drag.moving && !app.drag.snapped) },
        y = { held ? app.grid.y + app.selectedCell!.y + app.selectedCell!.box.y : 0 },
        height = { held ? app.selectedCell!.box.height : app.height },
        bar: EventBar [ pointerEvents = "auto" ]
        ],

    // ── the info panel, sliding in from the right over the grid's edge ──────

    interior: View [ x = 20, y = 57, width = 810, height = 516, clip = true,
        info: InfoPanel [ x = 830, opacity = 0, visible = { this.x < 830 },
            slideIn: Animator [ attribute = x, from = 830, to = 602, duration = 500, easing = laszloBoth, started = { app.infoOpen },
                onStop() { app.focusTitle() }
                ],
            fadeIn: Animator [ attribute = opacity, from = 0, to = 1, duration = 500, easing = laszloBoth, started = { app.infoOpen } ],
            slideOut: Animator [ attribute = x, from = 602, to = 830, duration = 500, easing = laszloBoth,
                started = { app.infoUsed && !app.infoOpen },
                onStop() { app.infoGone() }
                ],
            fadeOut: Animator [ attribute = opacity, to = 0, duration = 400, easing = laszloBoth,
                started = { app.infoUsed && !app.infoOpen } ]
            ]
        ]
    ]
