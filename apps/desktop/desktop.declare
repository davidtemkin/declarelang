// the desktop itself — the About/Source subject when no application's window
// is front; not in the dock roster

class DeskApp extends DesktopApp [ id = "desktop", label = "Declare Desktop", title = "Declare Desktop",
    blurb = "A Mac desktop, declared. Windows, dock, and menus are views and records, all drawn — no bitmaps, no borrowed art.",
    glyph = "[  ]", hue1 = #4AA8E8, hue2 = #35C4B5,
    launch(v: View?) { app.launcher.newFiles() }
    ]


/*
### WinSlot — the one imperative hinge of windows-as-data

Replication cannot vary a CLASS per record (the tag is structure, fixed at
compile time), so every window record replicates this one fixed slot, and the
slot creates its record's class by name — `createView(:cls)`, the string door
`use` holds open. Everything else about a window is data: which windows
exist, their stacking (record order IS paint order — a raise is `list.move`),
and which are parked (the `mini` tail). The slot fills the layer and declares
no handlers, so it is transparent to the pointer; the window inside is the
citizen. The slot also resolves the record's non-data companions at birth:
the application instance (by id) and the origin view (the launcher's
`takeBorn` side channel — a node reference never enters data-shaped state).
*/

class WinSlot extends View [ width = { parent.width }, height = { parent.height },
    recId: string = { "" + (:id ?? "") },
    win: Window = null,
    onInit() {
        const props = ({ ...((:props ?? ({})) as object),
            recId: "" + (:id ?? ""),
            forApp: app.launcher.byId("" + (:appId ?? "")),
            bornFrom: app.launcher.takeBorn("" + (:id ?? "")) })
        this.win = this.createView("" + (:cls ?? "View"), props as Record<string, unknown>) as Window
        }
    ]


/*
### The window manager

The desktop's core model, faceless: the set of windows as it exists — who is
front, who is parked in the dock — with no pixels of its own. THE WINDOW LIST
IS DATA (`list`, windows-as-data 2026-08-25): one record per window
{ id, cls, appId, mini, props… }, whose ORDER is the paint order — a raise is
a `move`, an open an `insert` (before the minimized tail), a close a
`removeAt`, and the replicated WinSlots reconcile the views to match. That
retired the whole hand-bumped era: `winSeq`, `frontOpen`/`lowestMini`/
`raise(below)`, `rebuildMinis` + the `miniRecs`/`miniWins` parallel arrays,
the six-tile cap, and `seatCheck`'s deps-as-arguments — consumers now derive
from the records (through the tracked `read`) and from the windows the slots
carry.

The surface:

  facts   `list` (the records) · `frontWin` · `activeApp` · `miniCount` ·
          `miniData` (the parked records, ix-stamped, for the dock's tiles)
  verbs   `focusWin` · `bringFront` · `closeWin` · `quitApp` · `minimizeWin` ·
          `restoreMini`/`restoreMiniAt` · `dockOpen` (raise-or-restore-or-
          launch) · `addWin`/`raiseWin`/`focusNew` (the record verbs the
          launcher opens through) · `windows()`/`miniList()`/`winOf` (the live
          views, resolved through the slots)
*/

class WinManager extends Node [
    // WHO IS FRONT is data too — the record's id. `frontWin` DERIVES from it,
    // so the moment an insert's settle materializes the window, every reader
    // (shadows, the menu bar, activeApp) sees it — no wait-for-the-view step
    // anywhere.

    frontId: string = "",
    frontWin: Window = { this.winOf(this.frontId) },

    // two counters, one job each: `idSeq` mints record IDENTITY, `winCount`
    // staggers spawn POSITIONS — conflating them once made the welcome jot
    // shift every boot window by a stagger step

    idSeq: number = 0,
    winCount: number = 0,

    // the records. `recs()` reads through the TRACKED accessor, so a
    // constraint that derives from the list re-derives on every insert/move/
    // removeAt/set — mutations wake region cells, which plain `.value.wins`
    // property access would never subscribe to.

    list: Dataset { { "wins": [] } },

    recs() -> array { return (this.list.read(["wins"]) as object[]) ?? [] },
    minis() -> array { return this.recs().filter((r) => r.mini == true) },
    miniCount: number = { this.minis().length },

    // the parked records as DECLARED DATA for the dock's tile replication,
    // stamped with their band index (which is also each window's dockSlot)

    miniData: Dataset [ contents = { ({ minis: app.wm.minis().map((r, i) => ({ ...(r as object), ix: i })) }) } ],

    appOf(w: Window?) -> DesktopApp { return w != null && w.forApp != null ? w.forApp : app.launcher.files },

    activeApp: DesktopApp = { this.appOf(app.wm.frontWin) },

    // ── the live views, resolved through the slots (order = record order) ──

    windows() -> Window[] {
        const out = []
        for (const s of app.wins.childViews) { const w = (s as WinSlot).win; if (w != null) out.push(w) }
        return out as Window[]
        },
    miniList() -> Window[] { return this.windows().filter((w) => this.isMin(w)).sort((a, b) => this.ixOf(a) - this.ixOf(b)) },
    winOf(id: string) -> Window {
        for (const s of app.wins.childViews) { const sl = s as WinSlot; if (sl.recId == id && sl.win != null) return sl.win }
        return null
        },
    idxOf(id: string) -> number { return this.recs().findIndex((r) => r.id == id) },

    // ── the record verbs ──

    spawn() -> number { winCount = winCount + 1; return winCount },

    mintId() -> string { idSeq = idSeq + 1; return "w" + idSeq },

    // an open INSERTS before the minimized tail — top of the normal band

    addWin(rec: object) {
        const ws = this.recs()
        let at = ws.length
        for (let i = 0; i < ws.length; i++) if (ws[i].mini == true) { at = i; break }
        this.list.insert(["wins"], at, rec)
        },

    focusNew(id: string) { this.frontId = id },

    // a raise is a MOVE to the top of the normal band (just under the
    // minimized tail); the tail's own order is the band's business

    raiseWin(w: Window) {
        if (w == null || w.recId == "" || this.isMin(w)) return
        const ws = this.recs()
        const from = ws.findIndex((r) => r.id == w.recId)
        if (from < 0) return
        const rest = ws.filter((r) => r.id != w.recId)
        let to = rest.length
        for (let i = 0; i < rest.length; i++) if (rest[i].mini == true) { to = i; break }
        this.list.move(["wins"], from, to)
        },
    patchWin(id: string, p: object) {
        const i = this.idxOf(id)
        if (i < 0) return
        const ws = this.recs()
        this.list.set(["wins", i], ({ ...(ws[i] as object), ...(p as object) }))
        },
    removeWin(id: string) {
        const i = this.idxOf(id)
        if (i >= 0) this.list.removeAt(["wins"], i)
        },

    focusWin(w: Window?) { if (w == null) return; if (this.isMin(w)) this.restoreMini(w); else w.activate() },

    // Quit closes every window of that application — each by its own reverse
    // zoom — and clears its running flag (Files has no Quit; it's always
    // running). Running is an application state, not a window count: closing the
    // last window leaves the app running, its dock dot lit — only Quit ends it.

    quitApp(a: DesktopApp) {
        const doomed = this.windows().filter((w) => this.appOf(w) == a)
        for (const w of doomed) this.closeWin(w)
        a.running = false
        },

    /* A dock press dismisses an open menu AND does its own work — the dock rule,
       and worth stating because it is the opposite of a light dismiss. Clicking
       the wallpaper closes a menu and does nothing else; clicking the Dock closes
       it and opens the app, so the click is TAKEN, not swallowed.

       That is why the dock stays declared after `bar`: it paints above the menu's
       full-app backdrop, so the press reaches the dock rather than the catcher,
       and the dock closes the menu itself. `rootClose()` is what Escape uses —
       the whole chain, submenus included. Harmless when nothing is open.

       Every dock press routes through one of two verbs (dockOpen,
       restoreMiniAt), so this sits at the top of each rather than on a wrapper
       view: events do not bubble, so a press on an icon never reaches the dock. */

    dockOpen(a: DesktopApp, open: () -> void) {
        app.dockDismiss()
        const live = this.windows().filter((w) => this.appOf(w) == a && !this.isPlain(w) && !this.isMin(w))
        if (live.length > 0) { for (const w of live) this.focusWin(w); return }
        // nothing up but something in the dock: restore the most recent tile
        const mins = this.miniList().filter((w) => this.appOf(w) == a)
        if (mins.length > 0) { this.restoreMini(mins[mins.length - 1]); return }
        open()
        },

    /*
    ### Minimize to dock

    A minimized window becomes a dock citizen: its geometry constraints run the
    icons' own swell math, so it magnifies and displaces along with the row, and
    the dock's span is sprung so the plate widens smoothly to admit it. Parked
    membership is the record's `mini` flag (plus the label/size capture the dock
    fits tiles from); the journey (`miniT`, `dockSlot`, `homing`) stays the
    window's own — animators drive views, records carry facts.
    */

    isMin(w: Window?) -> boolean { return w != null && w.dockSlot >= 0 },
    ixOf(w: Window?) -> number { return w != null ? w.dockSlot : -1 },
    labelFor(w: Window) -> string { const t = this.titleOf(w); return t != "" ? t : this.appOf(w).title },

    startPark(w: Window) { w.miniBack.stop(); w.bornX = 0; w.bornY = 0; w.miniGo.start() },
    startUnpark(w: Window) { w.miniGo.stop(); w.miniBack.start() },

    // renumber the parked windows' dockSlots to their band order — after
    // every park, unpark, and close-of-parked

    renumberMinis() {
        const ms = this.minis()
        for (let i = 0; i < ms.length; i++) { const w = this.winOf("" + ms[i].id); if (w != null) w.dockSlot = i }
        },

    minimizeWin(w: Window) {
        if (w == null || this.isPlain(w) || this.isMin(w)) return
        // capture what the dock needs while the window is parked — label and
        // RAW geometry (pixel fitting is the dock's business, dock.tiles)
        this.patchWin(w.recId, ({ mini: true, label: this.labelFor(w), appId: this.appOf(w).id, winW: w.width, winH: w.height }))
        const from = this.idxOf(w.recId)
        if (from >= 0) this.list.move(["wins"], from, this.recs().length - 1)   // to the very top: the band's newest
        this.renumberMinis()
        if (frontId == w.recId) frontId = ""
        this.startPark(w)
        },

    bringFront(w: Window) { w.activate() },              // not focusWin — that would recurse via isMin

    restoreMini(w: Window) {
        if (w == null || !this.isMin(w) || w.homing) return   // already on the way home
        w.homing = true
        this.startUnpark(w)                      // the slot stays mine until the journey home ends
        this.bringFront(w)                       // frontmost from the first frame of the journey
        },

    // miniBack's onStop: the window is home — its record rejoins the normal
    // band's top, the slot is released, and it takes focus

    unparked(w: Window) {
        this.patchWin(w.recId, ({ mini: false }))
        const from = this.idxOf(w.recId)
        const rest = this.recs().filter((r) => r.id != w.recId)
        let to = rest.length
        for (let i = 0; i < rest.length; i++) if (rest[i].mini == true) { to = i; break }
        if (from >= 0) this.list.move(["wins"], from, to)
        w.dockSlot = -1
        w.homing = false
        this.renumberMinis()
        this.focusWin(w)
        },

    restoreMiniAt(i: number) {
        app.dockDismiss()
        const ws = this.miniList()
        if (i >= 0 && i < ws.length) this.restoreMini(ws[i])
        },
    closeWin(w: Window) { w.beginClose() },              // the reverse zoom; removal on its onStop

    reallyClose(w: Window) {
        // an About box carries its SUBJECT's forApp but is not a window OF that
        // app — `plain` is the discriminator, so closing "About Markdown" never
        // decrements the viewer count
        if (!w.plain && w.forApp != null) w.forApp.count = w.forApp.count - 1
        if (frontId == w.recId) frontId = ""
        this.removeWin(w.recId)                  // the record goes; replication discards slot + window
        this.renumberMinis()                     // a Quit can take a minimized window's tile with it
        },

    // seatedness for a tile's badge: the window's visual width equals the
    // slot's — pure geometry, read LIVE off the window the slot resolves
    // (per-frame during a journey, via tracking; no journey bookkeeping)

    seated(id: string, slotW: number) -> boolean {
        const w = this.winOf(id)
        if (w == null || w.homing == true) return false   // homing = leaving now: the badge goes first
        return w.scale < 0.9 && Math.abs(w.scale * w.width - slotW) < 0.5
        },

    isPlain(w: Window?) -> boolean { return w != null && w.plain },
    titleOf(w: Window?) -> string { return w != null ? w.title : "" }
    ]


/*
### The launcher

Getting applications BORN, faceless: the application INSTANCES (see "The
applications" above), the open verbs behind every dock click and menu item,
and the one launch gate their dots and bounces derive from. The window
manager owns windows once they exist; this node owns the moment before.

The instances replaced the application RECORDS array — which had itself
replaced five parallel flag families (attributes clustered by prefix are
records wanting to exist; records for a fixed catalog of stateful,
art-bearing citizens were in turn CLASSES wanting to exist). State is plain
reactive attributes on each instance — assignment is the update, no patch
ceremony — and the only data left is identity: `data` derives id + order for
the dock's replication, and each icon resolves its instance back from the id
(a node reference never enters data-shaped state).

The surface:

  facts   the instances (`files` … `terminal`, plus `desk`, the desktop
          itself) · `roster` (the dock's order) · `data` (id + ix, for the
          datapath) · `byId`
  verbs   each app's own `launch(v)` · `gated` (the launch bounce, once) ·
          `openHosted` · `openViewer`/`openDoc`/`openMarkdown` · `newFiles`/
          `openFolderWindow` · `newJot`/`openWelcome` · `openAbout`/
          `dismissAbouts` · `openSource`
*/

class Launcher extends Node [

    // the applications — one instance each (see "The applications"), plus
    // `desk`, the desktop itself (the About/Source subject; not in the dock)

    files:    FilesApp    [ ],
    markdown: MarkdownApp [ ],
    viewer:   ViewerApp   [ ],
    calendar: CalendarApp [ ],
    jots:     JotsApp     [ ],
    birds:    BirdsApp    [ ],
    write:    WriteApp    [ ],
    mail:     MailApp     [ ],
    music:    MusicApp    [ ],
    terminal: TerminalApp [ ],
    desk:     DeskApp     [ ],

    // the dock's order, and the enumeration every by-id lookup walks

    roster: DesktopApp[] = { [this.files, this.markdown, this.viewer, this.calendar,
        this.jots, this.birds, this.write, this.mail, this.music, this.terminal] },

    byId(id: string) -> DesktopApp { return this.roster.find((a) => a.id == id) ?? null },

    // Per-attribute accessors for ID-CARRIED references. A constraint may not
    // read an attribute off a node a method CHOSE at run time (DECLARE7001 —
    // the dependency can't be named at the call site), but a method may
    // return the ATTRIBUTE itself. These serve the STATIC facts (hues, glyph,
    // size, label): they re-derive whenever the id changes. The one LIVE
    // per-app flag, `running`, rides the data records above instead — a
    // class-body constraint does not wire reads made inside a method it
    // calls, so a mutation there would never wake it.

    hue1Of(id: string) -> Color { const a = this.roster.find((x) => x.id == id); return a != null ? a.hue1 : 0x4A90D9 },
    hue2Of(id: string) -> Color { const a = this.roster.find((x) => x.id == id); return a != null ? a.hue2 : 0x2E5FA3 },
    glyphOf(id: string) -> string { const a = this.roster.find((x) => x.id == id); return a != null ? a.glyph : "" },
    gsizeOf(id: string) -> number { const a = this.roster.find((x) => x.id == id); return a != null ? a.gsize : 0.42 },
    drawnOf(id: string) -> boolean { const a = this.roster.find((x) => x.id == id); return a != null && a.drawn },
    labelOf(id: string) -> string { const a = this.roster.find((x) => x.id == id); return a != null ? a.label : "" },

    // identity, order, and the ONE LIVE FLAG as DECLARED DATA, for the dock's
    // datapath (a cursor can only point into a Dataset, and a node reference
    // never enters data-shaped state — each icon resolves its instance back
    // from the id). The closure over the roster is LIVE: reads the extractor
    // can see but not name (`a.running`, through the map) put this constraint
    // on the runtime-tracking path, where every one of them wakes it.

    data: Dataset [ contents = { ({ apps: classroot.roster.map((a, i) => ({ id: a.id, ix: i, running: a.running })) }) } ],

    // THE LAUNCH GATE, once for every application. A first open (not running,
    // not launching) is a launch: the dock icon bounces and the window
    // appears mid-second-bounce, the way a fast-launching app feels; later
    // opens are instant. State moves inside the deferred step, so the running
    // dot appears when the app HAS launched, not at the click, and the
    // mid-launch flag guards a double-click during the bounce.

    gated(a: DesktopApp, body: () -> void) {
        const first = !a.running && !a.launching
        if (first) a.launching = true
        const go = () => {
            a.launching = false
            a.running = true
            a.count = a.count + 1
            body()
            }
        if (first) { app.dock.poke(a); setTimeout(go, 900) } else go()
        },

    // ── the one door every window opens through (windows-as-data): mint the
    // record, stash the origin view in the side channel (a node reference
    // never enters data-shaped state — the slot collects it at birth), insert
    // before the minimized tail, and focus the window the settle materializes.

    borns: object,                               // id → origin view, until the slot takes it
    onInit() { this.borns = ({}) },
    putBorn(id: string, v: View?) { if (v != null && this.borns != null) this.borns[id] = v },
    takeBorn(id: string) -> View {
        if (this.borns == null) return null
        const v = this.borns[id] ?? null
        delete this.borns[id]
        return v as View
        },

    openWin(id: string, cls: string, a: DesktopApp, props: object, v: View?) {
        this.putBorn(id, v)
        app.wm.addWin(({ id: id, cls: cls, appId: a.id, mini: false, props: props }))
        app.wm.focusNew(id)
        },

    // View & Edit Source opens the running program itself in the Declare
    // Viewer — as an embedded app in a desktop window: the AppWindow hosts
    // apps/viewer, and `program=` in its env segment names the subject (a
    // path valid in this app's transport base). The viewer self-loads that
    // program's ?segments and ?file artifacts — reader mode by default.

    openSource(a: DesktopApp) {
        this.openHosted(this.viewer, null, "program=" + a.src)
        },
    openAbout(a: DesktopApp) {
        const n = app.wm.spawn()
        this.openWin(app.wm.mintId(), "AboutWindow", a,
            ({ wx: (app.width - 280) / 2 + (n % 3) * 16, wy: 110 + (n % 3) * 14 }), null)
        },

    // a press that lands on nothing deeper (the wallpaper) also dismisses —
    // the App root is the sink of last resort

    dismissAbouts() {
        const doomed = app.wm.windows().filter((w) => app.wm.isPlain(w))
        for (const w of doomed) app.wm.closeWin(w)
        },
    newFiles() {
        this.dismissAbouts()
        // spawn positions cascade, wrapping after a handful
        const n = app.wm.spawn()
        this.openWin(app.wm.mintId(), "FilesWindow", this.files,
            ({ wx: 90 + (n % 7) * 28, wy: 46 + (n % 7) * 26 }), null)
        },

    // Double-clicking a folder (or File → Open on one) opens a NEW Files window
    // drilled to that folder and PINNED so the folder's own column sits at the left
    // edge (its contents lead) — but the whole tree is present, so you can scroll
    // left all the way back to the root categories.

    openFolderWindow(folderPath: string, v: View?) {
        this.dismissAbouts()
        const n = app.wm.spawn()
        const depth = ("" + folderPath).split("\n").length - 1
        this.openWin(app.wm.mintId(), "FilesWindow", this.files,
            ({ wx: 90 + (n % 7) * 28, wy: 46 + (n % 7) * 26, selPath: "" + folderPath, focusDepth: depth }), v)
        },

    // Every open verb takes `v`, the view the open came from (the double-clicked
    // row or icon): the window zooms out of it and shrinks back to it on close.
    // With no origin (a menu, the dock, ⌘O) a window zooms gently from its own
    // center. originOf resolves that center in app coords by walking the parents.

    // ⚠ SCROLL OFFSETS COUNT. A row's `y` is its position in its column's
    // CONTENT, and the column scrolls — so summing the chain without subtracting
    // each scroller's offset gives where the row would be if nothing had ever
    // been scrolled. Scroll a file list halfway down and the window then zooms
    // out of a point off past the bottom of the screen.

    originOf(v: View?) -> object {
        if (v == null) return null
        let ox = v.width / 2
        let oy = v.height / 2
        let n = v
        while (n != null) {
            ox += n.x || 0
            oy += n.y || 0
            const p = n.parent
            if (p != null) { ox -= p.scrollX || 0; oy -= p.scrollY || 0 }
            n = p
            }
        return ({ x: ox, y: oy })
        },

    // A first open (count 0 — or 0 again after a Quit) is a launch: the dock
    // icon bounces and the window appears mid-second-bounce, the way a
    // fast-launching app feels. Later opens are instant.

    // ONE Markdown-window opener behind both verbs: `props` is what differs —
    // a `path` to fetch, or a hydrated `inlineDoc` + `docName` handed over
    // whole. Launch gating, spawn cascade, and the origin zoom are identical.

    openMarkdown(props: object, v: View?) {
        this.gated(this.markdown, () => {
            this.dismissAbouts()
            const n = app.wm.spawn()
            const wx = 160 + (n % 7) * 28
            const wy = 36 + (n % 7) * 26
            const o = this.originOf(v)
            this.openWin(app.wm.mintId(), "ViewerWindow", this.markdown,
                ({ ...(props as object), wx: wx, wy: wy,
                    bornX: o != null ? o.x - wx : -1, bornY: o != null ? o.y - wy - app.menuBarH : -1 }), v)
            })
        },
    openViewer(p: string, nm: string, v: View?) { if (p != "") this.openMarkdown(({ path: p }), v) },

    // …and a HYDRATED document — Markdown the model already assembled (an
    // element's reference, the enums page), handed over whole instead of fetched.

    openDoc(md: string, nm: string, v: View?) { if (md != "") this.openMarkdown(({ inlineDoc: md, docName: nm }), v) },

    // a full Declare app in a window — a HOSTED application: the AppWindow's
    // island mounts `a.prog` ("../../calendar/calendar" runs the real
    // calendar; the path is demos/-relative, the slot convention). `envExtra`
    // overrides the app's own env segment when the caller names a different
    // subject (View & Edit Source's "program=…"); "" takes the app's own.
    // Hosted apps count separately (running dots + Quit are per application),
    // and each launch-bounces on its first open — the shared gate.

    openHosted(a: HostedApp, v: View?, envExtra: string) {
        this.gated(a, () => {
            this.dismissAbouts()
            const n = app.wm.spawn()
            let wx = 110 + (n % 5) * 30
            let wy = 24 + (n % 5) * 22
            let ww = 880, wh = 560
            // An app may state a PLACEMENT POLICY — the calendar opens
            // smaller than a full app window and clears the dock (its height
            // caps to the room above it), centered horizontally; anything
            // without a policy keeps the base size.
            if (a.place == "clearDock") {
                wy = 28
                // clear the dock (height caps to the room above it) AND never
                // fall below the calendar's own min (480 × 420) — clamp to both.
                ww = Math.max(480, Math.min(920, app.width - 80))
                wh = Math.max(420, Math.min(600, app.height - app.menuBarH - wy - 168))   // 168 ≈ dock footprint + gap
                wx = Math.round((app.width - ww) / 2)
                }
            const o = this.originOf(v)
            this.openWin(app.wm.mintId(), "AppWindow", a,
                ({ appPath: "" + a.prog, appTitle: "" + a.title, wx: wx, wy: wy,
                    width: ww, height: wh,
                    extraEnv: envExtra != "" ? envExtra : "" + a.env,
                    bornX: o != null ? o.x - wx : -1, bornY: o != null ? o.y - wy - app.menuBarH : -1 }), v)
            })
        },

    // ── Jots: the built-in application — its notes are JotWindows in
    // this very program, no island involved. The welcome note pre-opens at boot
    // (so Jots starts running, its dot lit, with no bounce — it was already
    // up when you arrived); later launches bounce like any app's.

    welcomeNote: string = """
**Hello!** This is a working desktop — windows, menus, a dock — running entirely in your browser.

It's built with **Declare**, a new language for user interfaces. A Declare program doesn't script behavior; it states what the interface *is* — this note's yellow, that window's shadow — and the runtime keeps every relationship true while you interact.

**Try things.** Drag the windows. Open apps from the dock. Minimize something. Browse the language's documentation in the Documentation window.

**Curious how it's made?** Press the `[ ]` icon in the dock to read this desktop's own source.

**Never, ever, press the 'r' or 's' keys.**
""",
    newJot(txt: string, v: View?) {
        this.gated(this.jots, () => {
            this.dismissAbouts()
            const n = app.wm.spawn()
            this.openWin(app.wm.mintId(), "JotWindow", this.jots,
                ({ note: "" + (txt || "*A new note.*"),
                    wx: 480 + (n % 5) * 26, wy: 90 + (n % 5) * 24 }), null)
            })
        },
    openWelcome() {
        this.jots.running = true
        // no spawn(): the welcome is furniture and takes no stagger step —
        // identity (mintId) and position (spawn) are separate counters
        this.openWin(app.wm.mintId(), "JotWindow", this.jots,
            ({ note: this.welcomeNote,
                width: 400, height: 385, wx: Math.max(440, app.width - 490), wy: 120 }), null)
        }
    ]


/*
## App — the desktop root

The root is COMPOSITION now, and reads as one: three faceless nodes carry the
model — `wm` (the windows AS DATA: records whose order is the stacking), the
`launcher` (the applications, and the moment before a window exists), `clock`
(today, as a fact) — and five stacked views carry the chrome: wallpaper,
windows layer, menu bar, dock, alert, in paint order. Each view owns its own state and geometry;
the nodes never reach into them. What stays flat here has a reason to be
root-wide: the theme, the appearance choice, the window eggs (tilt/zoom — read
by every Window), `drawPill` (the one label-pill silhouette the dock and the
parked tiles share; an app's ICON art lives on its application class), and
`command`, the one dispatch seam the menu bar, the dock, and the keyboard all
route through.

It tracks the browser window with no size floor (a floor would make the page
scroll, and a desktop never scrolls), and the root clips, so a window hanging
past an edge is cropped where it lies rather than moved. Everything anchored
to an edge — the menu bar's width, the clock's right edge, the dock's seat at
the bottom — re-derives from app.width / app.height on every host resize.
*/

App [ appName = "Declare Desktop", scrolls = none,   // a fixed stage: overflow (wallpaper bleed, a window past the fold) is out of frame, never scroll range

    // the faceless core: the window model lives OFF the chrome (see the
    // WinManager header above) — every fact the desktop's views bind is app.wm.*

    wm: WinManager [ ],
    clock: Clock [ ],
    launcher: Launcher [ ],
    minWidth = 800, minHeight = 600,                 // the floors: in a smaller viewport the browser pans (and pinches) the held frame natively — frame-driven, not a scroll anyone declares
    theme = { Themes.cupertino(app.darkMode) },
    fontFamily = "system-ui, sans-serif",

    // a dark solid beneath the drawn wallpaper (the `wallpaper` view covers it;
    // this only shows before first paint / outside its bounds)

    fill = 0x0A0612,

    // Window-activation policy: a click on a background window only brings it
    // forward; the app inside hears nothing until the window is front. Flip to
    // false for click-through (the first click both activates and lands in the
    // content).

    firstClickActivatesOnly: boolean = true,

    // ── shared desktop geometry: named once, read by every constraint below ──

    menuBarH: number = 32,                       // the menu bar's height; windows live below it

    // The tilt easter egg's seed (see Window.tilts): 0 = a level desktop
    // (boot state — the egg is dormant until pressed). `r` bumps it and every
    // window springs to a fresh random lean; `R` zeroes it and they all
    // spring level.

    tiltSeed: number = 0,
    scaleSeed: number = 0,                       // the zoom egg's seed; `s` re-rolls, `S` resets

    /*
    ### The dock's magnification swell

    The swell has two jobs, and each gets its own smoothing so the motion is
    FRAME-paced, not pointer-EVENT-paced (browsers coalesce pointer events and
    deliver them irregularly — a magnification read straight off `pointerX`
    stutters, holding for several frames and then jumping):

      • dockX — a spring that chases the raw pointer. Everything the swell
        touches reads dockX, so it re-derives every frame the spring ticks (the
        shared clock delivers those smoothly), gliding between the sparse
        pointer events. Its slight trail is the settle you feel.
      • hot — the enter/exit envelope (on the dock view): 0 when the pointer is
        away from the dock band, 1 while over it. It scales the whole swell, so
        entering and leaving glide instead of snapping.

    `dockMag` is the shape: distance-from-an-icon → magnification. The hovered
    icon reaches about 1.55× and the swell falls off over four icon-pitches as a
    pointed peak (a steep first step), set by the knots below. Distance is to
    the RESTING center (cx0), never the magnified layout, so the swell can't
    feed back on itself.
    */

    // The label pill's silhouette — ONE path: a stadium body (fully-rounded
    // left/right ends, r = half the body height, so the caps are true
    // semicircles, not rounded-rectangle corners) plus a small fixed triangle
    // tail at bottom-center. Filled translucent and stroked as a single outline,
    // so the border wraps the tail with no seam. The body is ~22px, the tail
    // ~7px on a ~16px base, and the fill is ~0.88 so the wallpaper shows through.
    // The tail is fixed — it doesn't grow with the name.

    drawPill(d: Draw, w: number, bh: number, dark: boolean) {
        const r = bh / 2                     // stadium: fully-rounded ends (semicircle caps)
        const th = 7                         // FIXED triangle height — does NOT scale with the name
        const hb = 8                         // FIXED triangle half-base (narrow)
        const cx = w / 2
        d.beginPath()
        d.moveTo(r, 0)
        d.lineTo(w - r, 0)                                       // top edge
        d.arc(w - r, r, r, -Math.PI / 2, Math.PI / 2, false)    // right cap (semicircle)
        d.lineTo(cx + hb, bh)                                    // bottom edge → triangle base
        d.lineTo(cx, bh + th)                                    // down to the tip
        d.lineTo(cx - hb, bh)                                    // back up
        d.lineTo(r, bh)                                          // bottom edge
        d.arc(r, r, r, Math.PI / 2, Math.PI * 1.5, false)       // left cap (semicircle)
        d.closePath()
        d.fillStyle = dark ? "rgba(46,46,51,0.9)" : "rgba(242,242,246,0.88)"
        d.fill()
        d.strokeStyle = dark ? "rgba(0,0,0,0.35)" : "rgba(196,196,204,0.85)"
        d.lineWidth = 1
        d.stroke()
        },

    // ── the command seam: the menu bar, the dock, and keys all route here ──

    command(id: string) {
        // New and Open route through the ACTIVE APPLICATION's own verb — the
        // one specific case is a Files window's Open-on-selection. (activeApp
        // reads as nullable, but appOf's files-fallback means it never is.)
        const cur = app.wm.activeApp!
        if (id == "new") cur.launch(null)
        else if (id == "open") {
            if (cur == app.launcher.files && app.wm.frontWin != null) (app.wm.frontWin as FilesWindow).openSelection()
            else cur.launch(null)
            }
        else if (id == "close") { if (app.wm.frontWin != null) app.wm.closeWin(app.wm.frontWin) }
        else if (id == "dark") { app.darkChoice = !app.darkMode; app.darkLocked = true }
        else if (id == "about-desktop") app.launcher.openAbout(app.launcher.desk)
        else if (id == "about-app") app.launcher.openAbout(cur)
        else if (id == "source-desktop") app.launcher.openSource(app.launcher.desk)
        else if (id == "home") app.navigate("apps/homepage/homepage.declare")   // distro-root-relative → works on dev server AND static host
        else if (id == "source") app.launcher.openSource(cur)
        else if (id == "quit") app.wm.quitApp(cur)
        else if (id.indexOf("win:") == 0) app.wm.focusWin(app.wm.windows()[+id.slice(4)])
        },

    dockDismiss() { app.bar.dismissMenus() },

    onPointerDown() { app.launcher.dismissAbouts() },

    // Appearance follows the OS color scheme (app.dark) by default; the menu's
    // Dark / Light item locks the choice to the user's pick from that point on,
    // so later system flips no longer move it.

    darkLocked: boolean = false,
    darkChoice: boolean = false,
    darkMode: boolean = { this.darkLocked ? this.darkChoice : app.dark },

    // ── The documentation model: one fetch of the docs app's own spine. The
    // Files browser's Guide and Reference folders, and the synthesized reference
    // pages, all derive from it.

    docsModel: DataSource [ url = "../../docs/declare-model.json" ],

    // 15s ticks catch the minute flip well within a minute-precision display

    // The boot windows open at onReady — the first settle's close, tree
    // standing and geometry LIVE (the welcome's position derives from
    // app.width, which onInit cannot yet see; this retired a setTimeout(0)
    // workaround). Order is deliberate: the note opens first, then the Files
    // window on top of it, so you arrive with Files frontmost and the
    // greeting resting behind.

    onInit() { this.docsModel.fetch() },
    onReady() { app.launcher.openWelcome(); app.launcher.newFiles() },

    keys: Keys [
        onKeyDown(e: KeyEvent) {
            if (e.key == "`" && !e.meta && !e.repeat) { app.wallpaper.seed = app.wallpaper.seed + 1; return }   // cycle the wallpaper (selection/debug)
            if (e.key == "r" && !e.meta && !e.repeat) { app.tiltSeed = app.tiltSeed + 1; return }   // the tilt egg: every window springs to a random lean
            if (e.key == "R" && !e.meta && !e.repeat) { app.tiltSeed = 0; return }                  // …and level again
            if (e.key == "s" && !e.meta && !e.repeat) { app.scaleSeed = app.scaleSeed + 1; return } // the zoom egg: every window springs to a random scale
            if (e.key == "S" && !e.meta && !e.repeat) { app.scaleSeed = 0; return }                 // …and true-size again
            if (!e.meta || e.repeat || e.key == "Meta") return
            if (app.bar.mb.shown) return             // an open menu owns the keyboard
            const combo = "⌘" + (e.key.length == 1 ? e.key.toUpperCase() : e.key)
            const hit = (app.bar.keyRegistry || []).find((r) => r.key == combo && r.enabled != false)
            if (hit != null) app.command("" + hit.id)
            }
        ],

    /*
    ### The wallpaper — a generative mesh field, drawn

    A hue-tinted dark ground with five saturated color poles, biased to the edges
    and melted together with a big blur() under a `lighten` blend — a bold,
    cohesive gradient field. It is a PURE FUNCTION of `this.seed`: a seeded
    PRNG picks the palette (a per-seed color scheme keeps hues cohesive rather
    than muddy) and the pole layout, so pressing ` (backtick) bumps the seed and
    rotates through the generated space. It has no handler, so a desktop press
    still dismisses an About box. Only draw()-subset primitives are used: radial
    gradients, filter blur(), and globalCompositeOperation — no images.

    **Drawn once, then paint-scaled.** The mesh is recorded in a FIXED reference
    box (refW × refH constants), so its display list never changes with the
    window — only `this.seed` rebuilds it. On resize the view is cover-scaled
    to fill (uniform, aspect preserved: the tighter axis fits, the other overflows
    and clips) and re-centered, all with paint-only transforms, so the field never
    re-rasters on resize. This matters because WebKit's 2D canvas is deferred —
    draw() only records, and the raster flushes lazily — so re-recording this
    field every resize frame (five full-screen radial fills plus a blur) runs
    ~24ms per flush in Safari (~42fps), stalling the whole compositor so the dock
    trails the window; a cached raster plus a CSS scale is ~17ms (~60fps).
    (Chrome's GPU raster is eager — ~8ms either way — which is why the lag never
    showed there.) It's the same trick the dock icons use: draw once, then scale
    with a paint-only transform. 1920×1200 covers a common maximized window at
    scale ≤ 1 (crisp) and upscales gently past it (a blurred field hides the
    softness).
    */

    wallpaper: View [
        seed: number = 7,                        // the generative seed; ` (backtick) cycles it
        refW: number = 1920,
        refH: number = 1200,
        width = { this.refW }, height = { this.refH },
        x = { (app.width - this.refW) / 2 }, y = { (app.height - this.refH) / 2 },
        pivotX = { this.refW / 2 }, pivotY = { this.refH / 2 },
        scale = { Math.max(app.width / this.refW, app.height / this.refH) },
        draw(d: Draw) {
            const W = this.width
            const H = this.height
            const hsl = (h, s, l) => "hsl(" + (((h % 360) + 360) % 360) + "," + s + "%," + l + "%)"
            // seeded PRNG (mulberry32) — deterministic per this.seed
            let a = (this.seed >>> 0) || 1
            const rnd = () => {
                a = (a + 1831565813) | 0                          // mulberry32's increment, in decimal (an 8-digit 0x here would read as a color)
                let t = Math.imul(a ^ (a >>> 15), 1 | a)
                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296
                }
            const hue0 = rnd() * 360
            // a COHESIVE color scheme per seed, so complementaries don't meet
            // and mud out; hue0 and the scheme swing strongly seed to seed
            const scheme = Math.floor(rnd() * 3)                 // 0 analogous · 1 triad · 2 split-complementary
            const hueFor = () => {
                if (scheme == 0) return hue0 + (rnd() - 0.5) * 100
                if (scheme == 1) return hue0 + [0, 120, 240][Math.floor(rnd() * 3)] + (rnd() - 0.5) * 26
                return rnd() < 0.72 ? hue0 + (rnd() - 0.5) * 74 : hue0 + 180 + (rnd() - 0.5) * 40
                }
            // dark, hue-tinted ground
            d.fillStyle = hsl(hue0, 52, 5)
            d.fillRect(0, 0, W, H)
            // five poles biased to the edges and corners, so the center never piles to white
            const spots = [[0.17, 0.24], [0.82, 0.2], [0.5, 0.54], [0.2, 0.82], [0.83, 0.8]]
            const blurPx = Math.round(Math.max(W, H) * 0.05)
            d.save()
            d.filter = "blur(" + blurPx + "px)"
            d.globalCompositeOperation = "lighten"                // per-channel max keeps overlaps saturated, not gray
            for (const s of spots) {
                const px = (s[0] + (rnd() - 0.5) * 0.18) * W
                const py = (s[1] + (rnd() - 0.5) * 0.18) * H
                const r = (0.36 + rnd() * 0.26) * Math.max(W, H)
                const h = hueFor()
                const sat = 70 + rnd() * 22
                const li = 44 + rnd() * 12
                const g = d.createRadialGradient(px, py, 0, px, py, r)
                g.addColorStop(0, hsl(h, sat, li))
                g.addColorStop(0.5, hsl(h, sat, li * 0.62))
                g.addColorStop(1, "rgba(0,0,0,0)")
                d.fillStyle = g
                d.fillRect(0, 0, W, H)
                }
            d.restore()
            // strong vignette — contrast, framing, and a darker center-out that
            // keeps the field from washing out
            const v = d.createRadialGradient(W / 2, H * 0.45, H * 0.1, W / 2, H * 0.5, W * 0.72)
            v.addColorStop(0, "rgba(0,0,0,0)")
            v.addColorStop(1, "rgba(0,0,6,0.62)")
            d.fillStyle = v
            d.fillRect(0, 0, W, H)
            // a faint top scrim so the (background-less) menu bar's light text
            // stays legible over any palette
            const top = d.createLinearGradient(0, 0, 0, 48)
            top.addColorStop(0, "rgba(0,0,0,0.30)")
            top.addColorStop(1, "rgba(0,0,0,0)")
            d.fillStyle = top
            d.fillRect(0, 0, W, 48)
            }
        ],

    // ── the windows layer: WINDOWS AS DATA — the WM's records replicate into
    // slots (each WinSlot creates its record's class); record order is paint
    // order, so a raise is a data move and the minimized band is the tail ──

    wins: View [ x = 0, y = { app.menuBarH }, width = { app.width }, height = { app.height - app.menuBarH },
        datapath = { app.wm.list.value },
        WinSlot [ datapath = :wins[], key = :id ]
        ],

    // No background: the menu bar's words render straight on the wallpaper.
    // `ink` turns the titles light, and the wallpaper's top scrim keeps them
    // legible over any palette.

    bar: View [ x = 0, y = 0, width = { app.width }, height = { app.menuBarH },
        menuInk: Color = 0xF2F2F5,

        /*
        ### The menu bar — whole menus as records, contextual

        The `menus` array re-derives from the active application (and, for the
        Window menu, live off the window slots and app.wm.frontWin), so the bar
        follows focus live, even while a menu is open. Keyboard shortcuts
        dispatch from these same records.
        */

        menus: array = { [
            ({ id: "brand", label: "Declare", kind: "BrandMark", items: [
                ({ id: "about-desktop", label: "About Declare Desktop", icon: "BracketIcon" }),
                ({ divider: true }),
                ({ id: "dark", label: app.darkMode ? "Light Mode" : "Dark Mode", key: "⌘K", icon: "AutoIcon" }),
                ({ divider: true }),
                ({ id: "source-desktop", label: "View & Edit Source", icon: "CodeIcon" }),
                ({ id: "home", label: "Declare Home" }),
            ] }),
            ({ id: "app", label: app.wm.activeApp!.title, bold: true,
                items: this.appMenuItems(app.wm.activeApp!) }),
            ({ id: "file", label: "File", items: [
                ({ id: "new", label: "New", key: "⌘N" }),
                ({ id: "open", label: "Open…", key: "⌘O", enabled: app.wm.activeApp!.canOpen }),
                ({ divider: true }),
                ({ id: "close", label: "Close Window", key: "⌘W", enabled: app.wm.frontWin != null }),
            ] }),

            // the standard Edit suite — present and keyed, honestly disabled:
            // nothing on this desktop edits yet

            ({ id: "edit", label: "Edit", items: [
                ({ id: "undo", label: "Undo", key: "⌘Z", enabled: false }),
                ({ id: "redo", label: "Redo", key: "⇧⌘Z", enabled: false }),
                ({ divider: true }),
                ({ id: "cut", label: "Cut", key: "⌘X", enabled: false }),
                ({ id: "copy", label: "Copy", key: "⌘C", enabled: false }),
                ({ id: "paste", label: "Paste", key: "⌘V", enabled: false }),
                ({ divider: true }),
                ({ id: "selall", label: "Select All", key: "⌘A", enabled: false }),
            ] }),
            ({ id: "window", label: "Window", items: this.windowItems() }),
            ({ id: "help", label: "Help", items: [
                ({ id: "hsearch", kind: "HelpSearch" }),
                ({ id: "help-app", label: app.wm.activeApp!.title + " Help", icon: "LightbulbIcon" }),
            ] }),
        ] },

        // The application menu: About, View & Edit Source, and — except for Files,
        // which is always running — Quit.

        appMenuItems(a: DesktopApp) -> array {
            const nm = a.title
            const out = []
            out.push(({ id: "about-app", label: "About " + nm }))
            out.push(({ divider: true }))
            out.push(({ id: "source", label: "View & Edit Source" }))
            if (!a.alwaysRunning) {
                out.push(({ divider: true }))
                out.push(({ id: "quit", label: "Quit " + nm, key: "⌘Q" }))
                }
            return out
            },

        // the Window menu is live state as records: the active application's
        // open windows, front one checked — derived straight off the slots'
        // windows and the front slot (the hand-bumped `winSeq`/deps-as-
        // arguments idiom this replaced is retired: the reads are live)

        windowItems() -> array {
            const a = app.wm.activeApp!
            const front = app.wm.frontWin
            const ws = app.wm.windows()
            const out = []
            for (let i = 0; i < ws.length; i++) {
                if (app.wm.isPlain(ws[i]) || app.wm.appOf(ws[i]) != a) continue
                out.push(({ id: "win:" + i, label: app.wm.titleOf(ws[i]) || a.title, checked: ws[i] == front }))
                }
            if (out.length == 0) out.push(({ id: "nowin", label: "No Windows", enabled: false }))
            return out
            },

        // ── ⌘-shortcuts dispatch from the menus' own records: one registry, derived
        // from whatever the contextual bar currently shows, so the active
        // application's keys are automatically the live set — nothing is declared
        // twice.

        keyRegistry: array = { (app.bar.menus || [])
            .flatMap((m) => (m.items || []).filter((r) => r.key).map((r) => ({ menu: "" + m.label, ...r }))) },

        // the menu chain's OWNER offers the dismiss: outsiders (the dock, the
        // App's command seam) ask the bar, never its internals

        dismissMenus() { this.mb.menu.rootClose() },

        mb: MenuBar [ x = 10, height = { parent.height }, menus = { app.bar.menus }, ink = { parent.menuInk },
            picked(id: string) { app.command(id) }
            ],
        clock: Text [ x = { parent.width - this.width - 14 }, y = center, fontSize = 13,
            fontWeight = medium,                 // 400 reads thin under browser antialiasing; medium holds up
            textColor = { parent.menuInk }, text = { app.clock.text } ]
        ],

    /*
    ### The dock

    A translucent plate holding the icon row, the minimized-window tiles, and the
    magnification swell (see "The dock's magnification swell" above). Its width is
    the plate's, and it stays centered at the bottom of the screen.
    */

    dock: View [ height = 150,

        // the launch bounce, asked of the DOCK (the launcher names an app;
        // which view that is — a replicated icon found by record key — is
        // this chrome's own business, not a node's)
        // the param tier keeps the receiver analyzable (startPark's pattern)

        pokeIcon(icon: DockIcon) { icon.poke() },
        poke(a: DesktopApp) {
            // typed at the seam, like wins.children: every row child is a
            // DockIcon by construction
            for (const c of this.row.children) if ((c as DockIcon).appId == a.id) this.pokeIcon(c as DockIcon)
            },

        // ── the dock's own geometry: the constants, the smoothed pointer, the
        // wave, and the parked-strip layout — everything that knows what a
        // pixel is lives HERE now; the WM hands over raw window facts and the
        // dock derives the rest (tiles → miniGoal → the sprung span). The
        // springs kept their structure, constants, and targets in the move.

        iconEdge: number = 56,                   // a dock icon's resting edge
        badgeEdge: number = 20,                  // a minimized window's app badge, at rest
        thumbEdge: number = 64,                  // a minimized thumbnail's longer edge — bigger than an icon, and centered

        dockX: number = 0,

        // In-dock tracking: the swell sits under the cursor with about a frame
        // of lag and settles in ~110ms, critically damped (no tail).

        dockXSpring: Spring [ attribute = dockX, to = { app.pointerX }, stiffness = 1300, damping = 62, epsilon = 0.5 ],

        dockMag(dist: number) -> number {
            const pitch = this.iconEdge + 16
            const a = Math.abs(dist)
            const xs = [0, pitch, 2 * pitch, 3 * pitch, 4 * pitch]
            // A pointed peak, not a dome: the hovered icon reaches 1.55× and the
            // drop-off is steepest on the first step.
            // peak · ±1 · ±2 · ±3 · ±4 = 1.55 · 1.35 · 1.18 · 1.06 · 1.0.
            const ys = [1.55, 1.35, 1.18, 1.06, 1]
            if (a >= xs[4]) return 1
            for (let i = 0; i < 4; i++) {
                if (a <= xs[i + 1]) return ys[i] + (ys[i + 1] - ys[i]) * (a - xs[i]) / (xs[i + 1] - xs[i])
                }
            return 1
            },

        // the parked strip, fitted: raw window facts (the WM's parked records)
        // → tile pixel sizes — the thumbnail's longer edge matches an icon's
        // edge, so it is never wider or taller than one

        tiles: array = { (app.wm.minis() || []).map((r, i) => {
            const fit = this.thumbEdge / Math.max(r.winW, r.winH)
            return ({ ix: i, label: r.label, w: Math.round(r.winW * fit), h: Math.round(r.winH * fit) })
            }) },

        // the strip's resting width: the divider zone (34 = 16px left margin +
        // line + 18px right) plus the slots and their 8px gaps; the trailing
        // gap is already counted, so: total + 34 − 8

        miniGoal: number = { this.tiles.length > 0 ? this.tiles.reduce((t, r) => t + r.w + 8, 0) + 26 : 0 },

        miniSpan: number = 0,
        spanSpring: Spring [ attribute = miniSpan, to = { app.dock.miniGoal }, stiffness = 380, damping = 34, epsilon = 0.5 ],

        // ── the mini layout: one computation both the parked windows and their
        // hit tiles read (deps arrive as arguments, so the constraint visibly
        // tracks them — the windowItems pattern). Left-anchored accumulation,
        // exactly like the icon row's layout: a magnified thumbnail pushes its
        // neighbors right and never crosses the divider on its left. The wave's
        // falloff runs over resting centers (the icons' anti-feedback rule).

        miniLayout: array = { this.computeMiniLayout(this.tiles, this.dockX, this.hot,
            this.x, this.row.width, this.miniSpan, app.width) },

        // iconRow = the resting icon row (from the roster); 10 = the plate's side
        // skirts (5 each); 5 = the row's inset in the plate; 17 = the divider
        // zone (8 + line + 8). The wave itself is dockMag — one curve, read
        // here for the tiles and by each DockIcon for the icons.

        computeMiniLayout(recs: array, px: number, hot: number, dockLeftX: number, rowW: number, span: number, appW: number) -> array {
            const rs = recs || []
            const n = app.launcher.roster.length
            const iconRow = n * this.iconEdge + (n - 1) * 16   // the resting icon row, derived from the roster (was hard-coded at nine icons — one short)
            // 32 = the plate's two 16px side skirts; 16 = the row's inset in the
            // plate; 34 = the divider zone (16px left margin + line + 18px right
            // margin) — the first thumbnail starts 34px past the last icon's edge
            const restDockX = (appW - (iconRow + 32 + span)) / 2
            let rx = restDockX + 16 + iconRow + 34      // first slot's resting left
            let lx = dockLeftX + 16 + rowW + 34         // …and its live left
            const out = []
            for (const r of rs) {
                const cx0 = rx + r.w / 2
                // the same wave the icons ride (dockMag), so tiles magnify in step
                const m = 1 + (this.dockMag(px - cx0) - 1) * hot
                const w = r.w * m
                out.push(({ x: lx, w: w, rw: r.w, h: (r.h || r.w) * m, cx: lx + w / 2 }))
                lx += w + 8
                rx += r.w + 8
                }
            return out
            },

        // the wave's extra width beyond rest — the plate stretches for it, so a
        // magnified thumbnail never hangs past the dock's right edge

        miniMagX: number = { this.magOf(this.miniLayout, this.tiles) },
        magOf(lay: array, recs: array) -> number {
            if (lay == null || recs == null || lay.length == 0) return 0
            let d = 0
            for (let i = 0; i < lay.length; i++) d += lay[i].w - recs[i].w
            return Math.max(0, d)
            },

        width = { this.plate.width },
        x = { (app.width - this.width) / 2 },
        y = { app.height - 155.5 },           // the 88px plate sits 5.5px off the bottom edge

        // The enter/exit envelope the icons scale by, sprung fast (~100ms), so
        // entry reads as one quick motion; inside the strip the icons track the
        // pointer directly. The band has hysteresis: it arms a fixed distance
        // above the bottom edge but, while hot, holds higher — past a magnified
        // icon's crest — so hovering the top of a grown icon doesn't fall out of
        // the band and collapse the dock under the pointer.
        //
        // `hovering` gates the whole band: when the pointer leaves the browser
        // window it clears, so the dock cools instead of staying magnified at
        // the pointer's last known column.

        armBand: number = 100,                   // the hover band arms this far above the bottom edge (~plate top at 93.5)…
        holdBand: number = 132,                  // …and holds to here while hot (past a magnified icon's crest ~104)
        hot: number = 0,

        // hotGate is the INSTANT band result (0/1). The app icons read it as
        // their wave gate, so their own per-icon mag springs do all the enter/
        // leave smoothing (no double-spring). `hot` is the SPRUNG version — the
        // mini section (a shared pointer-spring layout) still eases through it.

        hotGate: number = { app.hovering && app.pointerY > app.height - (this.hot > 0.5 ? this.holdBand : this.armBand) ? 1 : 0 },

        heat: Spring [ attribute = hot, to = { parent.hotGate }, stiffness = 3600, damping = 120, epsilon = 0.002 ],

        // at rest the icons sit clearly inside the plate; a magnified icon
        // crests above its top — bottom-anchored, top rises. The row must be
        // dock-height: the icons' bottom anchor reads parent.height, and a
        // shorter row would float them above the plate at rest.

        plate: View [ x = 0, y = { parent.height - 88 }, height = 88, width = { parent.row.width + 32 + app.dock.miniSpan + app.dock.miniMagX },
            cornerRadius = 27, fill = { app.darkMode ? 0x2A2A30 : 0xFCFCFE }, opacity = 0.4 ],

        // The plate's edge rim, DRAWN at full strength (the plate is translucent,
        // so the rim rides a sibling above it, not inside its opacity). A top-lit
        // inner highlight: a vertical white gradient stroke, brightest along the
        // TOP edge and fading down the sides to nothing at the floor — a "lit
        // from above" bevel. A faint outer hairline sets the plate off from the
        // wallpaper.

        plateRim: View [ x = 0, y = { parent.height - 88 }, height = 88, width = { parent.plate.width },
            draw(d: Draw) {
                const w = this.width
                const h = this.height
                const r = 27
                d.strokeStyle = app.darkMode ? "rgba(0,0,0,0.34)" : "rgba(112,124,148,0.22)"
                d.lineWidth = 1
                d.beginPath()
                d.roundRect(0.5, 0.5, w - 1, h - 1, r - 0.5)
                d.stroke()
                const g = d.createLinearGradient(0, 0, 0, h)
                g.addColorStop(0, app.darkMode ? "rgba(255,255,255,0.30)" : "rgba(255,255,255,0.62)")
                g.addColorStop(0.42, app.darkMode ? "rgba(255,255,255,0.05)" : "rgba(255,255,255,0.13)")
                g.addColorStop(1, "rgba(255,255,255,0)")
                d.strokeStyle = g
                d.lineWidth = 1.5
                d.beginPath()
                d.roundRect(1.4, 1.4, w - 2.8, h - 2.8, r - 1.4)
                d.stroke()
                }
            ],
        row: View [ x = 16, y = 0, height = { parent.height },
            datapath = { app.launcher.data.value },
            layout: SimpleLayout [ axis = x, spacing = 16 ],

            // a running app's icon raises its open windows instead of opening
            // more — dockOpen: raise if any, else the app's OWN open verb
            // (the launch gate decides bounce vs instant). ONE icon,
            // replicated over the WHOLE roster — launchables, Files (always
            // running), and the four inert quips alike. The data carries only
            // id + order; the icon resolves its application instance and
            // reads everything — face, hues, dot, pill, click — off it.

            DockIcon [ datapath = :apps[], key = :id,
                hotGate = { app.dock.hotGate },
                ix = { Number(:ix ?? 0) },
                appId = { "" + (:id ?? "") },
                running = { :running == true },
                onClick() { const a = this.ap(); if (a != null) app.wm.dockOpen(a, () => a.launch(this)) }
                ]
            ],

        // ── The minimized-window section: a vertical divider, then a hit tile
        // per minimized window — the visuals are the parked windows themselves,
        // riding the same swell. The section exists only while the sprung span
        // is open, and the divider fades in with the widening, so growth reads as
        // one motion with no seam.

        minis: View [ visible = { app.dock.miniSpan > 0.5 },
            x = { parent.row.x + parent.row.width + 16 }, y = 0, height = { parent.height },
            div: View [ x = 0, y = { parent.height - 77 }, width = 1, height = 65,
                opacity = { Math.min(1, app.dock.miniSpan / 26) },
                fill = { app.darkMode ? 0xFFFFFF48 : 0x00000042 } ],

            // one tile per parked RECORD (wm.miniData), keyed by window id —
            // add a park and a tile exists, close it from anywhere and it goes

            rowM: View [ x = 0, y = 0, height = { parent.height },
                datapath = { app.wm.miniData.value },
                MiniTile [ datapath = :minis[], key = :id ]
                ]
            ]
        ],

    // ── The "Not implemented" alert: a translucent app-modal sheet — the scrim
    // swallows every press — sitting frontmost over all the chrome. Its icon
    // is the subject app's own (AppGlyph — the dock's renderer), badged with a
    // caution triangle.

    alert: View [
        // its own single slot of state: an inert app assigns ITSELF here
        // (InertApp.open), dismiss clears it, null = no alert — the state
        // lives where the pixels are, and everything below (icon, headline,
        // message) derives from the one subject

        subject: DesktopApp = null,
        dismiss() { this.subject = null },
        visible = { this.subject != null },
        x = 0, y = 0, width = { app.width }, height = { app.height },
        onPointerDown() { },                           // modal: presses on the scrim do nothing

        scrim: View [ x = 0, y = 0, width = { parent.width }, height = { parent.height }, fill = #00000026 ],

        panel: View [ width = 300, height = 422,
            // The panel sits slightly above center — the top gap is about a
            // third of the empty vertical space, never dead-center.

            x = center, y = { (parent.height - this.height) / 3 },
            cornerRadius = 20,
            fill = { theme.menuMaterial != null ? theme.menuMaterial : theme.surface },
            stroke = stroke(1, #FFFFFF80),
            shadow = shadow(0, 16, 50, #00000059),

            icon: AppGlyph [ x = 118, y = 26, edge = 64, appId = { app.alert.subject != null ? app.alert.subject.id : "" } ],
            badge: CautionBadge [ x = 162, y = 70, edge = 30 ],

            title: Text [ x = center, y = 112, fontSize = 15, fontWeight = semibold,
                textColor = { theme.text }, text = { app.alert.subject != null ? app.alert.subject.quip : "" } ],
            msg: Text [ x = 20, y = 136, width = 260, wrap = true, textAlign = center,
                fontSize = 12, textColor = { theme.textMuted },
                text = { "Declare Desktop doesn't include " + (app.alert.subject != null ? app.alert.subject.title : "") + "." } ],

            // The payoff — a rounded image with a thin hairline, so it reads as
            // deliberate rather than a stray asset.

            rick: Image [ source = "rick.jpeg", x = 22, y = 184, width = 256, height = 160,
                stretches = both, cornerRadius = 10, clip = true,
                stroke = { stroke(1, app.darkMode ? 0xFFFFFF2E : 0x0000002E) } ],

            ok: Button [ x = 16, y = { parent.height - 46 }, width = { parent.width - 32 },
                label = "OK", primary = true,
                onClick() { app.alert.dismiss() }
                ]
            ]
        ]
    ]
