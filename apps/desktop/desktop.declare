class MusicApp extends InertApp [ id = "music", label = "Music", title = "Music",
    quip = "Nah.", glyph = "♪", gsize = 0.52, hue1 = #FB5C74, hue2 = #FA233B
    ]


class TerminalApp extends InertApp [ id = "terminal", label = "Terminal", title = "Terminal",
    quip = "Not.", hue1 = #3A3A40, hue2 = #17171B, drawn = true,
    face(d: Draw) {
        d.strokeStyle = 0xFFFFFF
        d.lineWidth = 2.6
        d.lineCap = "round"
        d.beginPath()
        d.moveTo(14, 18.5); d.lineTo(20, 24); d.lineTo(14, 29.5)
        d.moveTo(24, 30); d.lineTo(32.5, 30)
        d.stroke()
        }
