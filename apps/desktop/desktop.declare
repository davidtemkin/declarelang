/*
# The Desktop

A Mac-style desktop, declared — windows, a dock, menus, and an embedded
app, the whole thing built from shapes, gradients, and constraints with
no image assets to load. It is the library's widest proof: dozens of
independent relationships — which window is front, how far the dock has
swelled, what the menu bar belongs to — all held true at once by the
runtime while you drag, resize, zoom, and click.

- **Windows** are their own layer, created at runtime by name. One
  `Window` class carries the chrome — a title bar you drag, edges and
  corners you resize (each with its resize cursor), a shadow that deepens
  when the window is front, and close / minimize / zoom controls — and
  subclasses carry the contents.
- **Files** browses this repository's own documentation, its column tree
  derived live from the docs model. **Viewer** renders any of those
  documents. **AppWindow** hosts a whole other Declare program as an
  embedded child — the dock's Calendar opens the real calendar app.
- The **dock** magnifies by layout, not paint: each icon's width is a
  constraint over its resting center, so neighbors displace and the
  plate stretches to hold them. Minimized windows park here as live
  thumbnails, riding the same swell and wearing their app's icon.
- The **menu bar** is whole menus expressed as records, and it follows
  focus — the menus belong to the front window's application, with a
  brand mark in the leading slot, a live Window menu, and a Help menu
  whose search field is a real text input. Keyboard shortcuts dispatch
  from the same records the bar is drawn from.

Every icon, control, and texture is drawn from shapes and gradients, so
the desktop carries no image payload at all — pure description. (The one
bitmap is a certain music-video still, and it earns its keep.)
*/

// The window classes below are created only at runtime, by name — a window
// RECORD carries its class as a string, and WinSlot (the replication hinge)
// creates it — never as a declared tag. Class reachability is otherwise a
// static fact (unused classes are dropped, which is what tree-shakes
// production builds), and a name inside a runtime string is invisible to that
// analysis. `use` is the explicit bridge: keep these classes registered for
// creation by name.

use [ BracketIcon, CodeIcon, AutoIcon, LightbulbIcon, FilesWindow, ViewerWindow, AppWindow, AboutWindow, JotWindow, BrandMark, HelpSearch, AppGlyph, CautionBadge ]

/*
## Window — chrome once, contents per subclass

Every window on the desktop is one of these. `Window` carries all of the
chrome — the shadow, the resize edges and corners, and the shade / zoom /
minimize behaviors — and each subclass (Files, Viewer, AppWindow, About,
Jot) supplies only its contents. Geometry the class shares is named
once (`barH`, `minW`, `gutter`, `corner`…) so no derived position below
carries a bare number.

Two motions drive most of the class. **Open and close** run `baseScale`
from the icon a window launched from up to full size and back, so it grows
out of its dock icon and shrinks into it. **Minimize** doesn't hide a
window — it parks it in the dock as a live thumbnail that rides the same
magnification swell as the icons, blended by `miniT` from a free window
(0) to a docked one (1).
*/

class Window extends View [ width = 560, height = 400, clip = true,
    fill = { theme.surface },
    stroke = { stroke(1, theme.line) },

    // The front window floats on a deeper, softer shadow; an inactive one sits
    // closer to the desktop on a lighter, tighter one.

    inkHi: Color = #0000006B,                    // front-window shadow ink
    inkLo: Color = #00000047,                    // inactive-window shadow ink

    shadow = { app.wm.frontWin == this ? shadow(0, 12, 26, this.inkHi) : shadow(0, 5, 14, this.inkLo) },

    title: string = "",
    active: boolean = { app.wm.frontWin == this },

    // named geometry — every derived position below reads these, so the
    // numbers exist in exactly one place

    barH: number = 35,                           // title-bar height; content starts below it
    minW: number = 340,                          // resize floors
    minH: number = 120,
    gutter: number = 6,                          // the resize halo's reach OUTSIDE the frame (ignoreClip)
    inset: number = 3,                           // …and INSIDE it — the resize band: ±3px on the

    //   frame line, the window winning over content (scrollbars
    //   included) in those inner px — observed live on Sequoia

    corner: number = 16,                         // corner strip size (wins over the edges)

    // a plain window (an About box) is close-to-dismiss only: no resize, no
    // shade, no zoom — the strips vanish and the yellow/green lights go inert

    plain: boolean = false,
    recId: string = "",                          // my window RECORD's id (wm.list) — the slot sets it at creation
    forApp: DesktopApp = null,                   // the application this window belongs to; the slot sets it from the record
    appPath: string = "",                        // an AppWindow's program path; "" elsewhere
    homing: boolean = false,                     // mid restore flight: leaving the dock, slot still held

    // custom-chrome windows (Jots) keep the base's behavior — drag
    // bookkeeping, activation, shade/zoom, resize strips — but drop the
    // standard title bar and grip art, and supply their own chrome on top

    chrome: boolean = true,

    // Open zoom: the window grows from the position it launched from — small at
    // the source, most of the way there within the first few frames, settled in
    // under a quarter second on a strong ease-out. bornX/bornY hold that origin
    // in window coordinates (-1 = no origin, so the window zooms gently from its
    // own center instead).

    bornX: number = -1,
    bornY: number = -1,
    bornFrom: View = null,                       // the view the open came from, for the return trip

    // ── the TILT easter egg (rotation road-tested where everyone lives) ──
    // Press `r` and every window on screen springs to a random lean between
    // −30° and 30°; `r` again re-rolls, `R` levels everything. DORMANT until
    // pressed: `app.tiltSeed` starts at 0, every angle below derives to 0,
    // and nothing here changes a level desktop's behavior by a bit. The
    // constraint reads the seed purely to subscribe (Math.random is an
    // untracked read, so the bump is what re-rolls); the Spring is slightly
    // underdamped so a window settles into its new lean with a small wobble.
    // A leaning window untilts on the way into the dock (`miniT` blends the
    // angle away) so thumbnails park straight, and pivots at its center
    // instead of the launch icon — the one behavior trade, active only while
    // actually tilted.

    tilts: boolean = true,                       // a window kind could opt out; none does
    tiltTarget: number = { app.tiltSeed > 0 && this.tilts ? Math.random() * 60 - 30 : 0 },
    tiltA: number = 0,
    tiltSpring: Spring [ attribute = tiltA, to = { classroot.tiltTarget }, stiffness = 160, damping = 14, epsilon = 0.01 ],
    rotation = { this.tiltA * (1 - this.miniT) },

    // ── the ZOOM egg — the tilt's scale twin (`s` re-rolls, `S` resets) ──
    // Same dormancy contract: zoomA rides at 1 until the seed is bumped, and
    // blends away on the way into the dock (the park scale must land exact —
    // the seat check measures it to half a pixel). Composed MULTIPLICATIVELY into
    // the park blend below, so the two journeys never fight.

    zoomTarget: number = { app.scaleSeed > 0 && this.tilts ? 0.55 + Math.random() * 0.9 : 1 },
    zoomA: number = 1,
    zoomSpring: Spring [ attribute = zoomA, to = { classroot.zoomTarget }, stiffness = 160, damping = 14, epsilon = 0.002 ],

    pivotX = { this.tiltA != 0 || this.zoomA != 1 ? this.width / 2 : this.bornX >= 0 ? this.bornX : this.width / 2 },
    pivotY = { this.tiltA != 0 || this.zoomA != 1 ? this.height / 2 : this.bornY >= 0 ? this.bornY : this.height / 2 },
    born: Animator [ attribute = baseScale, from = { classroot.bornX >= 0 ? 0.15 : 0.85 }, to = 1,
        duration = 230, motion = cubicOut, started = true ],

    // ── the geometry split that makes a minimized window a dock citizen ──
    // Everything imperative (drag, spawn, the zoom animators) writes the base
    // slots wx/wy/baseScale; the real x/y/scale are constraints blending base
    // geometry toward a dock slot the window computes for itself — the same
    // wave math the icons run, over the same live inputs. So a parked window
    // magnifies, displaces, and rides the dock's widening exactly as an icon
    // does: not a placed thumbnail but a member of the wave. `miniT` (the
    // blend, animated 0↔1) is the whole minimize journey.

    wx: number = 0,
    wy: number = 0,
    baseScale: number = 1,                       // the free-window scale — the zoom animators drive this
    dockSlot: number = -1,                       // ≥0 = my slot in the dock's minimized section
    miniT: number = 0,                           // the park blend: 0 = free, 1 = docked (animated — the journey)

    // My slot comes from the shared mini layout (app.dock.miniLayout), left-anchored
    // like the icon row so a magnified thumbnail grows rightward and never
    // crosses the divider. x/w are the slot's live geometry; rw is its resting
    // width, so w/rw is my share of the magnification swell. A thumbnail keeps
    // its aspect, centers vertically in its cell, and rounds its corners at
    // thumbnail scale.

    slotW: number = { app.dock.miniLayout != null && this.dockSlot >= 0 && this.dockSlot < app.dock.miniLayout.length ? app.dock.miniLayout[this.dockSlot].w : 48 },
    slotRestW: number = { app.dock.miniLayout != null && this.dockSlot >= 0 && this.dockSlot < app.dock.miniLayout.length ? app.dock.miniLayout[this.dockSlot].rw : 48 },
    slotX: number = { app.dock.miniLayout != null && this.dockSlot >= 0 && this.dockSlot < app.dock.miniLayout.length ? app.dock.miniLayout[this.dockSlot].x : 0 },
    parkScale: number = { this.slotW / Math.max(1, this.width) },
    waveMag: number = { this.slotW / Math.max(1, this.slotRestW) },

    // A thumbnail sits centered in the dock plate (with a small margin), not
    // bottom-anchored like the icons. The plate's center is 49.5px off the
    // screen bottom (a 5.5px gap plus the 44px half-plate), and the window's
    // visual center is placed to land there.
    //
    // It scales around the badge baseline — about 14px above the plate floor,
    // screen y = app.height - 19 — rather than its own center, so on rollover it
    // grows upward, away from the floor. At rest (waveMag 1) that baseline is
    // the plate center, so a resting thumbnail is still centered.

    parkY: number = { app.height - 19 - 30.5 * this.waveMag - this.height * this.parkScale / 2 - app.menuBarH },

    baseRadius: number = 10,                     // the window's normal corner rounding (the classic treatment;

    // (taller, rounder title bars are their own design track, deferred)

    bandR: number = { Math.max(2, this.baseRadius - 1) },  // the resize band's inner-cut arc radius — the ONE

    // source ring() and zone() both read, so the hit shape and
    // the grab behavior cannot disagree at the corners

    thumbRadius: number = 3.5,                   // …and its rounding at thumbnail scale, in dock pixels
    cornerRadius = { this.baseRadius + (this.thumbRadius * this.waveMag / Math.max(0.02, this.parkScale) - this.baseRadius) * this.miniT },

    x = { this.wx + (this.slotX - this.wx) * this.miniT },
    y = { this.wy + (this.parkY - this.wy) * this.miniT },
    scale = { (this.baseScale + (this.parkScale - this.baseScale) * this.miniT) * (1 + (this.zoomA - 1) * (1 - this.miniT)) },

    // Each journey stops the other before it starts, so a restore mid-park never
    // leaves two animators racing `miniT`; and each completion handler checks
    // that it actually arrived, so an interrupted journey never commits the
    // destination's state.

    miniGo: Animator [ attribute = miniT, to = 1, duration = 260, motion = cubicIn ],
    miniBack: Animator [ attribute = miniT, to = 0, duration = 260, motion = cubicOut,
        onStop() { if (classroot.miniT <= 0.01) app.wm.unparked(classroot) }
        ],

    // Close runs the open in reverse: the window shrinks back to its return
    // spot, recomputed at close time from the origin view (which may have
    // moved), falling back to the birth snapshot if that view is gone.

    closing: boolean = false,

    beginClose() {
        if (closing) return
        closing = true
        if (bornFrom != null) {
            let ox = bornFrom.width / 2
            let oy = bornFrom.height / 2
            let n = bornFrom
            let top = null
            // same walk as app.launcher.originOf — scroll offsets included (see the note
            // there); the return trip has to land where the open came from
            while (n != null) {
                ox += n.x || 0
                oy += n.y || 0
                top = n
                const p = n.parent
                if (p != null) { ox -= p.scrollX || 0; oy -= p.scrollY || 0 }
                n = p
                }
            // the walk reaching app proves the origin view is still attached;
            // its result is app coords — shift into this window's frame
            if (top == app) { bornX = ox - this.x; bornY = oy - this.y - app.menuBarH }
            }
        this.die.start()
        },

    die: Animator [ attribute = baseScale, to = 0.15, duration = 200, motion = cubicIn,
        onStop() { app.wm.reallyClose(classroot) }
        ],

    // drag/resize bookkeeping (the captured-move pattern: root-space anchors).
    // px0/py0 are the shared POINTER anchors; each gesture then keeps its OWN
    // pool — drag anchors the window origin, size anchors the box — because
    // one shared pool once had `wx0` meaning window-x in one gesture and
    // width in the other.

    px0: number = 0,
    py0: number = 0,
    wx0: number = 0,                             // window x at drag start
    wy0: number = 0,                             // window y at drag start
    dragging: boolean = false,
    sizeMode: string = "",                       // "" | "r" | "b" | "rb"
    sizeW0: number = 0,                          // width at size start
    sizeH0: number = 0,                          // height at size start
    sizeX0: number = 0,                          // window x at size start (left-edge modes)
    sizeY0: number = 0,                          // window y at size start (top-edge modes)

    // Shade (the Jot's collapse widget) and zoom each remember what they
    // displace so they can restore it. Minimize sends the window down into the
    // dock's minimized section — the same open/close curve, aimed at its tile —
    // and back out when the tile is clicked.

    shaded: boolean = false,
    zoomed: boolean = false,
    minimized: boolean = false,
    saveH: number = 0,
    saveX: number = 0,
    saveY: number = 0,
    saveW: number = 0,

    // minimize does not hide: the window parks at its dock tile, scaled to
    // fit — a live thumbnail (an embedded app inside keeps running; its DOM
    // island never unmounts, only transforms). The tile above it is the
    // click target, so the parked window can't be poked at 8% scale.

    // activating any real window dismisses open About boxes — they're modals
    // in spirit: clicking anywhere else lets them go (the red light works too)

    activate() { app.wm.frontId = this.recId; app.wm.raiseWin(this); if (!plain) app.launcher.dismissAbouts() },

    // RAISING IS POINTER-KIND-SPLIT (ruled 2026-07-31). A mouse raises the
    // instant it touches a window — the platform rule, and the one that makes
    // press-dragging a background window raise AND move it in one gesture. A
    // finger cannot afford that: on a floored desktop a swipe that begins over
    // a window is usually a page pan, and raising at touchdown reorders the
    // desktop under the finger before the user has asked for anything. So the
    // PRESS arm is mouse-only, and a finger raises on the two gestures that
    // actually mean "this window": the click (a real tap — a wandering swipe
    // never produces one) and the hold (which is also where a touch drag
    // begins, so the pick-up raises as it lifts).

    activateOnPress() { if (app.lastPointerType == "mouse") this.activate() },

    onPointerDown() { this.activateOnPress() },
    onClick()       { this.activate() },
    onHold()        { this.activate() },

    // subclass content attaches after the base's children, so any content that
    // reaches the window's edges would eat the resize strips' events — the
    // chrome re-promotes above everything (order is a slot). Subclasses that
    // override onInit call raiseChrome() themselves.

    raiseChrome() {
        this.halo.raise()                        // above all content: the inner `inset` px of the band beat
                                                 // panes and scrollbars (the band always wins); the ring
                                                 // clip keeps the interior transparent to the pointer
        this.veil.raise()                        // topmost of all — a background window's first-click catcher
        },

    onInit() { this.raiseChrome() },

    // Shade collapses the window down to just its title bar; zoom fills the
    // desktop, leaving the dock's band clear at the bottom.

    shadeToggle() {
        if (shaded) { this.height = saveH; shaded = false }
        else { saveH = this.height; this.height = barH; shaded = true }
        },

    zoomToggle() {
        if (zoomed) { this.wx = saveX; this.wy = saveY; this.width = saveW; this.height = saveH; zoomed = false }
        else {
            saveX = this.wx; saveY = this.wy; saveW = this.width; saveH = this.height
            this.wx = 12; this.wy = 8
            this.width = app.width - 24
            this.height = app.height - 130            // 130 ≈ the dock band + margins
            zoomed = true
            }
        },

    // Title-bar dragging, shared by both chromes (the standard bar and the
    // Jot's strip): anchor on press, clamp on move — a window can never be
    // dragged beyond reach; some of it stays on the desktop on every side.

    beginDrag() {
        this.activateOnPress()   // a finger raises at the hold instead (the bar's onHold)
        dragging = true
        px0 = app.pointerX
        py0 = app.pointerY
        wx0 = this.wx
        wy0 = this.wy
        },
    dragTo() {
        if (!dragging) return
        this.wx = Math.max(-200, Math.min(app.width - 60, wx0 + app.pointerX - px0))
        this.wy = Math.max(0, Math.min(app.height - 90, wy0 + app.pointerY - py0))
        },
    endDrag(canceled: boolean) {
        // An interrupted drag (the browser took the finger for a page pan —
        // a quick swipe over the title bar on a floored, panning desktop)
        // must not leave the window displaced by the pre-take moves.
        if (canceled) { this.wx = wx0; this.wy = wy0 }
        dragging = false
        },

    beginSize(mode: string) {
        if (plain) return
        this.activate()
        sizeMode = "" + mode
        px0 = app.pointerX
        py0 = app.pointerY
        sizeW0 = this.width
        sizeH0 = this.height
        sizeX0 = this.wx
        sizeY0 = this.wy
        },

    // The grabbable set composes into "l" | "r" | "t" | "b" and the four
    // corners ("lt" | "rt" | "lb" | "rb"). A left-edge drag keeps the right
    // edge fixed, so x follows the width; a top-edge drag keeps the bottom
    // fixed, so y follows the height.

    // A vector rotated by `deg` — the one piece of trig the tilt egg needs.
    // moveSize uses it in both directions: the pointer's delta rotated INTO
    // the window's frame (−rotation), and the center's shift rotated back OUT
    // (+rotation). At 0° it returns its input, so a level window resizes on
    // exactly the old arithmetic.

    rot(x: number, y: number, deg: number) -> object {
        const a = deg * Math.PI / 180
        return ({ x: x * Math.cos(a) - y * Math.sin(a), y: x * Math.sin(a) + y * Math.cos(a) })
        },

    moveSize() {
        if (sizeMode == "") return
        // the pointer's travel, in the window's own axes (a tilted window
        // sizes along its edges, not the screen's) — and in its own UNITS: a
        // zoomed window's local pixels cover `scale` screen pixels each, so
        // the rotated delta divides by the scale (the zoom egg's twin of the
        // rotation term; at 1 it divides by nothing)
        const sc = Math.max(0.05, this.scale)
        const d0 = this.rot(app.pointerX - px0, app.pointerY - py0, -this.rotation)
        const d = ({ x: d0.x / sc, y: d0.y / sc })
        const sx = sizeMode.indexOf("r") >= 0 ? 1 : sizeMode.indexOf("l") >= 0 ? -1 : 0
        const sy = sizeMode.indexOf("b") >= 0 ? 1 : sizeMode.indexOf("t") >= 0 ? -1 : 0
        const w = sx != 0 ? Math.max(minW, sizeW0 + sx * d.x) : sizeW0
        const h = sy != 0 ? Math.max(minH, sizeH0 + sy * d.y) : sizeH0
        // plant the OPPOSITE edge: with a center pivot, growing the box moves
        // both edges, so the center shifts by half the growth toward the
        // grabbed side — half the VISIBLE growth (× scale), in window axes,
        // hence rotated back to root
        const m = this.rot(sx * (w - sizeW0) / 2 * sc, sy * (h - sizeH0) / 2 * sc, this.rotation)
        this.wx = sizeX0 + (sizeW0 - w) / 2 + m.x
        this.wy = sizeY0 + (sizeH0 - h) / 2 + m.y
        if (sy < 0 && this.rotation == 0 && this.scale == 1) this.wy = Math.max(0, this.wy)
        this.width = w
        this.height = h
        },

    lightsHover: boolean = false,

    bar: View [ width = { parent.width }, height = { classroot.barH }, visible = { classroot.chrome },

        // The active window's bar carries a subtle vertical gradient; an
        // inactive one drops to the flat background tone.

        fill = { classroot.active
                ? (app.darkMode ? gradient(0x3B3B40, 0x2E2E32) : gradient(0xFAFAFC, 0xE6E6EA))
                : theme.bg },
        onPointerDown() { classroot.beginDrag() },
        onPointerMove() { classroot.dragTo() },
        onPointerUp(e: PointerUpEvent)   { classroot.endDrag(e.canceled) },

        // the hold rider: with onHold declared, the bar claims the touch only
        // at the press-and-hold — a quick swipe over it pans a floored desktop

        onHold() { classroot.activate() },   // the hold that begins a touch drag also raises

        // The three window controls — close, minimize, zoom. Gray when the
        // window is inactive. Rollover is scoped to the controls block alone
        // (the bounding rectangle of the three circles), not the whole bar:
        // hovering it colorizes even an inactive window's controls and reveals
        // their glyphs, while the rest of the bar does nothing.
        //
        // 14px circles on a 20px pitch, so the block is 2·20 + 14 = 54 wide,
        // centered in the 35px bar.

        lights: View [ x = 13, y = 10.5, width = 54, height = 14,
            onPointerOver() { classroot.lightsHover = true },
            onPointerOut()  { classroot.lightsHover = false },
            close: TrafficLight [ x = 0, c = #EC6A5E, rim = #D25349, ink = #7B1006, sym = "close",
                on = { classroot.active || classroot.lightsHover }, showGlyph = { classroot.lightsHover },
                onPointerOver() { classroot.lightsHover = true },
                onPointerOut()  { classroot.lightsHover = false },
                onClick() { app.wm.closeWin(classroot) }
                ],
            mini: TrafficLight [ x = 20, c = #F5BF4F, rim = #D9A340, ink = #8F5B00, sym = "min",
                on = { classroot.active || classroot.lightsHover }, showGlyph = { classroot.lightsHover },
                onPointerOver() { classroot.lightsHover = true },
                onPointerOut()  { classroot.lightsHover = false },
                onClick() { if (!classroot.plain) app.wm.minimizeWin(classroot) }
                ],
            zoom: TrafficLight [ x = 40, c = #61C554, rim = #4CAF45, ink = #145E14, sym = "zoom",
                on = { classroot.active || classroot.lightsHover }, showGlyph = { classroot.lightsHover },
                onPointerOver() { classroot.lightsHover = true },
                onPointerOut()  { classroot.lightsHover = false },
                onClick() { if (!classroot.plain) classroot.zoomToggle() }
                ]
            ],

        cap: Text [ x = center, y = center, fontSize = 13, fontWeight = semibold,
            textColor = { classroot.active ? theme.text : theme.textMuted },
            text = { classroot.title } ],

        // the separator under the title bar — present active or not

        sep: View [ x = 0, y = { classroot.barH - 1 }, width = { parent.width }, height = 1, fill = { theme.line } ]
        ],

    // THE RESIZE HALO — one ignoreClip child instead of eight strips: a ring
    // OUTSIDE the frame (the window clips; the halo opts out), raised above
    // all content by raiseChrome so the band wins everywhere it exists — and
    // ONLY there: the ring clip makes the whole interior hit-transparent, so
    // a scrollbar keeps its entire lane (the conflict the old inner strips
    // could only thin, dissolved). Zones and cursors are arithmetic on the
    // pointer; a corner is the last `corner` px of a band.

    halo: View [ ignoreClip = true, visible = { !classroot.plain && !classroot.shaded },
        x = { -classroot.gutter }, y = { -classroot.gutter },
        width = { parent.width + 2 * classroot.gutter }, height = { parent.height + 2 * classroot.gutter },

        // the halo's own clip is a RING (outer rect wound one way, inner the
        // other — nonzero rule keeps the band): a Shape clip cuts hit-testing
        // with the pixels on both backends, so everything deeper than the band
        // is genuinely transparent to the pointer whatever the stacking. The
        // inner cut sits `inset` px INSIDE the frame — the ± resize band —
        // and is ROUNDED to the window's radius, so the corner void answers
        // the diagonal exactly.

        clip = { this.ring(classroot.gutter, classroot.inset, classroot.bandR, this.width, this.height) },
        ring(g: number, n: number, r: number, w: number, h: number) -> Shape {
            // outer rect clockwise, inner rounded rect COUNTER-clockwise — the
            // opposed windings are what makes nonzero fill keep only the band
            const i = g + n
            const x1 = w - i
            const y1 = h - i
            return "M0 0 H" + w + " V" + h + " H0 Z"
                 + " M" + i + " " + (i + r)
                 + " V" + (y1 - r)
                 + " A" + r + " " + r + " 0 0 0 " + (i + r) + " " + y1
                 + " H" + (x1 - r)
                 + " A" + r + " " + r + " 0 0 0 " + x1 + " " + (y1 - r)
                 + " V" + (i + r)
                 + " A" + r + " " + r + " 0 0 0 " + (x1 - r) + " " + i
                 + " H" + (i + r)
                 + " A" + r + " " + r + " 0 0 0 " + i + " " + (i + r)
                 + " Z"
            },
        zone(px: number, py: number) -> string {
            const g = classroot.gutter + classroot.inset
            const c = classroot.corner
            const w = this.width
            const h = this.height
            const inL = px < g
            const inR = px >= w - g
            const inT = py < g
            const inB = py >= h - g
            if (!inL && !inR && !inT && !inB) {
                // THE CORNER CRESCENTS. The band's inner cut is ROUNDED
                // (ring, same bandR), so at each corner the band reaches
                // past the straight-line tests above: the sliver between
                // the straight boundary and the inner arc is hittable —
                // the cursor children already show a resize cursor there —
                // and a grab must do what the cursor promises. In-ring =
                // on the corner side of the arc's center and farther than
                // bandR from it; the zone then follows the same strips the
                // cursors use (corner square → diagonal, else the edge).
                const r = classroot.bandR
                const ox = (px < w / 2 ? g + r - px : px - (w - g - r))
                const oy = (py < h / 2 ? g + r - py : py - (h - g - r))
                if (ox > 0 && oy > 0 && ox * ox + oy * oy > r * r) {
                    const chz = px < c ? "l" : px >= w - c ? "r" : ""
                    const cvz = py < c ? "t" : py >= h - c ? "b" : ""
                    return chz + cvz
                }
                return ""
            }
            let hz = inL ? "l" : inR ? "r" : (px < g + c ? "l" : px >= w - g - c ? "r" : "")
            let vz = inT ? "t" : inB ? "b" : (py < g + c ? "t" : py >= h - g - c ? "b" : "")
            if ((inL || inR) && !(py < g + c || py >= h - g - c)) vz = ""
            if ((inT || inB) && !(px < g + c || px >= w - g - c)) hz = ""
            return hz + vz
            },
        onPointerMove() { if (classroot.sizeMode != "") classroot.moveSize() },
        onPointerDown(e: PointerEvent) { const z = this.zone(e.x, e.y); if (z != "") classroot.beginSize(z) },
        onPointerUp() { classroot.sizeMode = "" },

        // STATIC per-zone cursors: sinkless children of the band (WebKit will
        // not refresh a dynamically-set cursor mid-hover, so the shapes are
        // fixed CSS on fixed regions — hits pass through to the halo's sink).
        // Corners first (they overlap the edge ends and, later in tree order,
        // would cover them — here order is irrelevant since all are sinkless
        // and cursor comes from the deepest element under the pointer).

        cl: View [ x = 0, y = { classroot.corner }, width = { classroot.gutter + classroot.inset }, height = { parent.height - 2 * classroot.corner }, pointerEvents = "auto", cursor = "ew-resize" ],
        cr: View [ x = { parent.width - classroot.gutter - classroot.inset }, y = { classroot.corner }, width = { classroot.gutter + classroot.inset }, height = { parent.height - 2 * classroot.corner }, pointerEvents = "auto", cursor = "ew-resize" ],
        ct: View [ x = { classroot.corner }, y = 0, width = { parent.width - 2 * classroot.corner }, height = { classroot.gutter + classroot.inset }, pointerEvents = "auto", cursor = "ns-resize" ],
        cb: View [ x = { classroot.corner }, y = { parent.height - classroot.gutter - classroot.inset }, width = { parent.width - 2 * classroot.corner }, height = { classroot.gutter + classroot.inset }, pointerEvents = "auto", cursor = "ns-resize" ],
        ktl: View [ x = 0, y = 0, width = { classroot.corner }, height = { classroot.corner }, pointerEvents = "auto", cursor = "nwse-resize" ],
        kbr: View [ x = { parent.width - classroot.corner }, y = { parent.height - classroot.corner }, width = { classroot.corner }, height = { classroot.corner }, pointerEvents = "auto", cursor = "nwse-resize" ],
        ktr: View [ x = { parent.width - classroot.corner }, y = 0, width = { classroot.corner }, height = { classroot.corner }, pointerEvents = "auto", cursor = "nesw-resize" ],
        kbl: View [ x = 0, y = { parent.height - classroot.corner }, width = { classroot.corner }, height = { classroot.corner }, pointerEvents = "auto", cursor = "nesw-resize" ]
        ],

    // The bottom-right corner keeps its small grip AFFORDANCE (art only — the
    // halo owns the interaction, from outside the frame).

    grip: View [ x = { parent.width - classroot.corner }, y = { parent.height - classroot.corner }, visible = { !classroot.plain && !classroot.shaded },
        width = { classroot.corner }, height = { classroot.corner },
        draw(d: Draw) {
            if (!classroot.chrome) return            // custom chrome resizes here too, but unmarked
            d.strokeStyle = theme.textFaint
            d.lineWidth = 1
            d.beginPath()
            d.moveTo(6, 14); d.lineTo(14, 6)
            d.moveTo(10, 14); d.lineTo(14, 10)
            d.stroke()
            }
        ],

    // The first-click veil — a swappable policy (app.firstClickActivatesOnly).
    // A background window's content is covered by this transparent view, so a
    // click there raises the window and goes no further: the content (built-in
    // or an embedded app's island alike) never hears it, because the veil is the
    // hit target and events don't bubble. The chrome stays live — the title bar,
    // the controls, and the veil itself all activate. It sits topmost
    // (raiseChrome) and exists only while the window is in the background, so an
    // active window's content receives everything as usual.

    veil: View [ visible = { !classroot.active && app.firstClickActivatesOnly },
        x = 0, y = { classroot.barH },
        width = { parent.width }, height = { parent.height - classroot.barH },
        onPointerDown() { classroot.activateOnPress() },
        onClick()       { classroot.activate() },
        onHold()        { classroot.activate() }
        ]
    ]


/*
## TrafficLight — a window control

The three round window controls. Each is a filled circle with a hairline
rim a shade darker than the fill (never black), and on bar-hover it reveals
a glyph drawn in a dark tone of the same hue — a thick rounded ×, a minus
bar, and a pair of triangles split along the diagonal for zoom.
*/

class TrafficLight extends View [ y = 0, width = 14, height = 14, cornerRadius = 7,
    c:   Color = #EC6A5E,
    rim: Color = #D25349,
    ink: Color = #7B1006,
    sym: string = "",                            // "close" | "min" | "zoom"
    on: boolean = false,                         // the window's active state, fed at the use site
    showGlyph: boolean = false,                  // bar-hover, fed at the use site

    // The rims are hairlines — a half-pixel stroke, hue-toned when lit and a
    // barely-there gray when not.

    fill = { on ? c : (app.darkMode ? 0x54545A : 0xD2D2D6) },
    faint: Color = #00000014,                    // the barely-there rim of an inactive control
    stroke = { stroke(0.5, on ? rim : this.faint) },

    // The glyph paths are authored in the control's own 14px box.

    g: View [ x = 0, y = 0, width = 14, height = 14,
        visible = { classroot.showGlyph && classroot.on },
        draw(d: Draw) {
            d.strokeStyle = classroot.ink
            d.fillStyle = classroot.ink
            d.lineCap = "round"
            if (classroot.sym == "close") {
                d.lineWidth = 1.6
                d.beginPath()
                d.moveTo(4.5, 4.5); d.lineTo(9.5, 9.5)
                d.moveTo(9.5, 4.5); d.lineTo(4.5, 9.5)
                d.stroke()
                }
            else if (classroot.sym == "min") {
                d.lineWidth = 1.8
                d.beginPath()
                d.moveTo(3.5, 7); d.lineTo(10.5, 7)
                d.stroke()
                }
            else if (classroot.sym == "zoom") {
                d.beginPath()
                d.moveTo(4.1, 4.1); d.lineTo(8.5, 4.1); d.lineTo(4.1, 8.5)
                d.closePath(); d.fill()
                d.beginPath()
                d.moveTo(9.9, 9.9); d.lineTo(5.5, 9.9); d.lineTo(9.9, 5.5)
                d.closePath(); d.fill()
                }
            }
        ]
    ]


/*
## BrandMark — Declare's identity in the leading menu-bar slot

A white disc carrying Declare's `[ ]` brackets in black monospace. It reads
cleanly on any wallpaper and is a calm counterpart to the colored dock icons.
*/

class BrandMark extends View [ width = 18, height = 18, cornerRadius = 9,
    fill = #FFFFFF,

    Text [ x = center, y = center, fontSize = 9, fontWeight = bold,
        textColor = #000000, text = "[ ]" ]
    ]


/*
## The desktop's own menu marks

Two icons that belong to THIS app rather than the library, by the closed-set
rule (`library/icons/icon.declare`): one is Declare's identity, the other names
a thing only this desktop offers. Both are `Icon` subclasses, so they take their
size from the host and their ink from the prevailing text colour like every
other mark in the chrome — what changes is that they are drawn instead of typed.

`BracketIcon` restores the `[ ]` the About row used to set as a text glyph. That
mark is referenced elsewhere as a thing the reader can find (the welcome note
points at "the [ ] icon in the dock"), so it stays visible; only its rendering
changes. `CodeIcon` restores the `‹›` on View & Edit Source the same way.
*/

class BracketIcon extends Icon [
    weight = 1.5,
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(5.4, 3.4); d.lineTo(3.0, 3.4); d.lineTo(3.0, 12.6); d.lineTo(5.4, 12.6)
        d.moveTo(10.6, 3.4); d.lineTo(13.0, 3.4); d.lineTo(13.0, 12.6); d.lineTo(10.6, 12.6)
        d.stroke()
        }
    ]


class CodeIcon extends Icon [
    weight = 1.5,
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.lineJoin = "round"
        d.beginPath()
        d.moveTo(6.4, 4.2); d.lineTo(2.6, 8.0); d.lineTo(6.4, 11.8)
        d.moveTo(9.6, 4.2); d.lineTo(13.4, 8.0); d.lineTo(9.6, 11.8)
        d.stroke()
        }
    ]


/*
## AppGlyph — an application's icon at any size

The dock's rounded plate plus the app's own mark — a text glyph or its drawn
`face` — read straight off the application instance, so the mark is identical
wherever it appears: the dock, an About box, the alert sheet, a minimized
window's badge.
*/

class AppGlyph extends View [ width = { this.edge }, height = { this.edge },
    edge: number = 64,

    // the application BY ID (a component slot cannot be constrained —
    // DECLARE2000; the id can, and ap() resolves it per read)

    appId: string = "",
    ap() -> DesktopApp { return app.launcher.byId(this.appId) },
    cornerRadius = { this.edge * 0.23 }, clip = true,
    fill = { gradient(app.launcher.hue1Of(this.appId), app.launcher.hue2Of(this.appId)) },

    g: Text [ x = center, y = center, fontWeight = semibold, textColor = #FFFFFF,
        fontSize = { classroot.edge * app.launcher.gsizeOf(classroot.appId) },
        visible = { !app.launcher.drawnOf(classroot.appId) && app.launcher.glyphOf(classroot.appId) != "" },
        text = { app.launcher.glyphOf(classroot.appId) } ],
    art: View [ x = 0, y = 0, width = { parent.width }, height = { parent.height },
        visible = { app.launcher.drawnOf(classroot.appId) },
        draw(d: Draw) {
            d.scale(this.width / 48, this.width / 48)
            const a = classroot.ap()
            if (a != null) a.face(d)
            }
        ]
    ]


/*
## CautionBadge — a warning mark

A rounded yellow triangle with a `!`, over a white halo so it reads against
any app icon behind it. Drawn in a 48-unit box.
*/

class CautionBadge extends View [ width = { this.edge }, height = { this.edge },
    edge: number = 30,
    draw(d: Draw) {
        d.scale(this.edge / 48, this.edge / 48)
        const tri = (e, r) => {
            const P = [[24, 5 - e], [44 + e, 41 + e * 0.5], [4 - e, 41 + e * 0.5]]
            d.beginPath()
            d.moveTo((P[0][0] + P[2][0]) / 2, (P[0][1] + P[2][1]) / 2)
            d.arcTo(P[0][0], P[0][1], P[1][0], P[1][1], r)
            d.arcTo(P[1][0], P[1][1], P[2][0], P[2][1], r)
            d.arcTo(P[2][0], P[2][1], P[0][0], P[0][1], r)
            d.closePath()
            }
        d.fillStyle = 0xFFFFFF                        // the halo
        tri(2.6, 7); d.fill()
        const g = d.createLinearGradient(0, 3, 0, 43)
        g.addColorStop(0, "#FFD426"); g.addColorStop(1, "#F5B800")
        d.fillStyle = g
        tri(0, 6); d.fill()
        d.fillStyle = 0x3A2E00                        // the exclamation
        d.fillRect(22, 17, 4, 13)
        d.beginPath(); d.arc(24, 34, 2.3, 0, 6.3, false); d.fill()
        }
    ]


/*
## HelpSearch — a real input inside a menu overlay

The Help menu's search field, rendered as a menu `kind:` row: the row's chrome (no
highlight, no pick) is the menu's, and inside sits a live `TextInput` — a genuine test
of keyboard focus inside a raised layer.

The search *look* is two attributes, not a component: a capsule is
`cornerRadius = height / 2`, and `padding` opens the room the magnifier sits in. The
field keeps its own derived chrome (surface fill, and the 1px edge that turns accent
while focused), which a wrapper drawing the box itself would have displaced.
*/

class HelpSearch extends View [ height = 40,
    width = { parent.width },

    // The capsule is a VIEW, and the field sits inside it. It used to BE the
    // field, inset with `padding = 28` to clear the glyph — but `padding` is one
    // number on all four sides, and 28px of it does not fit a 30px-tall box.
    // Under `box-sizing: border-box` the padding alone claims 56px, so the
    // element grew past its declared height and the placeholder hung below the
    // capsule it was supposed to sit in. A leading glyph needs the inset
    // HORIZONTALLY only, which is a position, not a padding.
    //
    // The cost is reproducing the chrome TextInput derives for itself — surface
    // fill, and the 1px edge that turns accent while focused. Both are read off
    // the same prevailing theme the field would have used, so a theme swap still
    // carries. The capsule reaches 12px from the menu's edges, past the kind-row
    // host's standard 24px inset — hence the negative x.

    cap: View [ x = -12, y = 5, width = { parent.width + 10 }, height = 30,
        cornerRadius = { this.height / 2 },
        fill = { theme.surface },
        stroke = { stroke(1, this.sf.focused ? theme.accent : theme.line) },

        // chrome off: the capsule draws it. The x IS the glyph's room.

        sf: TextInput [ x = 28, y = 0, width = { parent.width - 36 }, height = { parent.height },
            padding = 0, fill = null, stroke = null, cornerRadius = 0,
            placeholder = "Search" ],

        mag: View [ x = 10, y = { (parent.height - 14) / 2 },
            width = 14, height = 14, pointerEvents = "none",
            draw(d: Draw) {
                d.strokeStyle = theme.textFaint
                d.lineWidth = 1.5
                d.lineCap = "round"
                d.beginPath()
                d.arc(6, 6, 4.2, 0, Math.PI * 2, false)
                d.moveTo(9.4, 9.4)
                d.lineTo(12.5, 12.5)
                d.stroke()
                }
            ]
        ]
    ]


/*
## AboutWindow — a tall, image-topped About box

One class serves the desktop and every application: `forApp` picks the art,
the name, and the blurb. `plain` windows give up resize and shade/zoom — the
close control is the whole interface.
*/

class AboutWindow extends Window [ width = 280, height = 380, plain = true,

    // the SUBJECT arrives at creation (openAbout passes the app instance);
    // name, blurb, and art all read it — nothing here switches on a kind

    aname: string = { this.forApp != null ? this.forApp.title : "" },

    body: View [ x = 0, y = { classroot.barH }, width = { parent.width }, height = { parent.height - classroot.barH },
        col: View [ x = 24, y = 22, width = { parent.width - 48 },
            layout: SimpleLayout [ axis = y, spacing = 10 ],

            // the app's own mark at About size — the ONE renderer (AppGlyph),
            // so this art and the dock's cannot disagree

            art: AppGlyph [ x = center, edge = 96, appId = { classroot.forApp != null ? classroot.forApp.id : "" } ],

            nm: Text [ x = center, fontSize = 17, fontWeight = bold, textColor = { theme.text },
                text = { classroot.aname } ],
            ver: Text [ x = center, fontSize = 11, textColor = { theme.textMuted },
                text = "Version pre-1.0" ],
            gap: View [ width = 4, height = 2 ],
            bl: Text [ fontSize = 11, wrap = true, width = { parent.width }, textAlign = center,
                textColor = { theme.textMuted }, text = { classroot.forApp != null ? classroot.forApp.blurb : "" } ],
            gap2: View [ width = 4, height = 8 ],
            cp: Text [ x = center, fontSize = 10, textColor = { theme.textFaint },
                text = "Built in Declare · MIT · © 2026 David Temkin" ]
            ]
        ]
    ]


/*
## FolderIcon / FileIcon — small drawn file-browser icons

A blue folder and a dog-eared page, drawn from rounded rectangles and a few
strokes. (The .5 offsets put 1px strokes on pixel centers, for crisp
hairlines.)
*/

class FolderIcon extends View [ width = 17, height = 13,
    draw(d: Draw) {
        d.fillStyle = 0x4E9FEA
        d.beginPath(); d.roundRect(0, 0, 7.5, 4, 1.5); d.fill()       // the back tab
        d.fillStyle = 0x6AB2F5
        d.beginPath(); d.roundRect(0, 1.8, 17, 11, 1.5); d.fill()     // the body
        d.fillStyle = 0x8CC4F8
        d.beginPath(); d.roundRect(0, 1.8, 17, 3.2, 1.5); d.fill()    // the top lip highlight
        }
    ]


class FileIcon extends View [ width = 13, height = 16,
    draw(d: Draw) {
        d.fillStyle = 0xFFFFFF
        d.strokeStyle = 0xB4B4BA
        d.lineWidth = 1
        d.beginPath()
        d.moveTo(0.5, 0.5); d.lineTo(8.5, 0.5); d.lineTo(12.5, 4.5)
        d.lineTo(12.5, 15.5); d.lineTo(0.5, 15.5)
        d.closePath(); d.fill(); d.stroke()
        d.fillStyle = 0xDDDDE2                       // the dog-ear fold
        d.beginPath()
        d.moveTo(8.5, 0.5); d.lineTo(8.5, 4.5); d.lineTo(12.5, 4.5)
        d.closePath(); d.fill(); d.stroke()
        }
    ]


/*
## FilesWindow — a column browser over the repo's own documentation

Three columns — folders, files, and a preview — over a tree derived live from
the documentation model (`app.docsModel`), so nothing here goes stale when the
docs move. The window's title is the deepest open folder. The columns scroll
and clip independently, the dividers between them drag, and a double-click
opens a document in the Viewer.
*/

class FilesWindow extends Window [

    // the SELECTION CHAIN: the open nodes' names, newline-joined, one per column
    // ("" = nothing open). Every level of the hierarchy — even the top — is DATA
    // (app.docsModel.value.browse, the one documentation model); this window
    // chooses no categories of its own.

    selPath: string = "",
    rootPath: string = "",                       // the folder this window is ROOTED at ("" = the whole tree); a double-clicked folder opens a new window rooted at itself
    colW: number = 250,                          // default column width (fixed; drag a seam to resize)
    widths: number[] = [],                       // per-column width overrides by depth — Finder resizes ONE column
    rowH: number = 24,                           // one Finder row — icon + name, single line
    cw0: number = 0,                             // divider-drag anchors
    cpx0: number = 0,
    cwk: number = -1,                            // depth of the column being dragged
    pendingAt: string = "",                      // the item awaiting a possible second click (data-level double-click)
    pendingItem: object,                         // that item's record (name/path/doc/hasKids/at) — what a second click opens
    pendingPX: number = 0,                       // the pointer at the first click (root space) — a double-click is
    pendingPY: number = 0,                       //   time + POINTER distance, so a row sliding under the cursor

    //   (the strip's reveal scroll) can never retarget the second click

    focusDepth: number = -1,                     // >=0: open pinned to this column at the LEFT edge (a folder opened into a new window), ancestors scroll-left; -1: reveal the deepest column

    // the window's name is the deepest open node, or "Documentation"

    title = { this.selPath != "" ? (("" + this.selPath).split("\n").pop() ?? "Documentation") : (this.rootPath != "" ? (("" + this.rootPath).split("\n").pop() ?? "Documentation") : "Documentation") },

    // Walk `browse` along selPath into a flat list of columns: one LIST column
    // per level (its child nodes), then a DETAIL column once the deepest
    // selection is a leaf. Each item carries `at` — the exact selPath that opens
    // it — so a row's click is one assignment and truncation is automatic (the
    // list re-derives). Miller columns fall straight out of a recursive walk.

    columnData(selPath: string, model: object, rootPath: string) -> array {
        const rootParts = rootPath == "" ? [] : rootPath.split("\n")
        const parts = selPath == "" ? [] : selPath.split("\n")
        const item = (n, p) => ({ name: "" + n.name, kind: "" + (n.kind || ""), label: "" + (n.label || ""),
            hasKids: (n.children != null && n.children.length > 0),
            path: "" + (n.path || ""), doc: "" + (n.doc || ""), preview: "" + (n.preview || ""),
            at: p.join("\n") })
        let level = ((model || ({ })).browse) || []
        // descend to the window's ROOT folder — its children are the first column
        for (let i = 0; i < rootParts.length; i = i + 1) {
            const n = level.find((x) => x.name == rootParts[i])
            if (n == null || n.children == null) return []
            level = n.children
        }
        // the selPath BELOW the root drives the drill; `at` stays the absolute path
        const drill = parts.slice(rootParts.length)
        const cols = []
        cols.push(({ items: level.map((n) => item(n, rootParts.concat([n.name]))), depth: 0 }))
        for (let k = 0; k < drill.length; k = k + 1) {
            const chosen = level.find((n) => n.name == drill[k])
            if (chosen == null) break
            const prefix = rootParts.concat(drill.slice(0, k + 1))
            if (chosen.children != null && chosen.children.length > 0) {
                level = chosen.children
                cols.push(({ items: level.map((n) => item(n, prefix.concat([n.name]))), depth: cols.length }))
            } else {
                cols.push(({ leaf: item(chosen, prefix), depth: cols.length }))
                break
            }
        }
        return cols
        },
    cols: Dataset [ contents = { ({ list: classroot.columnData(classroot.selPath, app.docsModel.value, classroot.rootPath) }) } ],

    // open a leaf — every leaf is a document. An authored file (`path`) opens its
    // source; a hydrated page (`doc`, assembled by the model) opens whole. Same
    // Markdown window either way; the browser special-cases nothing.

    // `v` is the view the open CAME FROM — the row, the Open button — and it is
    // what the new window zooms out of. It used to pass `this`, which in a
    // classroot method is the whole FilesWindow, so opening a file zoomed out of
    // the middle of the browser rather than out of the file. The folder path
    // beside it always passed its row (`openFolderWindow(…, this)`), which is
    // why a folder looked right and a file did not.

    openLeaf(leaf: object, v: View?) {
        const d = "" + (leaf.doc || ""), p = "" + (leaf.path || "")
        if (d != "") { app.launcher.openDoc(d, "" + leaf.name, v); return }
        if (p != "") app.launcher.openViewer("../../" + p, "" + leaf.name, v)
        },

    // THE POINTER-ANCHORED second click (the OS rule: two clicks within a
    // time window AND a few px of pointer travel — row identity deliberately
    // NOT consulted, because the strip's reveal scroll can slide a different
    // row under the cursor between them; matching rows would let a stray hit
    // reselect an ancestor, or pair two distant clicks through a row that
    // slid between). Consumes the pending item and opens it; returns whether
    // it did. NOT the platform's onDblClick, on purpose: a Finder row must
    // SELECT on the first click instantly, and declaring onDblClick makes a
    // single click wait out the double window (§8's resolved layer).

    secondClick(v: View?) -> boolean {
        const near = Math.abs(app.pointerX - this.pendingPX) < 6 && Math.abs(app.pointerY - this.pendingPY) < 6
        const it = this.pendingItem
        if (this.pendingAt == "" || it == null || !near) return false
        this.pendingAt = ""
        if (it.hasKids) app.launcher.openFolderWindow("" + it.at, v)
        else this.openLeaf(it, v)
        return true
        },

    // File → Open (⌘O) on this window's current selection: a document opens in the
    // viewer, a folder opens a new window rooted at it — the double-click actions.

    openSelection() {
        if (this.selPath == "") return
        const cols = this.columnData(this.selPath, app.docsModel.value, this.rootPath)
        const last = cols[cols.length - 1]
        if (last != null && last.leaf != null) this.openLeaf(last.leaf, null)
        else app.launcher.openFolderWindow("" + this.selPath, this)
        },

    body: View [ x = 0, y = { classroot.barH }, width = { parent.width }, height = { parent.height - classroot.barH },
        fill = { theme.bg },

        // the column STRIP: a horizontal row as wide as the open columns need,
        // inside a viewport that scrolls RIGHT (scrolls = x) as they accumulate — a
        // trackpad's horizontal delta drives it, and the runtime swallows that
        // gesture so it never becomes Safari's back-swipe (dom-backend setScrollX).

        strip: View [ x = 0, y = 0, width = { parent.width }, height = { parent.height }, scrolls = x,
            datapath = { classroot.cols.value },

            // the strip's own reveal: a column that finds itself occluded asks
            // the STRIP to glide to a new left position (`reveal.to` then
            // `start()`). The strip is the only thing that moves — this is
            // deliberately NOT scrollIntoView, which reveals on every axis
            // through every ancestor scroller: hosted in a short viewport (the
            // Viewer's edit preview), that walk scrolled the EMBEDDING island
            // vertically. The window's interior animating itself cannot.

            reveal: Animator [ attribute = scrollX, to = 0, duration = 260, motion = cubicOut ],
            row: View [ x = 0, y = 0, height = { parent.height },
                width = { (classroot.cols.value.list || []).reduce((s, c) => s + (classroot.widths[c.depth] != null ? classroot.widths[c.depth] : classroot.colW), 0) },
                layout: SimpleLayout [ axis = x, spacing = 0 ],

                // ONE column per browse level (its child nodes), then the final
                // leaf-DETAIL column once the deepest selection has no children.
                // Each column keeps its own width (Finder: drag one seam, one column).

                // keyed by DEPTH — the stable identity of a column. columnData mints
                // fresh records every derivation; unkeyed, a selection change rebuilt
                // every column (the row emptied for a frame, the native scroller
                // clamped to 0 — a visible left-pop before the reveal scrolled back).
                // Keyed, a selection updates columns in place: no churn, no pop, and
                // only a genuinely NEW (deeper) column runs its reveal.

                View [ datapath = :list[], key = :depth, height = { parent.height }, clip = true, fill = { theme.bg },
                    width = { classroot.widths[:depth] != null ? classroot.widths[:depth] : classroot.colW },

                    // a freshly-opened column reveals itself — IF the window's
                    // frame occludes it, the strip glides to a new left position,
                    // ANIMATED (not a pop). Occlusion is judged here, against the
                    // strip's own viewport, and only `strip.scrollX` moves: the
                    // reveal can never touch any other scroller, however this app
                    // is hosted. Deferred past the double-click window (400ms) so
                    // a second click still lands on the same, un-moved row. A
                    // window opened onto a folder (focusDepth >= 0) instead pins
                    // THAT column to the left edge, so its contents lead.

                    onInit() { setTimeout(() => {
                        const strip = classroot.body.strip
                        const fd = classroot.focusDepth
                        const left = this.x, right = left + this.width
                        let to = -1
                        if (fd < 0) {
                            if (right > strip.scrollX + strip.width) to = right - strip.width
                            else if (left < strip.scrollX) to = left
                        } else if (:depth == fd) to = left
                        if (to >= 0) {
                            // no clamp here: the scroll write is clamped by the
                            // platform to the strip's contained extent, exactly
                            // like a user scroll — the app states the intent
                            strip.reveal.to = to
                            strip.reveal.start()
                        }
                    }, 440) },

                    // a LIST column — this level's nodes as selectable rows

                    lst: View [ visible = { :items != null }, x = 0, y = 0, width = { parent.width }, height = { parent.height }, scrolls = y,

                        // a second click that lands on DEAD SPACE (the reveal slide moved
                        // the rows out from under the pointer) still completes a pointer-
                        // anchored double-click — rows don't bubble, so this fires only
                        // when no row took the hit

                        onClick() { classroot.secondClick(this) },
                        inner: View [ x = 0, y = 6, width = { parent.width }, height = { this.contentHeight + 12 },
                            layout: SimpleLayout [ axis = y, spacing = 1 ],
                            View [ datapath = :items[], width = { parent.width }, height = { classroot.rowH },
                                on: boolean = { classroot.selPath != "" && (("" + classroot.selPath) + "\n").indexOf(("" + :at) + "\n") == 0 },
                                onClick() {
                                    classroot.activate()
                                    const at = "" + :at
                                    // the data-level double-click (secondClick above); a first
                                    // click ARMS the pending item and selects
                                    if (!classroot.secondClick(this)) {
                                        classroot.pendingAt = at
                                        classroot.pendingItem = ({ name: "" + :name, path: "" + :path, doc: "" + :doc, hasKids: !!:hasKids, at: at })
                                        classroot.pendingPX = app.pointerX
                                        classroot.pendingPY = app.pointerY
                                        classroot.selPath = at
                                        setTimeout(() => { if (classroot.pendingAt == at) classroot.pendingAt = "" }, 550)
                                    }
                                    },
                                hl: View [ x = 4, y = 2, width = { parent.width - 8 }, height = { classroot.rowH - 4 }, cornerRadius = 5,
                                    visible = { parent.on }, fill = { theme.accent } ],
                                fo: FolderIcon [ x = 11, y = center, visible = { :hasKids } ],
                                fi: FileIcon [ x = 12, y = center, visible = { !:hasKids } ],
                                nm: Text [ x = 34, y = center, fontSize = 13, wrap = false, width = { parent.width - 52 },
                                    textColor = { parent.on ? theme.accentText : theme.text }, text = { "" + :name } ],
                                chev: Text [ x = { parent.width - 15 }, y = center, fontSize = 12, visible = { :hasKids },
                                    textColor = { parent.on ? theme.accentText : theme.textFaint }, text = "›" ]
                                ]
                            ],
                        edge: View [ x = { parent.width - 1 }, y = 0, width = 1, height = { parent.height }, fill = { theme.line } ]
                        ],

                    // the LEAF DETAIL column — name, kind, a preview, and Open

                    det: View [ visible = { :leaf != null }, x = 18, y = 20, width = { parent.width - 36 },
                        layout: SimpleLayout [ axis = y, spacing = 11 ],
                        dn: Text [ fontSize = 14, fontWeight = semibold, wrap = true, width = { parent.width },
                            textColor = { theme.text }, text = { "" + :leaf.name } ],
                        dk: Text [ fontSize = 11, wrap = false, textColor = { theme.textFaint },
                            text = { "" + :leaf.label } ],
                        dp: Text [ fontSize = 12, wrap = true, width = { parent.width },
                            textColor = { theme.text }, text = { "" + :leaf.preview } ],
                        Button [ width = 92, label = "Open", primary = true, visible = { :leaf.path != "" || :leaf.doc != "" },
                            onClick() { classroot.openLeaf(:leaf, this) }
                            ]
                        ],

                    // drag any seam to resize the columns (fixed width, Finder-style)

                    grip: View [ x = { parent.width - 4 }, y = 0, width = 8, height = { parent.height }, cursor = "col-resize",
                        onPointerDown() { classroot.activateOnPress(); classroot.cwk = :depth; classroot.cw0 = parent.width; classroot.cpx0 = app.pointerX },
                        onPointerMove() { if (classroot.cwk == :depth) { const nw = Math.max(150, Math.min(460, classroot.cw0 + app.pointerX - classroot.cpx0)); const a = [...classroot.widths]; a[:depth] = nw; classroot.widths = a } },
                        onPointerUp() { classroot.cwk = -1 }
                        ]
                    ]
                ]
            ]
        ]
    ]


/*
## AppWindow — a whole Declare app inside a desktop window

The window frame around an `AppIsland` — the library's app-embedding primitive.
Give the island a `program` and it mounts that app as its own child: its own
reactive graph, input router, sized to the island's box. The path is relative,
so `"../../calendar/calendar"` reaches the real calendar app: no copy, no shim.
The window adds only what a window owns — the title (taken from the running
child's own name, `island.childName`), activation, and the `dark` + `extraEnv`
environment it hands the island.
*/

class AppWindow extends Window [ width = 880, height = 560,
    extraEnv: string = "",                       // appended env parameters ("program=…")

    // the window's name is the HOSTED app's name, reflected up from the embedded
    // child (`island.childName`): the viewer titles by the file it shows and
    // follows its navigation. `appTitle` is the fallback until the child is up.

    appTitle: string = "",
    title = { this.island.childName != "" ? this.island.childName : this.appTitle },

    // the slot's ENV segment (after `|`) is the embedding environment — the
    // host parses it into the child's reactive `app.env`, at mount and on
    // every change: toggling the desktop's appearance re-marks the slot and
    // the hosted app re-derives (its Auto mode follows `app.env.dark`)

    // a press anywhere in the hosted app also lands here (the router remaps
    // embedded presses to the island — dom-backend), so clicking the child's
    // content raises this window exactly as clicking any window body does

    island: AppIsland [ x = 0, y = { classroot.barH }, width = { parent.width }, height = { parent.height - classroot.barH },
        onPointerDown() { classroot.activateOnPress() },
        onClick()       { classroot.activate() },
        onHold()        { classroot.activate() },
        program = { classroot.appPath },

        // The TYPED half of the dark channel (islands design): a tenant that
        // declares `external darkOverride: string` gets this as a checked
        // fact, handshake and all. TRI-STATE by sentinel — "dark" / "light",
        // "" = the host has no opinion (an unlinked tenant's default, so its
        // Auto mode falls through to its own app.dark). The desktop always
        // has an opinion. `env.dark` below stays — the untyped ancestor — so
        // every existing tenant keeps working; new tenants should pair.

        external darkOverride: string = { app.darkMode ? "dark" : "light" },
        env = { "dark=" + (app.darkMode ? "1" : "0")
            + (classroot.extraEnv != "" ? "&" + classroot.extraEnv : "") }
        ]
    ]


/*
## ViewerWindow — a Markdown window over a real document

Renders a document with the library's `Markdown` view. A `"ref:"` path builds a
reference page from the documentation model; anything else fetches the real
file as text. Its title is the file's basename.
*/

class ViewerWindow extends Window [ width = 640, height = 460,
    path: string = "",

    // the window's name is the FILE being viewed — its basename, not the path
    // (a "ref:" page names the element). The same basename rule the standalone
    // viewer app titles itself by, so the two agree.

    // a viewer opens either a real FILE (a `path` it fetches) or a HYDRATED doc
    // handed over whole (`inlineDoc` — a page the model already assembled, e.g.
    // an element's reference). `docName` titles a hydrated doc; a file titles by
    // its basename.

    inlineDoc: string = "",
    docName: string = "",
    title = { this.inlineDoc != "" ? this.docName : (this.path.split("/").pop() || "") },

    src: DataSource [ format = "text", url = { classroot.path } ],

    // the scrolling body is a real pointer target covering the whole window,
    // and subclass children attach after the base's — so the Window's resize
    // strips re-promote above it (order is a slot) or edge drags never land

    onInit() {
        if (this.inlineDoc == "") this.src.fetch()
        this.raiseChrome()
        },

    body: View [ x = 0, y = { classroot.barH }, width = { parent.width }, height = { parent.height - classroot.barH },
        scrolls = y, selectable = true,

        // THE DOCS READING TREATMENT, carried over whole (docs.declare is the
        // reference): 48px side margins and 40 above (the pad's explicit height
        // adds the same 40 below, so the scroll extent ends with breathing room);
        // prose wraps at the 560 reading measure while code fills the column;
        // 1.6 leading; the docs body ink; and every code block gets the tinted
        // box with the teal left bar. The chip tints are the docs values on the
        // shared white surface, and a neutral step-up of the same relationship
        // on Cupertino's dark surface (the docs dark chip is tuned to its own
        // blue-black page, not to 0x2C2C2E).

        pad: View [ x = 48, y = 40, width = { parent.width - 96 },
            height = { this.doc.height + 40 },
            loading: Text [ fontSize = 13, textColor = { theme.textFaint },
                visible = { classroot.inlineDoc == "" && classroot.src.loading }, text = "Loading…" ],
            failed: Text [ fontSize = 13, textColor = { theme.textFaint }, wrap = true, width = { parent.width },
                visible = { classroot.inlineDoc == "" && classroot.src.failed },
                text = { "Could not load — " + (classroot.src.error || "") } ],
            doc: Markdown [ width = { parent.width },
                visible = { classroot.inlineDoc != "" || classroot.src.loaded },
                richTextLayout = { { default: { maxWidth: 560 }, code: { maxWidth: 0 } } },
                lineHeight = 1.6,
                bodyColor = { app.darkMode ? 0xC4CFD8 : 0x2E3B46 },
                codeBackground = { app.darkMode ? 0x35393F : 0xE9EFF4 },
                codeRule = { app.darkMode ? 0x37E0C8 : 0x12A08D },
                dark = { app.darkMode },
                text = { classroot.inlineDoc != "" ? classroot.inlineDoc : (classroot.src.value || "") } ]
            ]
        ]
    ]


/*
## JotWindow — a sticky note with its own chrome

A custom window type: square corners, yellow paper, and — when active — a
saturated title strip carrying olive-outlined pale widgets (a close box at the
left; a zoom triangle and a collapse box at the right). An inactive note is
chromeless: the strip and widgets vanish into the paper. It keeps all of the
base `Window`'s behavior — drag, the activation shadow, shade, resize edges —
through `chrome = false`, so here chrome is a skin, not the skeleton.
*/

class JotWindow extends Window [ width = 300, height = 250, chrome = false,
    baseRadius = 0, barH = 12, minW = 160, minH = 90,
    title = "",                                  // untitled — labels fall back to the app's name
    note: string = "",                           // the note's seed text

    // the note's palette: paper #FEF49C, active strip #FEEA3D, widget
    // linework #DBC501 dark olive over #FFF49C pale, and a half-pixel
    // #4E4E52 rim — a full CSS pixel reads as drawn-on lines, not an edge

    fill = #FEF49C,
    stroke = { stroke(0.5, 0x4E4E52) },
    inkHi = #00000052,
    inkLo = #00000038,
    shadow = { app.wm.frontWin == this ? shadow(0, 10, 26, this.inkHi) : shadow(0, 3, 9, this.inkLo) },

    strip: View [ x = 0, y = 0, width = { parent.width }, height = { classroot.barH },
        fill = { classroot.active ? 0xFEEA3D : 0xFEF49C },
        onPointerDown() { classroot.beginDrag() },
        onPointerMove() { classroot.dragTo() },
        onPointerUp(e: PointerUpEvent)   { classroot.endDrag(e.canceled) },
        onHold() { classroot.activate() },   // the hold rider — same claim shape as the title bar; it also raises

        // the strip's widgets: dark olive outlines around pale interiors —
        // the close box 11px in from the left, the zoom triangle (right
        // angle at bottom-right) and the collapse box in from the right

        closeBox: View [ visible = { classroot.active }, x = 11, y = 2.25, width = 7.5, height = 7.5,
            fill = #FFF49C, stroke = { stroke(1.4, 0xDBC501) },
            onClick() { app.wm.closeWin(classroot) }
            ],
        zoomW: View [ visible = { classroot.active }, x = { parent.width - 33 }, y = 2.25, width = 8, height = 8,
            onClick() { classroot.zoomToggle() },
            draw(d: Draw) {
                d.fillStyle = 0xFFF49C
                d.strokeStyle = 0xDBC501
                d.lineWidth = 1.4
                d.beginPath()
                d.moveTo(0.7, 7.3); d.lineTo(7.3, 7.3); d.lineTo(7.3, 0.7)
                d.closePath(); d.fill(); d.stroke()
                }
            ],
        collapseW: View [ visible = { classroot.active }, x = { parent.width - 21 }, y = 2.25, width = 8, height = 8,
            onClick() { classroot.shadeToggle() },   // collapse down to just the strip
            draw(d: Draw) {
                d.fillStyle = 0xFFF49C
                d.fillRect(0.7, 0.7, 6.6, 6.6)
                d.strokeStyle = 0xDBC501
                d.lineWidth = 1.4
                d.beginPath()
                d.rect(0.7, 0.7, 6.6, 6.6)
                d.stroke()
                d.beginPath()
                d.moveTo(0.7, 3.1); d.lineTo(7.3, 3.1)
                d.stroke()
                }
            ]
        ],

    // the note body is formatted — a Markdown field on the paper (no input
    // chrome, no focus ring; the note's text is authored, not typed)

    pad: View [ x = 12, y = { classroot.barH + 6 }, clip = true,
        width = { parent.width - 24 }, height = { parent.height - classroot.barH - 16 },
        md: Markdown [ width = { parent.width }, dark = false,
            bodyColor = 0x1D1D1F, scale = 0.82, lineHeight = 1.45,
            text = { classroot.note } ]
        ]
    ]


/*
## MiniTile — a minimized window's dock tile

An invisible click target that rides the same magnification swell as the
icons, so its hit area and label track the live thumbnail beneath it (the
thumbnail is the parked window itself). The tile sits in the dock layer above
the parked window, so a click restores it instead of poking its tiny content.
Its pill is the `DockIcon`'s, showing the window's title.
*/

class MiniTile extends View [

    // REPLICATED over the WM's parked records (wm.miniData, one tile per
    // record, keyed by the window's id) — the static six-slot pool this
    // replaced existed only because per-row liveness couldn't then be
    // trusted; the records era ends with the cap

    ix: number = { Number(:ix ?? 0) },
    recId: string = { "" + (:id ?? "") },
    lbl: string = { "" + (:label ?? "") },
    appId: string = { "" + (:appId ?? "") },

    // geometry straight from the mini layout (the same entries the parked
    // window reads), translated into the minis section's local space

    slotW: number = { app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].w : 48 },
    slotH: number = { app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].h : 48 },
    slotRestW: number = { app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].rw : 48 },
    waveMag: number = { this.slotW / Math.max(1, this.slotRestW) },
    x = { (app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].x : 0) - (app.dock.x + app.dock.row.width + 32) },
    width = { this.slotW },
    height = { this.slotH },   // the thumbnail's aspect height (not icon-square), so the badge lands on the thumbnail's own corner
    y = { parent.height - 13.5 - 30.5 * this.waveMag - this.height / 2 },   // scales around the badge baseline (grows upward on rollover); at rest this is the plate center
    onClick() { app.wm.restoreMiniAt(this.ix) },

    // the app-icon badge — on the tile (the dock layer, above the plate's
    // frost, so it renders crisp), gated by geometry: it shows exactly while
    // the window is seated in this slot — its visual width equals the slot's
    // (both sides derive from the same layout entry, so the equality holds
    // through the magnification wave, and never mid-journey: a traveling or
    // restored window's scale·width can't match). Pure derived fact, read
    // LIVE off the window itself — no journey bookkeeping.

    seated: boolean = { app.wm.seated(this.recId, this.slotW) },

    // The badge is the app's own dock icon at badge scale — same class, same
    // art, so the calendar badge carries the live date.
    // Its wave/size/position constraints are displaced at this use site, and
    // its pointer handlers forward to the tile (so no second pill appears).

    badge: DockIcon [
        visible = { classroot.seated },
        width = { app.dock.badgeEdge * classroot.waveMag }, height = { app.dock.badgeEdge * classroot.waveMag },

        // x tracks the thumbnail's right edge (2px inside it); y sits on the
        // dock's common badge baseline (13.5px above the plate floor), not the
        // thumbnail's own bottom — so a short or landscape thumbnail's badge
        // hangs below it while a tall one stays contained. The tile's center is
        // the plate center; baseline = center + (44 - 13.5).

        x = { parent.width - (app.dock.badgeEdge + 2) * classroot.waveMag },
        y = { parent.height / 2 + (30.5 - app.dock.badgeEdge) * classroot.waveMag },
        appId = { classroot.appId },
        onClick() { app.wm.restoreMiniAt(classroot.ix) }
        ],

    // the label pill — the DockIcon's, verbatim geometry: it floats just above
    // the tile's OWN top (local y), tail tip meeting it, so it rides the
    // magnified crest exactly as the app-icon pill does

    pill: View [ visible = { classroot.hovered },   // the TILE's hover, not the pill's:
        //  a pill hidden until hovered could never show itself (an invisible view
        //  is not on the hit chain), so the fact has to come from what it labels

        width = { this.t.width + 26 }, height = 33,
        x = center,
        y = { parent.height / 2 - 102 },   // pinned to the shared pill baseline (~62px above the plate top), same Y as the app-icon pills
        bodyH: number = 22,
        draw(d: Draw) { app.drawPill(d, this.width, this.bodyH, app.darkMode) },
        t: Text [ x = center, y = { (this.parent.bodyH - this.height) / 2 }, fontSize = 13,
            textColor = { app.darkMode ? 0xF2F2F5 : 0x1D1D1F },
            text = { classroot.lbl } ]
        ]
    ]


/*
## DockIcon — a drawn, labeled icon that magnifies by layout

Each icon's live width springs toward a target read from the pointer's distance
to its resting center, so hovering the dock swells the icons under the pointer
and displaces their neighbors. The magnification is layout, not paint: the
widths really change and the plate stretches to hold them.
*/

class DockIcon extends View [

    // per-icon inputs, fed at the use site

    ix: number = 0,                              // resting slot index
    slots: number = { app.launcher.roster.length },   // total icons — derived from the catalog

    // THE application, held BY ID: a component slot cannot be constrained
    // (DECLARE2000), but an id string can — and a constraint may freely READ
    // the node ap() resolves, so face, hues, dot, pill, and the click all
    // derive from the one instance, reactively re-resolving if the id moves
    // (a MiniTile badge's does).

    appId: string = "",
    ap() -> DesktopApp { return app.launcher.byId(this.appId) },
    running: boolean = false,                    // fed from the data row at the use site (the live flag rides the records)

    // shared geometry — one place for the numbers the constraints below share

    rest: number = { app.dock.iconEdge },             // resting icon size (the shared cell)
    pitch: number = { app.dock.iconEdge + 16 },       // slot-center spacing: the resting size plus a 16px gap
    strip: number = 16,                          // the running-dot band below the icons

    // the face is rendered ONCE at this fixed reference size and paint-scaled to
    // the live magnified width (the plate's `scale` below). It must be ≥ the
    // largest magnified size (rest · 1.55 ≈ 87pt) so the transform only ever
    // DOWNsamples the hi-res raster — smooth, no shimmer — while the illustration
    // and rim draw()s invalidate only on real content change (calendar day,
    // theme), never per magnification frame. This keeps the wave inside Safari's
    // frame budget: 9 GPU blits, not 9 vector re-rasters, every frame.

    face: number = 96,

    // the resting slot center in app coords — the magnification's source must
    // not read the magnified layout (a feedback loop); resting geometry is
    // fixed: `pitch` about the app's center

    cx0: number = { app.width / 2 + (this.ix - (this.slots - 1) / 2) * this.pitch - app.dock.miniSpan / 2 },

    // magnification: the shared wave (app.dockMag) about my resting center,
    // read off the SMOOTHED pointer (dockX) so it glides every frame, and
    // scaled by the enter/exit envelope (the dock's `hot`) so entering and
    // leaving glide too. Neighbors displace as the widths change — the wave
    // is layout, not paint.

    // Each icon springs its OWN magnification toward a target read from the raw
    // pointer, so every icon is always mid-flight during motion and the swell
    // glides continuously — smoother than a single shared spring, which would
    // settle between the browser's coalesced pointer events and step. The
    // resting center (cx0) feeds the distance, so the swell never reads its own
    // magnified output.

    // The dock's enter/exit gate, DECLARED rather than groped for. This class
    // is hosted in two places — the dock row (which feeds the dock's live
    // gate at the instance) and a MiniTile badge (which feeds nothing) — and
    // the default 0 IS the badge's contract: a host that states no gate is a
    // host with no wave, so the badge's spring parks at 1. The old shape
    // reached this.parent.parent.hotGate and coped with `undefined` at run
    // time; that once fed six springs a NaN target they chased for the life
    // of the session (F1) — a typed slot with a stated default cannot.

    hotGate: number = 0,

    magTarget: number = { 1 + (app.dock.dockMag(app.pointerX - this.cx0) - 1) * this.hotGate },
    mag: number = 1,
    magSpring: Spring [ attribute = mag, to = { classroot.magTarget }, stiffness = 1300, damping = 62, epsilon = 0.002 ],
    width  = { this.rest * this.mag },
    height = { this.width },
    y = { parent.height - this.height - this.strip - this.hopY },   // bottom-anchored above the dot strip

    // The launch bounce: a ballistic arc — decelerating up, gravity down —
    // twice, about 560ms per bounce, poked by the app when an application first
    // opens (or first opens again after a Quit). The group cascades `attribute`
    // to its members; each leg is one half of the parabola.

    hopY: number = 0,

    bounce: AnimatorGroup [ attribute = hopY, process = sequential,
        Animator [ to = 30, duration = 300, motion = quadOut ],
        Animator [ to = 0, duration = 260, motion = quadIn ],
        Animator [ to = 30, duration = 300, motion = quadOut ],
        Animator [ to = 0, duration = 260, motion = quadIn ]
        ],

    poke() { this.bounce.start() },
    plate: View [ x = 0, y = 0, width = { classroot.face }, height = { classroot.face },
        // Paint-only magnification: the face is drawn once at `face`px and the
        // GPU scales it (about the top-left, so it fills the bottom-anchored box)
        // to the live width — no per-frame re-raster of the illustration or rim.
        // The DockIcon's LAYOUT width still grows, so neighbors displace as
        // before: the swell stays layout; only each icon's paint is cached.

        scale = { classroot.width / classroot.face },
        cornerRadius = { this.width * 0.23 }, clip = true,
        fill = { gradient(app.launcher.hue1Of(classroot.appId), app.launcher.hue2Of(classroot.appId)) },

        // Glyph sizes stay fractional — rounding them would tick the art in
        // whole-pixel steps while the plate glides subpixel, a visible jitter.

        g: Text [ x = center, y = center, fontWeight = semibold, textColor = 0xFFFFFF,
            fontSize = { this.parent.width * app.launcher.gsizeOf(classroot.appId) },
            visible = { !app.launcher.drawnOf(classroot.appId) && app.launcher.glyphOf(classroot.appId) != "" },
            text = { app.launcher.glyphOf(classroot.appId) } ],

        // Drawn app art, authored in a 48-unit box and scaled to fill the plate.

        art: View [ x = 0, y = 0, width = { parent.width }, height = { parent.height },
            visible = { app.launcher.drawnOf(classroot.appId) },

            // the illustration is drawn at the icon's LIVE size — a canvas
            // scale inside draw() (vector, recomputed every frame) rather than
            // a CSS transform stretching a fixed 48px raster, which re-samples
            // and jitters a pixel as the magnification glides. The app's face
            // keeps its 48-unit authoring coordinates; only the scale moved
            // inward. (The calendar's live weekday + day are part of ITS face,
            // so the whole mark scales as one unit and re-records on the flip.)

            draw(d: Draw) {
                d.scale(this.width / 48, this.width / 48)
                const a = classroot.ap()
                if (a != null) a.face(d)
                }
            ],

        // The icon's glossy edge — the same top-lit rim the dock plate carries,
        // scaled to the icon and drawn at its live size (no raster jitter as it
        // magnifies). A 1px white highlight, brightest along the top and fading
        // down, like the sheen a glossy rounded tile catches from above.

        rim: View [ x = 0, y = 0, width = { parent.width }, height = { parent.height },
            draw(d: Draw) {
                const w = this.width
                const h = this.height
                if (w < 3 || h < 3) return       // a freshly replicated tile's first paint can be 0×0 — nothing to rim
                const r = w * 0.23
                const g = d.createLinearGradient(0, 0, 0, h)
                g.addColorStop(0, "rgba(255,255,255,0.42)")
                g.addColorStop(0.34, "rgba(255,255,255,0.07)")
                g.addColorStop(1, "rgba(255,255,255,0)")
                d.strokeStyle = g
                d.lineWidth = 1
                d.beginPath()
                d.roundRect(0.5, 0.5, w - 1, h - 1, r - 0.5)
                d.stroke()
                }
            ]
        ],

    // the running-app dot, centered in the strip below the icon

    // the dot marks is-running and never bounces: adding hopY back cancels the
    // icon's launch-bounce offset, pinning the dot to the strip. MEASURED from
    // the running dot: near-black on the light shelf, ~4px across — not muted
    // gray. theme.text IS that value (0x1D1D1F light) and flips to a light dot
    // under a dark theme, so it always reads against the shelf.

    dot: View [ width = 4, height = 4, cornerRadius = 2,
        x = { (parent.width - 4) / 2 }, y = { parent.height + 6 + this.parent.hopY },
        visible = { running }, fill = { theme.text } ],

    // The label pill — the dock's own tooltip: a frosted chip with a downward
    // pointer tick and no shadow. It floats just above the hovered icon's own
    // top, so its tail tip meets the icon and — since the hovered icon is the
    // swell's peak — it clears every neighbor. As the icon magnifies and its top
    // rises, the pill rides up with it.

    pill: View [ visible = { classroot.hovered },   // the ICON's hover, not the pill's
        width = { this.t.width + 26 }, height = 33,
        x = center,
        y = { parent.height - 130 },   // pinned to the shared pill baseline, so it lands right at any magnification
        bodyH: number = 22,
        draw(d: Draw) { app.drawPill(d, this.width, this.bodyH, app.darkMode) },
        t: Text [ x = center, y = { (this.parent.bodyH - this.height) / 2 }, fontSize = 13,
            textColor = { app.darkMode ? 0xF2F2F5 : 0x1D1D1F },
            text = { app.launcher.labelOf(classroot.appId) } ]
        ]
    ]


/*
### The clock

Today, as a fact: the menu bar's live readout, the calendar dock icon's date
face, and an About window's date all read the same node. Self-driving — it
arms its own 15-second timer at init, so no host wiring exists to forget.
*/

class Clock extends Node [
    text: string = "",
    dayName: string = "",
    dayNum: number = 0,

    tick() {
        const d = new Date()
        const wd = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][d.getDay()]
        const mo = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][d.getMonth()]
        const h12 = d.getHours() % 12 == 0 ? 12 : d.getHours() % 12
        const mm = (d.getMinutes() < 10 ? "0" : "") + d.getMinutes()
        this.text = wd + " " + mo + " " + d.getDate() + "  " + h12 + ":" + mm + " " + (d.getHours() >= 12 ? "PM" : "AM")
        this.dayName = wd.toUpperCase()
        this.dayNum = d.getDate()
        },
    onInit() { this.tick(); setInterval(() => this.tick(), 15000) }
    ]


/*
### The applications

An APPLICATION is a node: one instance per app the desktop offers, declared
under the launcher and reachable by name (`app.launcher.calendar`). The
instance carries everything that is the app's own — identity (label, title,
blurb), the icon (plate hues, a text glyph or a drawn `face`), launch state
(`running`/`launching`/`count`, plain reactive attributes — assignment is the
update, no record ceremony), policy (`alwaysRunning`, `canOpen`, `place`),
and the `launch` verb behind its dock icon and menu items. (The verb is
`launch`, not `open` — dep-extract resolves calls by NAME across the merged
source, and `open` collides with the library combobox's `open()`: the
phantom-".start()" trap this file has hit before.)

One taxonomy covers every citizen. A BUILT-IN app (Files, Jots) opens windows
of this very program. A HOSTED app (Calendar, 50 Birds, Declare Viewer) is a
FOREIGN program carried the same way — hosting is a subclass with a program
path, not a different mechanism. An INERT app (Write, Mail, Music, Terminal)
owns a quip and raises the alert. Chrome never switches on an app id: the
dock icon, the About box, the alert sheet, and a minimized window's badge all
read the ONE instance, so the art, the name, and the running dot cannot
disagree — and adding an application is one class plus one roster entry.

`face(d)` is the icon's art, authored in the dock's 48-unit box; the caller
scales first and has painted the plate hue behind (AppGlyph, DockIcon). It is
a method, so a face that reads live state — the calendar's date — re-records
when that state changes, like any tracked drawing.
*/

class DesktopApp extends Node [
    id: string = "",
    label: string = "",                          // the dock pill's short name
    title: string = "",                          // the formal name — menus, About
    blurb: string = "",                          // the About box's line
    glyph: string = "",                          // a text-glyph mark (M↓, ♪, [ ]) …
    gsize: number = 0.42,                        //   … at this fraction of the plate
    drawn: boolean = false,                      // … or a drawn face() — this flag picks
    hue1: Color = #4A90D9,                       // plate gradient, top → bottom
    hue2: Color = #2E5FA3,
    src: string = "desktop.declare",             // View & Edit Source's subject
    quip: string = "",                           // an inert app's refusal
    running: boolean = false,
    launching: boolean = false,                  // mid launch-bounce (guards a double-click)
    count: number = 0,                           // open windows (informational)
    alwaysRunning: boolean = false,              // Files: no Quit item
    canOpen: boolean = true,                     // calendar: Open… disabled
    face(d: Draw) { },                           // drawn icon art, in the 48-unit box
    launch(v: View?) { }                         // what New and a dock click do
    ]


class HostedApp extends DesktopApp [             // a foreign program — the same citizen
    prog: string = "",                           // the program the window's island mounts
    env: string = "",                            // its embedding environment segment
    place: string = "",                          // window placement policy ("clearDock")
    launch(v: View?) { app.launcher.openHosted(this, v, "") }
    ]


class InertApp extends DesktopApp [
    launch(v: View?) { app.alert.subject = this }
    ]


class FilesApp extends DesktopApp [ id = "files", label = "Files", title = "Files",
    blurb = "Browses the live documentation model — every chapter, every element.",
    hue1 = #59B0F6, hue2 = #1D6FD1, drawn = true,
    running = true, alwaysRunning = true,
    launch(v: View?) { app.launcher.newFiles() },
    face(d: Draw) {
        // the folder — one rendition, wherever the icon appears
        d.fillStyle = 0xD9E7FA
        d.beginPath()
        d.roundRect(9, 13.5, 14, 8, 2)
        d.fill()
        d.beginPath()
        d.roundRect(9, 16, 30, 19, 2.5)
        d.fill()
        d.fillStyle = 0xFFFFFF
        d.beginPath()
        d.roundRect(9, 20, 30, 15, 2.5)
        d.fill()
        }
    ]


class MarkdownApp extends DesktopApp [ id = "markdown", label = "Markdown", title = "Markdown",
    blurb = "Renders the real files, and reference pages synthesized from the model.",
    glyph = "M↓", hue1 = #8E7CE8, hue2 = #5A46B8,
    launch(v: View?) { app.launcher.openViewer("../../docs/declare.md", "declare.md", v) }
    ]


class ViewerApp extends HostedApp [ id = "declareviewer", label = "Declare Viewer", title = "Declare Viewer",
    blurb = "Reader, source, and live editor over any Declare program — here, hosted as an embedded app.",
    glyph = "[  ]", hue1 = #2E6FE0, hue2 = #12A594,
    prog = "../../viewer/viewer", env = "program=desktop.declare", src = "../viewer/viewer.declare"
    ]


class CalendarApp extends HostedApp [ id = "calendar", label = "Calendar", title = "Declare Calendar",
    blurb = "The actual apps/calendar, running as an embedded child app in this window's island.",
    hue1 = #FFFFFF, hue2 = #EFEFF2, drawn = true, canOpen = false,
    prog = "../../calendar/calendar", env = "base=../calendar/", src = "../calendar/calendar.declare",
    place = "clearDock",
    face(d: Draw) {
        d.fillStyle = 0xFFFFFF
        d.fillRect(0, 0, 48, 48)
        d.fillStyle = 0xFB4238
        d.fillRect(0, 0, 48, 13)
        // the weekday and day are drawn in the SAME 48-unit space, so the
        // whole face — band, MON, and the number — scales as one unit at any
        // size (dock crest, badge, About); reading the clock here means the
        // face re-records when the day flips, wherever it is mounted.
        d.textAlign = "center"
        d.fillStyle = 0xFFFFFF
        d.font = "bold 7.5px system-ui, sans-serif"
        d.textBaseline = "middle"
        d.fillText(app.clock.dayName, 24, 7)
        d.fillStyle = 0x1D1D1F
        d.font = "27px system-ui, sans-serif"
        d.fillText("" + app.clock.dayNum, 24, 31)
        }
    ]


class JotsApp extends DesktopApp [ id = "jots", label = "Jots", title = "Jots",
    blurb = "Small paper notes with their own window chrome — built into this program.",
    hue1 = #FCF4A7, hue2 = #F3E27E, drawn = true,
    launch(v: View?) { app.launcher.newJot("", v) },
    face(d: Draw) {
        // all-yellow paper (the plate's yellow is the background), a
        // saturated strip and faint ruled lines
        d.fillStyle = 0xF3DC49
        d.fillRect(0, 0, 48, 10)
        d.strokeStyle = 0xE0CE66
        d.lineWidth = 2
        d.beginPath()
        d.moveTo(8, 19); d.lineTo(40, 19)
        d.moveTo(8, 27); d.lineTo(40, 27)
        d.moveTo(8, 35); d.lineTo(26, 35)
        d.stroke()
        }
    ]


class BirdsApp extends HostedApp [ id = "birds", label = "50 Birds", title = "50 Birds",
    blurb = "The actual apps/birds — Audubon's plates as a field guide — hosted as an embedded app.",
    hue1 = #66C95F, hue2 = #2C9243, drawn = true,
    prog = "../../birds/birds", env = "base=../birds/", src = "../birds/birds.declare",
    face(d: Draw) {
        // the bird: a perched songbird facing right — one white
        // silhouette (beak, crown, back, tail, breast), with the eye and
        // the folded wing struck back in the plate's hue.
        d.fillStyle = 0xFFFFFF
        d.beginPath()
        d.moveTo(41.5, 16.5)                                     // beak tip
        d.lineTo(34.6, 13.4)                                     // beak base, top edge
        d.bezierCurveTo(33.2, 8.6, 26.4, 7.2, 22.8, 10.8)        // the crown
        d.bezierCurveTo(17.5, 15.8, 12.2, 25.4, 8.5, 37)         // the back, sloping to the tail
        d.lineTo(16.2, 34.2)                                     // the tail's notch
        d.bezierCurveTo(21.5, 36.6, 28.4, 36.4, 32.4, 32.2)      // the belly
        d.bezierCurveTo(35.6, 28.8, 36.2, 23.6, 34.9, 19.6)      // the breast, up to the throat
        d.closePath()                                            // throat back to the beak tip
        d.fill()
        d.fillStyle = this.hue1
        d.beginPath()
        d.arc(30.2, 14.6, 1.6, 0, Math.PI * 2)                   // the eye
        d.fill()
        d.strokeStyle = this.hue1
        d.lineWidth = 1.6
        d.lineCap = "round"
        d.beginPath()
        d.moveTo(24.5, 18.5)
        d.quadraticCurveTo(17.5, 22.5, 14.8, 30.5)               // the folded wing
        d.stroke()
        }
    ]


class WriteApp extends InertApp [ id = "write", label = "Write", title = "Write",
    quip = "No.", hue1 = #F49B45, hue2 = #C96B1D, drawn = true,
    face(d: Draw) {
        // the pencil: eraser upper-left, tip lower-right. Body + tip in
        // white; the eraser seam struck back in the plate's hue.
        d.fillStyle = 0xFFFFFF
        d.beginPath()
        d.moveTo(7.8, 12.2); d.lineTo(14.2, 5.8); d.lineTo(35.7, 27.3); d.lineTo(29.3, 33.7)
        d.closePath(); d.fill()
        d.beginPath()
        d.moveTo(35.7, 27.3); d.lineTo(29.3, 33.7); d.lineTo(39.5, 37.5)
        d.closePath(); d.fill()
        d.strokeStyle = this.hue1
        d.lineWidth = 1.6
        d.beginPath()
        d.moveTo(11.4, 15.7); d.lineTo(17.7, 9.4)
        d.moveTo(13.5, 17.8); d.lineTo(19.8, 11.5)
        d.stroke()
        }
    ]


class MailApp extends InertApp [ id = "mail", label = "Mail", title = "Mail",
    quip = "Nope.", hue1 = #1E8CFB, hue2 = #1667D9, drawn = true,
    face(d: Draw) {
        d.fillStyle = 0xFFFFFF
        d.beginPath()
        d.moveTo(9, 15); d.lineTo(39, 15); d.lineTo(39, 34); d.lineTo(9, 34)
        d.closePath(); d.fill()
        d.strokeStyle = 0xB9C6DB
        d.lineWidth = 1.6
