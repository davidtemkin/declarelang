App [ facts: Dataset { { "rows": [
        { "label": "reactive", "n": 92 },
        { "label": "compiled", "n": 78 },
        { "label": "small",    "n": 64 } ] } },
    group: View [ x = center, y = center, width = 80%, height = { this.contentHeight },
        datapath = { app.facts.value },
        layout: SimpleLayout [ axis = y, spacing = 20 ],
        Bar [ width = { parent.width }, datapath = :rows[], label = :label, value = :n ],
        ],
    ]
