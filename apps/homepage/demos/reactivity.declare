App [ textColor = whitesmoke,
    v: number = 40,
    cool: Color = dodgerblue,
    warm: Color = turquoise,
    onPointerDown() { v = (v + 20) % 100 },
    group: View [ x = center, y = center, width = 80%, height = { this.contentHeight },
        layout: SimpleLayout [ axis = y, spacing = 20 ],
        Text [ width = { parent.width }, textAlign = center, textColor = slategray, text = "click anywhere to change v" ],
        Text [ width = { parent.width }, textAlign = center, fontSize = 70, fontWeight = bold, text = { v + "" } ],
        Bar [ width = { parent.width }, value = { v }, tint = { v < 50 ? cool : warm } ]
        ]
    ]
