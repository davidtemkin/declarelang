/*
# The Declare homepage

The page you are reading, written in Declare. The design tokens live once as
semantic type components, and the page is a vertical **flow** of auto-sizing
sections — no absolute-y. Each section's height falls out of its content, so
the page stacks and re-flows on its own at any width. The full-bleed chrome —
the blueprint grid, the sticky header, the pointer dot — sits absolutely
around the centered column.

`{ }` bodies are TypeScript, so colors there are `0x…`; `[ ]` literal slots
take `#…`. Every color on the page has a name in the App's `theme` record —
the palette lives there, once, and nowhere else.
*/

font Sans [ family = "system-ui" ]

font Mono [ family = "ui-monospace" ]

/*
## The figures under an app card

`stats.json` is generated by the prewarm pass from the real production builds
(line metrics + the gzipped wire size), so these helpers are the only place the
page decides how to *say* a figure — never what it is. A missing value yields
"", so a card that outruns the stats file degrades to no figures rather than to
"undefined".

Each figure arrives as its OWN argument, because a helper's arguments are its
reactive wiring. Hand it the whole record instead and the reads happen inside
the body, where the dependency extractor cannot see them — the compiler refuses
that (DECLARE7001), and it is right to: the line would render once against an
unloaded DataSource and never update again.
*/

script {
    function hpLines(total: object, code: object, comment: object): string {
        if (total == null) return ""
        return total + " lines — " + code + " code, " + comment + " comment"
        }

    function hpWire(wire: object): string {
        return wire == null ? "" : " · " + Math.round((wire as any) / 1024) + " KB over the wire"
        }
    }

/*
## Type as tokens

Every text style on the page is one of these classes — headings semibold with
tracking that scales with the size, eyebrows mono and wide-tracked, lead and
body in the muted tone — so the page's whole typography reskins from here.
*/

class Heading extends Text [ fontWeight = semibold, textColor = { theme.text },
    letterSpacing = { -0.02 * fontSize }, selectable = true
    ]


class Eyebrow extends Text [ fontFamily = [Mono, "monospace"], fontSize = 13,
    fontWeight = semibold, letterSpacing = 1.6, textColor = { theme.muted }, selectable = true
    ]


// the accent section number

class Marker extends Eyebrow [ textColor = { theme.accent } ]

// footer text in the Declare typeface (App Sans), not the mono eyebrow

class FootLabel extends Text [ fontSize = 13, fontWeight = semibold, textColor = { theme.muted }, selectable = true ]

class Lead extends Text [ fontSize = 19, fontWeight = normal, textColor = { theme.lead }, selectable = true ]

class Body extends Text [ fontSize = 17, fontWeight = normal, textColor = { theme.muted }, selectable = true ]

// an article paragraph (the "Why" view) — HTML flow, so its `"""` source wraps
// at the writer’s margin and the line breaks collapse away in the rendering

class Para extends HTMLText [ fontSize = 18, lineHeight = 1.2, width = { parent.width },
    bodyColor = { theme.lead }, selectable = true
    ]


/*
## The header pills

A nav link is a padded pill: it fills with surface-2 on hover (a rounded rect
behind the text, not just a color change), and `pressed` deepens the pill and
lights the label — the tap feedback a touch device gets in place of hover.
Width auto-fits the label plus 12px of padding each side.
*/

class NavLink extends View [ height = 33, cornerRadius = 8,
    label:   string = "",

    // a pill WITH children opens the dropdown instead of following a link —
    // the wide rendition of the sheet's group rows. The anchor is snapshotted
    // at the gesture (rootOrigin, converted to viewport space), the sanctioned
    // overlay pattern (Menu.openAt).

    menu:    boolean = false,
    onClick() {
        if (!this.menu) return
        const o = this.rootOrigin()
        app.appsX = o.x - app.scrollX
        app.appsY = o.y - app.scrollY + this.height + 6
        app.appsOpen = !app.appsOpen
        },

    // ONE reference (location.md §0.3) where three fields and an if-chain
    // stood: "#why" is a destination, "#apps" a bare anchor (the runtime
    // derives its location and reveals it), a URL leaves the app. The follow,
    // the real <a> (hover preview, ⌘-click, copy-link), the keyboard stop,
    // and the crawler's edge all come from the `link` the use site sets.

    // pressed deepens the pill + lights the label — the tap feedback a touch
    // device gets in place of hover (mouseDown/Up fire on a tap, hover does not).

    fill = { pressed ? theme.pillPress : hovered ? theme.pillHover : null },
    lbl: Text [ x = 12, y = 8, fontFamily = [Sans, "system-ui", "sans-serif"], fontSize = 14,
        text = { classroot.label },
        textColor = { classroot.hovered || classroot.pressed ? theme.text : theme.muted } ],
    width = { this.lbl.width + 24 }
    ]


/*
## The mobile nav sheet

At phone width the pill row would ride the wordmark, so it collapses to a kebab
(the page's dot motif) that opens this sheet: a thumb-height row per destination,
drawn from the same `navItems` as the pills. Same press feedback as a pill.

The sheet is the one surface that can afford STRUCTURE. The pill row is bounded
by the window's width, so a destination with children shows there as a single
pill; the sheet is already open by the time it is read and vertical space is
free, so the children get their own rows under the parent — no second tap to
reach the thing you came for. One `navItems` list, two renditions, which is
what these two surfaces already were.
*/

class MobileNavRow extends View [ width = { parent.width }, height = 44, cornerRadius = 8,
    label:   string = "",

    // a child row: same type size and the same thumb height as its parent —
    // these are destinations, not annotations, and shrinking them would say
    // otherwise. The INDENT alone carries the hierarchy, with the quieter
    // tone behind it.

    sub:     boolean = false,

    fill = { pressed ? theme.pillPress : hovered ? theme.pillHover : null },

    // the coexistence rule (location.md §0.4): the handler runs — closing the
    // sheet — then the follow. Navigation itself is the `link`.

    onClick()     { app.menuOpen = false; app.appsOpen = false },

    lbl: Text [ x = { classroot.sub ? 30 : 14 }, y = center, fontFamily = [Sans, "system-ui", "sans-serif"],
        fontSize = 16, fontWeight = medium,
        text = { classroot.label },
        textColor = { classroot.hovered || classroot.pressed ? theme.text : classroot.sub ? theme.muted : theme.lead } ]
    ]


// one navItems entry as it appears in the sheet: its own row, then a row per
// child. `:children[]` on an entry whose list is empty resolves to no records,
// so a childless destination is simply its own row — there is no branch here
// and no second rendition to keep in step.

class MobileNavGroup extends View [ width = { parent.width },
    height = { this.contentHeight },
    layout: SimpleLayout [ axis = y, spacing = 0 ],
    MobileNavRow [ label = { :label }, link = { :link } ],
    kids: View [ width = { parent.width }, height = { this.contentHeight },
        layout: SimpleLayout [ axis = y, spacing = 0 ],
        MobileNavRow [ datapath = :children[], sub = true, label = { :label }, link = { :link } ]
        ]
    ]


/*
## Section furniture

The repeated shapes the numbered sections are built from: an `AppCard` (§01 —
a shot of a real application over its one-line description), a `FeatureRow`
for the closing enumeration, a `Point` with its accent top-rule, a big
gradient `Metric`, and the footer’s separator `Dot`.
*/

/*
### A screenshot frame

A clipped, rounded plate holding one app’s picture. Its height derives from its
OWN width at the shots’ 1.6 aspect, so whatever sizes it — a responsive share,
a layout, a card — gets the right box with no second number to keep in sync.
Clicking runs the app; the stroke lifts to the accent rule on hover so the
plate reads as a door rather than a picture.
*/

class Shot extends View [
    src: string = "",
    url: string = "",

    // An optional MOVING version. `clip` is taken — it is View's own attribute —
    // so the moving source is `motion`, and the still becomes its poster:
    // `pic` shows until the clip has a frame, which is the composition a
    // `poster` attribute would have hard-coded. `live` gates playback, so a
    // clip below the fold is not decoding while nobody is looking.

    motion: string = "",
    live: boolean = true,

    // an outside hover — the card's own title — lights the plate too, so the
    // picture and the words behave as the single target they are

    hot: boolean = false,

    cornerRadius = 12, clip = true, fill = { theme.stage },
    height = { this.width / 1.6 },

    // A GLOW, not a drop shadow. On a near-black ground a black shadow has
    // nothing to darken — it reads as almost nothing. A light halo does the
    // same job in the other direction: zero offset so it sits evenly around the
    // plate, and a low alpha so it separates the shot from the page without
    // announcing itself. The 1px stroke is still the crisp edge; this is the
    // separation behind it.

    stroke = { stroke(1, hovered || hot ? theme.pointRule : theme.line) },

    // colours here are RRGGBBAA (the theme's own spelling — `scrim` is
    // 0x0B141BB3), so the alpha is the LOW byte: a cool off-white at 0x1C
    // resting, 0x33 when the card is hot.

    shadow = { shadow(0, 0, 26, hovered || hot ? 0xBFD8EA8C : 0xBFD8EA4D) },

    onClick() { if (classroot.url != "") app.navigate(classroot.url) },

    pic: Image [ width = { parent.width }, height = { parent.height },
        stretches = both, source = { classroot.src },
        visible = { classroot.motion == "" || !this.parent.reel.loaded } ],

    reel: Video [ visible = { classroot.motion != "" },
        width = { parent.width }, height = { parent.height }, stretches = both,
        loop = true, source = { classroot.motion },
        playing = { classroot.live && classroot.motion != "" } ]
    ]


/*
### A small navigating link

The page’s quiet link rendition — the accent, brightening on hover and flashing
at the press, the same direction every other text link here answers a tap. Not
selectable: it is a control, not copy.
*/

class SmallLink extends Text [ fontFamily = [Sans, "system-ui", "sans-serif"],
    fontSize = 14, fontWeight = medium, wrap = false, selectable = false,
    url: string = "",
    textColor = { pressed ? theme.linkPress : hovered ? theme.linkHover : theme.accent },
    onClick() { app.navigate(classroot.url) }
    ]


/*
### A compact figure

`Metric`’s narrow-column sibling. Metric sizes for a full-width band and goes
full-width below 560, which is right there and wrong inside a half-column: three
of them would stack into a tower. This one stays three-up in the space it is
given.
*/

class MiniMetric extends View [
    value: string = "",
    note:  string = "",
    width = { (parent.width - 40) / 3 },
    layout: SimpleLayout [ axis = y, spacing = 4 ],
    Heading [ fontSize = 34, width = { parent.width }, textFill = { theme.brand },
        text = { classroot.value } ],
    Body [ fontSize = 12, width = { parent.width }, text = { classroot.note } ]
    ]


/*
### The sequence badge

The three applications are the page’s one enumerated set, and the layout around
them is busy enough that the set reads as three unrelated rows. A number pins
each title to the sequence: the ordinal AT THE TITLE’S OWN SIZE — a `Heading`,
so font, weight and tracking are the title’s exactly, and the baselines match
by construction (same metrics, boxes top-aligned in the same row) — in the
page’s ink on a white disc. White, not accent: the discs must read as counters
against the noise, not as three more accent-colored controls.
*/

class AppNum extends View [ width = 30,
    n: string = "",
    url: string = "",

    // the row's hover fact, bound in by the use site — the disc answers the
    // SAME state the title answers, so the pair lights as one target

    hot: boolean = false,
    visible = { n != "" },
    onClick() { if (classroot.url != "") app.navigate(classroot.url) },

    // BASELINE BY CONSTRUCTION, because there is no metrics read to do it by
    // arithmetic: the numeral is a `Heading` at the title's own size, so it
    // shares the title's font, weight and tracking exactly — and this box's
    // height IS the numeral's line box, top-aligned in the head row beside the
    // title's. Same metrics, same box top, same baseline, no font constants.

    height = { this.num.height },

    // the disc paints first (under the digit): white at rest, the accent while
    // the row is hot or the badge itself is pressed — the title's own change,
    // answered in fill rather than ink. The NUMERAL stays ink in every state:
    // ink-on-accent is already the page's text-on-accent pairing (Button).
    // Centered on the line box — a disc has no baseline of its own, so the box
    // center is the honest anchor.

    disc: View [ width = 30, height = 30, cornerRadius = 15,
        fill = { classroot.hot || classroot.pressed ? theme.accent : theme.badge },
        y = { (parent.height - this.height) / 2 } ],
    num: Heading [ fontSize = 22, wrap = false, selectable = false, textColor = { theme.ink },
        x = { (parent.width - this.width) / 2 },
        text = { classroot.n } ]
    ]


/*
### An application card

The tracker and the desktop: a screenshot over the app’s name, what it does as
one dot-separated run, its figures small and dim, and a source link. The plate
and the name run the app; the source link opens the reader — and because events
do not bubble, that link answers its own click without the card also firing.
*/

class AppCard extends View [
    title:   string = "",
    num:     string = "",
    shot:    string = "",
    blurb:   string = "",
    figures: string = "",
    url:     string = "",
    srcUrl:  string = "",
    layout: SimpleLayout [ axis = y, spacing = 16 ],

    // TWO hover facts, not one. `titleHot` is the words; `hot` is the words or
    // the plate. The plate reads `titleHot` and the words read `hot`, so a
    // pointer anywhere on either lights BOTH — and there is no cycle, because
    // each derives from the raw `hovered` of the other, never from its styling.

    titleHot: boolean = { this.head.seq.hovered || this.head.name.hovered || this.head.arrow.hovered },
    hot: boolean = { this.frame.hovered || this.titleHot },

    // the name LEADS: you read what the thing is, then look at it. The plate
    // under a title also gives the row a left edge to hang from, which three
    // pictures of different interiors do not.

    head: View [ width = { parent.width }, height = { this.contentHeight },
        layout: SimpleLayout [ axis = x, spacing = 10 ],

        seq: AppNum [ n = { classroot.num }, hot = { classroot.hot }, url = { classroot.url } ],
        name: Heading [ fontSize = 22, wrap = false, selectable = false,
            textColor = { classroot.hot ? theme.accent : theme.text },
            text = { classroot.title },
            onClick() { app.navigate(classroot.url) }
            ],
        arrow: Text [ y = 3, fontSize = 16, fontWeight = semibold, wrap = false,
            textColor = { classroot.hot ? theme.accent : theme.dim }, text = "→",
            onClick() { app.navigate(classroot.url) }
            ]
        ],

    frame: Shot [ width = { parent.width }, src = { classroot.shot }, url = { classroot.url },
        hot = { classroot.titleHot } ],

    copy: View [ width = { parent.width },
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        say: Body [ fontSize = 15, width = { parent.width }, text = { classroot.blurb } ],
        fig: Body [ fontSize = 13, width = { parent.width }, textColor = { theme.dim },
            text = { classroot.figures } ],
        src: SmallLink [ text = "View & edit source →", url = { classroot.srcUrl } ]
        ]
    ]


/*
### A feature row

One block of the closing enumeration: the category, then its points beneath.
Two levels of replication and no list-building code — the block comes from a
slice of `:rows[]`, each point from `:items[]` inside it, so the section's
shape is written once and the data decides how many there are.

The points are PHRASES, not sentences: a run of prose here reads as a
document, and this has to read as a layout. The blocks pair into two columns
at the section level (below), which is also what keeps a label from stranding
across a wide gutter from the points it names.
*/

class FeatureRow extends View [ width = { parent.width },
    layout: SimpleLayout [ axis = y, spacing = 8 ],

    cap: Heading [ fontSize = 15, width = { parent.width }, selectable = true,
        text = { "" + :cap } ],

    list: View [ width = { parent.width },
        layout: SimpleLayout [ axis = y, spacing = 7 ],
        Body [ datapath = :items[], fontSize = 15, width = { parent.width },
            text = { "" + this.$data("") } ]
        ]
    ]


class Point extends View [ width = { Math.min(357, parent.width) },
    ptitle: string = "",
    body:   string = "",
    layout: SimpleLayout [ axis = y, spacing = 16 ],
    rule: View [ width = { parent.width }, height = 2, fill = { theme.pointRule } ],
    txt: View [ width = { parent.width },
        layout: SimpleLayout [ axis = y, spacing = 8 ],
        Heading [ fontSize = 17, text = { classroot.ptitle } ],
        Body    [ fontSize = 15, width = { parent.width }, text = { classroot.body } ]
        ]
    ]


// width/fontSize key off parent.width (the real available width in the row) —
// a component sizes off its parent, not the app; `app.width` is the whole page

class Metric extends View [
    cols: number = 2,
    width = { parent.width < 560 ? parent.width : (parent.width - 48 * (cols - 1)) / cols },
    value: string = "",
    note:  string = "",
    layout: SimpleLayout [ axis = y, spacing = 8 ],
    Heading [ fontSize = { parent.width < 420 ? 54 : 92 }, width = { parent.width }, textAlign = center,
        textFill = { theme.brand }, text = { classroot.value } ],
    Body [ fontSize = 14, width = { parent.width }, textAlign = center, text = { classroot.note } ]
    ]


class Dot extends Body [ fontSize = 14, textColor = { theme.faint }, text = "·" ]

/*
## Buttons

Primary fills accent and brightens on hover; secondary lifts to surface-2 and
answers a press with an accent ring. Press feedback is what a touch device
sees in place of hover — both are driven by the view’s own handlers.
*/

class Button extends View [ height = 46, cornerRadius = 9,
    label:   string = "",
    primary: boolean = true,
    fill = { primary ? (pressed ? theme.accentPress : hovered ? theme.accentHover : theme.accent)
                     : (pressed ? theme.press       : hovered ? theme.hover       : theme.surface) },
    stroke = { primary ? stroke(0, theme.accent) : stroke(1, pressed ? theme.accentSecondary : theme.line) },

    // label centered in the button box (textAlign over the full width)

    caption: Text [ y = 14, width = { parent.width }, textAlign = center, fontSize = 15, fontWeight = semibold,
        text = { classroot.label },
        textColor = { classroot.primary ? theme.ink : theme.text } ]
    ]


/*
## The site footer

One line, shared by every page of the site — the scrolling front page and the
in-app Why / Language views alike: provenance left, legal right.

A `FootLink` is the footer’s link rendition: the eyebrow treatment with the
teal hover and the brighter pressed tap feedback, navigating on click.
*/

class FootLink extends FootLabel [
    to: string = "",

    // A navigating link is a control, not copy — FootLabel's `selectable`
    // is for the static footer text and must not ride along here.

    selectable = false,
    textColor = { pressed ? theme.accentSecondaryPress : hovered ? theme.accentSecondary : theme.muted },
    onClick()     { app.navigate(to) }
    ]


// the footer separator: a faint dot that drops out once the row wraps, so no dot
// is ever stranded at a line's end (the 620 line is where the row stops fitting)

class FootSep extends FootLabel [ text = "·", textColor = { theme.faint }, visible = { parent.width >= 620 } ]

class Footer extends View [ width = { parent.width },
    // its own bottom margin — the page has no trailing spacer, because the
    // flow's section spacing applied to that too and left a large dead band

    height = { this.contentHeight + 36 },
    layout: SimpleLayout [ axis = y, spacing = 16 ],

    // one centered flow — every item on a line, dot-separated at full width. As
    // the width narrows the separator dots drop out and the items wrap to centered
    // rows (the wider spacing keeps them legible), so provenance and legal never
    // collide the way a left/right split does. Dropping the dots on wrap is what
    // avoids a stranded separator at a line's end.

    row: View [ width = { parent.width }, height = { this.contentHeight },
        layout: WrappingLayout [ align = center, spacing = { parent.width >= 620 ? 10 : 18 }, lineSpacing = 10 ],

        // "Built in Declare" is one text RUN (HTMLText carries the brand accent
        // inline), so it keeps a word space, not a gap

        built: HTMLText [ width = 108, fontSize = 13, fontWeight = semibold, bodyColor = { theme.muted },
            accents = { ({ g: theme.brand }) },
            html = "Built in <span class='g'>Declare</span>" ],
        FootSep [ ],
        FootLink [ to = "apps/homepage/homepage.declare?viewer", text = "View Source" ],
        FootSep [ ],
        FootLink [ to = "apps/docs/docs.declare", text = "Docs" ],
        FootSep [ ],
        FootLink [ to = "https://github.com/davidtemkin/declarelang", text = "GitHub" ],
        FootSep [ ],
        lic: FootLink [ to = "https://github.com/davidtemkin/declarelang/blob/main/LICENSE", text = "MIT License" ],
        FootSep [ ],
        FootLabel [ text = "© 2026 David Temkin" ]
        ]
    ]


/*
## The live panels

The heart of the page: every demo is real Declare, compiled and running. A
`CodeField` is a native editable field seeded (uncontrolled, `initial`) from
the demo’s source — it follows the source until you type, then holds the
edit, publishing each keystroke on `App.liveSource` for the host to
recompile. A `SourcePanel` frames it (LIVE·EDITABLE chip, Revert, hairline);
a `PreviewFrame` hosts the compiled app as an **embedded child app** — no
iframe — so the preview can’t drift from the source. Its `active` flag gates
the island slot, which is what bounds the full-page-editor recursion: a
closed editor’s preview renders nothing, so the page source containing that
very editor only descends one level per user click.
*/

class CodeField extends TextInput [ multiline = true, spellcheck = false,
    fontFamily = [Mono, "monospace"], fontSize = 11, textColor = { theme.lead },
    editName: string = "",
    src: string = "",
    initial = { src },
    onInput() { app.liveCard = editName; app.liveSource = text }
    ]


// Neither the field nor the panel carries a height: a field with none sizes to
// its text, and the panel sizes to the field. So the code is never a scrolling
// listing — it re-fits as the column re-flows, and as you type in it. The
// preview beside it takes the same height. Revert restores the pristine `src`
// and asks the host to recompile.

class SourcePanel extends View [
    editName: string = "",
    src: string = "",
    fill = { theme.panel }, cornerRadius = 12, stroke = { stroke(1, theme.panelLine) },

    // the panel is its field, plus the chip row above it and a margin below

    height = { this.field.y + this.field.height + 8 },

    // the affordance chip: this code runs, and you can type in it

    live: View [ x = 12, y = 7, height = 18, cornerRadius = 5, fill = { theme.accent },
        width = { this.t.width + 14 },
        t: Text [ x = 7, y = 4, fontFamily = [Sans, "system-ui"], fontSize = 9, fontWeight = bold,
            letterSpacing = 0.8, wrap = false, textColor = { theme.ink }, text = "LIVE · EDITABLE" ]
        ],
    revert: View [ y = 5, height = 20, cornerRadius = 6, stroke = { stroke(1, theme.revertLine) },
        x = { parent.width - this.width - 10 },
        width = { this.rlbl.width + 16 },
        fill = { hovered ? theme.hover : null },
        onClick() { classroot.field.text = classroot.src
                    app.liveCard = classroot.editName
                    app.liveSource = classroot.src },
        rlbl: Text [ x = 8, y = 3, fontFamily = [Sans, "system-ui"], fontSize = 11, fontWeight = semibold,
            textColor = { parent.hovered ? theme.text : theme.lead }, text = "Revert" ]
        ],
    hairline: View [ y = 31, width = { parent.width }, height = 1, fill = { theme.panelLine } ],
    field: CodeField [ x = 12, y = 40, width = { parent.width - 24 },
        editName = { classroot.editName }, src = { classroot.src } ],

    // the compile report, at the panel — a broken edit shows its error right here
    // (the last good preview keeps running beside it); host feeds app.liveReport

    err: View [ width = { parent.width }, fill = { theme.errBg },
        visible = { app.liveCard == classroot.editName && app.liveReport != "" },
        y = { parent.height - this.height },
        height = { this.msg.height + 16 },
        bar: View [ x = 0, y = 0, width = 3, height = { parent.height }, fill = { theme.errBar } ],
        msg: Text [ x = 14, y = 8, width = { parent.width - 28 }, wrap = true,
            fontFamily = [Mono, "monospace"], fontSize = 11, textColor = { theme.errText },
            text = { app.liveReport } ]
        ]
    ]


class PreviewFrame extends View [
    runName: string = "",
    active: boolean = true,
    run: AppIsland [ width = { parent.width }, height = { parent.height },
        program = { classroot.active ? classroot.runName : "" } ]
    ]


/*
## Backdrop and section heads

The blueprint grid draws itself; a `SectionHead` is the tight
number · heading · lead rhythm every numbered section opens with.
*/

/*
The blueprint backdrop is VIEWPORT-sized and pinned, never document-sized.

`draw()` rasterises into a canvas the size of the view's bounds at device pixel
ratio, so a backdrop stretched over a whole document allocates a backing store
for the whole document: the language view is 16,711px tall, which at 2x is a
2882 x 33,422 canvas — 96 megapixels, ~385 MB, reallocated every time the view
is shown or hidden. Measured: 1091 ms blocked going in, 1435 ms coming back.
Viewport-sized and pinned: 57 ms and 21 ms. (It also cleared Chrome's 32,767px
maximum canvas dimension, which the old shape exceeded.)

A uniform 32px lattice looks the same pinned as it does scrolling, so this
costs nothing visually — it is the same paper, drawn once.
*/

class GridBg extends View [
    draw(d: Draw) {
        d.fillStyle = theme.grid
        for (let gx = 0; gx <= width;  gx += 32) d.fillRect(gx, 0, 1, height)
        for (let gy = 0; gy <= height; gy += 32) d.fillRect(0, gy, width, 1)
        }
    ]


class SectionHead extends View [ width = { parent.width },
    num:  string = "",
    head: string = "",
    lead: string = "",
    layout: SimpleLayout [ axis = y, spacing = 14 ],
    Marker  [ text = { classroot.num } ],
    Heading [ fontSize = 40, width = { Math.min(900, parent.width) }, text = { classroot.head } ],
    Lead    [ width = { Math.min(760, parent.width) }, text = { classroot.lead } ]
    ]


/*
## The page

The palette lives once as a prevailing `theme` token record — every semantic
type class defaults its color to `{ theme.… }`, so the whole page reskins
from this one place. The scroller fills the viewport and scrolls its taller
content natively; the chrome further down (header, cursor) are its
**siblings**, not its children, so they never move.
*/

// THE HEADLINE LIVES HERE, ONCE. The hero reads it, and `appName` carries it
// into `document.title` at boot (runtime/src/boot.ts — "the ONE place that
// mapping lives"), which is also what the crawl extraction reports as the
// page's title and what the bake stamps into index.html's <title> and social
// cards. Before this, index.html restated the headline by hand in six places;
// changing the hero left all six behind, and the drift was invisible to a
// visitor — the runtime overwrites document.title at boot — so only crawlers
// and LLMs ever read the stale copy. Exactly the readers this page is for.

App [ tagline: string = "a UI language for you and your AI",
    edges = cover,
    revealInset = 80,
    appName = { "Declare — " + app.tagline },
    theme = { {
        // text, brightest to faintest
        text: 0xE7EEF2, lead: 0x9DB0BC, muted: 0x8A9BA6, dim: 0x6A7C89, faint: 0x556673,
        // the blue accent and its interaction shades; links brighten past accent
        // (hover), then flash brighter still at the press — the same direction
        // FootLink's teal takes, so every text link answers a tap the same way
        accent: 0x4C8DFF, accentHover: 0x63A0FF, accentPress: 0x3D7BE0, linkHover: 0x7FB0FF, linkPress: 0xB2CFFF,
        // the teal second accent; the brand gradient runs accent → accentSecondary
        accentSecondary: 0x37E0C8, accentSecondaryPress: 0x9BF2E4,
        brand: gradient("90deg", 0x4C8DFF, 0x37E0C8),
        // the sequence badges' disc — true white, not the off-white text tone:
        // a solid counter can take full white where text-on-dark cannot
        badge: 0xFFFFFF,
        // grounds, darkest to lightest, and their interaction shades
        ink: 0x0B141B, panel: 0x0C1620, press: 0x0C1922, surfaceDeep: 0x0D1922,
        surface: 0x101E28, hover: 0x162A36, pillHover: 0x1C2D39, pillPress: 0x24384A,
        // rules and strokes
        line: 0x263D4C, panelLine: 0x1E313C, revertLine: 0x26414F, pointRule: 0x345B84,
        grid: 0x172A38,
        // the error strip, the demo stage, and the overlay grounds
        errBg: 0x2A1518, errBar: 0xE0525E, errText: 0xF2A0A6,
        stage: 0x151A22, scrim: 0x0B141BB3, shade: 0x00000066 } },
    fill = { theme.ink },
    fontFamily = [Sans, "system-ui", "sans-serif"], fontSize = 17, fontWeight = normal,
    textColor = { theme.text },

    // in-app location: "home" (the scrolling page), "why" (the mini-article),
    // "language" (the one-file core doc, rendered in-app), or "getstarted" (the
    // quick-start guide, rendered the same way) — the app’s slice of the
    // URL (docs/system-design/location.md). `location` is a BUILT-IN App attribute;
    // setting it here declares the INITIAL, which is the default: the host shows a
    // clean URL at "home" and `#why`/`#language` elsewhere, seeds it from a deep
    // link before first paint, and walks it on back/forward — no hash wiring in app
    // code. Every `visible` below derives from it; the header pills write it.

    location = "home",

    // return the page to the top — the page is the app's scroller, so a
    // destination change must not inherit the previous view's scroll offset.
    // (Every location write below pairs with this; the write stays a LITERAL
    // assignment so the static crawl keeps discovering the destinations.)

    toTop() { this.scrollIntoView("start") },

    /* No link-routing code. Every href in the rendered Markdown below — the
       FAQ's, the guide's, the language doc's — routes through the runtime's
       own default: a "#name" follows in-app (destination or anchor alike,
       measured-reveal and all), anything else leaves through `navigate`
       (location.md §0.5). The openLink method and the three onLink handlers
       that stood here are the code this design exists to delete. */
    // the page’s textual material, fetched DIRECTLY as text (format = "text"):
    // the core doc itself (docs/declare.md — up the tree, but still the
    // deployed repo’s own material), the getting-started guide, and the FAQ.
    // The authored .md files carry assembler markers as HTML comments, which
    // Markdown drops — so there is no JSON-wrap projection beside this file,
    // and a drifted copy is impossible because there is no copy. stats.json
    // stays JSON (line metrics computed by the prewarm pass, so the figures
    // below can never go stale).

    lang: DataSource [ url = "../../docs/declare.md", format = "text" ],
    stats: DataSource [ url = "stats.json" ],
    guide: DataSource [ url = "getstarted.md", format = "text" ],
    faq: DataSource [ url = "declare-faq.md", format = "text" ],
    onInit() { this.lang.fetch(); this.stats.fetch(); this.guide.fetch(); this.faq.fetch() },

    // `liveCard`/`liveSource` name the demo an inline editor is republishing
    // and its current text — the host recompiles that pair live. (A whole-page
    // editor once lived here; nothing ever set its `editing` flag, so it was
    // unreachable — `?viewer=edit` is the live path, and it is gone.)

    liveCard: string = "",
    liveSource: string = "",

    // the site nav — ONE list of destinations, shared by the header pills (wide)
    // and the mobile sheet (narrow), so a link added here appears in both and the
    // two can never drift. `to` is an in-app location (a fragment), `url` an
    // out-of-app target (the `navigate` service action) — each item uses one.
    // `navData` is the datapath wrapper both surfaces replicate from; `menuOpen`
    // is the sheet's toggle.

    // The three applications ride under one `Apps` entry. Standing alone in a
    // nav row, "Calendar", "Desktop" and "Tracker" name nothing a first-time
    // reader can act on — and beside a GitHub link two of them read as
    // something else entirely (a desktop build; an issue tracker). The parent
    // supplies the category the labels can't, and lands on §01, which is the
    // page that actually answers what they are: three shots, each with its
    // line count and wire size. The children keep their direct doors in the
    // sheet, where there is room for both.

    navItems: array = { [
        ({ label: "Getting Started", link: "#getstarted", children: [] }),
        ({ label: "Why Declare",     link: "#why",        children: [] }),
        ({ label: "FAQ",             link: "#faq",        children: [] }),
        // "#apps" is a BARE ANCHOR (§01's section carries `anchor = "apps"`):
        // the runtime derives its destination and lands on it — no section
        // machinery here, and the reference survives the section moving.
        ({ label: "Apps", link: "#apps", children: [
            ({ label: "Calendar", link: "apps/calendar/calendar.declare", children: [] }),
            ({ label: "Desktop",  link: "apps/desktop/desktop.declare",  children: [] }),
            ({ label: "Tracker",  link: "apps/tracker/tracker.declare",  children: [] }),
            ({ label: "Weather",  link: "apps/weather/weather.declare",  children: [] }),
            ({ label: "Birds",    link: "apps/birds/birds.declare",      children: [] }),
            ] }),
        ({ label: "Docs",     link: "apps/docs/docs.declare", children: [] }),
        // last, and the only item that leaves the site — an off-site link placed
        // mid-row would split the applications from the Docs they belong beside
        ({ label: "GitHub",   link: "https://github.com/davidtemkin/declarelang", children: [] }),
        ] },

    // the closing enumeration's content, as DATA — so the section is a shape
    // written once rather than six hand-built rows. A Dataset's literal body
    // is strict JSON (language §7), which is why the quoting is fussy here.
    //
    // Only what is NEW at this point in the scroll: the demos above already
    // showed constraints, replication, and springs, and the pull quote made
    // the type-checking argument — so those lines don't repeat here. Two
    // honest limits ride in the list on purpose (accessibility depth; the
    // Mac host not yet being a desktop-app platform).

    features: Dataset {
        {
                "rows": [
                        {
                                "cap": "Still a web page",
                                "items": [
                                        "Find-in-page, real selection, native fields",
                                        "Back button, deep links",
                                        "Real HTML for crawlers — no server, no hydration",
                                        "Embeds in any page — React included",
                                        "Accessibility past native text and fields — a known gap"
                                ]
                        },
                        {
                                "cap": "Data",
                                "items": [
                                        "Load JSON, bind to it — edits write back",
                                        "SSE and WebSocket streams",
                                        "A million rows — virtualize on one word"
                                ]
                        },
                        {
                                "cap": "Touch",
                                "items": [
                                        "The browser keeps every gesture you don't claim",
                                        "A card that drags still pinch-zooms",
                                        "No stuck hovers, no ghost clicks"
                                ]
                        },
                        {
                                "cap": "One program, four hosts",
                                "items": [
                                        "Browser — DOM",
                                        "Browser — canvas, verified pixel-for-pixel",
                                        "Mac native, browser-free — full desktop integration still to come",
                                        "Headless — where the crawls and tests run"
                                ]
                        },
                        {
                                "cap": "What ships",
                                "items": [
                                        "Buttons to data grids — a library written in Declare",
                                        "Markdown and rich text built in",
                                        "Themes, swappable live — no CSS, no cascade"
                                ]
                        },
                        {
                                "cap": "For you and your AI",
                                "items": [
                                        "The whole language in one file — ~10k tokens",
                                        "Diagnostics that name the rewrite",
                                        "Ask any value where it came from",
                                        "An installable agent skill, with evals behind it"
                                ]
                        }
                ]
        }
        },

    navSource: Dataset [ contents = { ({ items: app.navItems }) } ],
    menuOpen: boolean = false,

    // the Apps dropdown (wide rendition): open state + the gesture-time anchor,
    // and its rows DERIVED from the one navItems list (no second list to drift)

    appsOpen: boolean = false,
    appsX: number = 0,
    appsY: number = 0,
    appsSource: Dataset [ contents = { ({ items: (app.navItems.find((i) => i.label == "Apps") || ({ children: [] })).children }) } ],

    // the content measure and the centering gutter — the one geometry every
    // aligned edge on the page (column, wordmark, nav) derives from

    measure: number = 1120,
    gutter: number = { Math.max(24, (app.width - app.measure) / 2) },
    heroFont: number = { app.width < 700 ? 44 : 60 },

    // the front page's content — carried by the PAGE's own scroll (the App
    // scrolls by default, and its scroller is the browser's): taller than the
    // window, so the document scrolls, with the full native gesture tier

    scroller: View [ width = { app.width }, shows = "home",

        // full-bleed blueprint behind the column, sized to the page's full
        // extent — its offset AND its height, so the paper runs to the very
        // bottom of the scroll range (the extent is page.y + page.height;
        // sizing to height alone left a 96px paperless band at the bottom).
        // Reading the page keeps this out of the page's own auto-extent, so
        // no cycle.

        grid: GridBg [ x = 0, width = { app.width },
            // Follows the scroll rather than spanning the document. `ignoreScroll`
            // would lift it out of paint order and composite it OVER the content;
            // as an ordinary child it stays behind. Snapped to the 32px lattice so
            // the paper is pixel-identical to the document-tall version — the same
            // lines in the same places — while only one viewport is ever rasterised.
            // CLAMPED to the content's own bottom. Unclamped, the backdrop's
            // bottom is scrollY + a viewport, which feeds the scroller's
            // auto-extent — so every trip to the bottom grew the page another
            // 32px and left dead space under the footer (measured: 5243 →
            // 5412 over six trips). Reading the content's extent is what the
            // document-tall version did too, and it is not a cycle: the
            // content never reads the backdrop.

            y = { Math.max(0, Math.min(Math.floor(app.scrollY / 32) * 32,
                    parent.page.y + parent.page.height - this.height)) },
            height = { app.height + 32 } ],

        // the centered content column: a fixed measure, and a VERTICAL FLOW of
        // sections — each auto-sizes, the page stacks them

        page: View [ width = { Math.min(app.measure, app.width - 48) },
            x = { app.gutter }, y = 96,
            layout: SimpleLayout [ axis = y, spacing = { parent.width < 660 ? 72 : 112 } ],

            /* ### Hero — the name, the claim, and the two doors in
               (GitHub, or edit this page’s own source) */

            hero: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 24 ],
                top: View [ width = { parent.width },
                    layout: SimpleLayout [ axis = y, spacing = 26 ],

                    // the title: product name in the blue→teal gradient, the claim on the
                    // next line. One rendition at every width — no wide/narrow split to keep in sync.

                    titleGroup: View [ width = { parent.width },
                        layout: SimpleLayout [ axis = y, spacing = 12 ],
                        headline: View [ width = { parent.width },
                            layout: SimpleLayout [ axis = y, spacing = 2 ],
                            Heading [ fontSize = { app.heroFont },
                                textFill = { theme.brand }, text = "Declare" ],
                            Heading [ fontSize = { app.heroFont }, width = { parent.width },
                                text = { "is " + app.tagline + "." } ]
                            ]
                        ],
                    paras: View [ width = { parent.width },
                        layout: SimpleLayout [ axis = y, spacing = 12 ],
                        HTMLText [ width = { Math.min(680, parent.width) }, fontSize = 19, lineHeight = 1.2, bodyColor = { theme.lead }, selectable = true,
                            accents = { ({ g: theme.brand }) },
                            html = "Just as SQL is a domain-specific language for database queries, <span class='g'>Declare</span> is a DSL for user interfaces. Its whole surface fits in your head — and inside an LLM’s context window." ],

                        // The page's most arresting fact, and the only claim on it a
                        // visitor can falsify in their own browser in three clicks —
                        // so it reads as a statement, not a caption under the one above.

                        Lead [ width = { Math.min(680, parent.width) }, fontWeight = semibold,
                            textColor = { theme.text },
                            text = "This page is written in it. By an LLM." ]
                        ]
                    ],

                // the two doors in, side by side with a quiet dot between

                learn: View [ width = { parent.width },
                    layout: ResponsiveLayout [ plan = { [({ from: 600, flow: "row", gap: 16 }), ({ from: 0, flow: "stack", gap: 8 })] } ],
                    why: Text [ fontFamily = [Sans, "system-ui", "sans-serif"], fontSize = 15, fontWeight = medium, wrap = false,
                        textColor = { this.pressed ? theme.linkPress : this.hovered ? theme.linkHover : theme.accent }, text = "Why a new language, now? →",
                        link = "#why" ],
                    Dot [ y = 1, visible = { parent.width >= 600 } ],
                    onefile: Text [ fontFamily = [Sans, "system-ui", "sans-serif"], fontSize = 15, fontWeight = medium, wrap = false,
                        textColor = { this.pressed ? theme.linkPress : this.hovered ? theme.linkHover : theme.accent }, text = "The whole language, in one file →",
                        link = "#language" ]
                    ]
                ],

            /* ### 01 — Three applications. The calendar leads at full width; the
               tracker and the desktop share the row beneath, and stack on a
               phone. Each numbered section fades in on a Spring the moment it
               scrolls into view — a reveal declared as a reactive target, not
               scheduled. Every figure below is read from `stats.json`, which the
               prewarm pass regenerates from the real production builds, so no
               number here can drift from the tree. */

            // `anchor = "apps"` — the §01 section IS the `#apps` reference's
            // target; App.revealInset clears the fixed header (the hand-placed
            // marker view this replaces was measured drift waiting to happen)

            apps: View [ anchor = "apps", width = { parent.width }, opacity = 0,
                reveal: Spring [ attribute = opacity, stiffness = 90, damping = 22, epsilon = 0.004,
                    to = { app.scrollY + app.height > parent.parent.y + parent.y + 90 ? 1 : 0 } ],

                // 72, not the page's usual 40: the three applications are three
                // separate things, and the calendar's own caption sits inside its
                // row — too little air here and the button reads as the tracker's

                layout: SimpleLayout [ axis = y, spacing = 72 ],

                SectionHead [ num = "01", head = "Three applications, written in Declare.",
                    lead = "Complete programs — open one, read it end to end, and edit it live in the browser you're using." ],

                /* The calendar takes its own row: the pitch on the LEFT where the
                   eye starts, the plate on the right at half the column — the same
                   size as the two beneath, so all three pictures agree. Below 860
                   the row stacks, and because the words come first in declaration
                   order the stack reads pitch-then-picture too.

                   `hot` is the row's one hover fact: the title lights the plate and
                   the plate lights the title, each derived from the other's raw
                   `hovered`, never from its styling — so they answer together with
                   no cycle. */

                cal: View [ width = { parent.width },
                    hot: boolean = { this.plate.hovered || this.tell.head.name.hovered || this.tell.head.seq.hovered },
                    layout: ResponsiveLayout [ plan = { [({ from: 860, flow: "row", gap: 40, share: ({ tell: 50, plate: 50 }) }),
                                                         ({ from: 0, flow: "stack", gap: 26, share: ({ tell: 100, plate: 100 }) })] } ],

                    tell: View [ layout: SimpleLayout [ axis = y, spacing = 18 ],

                        head: View [ width = { parent.width }, height = { this.contentHeight },
                            layout: SimpleLayout [ axis = x, spacing = 10 ],
                            seq: AppNum [ n = "1", url = "apps/calendar/calendar.declare",
                                hot = { this.parent.parent.parent.hot } ],
                            name: Heading [ fontSize = 22, wrap = false, selectable = false,
                                textColor = { this.parent.parent.parent.hot ? theme.accent : theme.text },
                                text = "Declare Calendar",
                                onClick() { app.navigate("apps/calendar/calendar.declare") }
                                ]
                            ],

                        Lead [ fontSize = 17, width = { parent.width },
                            text = "It’s the kind of experience you’ll see in the best native apps — a view doesn’t switch so much as become the next one, where motion carries meaning, and everything is fast and interruptible." ],

                        // The clip beside this shows a detail panel opening and an
                        // event being dragged to another day — operations, not
                        // motion. Nothing else in this column claimed that, so the
                        // strongest beat of the clip was going unnamed. It answers
                        // the doubt a video invites — is this the thing, or a
                        // recording of it — with what the drag actually commits.

                        Lead [ fontSize = 17, width = { parent.width },
                            text = "It runs on real data: open an event, drag it to another day, and it’s moved." ],

                        // computed, not claimed — stats.json, regenerated from the
                        // real production build on every prewarm

                        stat: View [ width = { parent.width }, height = { this.contentHeight },
                            layout: SimpleLayout [ axis = x, spacing = 20 ],

                            // CODE lines, and the note says so. The file is longer
                            // than this — open it and you count ~800 — so a bare
                            // "lines of Declare" reads as caught out rather than
                            // modest. Naming the comment lines is what makes the
                            // smaller number legible as the honest one. Each figure
                            // is its own read: a helper taking the record would put
                            // the reads inside a body the extractor cannot see.

                            MiniMetric [ value = { "" + (app.stats.read(["calendar", "code"]) ?? "—") },
                                note = { "lines of code, plus "
                                    + (app.stats.read(["calendar", "comment"]) ?? "—")
                                    + " of comments — four views, zoom, drag and edit" } ],
                            MiniMetric [ value = { app.stats.read(["calendar", "wireGzip"]) ? Math.round(app.stats.read(["calendar", "wireGzip"]) / 1024) + " KB" : "—" },
                                note = "over the wire, gzipped — app and runtime" ],
                            MiniMetric [ value = "0",
                                note = "lines written by hand — an LLM wrote it" ]
                            ],

                        actions: View [ width = { parent.width },
                            layout: ResponsiveLayout [ plan = { [({ from: 420, flow: "row", gap: 18 }), ({ from: 0, flow: "stack", gap: 14 })] } ],
                            Button [ width = 240, label = "Run Declare Calendar →",
                                onClick() { app.navigate("apps/calendar/calendar.declare") }
                                ],
                            SmallLink [ y = 15, text = "View & edit source →",
                                url = "apps/calendar/calendar.declare?viewer" ]
                            ]
                        ],

                    // the one claim a still cannot make: four views that BECOME each
                    // other. It runs once the section has revealed — `parent.parent`
                    // is the apps band, whose opacity is that reveal — so a visitor
                    // who never scrolls here never decodes a frame.

                    plate: Shot [ src = "shots/calendar.webp", url = "apps/calendar/calendar.declare",
                        // Its last frame IS its first, so the loop has no seam to
                        // notice. What it shows is the app being USED — a detail
                        // panel opening on a real record, an event dragged to
                        // another day — not a view transforming for its own sake.
                        // shots/video/ holds the clip and the script that cuts it

                        motion = "shots/video/calendar.mp4",
                        live = { parent.parent.opacity > 0.9 },
                        hot = { this.parent.tell.head.name.hovered } ]
                    ],

                // the pair, with a wider gutter than the calendar row's — two
                // whole applications side by side need more air between them than
                // a picture needs from its own caption

                pair: View [ width = { parent.width },
                    layout: ResponsiveLayout [ plan = { [({ from: 720, flow: "row", gap: 56, share: ({ trk: 50, dsk: 50 }) }),
                                                         ({ from: 0, flow: "stack", gap: 56, share: ({ trk: 100, dsk: 100 }) })] } ],

                    trk: AppCard [ title = "Declare Tracker", num = "2",
                        shot   = "shots/tracker.webp",
                        url    = "apps/tracker/tracker.declare",
                        srcUrl = "apps/tracker/tracker.declare?viewer",
                        blurb = "1,000,000 issues · search as you type · edit in place, with undo · not one line of virtualization code",

                        // the wire figure is the production BUILD — app, runtime and
                        // library slices. The tracker's 3 MB issues.json is fetched by a
                        // DataSource at run time and is not in it, so the line says so:
                        // "before its data" is the difference between a small app and a
                        // small download.

                        figures = { hpLines(app.stats.read(["tracker","total"]), app.stats.read(["tracker","code"]), app.stats.read(["tracker","comment"]))
                              + hpWire(app.stats.read(["tracker","wireGzip"])) + ", before its data"
                              + " · no dependencies · the same brief in idiomatic React: 2,703 lines, 9 dependencies" } ],

                    dsk: AppCard [ title = "Declare Desktop", num = "3",
                        shot   = "shots/desktop.webp",
                        url    = "apps/desktop/desktop.declare",
                        srcUrl = "apps/desktop/desktop.declare?viewer",
                        blurb = "Windows that drag, resize, layer, and minimize into live dock thumbnails · a magnifying dock · menus that follow focus · the calendar running inside one of them",
                        figures = { hpLines(app.stats.read(["desktop","total"]), app.stats.read(["desktop","code"]), app.stats.read(["desktop","comment"]))
                              + hpWire(app.stats.read(["desktop","wireGzip"])) + " · every pixel drawn from shapes, no image assets" } ]
                    ]
                ],

            /* ### 02 — Declare it. It runs. It stays true.
               Sections 02–04 share one shape: a SectionHead, a caption, and a
               live SourcePanel + PreviewFrame pair running the demo for real.
               These three are the language's genuinely new ideas — a constraint,
               replication over data, and a spring — one each, nothing else. */

            s3: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 36 ],
                SectionHead [ num = "02", head = "Declare it. It runs. It stays true.",
                    lead = "A binding isn’t a callback you remember to re-run — it’s a standing relationship the runtime keeps true, re-derived the moment its inputs change." ],
                demo3: View [ width = { parent.width },
                    layout: SimpleLayout [ axis = y, spacing = 14 ],
                    caption: Body [ fontSize = 15, width = { parent.width },
                        text = "Three bindings track one value: the big number, the bar’s width, and its color. Click to bump v — all three update together, and the color crosses cool to warm at the halfway mark." ],
                    cards: View [ width = { parent.width },
                        layout: ResponsiveLayout [ plan = { [({ from: 760, flow: "row", gap: 20, share: ({ src: 58, prev: 42 }) }), ({ from: 0, flow: "stack", gap: 20, share: ({ src: 100, prev: 100 }) })] } ],
                        src: SourcePanel [ editName = "reactivity",
                            src = { app.demoSources.reactivity || "" } ],
                        prev: PreviewFrame [ runName = "reactivity", height = { parent.src.height } ]
                        ]
                    ]
                ],

            /* ### 03 — Declare the shape, not the loop. */

            s4: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 36 ],
                SectionHead [ num = "03", head = "Declare the shape, not the loop.",
                    lead = "A view can be built from data instead of laid out by hand — the shape written once, the data deciding how many there are and what each one says." ],
                demo4: View [ width = { parent.width },
                    layout: SimpleLayout [ axis = y, spacing = 14 ],
                    caption: Body [ fontSize = 15, width = { parent.width },
                        text = "One Bar, instanced once per row of the data. Edit a number or add a row and the list rebuilds itself — no loop, no keys. And Bar is auto-included: no import, no definition, just use it." ],
                    cards: View [ width = { parent.width },
                        layout: ResponsiveLayout [ plan = { [({ from: 760, flow: "row", gap: 20, share: ({ src: 58, prev: 42 }) }), ({ from: 0, flow: "stack", gap: 20, share: ({ src: 100, prev: 100 }) })] } ],
                        src: SourcePanel [ editName = "components",
                            src = { app.demoSources.components || "" } ],
                        prev: PreviewFrame [ runName = "components", height = { parent.src.height } ]
                        ]
                    ]
                ],

            /* ### 04 — Motion you declare, not schedule. */

            s5: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 36 ],
                SectionHead [ num = "04", head = "Motion you declare, not schedule.",
                    lead = "You say where a thing belongs; a Spring finds the path there and settles by physics — motion you declare, not a timeline you sequence." ],
                demo5: View [ width = { parent.width },
                    layout: SimpleLayout [ axis = y, spacing = 14 ],
                    caption: Body [ fontSize = 15, width = { parent.width },
                        text = "Click to toggle the ball’s target between two positions. The Spring follows and settles by physics — no timeline, no frames driven by hand." ],
                    cards: View [ width = { parent.width },
                        layout: ResponsiveLayout [ plan = { [({ from: 760, flow: "row", gap: 20, share: ({ src: 58, prev: 42 }) }), ({ from: 0, flow: "stack", gap: 20, share: ({ src: 100, prev: 100 }) })] } ],
                        src: SourcePanel [ editName = "spring",
                            src = { app.demoSources.spring || "" } ],
                        prev: PreviewFrame [ runName = "spring", height = { parent.src.height } ]
                        ]
                    ]
                ],

            /* ### The pull quote — the page's one line about WHY it is shaped
               this way, placed where it can land: after three tiny programs the
               reader has just read, not before. The essay's door sits under it,
               which is the moment a curious reader actually wants it (the hero's
               copy of the same link is for the one who arrives already asking). */

            legible: View [ width = { parent.width }, opacity = 0,
                reveal: Spring [ attribute = opacity, stiffness = 90, damping = 22, epsilon = 0.004,
                    to = { app.scrollY + app.height > parent.parent.y + parent.y + 90 ? 1 : 0 } ],
                layout: SimpleLayout [ axis = y, spacing = 20 ],

                Heading [ fontSize = { app.width < 700 ? 24 : 30 },
                    width = { Math.min(880, parent.width) }, x = { (parent.width - Math.min(880, parent.width)) / 2 },
                    textAlign = center,
                    text = "Everything that makes it legible to an LLM makes it legible to you." ],

                // the benefit, not the mechanism. A fix-naming diagnostic is a
                // capability; what a reader wants to know is what it buys them —
                // an LLM that converges instead of guessing, and no app that
                // compiles clean and quietly does the wrong thing.

                Lead [ fontSize = 17, width = { Math.min(700, parent.width) },
                    x = { (parent.width - Math.min(700, parent.width)) / 2 }, textAlign = center,
                    text = "When an LLM gets something wrong, the compiler names the rewrite — so it corrects itself instead of guessing, and you don’t inherit an app that quietly runs wrong." ]

                // No link out to the "why" essay here. The band's own link would be
                // an exit immediately above the enumeration, the closer and Get
                // Started — and the hero already offers that door before any
                // argument is made, with the header carrying it the whole way down.
                ],

            /* ### Everything else, enumerated. The manifesto band used to sit
               here and spend a whole screen arguing against the document model.
               This states the surface instead: eight rows, each one flow, so a
               category and its contents wrap together into the column rather
               than stranding a label above a list.

               UNNUMBERED, and with no head. A SectionHead announcing "what comes
               with it" only says aloud what a list of capabilities plainly is —
               and heading it left-aligned the pair against a column of text that
               is no longer there. The block now centers on the page instead. */

            what: View [ width = { parent.width }, opacity = 0,
                reveal: Spring [ attribute = opacity, stiffness = 90, damping = 22, epsilon = 0.004,
                    to = { app.scrollY + app.height > parent.parent.y + parent.y + 90 ? 1 : 0 } ],
                layout: SimpleLayout [ axis = y, spacing = 34 ],

                // TWO COLUMNS, by slicing the same data twice: `:rows[0:3][]` and
                // `:rows[3:6][]` replicate the first and second halves, so each
                // column reads top-to-bottom (a wrapping flow would read across,
                // pairing unrelated categories). One list, two slices, no split
                // copy to keep in sync.
                //
                // Sized to the LONGEST LINE rather than to the page: at the page's
                // full width the two 50% shares put 250px of dead gutter between
                // columns whose text runs ~340px, and the pair read as two lists
                // that happened to land near each other. Centered, they read as one
                // block. Below the breakpoint this is `parent.width` and x is 0, so
                // the stacked phone layout is untouched.

                rows: View [ width = { Math.min(800, parent.width) },
                    x = { (parent.width - Math.min(800, parent.width)) / 2 },
                    layout: ResponsiveLayout [ plan = { [({ from: 760, flow: "row", gap: 56, share: ({ colA: 50, colB: 50 }) }),
                                                         ({ from: 0, flow: "stack", gap: 28, share: ({ colA: 100, colB: 100 }) })] } ],

                    colA: View [ datapath = { app.features.value },
                        layout: SimpleLayout [ axis = y, spacing = 28 ],
                        FeatureRow [ datapath = :rows[0:3][] ]
                        ],
                    colB: View [ datapath = { app.features.value },
                        layout: SimpleLayout [ axis = y, spacing = 28 ],
                        FeatureRow [ datapath = :rows[3:6][] ]
                        ]
                    ]
                ],

            /* ### The closing line — centered between the accent rules the
               manifesto used to wear. Three beats, and the third has a verb so
               it cannot be misread as describing this page's own interface. */

            closer: View [ width = { parent.width }, opacity = 0,
                reveal: Spring [ attribute = opacity, stiffness = 90, damping = 22, epsilon = 0.004,
                    to = { app.scrollY + app.height > parent.parent.y + parent.y + 90 ? 1 : 0 } ],
                layout: SimpleLayout [ axis = y, spacing = 30 ],
                ruleTop: View [ x = { (parent.width - 140) / 2 }, width = 140, height = 2, fill = { theme.accent } ],
                Heading [ fontSize = { app.width < 700 ? 26 : 38 },
                    width = { Math.min(900, parent.width) }, x = { (parent.width - Math.min(900, parent.width)) / 2 },
                    textAlign = center,
                    text = "Small language. Short programs." ],
                ruleBot: View [ x = { (parent.width - 140) / 2 }, width = 140, height = 2, fill = { theme.accent } ]
                ],

            /* ### The closing call to action — the primary blue button that
               leads into the getting-started page, centered above the footer */

            /* the page flow’s 112px would sit both above and below this one
               short row — the button pulls up into the gap (negative y, no
               clip) and the zero-height container lets the footer follow
               closer: ~88px above, ~90px below instead of 112/112 */

            cta: View [ width = { parent.width }, height = 0,
                Button [ width = 260, x = center, y = -24, label = "Get Started →", link = "#getstarted" ]
                ],

            /* ### Footer */

            // No trailing spacer: the page flow's 112px spacing applies BEFORE it
            // too, so a 28px tail cost 140px of dead space under the footer. The
            // footer carries its own bottom margin instead.

            footer: Footer [ width = { parent.width } ]
            ]
        ],

    /* ## The "Why" view

       An in-app view (`app.location == "why"`) wearing the same skin as the page —
       theme, graph-paper grid, and the header renders here too. The host mirrors
       `app.location` to the URL fragment (#why), so it deep-links and honours the
       back button — for free, from the one built-in binding. The article itself is
       prose in `"""` blocks: HTML collapses the line breaks, so the source wraps
       and the page flows. */

    whyView: View [ shows = "why", width = { app.width }, fill = { theme.ink },
        grid: GridBg [ x = 0, width = { app.width },
            // Follows the scroll rather than spanning the document. `ignoreScroll`
            // would lift it out of paint order and composite it OVER the content;
            // as an ordinary child it stays behind. Snapped to the 32px lattice so
            // the paper is pixel-identical to the document-tall version — the same
            // lines in the same places — while only one viewport is ever rasterised.
            // CLAMPED to the content's own bottom. Unclamped, the backdrop's
            // bottom is scrollY + a viewport, which feeds the scroller's
            // auto-extent — so every trip to the bottom grew the page another
            // 32px and left dead space under the footer (measured: 5243 →
            // 5412 over six trips). Reading the content's extent is what the
            // document-tall version did too, and it is not a cycle: the
            // content never reads the backdrop.

            y = { Math.max(0, Math.min(Math.floor(app.scrollY / 32) * 32,
                    parent.body.y + parent.body.height - this.height)) },
            height = { app.height + 32 } ],
        body: View [ y = 56, width = { app.width }, selectable = true,
            col: View [ width = { Math.min(720, app.width - 48) }, x = { Math.max(24, (app.width - 720) / 2) }, y = 52,
                layout: SimpleLayout [ axis = y, spacing = 22 ],
                Marker  [ text = "WHY DECLARE" ],
                Heading [ fontSize = { app.width < 700 ? 32 : 42 }, width = { parent.width },
                    text = "Why a new language, now?" ],
                Para [ html = """
                    Start with the obvious objection. LLMs write code now, and they’re
                    best at the languages they’ve seen the most — so the winning move is
                    to use whatever has the biggest corpus and let the model figure it
                    out. By that logic the era of new programming languages is over.
                    """ ],
                Para [ html = """
                    That argument gets its facts right and its conclusion backwards.
                    Producing code is now nearly free; trusting it costs what it always
                    did. An LLM writing React verifies its work by resemblance — this
                    looks like the billion lines it trained on — and resemblance is not
                    correctness. Meanwhile, less and less of the code passes under human
                    eyes, which leaves the language and its compiler as the one reviewer
                    that is always present. Handing the writing to a machine doesn’t make
                    the language irrelevant. It makes it load-bearing.
                    """ ],
                Heading [ fontSize = 24, width = { parent.width }, text = "Two kinds of leverage" ],
                Para [ html = """
                    What an LLM gets from a mainstream stack is corpus leverage: fluency
                    by imitation — broad, shallow, self-contradictory, unverifiable. The
                    other kind is comprehension leverage: a language small enough to hand
                    to a model whole, regular enough that its programs can be analyzed
                    rather than pattern-matched, and backed by a compiler that turns each
                    mistake into a precise correction. Corpus leverage arrives free with
                    popularity. Comprehension leverage has to be designed in — and it is
                    the only kind a new language can compete on.
                    """ ],
                Para [ html = """
                    This is a measured bet, not a hunch. LLMs can learn a language they
                    never trained on from a spec in context — in recent studies, a small
                    language purpose-designed for LLM use, with zero training exposure,
                    beat the same model writing Python, its best-trained language. And
                    what bounds a model’s ability to repair its own mistakes is the
                    quality of the feedback: a compiler that explains beats one that
                    merely rejects, by a double-digit margin.
                    """ ],
                sources: View [ width = { parent.width },
                    layout: ResponsiveLayout [ plan = { [({ from: 560, flow: "row", gap: 20 }), ({ from: 0, flow: "stack", gap: 8 })] } ],
                    lbl: Text [ fontSize = 14, wrap = false, textColor = { theme.faint }, text = "The studies:" ],
                    s1: Text [ fontSize = 14, wrap = false, selectable = false,
                        textColor = { this.pressed ? theme.linkPress : this.hovered ? theme.linkHover : theme.accent }, text = "a zero-corpus DSL vs. Python →",
                        onClick()     { app.navigate("https://arxiv.org/abs/2512.23214") }
                        ],
                    s2: Text [ fontSize = 14, wrap = false, selectable = false,
                        textColor = { this.pressed ? theme.linkPress : this.hovered ? theme.linkHover : theme.accent }, text = "feedback quality vs. repair →",
                        onClick()     { app.navigate("https://arxiv.org/abs/2504.06939") }
                        ]
                    ],
                Heading [ fontSize = 24, width = { parent.width }, text = "Designed in, not bolted on" ],
                Para [ html = """
                    Declare’s declarative layer is small — the whole language fits in a
                    model’s context window with room left for your app — and everything
                    inside a { } is ordinary TypeScript, so the hard part of generation
                    rides the largest corpus there is. Where Declare looks familiar, it
                    behaves the way a model — or you — will assume: assignment is
                    assignment, and there is no bypass to forget. Where it’s genuinely
                    new, it looks new — brackets for structure, :path for data — a
                    visible cue to consult the spec instead of autocompleting from memory.
                    """ ],
                Para [ html = """
                    And because a UI’s real structure — components, state, data, what
                    reacts to what — is expressed in the language, the compiler can see
                    all of it: it extracts every binding’s dependencies statically,
                    checks the shape of the tree, and types the seams. What a model
                    reasons about is exactly what the compiler verifies, and its errors
                    are written for that loop — each one states the rule and names the
                    rewrite that fixes it, because the primary reader of a compiler
                    message, now, is an LLM deciding what to do next.
                    """ ],
                Para [ html = """
                    Indexable content is there from the start: the compiler runs your
                    program at build time and serializes what it renders, so what a
                    visitor sees and what a crawler sees can never drift. No server-side
                    rendering, no hydration. That’s why this page works on a static host
                    like GitHub Pages.
                    """ ],
                Heading [ fontSize = 24, width = { parent.width }, text = "What it’s actually for" ],
                Para [ html = """
                    All of that is the floor, not the point. The point is what a language
                    makes sayable. The most prized layer of modern UI — the continuity
                    you feel in the best native software, where a view doesn’t switch so
                    much as become the next one, where motion carries meaning and
                    everything stays interruptible — has always been bespoke: specialist
                    craft, one interaction at a time, locked to a platform. It is also
                    the least machine-writable code there is; the corpus is thin, custom,
                    and wrong in ways nothing catches.
                    """ ],
                Para [ html = """
                    Declare makes continuity the grain, not the garnish. Motion is a
                    Spring on an attribute; layout is a reactive slot; a mode is a
                    reversible state — so the continuous version of an interface is often
                    less code than the discrete one. The reference app is a calendar
                    whose four views are one surface seen through a moving, zooming
                    rectangle — normally a bespoke project of its own, here a few hundred
                    lines of declarations, readable end to end, written with an LLM. The
                    whole category moves into the declarative, analyzable layer: the
                    hardest part of ambitious UX becomes the part a model is best at.
                    """ ],
                Para [ html = """
                    And that is the forward-looking wager. There is another generation of
                    experiences beyond the hand-crafted best-in-class interfaces of
                    today — built on a foundation with continuity at its core, enabled
                    at the language level, deployed as universally as a URL, and iterated
                    by imaginative designer-developers working with an LLM at their side.
                    Declare is built to find that out.
                    """ ],
                Para [ html = """
                    None of this trades away the human. What makes code legible to a
                    model is what makes it fast for you to read — and you are still the
                    reader who decides. You don’t teach an LLM Declare with a million
                    examples. You hand it the language and let the compiler keep it
                    honest. The corpus will come; the language doesn’t need it first.
                    """ ],

                /* ### Where this came from

                   A second movement, not a postscript: the essay above answers "why a
                   new language, now?", and this answers "where did this one come
                   from?" — a different question, in the first person. Marked as its
                   own section (breath, hairline, eyebrow) rather than run on from the
                   last paragraph, so the essay's closing line still reads as an
                   ending. Set a step smaller and in the muted tone: quieter than the
                   argument it follows, without the fatigue of a long italic run.

                   One `Para` per paragraph, the way the essay does it — the column's
                   22px `SimpleLayout` spacing IS the paragraph rule, so there is no
                   block markup to keep consistent with the prose above. */

                breath: View [ width = 8, height = 18 ],

                // `anchor = "story"` — "#story" reaches this note from anywhere
                // (the FAQ's cross-reference), the destination derived, the
                // landing measured-reveal'd, the header cleared by revealInset

                rule:   View [ anchor = "story", width = { parent.width }, height = 1, fill = { theme.line } ],
                Marker [ text = "WHERE THIS CAME FROM" ],
                Para [ fontSize = 16, bodyColor = { theme.muted }, html = """
                    I co-founded Laszlo Systems and led the team behind OpenLaszlo — a
                    declarative UI language, first shipped in 2002, that pushed right to
                    the edge of what that era’s web browsers could handle.
                    """ ],

                // the note's one outbound link. `link` is a RichText event, so the href
                // routes through the app rather than the document — same `navigate`
                // service action every other off-site link on the page uses — and
                // `linkColor` puts it on the page's own accent instead of the rich
                // flow's built-in blue.

                Para [ fontSize = 16, bodyColor = { theme.muted }, linkColor = { theme.accent },
                    html = """
                    What brought me back to UI development was
                    <a href="https://davidtemkin.com/about-mesa/">Mesa</a>, a zoomable
                    canvas app I built without using a browser framework, toolkit, or
                    higher-level language. Mesa renders a thousand live objects at a
                    60fps floor, even on a phone. It’s been positively amazing to see how
                    fast today’s browsers have become — and how powerful and flexible
                    today’s web platform is.
                    """ ],
                Para [ fontSize = 16, bodyColor = { theme.muted }, html = """
                    And yet the web as it actually stands is still, mostly, slow and
                    clunky. Even brand-new sites. How can that be?
                    """ ],
                Para [ fontSize = 16, bodyColor = { theme.muted }, html = """
                    It turns out the browser isn’t what makes the web feel worse than a
                    good native app. It’s what we’ve built on top of it. A lot of
                    accumulated code — and a lot of accumulated habits — take their toll,
                    and the interfaces that do escape them are hand-crafted, one at a
                    time, by specialists.
                    """ ],
                Para [ fontSize = 16, bodyColor = { theme.muted }, html = """
                    In June I handed the original OpenLaszlo compiler to an LLM and got
                    back a modern port that compiles any OpenLaszlo program perfectly,
                    byte-for-byte.
                    """ ],
                Para [ fontSize = 16, bodyColor = { theme.muted }, html = """
                    Seeing those programs again through fresh eyes — and seeing how small
                    and how fast the sites built with them are — I decided the language
                    deserved to be modernized. Declare is what came out of that: a direct
                    descendant of OpenLaszlo, with the core ideas intact, built on an
                    entirely new foundation, and shaped to be written with an LLM.
                    """ ],
                Para [ fontSize = 16, bodyColor = { theme.muted }, html = """
                    Enjoy!
                    """ ],
                sig: Para [ fontSize = 16, bodyColor = { theme.dim }, html = """
                    <em>— David Temkin</em>
                    """ ],

                gap: View [ width = 8, height = 64 ],
                Footer [ width = { parent.width } ],
                tail: View [ width = 8, height = 40 ]
                ]
            ]
        ],

    /* ## The "Language" view

       The one-file core doc (docs/declare.md), rendered in-app by the native
       Markdown component — same skin and same location machinery as the Why
       article, so it deep-links (#language) and is crawled into the static
       document like any other reachable location. The text arrives as the
       app's own material — docs/declare.md fetched directly, format = "text":
       loading and failure are lifecycle states the view derives from, never
       a blank. */

    languageView: View [ shows = "language", width = { app.width }, fill = { theme.ink },
        // TEST: viewport-height backdrop instead of document-height

        grid: GridBg [ x = 0, width = { app.width },
            // Follows the scroll rather than spanning the document. `ignoreScroll`
            // would lift it out of paint order and composite it OVER the content;
            // as an ordinary child it stays behind. Snapped to the 32px lattice so
            // the paper is pixel-identical to the document-tall version — the same
            // lines in the same places — while only one viewport is ever rasterised.
            // CLAMPED to the content's own bottom. Unclamped, the backdrop's
            // bottom is scrollY + a viewport, which feeds the scroller's
            // auto-extent — so every trip to the bottom grew the page another
            // 32px and left dead space under the footer (measured: 5243 →
            // 5412 over six trips). Reading the content's extent is what the
            // document-tall version did too, and it is not a cycle: the
            // content never reads the backdrop.

            y = { Math.max(0, Math.min(Math.floor(app.scrollY / 32) * 32,
                    parent.body.y + parent.body.height - this.height)) },
            height = { app.height + 32 } ],
        body: View [ y = 56, width = { app.width }, selectable = true,
            col: View [ width = { Math.min(720, app.width - 48) }, x = { Math.max(24, (app.width - 720) / 2) }, y = 52,
                layout: SimpleLayout [ axis = y, spacing = 22 ],
                Marker [ text = "THE LANGUAGE" ],
                loading: Text [ visible = { app.lang.loading }, fontSize = 15, textColor = { theme.faint }, text = "Loading the language…" ],
                failed:  Text [ visible = { app.lang.failed }, fontSize = 15, textColor = { theme.faint }, wrap = true, width = { parent.width },
                    text = { "The language file did not load — " + (app.lang.error || "") } ],
                doc: Markdown [ visible = { app.lang.loaded }, width = { parent.width }, lineHeight = 1.35, bodyColor = { theme.lead }, dark = true,
                    text = { app.lang.value || "" } ],
                gap: View [ width = 8, height = 64 ],
                Footer [ width = { parent.width } ],
                tail: View [ width = 8, height = 40 ]
                ]
            ]
        ],

    /* ## The "Get Started" view

       The getting-started guide (app.location == "getstarted"), rendered in-app
       with the same skin and Markdown pipeline as the Language view: the copy is
       getstarted.md itself (an authored page, its command blocks generated), so
       it deep-links (#getstarted), honours the back button, and is crawled into
       the static document like any other reachable location. Loading and failure
       are lifecycle states the view derives from, never a blank. */

    getStartedView: View [ shows = "getstarted", width = { app.width }, fill = { theme.ink },
        grid: GridBg [ x = 0, width = { app.width },
            // Follows the scroll rather than spanning the document. `ignoreScroll`
            // would lift it out of paint order and composite it OVER the content;
            // as an ordinary child it stays behind. Snapped to the 32px lattice so
            // the paper is pixel-identical to the document-tall version — the same
            // lines in the same places — while only one viewport is ever rasterised.
            // CLAMPED to the content's own bottom. Unclamped, the backdrop's
            // bottom is scrollY + a viewport, which feeds the scroller's
            // auto-extent — so every trip to the bottom grew the page another
            // 32px and left dead space under the footer (measured: 5243 →
            // 5412 over six trips). Reading the content's extent is what the
            // document-tall version did too, and it is not a cycle: the
            // content never reads the backdrop.

            y = { Math.max(0, Math.min(Math.floor(app.scrollY / 32) * 32,
                    parent.body.y + parent.body.height - this.height)) },
            height = { app.height + 32 } ],
        body: View [ y = 56, width = { app.width }, selectable = true,
            col: View [ width = { Math.min(720, app.width - 48) }, x = { Math.max(24, (app.width - 720) / 2) }, y = 52,
                layout: SimpleLayout [ axis = y, spacing = 22 ],
                Marker [ text = "GETTING STARTED" ],
                loading: Text [ visible = { app.guide.loading }, fontSize = 15, textColor = { theme.faint }, text = "Loading the guide…" ],
                failed:  Text [ visible = { app.guide.failed }, fontSize = 15, textColor = { theme.faint }, wrap = true, width = { parent.width },
                    text = { "The guide did not load — " + (app.guide.error || "") } ],
                doc: Markdown [ visible = { app.guide.loaded }, width = { parent.width }, lineHeight = 1.35, bodyColor = { theme.lead }, dark = true,
                    text = { app.guide.value || "" } ],
                gap: View [ width = 8, height = 64 ],
                Footer [ width = { parent.width } ],
                tail: View [ width = 8, height = 40 ]
                ]
            ]
        ],

    /* ## The FAQ view — the Get Started pattern at #faq */

    faqView: View [ shows = "faq", width = { app.width }, fill = { theme.ink },
        grid: GridBg [ x = 0, width = { app.width },
            // Follows the scroll rather than spanning the document. `ignoreScroll`
            // would lift it out of paint order and composite it OVER the content;
            // as an ordinary child it stays behind. Snapped to the 32px lattice so
            // the paper is pixel-identical to the document-tall version — the same
            // lines in the same places — while only one viewport is ever rasterised.
            // CLAMPED to the content's own bottom. Unclamped, the backdrop's
            // bottom is scrollY + a viewport, which feeds the scroller's
            // auto-extent — so every trip to the bottom grew the page another
            // 32px and left dead space under the footer (measured: 5243 →
            // 5412 over six trips). Reading the content's extent is what the
            // document-tall version did too, and it is not a cycle: the
            // content never reads the backdrop.

            y = { Math.max(0, Math.min(Math.floor(app.scrollY / 32) * 32,
                    parent.body.y + parent.body.height - this.height)) },
            height = { app.height + 32 } ],
        body: View [ y = 56, width = { app.width }, selectable = true,
            col: View [ width = { Math.min(720, app.width - 48) }, x = { Math.max(24, (app.width - 720) / 2) }, y = 52,
                layout: SimpleLayout [ axis = y, spacing = 22 ],
                Marker [ text = "FAQ" ],
                loading: Text [ visible = { app.faq.loading }, fontSize = 15, textColor = { theme.faint }, text = "Loading…" ],
                failed:  Text [ visible = { app.faq.failed }, fontSize = 15, textColor = { theme.faint }, wrap = true, width = { parent.width },
                    text = { "The FAQ did not load — " + (app.faq.error || "") } ],
                doc: Markdown [ visible = { app.faq.loaded }, width = { parent.width }, lineHeight = 1.35, bodyColor = { theme.lead }, dark = true,
                    text = { app.faq.value || "" } ],
                gap: View [ width = 8, height = 64 ],
                Footer [ width = { parent.width } ],
                tail: View [ width = 8, height = 40 ]
                ]
            ]
        ],

    /* ## Fixed chrome

       `ignoreScroll` — the scroll carries everyone but these; they ride the
       window while the page's own scroll carries the content: the top bar, the
       whole-page editor overlay, the pointer dot, and the mobile nav sheet. */

    // the bar is ALWAYS present, stuck to the top (the springs that used to
    // reveal it on scroll retired 2026-07-17: a first-time visitor sees the
    // whole map)

    header: View [ ignoreScroll = true, width = { app.width }, height = { 56 + app.safeTop }, y = 0, opacity = 1, fill = { theme.surface },
        hairline: View [ y = { 55 + app.safeTop }, width = { app.width }, height = 1, fill = { theme.line } ],

        /* The header row, gutter to gutter. ONE ResponsiveLayout decides whether
           the pill row fits, and `share: 0` IS the hiding — so there is no width
           test written by hand and no `visible` to keep in step with a number.
           Above the threshold the plan drops the kebab; below it the plan drops
           the pills and the kebab takes over, the whole list moving to the sheet.
           Nothing is ever dropped from the list itself, unlike a progressively
           trimmed pill row.

           The threshold is the row's OWN width, not the window's (a plan watches
           its view), and it is measured: the wordmark runs 53 and the pills 477,
           so 593 leaves 63 between them. It is also the one number that moves
           when `navItems` gains an entry — which is why it is stated once.
           (Was 772 against a 656px pill run, when the three applications each
           had a pill of their own; folding them under `Apps` took 179 out of
           the row, so the pills now survive to a much narrower window.)

           The Spacer is what right-aligns the run: it absorbs the slack between
           the wordmark and whatever follows. Shares fill; naturals align. */

        bar: View [ x = { app.gutter }, y = { app.safeTop }, height = 56,
            width = { app.width - app.gutter * 2 },
            layout: ResponsiveLayout [ gap = 0, plan = { [
                ({ from: 593, flow: "row", share: ({ kebab: 0 }) }),
                ({ from: 0,   flow: "row", share: ({ nav: 0 }) })] } ],

            // wordmark — the product name in the brand gradient, in the hero's typeface

            brand: View [ y = 18, height = 22,
                layout: SimpleLayout [ axis = x, spacing = 0 ],
                link = "#home",
                Heading [ fontSize = 15, textFill = { theme.brand }, text = "Declare" ]
                ],

            Spacer [ ],

            // primary nav — one NavLink per navItems entry; the padded pills carry
            // their own spacing

            nav: View [ y = 11,
                layout: SimpleLayout [ axis = x, spacing = 2 ],
                datapath = { app.navSource.value },
                NavLink [ datapath = :items[], label = { :label }, menu = { :children.length > 0 },
                    link = { :children.length > 0 ? "" : :link } ]
                ],

            // the kebab — three stacked dots (the page's dot motif), the pill's own
            // press feedback, toggling the sheet

            kebab: View [ y = 11, width = 34, height = 33, cornerRadius = 8,
                fill = { pressed ? theme.pillPress : hovered ? theme.pillHover : null },
                onClick()     { app.menuOpen = !app.menuOpen },
                d1: View [ x = center, y = 8,  width = 3, height = 3, cornerRadius = 1.5, fill = { parent.hovered || parent.pressed ? theme.text : theme.muted } ],
                d2: View [ x = center, y = 15, width = 3, height = 3, cornerRadius = 1.5, fill = { parent.hovered || parent.pressed ? theme.text : theme.muted } ],
                d3: View [ x = center, y = 22, width = 3, height = 3, cornerRadius = 1.5, fill = { parent.hovered || parent.pressed ? theme.text : theme.muted } ]
                ]
            ]
        ],

    // pointer dot — a 10px accent-2 dot in VIEWPORT space that SPRINGS after the
    // pointer (loose + low-mass = the slower, longer trail). Two position
    // Springs; the native cursor stays visible and leads, the dot follows.

    pointerDot: View [ ignoreScroll = true, width = 10, height = 10, cornerRadius = 5, fill = { theme.accentSecondary }, opacity = 0.9,
        shadow = { shadow(0, 0, 12, theme.accentSecondary) },

        // Decoration, not a target: the dot settles exactly under a resting
        // cursor, and the hit chain is occlusion-correct — without this line
        // the dot swallows every hover and press the moment the mouse stops
        // (links lit only while the cursor was moving; clicks resolved, but
        // `pressed`/`hovered` styling died at rest).

        pointerEvents = "none",

        // Only for a HOVERING pointer (mouse / trackpad) — `app.hovering` is false
        // for touch, so the dot never appears on a phone, yet an iPad trackpad
        // (which reports a "mouse" pointer) still gets it. Also yields to the
        // native I-beam when the pointer is over an editable field.

        visible = { app.hovering && !app.pointerOverText },
        followX: Spring [ attribute = x, to = { app.pointerX - 5 },
            stiffness = 120, damping = 14, mass = 0.6, epsilon = 0.05 ],
        followY: Spring [ attribute = y, to = { app.pointerY - 5 },
            stiffness = 120, damping = 14, mass = 0.6, epsilon = 0.05 ]
        ],

    // the mobile nav sheet — the kebab's menu, above everything. A dim scrim below
    // the header catches an outside tap (and leaves the header + kebab lit, so the
    // kebab still toggles it shut); the top-right panel lists every destination as
    // a thumb-height row, replicated from the SAME navData as the pills. Auto-hides
    // if the window is widened back past the breakpoint.

    navSheet: View [ ignoreScroll = true, visible = { app.menuOpen && app.header.bar.kebab.visible }, width = { app.width }, height = { app.height },
        scrim: View [ y = { 56 + app.safeTop }, width = { parent.width }, height = { parent.height - 56 - app.safeTop }, fill = { theme.scrim },
            onClick() { app.menuOpen = false }
            ],
        panel: View [ x = { app.width - app.gutter - this.width }, y = { 62 + app.safeTop }, width = 236, cornerRadius = 12,
            fill = { theme.surface }, shadow = { shadow(0, 12, 40, theme.shade) },

            // DERIVED from the list, not counted: rows and group children are
            // no longer one uniform height, so `navItems.length * 44` stated a
            // relationship the sheet had already stopped having.

            height = { this.list.contentHeight + 12 },
            list: View [ x = 6, y = 6, width = { parent.width - 12 }, height = { this.contentHeight },
                layout: SimpleLayout [ axis = y, spacing = 0 ],
                datapath = { app.navSource.value },
                MobileNavGroup [ datapath = :items[] ]
                ]
            ]
        ],

    // the Apps dropdown — the pill row's own menu, the same rows as the sheet
    // (MobileNavRow), anchored under the Apps pill. A transparent catcher
    // below closes it on an outside tap; narrowing past the breakpoint hides
    // it with the pills it belongs to.

    appsMenu: View [ ignoreScroll = true, visible = { app.appsOpen && !app.header.bar.kebab.visible },
        width = { app.width }, height = { app.height },
        catcher: View [ width = { parent.width }, height = { parent.height },
            onClick() { app.appsOpen = false }
            ],
        panel: View [ x = { app.appsX }, y = { app.appsY }, width = 190, cornerRadius = 12,
            fill = { theme.surface }, shadow = { shadow(0, 12, 40, theme.shade) },
            height = { this.list.contentHeight + 12 },
            list: View [ x = 6, y = 6, width = { parent.width - 12 }, height = { this.contentHeight },
                layout: SimpleLayout [ axis = y, spacing = 0 ],
                datapath = { app.appsSource.value },
                MobileNavRow [ datapath = :items[], label = { :label }, link = { :link } ]
                ]
            ]
        ]
    ]
