                            Button [ width = { app.compact ? 94 : 110 }, label = "Secondary", primary = false ],
                            Button [ width = { app.compact ? 94 : 110 }, label = "Disabled", disabled = true, tooltipLabel = "Disabled — but the tip still shows" ]
                            ]
