                            onHold(e: PointerEvent) { app.ctxMenu.open(this, e) },
                            Text [ x = 14, y = 14, fontSize = 13, textColor = { provided("theme").textMuted },
                                text = "Right-click (or long-press) in this box." ],
                            got: Text [ x = 14, y = 40, fontSize = 12, textColor = { provided("theme").textMuted },
                                text = { "picked: " + app.lastCtx } ]
                            ]
