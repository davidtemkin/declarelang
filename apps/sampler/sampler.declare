            // ── Forms page: a form, and editing one piece at a time ────────

            formsPage: View [ visible = { app.page == "forms" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "Forms",
                layout: ResponsiveLayout [ plan = { [
                    ({ from: 876, flow: "row",   gap: 32, share: ({ left: 50, right: 50 }) }),
                    ({ from: 0, flow: "stack", gap: 20, share: ({ left: 100, right: 100 }) })] } ],

                left: View [
                    layout: SimpleLayout [ axis = y, spacing = 20 ],
                    Specimen [ label = "Create an account",
                        SignUp [ ],
                        Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                            text = "Each field says what is wrong once you leave it; Create account judges them all. taken@example.com is refused by the pretend service, under its field." ]
                        ]
                    ],

                right: View [
                    layout: SimpleLayout [ axis = y, spacing = 20 ],

                    // admit refuses before anything appears; commit clamps, and
                    // what was typed stays on screen until the field is left

                    Specimen [ label = "Refused, and clamped",
                        row: View [ layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
                            TextInput [ width = 90, accessibilityLabel = "Font size", numeralWidth = tabular,
                                value = { String(app.size) },
                                admit(t: string) -> string | null { return /^[0-9]{0,3}$/.test(t) ? t : null },
                                commit(t: string) { if (t != "") app.size = Math.max(8, Math.min(400, Number(t))) }
                                ],
                            Text [ fontSize = 13, textColor = { provided("theme").textMuted }, text = { "size " + app.size + " (8–400)" } ]
                            ],
                        Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                            text = "Letters never appear. Type 4: the size is 8, the field still says 4, so 48 can follow." ]
                        ],

                    // admit tidies: a pasted sentence keeps only its digits

                    Specimen [ label = "Tidied as it arrives",
                        TextInput [ width = 160, accessibilityLabel = "Code", purpose = oneTimeCode, numeralWidth = tabular,
                            placeholder = "6-digit code", value <-> app.code,
                            admit(t: string) -> string { return t.replace(/[^0-9]/g, "").slice(0, 6) }
                            ],
                        Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                            text = "Paste “Your code is 12 34 56” and the field holds 123456 — one step on Undo." ]
                        ],

                    // the same code as six cells: still one native field — autofill,
                    // paste, Undo, one name to a screen reader — drawn by its own cells

                    Specimen [ label = "A code, in cells",
                        CodeField [ width = 300, accessibilityLabel = "One-time code", value <-> app.code ],
                        Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                            text = "One field, so a pasted or autofilled code fills every cell at once." ]
                        ],

                    // commitOn = "end": nothing is written until the field is left

                    Specimen [ label = "Saved when you leave",
                        TextInput [ width = 100%, accessibilityLabel = "Note", commitOn = "end", value <-> app.note ],
                        Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                            text = { "Saved: “" + app.note + "” — Tab away to save, Escape to take it back." } ]
                        ],

                    // a drag is one edit: committed once, when it is let go

                    Specimen [ label = "Committed at the release",
                        Slider [ width = 100%, accessibilityLabel = "Level", commitOn = "end",
                            value = { app.level },
                            commit(v: number) { app.level = Math.round(v); app.commits = app.commits + 1 }
                            ],
                        Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                            text = { "Level " + app.level + ", committed " + app.commits + (app.commits == 1 ? " time" : " times") + " — a whole drag is one." } ]
                        ]
                    ]
                ],

