/*
# The control sampler

The library's controls under four switchable stylings — San Francisco (the
default), Mountain View, Cupertino, and Redmond. One machinery, four token
records: the stylings are **data**, never code paths.

The chrome is a fixed-height top bar: the brand at left (compacting to just
"Declare" when narrow), the page switch in the center (Controls · Table ·
DataGrid · Overlays · More), and at right a Styling button whose menu holds
the four stylings, the accent-tint dot row and the focus-animation toggle,
beside the light/dark switch — the whole styling rig, off the page. The
Controls and More pages read as cards, two columns wide, one below the
breakpoint the cards actually need.
*/

use [ TintRow ]   // the styling menu names its tint row in data

// A custom menu row: the items data names it (`kind: "TintRow"`) and the menu
// creates it by name (hence the `use` above). Each dot handles its own click:
// it applies the accent and closes the menu itself.

class TintDot [ width = 16, height = 16, cornerRadius = 8,
    c: Color = #2E6FE0,

    // the hovered dot enlarges in place — scale is painted-only (no layout
    // shift, neighbors stay put, hit-testing follows)

    scale = { hovered ? 1.4 : 1 },
    pivotX = 8,
    pivotY = 8,
    fill = { c },
    stroke = { hovered ? stroke(2, provided("theme").text) : app.accentPick == c ? stroke(2, provided("theme").textMuted) : null },
    onClick() { app.accentPick = app.accentPick == c ? 0 : c || 0; app.stylingMenu.close() }
    ]


// The dots row: color and the selected ring say everything, so there is no
// caption. Clicking the selected dot again clears the tint.

class TintRow [
    height = 22,

    dots: View [ x = 0, y = 3,
        layout: SimpleLayout [ axis = x, spacing = 7 ],
        TintDot [ c = #2E6FE0 ],
        TintDot [ c = #6750A4 ],
        TintDot [ c = #E0447E ],
        TintDot [ c = #D03A2F ],
        TintDot [ c = #3A9E4C ]
        ]
    ]


// A specimen card: the library's `Card` — its surface, hairline and inset —
// with an eyebrow label stacked above the use site's content. The card has an
// inside, so a specimen's content is written with no coordinates at all, and
// the card's height falls out of what it holds.

class Specimen extends Card [ width = 100%,
    label: string = "",
    cornerRadius = 10,
    padding = [14, 16, 16, 16],                      // the eyebrow sits a little higher than it is deep
    layout: SimpleLayout [ axis = y, spacing = 17 ],   // eyebrow, then the specimen
    hd: Text [ fontSize = 11.5, fontWeight = semibold, letterSpacing = 1.1,
        textColor = { provided("theme").textMuted }, text = { label.toUpperCase() } ]
    ]


App [ fill = { provided("theme").background }, textColor = { provided("theme").text }, minWidth = 320,
    roboto: Font [
        FontFace [ src = "../../assets/fonts/roboto/roboto-400.woff2" ],
        FontFace [ src = "../../assets/fonts/roboto/roboto-500.woff2", weight = medium ]
        ],

    // ── the responsive facts, each scoped to what it governs ───────────────

    compact: boolean = { app.width < 640 },      // the bar: brand drops "Sampler", tighter segments
    narrow: boolean = { app.width < 940 },       // the page column: tighter side margins
    gridNarrow: boolean = { app.width < 760 },   // the grid: the narrow column-width set

    barH: number = { app.compact ? 92 : 52 },    // fixed for a width — on a narrow one the page switch takes a second row

    page: "controls" | "table" | "grid" | "overlays" | "more" = "controls",      // the center switch
    style: "sanFrancisco" | "mountainView" | "cupertino" | "redmond" = "sanFrancisco",
    menuLocked: boolean = true,
    lastPick: string = "(none yet)",
    lastCtx: string = "(none yet)",
    span: string = "week",
    readScale: number = 1,
    pane: string = "general",
    lastBar: string = "(none yet)",
    themeMode: "auto" | "light" | "dark" = "auto",          // orthogonal to the styling
    darkUI: boolean = { themeMode == "dark" || (themeMode == "auto" && app.dark) },
    animateFocus: boolean = true,
    accentPick: number = 0,                      // 0 = the mode's own accent; a pick overrides it everywhere

    // the library presets, by city and mode: SanFrancisco / MountainView /
    // Cupertino / Redmond and their …Dark companions

    preset: Theme = { ({ sanFrancisco: darkUI ? SanFranciscoDark : SanFrancisco, mountainView: darkUI ? MountainViewDark : MountainView, cupertino: darkUI ? CupertinoDark : Cupertino, redmond: darkUI ? RedmondDark : Redmond })[style] },

    theme = { {
        ...app.preset,
        // the brand gradient's second stop — the family's teal, as docs and
        // the calendar name it; no preset carries it
        accentSecondary: darkUI ? 0x37E0C8 : 0x12A594,
        focusAnimate: animateFocus,
        // Redmond's focus ring appears in place ("rest"); with focus animation
        // switched on, the app overrides that one token to "both" so it moves
        // too. The preset stays as shipped.
        ...(style == "redmond" && animateFocus ? ({ focusRingStyle: "both" }) : ({})),
        ...(accentPick != 0 ? ({ accent: accentPick, controlSelected: activeTone(accentPick, app.preset.surface) }) : ({})),
    } },

    // the type stack is part of the styling: Roboto for Mountain View, the system face for Cupertino

    fontFamily = { ({ sanFrancisco: "system-ui, sans-serif", mountainView: [app.roboto, "system-ui", "sans-serif"], cupertino: "-apple-system, system-ui, sans-serif", redmond: "'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif" })[style] },

    // ── data: the Table's cities; the DataGrid's issues (app-owned — seeded
    //    once, so cell edits persist; the sort verb reorders the data) ──────

    cities: Dataset { {
        "rows": [
            { "id": "sf",  "name": "San Francisco", "pop": "808,000" },
            { "id": "cu",  "name": "Cupertino",     "pop": "57,000" },
            { "id": "mv",  "name": "Mountain View", "pop": "81,000" },
            { "id": "re",  "name": "Redmond",       "pop": "78,000" },
            { "id": "au",  "name": "Austin",        "pop": "979,000" },
            { "id": "po",  "name": "Portland",      "pop": "635,000" },
            { "id": "se",  "name": "Seattle",       "pop": "755,000" },
            { "id": "ch",  "name": "Chicago",       "pop": "2,665,000" },
            { "id": "ny",  "name": "New York",      "pop": "8,258,000" },
            { "id": "bo",  "name": "Boston",        "pop": "654,000" }
        ]
    } },

    gd: Dataset { { "rows": [] } },

    // the grid's column widths, app-owned: user resizes merge here, and on a
    // narrow window they override the narrow defaults

    gridWidths: object = null,

    issueRows() -> array {
        const states = ["open", "triage", "done"]
        const owners = ["ada", "alan", "grace", "edsger"]
        return Array.from({ length: 500 }, (_, i) => ({
            id: i + 1,
            title: "Issue " + (i + 1),
            state: states[i % 3],
            owner: owners[(i * 7) % 4],
            done: i % 4 == 0,
            }))
        },

    onInit() { gd.set(["rows"], this.issueRows()) },

    // the sort delivery's consumer: the app owns the data, so sorting is a
    // data verb — a reordered copy replaces the rows (identity by `id` keeps
    // every instance and every edit)

    resort(on: string, dir: string) {
        const rows = [...(gd.value.rows ?? [])]
        rows.sort((a, b) => {
            const va = (a as any)[on]
            const vb = (b as any)[on]
            const c = va < vb ? -1 : va > vb ? 1 : 0
            return dir == "desc" ? -c : c
            })
        gd.set(["rows"], rows)
        },

    // ── the STYLING menu — the styling rig as records: styling rows, the
    //    tint dots (the Finder idiom), the flourish. Light/dark is the bar's
    //    own switch, beside it. ───────────────────────────────────────────

    stylingMenu: Menu [
        width = 240,
        items = { [
            ({ id: "style:sanFrancisco", label: "San Francisco", checked: app.style == "sanFrancisco" }),
            ({ id: "style:mountainView", label: "Mountain View", checked: app.style == "mountainView" }),
            ({ id: "style:cupertino", label: "Cupertino", checked: app.style == "cupertino" }),
            ({ id: "style:redmond", label: "Redmond", checked: app.style == "redmond" }),
            ({ divider: true }),
            ({ kind: "TintRow" }),
            ({ divider: true }),
            ({ id: "animate", label: "Animate focus transitions", checked: app.animateFocus }),
        ] },
        picked(id: string) {
            if (id.startsWith("style:")) app.style = id.slice(6) as "sanFrancisco" | "mountainView" | "cupertino" | "redmond"
            else if (id == "animate") app.animateFocus = !app.animateFocus
            }
        ],

    // ── the options menu demo: the record vocabulary in one declaration ────

    optionsMenu: Menu [
        items = { [
            ({ id: "new", label: "New Event", key: "⌘N" }),
            ({ id: "dup", label: "Duplicate", key: "⌘D" }),
            ({ id: "lock", label: "Locked", checked: app.menuLocked }),
            ({ divider: true }),
            ({ id: "share", label: "Share", submenu: [
                ({ id: "mail", label: "Mail", key: "⌘M" }),
                ({ id: "messages", label: "Messages" }),
                ({ divider: true }),
                ({ id: "airdrop", label: "AirDrop" }),
            ] }),
            ({ divider: true }),
            ({ id: "delete", label: "Delete", key: "⌫", enabled: !app.menuLocked }),
        ] },
        picked(id: string) {
            if (id == "lock") app.menuLocked = !app.menuLocked
            app.lastPick = id
            }
        ],

    // the context menu, declared once; the view that offers it opens it from
    // its own onContextMenu and onHold handlers

    ctxMenu: ContextMenu [
        items = { [
            ({ id: "open", label: "Open" }),
            ({ id: "rename", label: "Rename…" }),
            ({ id: "duplicate", label: "Duplicate" }),
            ({ divider: true }),
            ({ id: "delete", label: "Delete", key: "⌫" }),
        ] },
        picked(id: string) { app.lastCtx = id }
        ],

    dlg: Dialog [ ],
    lastDialog: string = "(none yet)",

    // ── the Overlays page's overlays: each a Floating, declared once here ──

    textSize: number = 15,
    docName: string = "Untitled",
    lastOverlay: string = "(none yet)",

    sizer: Popover [
        Text [ fontWeight = semibold, textColor = { provided("theme").text }, text = { "Text size · " + app.textSize } ],
        Slider [ width = 200, min = 10, max = 32, value = { app.textSize }, accessibilityLabel = "Text size",
            input(v: number) { app.textSize = Math.round(v) }
            ]
        ],

    rename: Dialog [ title = "Rename document",
        buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "ok", label: "Rename", default: true }) ] },
        picked(id: string) { if (id == "ok" && this.nameField.text != "") app.docName = this.nameField.text; app.lastOverlay = "rename: " + id },
        nameField: TextInput [ width = 100%, initial = { app.docName }, accessibilityLabel = "Document name" ]
        ],

    viewer: Dialog [ presentation = "full",
        View [ width = 100%, height = 100%, fill = #101418,
            Text [ x = center, y = center, fontSize = 28, fontWeight = semibold, textColor = #F4F6FA, text = "A full-screen dialog" ],
            Text [ x = center, y = { parent.height - 60 }, fontSize = 13, textColor = #9AA4B0, text = "Esc closes it" ]
            ]
        ],

    prefs: Sheet [ edge = "end", accessibilityLabel = "Preferences",
        Text [ fontSize = 17, fontWeight = bold, textColor = { provided("theme").text }, text = "Preferences" ],
        Checkbox [ label = "Show line numbers", checked = true ],
        Checkbox [ label = "Wrap long lines" ],
        Checkbox [ label = "Autosave" ],
        Button [ label = "Done", primary = true,
            onClick() { app.prefs.close() }
            ]
        ],

    share: Sheet [ accessibilityLabel = "Share",
        Text [ fontSize = 17, fontWeight = bold, textColor = { provided("theme").text }, text = "Share" ],
        Text [ width = 100%, wrap = true, textColor = { provided("theme").textMuted },
            text = "A sheet whose edge is the bottom floats as a card on a wide screen and rises from the bottom on a phone." ],
        Button [ label = "Copy link",
            onClick() { app.share.close(); app.toast.say("Link copied", null) }
            ]
        ],

    toast: Toast [ picked(id: string) { app.lastOverlay = "toast: " + id }
        ],

    stackMenu: Menu [ items = { [ ({ id: "duplicate", label: "Duplicate" }), ({ id: "toast", label: "Show a toast" }) ] },
        picked(id: string) {
            if (id == "toast") app.toast.say("A toast above the dialog", ({ id: "undo", label: "Undo" }))
            app.lastOverlay = "menu: " + id
            }
        ],
    stacked: Dialog [ title = "A dialog with a menu",
        message = "Open the menu from here: it paints above the dialog, and Esc closes the menu first, then the dialog.",
        buttons = { [ ({ id: "done", label: "Done", default: true }) ] },
        Button [ label = "More…", menu = { app.stackMenu } ]
        ],

    // ── the top bar: fixed height — brand · pages · styling · light/dark ───

    bar: View [ x = 0, y = 0, width = { app.width }, height = { app.barH }, fill = { provided("theme").surface },

        // the rule under the bar is the bar's own bottom edge — a per-side stroke,
        // not a child view

        stroke = { [null, null, stroke(1, provided("theme").line), null] },

        brand: View [ x = 20, y = 15, height = 22,
            layout: SimpleLayout [ axis = x, spacing = 5 ],

            // "Declare" is the way home — navigate() resolves against the
            // distro root, so this works on either host at any mount point

            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                textFill = { gradient("90deg", provided("theme").accent, provided("theme").accentSecondary) }, text = "Declare",
                onClick() { app.navigate("apps/homepage/homepage.declare") }
                ],

            // on a narrow bar the app name hides first, leaving "Declare"

            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                visible = { !app.compact }, text = "Sampler" ]
            ],

        // the page switch is the library's TabBar: a Segmented that acts as tabs

        pageSwitch: TabBar [ y = { app.compact ? 52 : 11 },
            x = { app.compact ? (app.width - this.width) / 2 : Math.max(200, (app.width - this.width) / 2) },
            segMin = { app.compact ? Math.min(92, (app.width - 32) / 5) : 92 },
            value = { app.page },
            input(v: object) { app.page = v as "controls" | "table" | "grid" | "overlays" | "more" },
            choices = { [ ({ id: "controls", label: "Controls" }),
                          ({ id: "table",    label: "Table" }),
                          ({ id: "grid",     label: "DataGrid" }),
                          ({ id: "overlays", label: "Overlays" }),
                          ({ id: "more",     label: "More" }) ] }
            ],

        // at the right end: the STYLING door — a button with a menu (the
        // chevron and the anchored open come with Control's `menu` role),
        // holding the stylings, the tints and the flourish — and the light /
        // dark switch, which shows the appearance in force; until a press
        // flips it, `themeMode` stays "auto" and the OS decides

        right: View [ x = end, y = 10, padding = [0, 14, 0, 0],
            layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
            styling: Button [ height = 30, label = "Styling", menu = { app.stylingMenu } ],
            appear: AppearanceSwitch [
                dark = { app.darkUI },
                input(v: boolean) { app.themeMode = v ? "dark" : "light" }
                ]
            ]
        ],

    // ── the page: everything below the bar scrolls ─────────────────────────

    content: View [ x = 0, y = { app.barH }, width = { app.width }, height = { app.height - app.barH },
        scrolls = y, clip = true,

        col: View [ y = 24,
            x = { app.narrow ? 16 : 32 },
            width = { Math.min(960, app.width - (app.narrow ? 32 : 64)) },
            padding = [0, 0, 64, 0],
            layout: SimpleLayout [ axis = y, spacing = 24 ],

            // ── Controls page: specimen cards, two balanced columns ────────

            grid: View [ visible = { app.page == "controls" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "Controls",
                layout: ResponsiveLayout [ plan = { [
                    ({ from: 876, flow: "row",   gap: 32, share: ({ left: 50, right: 50 }) }),
                    ({ from: 0, flow: "stack", gap: 20, share: ({ left: 100, right: 100 }) })] } ],

                left: View [
                    layout: SimpleLayout [ axis = y, spacing = 20 ],

                    Specimen [ label = "Buttons",
                        row: View [
                            layout: SimpleLayout [ axis = x, spacing = 12 ],
                            Button [ width = { app.compact ? 94 : 110 }, label = "Primary", primary = true, tooltipLabel = "The accent action" ],
                            Button [ width = { app.compact ? 94 : 110 }, label = "Secondary", primary = false ],
                            Button [ width = { app.compact ? 94 : 110 }, label = "Disabled", disabled = true, tooltipLabel = "Disabled — but the tip still shows" ]
                            ]
                        ],

                    Specimen [ label = "Checkbox · Switch · Radio",
                        row: View [
                            layout: SimpleLayout [ axis = x, spacing = 24 ],
                            Checkbox [ label = "Notifications", checked = true ],
                            Switch [ checked = true, accessibilityLabel = "Wi-Fi" ],
                            Switch [ accessibilityLabel = "Bluetooth" ],
                            RadioGroup [ value = "m",
                                Radio [ choice = "s", label = "S" ],
                                Radio [ choice = "m", label = "M" ],
                                Radio [ choice = "l", label = "L" ]
                                ]
                            ]
                        ],

                    Specimen [ label = "Segmented",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 10 ],
                            Segmented [ width = { Math.min(260, parent.width) }, value = { app.span },
                                accessibilityLabel = "Span",
                                choices = { [ ({ id: "day", label: "Day" }),
                                              ({ id: "week", label: "Week" }),
                                              ({ id: "month", label: "Month" }) ] },
                                input(v: string) { app.span = v }
                                ],
                            Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                                text = { "showing a " + app.span } ]
                            ],
                        size: View [ width = 100%,
                            layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
                            TextSizeSwitch [ value = { app.readScale },
                                input(v: object) { app.readScale = v as number }
                                ],
                            Text [ fontSize = { 13 * app.readScale }, textColor = { provided("theme").textMuted }, text = "Text at this size" ]
                            ]
                        ],

                    Specimen [ label = "Slider · Progress · Gauge",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 14 ],
                            vol: Slider [ width = { Math.min(280, parent.width) }, value = 40, tooltipLabel = "Volume — arrows nudge", accessibilityLabel = "Volume" ],
                            ProgressBar [ width = { Math.min(280, parent.width) }, value = { parent.vol.value }, accessibilityLabel = "Volume level" ],
                            Gauge [ width = { Math.min(280, parent.width) }, label = "Storage", value = 72 ]
                            ]
                        ],

                    Specimen [ label = "Combobox",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 10 ],
                            cb: Combobox [ width = 250, placeholder = "Assignee…",
                                items = { [
                                    ({ id: "ada", label: "Ada Lovelace" }),
                                    ({ id: "alan", label: "Alan Turing" }),
                                    ({ id: "grace", label: "Grace Hopper" }),
                                    ({ id: "edsger", label: "Edsger Dijkstra" }),
                                    ({ id: "barbara", label: "Barbara Liskov" }),
                                ] } ],
                            cap: Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                                text = { "chosen: " + (parent.cb.value != null ? (parent.cb.value as any).label : "none") } ]
                            ]
                        ],

                    Specimen [ label = "Context menu",
                        pad: View [ width = 100%, height = 74,
                            cornerRadius = 8, fill = { provided("theme").background }, stroke = { stroke(1, provided("theme").line) },
                            onContextMenu(e: PointerEvent) { app.ctxMenu.open(this, e) },
                            onHold(e: PointerEvent) { app.ctxMenu.open(this, e) },
                            Text [ x = 14, y = 14, fontSize = 13, textColor = { provided("theme").textMuted },
                                text = "Right-click (or long-press) in this box." ],
                            got: Text [ x = 14, y = 40, fontSize = 12, textColor = { provided("theme").textMuted },
                                text = { "picked: " + app.lastCtx } ]
                            ]
                        ]
                    ],

                right: View [
                    layout: SimpleLayout [ axis = y, spacing = 20 ],

                    Specimen [ label = "Text input · Search field · Field",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 12 ],
                            TextInput [ width = { Math.min(280, parent.width) }, height = 30, placeholder = "Your name",
                                purpose = name ],
                            SearchField [ width = { Math.min(280, parent.width) }, placeholder = "Search documents" ],
                            Field [ label = "Email", labelWidth = 72,
                                TextInput [ width = 200, height = 30, text = "d@t.com", purpose = email, accessibilityLabel = "Email" ]
                                ],

                            // `purpose = password` hides what is typed and lets a password manager fill it

                            Field [ label = "Password", labelWidth = 72,
                                TextInput [ width = 200, height = 30, text = "hunter2", purpose = password, accessibilityLabel = "Password" ]
                                ]
                            ]
                        ],

                    Specimen [ label = "Menu",
                        row: View [
                            layout: SimpleLayout [ axis = x, spacing = 14 ],

                            // `menu` is the role — the chevron, the anchored open,
                            // the held-open styling and Down-to-open come with it

                            Button [ width = 130, label = "Options",
                                menu = { app.optionsMenu } ],
                            last: Text [ y = center, fontSize = 12, textColor = { provided("theme").textMuted },
                                text = { "picked: " + app.lastPick } ]
                            ]
                        ],

                    Specimen [ label = "Menu bar",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 10 ],
                            bar: MenuBar [
                                menus = { [ ({ id: "file", label: "File", items: [
                                                ({ id: "new", label: "New" }),
                                                ({ id: "open", label: "Open…" }),
                                                ({ divider: true }),
                                                ({ id: "close", label: "Close" }) ] }),
                                            ({ id: "edit", label: "Edit", items: [
                                                ({ id: "undo", label: "Undo" }),
                                                ({ divider: true }),
                                                ({ id: "cut", label: "Cut" }),
                                                ({ id: "copy", label: "Copy" }) ] }),
                                            ({ id: "view", label: "View", items: [
                                                ({ id: "zoom-in", label: "Zoom In" }),
                                                ({ id: "zoom-out", label: "Zoom Out" }) ] }) ] },
                                picked(id: string) { app.lastBar = id }
                                ],
                            Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                                text = { "picked: " + app.lastBar } ]
                            ]
                        ],

                    Specimen [ label = "Dialog",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 10 ],
                            row: View [ layout: SimpleLayout [ axis = x, spacing = 12 ],
                                Button [ width = 96, label = "Notice…",
                                    onClick() { app.dlg.notice("Saved", "Your changes were saved.", (id) => app.lastDialog = id) }
                                    ],
                                Button [ width = 96, label = "Ask…",
                                    onClick() { app.dlg.ask("Save changes?", "Your unsaved changes will be lost.", (id) => app.lastDialog = id) }
                                    ],
                                Button [ width = 96, label = "Error…",
                                    onClick() { app.dlg.error("Could not connect", "The server refused the connection.", (id) => app.lastDialog = id) }
                                    ]
                                ],
                            ans: Text [ fontSize = 12, textColor = { provided("theme").textMuted }, text = { "answered: " + app.lastDialog } ]
                            ]
                        ],

                    Specimen [ label = "TabBar",
                        demo: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 12 ],
                            TabBar [ width = { Math.min(260, parent.width) }, value = { app.pane },
                                choices = { [ ({ id: "general", label: "General" }),
                                              ({ id: "privacy", label: "Privacy" }),
                                              ({ id: "sync", label: "Sync" }) ] },
                                input(v: string) { app.pane = v }
                                ],
                            View [ visible = { app.pane == "general" },
                                accessibilityRole = tabPanel, accessibilityLabel = "General",
                                Checkbox [ label = "Open at login", checked = true ]
                                ],
                            View [ visible = { app.pane == "privacy" },
                                accessibilityRole = tabPanel, accessibilityLabel = "Privacy",
                                Checkbox [ label = "Share usage data" ]
                                ],
                            View [ visible = { app.pane == "sync" },
                                accessibilityRole = tabPanel, accessibilityLabel = "Sync",
                                Checkbox [ label = "Sync over cellular" ]
                                ]
                            ]
                        ],

                    Specimen [ label = "Accordion",
                        acc: Accordion [ width = 100%,
                            Pane [ label = "First", initial = true,
                                View [ width = 100%, height = 64, fill = { provided("theme").background },
                                    Button [ x = 12, y = center, width = 110, label = "In pane 1" ]
                                    ]
                                ],
                            Pane [ label = "Second",
                                View [ width = 100%, height = 64, fill = { provided("theme").background },
                                    Button [ x = 12, y = center, width = 110, label = "In pane 2" ]
                                    ]
                                ],
                            Pane [ label = "Third",
                                View [ width = 100%, height = 56, fill = { provided("theme").background },
                                    Text [ x = 12, y = 10, textColor = { provided("theme").textMuted }, text = "A taller third pane." ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ],

            // ── Table page: the ruled selection model, at real height ──────

            tablePage: View [ visible = { app.page == "table" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "Table",
                layout: SimpleLayout [ axis = y, spacing = 10 ],
                Text [ fontSize = 12, fontWeight = semibold, letterSpacing = 1.2,
                    textColor = { provided("theme").textMuted }, text = "TABLE — THE RULED SELECTION MODEL" ],
                tbl: Table [ width = 100%, accessibilityLabel = "Cities",
                    height = { Math.max(240, app.height - app.barH - 190) },
                    datapath = { app.cities.value }, selects = "multi",
                    fill = { provided("theme").surface }, stroke = { stroke(1, provided("theme").line) }, cornerRadius = 8,
                    TableRow [ datapath = :rows[], height = 30,
                        n: Text [ x = 12, y = center, fontSize = 13, text = :name ],
                        p: Text [ x = 260, y = center, fontSize = 13, textColor = { provided("theme").textMuted }, text = :pop ]
                        ]
                    ],
                cap: Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                    text = { "Click, ⇧-range, ⌘-toggle; arrows + Space from the keyboard.  Selected: "
                           + (((parent.tbl.selection ?? []).map((r) => r.name).join(", ")) || "none") } ]
                ],

            // ── DataGrid page: 500 windowed rows, live cells ───────────────

            gridPage: View [ visible = { app.page == "grid" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "DataGrid",
                layout: SimpleLayout [ axis = y, spacing = 10 ],
                Text [ fontSize = 12, fontWeight = semibold, letterSpacing = 1.2, padding = [0, 0, 32, 0],
                    textColor = { provided("theme").textMuted },
                    text = "DATAGRID — 500 ROWS, WINDOWED; EVERY CELL WRITES THE RECORD" ],
                grid: DataGrid [ width = 100%, accessibilityLabel = "Tasks",
                    height = { Math.max(280, app.height - app.barH - 220) },
                    datapath = { app.gd.value }, selects = "multi",
                    fill = { provided("theme").surface }, stroke = { stroke(1, provided("theme").line) }, cornerRadius = 8,
                    widths = { app.gridNarrow
                        ? ({ id: 34, title: 116, state: 84, owner: 74, done: 44, ...(app.gridWidths ?? ({})) })
                        : app.gridWidths },
                    resizeInput(id: string, w: number) {
                        app.gridWidths = ({ ...(app.gridWidths ?? ({})), [id]: w })
                        },
                    sortInput(on: string, dir: string) {
                        sortOn = on
                        sortDir = dir
                        app.resort(on, dir)
                        },
                    Column [ title = "#", field = "id", width = 56 ],
                    Column [ title = "Title", field = "title", width = 250, kind = "edit" ],
                    Column [ title = "State", field = "state", width = 120, kind = "select",
                        options = { ["open", "triage", "done"] } ],
                    Column [ title = "Owner", field = "owner", width = 120, kind = "select",
                        options = { ["ada", "alan", "grace", "edsger"] } ],
                    Column [ title = "Done", field = "done", width = 64, kind = "check" ],
                    GridRow [ datapath = :rows[], virtualize = true ]
                    ],
                cap: Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                    text = "Title edits live; State and Owner pick from a menu; Done is a checkbox — every edit writes the record. Drag headers to reorder, edges to resize, click to sort. From the keyboard: arrows move the active cell, Enter or typing edits, Esc puts it back." ]
                ],

            // ── More page: more controls, two balanced columns ──────────────

            morePage: View [ visible = { app.page == "more" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "More",
                layout: ResponsiveLayout [ plan = { [
                    ({ from: 876, flow: "row",   gap: 32, share: ({ left: 50, right: 50 }) }),
                    ({ from: 0, flow: "stack", gap: 20, share: ({ left: 100, right: 100 }) })] } ],

                left: View [
                    layout: SimpleLayout [ axis = y, spacing = 20 ],

                    Specimen [ label = "Disclosure",
                        stack: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 2 ],
                            Disclosure [ width = 100%, label = "Advanced options",
                                Checkbox [ label = "Keep a log" ],
                                Checkbox [ label = "Check for updates" ]
                                ],
                            Disclosure [ width = 100%, label = "Details",
                                Text [ width = 100%, wrap = true, fontSize = 13, textColor = { provided("theme").textMuted },
                                    text = "Any number may be open at once; an Accordion keeps one." ]
                                ]
                            ]
                        ],

                    Specimen [ label = "Stepper",
                        copies: number = 2,
                        row: View [
                            layout: SimpleLayout [ axis = x, spacing = 12, align = center ],
                            Stepper [ value = { parent.parent.copies }, min = 1, max = 99, accessibilityLabel = "Copies",
                                input(v: number) { (parent.parent as any).copies = v }
                                ],
                            Text [ fontSize = 13, textColor = { provided("theme").textMuted }, text = { parent.parent.copies + " copies" } ],
                            Stepper [ value = 12, min = 6, max = 72, accessibilityLabel = "Text size",
                                format(v: number) -> string { return v + " pt" }
                                ]
                            ]
                        ],

                    Specimen [ label = "Toolbar",
                        bold: boolean = true,
                        italic: boolean = false,
                        Toolbar [ accessibilityLabel = "Formatting",
                            ToolButton [ label = "B", toggle = true, accessibilityLabel = "Bold",
                                on = { parent.parent.bold },
                                input(v: boolean) { (parent.parent as any).bold = v }
                                ],
                            ToolButton [ label = "I", toggle = true, accessibilityLabel = "Italic",
                                on = { parent.parent.italic },
                                input(v: boolean) { (parent.parent as any).italic = v }
                                ],
                            ToolbarDivider [ ],
                            ToolButton [ label = "Cut" ],
                            ToolButton [ label = "Copy" ],
                            ToolbarDivider [ ],
                            ToolButton [ icon = "PlusIcon", label = "Add" ],
                            ToolButton [ icon = "MinusIcon", label = "Remove" ]
                            ],
                        Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                            text = "One Tab stop: the arrows move along it, Space or Enter presses." ]
                        ],

                    Specimen [ label = "Tree",
                        Tree [ width = 100%, accessibilityLabel = "Files", value = "notes",
                            expanded = ["docs", "pics"],
                            items = { [
                                ({ id: "docs", label: "Documents", children: [
                                    ({ id: "notes", label: "Notes.txt" }),
                                    ({ id: "plans", label: "Plans", children: [
                                        ({ id: "q1", label: "Q1.txt" }), ({ id: "q2", label: "Q2.txt" }) ] }) ] }),
                                ({ id: "pics", label: "Pictures", children: [
                                    ({ id: "beach", label: "Beach.jpg" }), ({ id: "hills", label: "Hills.jpg" }) ] }),
                                ({ id: "todo", label: "To do" }) ] } ],
                        Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                            text = "Up and Down move, Right opens or steps in, Left closes or steps out." ]
                        ]
                    ],

                right: View [
                    layout: SimpleLayout [ axis = y, spacing = 20 ],

                    Specimen [ label = "Breadcrumb",
                        at: string = "layout",
                        Breadcrumb [
                            items = { [ ({ id: "home", label: "Home" }),
                                        ({ id: "guide", label: "Guide" }),
                                        ({ id: "layout", label: "Layout" }) ] },
                            input(id: string) { (parent as any).at = id }
                            ],
                        Text [ fontSize = 12, textColor = { provided("theme").textMuted }, text = { "last pressed: " + parent.at } ]
                        ],

                    Specimen [ label = "Splitter",
                        panes: View [ width = 100%, height = 140, clip = true, cornerRadius = 8,
                            stroke = { stroke(1, provided("theme").line) },
                            layout: SimpleLayout [ axis = x ],
                            side: View [ width = { parent.split.value }, height = 100%, fill = { provided("theme").background },
                                Text [ x = 12, y = 12, fontSize = 13, text = "Mailboxes" ]
                                ],
                            split: Splitter [ value = 140, min = 90, max = 260, accessibilityLabel = "Sidebar width" ],
                            main: View [ width = { parent.width - parent.side.width - parent.split.width }, height = 100%,
                                Text [ x = 12, y = 12, fontSize = 13, text = { "Message — sidebar " + parent.parent.split.value + " px" } ]
                                ]
                            ]
                        ],

                    Specimen [ label = "Date picker · Month calendar",
                        day: string = "2026-10-18",
                        row: View [ width = 100%,
                            layout: SimpleLayout [ axis = y, spacing = 16 ],
                            Field [ label = "Due",
                                DatePicker [ width = 150, value = { parent.parent.parent.day },
                                    input(v: string) { (parent.parent.parent as any).day = v }
                                    ]
                                ],
                            MonthCalendar [ value = { parent.parent.day },
                                input(v: string) { (parent.parent as any).day = v }
                                ]
                            ]
                        ],

                    Specimen [ label = "Window",
                        notesOpen: boolean = true,
                        stage: View [ width = 100%, height = 280, clip = true, cornerRadius = 8,
                            fill = { provided("theme").background },
                            Window [ x = 14, y = 14, width = 210, height = 170, title = "Settings",
                                View [ width = 100%, padding = 14,
                                    layout: SimpleLayout [ axis = y, spacing = 10 ],
                                    Checkbox [ label = "Line numbers" ],
                                    Checkbox [ label = "Wrap lines" ]
                                    ]
                                ],
                            Window [ x = 150, y = 80, width = 220, height = 180, title = "Notes", resizable = true,
                                open = { parent.parent.notesOpen },
                                input(v: boolean) { (parent.parent as any).notesOpen = v },
                                View [ width = 100%, padding = 14,
                                    layout: SimpleLayout [ axis = y, spacing = 10 ],
                                    TextInput [ width = 100%, placeholder = "Title" ]
                                    ]
                                ]
                            ],
                        Button [ label = "Show notes", disabled = { parent.notesOpen },
                            onClick() { (parent as any).notesOpen = true }
                            ]
                        ]
                    ]
                ],

            // ── Overlays page: every kind of Floating, opened from a card ──

            overlaysPage: View [ visible = { app.page == "overlays" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "Overlays",
                layout: SimpleLayout [ axis = y, spacing = 16 ],
                Text [ fontSize = 12, fontWeight = semibold, letterSpacing = 1.2,
                    textColor = { provided("theme").textMuted }, text = "OVERLAYS — EACH PAINTS ABOVE ITS CONTEXT, CLOSES AS ITS KIND DOES" ],

                Specimen [ label = "Popover",
                    View [ layout: SimpleLayout [ axis = x, spacing = 16, align = center ],
                        Button [ label = "Text size…",
                            onClick() { app.sizer.showFor(this) }
                            ],
                        Text [ fontSize = { app.textSize }, textColor = { provided("theme").text }, text = "The quick brown fox" ]
                        ],
                    Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                        text = "Anchored to its button, follows it as the page scrolls; a press outside closes it and still lands." ]
                    ],

                Specimen [ label = "Dialog",
                    View [ layout: SimpleLayout [ axis = x, spacing = 12 ],
                        Button [ label = "Ask…",
                            onClick() { app.dlg.ask("Save changes?", "Your unsaved changes will be lost.", (id) => app.lastOverlay = "ask: " + id) }
                            ],
                        Button [ label = "Rename…",
                            onClick() { app.rename.show() }
                            ],
                        Button [ label = "Full screen…",
                            onClick() { app.viewer.show() }
                            ]
                        ],
                    Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                        text = { "Document: " + app.docName + " · " + app.lastOverlay } ]
                    ],

                Specimen [ label = "Sheet",
                    View [ layout: SimpleLayout [ axis = x, spacing = 12 ],
                        Button [ label = "Preferences…",
                            onClick() { app.prefs.show() }
                            ],
                        Button [ label = "Share…",
                            onClick() { app.share.show() }
                            ]
                        ],
                    Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                        text = "Preferences slides in from the end edge; Share floats as a card — both rise from the bottom on a phone." ]
                    ],

                Specimen [ label = "Toast",
                    View [ layout: SimpleLayout [ axis = x, spacing = 12 ],
                        Button [ label = "Copy",
                            onClick() { app.toast.say("Copied", null) }
                            ],
                        Button [ label = "Delete",
                            onClick() { app.toast.say("Item deleted", ({ id: "undo", label: "Undo" })) }
                            ]
                        ],
                    Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                        text = "Takes no focus, blocks nothing, goes by itself." ]
                    ],

                Specimen [ label = "Stacking",
                    View [ layout: SimpleLayout [ axis = x, spacing = 12 ],
                        Button [ label = "Dialog with a menu…",
                            onClick() { app.stacked.show() }
                            ],
                        Button [ label = "With a tooltip", tooltipLabel = "Tooltips paint above everything too" ]
                        ],
                    Text [ fontSize = 12, textColor = { provided("theme").textMuted },
                        text = "A menu over a dialog, a toast over both; Esc closes the topmost." ]
                    ]
                ]
            ]
        ]
    ]
