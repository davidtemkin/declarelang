/*
# The control sampler

The library's controls under four switchable stylings — San Francisco (the
default), Mountain View, Cupertino, and Redmond. One machinery, four token
records: the stylings are **data**, never code paths.

The chrome is a fixed-height top bar: the brand at left (compacting to just
"Declare" when narrow), the page switch in the center (Controls · Forms ·
Table · DataGrid · Overlays · More), and at right a Styling button whose menu holds
the four stylings, the accent-tint dot row and the focus-animation toggle,
beside the light/dark switch — the whole styling rig, off the page. The
Controls, Forms and More pages read as cards, two columns wide, one below the
breakpoint the cards actually need.
*/

use [ TintRow ]   // the styling menu names its tint row in data

// A custom menu row: the items data names it (`kind: "TintRow"`) and the menu
// creates it by name (hence the `use` above). Each dot handles its own click:
// it applies the accent and closes the menu itself.

class TintDot [ width = 16, height = 16,
    c: Color = #2E6FE0,
    onClick() { app.accentPick = app.accentPick == c ? 0 : c || 0; app.stylingMenu.close() },

    // the hovered dot enlarges in place: a scaled view takes the room it is drawn
    // at, so the box the row lays out stays 16 and the dot inside it grows

    dot: View [ width = 16, height = 16, cornerRadius = 8,
        scale = { classroot.hovered ? 1.4 : 1 },
        pivotX = 8,
        pivotY = 8,
        fill = { classroot.c },
        stroke = { classroot.hovered ? stroke(2, provided("theme").text) : app.accentPick == classroot.c ? stroke(2, provided("theme").textMuted) : null } ]
    ]


// The dots row: color and the selected ring say everything, so there is no
// caption. Clicking the selected dot again clears the tint.

class TintRow [
    height = 22,

    dots: View [ x = 0, y = 3,
        layout: SimpleLayout [ axis = x, spacing = 7 ],
        TintDot [ c = #2E6FE0 ],
        TintDot [ c = #6750A4 ],
        TintDot [ c = #E0447E ],
        TintDot [ c = #D03A2F ],
        TintDot [ c = #3A9E4C ]
        ]
    ]


// A specimen card: the library's `Card` — its surface, hairline and inset —
// with an eyebrow label stacked above the use site's content. The card has an
// inside, so a specimen's content is written with no coordinates at all, and
// the card's height falls out of what it holds.

class Specimen extends Card [ width = 100%,
    label: string = "",
    cornerRadius = 10,
    padding = [14, 16, 16, 16],                      // the eyebrow sits a little higher than it is deep
    layout: SimpleLayout [ axis = y, spacing = 17 ],   // eyebrow, then the specimen
    hd: Text [ fontSize = 11.5, fontWeight = semibold, letterSpacing = 1.1,
        textColor = { provided("theme").textMuted }, text = { label.toUpperCase() } ]
    ]


// ── The DataGrid's cells. A column names the class its cells draw; each copy
//    is bound to its own row's record, so `:done` is that row's `done`.

// A checkbox over the record's `done`.

class DoneCell [ width = 100%, height = 100%,
    Checkbox [ x = center, y = center, label = "", accessibilityLabel = "Done",
        checked = :done,
        commit(v: boolean) { :done = v }
        ]
    ]


// A value picked from a short list: a button that drops the App's one pick
// menu (a control's `menu`), which reads the button's cell for its choices
// and hands the pick back to it. The field and the choices are the subclass's.

class PickCell [ width = 100%, height = 100%,
    field: string = "",
    choices: array = [],
    value: string = { "" + (:@[(classroot.field)] ?? "") },
    choose(v: string) { :@[(field)] = v },
    button: Control [ x = 2, y = 2, width = { parent.width - 4 }, height = { parent.height - 4 },
        cornerRadius = { provided("theme").gridCellCornerRadius + 2 },
        accessibilityLabel = { classroot.field },
        menu = { app.pickMenu },
        fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
        TextLabel [ x = 6, fontSize = { provided("theme").gridFontSize }, wrap = false, text = { classroot.value } ],
        ChevronIcon [ y = center, x = { parent.width - this.width - 6 }, iconSize = 11,
            ink = { provided("theme").textMuted } ]
        ]
    ]


// ── A one-time code drawn as cells. It is ONE text field — the platform's
//    autofill, paste, Undo and its single name to a screen reader all hold — whose
//    own text and caret are hidden (a transparent text color hides both), drawn by
//    a row of cells that read what it shows; the next cell is ringed while it has
//    the focus.

class CodeCell [ width = { (parent.width - 5 * 8) / 6 }, height = 48, cornerRadius = 8,
    at: number = 0,
    field: TextInput? = { parent.parent as TextInput },
    next: boolean = { classroot.field != null && classroot.field.focused && Math.min(5, (classroot.field.shown as string).length) == classroot.at },
    fill = { provided("theme").surface },
    stroke = { stroke(classroot.next ? 2 : 1, classroot.next ? provided("theme").accent : provided("theme").line) },
    TextLabel [ x = center, y = center, fontSize = 20, fontWeight = semibold, numeralWidth = tabular,
        textColor = { provided("theme").text },
        text = { ((classroot.field?.shown ?? "") as string).charAt(classroot.at) } ]
    ]


class CodeField extends TextInput [ height = 48, purpose = oneTimeCode, padding = 0,
    textColor = #00000000, fill = #00000000, stroke = null,
    admit(t: string) -> string { return t.replace(/[^0-9]/g, "").slice(0, 6) },
    cells: View [ width = 100%, height = 100%, pointerEvents = "none",
        layout: SimpleLayout [ axis = x, spacing = 8 ],
        CodeCell [ at = 0 ],
        CodeCell [ at = 1 ],
        CodeCell [ at = 2 ],
        CodeCell [ at = 3 ],
        CodeCell [ at = 4 ],
        CodeCell [ at = 5 ]
        ]
    ]


// ── The Forms page's form. Its values are its own attributes, each bound to its
//    control with `<->`; the form judges every control inside it, and the
//    pretend service refuses one address, which lands under the email field.

class SignUp extends Form [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 14 ],
    name: string = "",
    email: string = "",
    phone: string = "",
    password: string = "",
    confirm: string = "",
    country: object = null,
    start: string = "",
    plan: string = "personal",
    news: boolean = false,
    terms: boolean = false,
    done: string = "",

    Field [ width = 100%, label = "Name", stacked = true,
        TextInput [ width = 100%, name = "name", purpose = name, required = "Enter your name.",
            value <-> classroot.name ]
        ],
    Field [ width = 100%, label = "Email", stacked = true,
        TextInput [ width = 100%, name = "email", purpose = email, required = "Enter your email address.",
            value <-> classroot.email,
            validate(v: string) -> string { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? "" : "Enter an address like name@example.com." }
            ]
        ],
    Field [ width = 100%, label = "Phone (optional)", stacked = true,
        TextInput [ width = 100%, name = "phone", purpose = tel,
            value <-> classroot.phone,
            admit(t: string) -> string | null { return /^[0-9 +()-]{0,20}$/.test(t) ? t : null }
            ]
        ],
    Field [ width = 100%, label = "Password", stacked = true,
        TextInput [ width = 100%, name = "password", purpose = newPassword, required = "Choose a password.",
            value <-> classroot.password,
            validate(v: string) -> string { return v.length >= 8 ? "" : "Use at least 8 characters." }
            ]
        ],
    Field [ width = 100%, label = "Confirm password", stacked = true,
        TextInput [ width = 100%, name = "confirm", purpose = newPassword, required = "Type the password again.",
            value <-> classroot.confirm,
            validate(v: string) -> string { return v == classroot.password ? "" : "The passwords don't match." }
            ]
        ],
    Field [ width = 100%, label = "Country", stacked = true,
        Combobox [ width = 100%, name = "country", placeholder = "Search countries", required = "Choose a country.",
            items = { ["Australia", "Brazil", "Canada", "France", "Germany", "India", "Japan", "Kenya", "Mexico", "Norway", "Spain", "United Kingdom", "United States"] },
            value <-> classroot.country ]
        ],
    Field [ width = 100%, label = "Start date", stacked = true,
        DatePicker [ width = 180, name = "start", value <-> classroot.start ]
        ],
    RadioGroup [ name = "plan", value <-> classroot.plan, accessibilityLabel = "Plan",
        layout: SimpleLayout [ axis = x, spacing = 16 ],
        Radio [ choice = "personal", label = "Personal" ],
        Radio [ choice = "team", label = "Team" ]
        ],
    Checkbox [ label = "Send me product news", checked <-> classroot.news ],

    // a checkbox says its own sentence, so its message goes under it here, not in a Field

    termsBox: Checkbox [ name = "terms", label = "I agree to the terms", required = "Agree to the terms to continue.",
        checked <-> classroot.terms ],
    Text [ visible = { classroot.termsBox.error != "" }, width = 100%, fontSize = 13,
        textColor = { provided("theme").error }, text = { classroot.termsBox.error } ],
    Text [ visible = { classroot.error != "" }, width = 100%, wrap = true, fontSize = 13,
        textColor = { provided("theme").error }, text = { classroot.error } ],
    Button [ label = { classroot.pending ? "Creating…" : "Create account" }, primary = true,
        disabled = { classroot.pending },
        onClick() { classroot.submit() }
        ],
    Text [ visible = { classroot.done != "" }, width = 100%, wrap = true, fontSize = 13,
        textColor = { provided("theme").textMuted }, text = { classroot.done } ],

    // the pretend service: a moment's wait, then one address is taken

    send() {
        pending = true
        afterDelay(700, () => {
            this.pending = false
            if (this.email.trim().toLowerCase() == "taken@example.com") {
                this.refuse([({ name: "email", message: "That address already has an account." })])
                return
                }
            this.done = "Welcome, " + this.name + " — " + this.plan + " plan" + (this.news ? ", with product news." : ".")
            })
        }
    ]


class StateCell extends PickCell [ field = "state", choices = { ["open", "triage", "done"] } ]

class OwnerCell extends PickCell [ field = "owner", choices = { ["ada", "alan", "grace", "edsger"] } ]

App [ fill = { provided("theme").background }, textColor = { provided("theme").text }, minWidth = 320,
    roboto: Font [
        FontFace [ src = "../../assets/fonts/roboto/roboto-400.woff2" ],
        FontFace [ src = "../../assets/fonts/roboto/roboto-500.woff2", weight = medium ]
        ],

    // ── the responsive facts, each scoped to what it governs ───────────────

    compact: boolean = { app.width < 640 },      // the bar: brand drops "Sampler", tighter segments
    narrow: boolean = { app.width < 940 },       // the page column: tighter side margins
    gridNarrow: boolean = { app.width < 760 },   // the grid: the narrow column-width set

    barH: number = { app.compact ? 92 : 52 },    // fixed for a width — on a narrow one the page switch takes a second row

    page: "controls" | "forms" | "table" | "grid" | "overlays" | "more" = "controls",      // the center switch

    // the Forms page's specimens of editing, one fact each

    size: number = 32,
    code: string = "",
    note: string = "First draft",
    level: number = 40,
    commits: number = 0,
    style: "sanFrancisco" | "mountainView" | "cupertino" | "redmond" = "sanFrancisco",
    menuLocked: boolean = true,
    lastPick: string = "(none yet)",
    lastCtx: string = "(none yet)",
    span: string = "week",
    readScale: number = 1,
    pane: string = "general",
    lastBar: string = "(none yet)",
    themeMode: "auto" | "light" | "dark" = "auto",          // orthogonal to the styling
    darkUI: boolean = { themeMode == "dark" || (themeMode == "auto" && app.systemDark) },
    animateFocus: boolean = true,
    accentPick: number = 0,                      // 0 = the mode's own accent; a pick overrides it everywhere

    // the library presets, by city and mode: SanFrancisco / MountainView /
    // Cupertino / Redmond and their …Dark companions

    preset: Theme = { ({ sanFrancisco: darkUI ? SanFranciscoDark : SanFrancisco, mountainView: darkUI ? MountainViewDark : MountainView, cupertino: darkUI ? CupertinoDark : Cupertino, redmond: darkUI ? RedmondDark : Redmond })[style] },

    theme = { {
        ...app.preset,
        // the brand gradient's second stop — the family's teal, as docs and
        // the calendar name it; no preset carries it
        accentSecondary: darkUI ? 0x37E0C8 : 0x12A594,
        focusAnimate: animateFocus,
        // Redmond's focus ring appears in place ("rest"); with focus animation
        // switched on, the app overrides that one token to "both" so it moves
        // too. The preset stays as shipped.
        ...(style == "redmond" && animateFocus ? ({ focusRingStyle: "both" }) : ({})),
        ...(accentPick != 0 ? ({ accent: accentPick, controlSelected: activeTone(accentPick, app.preset.surface) }) : ({})),
    } },

    // the type stack is part of the styling: Roboto for Mountain View, the system face for Cupertino

    fontFamily = { ({ sanFrancisco: "system-ui, sans-serif", mountainView: [app.roboto, "system-ui", "sans-serif"], cupertino: "-apple-system, system-ui, sans-serif", redmond: "'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif" })[style] },

    // ── data: the Table's cities; the DataGrid's issues (app-owned — seeded
    //    once, so cell edits persist; the sort verb reorders the data) ──────

    cities: Dataset { {
        "rows": [
            { "id": "sf",  "name": "San Francisco", "pop": "808,000" },
            { "id": "cu",  "name": "Cupertino",     "pop": "57,000" },
            { "id": "mv",  "name": "Mountain View", "pop": "81,000" },
            { "id": "re",  "name": "Redmond",       "pop": "78,000" },
            { "id": "au",  "name": "Austin",        "pop": "979,000" },
            { "id": "po",  "name": "Portland",      "pop": "635,000" },
            { "id": "se",  "name": "Seattle",       "pop": "755,000" },
            { "id": "ch",  "name": "Chicago",       "pop": "2,665,000" },
            { "id": "ny",  "name": "New York",      "pop": "8,258,000" },
            { "id": "bo",  "name": "Boston",        "pop": "654,000" }
        ]
    } },

    gd: Dataset { { "rows": [] } },

    // the grid's column widths, app-owned: user resizes merge here, and on a
    // narrow window they override the narrow defaults

    gridWidths: object = null,

    issueRows() -> array {
        const states = ["open", "triage", "done"]
        const owners = ["ada", "alan", "grace", "edsger"]
        return Array.from({ length: 500 }, (_, i) => ({
            id: i + 1,
            title: "Issue " + (i + 1),
            state: states[i % 3],
            owner: owners[(i * 7) % 4],
            done: i % 4 == 0,
            }))
        },

    onInit() { gd.set(["rows"], this.issueRows()) },

    // the sort delivery's consumer: the app owns the data, so sorting is a
    // data verb — a reordered copy replaces the rows (identity by `id` keeps
    // every instance and every edit)

    // the one menu every pick cell drops: its items are the opening cell's
    // choices, the current one checked, and a pick goes back to that cell

    pickMenu: Menu [ minWidth = 150,
        items = { app.pickItems(opener) },
        picked(id: string) { const c = app.pickCellOf(opener); if (c != null) c.choose(id) }
        ],
    pickCellOf(o: View?) -> PickCell? { return o != null && o.parent != null && (o.parent as any).choices != null ? o.parent as PickCell : null },
    pickItems(o: View?) -> array {
        const c = app.pickCellOf(o)
        return c == null ? [] : c.choices.map((v) => ({ id: v, label: v, checked: v == c.value }))
        },

    resort(on: string, dir: string) {
        const rows = [...(gd.value.rows ?? [])]
        rows.sort((a, b) => {
            const va = (a as any)[on]
            const vb = (b as any)[on]
            const c = va < vb ? -1 : va > vb ? 1 : 0
            return dir == "desc" ? -c : c
            })
        gd.set(["rows"], rows)
        },

    // ── the STYLING menu — the styling rig as records: styling rows, the
    //    tint dots (the Finder idiom), the flourish. Light/dark is the bar's
    //    own switch, beside it. ───────────────────────────────────────────

    stylingMenu: Menu [
        width = 240,
        items = { [
            ({ id: "style:sanFrancisco", label: "San Francisco", checked: app.style == "sanFrancisco" }),
            ({ id: "style:mountainView", label: "Mountain View", checked: app.style == "mountainView" }),
            ({ id: "style:cupertino", label: "Cupertino", checked: app.style == "cupertino" }),
            ({ id: "style:redmond", label: "Redmond", checked: app.style == "redmond" }),
            ({ divider: true }),
            ({ kind: "TintRow" }),
            ({ divider: true }),
            ({ id: "animate", label: "Animate focus transitions", checked: app.animateFocus }),
        ] },
        picked(id: string) {
            if (id.startsWith("style:")) app.style = id.slice(6) as "sanFrancisco" | "mountainView" | "cupertino" | "redmond"
            else if (id == "animate") app.animateFocus = !app.animateFocus
            }
        ],

    // ── the options menu demo: the record vocabulary in one declaration ────

    optionsMenu: Menu [
        items = { [
            ({ id: "new", label: "New Event", key: "⌘N" }),
            ({ id: "dup", label: "Duplicate", key: "⌘D" }),
            ({ id: "lock", label: "Locked", checked: app.menuLocked }),
            ({ divider: true }),
            ({ id: "share", label: "Share", submenu: [
                ({ id: "mail", label: "Mail", key: "⌘M" }),
                ({ id: "messages", label: "Messages" }),
                ({ divider: true }),
                ({ id: "airdrop", label: "AirDrop" }),
            ] }),
            ({ divider: true }),
            ({ id: "delete", label: "Delete", key: "⌫", enabled: !app.menuLocked }),
        ] },
        picked(id: string) {
            if (id == "lock") app.menuLocked = !app.menuLocked
            app.lastPick = id
            }
        ],

    // the context menu, declared once; the view that offers it opens it from
    // its own onContextMenu and onHold handlers

    ctxMenu: ContextMenu [
        items = { [
            ({ id: "open", label: "Open" }),
            ({ id: "rename", label: "Rename…" }),
            ({ id: "duplicate", label: "Duplicate" }),
            ({ divider: true }),
            ({ id: "delete", label: "Delete", key: "⌫" }),
        ] },
        picked(id: string) { app.lastCtx = id }
        ],

    dlg: Dialog [ ],
    lastDialog: string = "(none yet)",

    // ── the Overlays page's overlays: each a Floating, declared once here ──

    textSize: number = 15,
    docName: string = "Untitled",
    lastOverlay: string = "(none yet)",

    sizer: Popover [
        Text [ fontWeight = semibold, textColor = { provided("theme").text }, text = { "Text size · " + app.textSize } ],
        Slider [ width = 200, min = 10, max = 32, value = { app.textSize }, accessibilityLabel = "Text size",
            commit(v: number) { app.textSize = Math.round(v) }
            ]
        ],

    rename: Dialog [ title = "Rename document",
        buttons = { [ ({ id: "cancel", label: "Cancel", cancel: true }), ({ id: "ok", label: "Rename", default: true }) ] },
        picked(id: string) { if (id == "ok" && this.nameField.value != "") app.docName = this.nameField.value; app.lastOverlay = "rename: " + id },

        // the document's name until the person edits it; then their draft

        nameField: TextInput [ width = 100%,
            draft: string = { app.docName },
            value = { draft },
            commit(t: string) { draft = t },
            accessibilityLabel = "Document name"
            ]
        ],

    viewer: Dialog [ presentation = "full",
        View [ width = 100%, height = 100%, fill = #101418,
            Text [ x = center, y = center, fontSize = 28, fontWeight = semibold, textColor = #F4F6FA, text = "A full-screen dialog" ],
            Text [ x = center, y = { parent.height - 60 }, fontSize = 13, textColor = #9AA4B0, text = "Esc closes it" ]
            ]
        ],

    prefs: Sheet [ edge = "end", accessibilityLabel = "Preferences",
        Text [ fontSize = 17, fontWeight = bold, textColor = { provided("theme").text }, text = "Preferences" ],
        Checkbox [ label = "Show line numbers", checked = true ],
        Checkbox [ label = "Wrap long lines" ],
        Checkbox [ label = "Autosave" ],
        Button [ label = "Done", primary = true,
            onClick() { app.prefs.close() }
            ]
        ],

    share: Sheet [ accessibilityLabel = "Share",
        Text [ fontSize = 17, fontWeight = bold, textColor = { provided("theme").text }, text = "Share" ],
        Text [ width = 100%, wrap = true, textColor = { provided("theme").textMuted },
            text = "A sheet whose edge is the bottom floats as a card on a wide screen and rises from the bottom on a phone." ],
        Button [ label = "Copy link",
            onClick() { app.share.close(); app.toast.say("Link copied") }
            ]
        ],

    toast: Toast [ picked(id: string) { app.lastOverlay = "toast: " + id }
        ],

    stackMenu: Menu [ items = { [ ({ id: "duplicate", label: "Duplicate" }), ({ id: "toast", label: "Show a toast" }) ] },
        picked(id: string) {
            if (id == "toast") app.toast.say("A toast above the dialog", ({ id: "undo", label: "Undo" }))
            app.lastOverlay = "menu: " + id
            }
        ],
    stacked: Dialog [ title = "A dialog with a menu",
        message = "Open the menu from here: it paints above the dialog, and Esc closes the menu first, then the dialog.",
        buttons = { [ ({ id: "done", label: "Done", default: true }) ] },
        Button [ label = "More…", menu = { app.stackMenu } ]
        ],

    // ── the top bar: fixed height — brand · pages · styling · light/dark ───

    bar: View [ x = 0, y = 0, width = { app.width }, height = { app.barH }, fill = { provided("theme").surface },

        // the rule under the bar is the bar's own bottom edge — a per-side stroke,
        // not a child view

        stroke = { [null, null, stroke(1, provided("theme").line), null] },

        brand: View [ x = 20, y = 15, height = 22,
            layout: SimpleLayout [ axis = x, spacing = 5 ],

            // "Declare" is the way home — navigate() resolves against the
            // distro root, so this works on either host at any mount point

            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                textFill = { gradient("90deg", provided("theme").accent, provided("theme").accentSecondary) }, text = "Declare",
                onClick() { app.navigate("apps/homepage/homepage.declare") }
                ],

            // on a narrow bar the app name hides first, leaving "Declare"

            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                visible = { !app.compact }, text = "Sampler" ]
            ],

        // the page switch is the library's TabBar: a Segmented that acts as tabs

        pageSwitch: TabBar [ y = { app.compact ? 52 : 11 },
            x = { app.compact ? (app.width - this.width) / 2 : Math.max(200, (app.width - this.width) / 2) },
            segMin = { app.compact ? Math.min(92, (app.width - 32) / 6) : 92 },
            value = { app.page },
            input(v: object) { app.page = v as "controls" | "forms" | "table" | "grid" | "overlays" | "more" },
            choices = { [ ({ id: "controls", label: "Controls" }),
                          ({ id: "forms",    label: "Forms" }),
                          ({ id: "table",    label: "Table" }),
                          ({ id: "grid",     label: "DataGrid" }),
                          ({ id: "overlays", label: "Overlays" }),
                          ({ id: "more",     label: "More" }) ] }
            ],

        // at the right end: the STYLING door — a button with a menu (the
        // chevron and the anchored open come with Control's `menu` role),
        // holding the stylings, the tints and the flourish — and the light /
        // dark switch, which shows the appearance in force; until a press
        // flips it, `themeMode` stays "auto" and the OS decides

        right: View [ x = end, y = 10, padding = [0, 14, 0, 0],
            layout: SimpleLayout [ axis = x, spacing = 8, align = center ],
            styling: Button [ height = 30, label = "Styling", menu = { app.stylingMenu } ],
            appear: AppearanceSwitch [
                dark = { app.darkUI },
                input(v: boolean) { app.themeMode = v ? "dark" : "light" }
                ]
            ]
        ],

    // ── the page: everything below the bar scrolls ─────────────────────────

    content: View [ x = 0, y = { app.barH }, width = { app.width }, height = { app.height - app.barH },
        scrolls = y, clip = true,

        col: View [ y = 24,
            x = { app.narrow ? 16 : 32 },
            width = { Math.min(960, app.width - (app.narrow ? 32 : 64)) },
            padding = [0, 0, 64, 0],
            layout: SimpleLayout [ axis = y, spacing = 24 ],

            // ── Controls page: specimen cards, two balanced columns ────────

            grid: View [ visible = { app.page == "controls" }, width = 100%,
                accessibilityRole = tabPanel, accessibilityLabel = "Controls",
                layout: ResponsiveLayout [ plan = { [
