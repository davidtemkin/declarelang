                                  { id: "owner", title: "Owner", width: 120, cell: "OwnerCell" },
                                  { id: "done",  title: "Done",  width: 64,  cell: "DoneCell" } ] }
                    ],
                cap: Text [ width = 100%, wrap = true, fontSize = 12, textColor = { provided("theme").textMuted },
                    text = "Title edits live; State and Owner pick from a menu; Done is a checkbox — every edit writes the record. Drag headers to reorder, edges to resize, click to sort. From the keyboard: arrows move the active cell, Enter or typing edits, Esc puts it back." ]
