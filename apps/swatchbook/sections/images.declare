/*
# Images

Every fit of a tall image and of a wide one; alignment within the box; tint;
and the box's own paint around an image.
*/

script {
    function imgFit(): Record<string, unknown>[] {
        return cross({ fit: ["none", "width", "height", "both", "cover", "contain"], shape: ["tall", "wide"] }, (r) => r.fit + " · " + r.shape + " box")
    }
    function imgAlign(): Record<string, unknown>[] {
        return cross({ ax: ["start", "center", "end"], ay: ["start", "center", "end"] }, (r) => "contain · " + r.ax + " / " + r.ay)
            .concat(cross({ ax: ["start", "end"], ay: ["start", "end"] }, (r) => "cover · " + r.ax + " / " + r.ay).map((r) => ({ ...r, cover: true })))
    }
    function imgTint(): Record<string, unknown>[] {
        return [0x2E6FE0, 0xE4572E, 0x17A34A, 0x111111].map((c, i) => ({ tint: c, name: "tint " + ["blue", "orange", "green", "black"][i] }))
    }
    }


class FitSwatch extends Swatch [ name = :name,
    frame: View [ x = { :shape == "tall" ? 76 : 16 }, y = 12, width = { :shape == "tall" ? 60 : 180 }, height = 96, clip = true,
        fill = { provided("theme").line },
        img: Image [ width = { parent.width }, height = 96, source = "assets/badge.png", stretches = { :fit } ]
        ]
    ]


class AlignSwatch2 extends Swatch [ name = :name,
    frame: View [ x = 16, y = 12, width = 180, height = 96, clip = true, fill = { provided("theme").line },
        img: Image [ width = 180, height = 96, source = "assets/badge.png", stretches = { :cover ? "cover" : "contain" },
            alignX = { :ax }, alignY = { :ay } ]
        ]
    ]


class TintSwatch extends Swatch [ name = :name,
    img: Image [ x = 16, y = 12, width = 180, height = 96, stretches = contain, source = "assets/badge.png", tint = { :tint } ]
    ]


class ImagesSection extends Section [ title = "Images",
    caption = "A tall image fitted into a tall box and a wide one, every way it can be; aligned within its box; tinted; and inside a box's own corners, stroke and shadow.",
    tabs = { [ ({ id: "fit", label: "Fit" }), ({ id: "align", label: "Align" }), ({ id: "tint", label: "Tint" }), ({ id: "boxed", label: "Boxed" }) ] },
    sub = "fit",
    SubHead [ visible = { app.matrix }, text = "Fit" ],
    Grid [ visible = { classroot.showing("fit") }, datapath = { app.book.value },
        FitSwatch [ datapath = :imgFit[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Align" ],
    Grid [ visible = { classroot.showing("align") }, datapath = { app.book.value },
        AlignSwatch2 [ datapath = :imgAlign[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Tint" ],
    Grid [ visible = { classroot.showing("tint") }, datapath = { app.book.value },
        TintSwatch [ datapath = :imgTint[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Boxed" ],
    Grid [ visible = { classroot.showing("boxed") },
        Swatch [ name = "rounded · clipped",
            View [ x = 36, y = 12, width = 140, height = 96, cornerRadius = 24, clip = true, fill = #DCE3EC,
                Image [ width = 140, height = 96, stretches = cover, source = "assets/badge.png" ]
                ]
            ],
        Swatch [ name = "circle · clipped",
            View [ x = 58, y = 12, width = 96, height = 96, cornerRadius = 48, clip = true, fill = #DCE3EC,
                Image [ width = 96, height = 96, stretches = cover, source = "assets/badge.png" ]
                ]
            ],
        Swatch [ name = "four radii · clipped",
            View [ x = 36, y = 12, width = 140, height = 96, cornerRadius = [0, 30, 50, 10], clip = true, fill = #DCE3EC,
                Image [ width = 140, height = 96, stretches = cover, source = "assets/badge.png" ]
                ]
            ],
        Swatch [ name = "stroke over an image",
            View [ x = 36, y = 12, width = 140, height = 96, cornerRadius = 12, clip = true, fill = #DCE3EC, stroke = stroke(5, #111111),
                Image [ width = 140, height = 96, stretches = cover, source = "assets/badge.png" ]
                ]
            ],
        Swatch [ name = "shadow around an image",
            View [ x = 36, y = 12, width = 140, height = 96, cornerRadius = 12, fill = white, shadow = shadow(0, 8, 16, #00000066),
                Image [ width = 140, height = 96, stretches = contain, source = "assets/badge.png" ]
                ]
            ],
        Swatch [ name = "image's own shadow filter",
            Image [ x = 36, y = 12, width = 140, height = 96, stretches = contain, source = "assets/badge.png", filter = shadow(0, 6, 10, #000000AA) ]
            ]
        ]
    ]
