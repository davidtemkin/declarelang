/*
# Type

A face and everything a run can do to it, one line of sample per swatch.
*/

script {
    const TYPE_BASE = { family: "sans-serif", weight: "normal", italic: false, size: 22, tracking: 0,
        transform: "none", caps: false, numerals: "normal", figures: "normal", zero: false,
        under: false, strike: false, outline: 0, shadow: "none", fill: "none", color: "text", sample: "Handgloves 0123" }

    function typeFaces(): Record<string, unknown>[] {
        return over(TYPE_BASE, cross({ family: ["sans-serif", "serif", "monospace", "system-ui", "Helvetica Neue", "Georgia", "Avenir Next", "roboto"],
                                      weight: ["light", "normal", "medium", "semibold", "bold"] },
            (r) => r.family + " · " + r.weight))
    }
    function typeItalic(): Record<string, unknown>[] {
        return over({ ...TYPE_BASE, italic: true }, cross({ family: ["sans-serif", "serif", "monospace", "system-ui", "Georgia", "roboto"], weight: ["normal", "bold"] },
            (r) => r.family + " · " + r.weight + " · italic"))
    }
    function typeSizes(): Record<string, unknown>[] {
        const sizes = [9, 11, 13, 16, 20, 28, 40, 64].map((s) => ({ size: s, sample: s >= 40 ? (s >= 60 ? "Hg" : "Hg 01") : s >= 28 ? "Hg 0123" : "Handgloves 0123", name: "size " + s }))
        const track = [-2, -0.5, 1, 3, 6].map((t) => ({ tracking: t, sample: "Handgloves", name: "tracking " + t }))
        return over(TYPE_BASE, [...sizes, ...track])
    }
    function typeCase(): Record<string, unknown>[] {
        return over(TYPE_BASE, [
            { transform: "uppercase", sample: "Handgloves", name: "uppercase" },
            { transform: "lowercase", sample: "HANDGLOVES", name: "lowercase" },
            { transform: "capitalize", sample: "hand and wool", name: "capitalize" },
            { caps: true, name: "small caps" },
            { caps: true, weight: "bold", name: "small caps · bold" },
            { numerals: "lining", sample: "Year 1987", name: "lining figures" },
            { numerals: "oldstyle", sample: "Year 1987", name: "old-style figures" },
            { figures: "tabular", sample: "1111 0000 7777", name: "tabular figures" },
            { figures: "proportional", sample: "1111 0000 7777", name: "proportional figures" },
            { zero: true, family: "monospace", sample: "0O 100 0.50", name: "slashed zero" },
            { numerals: "oldstyle", figures: "tabular", sample: "1987 2026", name: "old-style · tabular" },
            { family: "roboto", figures: "tabular", sample: "1111 0000", name: "roboto · tabular" },
        ])
    }
    function typeDecoration(): Record<string, unknown>[] {
        return over(TYPE_BASE, [
            { under: true, name: "underline" }, { strike: true, name: "strike" },
            { under: true, strike: true, name: "underline · strike" },
            { under: true, size: 40, sample: "Hgy", name: "underline · 40" },
            { outline: 1, weight: "bold", size: 32, sample: "Outline", name: "outline 1" },
            { outline: 3, weight: "bold", size: 32, sample: "Outline", name: "outline 3" },
            { shadow: "soft", name: "shadow · soft" }, { shadow: "hard", name: "shadow · hard" },
            { shadow: "glow", color: "white", weight: "bold", name: "shadow · glow" },
            { outline: 2, shadow: "soft", weight: "bold", size: 32, sample: "Both", name: "outline · shadow" },
        ])
    }
    function typeFill(): Record<string, unknown>[] {
        return over({ ...TYPE_BASE, weight: "bold", size: 30, sample: "Filled" }, [
            { fill: "solid", name: "solid fill" }, { fill: "linear", name: "linear fill" },
            { fill: "vertical", name: "vertical fill" }, { fill: "radial", name: "radial fill" },
            { fill: "conic", name: "conic fill" }, { fill: "linear", outline: 1, name: "fill · outline" },
            { fill: "linear", shadow: "soft", name: "fill · shadow" }, { fill: "linear", italic: true, name: "fill · italic" },
            { color: "accent", weight: "normal", name: "text colour" }, { color: "translucent", weight: "normal", name: "translucent colour" },
        ])
    }
    }


class TypeSwatch extends Swatch [ name = :name,
    t: Text [ x = 12, y = { (classroot.stageH - this.height) / 2 }, width = 188, wrap = false,
        fontFamily = { :family == "roboto" ? app.roboto : :family },
        fontWeight = { :weight }, italic = { :italic }, fontSize = { :size }, letterSpacing = { :tracking },
        textTransform = { :transform }, smallCaps = { :caps }, numerals = { :numerals }, numeralWidth = { :figures },
        slashedZero = { :zero }, underline = { :under }, strike = { :strike },
        outline = { :outline > 0 ? outline(:outline, 0x2E6FE0) : null },
        textShadow = { :shadow == "soft" ? shadow(0, 2, 6, colorWithAlpha(0x000000, 128)) : :shadow == "hard" ? shadow(3, 3, 0, 0xE4572E)
            : :shadow == "glow" ? shadow(0, 0, 8, 0x2E6FE0) : null },
        textColor = { :color == "accent" ? 0x2E6FE0 : :color == "translucent" ? colorWithAlpha(0x1B2733, 110)
            : :color == "white" ? 0xFFFFFF : provided("theme").text },
        textFill = { :fill == "solid" ? 0xE4572E : :fill == "linear" ? gradient("90deg", 0x2E6FE0, 0xE4572E)
            : :fill == "vertical" ? gradient("180deg", 0x2E6FE0, 0xE4572E) : :fill == "radial" ? radialGradient(0.5, 0.5, 0.7, 0xFDE68A, 0xE4572E)
            : :fill == "conic" ? conicGradient(0.5, 0.5, 0, 0x2E6FE0, 0x17A34A, 0xE4572E, 0x2E6FE0) : null },
        text = { :sample } ]
    ]


class TypeSection extends Section [ title = "Type",
    caption = "Families — generic, system, named and a declared web face — in every weight, then italic, size and tracking, case and figures, decoration, and fill.",
    tabs = { [ ({ id: "faces", label: "Faces" }), ({ id: "italic", label: "Italic" }), ({ id: "sizes", label: "Size" }),
               ({ id: "case", label: "Figures" }), ({ id: "decoration", label: "Decoration" }), ({ id: "fill", label: "Fill" }) ] },
    sub = "faces",
    SubHead [ visible = { app.matrix }, text = "Faces" ],
    Grid [ visible = { classroot.showing("faces") }, datapath = { app.book.value },
        TypeSwatch [ datapath = :typeFaces[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Italic" ],
    Grid [ visible = { classroot.showing("italic") }, datapath = { app.book.value },
        TypeSwatch [ datapath = :typeItalic[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Size" ],
    Grid [ visible = { classroot.showing("sizes") }, datapath = { app.book.value },
        TypeSwatch [ datapath = :typeSizes[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Case & figures" ],
    Grid [ visible = { classroot.showing("case") }, datapath = { app.book.value },
        TypeSwatch [ datapath = :typeCase[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Decoration" ],
    Grid [ visible = { classroot.showing("decoration") }, datapath = { app.book.value },
        TypeSwatch [ datapath = :typeDecoration[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Fill & colour" ],
    Grid [ visible = { classroot.showing("fill") }, datapath = { app.book.value },
        TypeSwatch [ datapath = :typeFill[] ]
        ]
    ]
