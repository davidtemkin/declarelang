/*
# Combined

Where the renderers' paths meet: a kind of content under an effect, turned and
not; clipping under a transform; masks and filters over children; opacity and
blending nested; 3D with effects.
*/

script {
    function comboRows(): Record<string, unknown>[] {
        return cross({ content: ["text", "rich", "image", "drawing"], fx: ["shadow", "blur", "opacity", "multiply", "mask", "grayscale"], rot: [0, 12] },
            (r) => r.content + " · " + r.fx + (r.rot ? " · rotated" : ""))
    }
    }


class ComboSwatch extends Swatch [ name = :name,
    ground: View [ x = 20, y = 14, width = 172, height = 92, cornerRadius = 10, visible = { :fx == "multiply" },
        fill = gradient(90, #17A34A, #FDE68A) ],
    body: View [ x = 36, y = 16, width = 140, height = 88, rotation = { :rot },
        filter = { :fx == "shadow" ? [shadow(0, 6, 10, colorWithAlpha(0x000000, 170))] : :fx == "blur" ? [blur(2)] : :fx == "grayscale" ? [grayscale(1)] : null },
        opacity = { :fx == "opacity" ? 0.45 : 1 },
        blend = { :fx == "multiply" ? "multiply" : "normal" },
        mask = { :fx == "mask" ? gradient("90deg", 0x000000, colorWithAlpha(0x000000, 0)) : null },
        word: Text [ y = 24, width = 140, textAlign = center, fontSize = 30, fontWeight = bold, wrap = false,
            visible = { :content == "text" }, textColor = 0x2E6FE0, text = "Swatch" ],
        doc: HTMLText [ width = 140, fontSize = 15, visible = { :content == "rich" },
            html = "<b>Rich</b> text, <span class='Warm'>styled</span> in runs across a line." ],
        pic: Image [ width = 140, height = 88, stretches = contain, source = "assets/badge.png", visible = { :content == "image" } ],
        art: View [ width = 140, height = 88, visible = { :content == "drawing" },
            draw(d: Draw) {
                d.fillStyle = 0xFDE68A
                d.fillRect(0, 0, 140, 88)
                d.strokeStyle = 0xE4572E
                d.lineWidth = 6
                d.beginPath()
                d.arc(70, 44, 30, 0, 6.2832)
                d.stroke()
                }
            ]
        ]
    ]


class CombinedSection extends Section [ title = "Combined",
    caption = "Content under an effect, turned and not; clipping under a transform; masks and filters over children; opacity and blending nested; 3D with effects.",
    tabs = { [ ({ id: "content", label: "Content" }), ({ id: "clip", label: "Clip" }),
               ({ id: "layers", label: "Layers" }), ({ id: "depth", label: "3D" }) ] },
    sub = "content",
    SubHead [ visible = { app.matrix }, text = "Content × effect" ],
    Grid [ visible = { classroot.showing("content") }, datapath = { app.book.value },
        ComboSwatch [ datapath = :comboRows[] ]
        ],

    SubHead [ visible = { app.matrix }, text = "Clip × transform" ],
    Grid [ visible = { classroot.showing("clip") },
        Swatch [ name = "rotated child in a clip",
            View [ x = 36, y = 16, width = 140, height = 88, clip = true, stroke = stroke(1, #111111),
                View [ x = 20, y = 10, width = 100, height = 68, rotation = 30, fill = gradient(90, #2E6FE0, #E4572E) ]
                ]
            ],
        Swatch [ name = "rotated clipping parent",
            View [ x = 36, y = 16, width = 140, height = 88, clip = true, rotation = 15, fill = #FDE68A,
                View [ x = -20, y = 20, width = 180, height = 48, fill = #2E6FE0 ]
                ]
            ],
        Swatch [ name = "rounded clip · rotated",
            View [ x = 46, y = 16, width = 120, height = 88, clip = true, cornerRadius = 30, rotation = -20,
                Image [ width = 120, height = 88, stretches = cover, source = "assets/badge.png" ]
                ]
            ],
        Swatch [ name = "scaled clip · text",
            View [ x = 36, y = 16, width = 140, height = 88, clip = true, scale = 0.8, fill = #E8EEF9,
                Text [ x = -10, y = 20, fontSize = 36, fontWeight = bold, wrap = false, text = "Overflowing" ]
                ]
            ],
        Swatch [ name = "skewed clip · rich text",
            View [ x = 36, y = 16, width = 140, height = 88, clip = true, skewX = 12, fill = #E8EEF9,
                HTMLText [ x = 6, y = 4, width = 160, fontSize = 13, html = "A <span class='Warm'>styled</span> paragraph clipped by a skewed box, wrapping past its edge." ]
                ]
            ],
        Swatch [ name = "mask × rotation",
            View [ x = 36, y = 16, width = 140, height = 88, rotation = 20, cornerRadius = 12, fill = gradient(90, #2E6FE0, #E4572E),
                mask = gradient("180deg", #000000, #00000000) ]
            ],
        Swatch [ name = "mask × scale · image",
            Image [ x = 36, y = 16, width = 140, height = 88, scale = 0.8, stretches = cover, source = "assets/badge.png",
                mask = radialGradient(0.5, 0.5, 0.6, #000000, #00000000) ]
            ],
        Swatch [ name = "shadow on a rotated rounded box",
            View [ x = 46, y = 24, width = 120, height = 72, rotation = 12, cornerRadius = 16, fill = #FFFFFF,
                shadow = shadow(0, 8, 14, #00000066), stroke = stroke(1, #11111122) ]
            ]
        ],

    SubHead [ visible = { app.matrix }, text = "Layers" ],
    Grid [ visible = { classroot.showing("layers") },
        Swatch [ name = "filter over clipped children",
            View [ x = 36, y = 16, width = 140, height = 88, clip = true, cornerRadius = 12, filter = shadow(0, 6, 10, #000000AA),
                View [ x = -20, y = -10, width = 100, height = 100, cornerRadius = 50, fill = #2E6FE0 ],
                View [ x = 70, y = 30, width = 100, height = 100, cornerRadius = 50, fill = #E4572E ]
                ]
            ],
        Swatch [ name = "blur over a group",
            View [ x = 36, y = 16, width = 140, height = 88, filter = blur(3),
                View [ width = 80, height = 88, fill = #2E6FE0 ],
                Text [ x = 60, y = 24, fontSize = 30, fontWeight = bold, text = "Blur" ]
                ]
            ],
        Swatch [ name = "opacity × blend",
            View [ x = 20, y = 14, width = 172, height = 92, fill = gradient(90, #17A34A, #FDE68A) ],
            View [ x = 36, y = 24, width = 140, height = 72, opacity = 0.6,
                View [ width = 90, height = 72, cornerRadius = 36, fill = #E4572E, blend = multiply ],
                View [ x = 50, width = 90, height = 72, cornerRadius = 36, fill = #2E6FE0, blend = screen ]
                ]
            ],
        Swatch [ name = "blend inside an opacity group",
            View [ x = 20, y = 14, width = 172, height = 92, opacity = 0.7, fill = gradient(90, #2E6FE0, #FDE68A),
                View [ x = 36, y = 14, width = 100, height = 64, cornerRadius = 32, fill = #E4572E, blend = difference ]
                ]
            ],
        Swatch [ name = "nested masks",
            View [ x = 36, y = 16, width = 140, height = 88, mask = gradient("90deg", #000000, #00000000),
                View [ width = 140, height = 88, fill = gradient(180, #2E6FE0, #E4572E), mask = gradient("180deg", #000000, #00000022) ]
                ]
            ],
        Swatch [ name = "filter chain over rich text",
            HTMLText [ x = 16, y = 16, width = 180, fontSize = 15, filter = [grayscale(1), shadow(0, 2, 3, #00000088)],
                html = "<b>Rich</b> text with a <span class='rGrad'>gradient run</span> under two filters." ]
            ],
        Swatch [ name = "frost over a rotated drawing",
            View [ x = 30, y = 20, width = 150, height = 80, rotation = -10,
                draw(d: Draw) { d.fillStyle = 0xE4572E; d.beginPath(); d.arc(40, 40, 36, 0, 6.2832); d.fill(); d.fillStyle = 0x2E6FE0; d.fillRect(80, 10, 60, 60) }
                ],
            View [ x = 56, y = 36, width = 100, height = 48, cornerRadius = 12, backdrop = frost(8), fill = #FFFFFF55 ]
            ],
        Swatch [ name = "drawing under opacity and a mask",
            View [ x = 16, y = 12, width = 180, height = 96, opacity = 0.7, mask = radialGradient(0.5, 0.5, 0.6, #000000, #00000000),
                draw(d: Draw) { const g = d.createLinearGradient(0, 0, 180, 0); g.addColorStop(0, 0x2E6FE0); g.addColorStop(1, 0xE4572E); d.fillStyle = g; d.fillRect(0, 0, 180, 96) }
                ]
            ]
        ],

    SubHead [ visible = { app.matrix }, text = "3D × effect" ],
    Grid [ visible = { classroot.showing("depth") },
        Swatch [ name = "rotateY · shadow",
            View [ x = 56, y = 28, width = 100, height = 64, perspective = 400,
                View [ width = 100, height = 64, pivotX = 50, pivotY = 32, rotateY = 35, cornerRadius = 8, fill = gradient(90, #2E6FE0, #E4572E), shadow = shadow(0, 8, 12, #00000066) ]
                ]
            ],
        Swatch [ name = "rotateX · text",
            View [ x = 36, y = 28, width = 140, height = 64, perspective = 300,
                Text [ width = 140, pivotX = 70, pivotY = 18, rotateX = 35, textAlign = center, fontSize = 30, fontWeight = bold, text = "Tilted" ]
                ]
            ],
        Swatch [ name = "rotateY · image · mask",
            View [ x = 56, y = 28, width = 100, height = 64, perspective = 400,
                Image [ width = 100, height = 64, pivotX = 50, pivotY = 32, rotateY = -35, stretches = cover, source = "assets/badge.png", mask = gradient("90deg", #000000, #00000000) ]
                ]
            ],
        Swatch [ name = "3D inside a clip",
            View [ x = 36, y = 16, width = 140, height = 88, clip = true, stroke = stroke(1, #111111), perspective = 300,
                View [ x = 20, y = 12, width = 100, height = 64, pivotX = 50, pivotY = 32, rotateY = 50, translateZ = 30, fill = #17A34A ]
                ]
            ],
        Swatch [ name = "3D · opacity · blur",
            View [ x = 56, y = 28, width = 100, height = 64, perspective = 400,
                View [ width = 100, height = 64, pivotX = 50, pivotY = 32, rotateX = 30, rotateY = 30, opacity = 0.6, filter = blur(1), fill = #E4572E, cornerRadius = 10 ]
                ]
            ]
        ]
    ]
