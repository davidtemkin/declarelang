/*
# Paint

A box's fill, its corners, its stroke on every side or some, and its shadow —
one at a time, then together.
*/


class PaintSwatch extends Swatch [ name = :name,
    box: View [ x = 36, y = 16, width = 140, height = 88,
        fill = { ({ solid: 0x2E6FE0, translucent: colorWithAlpha(0x2E6FE0, 100), light: 0xE8EEF9, white: 0xFFFFFF,
            linear: gradient("90deg", 0xFDE68A, 0xE4572E), linear45: gradient("45deg", 0xFDE68A, 0xE4572E),
            vertical: gradient("180deg", 0x2E6FE0, 0x17A34A), stops: gradient("90deg", 0x2E6FE0, 0xFDE68A, 0x17A34A, 0xE4572E),
            radial: radialGradient(0.5, 0.5, 0.8, 0xFDE68A, 0xE4572E), radialEdge: radialGradient(0.1, 0.2, 1, 0xFFFFFF, 0x2E6FE0),
            conic: conicGradient(0.5, 0.5, 0, 0x2E6FE0, 0x17A34A, 0xE4572E, 0x2E6FE0) })[:fill] ?? conicGradient(0.3, 0.6, 90, 0xFDE68A, 0xE4572E, 0xFDE68A) },
        cornerRadius = { ({ square: 0, small: 4, round: 16, pill: 44, four: [0, 28, 44, 8] })[:radius] ?? 200 },
        stroke = { ({ hair: stroke(1, 0x111111), ring: stroke(4, 0x111111), thick: stroke(14, 0x111111),
            top: [stroke(8, 0x111111), null, null, null], right: [null, stroke(8, 0x111111), null, null],
            bottom: [null, null, stroke(8, 0x111111), null], left: [null, null, null, stroke(8, 0x111111)],
            topBottom: [stroke(4, 0x111111), null, stroke(10, 0x111111), null], leftRight: [null, stroke(6, 0x111111), null, stroke(6, 0x111111)],
            three: [stroke(6, 0x111111), stroke(6, 0x111111), stroke(6, 0x111111), null],
            ladder: [stroke(2, 0x111111), stroke(6, 0x111111), stroke(10, 0x111111), stroke(14, 0x111111)],
            colours: [stroke(6, 0x2E6FE0), stroke(6, 0x17A34A), stroke(6, 0xE4572E), stroke(6, 0xB8860B)] })[:stroke] ?? null },
        shadow = { ({ soft: shadow(0, 8, 16, colorWithAlpha(0x000000, 100)), hard: shadow(6, 6, 0, 0x111111),
            far: shadow(12, 18, 24, colorWithAlpha(0x000000, 90)), up: shadow(0, -8, 12, colorWithAlpha(0x000000, 100)),
            coloured: shadow(0, 6, 14, 0xE4572E), tight: shadow(0, 1, 2, colorWithAlpha(0x000000, 160)) })[:shadow] ?? null } ]
    ]


class PaintSection extends Section [ title = "Paint",
    caption = "A box's fill — solid, translucent, linear at any angle, many stops, radial, conic — its corners, its stroke on every side or some, its shadow, and all of them together.",
    tabs = { [ ({ id: "fills", label: "Fills" }), ({ id: "corners", label: "Corners" }), ({ id: "strokes", label: "Strokes" }),
               ({ id: "shadows", label: "Shadows" }), ({ id: "all", label: "Together" }) ] },
    sub = "fills",

    // this section's rows, by sub-page, built from its axes

    paintBase() -> object { return { fill: "solid", radius: "square", stroke: "none", shadow: "none" } },
    paintFills() -> array {
        return over(this.paintBase(), ["solid", "translucent", "linear", "linear45", "vertical", "stops", "radial", "radialEdge", "conic", "conicFrom"]
            .map((f) => ({ fill: f, radius: "round", name: "fill · " + f })))
        },
    paintCorners() -> array {
        return over(this.paintBase(), cross({ radius: ["square", "small", "round", "pill", "four", "huge"], stroke: ["none", "ring"] },
            (r) => r.radius + (r.stroke === "ring" ? " · ring" : "")))
        },
    paintStrokes() -> array {
        return over({ ...this.paintBase(), fill: "light" }, ["hair", "ring", "thick", "top", "right", "bottom", "left", "topBottom", "leftRight", "three", "ladder", "colours"]
            .flatMap((s) => [{ stroke: s, name: "stroke · " + s }, { stroke: s, radius: "round", name: "stroke · " + s + " · round" }]))
        },
    paintShadows() -> array {
        return over({ ...this.paintBase(), fill: "white" }, ["soft", "hard", "far", "up", "coloured", "tight"].flatMap((s) => [
            { shadow: s, name: "shadow · " + s }, { shadow: s, radius: "round", stroke: "hair", name: "shadow · " + s + " · round · ring" }]))
        },
    paintAll() -> array {
        return cross({ fill: ["solid", "linear", "radial", "conic"], radius: ["square", "four"], stroke: ["ring", "topBottom"], shadow: ["none", "soft"] },
            (r) => r.fill + " · " + r.radius + " · " + r.stroke + (r.shadow !== "none" ? " · shadow" : ""))
        },
    rows: Dataset [ contents = { { paintFills: classroot.paintFills(), paintCorners: classroot.paintCorners(), paintStrokes: classroot.paintStrokes(), paintShadows: classroot.paintShadows(), paintAll: classroot.paintAll() } } ],
    SubHead [ visible = { app.matrix }, text = "Fills" ],
    Grid [ visible = { classroot.showing("fills") }, datapath = { classroot.rows.value },
        PaintSwatch [ datapath = :paintFills[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Corners" ],
    Grid [ visible = { classroot.showing("corners") }, datapath = { classroot.rows.value },
        PaintSwatch [ datapath = :paintCorners[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Strokes" ],
    Grid [ visible = { classroot.showing("strokes") }, datapath = { classroot.rows.value },
        PaintSwatch [ datapath = :paintStrokes[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Shadows" ],
    Grid [ visible = { classroot.showing("shadows") }, datapath = { classroot.rows.value },
        PaintSwatch [ datapath = :paintShadows[] ]
        ],
    SubHead [ visible = { app.matrix }, text = "Together" ],
    Grid [ visible = { classroot.showing("all") }, datapath = { classroot.rows.value },
        PaintSwatch [ datapath = :paintAll[] ]
        ]
    ]
