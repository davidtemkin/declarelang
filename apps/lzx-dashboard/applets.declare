/*
# The live applets

Chat, contacts and the two media players: the tabs of the dashboard that do
something. (The rest show pictures of their period.)
*/


/*
## Chat

The Communications window's live tab. There is no chat server here, so a line
you send goes straight into the transcript, your name in blue; another person's
would come in red.

The transcript is a white well with rounded corners and the window's scrollbar;
below it, the entry between its rounded ends, and Send.
*/

class ChatPanel [
    draft: string = "",

    send() {
        const t = draft.trim()
        if (t === "") return
        app.chatLog.insert(["messages"], app.chatLog.value.messages.length,
            ({ from: app.userName, text: t, self: true }))
        draft = ""
        afterSettle(() => well.transcript.scrollTo(Infinity))
        },

    // the well: the transcript, framed by its corner and edge art

    well: View [ x = 5, y = 4, width = { parent.width - 10 }, height = { parent.height - 52 },
        fontFamily = { app.veraRoman },

        transcript: ScrollPane [ x = 10, width = { parent.width - 10 }, height = 100%, fill = #FFFFFF,
            art = "chat", ground = #323229, idleGround = #8E9076,
            accessibilityRole = region, accessibilityLabel = "Chat", accessibilityLive = polite,
            lines: View [ width = 100%, padding = [4, 0, 6, 0], datapath = { app.chatLog.value },
                layout: SimpleLayout [ axis = y, spacing = 2 ],
                HTMLText [ datapath = :messages[], width = 100%, padding = 2,
                    textStyles = { { me: { textFill: "#0000FF" }, them: { textFill: "#CC0000" } } },
                    html = { "<span class='" + (:self ? "me" : "them") + "'>" + escapeHtml(:from) + "</span>: " + escapeHtml(:text) } ]
                ]
            ],

        topLeft:     Image [ fill = #FFFFFF, source = "resources/img/chat_corner_tl.png" ],
        top:         Image [ x = 12, width = { parent.width - 24 }, fit = both, source = "resources/img/chat_t.png" ],
        topRight:    Image [ x = { parent.width - 12 }, source = "resources/img/chat_corner_tr.png" ],
        left:        Image [ y = 10, height = { parent.height - 20 }, fit = both, fill = #FFFFFF, source = "resources/img/chat_l.png" ],
        right:       Image [ x = { parent.width - 3 }, y = 10, height = { parent.height - 20 }, fit = both, source = "resources/img/chat_r.png" ],
        bottomLeft:  Image [ y = { parent.height - 10 }, fill = #FFFFFF, source = "resources/img/chat_corner_bl.png" ],
        bottom:      Image [ x = 12, y = { parent.height - 10 }, width = { parent.width - 24 }, fit = both, source = "resources/img/chat_b.png" ],
        bottomRight: Image [ x = { parent.width - 12 }, y = { parent.height - 10 }, source = "resources/img/chat_corner_br.png" ]
        ],

    // the entry, between its rounded ends

    entryBar: View [ x = 6, y = { parent.height - 42 }, width = { parent.width - 12 }, height = 17,
        fontFamily = { app.veraRoman },
        left:   Image [ source = "resources/img/chat_round_edge.png" ],
        middle: Image [ x = 10, width = { parent.width - 20 }, fit = both, source = "resources/img/chat_middle.png" ],
        right:  Image [ x = { parent.width - 10 }, source = "resources/img/chat_round_edge_rt.png" ],
        entry:  TextInput [ x = 10, y = 1, width = { parent.width - 20 }, height = 15,
            fill = null, stroke = null, cornerRadius = 0, padding = [0, 3, 2, 1],
            accessibilityLabel = "Message",
            value <-> classroot.draft,
            onEnter() { classroot.send() }
            ]
        ],

    sendBtn: ImageButton [ x = { parent.width - 44 }, y = { parent.height - 41 }, accessibilityLabel = "Send",
        upArt = "resources/img/send_up.png", overArt = "resources/img/send_over.png", downArt = "resources/img/send_down.png",
        press() { classroot.send() }
        ]
    ]


/*
## Contacts

The People window's live tab: a bar for adding a contact, the form it opens, and
the contacts as rows that open one at a time; pressing the open one closes it.
When someone comes online their row shows a small light, and flashes white.
*/

// A field of the new-contact form: white, in a one-pixel black border.

class ContactField extends TextInput [ height = 18,
    fill = #FFFFFF, stroke = Stroke(1, #000000), cornerRadius = 0, padding = [0, 3, 2, 2],
    fontFamily = { app.veraRoman }
    ]


// One contact. Closed, its 34px plate: name and title. Open, 190px more: the
// e-mail button, and the contact's addresses, numbers and notes under their heads.

class ContactRow [ clip = true,
    open: boolean = false,
    picked() { },

    // how far open it is, in pixels, moved over 300ms when it opens or closes

    extent: number = { open ? 224 : 34 },
    opening: Animator [ attribute = extent, to = 224, duration = 300, easing = laszloBoth, started = { classroot.open } ],
    closing: Animator [ attribute = extent, to = 34, duration = 300, easing = laszloBoth, started = { !classroot.open } ],
    height = { extent },

    // whether this person has just come online

    online: boolean = { app.flashUser == :user },

    accessibilityRole = group,
    accessibilityLabel = :name,
    textColor = #222222, fontSize = 10,

    plate: Control [ width = 100%, height = 34, fill = #88B29D,
        accessibilityLabel = { :name + ", " + :title },
        accessibilityExpanded = { classroot.open },
        press() { classroot.picked() },
        wash: View [ width = 100%, height = 34, fill = #FFFFFF, opacity = 0,
            Animator [ attribute = opacity, from = 0.9, to = 0, duration = 2000, started = { classroot.online } ]
            ],
        lightEdge: View [ width = 100%, height = 1, fill = #B0DEC9 ],
        lightSide: View [ width = 1, height = 100%, fill = #B0DEC9 ],
        darkSide:  View [ x = { parent.width - 1 }, width = 1, height = 100%, fill = #568A70 ],
        darkEdge:  View [ y = { parent.height - 1 }, width = 100%, height = 1, fill = #568A70 ],
        name:  Label [ x = 9, y = 2, width = 180, fontFamily = { app.vera }, fontWeight = bold, text = :name ],
        title: Label [ x = 9, y = 15, width = 180, fontFamily = { app.veraRoman }, text = :title ],
        light: Image [ x = { parent.width - 20 }, y = 14, visible = { classroot.online },
            source = "resources/img/presencelight.png", accessibilityLabel = "online" ]
        ],

    detail: View [ width = 100%, visible = { classroot.height > 34 }, fontFamily = { app.veraRoman },
        emailButton: Image [ x = 5, y = 38, source = "resources/img/contact_email_but.png", accessibilityLabel = "e-mail" ],
        ruleDark:  View [ x = 5, y = 58, width = { parent.width - 10 }, height = 1, fill = #8D9E95 ],
        ruleLight: View [ x = 5, y = 59, width = { parent.width - 10 }, height = 1, fill = #C4DBCF ],
        infoPlate: View [ x = 5, y = 60, width = 35, height = 15, fill = #82998D ],
        infoHead:  Label [ x = 6, y = 60, textColor = #FFFFFF, fontFamily = { app.vera }, fontWeight = bold, text = "Info" ],

        // the sections run on from each other, each head ten pixels under what the
        // section before it holds, its small mark beside it

        emailHead: Label [ x = 5, y = 77, fontFamily = { app.vera }, fontWeight = bold, text = "Email Addresses" ],
        emailMark: Image [ x = { parent.width - 20 }, y = 79, source = "resources/img/contact_mini_n.png" ],
        email:     Label [ x = 5, y = 90, text = :email ],
        phoneHead: Label [ x = 5, y = { parent.email.y + parent.email.height + 10 }, fontFamily = { app.vera }, fontWeight = bold, text = "Telephone No's" ],
        phoneMark: Image [ x = { parent.width - 20 }, y = { parent.email.y + parent.email.height + 16 }, source = "resources/img/contact_mini_n.png" ],
        phone:     Label [ x = 5, y = { parent.email.y + parent.email.height + 24 }, text = :telephone ],
        addrHead:  Label [ x = 5, y = { parent.phone.y + parent.phone.height + 10 }, fontFamily = { app.vera }, fontWeight = bold, text = "Address" ],
        addrMark:  Image [ x = { parent.width - 20 }, y = { parent.phone.y + parent.phone.height + 16 }, source = "resources/img/contact_mini_n.png" ],
        address:   Label [ x = 5, y = { parent.phone.y + parent.phone.height + 24 }, text = :address ],

        notesTop: number = { address.y + address.height },
        notesRuleDark:  View [ x = 5, y = { parent.notesTop + 10 }, width = { parent.width - 10 }, height = 1, fill = #8D9E95 ],
        notesRuleLight: View [ x = 5, y = { parent.notesTop + 11 }, width = { parent.width - 10 }, height = 1, fill = #C4DBCF ],
        notesPlate: View [ x = 5, y = { parent.notesTop + 12 }, width = 90, height = 15, fill = #82998D ],
        notesMark:  Image [ x = { parent.width - 20 }, y = { parent.notesTop + 15 }, source = "resources/img/contact_mini_plus.png" ],
        notesHead:  Label [ x = 6, y = { parent.notesTop + 12 }, textColor = #FFFFFF, fontFamily = { app.vera }, fontWeight = bold,
            text = "Notes & More " ],
        notes:      Label [ x = 5, y = { parent.notesTop + 30 }, text = { :notes ?? "" } ]
        ]
    ]


class ContactsPanel [
    formOpen: boolean = false,

    // the contact being added, as typed

    draft: Dataset [ schema = Contact ] { { "name": "", "user": "", "title": "", "email": "", "telephone": "", "address": "" } },

    openForm() {
        draft.set([], ({ name: "", user: "", title: "", email: "", telephone: "", address: "" }))
        formOpen = true
        afterSettle(() => Focus.focus(adder.form.nameField))
        },
    saveNew() {
        const d = draft.value
        app.contactsData.insert(["contacts"], app.contactsData.value?.contacts.length ?? 0, ({
            name: d.name, user: d.name.split(" ")[0], title: d.title, email: d.email,
            telephone: d.telephone, address: d.address }))
        formOpen = false
        },

    // the open contact, by user

    openUser: string = "",

    // ── the bar, and the form it opens: 25px closed, 295 open, over 500ms ──

    adder: View [ width = 100%, clip = true,
        extent: number = { classroot.formOpen ? 295 : 25 },
        opening: Animator [ attribute = extent, to = 295, duration = 500, easing = laszloBoth, started = { classroot.formOpen } ],
        closing: Animator [ attribute = extent, to = 25, duration = 500, easing = laszloBoth, started = { !classroot.formOpen } ],
        height = { extent },

        bar: View [ width = 100%, height = 20, fill = #8CB29C,
            newBtn:    DashButton [ x = 4, y = 2, width = 43, label = "new",
                press() { classroot.openForm() }
                ],
            saveBtn:   DashButton [ x = { parent.width - 110 }, y = 2, width = 50, label = "save",
                press() { classroot.saveNew() }
                ],
            cancelBtn: DashButton [ x = { parent.width - 55 }, y = 2, width = 50, label = "cancel",
                press() { classroot.formOpen = false }
                ]
            ],
        rule: View [ y = 20, width = 100%, height = 1, fill = #48735D ],

        // the plate at the bar's right end, with its search and sort marks: it
        // rides at the foot of the form, so while the form is closed it covers
        // save and cancel; the form, over it, covers it in turn while open

        footLine: Image [ y = { parent.height - 5 }, width = 100%, fit = both, source = "resources/img/contact_data_top_l.png" ],
        plate: Image [ x = { parent.width - 160 }, y = { parent.height - 25 }, source = "resources/img/contact_data_top_r.png",
            marks: Image [ x = 80, y = 4, source = "resources/img/contact_data_top_buttons.png" ]
            ],

        form: View [ y = 21, width = 100%, height = { parent.height - 20 }, fill = #B6CCC1,
            visible = { classroot.formOpen || parent.height > 25 },
            accessibilityRole = group, accessibilityLabel = "New contact",
            datapath = { classroot.draft.value },
            textColor = #222222, fontSize = 10,
            gutter: View [ width = 55, height = 100%, fill = #9EBAAB ],

            Label [ x = 3, y = 5, fontFamily = { app.vera }, fontWeight = bold, text = "Name" ],
            nameField: ContactField [ x = 60, y = 3, width = { parent.width - 65 }, accessibilityLabel = "Name", value <-> :name ],
            Label [ x = 3, y = 23, fontFamily = { app.vera }, fontWeight = bold, text = "Title" ],
            ContactField [ x = 60, y = 20, width = { parent.width - 65 }, accessibilityLabel = "Title", value <-> :title ],
            Label [ x = 3, y = 52, fontFamily = { app.vera }, fontWeight = bold, text = "Email" ],
            ContactField [ x = 60, y = 48, width = { parent.width - 65 }, accessibilityLabel = "Email", purpose = email, value <-> :email ],
            ContactField [ x = 60, y = 65, width = { parent.width - 65 }, accessibilityLabel = "Second email", purpose = email ],
            Label [ x = 3, y = 95, fontFamily = { app.vera }, fontWeight = bold, text = "Phone" ],
            Label [ x = 57, y = 97, fontFamily = { app.veraRoman }, text = "Home" ],
            ContactField [ x = 93, y = 95, width = { parent.width - 98 }, accessibilityLabel = "Home phone", value <-> :telephone ],
            Label [ x = 57, y = 114, fontFamily = { app.veraRoman }, text = "Work" ],
            ContactField [ x = 93, y = 112, width = { parent.width - 98 }, accessibilityLabel = "Work phone" ],
            Label [ x = 57, y = 131, fontFamily = { app.veraRoman }, text = "Cell" ],
            ContactField [ x = 93, y = 129, width = { parent.width - 98 }, accessibilityLabel = "Cell phone" ],
            Label [ x = 57, y = 148, fontFamily = { app.veraRoman }, text = "Fax" ],
            ContactField [ x = 93, y = 146, width = { parent.width - 98 }, accessibilityLabel = "Fax" ],
            Label [ x = 3, y = 175, fontFamily = { app.vera }, fontWeight = bold, text = "Address" ],
            ContactField [ x = 60, y = 175, width = { parent.width - 65 }, accessibilityLabel = "Address", value <-> :address ],
            ContactField [ x = 60, y = 192, width = { parent.width - 65 }, accessibilityLabel = "Address line 2" ],
            ContactField [ x = 60, y = 209, width = { parent.width - 65 }, accessibilityLabel = "Address line 3" ],
            ContactField [ x = 60, y = 226, width = { parent.width - 65 }, accessibilityLabel = "Address line 4" ],
            notesBtn: DashButton [ x = 4, y = 250, width = 43, label = "notes",
                press() { classroot.formOpen = false }
                ]
            ]
        ],

    list: ScrollPane [ y = { parent.adder.height }, width = 100%, height = { parent.height - parent.adder.height - 9 },
        fill = #B6CCC1, art = "contacts", ground = #383F3B, idleGround = #729081,
        rows: View [ width = 100%, datapath = { app.contactsData.value },
            layout: SimpleLayout [ axis = y ],

            // two pixels narrower than the pane's content, as the original's

            ContactRow [ datapath = :contacts[], width = { parent.width - 2 },
                open = { classroot.openUser == :user },
                picked() { classroot.openUser = classroot.openUser == :user ? "" : :user }
                ]
            ]
        ]
    ]


/*
## Media

The Media window's Music and Video tabs: a player, its transport, and the tracks
to choose from. Pressing a track's picture or name offers it in the popup, whose
play button starts it.
*/

// One track to choose: its picture and, centered under it, its name.

class TrackCell extends Control [ width = 68, height = 68, clip = true,
    kind: string = "audio",
    accessibilityLabel = :label,
    press() { app.offer(art, :@, kind) },
    art: Image [ x = 12, y = 9, width = 40, height = 40, fit = both, source = :imageurl ],
    caption: Label [ y = 50, x = { Math.round((68 - this.width) / 2) }, accessibilityHidden = true,
        fontFamily = { app.kroe }, fontSize = 8, textColor = #000000, text = :label ]
    ]


/*
### The transport

The track's title, centered; back to the start, the load bar with the scrubber
riding it, and on to the end; the time; and the volume along the bottom, over
the tab-shaped art.

The scrubber shows pause until the player stops, then play. A short press on it
while stopped plays; dragging it seeks, and leaves the player stopped where it is
let go. The back and next buttons stop at the start or the end. The volume thumb
travels 39px, the volume twice its place and at most full; the soft and loud ends
step it 5px.
*/

class MediaTransport [ height = 74,
    label: string = "",
    player: Media? = null,

    // stopped, the scrubber shows play

    stopped: boolean = false,

    pos: number = { player != null ? player.position : 0 },
    dur: number = { player != null && player.duration > 0 ? player.duration : 0 },

    play() { if (player != null) { stopped = false; player.playing = true } },
    stopAt(t: number) {
        if (player == null) return
        player.playing = false
        player.position = Math.max(0, Math.min(dur, t))
        stopped = true
        },

    // the time as the original writes it: minutes and seconds, two digits each

    clock(secs: number) -> string {
        let s = Math.floor(secs)
        let out = "00:"
        if (s > 60) { const m = Math.floor(s / 60); out = (m < 10 ? "0" : "") + m + ":"; s = s - m * 60 }
        return out + (s < 10 ? "0" + s : "" + s)
        },

    info: Label [ y = 5, x = { Math.round((parent.width - this.width) / 2) }, accessibilityLive = polite,
        fontFamily = { app.vera }, fontWeight = bold, fontSize = 10, textColor = #000000, text = { classroot.label } ],

    controls: View [ x = 5, y = 25,
        layout: SimpleLayout [ axis = x ],
        back: ImageButton [ accessibilityLabel = "Back to the start",
            upArt = "resources/img/prev.png", overArt = "resources/img/prevover.png", downArt = "resources/img/prevdown.png",
            press() { classroot.stopAt(0) }
            ],
        loadbar: View [ width = { classroot.width - 132 }, height = 18,
            well: View [ width = 100%, height = 18, clip = true,
                onClick(e: PointerEvent) { classroot.stopAt(e.x / parent.scrubber.maxX * classroot.dur) },
                Image [ source = "resources/img/loadbarback.png" ]
                ],
            progress: Image [ y = 5, height = 8, fit = both, source = "resources/img/loadbar.png",
                width = { classroot.player != null && classroot.player.loaded ? parent.width : 0 } ],

            scrubber: Control [ y = 1, width = 16, height = 16,
                maxX: number = { parent.width - 16 },
                x = { classroot.dur > 0 ? classroot.pos / classroot.dur * this.maxX : 0 },
                accessibilityRole = slider, accessibilityLabel = "Position",
                accessibilityMin = 0, accessibilityMax = { Math.round(classroot.dur) }, accessibilityValue = { Math.round(classroot.pos) },
                accessibilityValueText = { classroot.clock(classroot.pos) },
                accessibilityIncrement() { classroot.stopAt(classroot.pos + 5) },
                accessibilityDecrement() { classroot.stopAt(classroot.pos - 5) },
                face: Image [ source = { "resources/img/" + (classroot.stopped ? "play" : "pause")
                    + (parent.pressed ? "down" : parent.hovered ? "over" : "") + ".png" } ],
                grabX: number = 0,
                startPos: number = 0,
                wasPlaying: boolean = false,
                onPointerDown(e: PointerEvent) {
                    grabX = e.x; startPos = classroot.pos
                    wasPlaying = classroot.player != null && classroot.player.playing
                    },
                onDrag(e: PointerEvent) {
                    const nx = e.rootX - parent.rootOrigin().x - grabX
                    classroot.stopAt(nx / maxX * classroot.dur)
                    },
                press() { if (!wasPlaying && Math.abs(classroot.pos - startPos) < 5 / 30) classroot.play() }
                ]
            ],
        next: ImageButton [ accessibilityLabel = "On to the end",
            upArt = "resources/img/next.png", overArt = "resources/img/nextover.png", downArt = "resources/img/nextdown.png",
            press() { classroot.stopAt(classroot.dur) }
            ]
        ],

    readout: Image [ x = { parent.width - 87 }, y = 27, source = "resources/img/media_timereadout.png" ],
    time: Label [ x = { parent.width - 85 }, y = 26, width = 120, accessibilityHidden = true,
        fontFamily = { app.vera }, fontWeight = bold, fontSize = 10, textColor = #000000,
        text = { classroot.clock(classroot.pos) } ],
    marks: Image [ x = { parent.width - 42 }, y = 25, source = "resources/img/media_is_buttons.png" ],

    // the tab-shaped art along the foot, under the volume

    tabLeft:   Image [ y = { parent.height - 7 }, width = 100%, height = 7, fit = both, source = "resources/img/media_tab_l.png" ],
    tabMiddle: Image [ x = 80, y = { parent.height - 28 }, source = "resources/img/media_tab_m.png" ],
    tabRight:  Image [ x = 112, y = { parent.height - 25 }, width = { parent.width - 112 }, height = 25, fit = both,
        source = "resources/img/media_tab_r.png" ],
    tabMarks:  Image [ x = { parent.width - 97 }, y = { parent.height - 22 }, source = "resources/img/media_tab_buttons.png" ],

    volume: View [ x = 5, y = { parent.height - 23 },
        level: number = 39,
        softer: Control [ accessibilityLabel = "Softer",
            press() { parent.level = parent.level - 5 },
            Image [ source = "resources/img/volumesoft.png" ]
            ],
        bar: Image [ x = 10, y = 4, source = "resources/img/volumebar.png",
            thumb: Image [ y = -3.5, x = { classroot.volume.level }, source = "resources/img/volumebutton.png",
                grabX: number = 0,
                onPointerDown(e: PointerEvent) { grabX = e.x },
                onDrag(e: PointerEvent) {
                    classroot.volume.level = Math.max(0, Math.min(39, e.rootX - parent.rootOrigin().x - grabX))
                    }
                ]
            ],
        louder: Control [ x = 64, accessibilityLabel = "Louder",
            press() { parent.level = parent.level + 5 },
            Image [ source = "resources/img/volumeloud.png" ]
            ]
        ],

    // the volume the thumb's place gives the player

    loudness: number = { Math.max(0, Math.min(1, volume.level * 2)) }
    ]


// A list of tracks under a player: white, scrolling with the media scrollbar.

class TrackList extends ScrollPane [ fill = #FFFFFF, art = "media", ground = #2E262D, idleGround = #856C81,
    kind: string = "audio",
    cells: View [ width = { parent.width + 4 },
        layout: WrappingLayout [ spacing = 8, rowSpacing = 0 ],
        TrackCell [ datapath = :tracks[], kind = { classroot.kind } ]
        ]
    ]


// Music: the track's picture in a shadowed well, the transport, and the tracks.

class MusicPanel [
    playTrack(t: Track) { current = t; song.source = t.url; transport.label = t.info; transport.play() },
    current: Track? = null,

    song: Audio [ volume = { parent.transport.loudness },
        onEnded() { parent.transport.stopped = true }
        ],

    well: View [ x = 6, y = 5, width = 32, height = 32, fill = #826886 ],
    picture: Image [ x = 4, y = 3, width = 32, height = 32, fit = both,
        source = { classroot.current != null ? classroot.current.imageurl : "" },
        accessibilityLabel = { classroot.current != null ? classroot.current.label : "" } ],

    transport: MediaTransport [ y = 32, width = 100%, label = "Choose a track below.", player = { classroot.song } ],

    list: TrackList [ y = 106, width = 100%, height = { parent.height - 108 }, kind = "audio",
        datapath = { app.musicData.value } ]
    ]


// Video: the picture, kept at the clip's 240:135 and centered on black, the
// transport under it, and a strip of clips along the foot.

class VideoPanel [
    playTrack(t: Track) { reel.source = t.url; transport.label = t.info; transport.play() },

    screen: View [ width = 100%, height = { parent.transport.y }, fill = #000000 ],
    reel: Video [ height = { parent.transport.y }, width = { this.height * 240 / 135 }, x = center,
        fit = both, clip = true, muted = false, volume = { parent.transport.loudness }, accessibilityLabel = { parent.transport.label },
        onEnded() { parent.transport.stopAt(0) }
        ],

    transport: MediaTransport [ y = { parent.height - 65 - 74 }, width = 100%, label = "Choose a video below.",
        player = { classroot.reel } ],

    list: TrackList [ y = { parent.height - 65 }, width = 100%, height = 65, fill = #F8EEF8, idleGround = #81657E, kind = "video",
        datapath = { app.videosData.value } ]
    ]
