/*
# LZX Dashboard

The OpenLaszlo **Dashboard** sample of 2003 — a web desktop with five windows, a
stack of tabs in each, live chat, a contacts book and a media player — in Declare.
The original ships with OpenLaszlo 5.0 under `examples/dashboard/`; this is the same
application, matched on what it looks like and how it behaves.

## The three files

| file | holds |
|---|---|
| `lzx-dashboard.declare` | the stage — five windows, the media popup, the login |
| `chrome.declare` | the window frame, the tab stack, the button: the drawn parts |
| `applets.declare` | chat, contacts, and the two media players |

The data is in `data/*.json`. The art is the original's: the desktop, the window
frames, tab bars, buttons and scrollbars, the period screenshots in the tabs, the
track art and the players' glyphs. The frames, tab bars and scrollbars are its
grayscale pieces, tinted per window with the original's own arithmetic. The fonts are the original's too: Bitstream Vera bold and roman, and
the Kroeger 6pt pixel face.

## Where things are

The App holds what the windows share: who signed in, the track offered in the
popup, and which track the two players are on. Keeping the now-playing choice here,
not in either player, is what lets the popup, the music tab and the video tab all
speak about one thing.
*/

include [ "chrome.declare" ]

include [ "applets.declare" ]

schema Track [ label: string, url: string, imageurl: string, info: string ]

schema Contact [ name: string, user: string, title: string, email: string, telephone: string, address: string,
    notes?: string, work?: string, cell?: string, fax?: string, address2?: string, address3?: string, address4?: string ]

schema Message [ from: string, text: string, self: boolean ]


// a desktop of fixed-size art, its fields at the design's sizes

defaultFlags [ devices = desktop ]

// The login's field: white, in a one-pixel black border.

class LoginInput extends TextInput [ width = 170, height = 20,
    fill = #FFFFFF, stroke = Stroke(1, #000000), cornerRadius = 0, padding = [0, 2, 0, 2]
    ]


/*
## The app

The page: the desktop art at its top left, five windows on it, the media popup,
and the login over everything until you sign in.
*/

App [ fill = #FFFFFF, appName = "Laszlo Dashboard",
    vera: Font [
        FontFace [ src = "resources/fonts/verabd.ttf", weight = bold ]
        ],
    veraRoman: Font [
        FontFace [ src = "resources/fonts/vera.ttf" ]
        ],
    kroe: Font [
        FontFace [ src = "resources/fonts/kroeger-6-plain-regular.ttf" ]
        ],

    // the original's defaults: 8px Verdana, for text that names no face or size of its own

    fontFamily = ["Verdana", "Vera", "sans-serif"], fontSize = 8, textColor = #000000,

    signedIn: boolean = false,
    userName: string = "guest",
    loginName: string = "",
    flashUser: string = "",

    // the track the popup offers, which player it is for, and the picture it was
    // offered from, which the popup opens over

    offered: Track? = null,
    offeredKind: string = "",
    offeredAt: View? = null,

    contactsData: DataSource [ url = "data/contacts.json", autoFetch = true, schema = [ contacts[]: Contact ] ],
    musicData:    DataSource [ url = "data/music.json", autoFetch = true, schema = [ tracks[]: Track ] ],
    videosData:   DataSource [ url = "data/videos.json", autoFetch = true, schema = [ tracks[]: Track ] ],
    chatLog: Dataset [ schema = [ messages[]: Message ] ] { { "messages": [] } },

    // the clock, turning over on the minute, and the label read from it

    minuteClock: Time [ tick = minute ],
    clockText: string = { app.clockLabel(app.minuteClock.now) },
    clockLabel(now: number) -> string {
        const d = new Date(now)
        const wd = ["Sun", "Mon", "Tues", "Wed", "Thur", "Fri", "Sat"][d.getDay()]
        const h = d.getHours() % 12 === 0 ? 12 : d.getHours() % 12
        const mm = String(d.getMinutes()).padStart(2, "0")
        return `${wd} ${h}:${mm} ${d.getHours() >= 12 ? "PM" : "AM"}`
        },

    signIn(name: string) {
        userName = name === "" ? "guest" : name
        signedIn = true
        // a contact's row lights when that person comes online; with no chat server,
        // one buddy arrives after a while to show it
        afterDelay(6000, () => { flashUser = "Bret" })
        },

    // offer a track in the popup, over its picture; play it, or let it go

    offer(art: View, track: Track, kind: string) {
        offeredAt = art
        offeredKind = kind
        offered = track
        },
    playOffered() {
        const t = offered
        if (t == null) return
        const tabs = app.desk.media.tabs
        if (offeredKind === "audio") tabs.musicTab.panel.playTrack(t)
        else tabs.videoTab.panel.playTrack(t)
        offered = null
        },

    // a press on the desktop between the windows sends them all home, each coming to
    // the front in turn

    restoreAll() {
        desk.dailyContent.restore(); desk.communications.restore()
        desk.planner.restore(); desk.media.restore(); desk.people.restore()
        },

    desktop: Image [ source = "resources/img/background.png", visible = { app.signedIn },
        onClick() { app.restoreAll() }
        ],

    clock: Label [ x = 923, y = 15, visible = { app.signedIn },
        fontFamily = { app.vera }, fontSize = 9, textColor = #FFFFFF,
        text = { "  " + app.clockText } ],

    /*
    ### The windows

    Five, placed on the desktop at the original's places; they are free to be
    dragged anywhere, past its edge too.
    */

    desk: View [ visible = { app.signedIn }, accessibilityRole = main,

        dailyContent: DashWindow [
            winLabel = "Daily Content", icon = "resources/img/dash_icon_daily.png",
            homeX = 18, homeY = 47, homeW = 464, homeH = 329,
            tint = #F2E9DA, art = "daily",

            tabs: TabStack [ x = 3, y = 31, width = { parent.width - 6 }, height = { parent.height - 46 },
                count = 4,
                DashTab [ art = "daily", label = "Entertainment", initiallyOpen = true,
                    shot: Image [ y = 19, source = "resources/img/entertainment_ex.jpg", accessibilityLabel = "Entertainment headlines" ]
                    ],
                DashTab [ art = "daily", label = "News",
                    shot: Image [ y = 19, source = "resources/img/news_ex.jpg", accessibilityLabel = "News headlines" ]
                    ],
                DashTab [ art = "daily", label = "Weather",
                    shot: Image [ y = 19, source = "resources/img/weather_ex.png", accessibilityLabel = "Weather" ]
                    ],
                DashTab [ art = "daily", label = "Horoscope",
                    shot: Image [ y = 19, source = "resources/img/horoscope_ex.png", accessibilityLabel = "Horoscope" ]
                    ]
                ]
            ],

        communications: DashWindow [
            winLabel = "Communications", icon = "resources/img/dash_icon_com.png",
            homeX = 18, homeY = 385, homeW = 464, homeH = 274,
            tint = #C9CCA3, art = "comm",

            tabs: TabStack [ x = 3, y = 31, width = { parent.width - 6 }, height = { parent.height - 46 },
                count = 4,
                DashTab [ art = "comm", label = "Email",
                    shot: Image [ y = 19, source = "resources/img/email_ex.jpg", accessibilityLabel = "Email" ]
                    ],
                DashTab [ art = "comm", label = "Chat", initiallyOpen = true,
                    panel: ChatPanel [ y = 19, width = 100%, height = { parent.height }, visible = { parent.open } ]
                    ],
                DashTab [ art = "comm", label = "Voice Mail",
                    shot: Image [ y = 19, source = "resources/img/voicemail_ex.jpg", accessibilityLabel = "Voice mail" ]
                    ],
                DashTab [ art = "comm", label = "Instant Messaging" ]
                ]
            ],

        planner: DashWindow [
            winLabel = "Planner", icon = "resources/img/dash_icon_planner.png",
            homeX = 498, homeY = 47, homeW = 247, homeH = 240,
            tint = #A6B5BC, art = "planner",

            tabs: TabStack [ x = 3, y = 31, width = { parent.width - 6 }, height = { parent.height - 46 },
                count = 4,
                DashTab [ art = "planner", label = "Calendar", initiallyOpen = true,
                    shot: Image [ x = -1, y = 18, source = "resources/img/db_cal.png", accessibilityLabel = "Calendar" ]
                    ],
                DashTab [ art = "planner", label = "Notes",
                    shot: Image [ x = -1, y = 18, source = "resources/img/notes.png", accessibilityLabel = "Notes" ]
                    ],
                DashTab [ art = "planner", label = "To Do List",
                    shot: Image [ x = -1, y = 18, source = "resources/img/list.png", accessibilityLabel = "To do list" ]
                    ],
                DashTab [ art = "planner", label = "Wallet",
                    shot: Image [ x = -1, y = 18, source = "resources/img/wallet.png", accessibilityLabel = "Wallet" ]
                    ]
                ]
            ],

        media: DashWindow [
            winLabel = "Media", icon = "resources/img/dash_icon_media.png",
            homeX = 498, homeY = 293, homeW = 246, homeH = 366, minWindowWidth = 246, minH = 100,
            tint = #6C6672, art = "media",

            tabs: TabStack [ x = 3, y = 31, width = { parent.width - 6 }, height = { parent.height - 46 },
                count = 3,
                musicTab: DashTab [ art = "media", label = "Music", initiallyOpen = true, fill = #BB95C0,
                    panel: MusicPanel [ y = 19, width = 100%, height = { parent.height }, clip = true, visible = { parent.open } ]
                    ],
                videoTab: DashTab [ art = "media", label = "Video", fill = #BB95C0,
                    panel: VideoPanel [ y = 18, width = 100%, height = { parent.height - 17 }, clip = true, visible = { parent.open } ]
                    ],
                DashTab [ art = "media", label = "Presentations", fill = #BB95C0,

                    // the slide in a dark frame, its width driving its height

                    frame: View [ x = 3, y = 21, width = { parent.width - 6 }, height = { Math.floor(this.width * 604 / 804) },
                        fill = #38244A, visible = { parent.open },
                        slide: Image [ x = 2, y = 2, width = { parent.width - 4 }, height = { parent.height - 4 }, fit = both,
                            source = "resources/img/presentation/q4numbers.png", accessibilityLabel = "Q4 numbers" ]
                        ]
                    ]
                ]
            ],

        people: DashWindow [
            winLabel = "People", icon = "resources/img/dash_icon_people.png",
            homeX = 758, homeY = 47, homeW = 210, homeH = 613, minH = 100,
            tint = #B6CCC1, art = "people",

            tabs: TabStack [ x = 3, y = 31, width = { parent.width - 6 }, height = { parent.height - 46 },
                count = 3,
                DashTab [ art = "people", label = "Signed-In" ],
                DashTab [ art = "people", label = "Buddies" ],
                DashTab [ art = "people", label = "Contacts", initiallyOpen = true,
                    panel: ContactsPanel [ y = 19, width = 100%, height = { parent.height - 10 }, visible = { parent.open } ]
                    ]
                ]
            ]
        ],

    /*
    ### The media popup

    Press a track and this balloon opens over its picture, naming the track and
    offering to play it. Its own close button lets it go, as does any press on a
    window or a tab, and Escape; it is placed once, when it opens.
    */

    popup: Floating [ width = 139, height = 43,
        shown = { app.offered != null },
        commit(open: boolean) { if (!open) app.offered = null },
        pressPolicy = "ignore",
        takesFocus = true,
        tabOrder() { return [play, dismiss] },
        accessibilityRole = dialog,
        accessibilityLabel = { app.offered != null ? app.offered.label : "" },
        x = { app.offeredAt != null ? app.offeredAt.rootOrigin().x - 139 / 2 + app.offeredAt.width / 2 : 0 },
        y = { app.offeredAt != null ? app.offeredAt.rootOrigin().y + 33 : 0 },

        art: Image [ source = "resources/img/media_popup.png" ],
        dismiss: Control [ x = 126, y = 4, accessibilityLabel = "Close",
            press() { app.offered = null },
            Image [ source = "resources/img/media_close.png" ]
            ],
        play: Control [ x = 30, y = 6, accessibilityLabel = "Play",
            press() { app.playOffered() },
            Image [ source = "resources/img/media_play.png" ]
            ],
        title: Label [ x = 3, y = 25, width = 100, fontFamily = { app.vera }, fontWeight = bold,
            fontSize = 10, textColor = #FFFFFF,
            text = { app.offered != null ? app.offered.label : "" } ]
        ],

    /*
    ## The login

    The login window opens at its full size over the grey, its loading bar
    showing; the bar fades out over 700ms, and then the form fades in over 500ms.
    Any name is accepted, or enter as a guest; signing in shows the desktop.
    Return in the name moves on to the title, and Return in the title signs in.
    */

    login: View [ width = 100%, height = 100%, fill = #80807E,
        visible = { !app.signedIn },

        // centered across, a third of the way down, on whole pixels

        panel: View [ x = { Math.floor((app.width - this.width) / 2) }, y = { Math.floor(app.height / 3 - this.height / 2) },
            width = 307, height = 172,
            accessibilityRole = dialog, accessibilityLabel = "Sign in to chat",

            dropShadow: DashShadow [ x = -3, width = { parent.width + 10 }, height = { parent.height + 10 } ],

            // the frame: a dark title strip with the logo, the rust body between
            // two edges, and a rounded foot

            top: View [ width = 100%, height = 31,
                logo: Image [ source = "resources/img/loadwndw_top_lft.png", accessibilityLabel = "Laszlo dashboard" ],
                strip: View [ x = 176, width = { parent.width - 181 }, height = 30, fill = #303030 ],
                rule: View [ x = 176, y = 30, width = { parent.width - 181 }, height = 1, fill = #000000 ],
                end: Image [ x = { parent.width - 5 }, source = "resources/img/loadwndw_top_lrt.png" ]
                ],
            middle: View [ y = 31, width = 100%, height = { parent.height - 31 - 14 }, fill = #C26E54,
                left: Image [ width = 5, height = 100%, fit = both, source = "resources/img/loadwndw_lft_mid.png" ],
                right: Image [ x = { parent.width - 5 }, width = 5, height = 100%, fit = both,
                    source = "resources/img/loadwndw_rt_mid.png" ]
                ],
            bottom: View [ y = { parent.height - 14 }, width = 100%, height = 14,
                left: Image [ source = "resources/img/loadwndw_bot_lft.png" ],
                middle: Image [ x = 12, width = { parent.width - 24 }, height = 14, fit = both,
                    source = "resources/img/loadwndw_bot_mid.png" ],
                right: Image [ x = { parent.width - 12 }, source = "resources/img/loadwndw_bot_rt.png" ]
                ],

            // the loading bar, full, since the app has loaded by the time it shows

            loadView: View [ y = 40, width = 100%, accessibilityHidden = true,
                loading: Image [ x = center, source = "resources/img/preloader_loading.png" ],
                well: Image [ x = center, y = 29, source = "resources/img/viewloader_well.png" ],
                bar: View [ x = { parent.well.x + 1 }, y = 31, width = { parent.well.width - 2 }, height = 15,
                    left: Image [ source = "resources/img/prog_bar_lft.png" ],
                    middle: Image [ x = 8, width = { parent.width - 16 }, fit = both, source = "resources/img/prog_bar_mid.png" ],
                    right: Image [ x = { parent.width - 8 }, source = "resources/img/prog_bar_rt.png" ]
                    ],
                fadeOut: Animator [ attribute = opacity, to = 0, duration = 700, easing = laszloBoth, started = true ]
                ],

            form: View [ x = 4, y = 31, width = 300, opacity = 0,
                visible = { this.opacity > 0 },
                fadeUp: Animator [ attribute = opacity, to = 1, duration = 500, easing = laszloBoth,
                    started = { app.login.panel.loadView.fadeOut.arrived } ],
                fontFamily = { app.veraRoman }, fontSize = 12, textColor = #000000,
                layout: SimpleLayout [ axis = y, spacing = 10 ],

                top: View [ x = 6,
                    fields: View [ y = 8,
                        layout: SimpleLayout [ axis = y, spacing = 10 ],
                        heading: View [
                            layout: SimpleLayout [ axis = x, spacing = 10 ],
                            Label [ height = 18, opacity = 0.8, fontFamily = { app.vera }, fontWeight = bold, text = "Sign in to chat" ],
                            Label [ y = 2, fontSize = 10, text = "(information not saved)" ]
                            ],
                        namePart: View [
                            Label [ text = "Name" ],
                            input: LoginInput [ x = 50, accessibilityLabel = "Name",
                                value <-> app.loginName,
                                onEnter() { Focus.focus(app.login.panel.form.top.fields.titlePart.input) }
                                ]
                            ],
                        titlePart: View [
                            Label [ text = "Title" ],
                            input: LoginInput [ x = 50, accessibilityLabel = "Title",
                                onEnter() { app.signIn(app.loginName) }
                                ]
                            ]
                        ],
                    signIn: StretchedImageButton [ x = 230, y = 66, width = 55, height = 20, accessibilityLabel = "Sign in",
                        upArt = "resources/img/signin/signin_btn_up.png",
                        overArt = "resources/img/signin/signin_btn_mo.png",
                        downArt = "resources/img/signin/signin_btn_dn.png",
                        press() { app.signIn(app.loginName) }
                        ]
                    ],

                rule: View [ x = 6, width = { parent.top.width }, height = 2, opacity = 0.5,
                    dark: View [ width = 100%, height = 1, fill = #000000 ],
                    light: View [ y = 1, width = 100%, height = 1, fill = #FFFFFF ]
                    ],

                bottom: View [ x = 6,
                    Label [ opacity = 0.8, fontFamily = { app.vera }, fontWeight = bold, text = "or enter as a guest." ],
                    guest: StretchedImageButton [ x = 230, width = 55, height = 20, accessibilityLabel = "Enter as a guest",
                        upArt = "resources/img/signin/guest_btn_up.png",
                        overArt = "resources/img/signin/guest_btn_mo.png",
                        downArt = "resources/img/signin/guest_btn_dn.png",
                        press() { app.signIn("") }
                        ]
                    ]
                ]
            ]
        ]
    ]
