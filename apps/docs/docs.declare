/*
# Declare docs

The Declare documentation, rendered as a Declare app — Declare documenting
Declare. It loads `docs/declare-model.json`, one walkable data structure, and
renders four modes over it: the guide, chapter by chapter; the language, one
page per form the grammar accepts; the types, one page per named vocabulary a
signature prints; and the class reference, a page per class with its prose,
members, and live examples. A left rail navigates the mode, a detail pane
reads it, and every doc string is rendered by the runtime's own Markdown view.

`{ }` bodies are TypeScript → `0x…` colors and expressions; `[ ]` literal
attributes take `#…` / named colors. Every color reads `theme.<token>` — one
provided record on the App (see it there), so the whole document reskins
from one place.
*/

/*
## Type tokens

Selection is a provided value: these tokens don't opt in themselves — the
detail pane sets `selectable = true` on its container, so all right-pane text
(including Markdown prose) is selectable, while the left rail stays
unselectable chrome.
*/

class Title extends Text [ fontWeight = semibold, textColor = { provided("theme").text } ]

class Muted extends Text [ textColor = { provided("theme").textMuted } ]

class Mono extends Text [ fontFamily = { app.mono } ]

// a class tab in the left rail — selection is one App attribute
// (`app.selected`, the class name); a tab lights when it matches and writes
// the location on click, so the whole navigator is one string

class ClassTab [ width = 100%, height = { app.touchDevice ? 44 : 30 }, cornerRadius = 6,
    cname:   string = "",
    lit: boolean = { app.mode == "reference" && app.selected == classroot.cname },
    fill = { lit ? provided("theme").sel : hovered ? provided("theme").control : null },
    link = { "#reference/" + cname },
    onClick()     { app.goRef(classroot.cname); app.navOpen = false },

    // the label ends 12 short of the row edge; a title written to fit never
    // reaches it, and one that does not is cut with an ellipsis there

    lbl: Mono [ x = 24, y = { 7 + (parent.height - 30) / 2 }, fontSize = 14, wrap = false, width = { parent.width - 36 }, maxLines = 1,
        text = { classroot.cname },
        textColor = { classroot.lit ? provided("theme").text : provided("theme").tabIdle } ]
    ]


/* A rail group's head — the line that folds it. Untouched, a group is OPEN when
   it holds the current page and closed otherwise, so the rail always shows where
   you are. A click overrides that, and THE TWO OVERRIDES DO NOT EXPIRE ALIKE:

   - OPENED BY THE READER: permanent. What the reader opened stays open through
     every navigation. The rail's contents must not move under the hand that is
     clicking in it — an outline that re-folds itself on every click makes the
     reader hunt for a row that was under the cursor a moment ago.
   - SHUT BY THE READER: keyed to the page it was made on, which is what it takes
     to shut a group the rail is auto-opening BECAUSE it holds the current page.
     Navigating away retires it, so a group shut once is not shut forever.

   One class serves the guide's parts, the language's form groups, and the class
   groups alike. */

class FoldHead extends Control [ width = 100%, height = { app.touchDevice ? 44 : 28 }, cornerRadius = 6, cursor = "pointer",
    label:    string  = "",
    accessibilityExpanded = { this.open },
    contains: boolean = false,             // does this group hold the current page?
    opened:   boolean = false,             // it has been open — this does not expire
    shut:     boolean = false,             // the reader shut it, …
    shutAt:   string  = "",                // … keyed by the page it was made on
    open:     boolean = { (classroot.shut && classroot.shutAt == app.page) ? false
        : classroot.opened || classroot.contains },

    // Once open, it stays open: a group the rail opened because it held the page
    // latches here, so navigating out of it does not fold it up under the
    // reader. Only a click closes anything.
    // (`onInit` as well as `onChange`: the group holding the page the reader
    // landed on has `contains` true from construction, and a value that starts
    // true never changes, so no change event would latch it.)

    trackChanges = ["contains"],
    onInit() { if (contains) opened = true },
    onChange(e: ChangeEvent) { if (contains) { opened = true; shut = false } },
    fill = { hovered ? provided("theme").control : null },
    press() {
        if (open) { opened = false; shut = true; shutAt = app.page }
        else { opened = true; shut = false }
        },
    mark: Mono [ x = 8, y = { 8 + (parent.height - 28) / 2 }, fontSize = 10, wrap = false, textColor = { provided("theme").textMuted },
        text = { classroot.open ? "\u25BC" : "\u25B6" } ],
    lbl: Text [ x = 24, y = { 6 + (parent.height - 28) / 2 }, fontSize = 14, fontWeight = semibold, wrap = false, width = { parent.width - 36 }, maxLines = 1,
        text = { classroot.label },
        textColor = { classroot.contains ? provided("theme").text : provided("theme").tabIdle } ]
    ]


// one topic of classes in the reference rail (model.classGroups — extract's CLASS_GROUPS)

class ClassGroup [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    head: FoldHead [ label = { "" + :name },
        contains = { app.mode == "reference" && (:classes as any[]).some(c => c.name == app.selected) } ],
    body: View [ width = 100%, visible = { classroot.head.open }, padding = [0, 0, 8, 0],
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        ClassTab [ datapath = :classes[], cname = :name ]
        ]
    ]


/*
## The reference kit

The chips, links, rows, and strips a class page is built from. A chip is a
member name in a tinted pill — attribute teal, method blue, event amber, class
accent — and a class chip is a link: a location write, exactly as a rail tab.
Every row of mixed type is a baseline row (`align = baseline`), and every
composite in one claims its baseline.
*/

class Eyebrow extends Mono [ fontSize = { 11 * app.fontScale }, letterSpacing = 1.2, wrap = false,
    textColor = { provided("theme").eyebrow }
    ]


// a section: a rule above, the heading, one line on what the section holds

class SectionHead [ width = 100%,
    head: string = "",
    note: string = "",
    layout: SimpleLayout [ axis = y, spacing = 18 ],
    rule: Divider [ ],
    title: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 4 ],
        Title [ fontSize = { 20 * app.fontScale }, text = { classroot.head } ],
        Muted [ fontSize = { 14 * app.fontScale }, width = 100%, text = { classroot.note } ]
        ]
    ]


class Chip [ height = { 24 * app.fontScale }, cornerRadius = 6,
    baseline: number = { this.lbl.y + this.lbl.baseline },
    label: string = "",
    kind:  "attribute" | "method" | "event" | "class" | "token" = "attribute",
    cls:   string = "",
    width = { this.lbl.width + 16 },
    fill = { hovered && cls != "" ? provided("theme").chipHov
           : kind == "method" ? provided("theme").mchipBg
           : kind == "event"  ? provided("theme").echipBg
           : provided("theme").chipBg },
    cursor = { cls != "" ? "pointer" : "default" },
    link = { cls != "" ? "#reference/" + cls : "" },
    onClick() { if (cls != "") app.goRef(cls) },
    lbl: Mono [ x = 8, y = { 5 * app.fontScale }, fontSize = { 13 * app.fontScale }, wrap = false,
        text = { classroot.label },
        textColor = { classroot.kind == "class"  ? provided("theme").accent
                    : classroot.kind == "method" ? provided("theme").chipBlue
                    : classroot.kind == "event"  ? provided("theme").chipAmber
                    : classroot.kind == "token"  ? provided("theme").code
                    : provided("theme").chipTeal } ]
    ]


// a member's chip in the index under its section head: a link to the member's
// own anchor on this page (`reference/View@width`)

class MemberChip extends Chip [
    label = { "" + :name },
    cursor = "pointer",
    fill = { hovered ? provided("theme").chipHov
           : kind == "method" ? provided("theme").mchipBg
           : kind == "event"  ? provided("theme").echipBg
           : provided("theme").chipBg },
    link = { "#" + provided("docPage", app.page) + "@" + :name }
    ]


// the index itself — every member of a section as a chip, when there is more
// than one to choose between

class MemberIndex [ width = 100%,
    layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ]
    ]


/*
## Linked signatures

A type printed in a signature is a NAME, and a name with a page behind it is a
link. `app.typeLoc` answers where a printed type is documented — by name
(`Color`, `Motion`, and every class), or by the TOKEN LIST a named enum prints
as (`left | center | right` is `TextAlign`), which is the spelling the reference
shows and so the spelling matched. A type with no page answers `""` and renders
as plain signature text: no cursor and no link.

`SigRun` is the same answer for a whole signature — `onKeyDown(e: KeyEvent)`,
`set(path: string, v: unknown): void` — split into runs, each identifier that
names a page carrying it and everything between them left alone.
*/

class LocChip [ height = { 24 * app.fontScale }, cornerRadius = 6,
    baseline: number = { this.lbl.y + this.lbl.baseline },
    label: string = "",
    to:    string = "",                    // a docs location ("type/Color", "reference/View"), or "" for no link
    tone:  Color  = { provided("theme").accent },
    width = { this.lbl.width + 16 },
    fill = { hovered && to != "" ? provided("theme").chipHov : provided("theme").chipBg },
    cursor = { to != "" ? "pointer" : "default" },
    link = { to != "" ? "#" + to : "" },
    onClick() { if (to != "") app.goLoc(to) },
    lbl: Mono [ x = 8, y = { 5 * app.fontScale }, fontSize = { 13 * app.fontScale }, wrap = false,
        text = { classroot.label },
        textColor = { classroot.tone } ]
    ]


class SigRun [
    sig:    string = "",
    size:   number = 15,
    weight: number = 400,                  // the hundreds ARE the weight keywords (FontWeight)
    dim:    Color  = { provided("theme").text },   // the colour of every run that is not a link

    // the widest it may run: a longer signature wraps between its parts, its
    // later lines stepped in. (Its own width is the face's measure of the whole
    // string, never the layout's, which would wrap at whatever it was handed.)

    limit:  number = 100000,
    natural: number = { Math.ceil(measureText(classroot.sig, ({ fontSize: classroot.size * app.fontScale, fontWeight: classroot.weight, fontFamily: app.mono })).width) + 2 },
    parts: Dataset [ contents = { { items: app.typeParts(classroot.sig) } } ],
    width  = { this.run.width },
    height = { this.run.height },
    run: View [ datapath = { classroot.parts.value },
        width = { Math.min(classroot.natural, classroot.limit) }, height = { this.contentHeight },
        layout: WrappingLayout [ spacing = 0, rowSpacing = 2, hangingIndent = 16 ],
        Mono [ datapath = :items[], wrap = false,
            fontSize = { classroot.size * app.fontScale },
            fontWeight = { classroot.weight },
            cursor = { :to != "" ? "pointer" : "default" },
            link = { :to != "" ? "#" + :to : "" },
            onClick() { if (:to != "") app.goLoc("" + :to) },
            textColor = { :to == "" ? classroot.dim
                        : hovered ? provided("theme").accent : provided("theme").accentSecondary },
            text = { "" + :t }
            ]
        ]
    ]


// one step of the ancestry: `→` before every ancestor but the first, then its chip

class Link [
    baseline: number = { this.chip.y + this.chip.baseline },
    width = { this.contentWidth },
    layout: SimpleLayout [ axis = x, spacing = 8, align = baseline ],
    arrow: Mono [ fontSize = { 14 * app.fontScale }, visible = { :arrow }, textColor = { provided("theme").sigDim }, text = "→" ],
    chip:  Chip [ kind = "class", cls = { "" + :name }, label = { "" + :name } ]
    ]


// a section link in the row under the opener: the section's name, its count, and
// a link to the section's anchor on this page — so the jump is an address
// (`reference/View@attributes`), Back returns to where the reader was, and the
// section can be linked to from anywhere

class JumpLink [
    baseline: number = { this.row.y + this.row.name.y + this.row.name.baseline },
    label: string = "",
    count: number = 0,
    to: string = "",                       // the section's anchor name
    height = { 28 * app.fontScale }, cornerRadius = 7, cursor = "pointer",
    width = { this.row.width + 24 },
    fill = { hovered ? provided("theme").chipHov : provided("theme").chipBg },

    // a title longer than the strip it sits in is cut to it, ending in an ellipsis

    room: number = { provided("tocSpan", parent.width) - 24 - (this.count > 0 ? this.row.n.width + 6 : 0) },

    // the page this link sits on, which its page view provides — a page stays
    // resident when hidden, so the current location is not necessarily its own

    link = { to != "" ? "#" + provided("docPage", app.page) + "@" + to : "" },
    row: View [ x = 12, y = { 5 * app.fontScale }, width = { this.contentWidth }, height = { 18 * app.fontScale },
        layout: SimpleLayout [ axis = x, spacing = 6, align = baseline ],
        name: Text [ fontSize = { 13 * app.fontScale }, fontWeight = semibold, wrap = false, maxLines = 1,
            width = { Math.min(Math.ceil(measureText(classroot.label, providedTextStyle({ fontSize: this.fontSize, fontWeight: 600 })).width) + 1, classroot.room) },
            textColor = { provided("theme").accent }, text = { classroot.label } ],
        n: Mono [ fontSize = { 12 * app.fontScale }, wrap = false, textColor = { provided("theme").sigDim },
            visible = { classroot.count > 0 }, text = { "" + classroot.count } ]
        ]
    ]


// "On this page": the section links of a page. Beside a rail they wrap under one
// another; on a phone the strip is one line that scrolls sideways, each title
// cut to the strip's width rather than the line's.

class TocFlow extends WrappingLayout [
    oneLine: boolean = false,
    place() {
        if (!this.oneLine) return super.place()
        const kids = this.laid()
        let base = 0
        for (const c of kids) if (c.visible && typeof (c as any).baseline == "number") base = Math.max(base, (c as any).baseline)
        const out = [] as any
        let cx = 0
        for (const c of kids) {
            if (!c.visible) { out.push({ x: cx, y: 0 }); continue }
            const f = (c as any).footprint()
            const b = (c as any).baseline
            out.push({ x: cx - f.x, y: (typeof b == "number" ? base - b : 0) - f.y })
            cx = cx + f.width + this.spacing
        }
        return out
        }
    ]


class OnThisPage [ width = 100%,
    tocSpan: number = { this.width },          // provided: the room a link's title is cut to
    scrolls = { app.docked ? "none" : "x" },
    defaultplacement = row,
    row: View [ width = { app.docked ? parent.width : this.contentWidth },
        layout: TocFlow [ oneLine = { !app.docked }, spacing = 8, rowSpacing = 8, align = baseline ],
        Muted [ fontSize = { 16 * app.fontScale }, wrap = false, text = "On this page:" ]
        ]
    ]


/*
## The wrapping chip

A chip in an inherited strip is a run of words, each word its own tinted box,
abutting — invisibly one chip while it fits. When the label is wider than the
column the chip takes the whole width and its words wrap inside it, the
continuation rows stepped in by the run's `hangingIndent`. Rounding is the
run's: its first word rounds on the left, its last on the right, every other
edge — a row's cut included — runs square, as an inline code span breaks
across lines. (A single word wider than the column still overflows; breaking
inside a word is the text engine's, not a flow's.)
*/

class WrapChip [
    kind:  "attribute" | "method" | "event" = "attribute",
    cls:   string = "",
    label: string = "",
    n:     number = { app.wordsOf(label).length },

    // wider than the column? then the chip is the column, and its words wrap

    long:  boolean = { measureText(label, ({ fontSize: 13 * app.fontScale, fontFamily: app.mono })).width + 16 > parent.width },
    width  = { long ? parent.width : this.run.contentWidth },
    height = { this.run.contentHeight },
    cursor = "pointer",
    link = { "#reference/" + cls },
    onClick() { app.goRef(cls) },
    words: Dataset [ contents = { { items: app.wordsOf(classroot.label) } } ],   // the words as declared data — a cursor root

    // the run's width never comes from the chip (whose width follows the run's
    // content — a cycle): the column when long, else unbounded, pointer-transparent

    run: View [ width = { classroot.long ? classroot.parent.width : 100000 }, pointerEvents = "none",
        datapath = { classroot.words.value },
        layout: WrappingLayout [ spacing = 0, rowSpacing = 4, hangingIndent = 24 ],
        View [ datapath = :items[], height = { 24 * app.fontScale },
            first: boolean = { rowIndex == 0 },
            last:  boolean = { rowIndex == classroot.n - 1 },
            width = { this.t.width + (first ? 8 : 0) + (last ? 8 : 0) },
            cornerRadius = { [first ? 6 : 0, last ? 6 : 0, last ? 6 : 0, first ? 6 : 0] },
            fill = { classroot.hovered ? provided("theme").chipHov
                   : classroot.kind == "method" ? provided("theme").mchipBg
                   : classroot.kind == "event"  ? provided("theme").echipBg
                   : provided("theme").chipBg },
            t: Mono [ x = { parent.first ? 8 : 0 }, y = { 5 * app.fontScale }, fontSize = { 13 * app.fontScale }, wrap = false,
                text = { "" + :w },
                textColor = { classroot.kind == "method" ? provided("theme").chipBlue
                            : classroot.kind == "event"  ? provided("theme").chipAmber
                            : provided("theme").chipTeal } ]
            ]
        ]
    ]


/*
## Reference rows

One row per documented member. `AttrRow` is an attribute: the signature line
(name : type = default), a long or multi-line default on its own indented line,
the read-only badge, the OVERRIDE line when the class re-defaults
an inherited member (the ancestor's member as a link, and what its default was
there), then its prose — for an override, the INTENT. `MethodRow` and
`EventRow` are the method and event forms.
*/

class OverrideLine [ width = 100%,
    from:  string = "",
    slot:  string = "",
    was:   string = "",
    layout: WrappingLayout [ spacing = 8, rowSpacing = 4, align = baseline ],
    Muted [ fontSize = { 13 * app.fontScale }, text = "overrides" ],
    Chip [ kind = "class", cls = { classroot.from }, label = { classroot.from + "." + classroot.slot } ],
    Mono [ fontSize = { 13 * app.fontScale }, textColor = { provided("theme").sigDim }, visible = { classroot.was != "" },
        text = { "was = " + classroot.was } ]
    ]


class AttrRow [ width = 100%,
    anchor = { "" + :name },                // the member's address on its page
    live:  boolean = false,                 // page-active, threaded down to any inline island

    // a long or multi-line `{ … }` default leaves the signature line and sits on its
    // own, indented — a signature is never truncated and never scrolls

    long: boolean = { ("" + (:default ?? "")).length > (app.docked ? 44 : 20) || ("" + (:default ?? "")).indexOf("\n") >= 0 || this.longType },

    // a long union type (blendMode's eleven modes) leaves the line the same way and
    // wraps — an unwrapped line wider than the pane would let a click-to-jump scroll
    // the whole page sideways

    longType: boolean = { ("" + :type).length > (app.docked ? 56 : 24) },

    // the printed type's own page, when it has one — a name, or a named enum's
    // token list. "" (no page) leaves the type unlinked.

    typeTo: string = { app.typeLoc("" + :type) },
    layout: SimpleLayout [ axis = y, spacing = 6 ],

    sig: View [ width = 100%,
        layout: WrappingLayout [ spacing = 8, rowSpacing = 4, align = baseline ],
        Mono [ fontSize = { 15 * app.fontScale }, fontWeight = semibold, textColor = { provided("theme").text }, text = { :name } ],
        ty: Mono [ fontSize = { 15 * app.fontScale }, visible = { !classroot.longType }, text = { ": " + :type },
            textColor = { classroot.typeTo != "" && this.hovered ? provided("theme").accent : provided("theme").accentSecondary },
            cursor = { classroot.typeTo != "" ? "pointer" : "default" },
            link = { classroot.typeTo != "" ? "#" + classroot.typeTo : "" },
            onClick() { if (classroot.typeTo != "") app.goLoc(classroot.typeTo) }
            ],
        Mono [ fontSize = { 14 * app.fontScale }, textColor = { provided("theme").sigDim }, visible = { !classroot.long },
            text = { :default != null ? "= " + :default : "" } ]
        ],
    longTypeLine: Mono [ x = 24, width = { parent.width - 24 }, fontSize = { 14 * app.fontScale }, lineHeight = 1.45,
        visible = { classroot.longType }, text = { ": " + :type },
        textColor = { classroot.typeTo != "" && this.hovered ? provided("theme").accent : provided("theme").accentSecondary },
        cursor = { classroot.typeTo != "" ? "pointer" : "default" },
        link = { classroot.typeTo != "" ? "#" + classroot.typeTo : "" },
        onClick() { if (classroot.typeTo != "") app.goLoc(classroot.typeTo) }
        ],
    longDefault: Mono [ x = 24, width = { parent.width - 24 }, fontSize = { 13 * app.fontScale }, lineHeight = 1.45, textColor = { provided("theme").sigDim },
        visible = { classroot.long }, text = { "= " + ("" + :default).split("\n").join("\n  ") } ],

    flags: Mono [ fontSize = { 12 * app.fontScale }, textColor = { provided("theme").eyebrow },
        visible = { :readOnly },
        text = { :readOnly ? "read-only" : "" } ],

    OverrideLine [ visible = { :overrides != null }, from = { "" + :overrides.from }, slot = { "" + :name },
        was = { :overrides.was != null ? "" + :overrides.was : "" } ],

    Block [ datapath = :docSegs[], width = 100%,
        live = { classroot.live }, tone = { provided("theme").refDim }, lead = 1.6 ]
    ]


// The signature string (`set(path: string, v: unknown): void`) comes whole from
// the model; a `:sig.slice()` would be read as a datapath (the `.` extends
// the path), so the datapath values are captured into plain attributes first
// and sliced in TypeScript.

class MethodRow [ width = 100%,
    anchor = { "" + :name },
    aname:    string = { :name },
    sigfull:  string = { :signature },
    tailtext: string = { this.sigfull.slice(this.aname.length) },   // "(path: …): void"
    live:     boolean = false,
    layout: SimpleLayout [ axis = y, spacing = 6 ],

    sig: View [ width = 100%,
        layout: SimpleLayout [ axis = x, spacing = 0 ],
        nm: Mono [ fontSize = { 15 * app.fontScale }, fontWeight = semibold, textColor = { provided("theme").text }, text = { classroot.aname } ],
        SigRun [ sig = { classroot.tailtext }, size = 15, dim = { provided("theme").mtail },
            limit = { app.docked ? 100000 : parent.width - parent.nm.width } ]
        ],

    OverrideLine [ visible = { :overrides != null }, from = { "" + :overrides.from }, slot = { :name + "()" }, was = "" ],

    Block [ datapath = :docSegs[], width = 100%,
        live = { classroot.live }, tone = { provided("theme").refDim }, lead = 1.6 ]
    ]


class EventRow [ width = 100%,
    anchor = { "" + :name },
    live:  boolean = false,
    layout: SimpleLayout [ axis = y, spacing = 6 ],

    sig: SigRun [ sig = { "" + :signature }, size = 15, weight = 600, dim = { provided("theme").text },
        limit = { app.docked ? 100000 : parent.width } ],

    Block [ datapath = :docSegs[], width = 100%,
        live = { classroot.live }, tone = { provided("theme").refDim }, lead = 1.6 ]
    ]


/*
## The strips

Per ancestor: what the class inherits (`Strip` — the disclosure, the class as a
link, the member counts, one baseline row, then its one-line lead; open, a chip
cloud of every name, each a link, never the ancestor's prose) and what it reads
from above of its own (`ReadStrip`, under Provided — present only for an
ancestor that reads something).
*/

class ReadStrip [ width = 100%, cornerRadius = 10, visible = { :n > 0 },
    open:  boolean = false,
    cname: string = { "" + :name },
    fill = { provided("theme").surface }, stroke = { stroke(1, provided("theme").line) },
    layout: SimpleLayout [ axis = y, spacing = 0 ],
    head: Control [ width = 100%, height = { app.touchDevice ? 44 : 40 }, cursor = "pointer", cornerRadius = 10,
        accessibilityExpanded = { classroot.open },
        fill = { hovered ? provided("theme").chipBg : null },
        padding = [10, 16, 10, 16],
        press() { classroot.open = !classroot.open },
        title: View [ width = 100%,
            layout: SimpleLayout [ axis = x, spacing = 10, align = baseline ],
            Mono [ fontSize = { 15 * app.fontScale }, wrap = false, textColor = { provided("theme").accent }, text = { classroot.open ? "▼" : "▶" } ],
            Muted [ fontSize = { 13 * app.fontScale }, wrap = false, text = "from" ],
            Chip [ kind = "class", cls = { classroot.cname }, label = { classroot.cname } ],
            Mono [ fontSize = { 13 * app.fontScale }, wrap = false, textColor = { provided("theme").sigDim },
                text = { :n + (:n == 1 ? " value" : " values") } ]
            ]
        ],
    body: View [ width = 100%, visible = { classroot.open },
        padding = [4, 16, 16, 16],
        layout: SimpleLayout [ axis = y, spacing = 8 ],
        tokens: View [ width = 100%, visible = { :reads.theme.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Chip [ datapath = :reads.theme[], kind = "token", label = { "theme." + :@ } ]   // :@ — the record is the string itself
            ],
        provided: View [ width = 100%, visible = { :reads.provided.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Chip [ datapath = :reads.provided[], kind = "token", label = { "" + :@ } ]
            ]
        ]
    ]


class Strip [ width = 100%, cornerRadius = 10,
    open:  boolean = false,                    // a declaration default: yields to the click
    cname: string = { "" + :name },
    fill = { provided("theme").surface }, stroke = { stroke(1, provided("theme").line) },
    layout: SimpleLayout [ axis = y, spacing = 0 ],

    head: Control [ width = 100%, cursor = "pointer",
        accessibilityExpanded = { classroot.open },
        height = { this.lead.y + this.lead.height + 14 },
        fill = { hovered ? provided("theme").chipBg : null }, cornerRadius = 10,
        press() { classroot.open = !classroot.open },
        title: View [ x = 16, y = 12, width = { parent.width - 32 },
            layout: WrappingLayout [ spacing = 10, rowSpacing = 4, align = baseline ],
            Mono [ fontSize = { 15 * app.fontScale }, wrap = false, textColor = { provided("theme").accent }, text = { classroot.open ? "▼" : "▶" } ],
            Muted [ fontSize = { 13 * app.fontScale }, wrap = false, text = "from" ],
            Chip [ kind = "class", cls = { classroot.cname }, label = { classroot.cname } ],
            Mono [ fontSize = { 13 * app.fontScale }, wrap = false, textColor = { provided("theme").sigDim },
                text = { :attributes.length + " attributes · " + :methods.length + " methods · " + :events.length + " events" } ]
            ],
        lead: Muted [ x = 42, y = { parent.title.y + parent.title.height + 6 }, fontSize = { 13 * app.fontScale }, width = { parent.width - 58 },
            text = { "" + :lead } ]
        ],

    body: View [ width = 100%, visible = { classroot.open },
        padding = [12, 16, 18, 16],
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        attrs: View [ width = 100%, visible = { :attributes.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6 ],
            WrapChip [ datapath = :attributes[], kind = "attribute", cls = { classroot.cname }, label = { "" + :label } ]
            ],
        methods: View [ width = 100%, visible = { :methods.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6 ],
            WrapChip [ datapath = :methods[], kind = "method", cls = { classroot.cname }, label = { "" + :label } ]
            ],
        events: View [ width = 100%, visible = { :events.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6 ],
            WrapChip [ datapath = :events[], kind = "event", cls = { classroot.cname }, label = { "" + :label } ]
            ]
        ]
    ]


/*
## The live example

An editable source field beside a running preview — the same machinery as the
homepage's editable demos: a `TextInput` seeded from the demo source that
republishes edits on `app.liveSource`, and an `AppIsland` the host mounts
the compiled child app into. Both are keyed by the example's program,
`demos/<Class>` beside this one (the extractor writes it there): the editor's
`editName` names the edit, and the island's `program` is what the host runs.
*/

class DocField extends TextInput [ multiline = true, spellcheck = false, wrap = false,
    accessibilityLabel = "Example source",
    fontFamily = { app.mono }, fontSize = { 13 * app.fontScale }, textColor = { provided("theme").code },   // 13 = the house code size (PROSE.codeSize)
    editName: string = "",
    src: string = "",

    // Seed the field from the demo source once the subtree exists. `initial`
    // would seed before the datapath has resolved `src`; an `onInit` write lands
    // after it, and — an author write, not a constraint — leaves the field
    // freely editable.

    onInit() { text = src },
    onInput() { app.liveCard = editName; app.liveSource = text }
    ]


// Rendered by datapath replication over the class's 0-or-1 `example` array, so the
// whole island (editor + preview) is constructed only for classes that ship a demo.

class Example [ width = 100%,
    cname:  string = { :name },
    demo:   string = { "demos/" + cname },      // the example's program, beside this one
    elines: number = { :lines },
    esrc:   string = { :source },
    estage: number = { :stageH || 250 },   // extractor-measured stage height — the frame fits the settled app
    live:   boolean = false,             // the parent gates the preview: it mounts only when this is true

    // this island's edit failed to compile (host publishes the report; see RunIsland)

    broken: boolean = { app.liveCard == demo && app.liveReport != "" },
    layout: SimpleLayout [ axis = y, spacing = 0 ],   // the preview frame abuts the code block below, no gap

    // the example's own title and lead (from the demo file's opening comment)

    head: View [ width = 100%, padding = [0, 0, 12, 0],
        layout: SimpleLayout [ axis = y, spacing = 6 ],
        Title [ fontSize = { 16 * app.fontScale }, text = { "" + :title } ],
        lead: Markdown [ width = 100%, visible = { ("" + :lead) != "" }, lineHeight = 1.55,
            bodyColor = { provided("theme").refDim }, fontScale = { app.fontScale }, text = { "" + :lead } ]
        ],

    // the editable source card — coheres with a static code block (the same
    // `chipBg` tint, 8px radius, 13px code face) but is marked live/editable by an
    // amber left bar + label, where a read-only block carries the teal `codeRule`.

    panel: View [ width = 100%, fill = { provided("theme").chipBg },
        height = { Math.min(classroot.elines * 15 * app.fontScale + 105, 900) },   // 15px/line measured; field pad + 60/8 chrome
        bar:   View [ x = 0, y = 0, width = 3, height = 100%, fill = { classroot.broken ? provided("theme").errBar : provided("theme").live } ],
        fname: Mono [ x = 18, y = 10, fontSize = { 11 * app.fontScale }, fontWeight = semibold, textColor = { provided("theme").strong },
            wrap = false, maxLines = 1,                // cut, ending in an ellipsis, where Revert begins
            width = { Math.min(Math.ceil(measureText(this.text, ({ fontSize: this.fontSize, fontWeight: 600, fontFamily: app.mono })).width) + 1, parent.rev.x - 28) },
            text = { classroot.cname + ".declare" } ],

        // the marker is an inverted chip — the amber accent as fill, dark letters —
        // so "live/editable" reads at a glance, distinct from a read-only block

        tag:   View [ y = 7, height = 17, cornerRadius = 3, fill = { provided("theme").live }, x = { parent.width - this.width - 14 },
            lbl: Mono [ x = 7, y = 3, fontSize = 10, letterSpacing = 1, fontWeight = semibold, textColor = { provided("theme").liveInk },
                text = "LIVE · EDITABLE", wrap = false ],
            width = { this.lbl.width + 14 }
            ],

        // Revert — restore the pristine source and republish (see RunIsland)

        // (on touch the control is a finger's height around the same pill)

        rev: Control [ y = { app.touchDevice ? 3 : 5 }, height = { app.touchDevice ? 44 : 20 }, cornerRadius = 6,
            x = { parent.tag.x - this.width - 10 },
            width = { this.pill.width },
            press() { classroot.panel.field.text = classroot.esrc
                      app.liveCard = classroot.demo
                      app.liveSource = classroot.esrc },
            pill: View [ y = center, height = 20, cornerRadius = 6, stroke = { stroke(1, provided("theme").line) },
                width = { this.rlbl.width + 16 },
                fill = { parent.hovered ? provided("theme").control : null },
                rlbl: Text [ x = 8, y = 3, fontSize = 11, fontWeight = semibold,
                    textColor = { parent.parent.hovered ? provided("theme").text : provided("theme").textMuted }, text = "Revert" ]
                ]
            ],

        // a line of breathing room below the label before the code starts

        hair:  View [ x = 18, y = 51, width = { parent.width - 30 }, height = 1, fill = { provided("theme").line } ],
        field: DocField [ x = 18, y = 60, width = { parent.width - 30 }, height = { parent.height - 68 },
            editName = { classroot.demo }, src = { classroot.esrc } ]
        ],

    // the compile report at the island (see RunIsland — same teaching surface)

    err: View [ width = 100%, fill = { provided("theme").errBg },
        visible = { classroot.broken },
        height = { this.msg.height + 20 },
        bar: View [ x = 0, y = 0, width = 3, height = 100%, fill = { provided("theme").errBar } ],
        msg: Text [ x = 18, y = 10, width = { parent.width - 36 }, wrap = true,
            fontFamily = { app.mono }, fontSize = { 12 * app.fontScale },
            textColor = { provided("theme").errText }, text = { app.liveReport } ]
        ],

    // the live preview island — the host mounts the compiled child app here. The slot
    // is live ONLY while the parent says so (`live`), so exactly one preview (the one
    // on the visible page) compiles at a time, even though every page is constructed.

    // The running app sits inset in the tinted box exactly as the code field
    // above it does — same 18 left, 12 right — so the demo reads as a card on
    // the page rather than paint running to the edge. The box carries the inset
    // in its own height, so the app keeps the height the extractor measured.

    stage: View [ width = 100%, height = { classroot.estage + 52 }, fill = { provided("theme").chipBg },

        card: View [ x = 18, y = 14, width = { parent.width - 30 }, height = { parent.height - 28 },
            cornerRadius = 8, fill = { provided("theme").surface },
            run: AppIsland [ x = 12, y = 12, width = { parent.width - 24 }, height = { parent.height - 24 },
                program = { classroot.live ? classroot.demo : "" },
                focusable = true,
                onPointerDown() { Focus.focus(this) }   // a press hands the running example the keyboard
                ]
            ],

        // a rule divides the code above from the running app below; the amber
        // spine, drawn over both, carries the code's left bar down the preview

        divider: View [ x = 0, y = 0, width = 100%, height = 2, fill = { provided("theme").rule } ],
        spine:   View [ x = 0, y = 0, width = 3, height = 100%, fill = { provided("theme").live } ]
        ]
    ]


/*
## Inline examples, woven through the prose

Every `declare` code fence in any prose that compiles (as-is, or wrapped in
`App […]`) becomes a `RunIsland`: the source above, its live preview below —
edit and it re-runs. The extractor wrote its source to
`apps/docs/demos/<id>.declare`, and the island runs it from there exactly
like the homepage's demos. `live` (threaded from the page) keeps the
preview's slot empty until its page is the one on screen, so only the visible
page's islands ever compile.
*/

class RunIsland [ width = 100%,
    rid:    string  = { :id },
    demo:   string  = { "demos/" + rid },       // the example's program, beside this one
    rsrc:   string  = { :source },
    rlines: number  = { :lines },
    rstage: number  = { :stageH || 200 },   // extractor-measured stage height — the frame fits the settled app
    live:   boolean = false,

    // this island's edit is the one that failed to compile — the host publishes the
    // report on app.liveReport (cleared by a clean compile), keyed by app.liveCard

    broken: boolean = { app.liveCard == demo && app.liveReport != "" },
    layout: SimpleLayout [ axis = y, spacing = 0 ],   // the preview frame abuts the code block, no gap

    // same code-box grammar as a static block (chipBg tint, 8px radius, 13px face),
    // marked live/editable by the amber bar + label (a read-only block is teal).

    // height: 15px per line at the 13px code face, plus the field's padding and
    // the 46+8 header/footer chrome — so the code fits without an inner
    // scrollbar up to the cap

    editor: View [ width = 100%, fill = { provided("theme").chipBg },
        height = { Math.min(classroot.rlines * 15 * app.fontScale + 93, 900) },
        bar:  View [ x = 0, y = 0, width = 3, height = 100%, fill = { classroot.broken ? provided("theme").errBar : provided("theme").live } ],
        tag:  View [ x = 18, y = 7, height = 17, cornerRadius = 3, fill = { provided("theme").live },
            lbl: Mono [ x = 7, y = 3, fontSize = 10, letterSpacing = 1, fontWeight = semibold, textColor = { provided("theme").liveInk },
                text = "LIVE · EDITABLE", wrap = false ],
            width = { this.lbl.width + 14 }
            ],

        // Revert restores the pristine source and republishes it — the way back the
        // guide owes a reader it just told to break something

        // (on touch the control is a finger's height around the same pill)

        rev: Control [ y = { app.touchDevice ? 1 : 5 }, height = { app.touchDevice ? 44 : 20 }, cornerRadius = 6,
            x = { parent.width - this.width - 10 },
            width = { this.pill.width },
            press() { classroot.editor.field.text = classroot.rsrc
                      app.liveCard = classroot.demo
                      app.liveSource = classroot.rsrc },
            pill: View [ y = center, height = 20, cornerRadius = 6, stroke = { stroke(1, provided("theme").line) },
                width = { this.rlbl.width + 16 },
                fill = { parent.hovered ? provided("theme").control : null },
                rlbl: Text [ x = 8, y = 3, fontSize = 11, fontWeight = semibold,
                    textColor = { parent.parent.hovered ? provided("theme").text : provided("theme").textMuted }, text = "Revert" ]
                ]
            ],

        // the hint is the first to go when the header narrows

        hint: Muted [ y = 9, fontSize = { 11 * app.fontScale }, italic = true, text = "runs live below ↓",
            visible = { parent.width >= 420 },
            x = { parent.rev.x - this.width - 12 } ],

        // a line of breathing room below the label before the code starts

        field: DocField [ x = 18, y = 46, width = { parent.width - 30 }, height = { parent.height - 54 },
            editName = { classroot.demo }, src = { classroot.rsrc } ]
        ],

    // the compile report, at the island — the diagnostic is a teaching surface, so a
    // broken edit shows its error right here (the last good render stays below it)

    err: View [ width = 100%, fill = { provided("theme").errBg },
        visible = { classroot.broken },
        height = { this.msg.height + 20 },
        bar: View [ x = 0, y = 0, width = 3, height = 100%, fill = { provided("theme").errBar } ],
        msg: Text [ x = 18, y = 10, width = { parent.width - 36 }, wrap = true,
            fontFamily = { app.mono }, fontSize = { 12 * app.fontScale },
            textColor = { provided("theme").errText }, text = { app.liveReport } ]
        ],

    // inset to match the code field above it, as the reference's Example is

    stage: View [ width = 100%, height = { classroot.rstage + 52 }, fill = { provided("theme").chipBg },
        card: View [ x = 18, y = 14, width = { parent.width - 30 }, height = { parent.height - 28 },
            cornerRadius = 8, fill = { provided("theme").surface },
            run: AppIsland [ x = 12, y = 12, width = { parent.width - 24 }, height = { parent.height - 24 },
                program = { classroot.live ? classroot.demo : "" },
                focusable = true,
                onPointerDown() { Focus.focus(this) }   // a press hands the running example the keyboard
                ]
            ],
        divider: View [ x = 0, y = 0, width = 100%, height = 2, fill = { provided("theme").rule } ],
        spine:   View [ x = 0, y = 0, width = 3, height = 100%, fill = { provided("theme").live } ]
        ]
    ]


// one prose segment — a run of Markdown text OR (0-or-1) a runnable island. A code
// block that didn't compile stays folded into the Markdown as a static code fence.
// `tone`/`lead` let a caller dim the prose (the reference runs dimmer than the guide).

class Block [ width = 100%,
    live: boolean = false,
    tone: Color   = { provided("theme").body },
    lead: number  = 1.6,
    layout: SimpleLayout [ axis = y, spacing = 14 ],

    // a guide section's address (`guide/14-data@talking-to-a-server`) — the
    // extractor anchors each segment that opens with a heading

    anchor = { "" + (:anchor ?? "") },
    md: Markdown [ width = 100%, lineHeight = { classroot.lead }, bodyColor = { classroot.tone }, fontScale = { app.fontScale },
        visible = { :md != "" }, text = { :md },
        onLink(href: string) { app.openDocLink(href) }
        ],

    // a chapter's title segment carries its sections, as the reference's pages
    // carry theirs: each a link to the section's anchor

    toc: OnThisPage [ visible = { (:toc ?? []).length > 0 },
        JumpLink [ datapath = :toc[], label = { "" + :title }, to = { "" + :anchor } ]
        ],
    RunIsland [ datapath = :code[], width = 100%, live = { classroot.live } ]
    ]


/*
## The class page

One class's whole detail page. A single instance exists — the use site
(refCol, below) computes the selected class's model node as its datapath, so
switching classes re-roots this subtree and constructs exactly the page being
read, and a boot never pays for the pages it is not showing.
*/

class ClassDetail [ width = 100%,
    cname: string = "",
    docPage: string = { "reference/" + classroot.cname },   // provided: the address of this page
    visible = { app.selected == classroot.cname },

    // this page is on screen — the gate every inline preview reads before it mounts

    pageLive: boolean = { app.mode == "reference" && app.selected == classroot.cname },
    hasBase:  boolean = { :extends != null },
    layout: SimpleLayout [ axis = y, spacing = 36 ],
    padding = [0, 0, 84, 0],

    // the ancestor projections as DECLARED data (the value-root idiom), so the
    // chain row and the strips can replicate over them

    ancestry:  Dataset [ contents = { { items: app.ancestryOf(classroot.cname) } } ],
    ancestors: Dataset [ contents = { { items: app.ancestorsOf(classroot.cname) } } ],

    /* ### Header — the class, where it sits, and its opener */

    header: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        eyebrow: View [ layout: SimpleLayout [ axis = x, spacing = 14, align = baseline ],
            // (the source's path is left to VIEW SOURCE where the line is too short for it)

            Eyebrow [ text = { "REFERENCE · " + (:origin == "library" ? "STANDARD LIBRARY" : "BUILT-IN") + (:source != null && app.docked ? " · " + :source : "") } ],

            // a library class is Declare like any program: its source opens in
            // the Viewer (`navigate` resolves the path against the distro root)

            Eyebrow [ visible = { :origin == "library" && :source != null }, text = "VIEW SOURCE →",
                textColor = { provided("theme").accent }, cursor = "pointer", link = { "" + :source + "?viewer" } ]
            ],
        Title [ fontSize = { 32 * app.fontScale }, text = { classroot.cname } ],

        // the chain, every ancestor a link — and the class's subclasses

        // (re-rooted to the ancestry data, so its visibility reads the page's fact, not a path)

        chain: View [ width = 100%, visible = { classroot.hasBase },
            datapath = { classroot.ancestry.value },
            layout: WrappingLayout [ spacing = 8, rowSpacing = 8, align = baseline ],
            Mono [ fontSize = { 14 * app.fontScale }, textColor = { provided("theme").sigDim }, text = { "class " + classroot.cname + " extends" } ],
            Link [ datapath = :items[] ]
            ],
        base: Mono [ fontSize = { 14 * app.fontScale }, textColor = { provided("theme").sigDim }, visible = { :extends == null },
            text = { "class " + classroot.cname + "  (base)" } ],
        subs: View [ width = 100%, visible = { :subclasses.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Muted [ fontSize = { 16 * app.fontScale }, text = "Subclasses:" ],
            Chip [ datapath = :subclasses[], kind = "class", cls = { "" + :@ }, label = { "" + :@ } ]
            ],

        // the page's sections, one line, before the narration: for the reader
        // who came for a fact

        Divider [ ],
        jump: OnThisPage [
            JumpLink [ label = "Usage",      visible = { :example.length > 0 },    count = { :example.length },    to = "usage" ],
            JumpLink [ label = "Attributes", visible = { :attributes.length > 0 }, count = { :attributes.length }, to = "attributes" ],
            JumpLink [ label = "Methods",    visible = { :methods.length > 0 },    count = { :methods.length },    to = "methods" ],
            JumpLink [ label = "Events",     visible = { :events.length > 0 },     count = { :events.length },     to = "events" ],
            JumpLink [ label = "Provided",   visible = { classroot.hasReads },     count = { :reads.theme.length + :reads.provided.length }, to = "provided" ],
            JumpLink [ label = "Inherited",  visible = { :chain.length > 1 },      count = { :chain.length - 1 }, to = "inherited" ]
            ],

        // the class prose — dimmed, with any inline runnable examples woven in

        Block [ datapath = :docSegs[], width = 100%,
            live = { classroot.pageLive }, tone = { provided("theme").refDim }, lead = 1.6 ]
        ],

    /* ### Usage — the class at work, live: each example runs, and its source is editable */

    usage: View [ width = 100%, visible = { :example.length > 0 }, anchor = "usage",
        layout: SimpleLayout [ axis = y, spacing = 28 ],
        SectionHead [ head = "Usage", note = "The class as you would write it. Every example runs below its source, and the source is yours to edit." ],
        Example [ datapath = :example[], width = 100%, live = { classroot.pageLive } ]
        ],

    /* ### The members, in three ruled sections — each headed by an index of its
           members; an override sits in its own section, with the ancestor's
           member linked under its signature */

    attrs: View [ width = 100%, visible = { :attributes.length > 0 }, anchor = "attributes",
        layout: SimpleLayout [ axis = y, spacing = 22 ],
        SectionHead [ head = "Attributes",
            note = { :attributes.length + " on " + classroot.cname + (app.hasOverrides(:attributes) ? " — its own first, then the inherited ones it gives a new default" : "") },
            MemberIndex [ visible = { :attributes.length > 1 },
                MemberChip [ datapath = :attributes[], kind = "attribute" ]
                ]
            ],
        AttrRow [ datapath = :attributes[], width = 100%, live = { classroot.pageLive } ]
        ],

    meths: View [ width = 100%, visible = { :methods.length > 0 }, anchor = "methods",
        layout: SimpleLayout [ axis = y, spacing = 22 ],
        SectionHead [ head = "Methods", note = { :methods.length + " on " + classroot.cname },
            MemberIndex [ visible = { :methods.length > 1 },
                MemberChip [ datapath = :methods[], kind = "method" ]
                ]
            ],
        MethodRow [ datapath = :methods[], width = 100%, live = { classroot.pageLive } ]
        ],

    evts: View [ width = 100%, visible = { :events.length > 0 }, anchor = "events",
        layout: SimpleLayout [ axis = y, spacing = 22 ],
        SectionHead [ head = "Events", note = { :events.length + " on " + classroot.cname },
            MemberIndex [ visible = { :events.length > 1 },
                MemberChip [ datapath = :events[], kind = "event" ]
                ]
            ],
        EventRow [ datapath = :events[], width = 100%, live = { classroot.pageLive } ]
        ],

    /* ### Provided — what the class READS from above: its contract with its container */

    hasReads: boolean = { :reads.theme.length + :reads.provided.length > 0 || app.ancestorsOf(classroot.cname).some((a) => a.n > 0) },
    reads: View [ width = 100%, visible = { classroot.hasReads }, anchor = "provided",
        layout: SimpleLayout [ axis = y, spacing = 18 ],
        SectionHead [ head = "Provided",
            note = { "The values " + classroot.cname + " reads from above — its dependencies on whatever contains it. Change one on any ancestor and it follows. Its own body's reads; an ancestor that reads values of its own is folded beneath." } ],
        tokens: View [ width = 100%, visible = { :reads.theme.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Chip [ datapath = :reads.theme[], kind = "token", label = { "theme." + :@ } ]
            ],
        provided: View [ width = 100%, visible = { :reads.provided.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Chip [ datapath = :reads.provided[], kind = "token", label = { "" + :@ } ]
            ],
        strips: View [ width = 100%, datapath = { classroot.ancestors.value },
            layout: SimpleLayout [ axis = y, spacing = 8 ],
            ReadStrip [ datapath = :items[] ]
            ]
        ],

    /* ### Inherited — per ancestor, names only, folded */

    inh: View [ width = 100%, visible = { :chain.length > 1 }, anchor = "inherited",
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        SectionHead [ head = "Inherited",
            note = { "Everything else " + classroot.cname + " can do, by the class it comes from. Names only — each is a link to its own entry; the ancestor's documentation stays on the ancestor's page." } ],
        strips: View [ width = 100%, datapath = { classroot.ancestors.value },
            layout: SimpleLayout [ axis = y, spacing = 14 ],
            Strip [ datapath = :items[] ]
            ]
        ]
    ]


/*
## The language pages

A third mode over the same model (its own locations, `language/<form>`, but no
tab of its own — the forms head the reference rail): every keyword, delimiter,
operator, and member shape the grammar accepts, from the registry
(tools/internal/doc/forms.md → model.forms). The rail lists them by group; the page is one form: its syntax in
a code box, its lead, live usage, the RULES the compiler enforces — each quoting the
checker's own sentence — and what it relates to. With no form selected the pane
shows the index: every form, grouped, one line each.
*/

// a form tab in the rail — the form's display name, lit when it is the location's cursor

class FormTab [ width = 100%, height = { app.touchDevice ? 44 : 28 }, cornerRadius = 6,
    slug: string = "",
    lit: boolean = { app.mode == "language" && app.form == classroot.slug },
    fill = { lit ? provided("theme").sel : hovered ? provided("theme").control : null },
    link = { "#language/" + slug },
    onClick()     { app.goForm(classroot.slug); app.navOpen = false },
    lbl: Mono [ x = 24, y = { 6 + (parent.height - 28) / 2 }, fontSize = 13, wrap = false, width = { parent.width - 36 }, maxLines = 1,
        text = { "" + (:short ?? :name) },
        textColor = { classroot.lit ? provided("theme").text : provided("theme").tabIdle } ]
    ]


class FormGroup [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    head: FoldHead [ label = { "" + :name },
        contains = { app.mode == "language" && (:forms as any[]).some(f => f.slug == app.form) } ],
    body: View [ width = 100%, visible = { classroot.head.open }, padding = [0, 0, 8, 0],
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        FormTab [ datapath = :forms[], slug = { "" + :slug } ]
        ]
    ]


// a syntax box: the form's grammar lines, as written, in the code tint

class SyntaxBox [ width = 100%, fill = { provided("theme").chipBg }, cornerRadius = 8,
    lines: string = "",
    height = { this.t.height + 28 },
    bar: View [ x = 0, y = 0, width = 3, height = 100%, fill = { provided("theme").accentSecondary } ],
    t: Mono [ x = 18, y = 14, width = { parent.width - 36 }, fontSize = { 14 * app.fontScale }, lineHeight = 1.6, textColor = { provided("theme").code },
        text = { classroot.lines } ]
    ]


// one rule: what it is, then the sentence the checker says at the site — quoted
// verbatim, and re-checked by the docs gate against the rule's own probe

class RuleRow [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 6 ],
    md: Markdown [ width = 100%, lineHeight = 1.55, bodyColor = { provided("theme").refDim }, fontScale = { app.fontScale },
        text = { "" + :rule } ],
    says: View [ width = 100%, height = { this.t.height + 16 },
        rule: View [ x = 0, y = 0, width = 2, height = 100%, fill = { provided("theme").line } ],
        lbl: Muted [ x = 14, y = { parent.t.y + parent.t.baseline - this.baseline },   // one baseline with the quote
            fontSize = { 12 * app.fontScale }, italic = true, wrap = false, text = "the checker says" ],
        t: Mono [ x = { parent.lbl.x + parent.lbl.width + 10 }, y = 8, width = { parent.width - parent.lbl.width - 24 },
            fontSize = { 12.5 * app.fontScale }, lineHeight = 1.5, textColor = { provided("theme").sigDim }, text = { "" + :says } ]
        ]
    ]


// a form link in an index row or a related row — a location write, like a class chip

class FormChip [ height = { 24 * app.fontScale }, cornerRadius = 6, cursor = "pointer",
    baseline: number = { this.lbl.y + this.lbl.baseline },
    slug: string = "",
    label: string = "",
    width = { this.lbl.width + 16 },
    fill = { hovered ? provided("theme").chipHov : provided("theme").chipBg },
    link = { "#language/" + slug },
    onClick() { app.goForm(slug) },
    lbl: Mono [ x = 8, y = { 5 * app.fontScale }, fontSize = { 13 * app.fontScale }, wrap = false,
        textColor = { provided("theme").accent }, text = { classroot.label } ]
    ]


// the index: one form per row — its name as a link, its gist beside it

class FormRow [ width = 100%,
    height = { Math.max(this.syn.height, this.gist.height) },
    cursor = "pointer",
    link = { "#language/" + :slug },
    onClick() { app.goForm("" + :slug) },
    syn: Mono [ x = 0, y = 0, width = 260, fontSize = { 14 * app.fontScale }, fontWeight = semibold, lineHeight = 1.5,
        textColor = { classroot.hovered ? provided("theme").accent : provided("theme").chipBlue }, text = { "" + :name } ],
    gist: Markdown [ x = 276, width = { parent.width - 276 }, lineHeight = 1.55, bodyColor = { provided("theme").refDim }, fontScale = { app.fontScale },
        text = { "" + :gist } ]
    ]


class FormIndex [ width = 100%,
    visible = { app.mode == "language" && app.form == "" },
    layout: SimpleLayout [ axis = y, spacing = 36 ],
    padding = [0, 0, 84, 0],
    header: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        Eyebrow [ text = "LANGUAGE · docs/declare.md" ],
        Title [ fontSize = { 32 * app.fontScale }, text = "The language" ],
        Block [ datapath = :docSegs[], width = 100%, tone = { provided("theme").refDim }, lead = 1.6 ]
        ],
    groups: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 36 ],
        View [ datapath = :groups[], width = 100%,
            layout: SimpleLayout [ axis = y, spacing = 18 ],
            SectionHead [ head = { "" + :name }, note = { :forms.length + (:forms.length == 1 ? " form" : " forms") } ],
            FormRow [ datapath = :forms[] ]
            ]
        ]
    ]


class FormDetail [ width = 100%,
    slug: string = "",
    docPage: string = { "language/" + classroot.slug },     // provided: the address of this page
    visible = { app.mode == "language" && app.form == classroot.slug },
    pageLive: boolean = { app.mode == "language" && app.form == classroot.slug },
    layout: SimpleLayout [ axis = y, spacing = 36 ],
    padding = [0, 0, 84, 0],
    nRelated: number = { :related.forms.length + :related.classes.length + :related.guide.length },

    header: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        Eyebrow [ width = 100%, wrap = true, text = { "LANGUAGE · " + ("" + :family).toUpperCase() + " · declare.md " + :spec } ],
        Mono [ fontSize = { 32 * app.fontScale }, fontWeight = semibold, textColor = { provided("theme").text }, text = { "" + :name } ],
        SyntaxBox [ lines = { "" + :syntaxText } ],   // the lines as written (a line may hold a comma)
        Block [ datapath = :docSegs[], width = 100%, live = { classroot.pageLive }, tone = { provided("theme").refDim }, lead = 1.6 ]
        ],

    jump: OnThisPage [
        JumpLink [ label = "Usage",   visible = { :example.length > 0 }, count = { :example.length }, to = "usage" ],
        JumpLink [ label = "Rules",   visible = { :rules.length > 0 },   count = { :rules.length },   to = "rules" ],
        JumpLink [ label = "Related", visible = { classroot.nRelated > 0 }, count = { classroot.nRelated }, to = "related" ]
        ],

    usage: View [ width = 100%, visible = { :example.length > 0 }, anchor = "usage",
        layout: SimpleLayout [ axis = y, spacing = 28 ],
        SectionHead [ head = "Usage", note = "The form as you would write it. Every example runs below its source, and the source is yours to edit." ],
        Example [ datapath = :example[], width = 100%, live = { classroot.pageLive } ]
        ],

    rules: View [ width = 100%, visible = { :rules.length > 0 }, anchor = "rules",
        layout: SimpleLayout [ axis = y, spacing = 22 ],
        SectionHead [ head = "Rules",
            note = "What the compiler enforces about this form. Each rule quotes the sentence the checker says at the site — the docs build re-runs every rule's probe, so the quote is always what the compiler says today." ],
        RuleRow [ datapath = :rules[] ]
        ],

    related: View [ width = 100%, visible = { classroot.nRelated > 0 }, anchor = "related",
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        SectionHead [ head = "Related", note = "Where this form leads: the forms it composes with, the classes it makes, and the guide chapters that teach it." ],
        forms: View [ width = 100%, visible = { :related.forms.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Muted [ fontSize = { 13 * app.fontScale }, text = "forms" ],
            FormChip [ datapath = :related.forms[], slug = { "" + :@ }, label = { app.formName("" + :@) } ]
            ],
        classes: View [ width = 100%, visible = { :related.classes.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Muted [ fontSize = { 13 * app.fontScale }, text = "classes" ],
            Chip [ datapath = :related.classes[], kind = "class", cls = { "" + :@ }, label = { "" + :@ } ]
            ],
        guide: View [ width = 100%, visible = { :related.guide.length > 0 },
            layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
            Muted [ fontSize = { 13 * app.fontScale }, text = "guide" ],
            View [ datapath = :related.guide[], height = { 24 * app.fontScale }, cornerRadius = 6, cursor = "pointer",
                baseline: number = { this.lbl.y + this.lbl.baseline },
                width = { this.lbl.width + 16 }, fill = { hovered ? provided("theme").chipHov : provided("theme").chipBg },
                link = { "#guide/" + :chapter },
                onClick() { app.goGuide("" + :chapter) },
                lbl: Mono [ x = 8, y = { 5 * app.fontScale }, fontSize = { 13 * app.fontScale }, wrap = false, textColor = { provided("theme").accent },
                    text = { :chapter + " · " + :title } ]
                ]
            ]
        ]
    ]


/*
## The type pages

A fourth mode over the same model (`type/<Name>`, no tab of its own — the types
sit between the forms and the classes in the reference rail): one page per named
vocabulary the language prints in a signature. Every enum (`spine.enums`) and
every shared type the scaffold declares into a `{ }` body (`spine.types.shared`)
has one, built by the assembler (tools/internal/doc/assemble.mjs → model.types)
in the same shape the language forms have — which is why the page below is
`FormDetail`'s twin rather than `ClassDetail`'s: a type is one definition, not a
class with an ancestry, members and a live example.

A page carries: what it is, its definition (an alias's type, an interface's
members) or its tokens (an enum's, grouped by family where the set has one), and
WHERE IT IS USED — every attribute whose type is this one, every event and method
whose signature names it, the types that name it, the functions that take or
return it. All of it derived from the model; nothing on the page is hand-listed.
*/

// a type tab in the rail — lit when it is the location's cursor

class TypeTab [ width = 100%, height = { app.touchDevice ? 44 : 28 }, cornerRadius = 6,
    tname: string = "",
    lit: boolean = { app.mode == "type" && app.tname == classroot.tname },
    fill = { lit ? provided("theme").sel : hovered ? provided("theme").control : null },
    link = { "#type/" + tname },
    onClick()     { app.goType(classroot.tname); app.navOpen = false },
    lbl: Mono [ x = 24, y = { 6 + (parent.height - 28) / 2 }, fontSize = 13, wrap = false, width = { parent.width - 36 }, maxLines = 1,
        text = { classroot.tname },
        textColor = { classroot.lit ? provided("theme").text : provided("theme").tabIdle } ]
    ]


class TypeGroup [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    head: FoldHead [ label = { "" + :name },
        contains = { app.mode == "type" && (:types as any[]).some(t => t.name == app.tname) } ],
    body: View [ width = 100%, visible = { classroot.head.open }, padding = [0, 0, 8, 0],
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        TypeTab [ datapath = :types[], tname = { "" + :name } ]
        ]
    ]


// one use of the type: what carries it, of what kind, and the signature or
// default that carries it. The chip is a link wherever the thing has a page.

class UseRow [ width = 100%,
    layout: WrappingLayout [ spacing = 10, rowSpacing = 6, align = baseline ],
    LocChip [ label = { "" + :label }, to = { "" + :loc } ],
    Muted [ fontSize = { 12 * app.fontScale }, wrap = false, text = { "" + :kind } ],
    Mono [ fontSize = { 13 * app.fontScale }, textColor = { provided("theme").sigDim },
        visible = { ("" + :detail) != "" }, text = { "" + :detail },
        width = { Math.min(Math.ceil(measureText(this.text, ({ fontSize: this.fontSize, fontFamily: app.mono })).width) + 2, app.docked ? 100000 : parent.width) } ]   // on a phone, wider than the row, it wraps
    ]


class TypeDetail [ width = 100%,
    tname: string = "",
    docPage: string = { "type/" + classroot.tname },        // provided: the address of this page
    visible = { app.mode == "type" && app.tname == classroot.tname },
    layout: SimpleLayout [ axis = y, spacing = 36 ],
    padding = [0, 0, 84, 0],

    header: View [ width = 100%,
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        Eyebrow [ text = { "TYPE · " + ("" + :kind).toUpperCase() + " · " + :group } ],
        Mono [ fontSize = { 32 * app.fontScale }, fontWeight = semibold, textColor = { provided("theme").text }, text = { "" + :name } ],
        SyntaxBox [ visible = { ("" + :syntaxText) != "" }, lines = { "" + :syntaxText } ],
        prose: Markdown [ width = 100%, lineHeight = 1.6, bodyColor = { provided("theme").refDim },
            fontScale = { app.fontScale }, text = { "" + :doc },
            onLink(href: string) { app.openDocLink(href) }
            ]
        ],

    jump: OnThisPage [
        JumpLink [ label = "Tokens",  visible = { :nTokens > 0 }, count = { :nTokens }, to = "tokens" ],
        JumpLink [ label = "Used by", visible = { :nUsed > 0 },   count = { :nUsed },   to = "used-by" ]
        ],

    // the vocabulary itself. A set built from directional suffixes comes grouped
    // by family (the easing curves); every other set is one flat run.

    tokens: View [ width = 100%, visible = { :nTokens > 0 }, anchor = "tokens",
        layout: SimpleLayout [ axis = y, spacing = 18 ],
        SectionHead [ head = "Tokens",
            note = { :nTokens + " of them. Write the token itself — bare, unquoted, in the attribute the type names." } ],
        fams: View [ width = 100%,
            layout: SimpleLayout [ axis = y, spacing = 12 ],
            View [ datapath = :tokenGroups[], width = 100%,
                layout: SimpleLayout [ axis = y, spacing = 6 ],
                Muted [ fontSize = { 13 * app.fontScale }, visible = { ("" + :name) != "" }, text = { "" + :name } ],
                row: View [ width = 100%,
                    layout: WrappingLayout [ spacing = 6, rowSpacing = 6, align = baseline ],
                    Chip [ datapath = :tokens[], kind = "token", label = { "" + :name } ]
                    ]
                ]
            ]
        ],

    uses: View [ width = 100%, visible = { :nUsed > 0 }, anchor = "used-by",
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        SectionHead [ head = "Used by",
            note = "Everywhere the language names this type: the attributes that hold one, the events and methods whose signatures carry one, the types that are built from it, and the functions that take or return it. Each is a link to where it is documented." ],
        UseRow [ datapath = :usedBy[], width = 100% ]
        ]
    ]


/*
## The guide

The mode switch, the chapter rail, and a chapter page. The doc app is two
tabs over one model: a narrative GUIDE and the REFERENCE (the language forms,
the types, then the classes). `app.mode` picks the page kind; each mode keeps
its own selection (`app.chapter` / `app.selected` / `app.form` / `app.tname`)
so switching back lands where you left. Both rails are folds: a group opens
when it holds the current page.

Nav chrome does not ride `app.fontScale`: the text-size switch is a reading-comfort
control for the content pane; the rail keeps its designed sizes.
*/

// one chapter link in the guide rail — lights when it is the current chapter

class ChapterTab [ width = 100%, height = { app.touchDevice ? 44 : 32 }, cornerRadius = 6,
    cid: string = { :id },
    cnum: number = { :num },
    ctitle: string = { :short },
    fill = { app.chapter == classroot.cid ? provided("theme").sel : hovered ? provided("theme").control : null },
    link = { "#guide/" + cid },
    onClick()     { app.goGuide(classroot.cid); app.navOpen = false },

    // numbered, because the chapters cite each other by number ("chapter 3")

    lbl: Text [ x = 24, y = { 8 + (parent.height - 32) / 2 }, fontSize = 14, wrap = false, width = { parent.width - 36 }, maxLines = 1,
        text = { classroot.cnum + ". " + classroot.ctitle },
        textColor = { app.chapter == classroot.cid ? provided("theme").text : provided("theme").tabIdle } ]
    ]


// one Part in the guide rail — an eyebrow over that part's chapter links

class PartGroup [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 2 ],
    head: FoldHead [ label = { "" + :part },
        contains = { app.mode == "guide" && (:chapters as any[]).some(c => c.id == app.chapter) } ],
    body: View [ width = 100%, visible = { classroot.head.open }, padding = [0, 0, 8, 0],
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        ChapterTab [ datapath = :chapters[] ]
        ]
    ]


// the chapter before or after this one, at the chapter's foot — a card naming it,
// a link like a rail tab

class ChapterLink extends Control [ flexes = true, cornerRadius = 10, cursor = "pointer",
    step: number = 1,                          // -1: the chapter before; 1: the one after
    ch: object? = null,                        // its guide entry, or null at either end
    cid: string = { this.ch != null ? "" + (this.ch as any).id : "" },
    visible = { this.cid != "" },
    link = { "#guide/" + this.cid },
    press() { app.goGuide(this.cid) },
    fill = { hovered ? provided("theme").chipBg : null },
    stroke = { stroke(1, hovered ? provided("theme").rule : provided("theme").line) },
    padding = [12, 16, 14, 16],
    layout: SimpleLayout [ axis = y, spacing = 6 ],
    Eyebrow [ width = 100%, textAlign = { classroot.step > 0 ? "right" : "left" }, text = { classroot.step > 0 ? "NEXT" : "PREVIOUS" } ],
    Text [ width = 100%, fontSize = { 15 * app.fontScale }, fontWeight = semibold, textColor = { provided("theme").accent },
        textAlign = { classroot.step > 0 ? "right" : "left" },
        text = { classroot.ch == null ? "" : classroot.step > 0 ? (classroot.ch as any).num + ". " + (classroot.ch as any).title + " →"
            : "← " + (classroot.ch as any).num + ". " + (classroot.ch as any).title } ]
    ]


// one chapter page — the chapter as ordered segments (prose + inline runnable islands),
// then its optional flagship demo. Every ```declare block that compiles is a live island.

class ChapterDetail [ width = 100%,
    cid: string = { :id },
    docPage: string = { "guide/" + classroot.cid },         // provided: the address of this page
    visible = { app.mode == "guide" && app.chapter == classroot.cid },
    pageLive: boolean = { app.mode == "guide" && app.chapter == classroot.cid },
    layout: SimpleLayout [ axis = y, spacing = 20 ],
    padding = [0, 0, 80, 0],

    // The chapter's content is its own file (chapters/<id>.json), fetched when
    // the page is first shown, not at construction — an eager prefetch would
    // make every boot pay the whole corpus. `wanted` is a latch: the page being
    // on screen asks for the file, and `loaded` holds the url steady afterward,
    // so a chapter stays resident once landed and is instant on return. A boot
    // costs the model plus exactly one chapter.

    wanted: boolean = { classroot.pageLive || classroot.src.loaded },
    src: DataSource [ auto = true,
        url = { classroot.wanted ? app.base + "chapters/" + classroot.cid + ".json" : "" } ],

    loading: Text [ visible = { classroot.src.loading }, fontSize = { 14 * app.fontScale }, textColor = { provided("theme").textMuted }, text = "Loading the chapter…" ],
    failed:  Text [ visible = { classroot.src.failed }, fontSize = { 14 * app.fontScale }, textColor = { provided("theme").textMuted }, wrap = true, width = 100%,
        text = { "The chapter did not load — " + (classroot.src.error || "") } ],

    // the guide is the primary reading surface: Block's default, brighter body tone

    content: View [ width = 100%, visible = { classroot.src.loaded }, datapath = { classroot.src.value },
        layout: SimpleLayout [ axis = y, spacing = 20 ],

        Block [ datapath = :segs[], width = 100%, live = { classroot.pageLive } ],

        // a flagship runnable example the chapter opts into with `<!-- demo: <Class> -->`

        demoBox: View [ width = 100%, visible = { :demo.length > 0 },
            Example [ datapath = :demo[], width = 100%, live = { classroot.pageLive } ]
            ],

        // the way on, and back: the chapters either side of this one

        foot: View [ width = 100%, padding = [20, 0, 0, 0],
            layout: SimpleLayout [ axis = y, spacing = 24 ],
            Divider [ ],
            links: View [ width = 100%,
                layout: SimpleLayout [ axis = x, spacing = 12 ],
                ChapterLink [ step = -1, ch = { app.guideStep(classroot.cid, -1) } ],
                ChapterLink [ step = 1, ch = { app.guideStep(classroot.cid, 1) } ]
                ]
            ]
        ]
    ]


/*
## The nav column

The Guide/Reference switch, then the nav for the live mode. One class in two
places: fixed in the rail beside the page on a wide screen, and inside the
drawer on a narrow one. What it shows is the App's — the mode, the location —
so either instance shows the same place.
*/

class NavColumn [ width = 100%,
    layout: SimpleLayout [ axis = y, spacing = 4 ],

    // Guide / Reference — a full-width segmented pair, each tab half the
    // rail, at the rail's own fixed type size. The pair's value is
    // `app.mode`, deriving from `app.location`, so a pick writes the
    // location and the value comes back round — the single source of
    // truth the App's location comment asks for.

    // Two tabs, four modes: the language and type pages have their own
    // locations (`language/<form>`, `type/<Name>`) but live in the
    // reference rail, so the Reference tab lights for them too.

    modes: TabBar [ width = 100%, height = { app.touchDevice ? 44 : 30 },
        value = { app.mode == "guide" ? "guide" : "reference" },
        input(v: object) { if (("" + v) == "guide") app.goGuide(app.guideAt); else app.goRef(app.refAt) },

        // each half declares where it goes, so the switch is a link the
        // crawler can follow — without it the reference half of the docs
        // is unreachable from the default location (see SegmentedItem)

        choices = { [ ({ id: "guide",     label: "Guide",     location: "guide/" + app.guideAt }),
                      ({ id: "reference", label: "Reference", location: "reference/" + app.refAt }) ] }
        ],

    // guide nav — the parts, each a fold over its chapters

    guideNav: View [ width = 100%, visible = { app.mode == "guide" }, padding = [12, 0, 0, 0],
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        PartGroup [ datapath = :guideParts[] ]
        ],

    // reference nav — the language (the forms, by group, with the index
    // above them), then the TYPES (the vocabulary a signature prints:
    // model.types.groups), then the classes (by topic:
    // model.classGroups). Each group folds. Types sit on the language
    // side because that is what they are — the words the grammar and
    // every signature are written in, not classes you instantiate —
    // and they keep their own eyebrow so a page with tokens and members
    // is never mistaken for a form with syntax and rules.

    // its padding is the rail's own margin: 16 above the first eyebrow, as
    // the column starts, and 26 under the last class group

    refNav: View [ width = 100%, visible = { app.mode == "reference" || app.mode == "language" || app.mode == "type" },
        exists = { app.refSeen || app.langSeen || app.typeSeen },     // built when that half is first shown
        padding = [16, 0, 26, 0],
        layout: SimpleLayout [ axis = y, spacing = 2 ],
        langEyebrow: Mono [ fontSize = 12, letterSpacing = 1.4, fontWeight = semibold, textColor = { provided("theme").textMuted }, text = "LANGUAGE" ],
        g2:    View [ height = 4 ],
        idx: View [ width = 100%, height = { app.touchDevice ? 44 : 28 }, cornerRadius = 6,
            lit: boolean = { app.mode == "language" && app.form == "" },
            fill = { lit ? provided("theme").sel : hovered ? provided("theme").control : null },
            link = "#language/",
            onClick() { app.goForm(""); app.navOpen = false },
            Text [ x = 24, y = { 6 + (parent.height - 28) / 2 }, fontSize = 14, wrap = false, width = { parent.width - 36 }, maxLines = 1, text = "All forms", textColor = { parent.lit ? provided("theme").text : provided("theme").tabIdle } ]
            ],
        FormGroup [ datapath = :forms.groups[] ],
        g3:    View [ height = 18 ],
        typeEyebrow: Mono [ fontSize = 12, letterSpacing = 1.4, fontWeight = semibold, textColor = { provided("theme").textMuted }, text = "TYPES" ],
        g3b:   View [ height = 4 ],
        TypeGroup [ datapath = :types.groups[] ],
        g3c:   View [ height = 18 ],
        classEyebrow: Mono [ fontSize = 12, letterSpacing = 1.4, fontWeight = semibold, textColor = { provided("theme").textMuted }, text = "CLASSES" ],
        g4:    View [ height = 4 ],
        ClassGroup [ datapath = :classGroups[] ]
        ]
    ]


/*
## Search results

One hit on the search page: title (the chapter or the member's full name), a
kind crumb, then the matched text in context with the terms bolded — the
snippet arrives pre-built from `findDocs` (the match window is computed once
per query there, not per row render). Click navigates: a result is a location
write, so it deep-links and back-buttons like any rail tab.

Every row is a focus stop — ↓ from the search field moves focus into the
list, ↓/↑ walk rows, ↑ off the top hands focus back to the field, Return opens
the focused row, Escape clears the search. `app.searchSel` mirrors the focused
index (onFocus writes it) so the selection highlight and the field's ↓ have
one fact to read.
*/

class SearchHit [ width = 100%, cornerRadius = 8,
    loc: string = { :loc },
    idx: number = { rowIndex },
    focusable = true,
    fill = { app.searchSel == idx ? provided("theme").sel : hovered ? provided("theme").control : null },
    onClick() { app.openResult(classroot.loc) },
    onFocus() { app.searchSel = idx },
    onKeyDown(e: KeyEvent) {
        if (e.key == "ArrowDown") app.focusHit(classroot.idx + 1)
        else if (e.key == "ArrowUp") {
            if (classroot.idx == 0) { app.searchSel = -1; Focus.focus(app.bar.search as any) }
            else app.focusHit(classroot.idx - 1)
            }
        else if (e.key == "Enter") app.openResult(classroot.loc)
        else if (e.key == "Escape") app.dismissSearch()
        },

    // the row's own content box, trailing space included — so the row
    // auto-sizes to exactly its text plus the inset around it

    padding = [9, 12, 9, 12],
    layout: SimpleLayout [ axis = y, spacing = 3 ],
    row: View [ width = 100%, height = 18,
        layout: SimpleLayout [ axis = x, spacing = 10 ],
        Title [ fontSize = 14, wrap = false, maxLines = 1, text = { :title },
            width = { Math.min(Math.ceil(measureText(this.text, providedTextStyle({ fontSize: 14, fontWeight: 600 })).width), parent.width - parent.crumb.width - 10) } ],
        crumb: Mono [ y = 3, fontSize = 10, letterSpacing = 0.6, textColor = { provided("theme").eyebrow }, wrap = false, text = { :crumb } ]
        ],
    snip: Markdown [ width = 100%, fontScale = 0.92, lineHeight = 1.45,
        bodyColor = { provided("theme").refDim },
        visible = { :snip != "" }, text = { :snip } ]
    ]


/*
## The bar's icon buttons

On a narrow window the bar trades words for marks: the contents (the drawer)
and the search, each a square control the size of the theme switch beside
them — a finger's size on touch.
*/

class MenuIcon extends Icon [
    accessibilityLabel = "Contents",
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.beginPath()
        d.moveTo(2.5, 4.5); d.lineTo(13.5, 4.5)
        d.moveTo(2.5, 8); d.lineTo(13.5, 8)
        d.moveTo(2.5, 11.5); d.lineTo(13.5, 11.5)
        d.stroke()
        }
    ]


class SearchIcon extends Icon [
    accessibilityLabel = "Search",
    draw(d: Draw) {
        d.scale(unit, unit)
        d.strokeStyle = ink
        d.lineWidth = weight / unit
        d.lineCap = "round"
        d.beginPath()
        d.arc(7, 7, 4.5, 0, Math.PI * 2)
        d.moveTo(10.4, 10.4); d.lineTo(13.5, 13.5)
        d.stroke()
        }
    ]


class BarButton extends Control [
    width = { app.touchDevice ? 44 : 32 },
    height = { this.width },
    cornerRadius = { Math.min(provided("theme").controlCornerRadius, height / 2) },
    fill = { pressed ? provided("theme").controlPressed : hovered ? provided("theme").controlHovered : null },
    ink: Color = { hovered ? provided("theme").text : provided("theme").textMuted }
    ]


/*
## The app

A top chrome bar (the house header — brand · search · type-size + theme), a
left rail below it, and a scrolling detail pane, over the model. Below
`docked` the rail leaves: the page takes the window, the bar's menu button
opens the same nav as a drawer from the start edge, and the search pill
becomes a button that opens the field across the bar.
*/

App [ fill = { provided("theme").background }, appName = "Declare Docs",
    revealInset = { app.barH },                // an anchor lands clear of the fixed bar

    // the two faces, named once: the UI face is provided from here, so every
    // run below — the rail, the chrome, the prose — reads it unless it names
    // the monospace face the reference and the code blocks use

    fontFamily = ["system-ui", "sans-serif"],
    mono: Font [ family = "ui-monospace, SFMono-Regular, monospace" ],

    /* Navigation is one string — `location`, the URL fragment. The grammar is
       this app's own: `<mode>/<cursor>[@heading]` (`guide/04-structure`,
       `reference/Slider`, `guide/04-structure@where-things-go`). The declared initial is the
       default, so a fresh `docs.declare` shows the first guide chapter with a clean
       URL. The mode and every cursor derive from it and are never assigned — every
       tab and link writes `location`, back/forward writes it back, state follows
       (the single-writer rule; assigning derived state would disconnect history). */

    location = "guide/01-what-declare-is",

    /* Cross-mode memory (not a language feature — four plain remembered cursors).
       `location` only carries the active mode's cursor, so switching modes would
       forget the others. The navigation verbs keep these in step and the mode
       switch consults them, so returning to a mode lands where you left it. */

    guideAt: string = "01-what-declare-is",              // last guide chapter visited …
    refAt:   string = "View",                  // … and last reference class
    formAt:  string = "",                      // … and last language form ("" = the index)
    typeAt:  string = "Color",                 // … and last type page

    // The four navigation verbs every tab, chip and link calls: remember the
    // cursor for its mode, write the location, start the new page at its top.
    // A view that calls one also declares the same reference as its `link`,
    // so the crawler sees the edge and ⌘-click works; the handler runs first,
    // then the follow.

    goGuide(id: string)  { app.guideAt = id;   app.location = "guide/" + id;     app.showPage() },
    goRef(name: string)  { app.refAt = name;   app.location = "reference/" + name; app.showPage() },
    goForm(slug: string) { app.formAt = slug;  app.location = "language/" + slug; app.showPage() },
    goType(name: string) { app.typeAt = name;  app.location = "type/" + name;     app.showPage() },

    // …and the one verb a generated link calls, since a link's target names its
    // own mode: the model hands out locations ("type/Color", "reference/View"),
    // never a verb to guess at.

    goLoc(loc: string) {
        const mode = loc.split("/")[0], cursor = loc.split("/")[1]
        if (mode == "type") app.goType(cursor)
        else if (mode == "language") app.goForm(cursor)
        else if (mode == "guide") app.goGuide(cursor)
        else app.goRef(cursor)
        },

    // The active view, parsed out of `location` (the anchor stripped first — it
    // selects a viewpoint, not a page). The inactive mode's cursor falls back to its
    // remembered value, so its rail/selection stay put behind the other mode.

    page:     string = { app.location.split("@")[0] },                 // the location less its anchor — the fold heads' key
    mode:     string = { app.page.split("/")[0] || "guide" },
    chapter:  string = { app.mode == "guide" ? (app.page.split("/")[1] || "01-what-declare-is") : app.guideAt },
    selected: string = { app.mode == "reference" ? (app.page.split("/")[1] || "View") : app.refAt },
    form:     string = { app.mode == "language" ? (app.page.split("/")[1] || "") : app.formAt },
    tname:    string = { app.mode == "type" ? (app.page.split("/")[1] || app.typeAt) : app.typeAt },

    // Each mode's pane is built the first time that mode is shown, and kept
    // after, so a return to it is instant: a boot on a guide chapter builds the
    // guide and none of the reference. Each flag starts as "showing now" and is
    // set for good the first time it is (the assignment replaces the formula).

    refSeen:  boolean = { app.mode == "reference" },
    langSeen: boolean = { app.mode == "language" },
    typeSeen: boolean = { app.mode == "type" },
    trackChanges = ["mode"],
    onChange(e: ChangeEvent) {
        if (app.mode == "reference") app.refSeen = true
        if (app.mode == "language") app.langSeen = true
        if (app.mode == "type") app.typeSeen = true
        },

    // the guide chapter `d` places from `id` (-1 the one before), or null past either end

    guideStep(id: string, d: number) -> object? {
        const g = (app.docs.read(["guide"]) || []) as any[]
        const i = g.findIndex((c) => c.id == id)
        return i < 0 ? null : g[i + d] ?? null
        },

    // a form's display name, for a related-forms chip

    formName(slug: string) -> string {
        const pages = (app.docs.read(["forms", "pages"]) || {}) as any
        return pages[slug] != null ? "" + pages[slug].name : slug
        },

    /* ## Typed signatures
       The model's link index: a printed type name → the location that
       documents it (a type page, or a class page for a class type), plus
       the token-list spelling a named enum prints as. One lookup answers for
       every signature the reference renders, and a name the index does not
       carry answers "", so an unlinkable type renders as plain text, never as
       a dead link. */

    tindex: object = { app.docs.read(["types", "index"]) || ({}) },

    typeLoc(s: string) -> string {
        const idx = app.tindex as any
        const u = idx.unions != null ? idx.unions["" + s] : null
        if (u != null) return "" + u
        const n = idx.link != null ? idx.link["" + s] : null
        return n != null ? "" + n : ""
        },

    // a whole signature, split into runs: each identifier that names a page
    // carries its location, everything between them carries "". A signature
    // that resolves whole (an attribute's type, or an enum's token list) stays
    // one run, linked as a whole.

    typeParts(s: string) -> array {
        const text = "" + s
        const whole = app.typeLoc(text)
        if (whole != "") return [({ t: text, to: whole })]
        const out = []
        for (const p of text.split(/([A-Za-z_$][A-Za-z0-9_$]*)/)) {
            if (p == "") continue
            out.push({ t: p, to: /^[A-Za-z_$]/.test(p) ? app.typeLoc(p) : "" })
        }
        return out
        },

    fontScale: number = 1.0,                   // reader font-size zoom for the CONTENT pane (the text-size switch drives it; nav is fixed)
    themeMode: string = "auto",                // "light" | "auto" | "dark" — the ☀◐☾ switch; auto follows app.dark
    barH: number = 52,                         // the house chrome bar (Viewer/Calendar/Tracker share the height)
    compact: boolean = { app.width < 780 },    // narrow bar: the type-size stepper stands down so the pill keeps its room

    // Narrower than a rail and a readable column, the rail leaves the layout:
    // the page takes the whole width, and the nav is a drawer (`navOpen`).

    docked: boolean = { app.width >= 720 },
    navOpen: boolean = false,

    /* ## Search
       The header pill searches the whole corpus — guide and reference — over
       `search-index.json`, a flat plain-text index (one entry per chapter and
       per documented member). The index is fetched on the first keystroke,
       never at boot, and `loaded` latches the url so it stays resident.
       `searchHits` derives from the query — typing is searching — and the
       results page replaces the reading column while the query is non-empty.
       A result click is a location write. */

    searchQ: string = "",
    searchSel: number = -1,                    // the focused result row (-1 = the field itself holds focus)
    searchOpen: boolean = false,               // undocked, the field is open across the bar
    searchIdx: DataSource [ auto = true,
        url = { app.searchQ != "" || this.loaded ? app.base + "search-index.json" : "" } ],
    searchHits: array = { app.findDocs(app.searchQ, app.searchIdx.value) },
    hits: Dataset [ contents = { { items: app.searchHits } } ],   // the same list as declared data — the results page's cursor root (the navSource idiom)

    /* ## The class page's projections
       The model stays normalized — inherited members are never copied into
       each class — so the page computes its ancestor views here, from the
       tree, per selection: the ancestry as links, each ancestor's strip
       (names, types, signatures, its one-line lead, its own reads), and a
       label's words for the wrapping chip. */

    classNode(name: string) -> object { return (app.docs.read(["tree"]) || []).find((c) => c.name == name) || null },

    ancestryOf(name: string) -> array {
        const me = app.classNode(name) as any
        return me == null ? [] : me.chain.slice(1).map((n, i) => ({ name: n, arrow: i > 0 }))
        },

    ancestorsOf(name: string) -> array {
        const me = app.classNode(name) as any
        if (me == null) return []
        return me.chain.slice(1).map((id) => app.classNode(id) as any).filter((c) => c != null).map((c) => ({
            name: c.name, lead: app.plainLead(c.doc || ""),
            reads: c.reads || ({ theme: [], provided: [] }),
            n: c.reads ? c.reads.theme.length + c.reads.provided.length : 0,
            attributes: c.attributes.map((a) => ({ name: a.name, label: a.name + ": " + a.type })),
            methods: c.methods.map((m) => ({ name: m.name, label: m.signature })),
            events: c.events.map((e) => ({ name: e.name, label: e.signature })) }))
        },

    // the first paragraph of a class's prose, as plain text — a strip's one-line lead

    plainLead(md: string) -> string {
        return md.split("\n\n")[0].replace(/\n/g, " ").replace(/\*\*/g, "").replace(/\u0060/g, "").replace(/\*/g, "").replace(/\s*\(docs\/system-design[^)]*\)/g, "").trim()
        },

    hasOverrides(list: array) -> boolean { return (list || []).some((a) => a.overrides != null) },

    // a label's words, each keeping its trailing space, so a run of word chips reads continuously

    wordsOf(label: string) -> array {
        const ws = ("" + label).match(/\S+\s*/g) || [label]
        return ws.map((w) => ({ w: w }))
        },

    // Match + rank + snippet, in one pass per query. Terms AND — every term
    // must appear in title or text. Rank: title prefix > title > body count.
    // The snippet is a word-trimmed window around the first body match, terms
    // bolded for the Markdown row (the snippet text is escaped first, so
    // corpus punctuation cannot leak markup into a result).

    findDocs(q: string, idx: object) -> array {
        const query = ("" + q).trim().toLowerCase()
        const entries = idx != null ? (idx as any).entries : null
        if (query == "" || entries == null) return []
        const terms = query.split(/\s+/).filter(Boolean)
        const out = []
        for (const e of entries) {
            const tl = e.title.toLowerCase(), xl = e.text.toLowerCase()
            let score = 0, first = -1, ok = true
            for (const t of terms) {
                const ti = tl.indexOf(t), xi = xl.indexOf(t)
                if (ti < 0 && xi < 0) { ok = false; break }
                if (ti >= 0) score += ti == 0 ? 120 : 50
                if (xi >= 0) { score += 10; if (first < 0 || xi < first) first = xi }
            }
            if (!ok) continue
            let snip = ""
            if (first >= 0) {
                let a = Math.max(0, first - 70), b = Math.min(e.text.length, first + 130)
                while (a > 0 && e.text[a - 1] != " ") a--          // trim to word edges
                while (b < e.text.length && e.text[b] != " ") b++
                snip = (a > 0 ? "…" : "") + e.text.slice(a, b) + (b < e.text.length ? "…" : "")
                snip = snip.replace(/([\\\u0060*_[\]<>#|])/g, "\\$1")   // escape before bolding (\u0060 = backtick, an escape so the { } scanner never sees one raw)
                for (const t of terms) {
                    const safe = t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
                    snip = snip.replace(new RegExp(safe, "ig"), (m) => "**" + m + "**")
                }
            }
            out.push({ loc: e.loc, title: e.title, crumb: e.crumb, snip: snip, score: score })
        }
        out.sort((a, b) => b.score - a.score)
        return out.slice(0, 40)
        },

    // A result opens like a rail tab: location write + cursor memory + scroll
    // to top, then the search clears. The field is uncontrolled, so clearing
    // `searchQ` alone would leave the typed text; dismissSearch resets it too.

    openResult(loc: string) {
        const mode = loc.split("/")[0], cursor = loc.split("/")[1]
        if (mode == "guide") app.goGuide(cursor); else app.goRef(cursor)
        app.dismissSearch()
        },

    dismissSearch() { app.searchQ = ""; app.searchSel = -1; app.searchOpen = false; app.bar.search.text = "" },

    // The field is in the bar once it is open, so focus goes to it a turn later:
    // a finger's tap ends with the browser focusing what was pressed, after the
    // press itself has run.

    openSearch() { app.searchOpen = true; afterDelay(0, () => Focus.focus(app.bar.search as any)) },

    // Focus result row `i` — the keyboard walk's one move. The rows are the
    // replicated children of the results column, each carrying its `idx`;
    // focusing one fires its onFocus (which records the selection) and the
    // reveal keeps the walked-to row on screen.

    focusHit(i: number) {
        for (const row of app.detail.searchCol.children) {
            if ((row as any).idx === i) { Focus.focus(row as any); (row as any).scrollIntoView("nearest"); return }
        }
        },

    // ⌘K reaches the search pill from anywhere; Escape unwinds an open search.

    keys: Keys [
        onKeyDown(e: KeyEvent) {
            if ((e.meta || e.ctrl) && e.code == "KeyK") app.openSearch()
            else if (e.key == "Escape" && (app.searchQ != "" || app.searchOpen)) app.dismissSearch()
            }
        ],

    // the one resolved fact every color decision reads — the theme record and
    // the Markdown rich-element palette must agree, or an override leaves
    // headings in the OS scheme while the chrome switches

    darkUI: boolean = { themeMode == "dark" || (themeMode == "auto" && app.dark) },

    // the rail is fixed-width chrome, sized snug around the short chapter titles

    railW: number = 236,
    liveCard: string = "",                     // the demo an inline editor is republishing (name) …
    liveSource: string = "",                   // … and its current source — the host recompiles this pair live

    // (app.liveReport — built-in — carries the host's rendered compile report; islands display it)

    /* The whole palette in one provided record, switched by the theme mode
       (`darkUI`, which follows the OS scheme under "auto") — every color
       below reads `theme.<token>`, so the docs render dark or light and
       follow the system theme as it flips. */

    // The house preset extended, not replaced: the standard tokens underneath,
    // this app's own values over them, and its many domain names (chipBg, rail,
    // live, errBar …) alongside. A standard control dropped in here finds every
    // token it consults; the docs palette is untouched. `live`/`liveInk` are
    // the editable-example amber and its letters, the same in both modes.

    theme = { { ...(darkUI ? SanFranciscoDark : SanFrancisco), ...app.docsTokens(darkUI) } },

    docsTokens(dark: boolean) -> object { return dark
        ? ({ bg: 0x0B141B, rail: 0x0D1922, surface: 0x0C1620, chipBg: 0x14232E, control: 0x152633, sel: 0x1C2D39, mchipBg: 0x172436, echipBg: 0x241F12, chipHov: 0x1C3243, line: 0x1E313C, rule: 0x345B84, edge: 0x1B2C39, accent: 0x4C8DFF, accentSecondary: 0x37E0C8, chipTeal: 0x9FD9CE, chipBlue: 0xA9C7FF, chipAmber: 0xE7C98A, text: 0xE7EEF2, body: 0xC4CFD8, code: 0xC7D3DC, strong: 0xB7C6D2, mtail: 0x9FB3C2, tabIdle: 0x9BB0BE, refDim: 0x98A7B1, textMuted: 0x8A9BA6, sigDim: 0x6E8494, eyebrow: 0x55707F, live: 0xE6B450, liveInk: 0x1A1A1A, errBg: 0x2A1518, errBar: 0xE0525E, errText: 0xF2A0A6 })
        : ({ bg: 0xF6F8FA, rail: 0xECF0F4, surface: 0xFFFFFF, chipBg: 0xE9EFF4, control: 0xE4EBF1, sel: 0xDBE5EE, mchipBg: 0xE7EDF6, echipBg: 0xF5EFE0, chipHov: 0xD9E4ED, line: 0xDCE3E9, rule: 0xB6C8DA, edge: 0xE0E6EC, accent: 0x2064DB, accentSecondary: 0x12A594, chipTeal: 0x15806E, chipBlue: 0x3355C2, chipAmber: 0x8F6F28, text: 0x172530, body: 0x2E3B46, code: 0x2B3843, strong: 0x3A4A56, mtail: 0x4F5F6B, tabIdle: 0x55636F, refDim: 0x51606C, textMuted: 0x5A6670, sigDim: 0x84929D, eyebrow: 0x93A0AA, live: 0xE6B450, liveInk: 0x1A1A1A, errBg: 0xFBE9EA, errBar: 0xC93B47, errText: 0x8E2830 }) },

    /* Code-vs-prose coherence, matching the source-viewer reader: prose (and
       every non-code block) wraps to a reading measure while code fills the
       column — so code renders wider than prose — and every code block gets a
       tinted box with a teal left bar. All provided, so every
       Markdown/HTMLText below inherits it. */

    richTextLayout = { { default: { maxWidth: 560 * app.fontScale }, code: { maxWidth: 0 } } },
    codeBackground = { provided("theme").chipBg },
    codeRule = { provided("theme").accentSecondary },

    // Hosted in another program (the desktop's window), this app's relative
    // data resolves in the host's space, and the host provides where this app
    // lives as `base`; standalone it is "" and the paths are this folder's.

    base: string = { hostProvided("base", "") },
    docs: DataSource [ url = { app.base + "../../docs/declare-model.json" } ],
    datapath = { docs.value },                 // root every :path below into the model
    onInit() { this.docs.fetch() },            // DataSource is explicit-fetch — kick it once, on construction

    // A page switch starts at the top of the new page — the detail pane keeps its
    // scroll offset otherwise. The reveal target is a zero-size anchor at the pane's
    // very top, not the column: the column sits 40px into the pane, so aligning its
    // top with the viewport would eat that margin. Every switch path routes through
    // here: rail tabs and prose links alike.

    showPage() { this.detail.top.scrollIntoView() },

    // The `declare-docs:` link scheme. An in-app id (guide, reference, language,
    // type) is a location write — it navigates exactly like a rail tab, so it
    // deep-links, shares, and back-buttons, and keeps the remembered cursor in
    // step. Every other id, and any ordinary href, leaves through `navigate`.

    openDocLink(href: string) {
        if (!href.startsWith("declare-docs:")) { app.navigate(href); return }
        const id = href.slice("declare-docs:".length)
        if (id.startsWith("guide:")) {                       // guide:tree → the chapter whose id ends with the slug
            const [slug, section] = id.slice("guide:".length).split("@")
            const hit = (app.docs.read(["guide"]) || []).find(c => c.id.replace(/^\d+-/, "") == slug)
            if (hit == null) return
            if (section == null) { app.goGuide(hit.id); return }
            app.guideAt = hit.id                             // guide:data@talking-to-a-server → that section
            app.follow("#guide/" + hit.id + "@" + section)
            return
        }
        if (id == "reference:index") { app.goRef(app.refAt); return }
        if (id.startsWith("language:")) { app.goForm(id.slice("language:".length)); return }   // language:class → the form's page ("language:" alone → the index)
        if (id.startsWith("type:")) { app.goType(id.slice("type:".length)); return }           // type:Motion → the type's page
        if (!id.includes(":")) {                                                            // a reference symbol: View / View.width / View.method.draw
            const parts = id.split(".")
            if (parts.length == 1) { app.goRef(parts[0]); return }
            app.refAt = parts[0]
            app.follow("#reference/" + parts[0] + "@" + parts[parts.length - 1])
            return
        }
        if (id.startsWith("operational:")) { app.navigate("docs/operational/" + id.slice("operational:".length) + ".md"); return }
        if (id == "spec:core") { app.navigate("docs/declare.md"); return }
        if (id == "essay:why-declare") { app.navigate("apps/homepage/homepage.declare") }
        },

    /* ## The chrome bar
       The house header — Viewer's and Tracker's bar, on this app: brand at 18
       (gradient "Declare", solid "Docs"), the search pill centered, and the
       type-size stepper + theme switch on the right. Undocked, a menu button
       leads, and the pill is a search button until it is pressed. */

    bar: View [ ignoreScroll = true, x = 0, y = 0, width = { app.width }, height = { app.barH }, fill = { provided("theme").rail },
        hair: View [ x = 0, y = { app.barH - 1 }, width = 100%, height = 1, fill = { provided("theme").edge } ],

        // the drawer's opener, where the rail would be

        menu: BarButton [ x = 8, y = center, visible = { !app.docked && !app.searchOpen },
            accessibilityLabel = "Contents", accessibilityExpanded = { app.navOpen },
            press() { app.navOpen = true },
            MenuIcon [ x = center, y = center, iconSize = 18, ink = { parent.ink } ]
            ],

        brand: View [ y = center, height = 22, visible = { app.docked || !app.searchOpen },
            x = { app.docked ? 20 : parent.menu.x + parent.menu.width + 6 },
            layout: SimpleLayout [ axis = x, spacing = 5 ],

            // "Declare" is the way home — navigate() resolves against the
            // distro root, so this works on either host at any mount point

            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                textFill = { gradient("90deg", provided("theme").accent, provided("theme").accentSecondary) }, text = "Declare",
                onClick() { app.navigate("apps/homepage/homepage.declare") }
                ],
            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                textColor = { provided("theme").text }, text = "Docs" ]
            ],

        // the pill: search-as-you-type over the whole corpus; Enter opens the
        // first hit; ⌘K focuses it from anywhere (the Keys source above)

        /* The pill is the field itself: the capsule is the TextInput's own
           shape, its text inset by per-side padding, so focus — and the focus
           ring, which takes the focused view's corners — frames the capsule a
           person sees (planes.md §14: no wrapper drawing chrome around a
           square field). The field's fill is the surface tone, which is also
           what keeps the native caret and placeholder legible in dark. */

        /* The pill centers in the window but never collides: its span is the
           gap between the brand and whatever the right cluster starts with
           (measured off those views, not a breakpoint — a longer brand or a
           wider stepper moves the bound by itself), and the centered x is
           clamped into that gap. Below `compact` the stepper stands down (the
           reading zoom is the most droppable control; the theme switch and the
           search are not), which is what keeps the pill usable at 560. */

        /* Undocked, the field is closed until the search button opens it, and
           then runs across the bar from the start edge to that button, which
           has become the way to close it. */

        search: TextInput [ y = center, height = { app.touchDevice ? 44 : 32 }, cornerRadius = { this.height / 2 },
            visible = { app.docked || app.searchOpen },
            lo: number = { app.docked ? parent.brand.x + parent.brand.width + 16 : 12 },
            hi: number = { app.docked ? (app.compact ? parent.themeSwitch.x : parent.size.x) - 16 : parent.find.x - 8 },
            x = { app.docked ? Math.max(this.lo, Math.min((app.width - this.width) / 2, this.hi - this.width)) : this.lo },
            width = { app.docked ? Math.max(120, Math.min(440, this.hi - this.lo)) : this.hi - this.lo },
            fill = { provided("theme").surface },
            stroke = { stroke(1, this.focused ? provided("theme").accent : provided("theme").line) },
            padding = [0, 16, 0, 16],
            fontSize = 16, textColor = { provided("theme").text },   // 16: a field under it makes iOS zoom the page toward it
            placeholder = { app.docked ? "Search the docs…   ⌘K" : "Search the docs…" },
            onInput(t: string) { app.searchQ = "" + t; app.searchSel = -1 },
            onEnter() { if (app.searchHits.length > 0) app.openResult(app.searchHits[0].loc) },
            onKeyDown(e: KeyEvent) {
                if (e.key == "Escape") app.dismissSearch()
                else if (e.key == "ArrowDown" && app.searchHits.length > 0) app.focusHit(0)
                }
            ],

        // the reading size: the content pane's text zooms, the nav keeps its size

        size: TextSizeSwitch [ y = center, x = { parent.themeSwitch.x - this.width - 20 }, height = 30,
            visible = { !app.compact },
            value = { app.fontScale },
            input(v: object) { app.fontScale = v as number }
            ],

        // the theme switch. Selection is one App attribute (`themeMode`); the
        // theme record derives from it, so the whole app (and every island's
        // chrome) reskins from this one control.

        // light / dark: shows the appearance in force, a press flips it; until
        // then `themeMode` stays "auto" and the OS decides

        themeSwitch: AppearanceSwitch [ y = center, x = { app.width - this.width - (app.docked ? 16 : 8) },
            width = { app.touchDevice ? 44 : provided("theme").appearanceSwitchSize },
            dark = { app.darkUI },
            input(v: boolean) { app.themeMode = v ? "dark" : "light" }
            ],

        // undocked, the search pill folded to its mark — and, while the field
        // is open, the way to close it

        find: BarButton [ y = center, x = { parent.themeSwitch.x - this.width - 4 }, visible = { !app.docked },
            accessibilityLabel = { app.searchOpen ? "Close search" : "Search" },
            press() { if (app.searchOpen) app.dismissSearch(); else app.openSearch() },
            SearchIcon [ x = center, y = center, iconSize = 18, ink = { parent.ink }, visible = { !app.searchOpen } ],
            CloseIcon [ x = center, y = center, iconSize = 18, ink = { parent.ink }, visible = { app.searchOpen } ]
            ]
        ],

    /* ## The left rail
       Below the bar, fixed beside the page (`ignoreScroll`, like the bar) and
       scrolling its own nav. Built only while the window is wide enough to
       keep it (`docked`); narrower, the same nav opens as a drawer. */

    rail: View [ ignoreScroll = true, x = 0, y = { app.barH }, width = { app.railW }, height = { app.height - app.barH }, scrolls = y, fill = { provided("theme").rail },
        exists = { app.docked },
        edge: View [ x = { app.railW - 1 }, y = 0, width = 1, height = 100%, fill = { provided("theme").edge } ],
        col: NavColumn [ x = 16, y = 16, width = { app.railW - 32 } ]
        ],

    /* ## The detail column
       The page itself: the App scrolls, and this column is its extent — the
       bar and the rail ride fixed beside it. So the browser's own instruments
       apply to the reading — Back returns to the scroll position it left, an
       `@anchor` lands under the bar by `revealInset`. Guide chapters are
       light shells (each fetches and builds its content only once visibility
       asks — ChapterDetail); the reference is one page, re-rooted to the
       selection (refCol). So the page only ever measures what is actually
       being read. `selectable` (a provided value) opts the whole column into
       ordinary browser text selection — prose, signatures, Markdown runs —
       while the rail stays chrome.

       Search replaces the content: while the query is non-empty the reading
       column hides and the results page takes the pane — same column, same
       scroller, no overlay chrome. Clearing the query (Escape, opening a
       result, deleting the text) brings the page back exactly as it was:
       `visible` conceals, it never tears down. No matches (or the index still
       loading) says so in the middle of the pane. */

    detail: View [ x = { app.docked ? app.railW : 0 }, y = { app.barH }, width = { app.width - (app.docked ? app.railW : 0) }, selectable = true,

        // the reading margins are the pane's own content box, so every column
        // in it is simply the room it is given — narrower without the rail

        padding = { app.docked ? [0, 48, 0, 48] : [0, 20, 0, 20] },
        top: View [ x = 0, y = 0, width = 1, height = 1 ],       // showPage's scroll-to-top anchor
        col: View [ y = { app.docked ? 40 : 24 }, width = 100%, visible = { app.searchQ == "" },
            guideCol: View [ width = 100%, visible = { app.mode == "guide" },
                ChapterDetail [ datapath = :guide[], cid = :id ]
                ],

            /* One reference page exists at a time — the selection's. The
               datapath computes the selected class's node, so a switch
               re-roots this single subtree and builds just that page, and a
               boot never constructs the hundreds it is not showing; the rail
               (ClassTab, above) still replicates the full list — that is what
               visibility requires of a navigator. */

            refCol: View [ width = 100%, visible = { app.mode == "reference" }, exists = { app.refSeen },
                ClassDetail [ datapath = { (app.docs.read(["tree"]) || []).find(c => c.name == app.selected) }, cname = :name ]
                ],

            // the language pane: the index (no cursor) or ONE form's page, re-rooted to
            // the selection exactly as the reference page is

            langCol: View [ width = 100%, visible = { app.mode == "language" }, exists = { app.langSeen },
                FormIndex [ datapath = { app.docs.read(["forms"]) } ],
                FormDetail [ datapath = { ((app.docs.read(["forms", "pages"]) || {}) as any)[app.form] }, slug = { "" + :slug } ]
                ],

            // the type pane — ONE page, re-rooted to the selection, exactly as
            // the reference and language panes are

            typeCol: View [ width = 100%, visible = { app.mode == "type" }, exists = { app.typeSeen },
                TypeDetail [ datapath = { ((app.docs.read(["types", "pages"]) || {}) as any)[app.tname] }, tname = { "" + :name } ]
                ]
            ],

        // the results page — rows replicate off the computed hits (the
        // homepage's value-root + :items[] idiom); focusHit walks these
        // children, so this column is the one place rows live

        searchCol: View [ y = 24, width = 100%,
            visible = { app.searchQ != "" && app.searchHits.length > 0 },
            layout: SimpleLayout [ axis = y, spacing = 2 ],
            datapath = { app.hits.value },
            SearchHit [ datapath = :items[], width = 100% ]
            ],

        // the empty answer, centered in the pane — visible only once the
        // index has answered (before that, the honest "loading")

        noHits: View [ visible = { app.searchQ != "" && app.searchHits.length == 0 },
            x = 0, y = 0, width = 100%, height = 100%,
            msg: Muted [ x = center, y = center, fontSize = 14,
                text = { app.searchIdx.loaded ? "No matches — the corpus has nothing for “" + app.searchQ + "”." : "Loading the search index…" } ]
            ]
        ],

    /* ## The drawer
       Undocked, the rail's nav opens over the page from the start edge. It
       closes on a pick (each nav row writes `navOpen` back), and as a sheet
       does on Esc, a press past it, and a swipe back toward its edge. */

    drawer: Sheet [ edge = "start", sheetWidth = 300, accessibilityLabel = "Contents",
        shown = { app.navOpen && !app.docked },
        input(open: boolean) { app.navOpen = open },
        NavColumn [ ]
        ]
    ]
