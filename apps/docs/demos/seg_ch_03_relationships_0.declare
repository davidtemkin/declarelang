App [ fill = black, textColor = whitesmoke,
    v: number = 42,
    cool: Color = dodgerblue,
    warm: Color = turquoise,
    onMouseDown() { v = (v + 30) % 100 },
    View [ x = 30, y = 30,
        layout: SimpleLayout [ axis = y, spacing = 20 ],
        Text [ fontSize = 70, fontWeight = bold, text = { `${v}` } ],
        Bar [ width = 300, value = { v },
            tint = { v < 50 ? cool : warm } ]
        ]
    ]
