// Prose, authored in Markdown
// It renders as real wrapped views — headings, emphasis, links, code — in the app's own type.

App [
    Markdown [ x = 30, y = 20, width = 400, text = """
# Declare

A **declarative** UI language:

- reactive `{ }` constraints
- native layout, both backends
- text authored in Markdown
""" ]
    ]
