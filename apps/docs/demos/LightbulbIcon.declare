// LightbulbIcon, at chrome sizes
// One path — the hint mark — at 16, 24, and 32, then tinted: `iconSize` scales the 16-box,
// `ink` colors it, and the stroke keeps a constant weight in device pixels at every size.

App [ textColor = 0x172530,
    row: View [ x = 20, y = 20, height = 40, width = { this.contentWidth },
        layout: SimpleLayout [ axis = x, spacing = 24 ],   // an Icon centers itself on y
        LightbulbIcon [ iconSize = 16 ],
        LightbulbIcon [ iconSize = 24 ],
        LightbulbIcon [ iconSize = 32 ],
        LightbulbIcon [ iconSize = 32, ink = 0x2E6FE0 ]
        ]
    ]
