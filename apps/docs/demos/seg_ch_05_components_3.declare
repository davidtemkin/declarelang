class Cart [
    count: number = 0,
    add() { count = count + 1 },
    clear() { count = 0 }
    ]


App [ width = 340, height = 90, fill = white, textColor = black,
    cart: Cart [ ],
    row: View [ x = 20, y = 24,
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        Button [ label = "Add", primary = true,
            onClick() { app.cart.add() }
            ],
        Button [ label = "Clear",
            onClick() { app.cart.clear() }
            ],
        Text [ text = { app.cart.count + " in the cart" } ]
        ]
    ]
