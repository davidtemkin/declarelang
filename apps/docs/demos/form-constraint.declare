// A relationship that stays true
// The box's size and colour are constraints on the slider's value; nothing subscribes,
// nothing re-renders — the expressions are re-evaluated when what they read changes.

App [ fill = 0xF6F8FA, textColor = 0xFFFFFF, fontSize = 13,
    t: number = 0.4,
    Slider [ x = 20, y = 16, width = 220, min = 0, max = 1, value = { app.t },
        input(v: number) { app.t = v }
        ],
    box: View [ x = 20, y = 50, cornerRadius = 8,
        width = { 60 + app.t * 240 },
        height = { 30 + app.t * 60 },
        fill = { app.t < 0.5 ? 0x2E6FE0 : 0xC93B47 },
        TextLabel [ x = 8, text = { "t = " + app.t.toFixed(2) } ]
        ]
    ]
