// Drive a slot to a target
// Click the box; the Animator moves its `x` toward the target over its duration — the slot animates, nothing is ticked by hand.

App [
    View [ x = 30, y = 90, width = 80, height = 80, cornerRadius = 10, fill = dodgerblue,
        onClick() { slide.start() },
        Text [ x = 20, y = 30, fontSize = 15, fontWeight = semibold,
            textColor = whitesmoke, text = "click" ],
        slide: Animator [ attribute = x, to = 460, duration = 500, motion = easeOut ]
        ]
    ]
