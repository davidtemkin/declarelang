App [ width = 360, height = 220, theme = { SanFrancisco },
    size: number = 14,
    Button [ x = 20, y = 20, label = "Text size…",
        onClick() { app.sizes.showFor(this) }
        ],
    Text [ x = 20, y = 80, fontSize = { app.size }, textColor = { provided("theme").text }, text = "Sample" ],
    sizes: Popover [
        Text [ textColor = { provided("theme").text }, text = { "Size " + app.size } ],
        Slider [ width = 180, min = 10, max = 32, value = { app.size },
            commit(v: number) { app.size = Math.round(v) }
            ]
        ]
    ]
