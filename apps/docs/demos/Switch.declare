// A boolean with a thumb, its label before it
// Same value contract as Checkbox: `checked` derives from the app's fact, `commit` delivers
// the change back up — the control never owns the truth. The line under it reads the same fact.

App [ textColor = 0x172530, fontSize = 14,
    night: boolean = false,
    col: View [ x = 20, y = 20, width = 220,
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        Switch [ label = "Dark mode", width = 100%, checked = { app.night },
            commit(v: boolean) { app.night = v }
            ],
        Text [ text = { app.night ? "Dark mode is on" : "Dark mode is off" } ]
        ]
    ]
