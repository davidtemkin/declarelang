// The field is the source of truth
// The Text beside it reads the field's `text` live — no submit, no event, no copy of the value.

App [ fill = white, textColor = black,
    View [ x = 30, y = 30,
        layout: SimpleLayout [ axis = y, spacing = 20 ],
        field: TextInput [ width = 300, height = 40, padding = 10, cornerRadius = 10,
            fill = gainsboro, placeholder = "type here" ],
        Text [ fontSize = 20, fontWeight = semibold,
            text = { "hello, " + (parent.field.text || "world") } ]
        ]
    ]
