App [ width = 300, height = 160, fill = white,
    card: View [ x = 20, y = 40, width = 120, height = 80, cornerRadius = 10, fill = 0x4C8DFF,
        downX: number = 0,
        startX: number = 0,
        onMouseDown(e) { downX = e.x; startX = this.x },
        onMouseMove(e) { x = Math.max(0, Math.min(180, startX + (e.x - downX))) },
        ],
    ]
