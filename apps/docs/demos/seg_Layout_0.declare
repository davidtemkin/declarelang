class Rail extends Layout [
    gap: number = 8,

    place() {
        let x = 0
        return this.laid().map((c) => {
            const box = ({ x })
            if (c.visible) x = x + (c as any).width + this.gap
            return box
            })
        },
    ]

App [
    layout: Rail [ gap = 12 ],
    View [ width = 40, height = 40, fill = tomato ],
    View [ width = 60, height = 40, fill = royalblue ],
    View [ width = 30, height = 40, fill = seagreen ],
]
