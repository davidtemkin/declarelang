// A typeface is an object in the tree
// `serif: Font [ … ]` and `mono: Font [ … ]` live on the App; a family slot takes one in a { },
// alone or first in a fallback list. `fontFamily` is provided, so the App's choice reaches
// every Text below until one overrides it — and a raw family string is still allowed.

App [ fill = 0xF6F8FA, textColor = 0x172530, fontSize = 16, fontFamily = { [app.serif, "serif"] },
    serif: Font [ family = "Georgia, 'Times New Roman', serif" ],
    mono: Font [ family = "ui-monospace, Menlo, monospace" ],
    col: View [ x = 20, y = 16, width = 400,
        layout: SimpleLayout [ axis = y, spacing = 8 ],
        Text [ text = "This line inherits the App's serif font." ],
        Text [ fontFamily = { [app.mono, "monospace"] }, text = "This one picks the mono font itself." ],
        Text [ fontFamily = "system-ui", text = "And a raw family string is allowed too." ]
        ]
    ]
