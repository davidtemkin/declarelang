App [ width = 240, height = 120, fill = midnightblue, textColor = whitesmoke,
    x0: number = 20,
    v: number = 60,
    physics: Frames [ onFrame(dt: number) { app.x0 = (app.x0 + app.v * dt) % 200 } ],
    dot: View [ x = { app.x0 }, y = 40, width = 40, height = 40, cornerRadius = 20,
        fill = turquoise ],
    ]
