App [ width = 400, height = 200,
    d: Dataset [ contents = { { rows: [...Array(500).keys()].map((i) => ({ id: i, n: "row " + i })) } } ],
    DataGrid [ x = 20, y = 20, width = 300, height = 150, datapath = { d.value },
        Column [ title = "Name", field = "n", width = 280 ],
        GridRow [ datapath = :rows[], virtualize = true ]
        ]
    ]
