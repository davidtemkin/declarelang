// WrappingLayout.declare — a horizontal flow of chips that wraps to new rows

class Chip extends View [ height = 30, cornerRadius = 15, fill = steelblue,
    label: string = "",
    Text [ x = 10, y = 5, fontSize = 13, fontWeight = semibold,
        textColor = whitesmoke, text = { classroot.label } ]
    ]


App [
    View [ x = 20, y = 20, width = 320,
        layout: WrappingLayout [ spacing = 10, lineSpacing = 10 ],
        Chip [ width = 70, label = "views" ],
        Chip [ width = 90, label = "reactive" ],
        Chip [ width = 80, label = "layout" ],
        Chip [ width = 60, label = "text" ],
        Chip [ width = 100, label = "animator" ],
        Chip [ width = 60, label = "state" ],
        Chip [ width = 90, label = "dataset" ],
        Chip [ width = 90, label = "markdown" ]
        ]
    ]
