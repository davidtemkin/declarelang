App [ on: boolean = false,
    onMouseDown() { on = !on },
    View [ x = 30, y = 30,
        layout: SimpleLayout [ axis = y, spacing = 20 ],
        Text [ textColor = slategray, text = "click anywhere to toggle" ],
        View [ height = 60, width = 60, cornerRadius = 30, fill = dodgerblue,
            Spring [ attribute = x, to = { on ? 240 : 0 },
                stiffness = 190, damping = 20 ]
            ]
        ]
    ]
