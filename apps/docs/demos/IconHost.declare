// A name becomes a view
// `kind` names an icon class; the host materializes it through `createView` and reserves
// no space when the name is empty. It is what lets a control say `iconLeft = "PlusIcon"`.

use [ PlusIcon, CheckIcon, CloseIcon ]   // named by string, so kept by name

App [ textColor = 0x172530, fontSize = 13,
    row: View [ x = 20, y = 20, height = 32, width = { this.contentWidth },
        layout: SimpleLayout [ axis = x, spacing = 16 ],
        IconHost [ kind = "PlusIcon" ],
        IconHost [ kind = "CheckIcon", ink = 0x12A594 ],
        IconHost [ kind = "CloseIcon", ink = 0xC93B47 ],
        IconHost [ kind = "" ],                              // empty: zero width, nothing reserved
        Text [ textColor = 0x6A7883, text = "← the fourth host is empty and takes no room" ]
        ]
    ]
