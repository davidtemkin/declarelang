// Two themes declared, one provided, swapped live
// `theme Brand [ … ]` is a named token record. `App [ theme = … ]` provides one to the whole
// tree, and your own code reads a token with `provided("theme").accent`. Click anywhere:
// the App provides the other record and every reader follows in one settle.

theme Brand [ accent = #CC3333, surface = #FFF7F5, text = #2B1D1B, muted = #9A7F7B ]

theme Night [ accent = #4C8DFF, surface = #101E28, text = #E7EEF2, muted = #8A9BA6 ]

class Heading extends Text [ fontWeight = bold, fontSize = 18, textColor = { provided("theme").text } ]

App [ theme = { app.night ? Night : Brand }, fill = { provided("theme").surface }, fontSize = 14,
    night: boolean = false,
    onClick() { night = !night },
    col: View [ x = 20, y = 20, width = { parent.width - 40 },
        layout: SimpleLayout [ axis = y, spacing = 8 ],
        Heading [ text = { app.night ? "Night — declared above" : "Brand — declared above" } ],
        Text [ textColor = { provided("theme").muted }, text = "click anywhere to provide the other theme" ],
        swatch: View [ width = 120, height = 24, cornerRadius = 6, fill = { provided("theme").accent } ]
        ]
    ]
