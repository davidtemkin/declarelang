// Machinery with no box
// A `Node` subclass is for a job that paints nothing: here a die — its state and the
// verbs that drive it. It lives in the tree as a named member; the readout reads it,
// and the buttons drive it.

class Die extends Node [
    sides: number = 6,
    last: number = 0,
    rolls: number = 0,
    roll() { last = 1 + Math.floor(Math.random() * sides); rolls = rolls + 1 },
    reset() { last = 0; rolls = 0 }
    ]


App [ textColor = 0x172530, fontSize = 14,
    die: Die [ ],
    row: View [ x = 20, y = 20, height = 40, width = { this.contentWidth },
        layout: SimpleLayout [ axis = x, spacing = 10, align = center ],
        Text [ fontSize = 24, fontWeight = semibold, width = 90,
            text = { app.die.last == 0 ? "–" : String(app.die.last) } ],
        Button [ label = "Roll",
            onClick() { app.die.roll() }
            ],
        Button [ label = "Reset",
            onClick() { app.die.reset() }
            ]
        ]
    ]
