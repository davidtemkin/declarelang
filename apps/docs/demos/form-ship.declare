// A program that says what its package must carry. Nothing here changes how
// it runs on the site; a production build reads the block and ships the rest.

ship [ islands = ["spring"], files = ["../shots/calendar-dark.webp"] ]

App [ width = 100%, height = 120, fill = { provided("theme").bg },
    Text [ x = 12, y = 12, text = "ship [ islands = [ \"spring\" ], files = [ \"…/calendar-dark.webp\" ] ]" ],
    Text [ x = 12, y = 44, text = "a package of this program carries the spring demo, compiled ahead, and the shot" ],
    Text [ x = 12, y = 72, text = "here on the site, both are simply beside it" ]
    ]
