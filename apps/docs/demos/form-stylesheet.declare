// A skin, keyed by class, swapped live
// Two sheets with an entry per class name, the App included. The App's `stylesheet` is a
// prevailing slot — flip it and the governed subtree restyles in one settle. (A sheet may
// also carry a `theme:` record; it replaces the app's theme whole, so start one from a
// preset — the house themes in library/themes are exactly such sheets.)

stylesheet Day [
    App:  [ fill = #FFFFFF ],
    Text: [ textColor = #172530 ],
    View: [ opacity = 1 ]
    ]


stylesheet Night [
    App:  [ fill = #0B141B ],
    Text: [ textColor = #E7EEF2 ],
    View: [ opacity = 0.92 ]
    ]


App [ stylesheet = Day, fontSize = 14,
    night: boolean = false,
    Switch [ x = 20, y = 16, checked = { app.night },
        input(v: boolean) { app.night = v; app.stylesheet = app.lookupStylesheet(v ? "Night" : "Day") }
        ],
    Text [ x = 74, y = 18, text = { app.night ? "Night sheet — App, Text and View entries restyled" : "Day sheet" } ],
    Button [ x = 20, y = 56, label = "a button, on the same theme in both" ]
    ]
