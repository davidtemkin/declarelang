// Editing a column in place
// `edit: true` makes a column's cells text fields that write the record as you type. Return
// or Down moves to the row below, Up to the row above, and Esc puts back what was there.

App [ width = 420, height = 160,
    d: Dataset { { "rows": [ { "id": 1, "item": "Flour", "qty": "2 kg" },
                             { "id": 2, "item": "Eggs", "qty": "12" },
                             { "id": 3, "item": "Butter", "qty": "250 g" } ] } },
    DataGrid [ x = 20, y = 20, width = 380, height = 120,
        items = { app.d.value.rows },
        columns = { [ { id: "item", title: "Item", width: 200, edit: true }, { id: "qty", title: "Quantity", width: 160, edit: true } ] } ]
    ]
