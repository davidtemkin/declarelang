// SimpleLayout.declare — children stacked down the y axis, evenly spaced

App [ fill = white, textColor = black,
    View [ x = 30, y = 20,
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        Bar [ width = 320, label = "north", value = 70, tint = royalblue ],
        Bar [ width = 320, label = "east",  value = 50, tint = dodgerblue ],
        Bar [ width = 320, label = "south", value = 90, tint = cornflowerblue ],
        Bar [ width = 320, label = "west",  value = 40, tint = lightskyblue ]
        ]
    ]
