// Children stacked down the y axis
// Evenly spaced by `spacing`; sizes stay the children's own, and the layout owns their positions.

App [ fill = white, textColor = black,
    View [ x = 30, y = 20,
        layout: SimpleLayout [ axis = y, spacing = 10 ],
        Gauge [ width = 320, label = "north", value = 70, tint = royalblue ],
        Gauge [ width = 320, label = "east",  value = 50, tint = dodgerblue ],
        Gauge [ width = 320, label = "south", value = 90, tint = cornflowerblue ],
        Gauge [ width = 320, label = "west",  value = 40, tint = lightskyblue ]
        ]
    ]
