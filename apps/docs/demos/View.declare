// A View is a box
// Size, decoration, children, and interaction, on one class. Click the box: `hot` flips, and the fill that reads it follows.

App [
    View [ x = 30, y = 30, width = 240, height = 150, cornerRadius = 16,
        hot: boolean = false,
        fill = { hot ? 0xE0533D : 0x2E6BE6 },
        onClick() { hot = !hot },
        Text [ x = 20, y = 20, fontSize = 15, fontWeight = semibold,
            textColor = whitesmoke, text = "click to recolor" ]
        ]
    ]
