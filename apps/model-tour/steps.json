    {
      "id": "own",
      "part": "motion",
      "title": "A layout is one method",
      "point": "A layout of your own is a class with place(): it returns a box for each child. The library's layouts are written the same way.",
      "hint": "",
      "code": [
        "class Ring extends Layout [ r: number = {{r}},",
        "    place() {",
        "        const kids = this.laid(), n = kids.length",
        "        const cx = this.contentExtent(\"width\") / 2",
        "        const cy = this.contentExtent(\"height\") / 2",
        "        return kids.map((c, i) => {",
        "            const a = 2 * Math.PI * i / n",
        "            const px = cx + r * Math.cos(a)",
        "            const py = cy + r * Math.sin(a)",
        "            return ({ x: px - c.width / 2,",
        "                y: py - c.height / 2 })",
        "            })",
        "        }",
        "    ]",
        "",
        "ring: View [ width = 400, height = 320,",
        "    layout: Ring [ ],",
        "    Chip [ label = \"Design\" ],",
        "    Chip [ label = \"Build\" ],",
        "    // … six in all",
        "    ]"
      ],
