    {
      "id": "glide",
      "part": "motion",
      "title": "Change the arrangement; it glides",
      "point": "Extend TweenLayout and change what place() reads: the children glide to their new boxes, and turn mid-flight if it changes again.",
      "hint": "Rearrange, then rearrange again before it lands.",
      "code": [
        "class RingOrGrid extends TweenLayout [ r: number = {{r}},",
        "    round: boolean = true,",
        "    place() {",
        "        const kids = this.laid(), n = kids.length",
        "        const cx = this.contentExtent(\"width\") / 2",
        "        const cy = this.contentExtent(\"height\") / 2",
        "        return kids.map((c, i) => {",
        "            const a = 2 * Math.PI * i / n",
        "            const px = cx + r * Math.cos(a)",
        "            const py = cy + r * Math.sin(a)",
        "            return round",
        "                ? ({ x: px - c.width / 2,",
        "                    y: py - c.height / 2 })",
        "                : ({ x: i % 3 * {{cell}},",
        "                    y: Math.floor(i / 3) * {{rowH}} })",
        "            })",
        "        }",
        "    ]",
        "",
        "ring: View [ width = 400, height = 320,",
        "    layout: RingOrGrid [ round = { app.round } ],",
        "    // … six chips",
        "    ],",
        "Button [ label = \"Rearrange\",",
        "    onClick() { app.round = !app.round } ]"
      ],
