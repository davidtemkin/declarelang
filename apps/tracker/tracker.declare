/*
# Declare Tracker

An issue tracker fast enough to triage a six-figure backlog: one flat
list, searched as you type, filtered, sorted, and grouped; issues open
IN PLACE for editing; create, bulk operations, and delete with undo; a
live statistics rail. Not one word of virtualization vocabulary appears
in this file — the list windows, recycles, measures its mixed-height
rows, and holds its viewport steady because the RUNTIME does all of
that; this source just declares rows over data.

The architecture, end to end:

- **One truth.** `db` holds the issues. Every mutation writes `db`, and
  every derivation re-runs because it READ `db` — no clock, no ticking,
  nothing anywhere keeping view-side state about data.
- **Views are derivations.** `shown` — the projected dataset the list
  renders — derives from the truth plus the view facts (filters, query,
  sort, grouping). So do the rail's counts, the workload bars, and the
  closed-per-day chart: change the data and every number moves, because
  each one is a constraint over the same truth.
- **Search is one more filter on the projection**, never a scan of
  rendered rows. The query narrows the derived dataset exactly as a
  status chip does; Enter and the search field's arrows walk the
  narrowed rows, which materialize on arrival like any others.
- **Editing is a working copy.** An open issue edits a DRAFT dataset
  bound with `<->`; Save commits the draft into the truth and closes,
  Cancel discards and closes — cancel is honest, and autosave is not
  pretended.
- **Selection holds RECORDS**, not indices: it survives sort flips,
  filter changes, and scrolling out of the window; regenerating the
  dataset is the only thing that clears it.

Scale: the shipped asset is 10,000 issues (~350 KB gzipped); the header's
scale control regenerates 10K / 100K / 1M in memory from the seeded
generator below — the same algorithm as tools/internal/gen-issues.mjs,
kept in sync by hand (the seed and the pools are the contract). Every
millisecond the rail reports is measured in this file, not asserted.
*/

use [ Menu, SunIcon, AutoIcon, MoonIcon ]   // the appearance menu names its icons in data

// ── script land: plain TypeScript helpers, zero reactive machinery ────────
//
// Functions declared here are callable from `{ }` constraint bodies and
// from methods; they compute, they never store. App state lives on the
// App below; record-shaped state lives in its datasets.

script [ "tracker-data.ts" ]

// ── small pieces: the tracker's ICON VOCABULARY ───────────────────────────
//
// One glance, no reading: status is a RING (hollow = open, dotted =
// in progress, filled = blocked, checked = done), priority is a BAR
// TRIO, a person is an AVATAR. Text codes ("P2", "in-progress") retreat
// to the places prose belongs — menus and the detail panel.

schema Issue [ id: number, title: string, description: string,
    status: "open" | "in-progress" | "blocked" | "closed",
    priority: "P0" | "P1" | "P2" | "P3",
    labels[]: string, assignee?: string,
    created: number, updated: number, closedAt?: number, comments: number ]


class StatusIcon extends View [ width = 14, height = 14,
    s: string = "open",
    ring: View [ x = 0, y = 0, width = 14, height = 14, cornerRadius = 7,
        fill = { s == "blocked" || s == "closed" ? trkStatusColor(classroot.s) : null },
        stroke = { stroke(1.5, trkStatusColor(classroot.s)) } ],
    dot: View [ visible = { s == "in-progress" }, x = 4.5, y = 4.5, width = 5, height = 5, cornerRadius = 2.5,
        fill = { trkStatusColor(classroot.s) } ],
    chk: CheckIcon [ visible = { s == "closed" }, x = 1.5, y = 1.5, iconSize = 11, weight = 1.9,
        ink = { trkWhite() } ],
    bang: Text [ visible = { s == "blocked" }, x = 5.5, y = 1, fontSize = 9, fontWeight = bold, wrap = false,
        textColor = { trkWhite() }, text = "!" ]
    ]


class PrioIcon extends View [ width = 13, height = 12,
    p: string = "P3",
    tip = { p == "P0" ? "Priority · P0 Urgent" : p == "P1" ? "Priority · P1 High" : p == "P2" ? "Priority · P2 Medium" : "Priority · P3 Low" },
    lit: number = { p == "P0" || p == "P1" ? 3 : p == "P2" ? 2 : 1 },
    tone: number = { p == "P0" ? trkRed() : 0 },
    b1: View [ x = 0, y = 7, width = 3, height = 5, cornerRadius = 1,
        fill = { classroot.tone != 0 ? classroot.tone : theme.textMuted } ],
    b2: View [ x = 5, y = 4, width = 3, height = 8, cornerRadius = 1,
        fill = { classroot.lit >= 2 ? (classroot.tone != 0 ? classroot.tone : theme.textMuted) : theme.line } ],
    b3: View [ x = 10, y = 0, width = 3, height = 12, cornerRadius = 1,
        fill = { classroot.lit >= 3 ? (classroot.tone != 0 ? classroot.tone : theme.textMuted) : theme.line } ]
    ]


class Avatar extends View [ width = 22, height = 22, cornerRadius = 11,
    name: string = "",
    capSize: number = 8.5,
    fill = { name == "" ? null : trkHue(name) },
    stroke = { name == "" ? stroke(1, theme.line) : null },
    cap: TextLabel [ x = 0, textAlign = center, fontWeight = semibold, wrap = false,
        width = { parent.width },
        fontSize = { classroot.capSize },
        letterSpacing = 0.3,
        textColor = { classroot.name == "" ? theme.textFaint : trkWhite() },
        text = { classroot.name == "" ? "—" : trkInitials(classroot.name) } ]
    ]


// a label pill: a color-keyed dot and the name, outline-quiet

class Tag extends View [ height = 18, cornerRadius = 9,
    t: string = "",
    width = { this.cap.width + 26 },
    stroke = { stroke(1, theme.line) },
    dot: View [ x = 7, y = 6, width = 6, height = 6, cornerRadius = 3, fill = { trkHue(t) } ],
    cap: Text [ x = 17, y = 2.5, fontSize = 10.5, wrap = false,
        textColor = { theme.textMuted }, text = { t } ]
    ]


// a FILTER CHIP: one value of one facet, its live count, and the on state —
// clicking toggles the facet (a Control: tab stop, Space/Enter, the ring)

class Chip extends Control [ height = 28, cornerRadius = 8,
    facet: string = "",         // "status" | "assignee" | "label"
    value: string = "",
    count: number = -1,         // -1 hides the count
    on: boolean = false,
    width = { this.row.contentWidth + 24 },
    fill = { on ? theme.controlSelected : hot ? theme.control : null },

    // the tally is a SPRUNG NUMBER — `Spring [ attribute = … ]` animates any
    // slot, data included, so a bulk move rolls the counts over instead of
    // snapping them. One declaration; no other wiring anywhere.

    anim: number = 0,
    Spring [ attribute = anim, to = { count < 0 ? 0 : count }, stiffness = 170, damping = 26 ],

    row: View [ x = 12, y = 6,
        layout: SimpleLayout [ axis = x, spacing = 6 ],
        dot: View [ y = 5, width = 6, height = 6, cornerRadius = 3,
            fill = { trkStatusColor(classroot.value) } ],
        cap: Text [ fontSize = 12.5, wrap = false,
            fontWeight = { classroot.on ? "semibold" : "normal" },
            textColor = { classroot.on ? theme.text : theme.textMuted },
            text = { trkStatusLabel(classroot.value) } ],
        n: Text [ y = 1, fontSize = 11, wrap = false, visible = { classroot.count >= 0 && !app.compact },
            textColor = { theme.textFaint }, text = { "" + Math.round(classroot.anim) } ]
        ],
    press() { app.toggleFilter(facet, value) },
    onClick() { if (!disabled) press() }
    ]


// the ISSUE ROW — one calm line: icons carry status and priority, the
// title is the row's single strong element, everything else recedes to
// the right (labels, the avatar, the date). Group headers are the
// taller face. The row never mentions how many of it exist.

class IssueRow extends TableRow [
    isHdr: boolean = { ("" + :kind) == "hdr" },

    exp: boolean = { !isHdr && ("" + :id) == ("" + app.expandedId) },

    // Opening and closing an issue ANIMATES — the one deliberate act in the
    // list, and the motion is what says "this row became a pane" rather than
    // "the list jumped". `targetH` is the resting height; the Spring carries
    // the row to it.
    //
    // What must NOT animate is a row REVEALED by scrolling. That is the
    // reconciler's business, not the author's: an instance presenting a record
    // it was not presenting before takes its geometry outright (Spring.arrive,
    // via replicate.ts), so an expanded row scrolled out and back returns at
    // its open height with no motion, and a recycled row never slides from the
    // departed record's geometry. Verified in materialization.test.mjs.

    targetH: number = { isHdr ? 42 : exp ? 356 : 44 },
    height = 44,
    Spring [ attribute = height, to = { targetH }, stiffness = 320, damping = 34 ],

    // ── the group header face ─────────────────────────────────────────────

    hdrRow: View [ visible = { parent.isHdr }, x = 0, y = 12, width = { parent.width }, height = 24,
        // collapsed points right, open points down — one class, turned. `▶`/`▼`
        // were solid triangles from two different Unicode blocks; this is the
        // same chevron the rest of the chrome discloses with.

        chev: ChevronIcon [ x = 23, y = 3, iconSize = 11, ink = { theme.textFaint },
            dir = { app.isCollapsed("" + :status, app.groupRev) ? "right" : "down" } ],
        d: StatusIcon [ x = 42, y = 3, s = { "" + :status } ],
        cap: Text [ x = 64, y = 2, fontSize = 13, fontWeight = semibold, wrap = false,
            text = { trkStatusLabel("" + :status) } ],
        n: Roll [ y = 3.5, fontSize = 11.5, textColor = { theme.textFaint },
            x = { this.parent.cap.x + this.parent.cap.width + 10 },
            n = { (:count ?? 0) + 0 } ]
        ],

    // ── the issue face: a fixed column map, left to right ─────────────────
    //
    //   inset ▸ status ring ▸ priority bars ▸ title … labels ▸ avatar ▸ date
    //
    // `ind` is the grouped view's indent: rows tuck under their header so
    // every status ring hangs on one vertical line.

    ind: number = { app.groupBy == "status" ? 18 : 0 },
    colStat: number = { 24 + ind },      // the status ring's left edge
    colPrio: number = { 50 + ind },      // the priority bars'
    colTitle: number = { 76 + ind },     // the title's

    stat: StatusIcon [ visible = { !parent.isHdr }, y = 15, x = { parent.colStat }, s = { "" + :status } ],

    prio: PrioIcon [ visible = { !parent.isHdr }, y = 16, x = { parent.colPrio }, p = { "" + :priority } ],

    title: Text [ visible = { !parent.isHdr }, y = 14, fontSize = 13.5, wrap = false, clip = true,
        x = { parent.colTitle },
        width = { parent.tags.x - parent.colTitle - 16 },
        text = { "" + :title } ],

    when: Text [ visible = { !parent.isHdr }, y = 15, fontSize = 11.5, wrap = false, textAlign = right,
        x = { parent.width - 24 - 40 }, width = 40,
        textColor = { theme.textFaint },
        text = { trkDate(:updated ?? 0) } ],

    avatar: Avatar [ visible = { !parent.isHdr }, y = 11,
        x = { parent.when.x - 34 },
        name = { "" + (:assignee ?? "") } ],

    // the first two labels ride inline (slice replication); "+n" carries
    // the rest — the detail panel shows them all

    tags: View [ visible = { !parent.isHdr && !app.compact && (:labels ?? []).length > 0 }, height = 18, y = 13,
        x = { this.parent.avatar.x - 12 - this.contentWidth },
        layout: SimpleLayout [ axis = x, spacing = 6 ],
        Tag [ datapath = :labels[0:2][], t = { "" + this.$data("") } ],
        more: Text [ y = 3, fontSize = 10.5, wrap = false, visible = { ((:labels ?? []) as any).length > 2 },
            textColor = { theme.textFaint },
            text = { "+" + (((:labels ?? []) as any).length - 2) } ]
        ],

    // selection announces itself with the accent bar, not a heavy fill

    bar: View [ visible = { !parent.isHdr && parent.selected && !parent.exp }, x = 0, y = 6, width = 3, cornerRadius = 1.5,
        height = { Math.min(parent.height, 44) - 12 },
        fill = { theme.accent } ],

    // the OPEN-IN-PLACE editor: rides below the row's own line while the
    // height spring makes room; absorbs clicks so the row doesn't toggle

    card: EditorCard [ visible = { parent.exp }, x = 12, y = 48, clip = true,
        width = { parent.width - 24 },
        height = { Math.max(0, parent.height - 56) },
        fill = { theme.surface }, cornerRadius = 10,
        stroke = { stroke(1, theme.line) },
        shadow = { shadow(0, 4, 16, 0x00000018) },
        onClick() { }
        ],

    // a header row collapses its group instead of selecting; an issue row
    // keeps TableRow's whole selection protocol and adds the context menu

    onClick() {
        if (disabled) return
        if (isHdr) { app.toggleGroup("" + :status); return }
        if (exp) { app.closeDetail(); return }
        (parent as Table).rowClick(this.rowIndex(), this.member(),
            Keys.isDown("MetaLeft") || Keys.isDown("MetaRight") || Keys.isDown("ControlLeft") || Keys.isDown("ControlRight"),
            Keys.isDown("ShiftLeft") || Keys.isDown("ShiftRight"))
        app.openDetail()
        },

    onContextMenu(e: PointerEvent) { if (!isHdr) app.rowMenu(this, e) },
    onHold(e: PointerEvent) { if (!isHdr) app.rowMenu(this, e) },

    fill = { isHdr ? theme.bg
           : selected ? theme.controlSelected
           : hot ? theme.surface : null },
    stroke = { active && (parent as Table).focusVisible ? stroke(1, theme.accent) : null }
    ]


// the UNDO TOAST — one at a time, rises from the bottom, waits eight
// seconds, honors its word

// a person's avatar as a MENU ICON — created into the standard icon
// column (`iconKind`), so person rows keep the settled anatomy: check
// column, icon column, labels on one text edge

class PersonIcon extends Avatar [ width = 16, height = 16, cornerRadius = 8, capSize = 6.5,
    name = { "" + this.$data(["name"]) }
    ]


// a ROLLING NUMBER — the rail's working unit: a Spring on the value itself

class Roll extends Text [ wrap = false,
    n: number = 0,
    anim: number = 0,
    Spring [ attribute = anim, to = { n }, stiffness = 170, damping = 26 ],
    text = { Math.round(anim).toLocaleString() }
    ]


// one rail statistic: status icon or avatar, a name, a bar, a rolling count.
// The row IS a filter — clicking it toggles the facet it counts.

class RailStat extends Control [ height = 30, cornerRadius = 7,
    width = { app.railW - 40 },
    facet: string = "",
    value: string = "",
    cap: string = "",
    n: number = 0,
    peak: number = 1,
    tint: number = 0,
    hueName: string = "",
    tintUse: number = { hueName != "" ? trkHue(hueName) : tint },
    on: boolean = false,
    fill = { on ? theme.controlSelected : hot ? theme.control : null },
    name: Text [ x = 30, y = center, fontSize = 12.5, wrap = false, clip = true, width = 92,
        fontWeight = { classroot.on ? "semibold" : "normal" },
        textColor = { classroot.on ? theme.text : theme.textMuted },
        text = { classroot.cap } ],
    track: View [ x = 128, y = 13, height = 4, cornerRadius = 2,
        width = { classroot.width - 128 - 54 },
        fill = { theme.control },
        fillbar: View [ x = 0, y = 0, height = 4, cornerRadius = 2,
            width = { Math.max(2, parent.width * classroot.n / Math.max(1, classroot.peak)) },
            fill = { classroot.tintUse != 0 ? classroot.tintUse : theme.accent } ]
        ],
    num: Roll [ y = center, fontSize = 12, textAlign = right, width = 44,
        x = { parent.width - 48 },
        textColor = { theme.textMuted },
        n = { classroot.n } ],
    press() { app.toggleFilter(facet, value) },
    onClick() { if (!disabled) press() }
    ]


class Toast extends View [ visible = { shown || lift > 0.02 }, height = 40, cornerRadius = 10,
    shown: boolean = false,
    msg: string = "",
    gen: number = 0,
    lift: number = 0,
    Spring [ attribute = lift, to = { shown ? 1 : 0 }, stiffness = 260, damping = 26 ],
    opacity = { lift },
    width = { this.cap.width + this.u.width + 46 },
    fill = { theme.tooltipBg },
    shadow = { shadow(0, 6, 24, 0x00000040) },
    cap: TextLabel [ x = 16, fontSize = 12.5, wrap = false,
        textColor = { theme.tooltipText }, text = { msg } ],
    u: Control [ y = 7, height = 26, cornerRadius = 7,
        x = { parent.cap.x + parent.cap.width + 10 },
        width = { this.t.width + 18 },
        fill = { hot || down ? theme.accent : null },
        t: Text [ x = 9, y = center, fontSize = 12, fontWeight = semibold, wrap = false,
            textColor = { this.parent.hot || this.parent.down ? theme.accentText : theme.accent }, text = "Undo" ],
        press() { app.undoDelete() },
        onClick() { if (!disabled) press() }
        ],
    show(m: string) {
        msg = m
        shown = true
        this.raise()
        gen = gen + 1
        const g = gen
        setTimeout(() => { if (this.gen == g) this.shown = false }, 8000)
        },
    hide() { gen = gen + 1; shown = false }
    ]


// an editable LABEL TAG for the detail panel — the list Tag plus a remove ×

class EditTag extends View [ height = 22, cornerRadius = 7,
    t: string = "",
    width = { this.cap.width + 30 },
    fill = { theme.control },
    cap: Text [ x = 8, y = 4, fontSize = 11.5, textColor = { theme.textMuted }, text = { t } ],
    x2: Text [ y = 4, fontSize = 11, textColor = { theme.textFaint }, text = "×",
        x = { parent.cap.x + parent.cap.width + 4 },
        onClick() {
            const ls = ((app.draft.value.it as any).labels ?? []).filter((l) => l != classroot.t)
            app.setDraftField("labels", ls)
            }
        ]
    ]


// the in-place EDITOR — an issue edits WHERE IT LIVES. The card binds the
// draft dataset (Save commits and closes, Cancel discards and closes);
// the host row's height springs open around it, and the windowed kernel's
// measured ladder carries the animation, so the rows below glide out of
// the way. One class, two hosts: the expanded row, and the New-issue
// strip above the list.

class EditorCard extends View [
    datapath = { app.draft.value },

    col: View [ x = 16, y = 12, width = { parent.width - 32 },
        layout: SimpleLayout [ axis = y, spacing = 12 ],

        titleF: TextInput [ width = { parent.width }, height = 36, fontSize = 16, fontWeight = semibold,
            text <-> :it.title,
            placeholder = "Issue title",
            onInput(t: string) { app.draftRev = app.draftRev + 1 }
            ],

        facets: View [ width = { parent.width }, height = 28,
            layout: SimpleLayout [ axis = x, spacing = 8 ],
            st: Facet [ field = "status", value = { trkStatusLabel("" + (:it.status ?? "open")) }, tint = { trkStatusColor("" + (:it.status ?? "open")) } ],
            pr: Facet [ field = "priority", value = { "" + (:it.priority ?? "P2") }, tint = { trkPrioColor("" + (:it.priority ?? "P2")) } ],
            as: Facet [ field = "assignee", value = { (:it.assignee ?? "Unassigned") + "" } ]
            ],

        labels: View [ width = { parent.width }, height = { Math.max(22, this.row.contentHeight) },
            row: View [ x = 0, y = 0, width = { parent.width },
                layout: WrappingLayout [ spacing = 6 ],
                EditTag [ datapath = :it.labels[], t = { "" + this.$data("") } ],
                add: Control [ height = 22, cornerRadius = 7, width = 26,
                    fill = { hot ? theme.control : null },
                    stroke = { stroke(1, theme.line) },
                    t: Text [ x = 8, y = 3, fontSize = 12, textColor = { theme.textMuted }, text = "+" ],
                    press() { app.openAddLabel(this) },
                    onClick() { if (!disabled) press() }
                    ]
                ]
            ],

        descF: TextInput [ width = { parent.width }, height = 84, fontSize = 16, multiline = true, wrap = true,
            text <-> :it.description,
            placeholder = "Add a description…",
            onInput(t: string) { app.draftRev = app.draftRev + 1 }
            ],

        // ONE ROW, ONE BASELINE. Every control here is the same height, so
        // the same-sized labels (the buttons' and Delete's) share a baseline
        // by construction; only the small meta line needs the cap-difference
        // correction that `trkBaselineNudge` names.

        foot: View [ width = { parent.width }, height = { app.footRowH },
            layout: SimpleLayout [ axis = x, spacing = 10 ],
            save: Button [ width = 96, height = { app.footRowH }, label = { app.creating ? "Create" : "Save" }, primary = true,
                disabled = { !app.draftDirty },
                onClick() { if (!disabled) app.commitDraft() }
                ],
            cancel: Button [ width = 84, height = { app.footRowH }, label = "Cancel",
                onClick() { app.closeDetail() }
                ],
            meta: Text [ fontSize = 11, wrap = false, textColor = { theme.textFaint }, visible = { !app.creating },
                y = { (parent.height - this.height) / 2 + trkBaselineNudge(app.footLabelPx, this.fontSize) },
                text = { "Created " + trkDate(:it.created ?? 0) + " · Updated " + trkDate(:it.updated ?? 0) + " · " + ("" + (:it.comments ?? 0)) + " comments" } ],
            sp: Spacer [ ],

            // the destructive action wears the same button as its neighbours —
            // same box, same label size — and says what it is in outline only

            del: Control [ width = 84, visible = { !app.creating },
                height = { app.footRowH },
                cornerRadius = { typeof theme.buttonRadius == "number" ? Math.min(theme.buttonRadius, this.height / 2) : theme.controlRadius },
                fill = { hot || down ? theme.control : theme.surface },
                stroke = { stroke(1, trkRed()) },
                t: Text [ x = 0, y = center, width = 84, textAlign = center, wrap = false,
                    fontSize = { app.footLabelPx },
                    textColor = { trkRed() },
                    text = "Delete…" ],
                press() { app.deleteSelection() },
                onClick() { if (!disabled) press() }
                ]
            ]
        ]
    ]


// one editable FACET BUTTON in the editor card: the current value and a
// chevron; press opens the shared options menu for its field

class Facet extends Control [ height = 28, cornerRadius = 7,
    field: string = "",
    value: string = "",
    tint: number = 0,
    width = { this.v.width + (tint != 0 ? 46 : 34) },
    fill = { hot || down ? theme.control : null },
    stroke = { stroke(1, theme.line) },
    dot: View [ visible = { tint != 0 }, x = 9, y = 10, width = 8, height = 8, cornerRadius = 4, fill = { tint } ],
    v: Text [ y = center, fontSize = 12.5, wrap = false,
        x = { tint != 0 ? 22 : 10 },
        text = { value } ],
    arr: ChevronIcon [ y = center, iconSize = 11, x = { parent.width - 15 }, ink = { theme.textMuted } ],
    press() { app.openFacet(this, field) },
    onClick() { if (!disabled) press() }
    ]


App [ fill = { theme.bg }, textColor = { theme.text }, minWidth = 320, appName = "Declare Tracker",

    // ── the responsive facts ───────────────────────────────────────────────

    compact: boolean = { app.width < 640 },      // the bar: brand compacts, omnibox shrinks

    barH: number = 56,
    footRowH: number = 32,        // the editor footer's one row height
    footLabelPx: number = 16,     // …and its button-label size, the baseline reference
    railW: number = 300,
    railOn: boolean = { app.width >= 1100 },     // below this the rail yields to the list

    // ── the chrome facts (the flagship family conventions) ─────────────────

    themeMode: string = "auto",
    darkUI: boolean = { themeMode == "dark" || (themeMode == "auto" && app.dark) },
    theme = { app.darkUI ? Themes.sanFrancisco(true) : Themes.sanFrancisco(false) },

    // ── THE TRUTH ──────────────────────────────────────────────────────────
    //
    // `db` holds the issues, and that is the whole of it: a verb writes db and
    // every projection that read db re-runs. Nothing else anywhere holds data.
    //
    // This used to hang off a `rev` counter every verb bumped, threaded through
    // nine method parameters, on the stated grounds that "a method's reads are
    // not tracked — the ARGUMENTS are the wiring". That reason was FALSE: the
    // compiler reads through method bodies (declare.md §5), and a method here
    // wires `this.root.db.read(["issues"])` with no help. What the clock was
    // really covering for is one line — `issuesOf` used to read
    // `db.value.issues`, a raw property walk off the value with no cell to
    // subscribe to, so the projection never woke. `read([…])` is the region
    // read the language tracks. One spelling, and the clock was redundant.

    db: Dataset [ schema = [ issues[]: Issue ] ] { { "issues": [] } },

    src: DataSource [ url = "issues.json", schema = [ issues[]: Issue ] ],

    booted: boolean = false,
    loadMs: number = 0,
    adoptMs: number = 0,

    onInit() {
        const t0 = trkNow()
        src.fetch().then(() => {
            const t1 = trkNow()
            this.adopt(this.src.value != null ? this.src.value.issues : [])
            this.loadMs = Math.round(t1 - t0)
            this.adoptMs = Math.round(trkNow() - t1)
            this.booted = true
            })
        },

    adopt(issues: array) {
        for (const it of issues as any) {
            }
        db.set(["issues"], issues)
        this.takeSelection(null)
        this.closeDetail()
        },

    regenerate(count: number) {
        const t0 = trkNow()
        const issues = trkGenerate(count)
        const t1 = trkNow()
        this.adopt(issues)
        this.loadMs = Math.round(t1 - t0)
        this.adoptMs = Math.round(trkNow() - t1)
        },

    // ── the view facts ─────────────────────────────────────────────────────

    sortOn: string = "updated",
    sortDir: string = "desc",
    groupBy: string = "none",                    // none | status
    fStatus: string = "",                        // "" = no filter
    fAssignee: string = "",
    fLabel: string = "",

    // A filter, sort, or grouping change is a NEW arrangement, not an edit
    // to the old one — the list starts it at the top. The runtime pins the
    // viewport to its anchor row across DATA changes (so an edit never
    // yanks the reader); a rearrangement is the one case where that
    // stability is wrong, so the request is made twice: once now, and once
    // after the new projection has settled — the anchor compensation is a
    // sanctioned writer that runs AFTER the first request and re-scrolls to
    // follow the anchor row, so a single request cannot survive it. (The
    // platform's held-request hold covers a surface that cannot take a
    // scroll yet, not one a later writer moves — this is the latter.)

    rearranged() {
        this.list.scrollTo(0)
        setTimeout(() => { this.list.scrollTo(0) }, 0)
        },

    // Is the keyboard currently owned by a text field? A bare-character
    // shortcut must never steal a keystroke from one. `placeholder` is
    // declared by TextInput alone, so its presence identifies an editor
    // without the App needing to know where every field in the tree is.

    typing() -> boolean {
        const f = Focus.getFocus()
        return f != null && (f as any).placeholder !== undefined
        },

    clearAll() {
        fStatus = ""; fAssignee = ""; fLabel = ""; query = ""
        this.bar.omni.text = ""
        this.rearranged()
        },

    toggleFilter(facet: string, value: string) {
        if (facet == "status") fStatus = fStatus == value ? "" : value
        else if (facet == "assignee") fAssignee = fAssignee == value ? "" : value
        else if (facet == "label") fLabel = fLabel == value ? "" : value
        this.rearranged()
        },

    setSort(field: string) {
        if (sortOn != field) { sortOn = field; sortDir = field == "title" ? "asc" : "desc" }
        this.rearranged()
        },

    toggleSortDir() {
        sortDir = sortDir == "desc" ? "asc" : "desc"
        this.rearranged()
        },

    // collapsed groups — a plain array behind a change clock. This clock is
    // REAL, unlike the data one that used to sit above: `_collapsed` is an
    // ordinary JS array stashed on the instance, not a reactive slot, so
    // nothing can notice it change and something has to say so. The honest fix
    // is to make it a slot; until then the counter is doing actual work.

    groupRev: number = 0,
    collapsedSet() -> array { return (this as any)._collapsed ?? ((this as any)._collapsed = []) },
    isCollapsed(s: string, g: number) -> boolean { return this.collapsedSet().includes(s) },
    toggleGroup(s: string) {
        const c = this.collapsedSet()
        const i = c.indexOf(s)
        if (i < 0) c.push(s); else c.splice(i, 1)
        groupRev = groupRev + 1
        },

    // ── THE PROJECTION — the one derived dataset the list renders.
    //    filter → sort → (group); group headers are records too ({ kind:
    //    "hdr" }) — non-uniform rows are just rows.
    //
    //    The arguments are the VIEW FACTS, and they are arguments because that
    //    reads well, not because the wiring needs them: the body could read
    //    `app.query` directly and wire identically. The DATA is not among them
    //    — `project` reaches it through `issuesOf`, and the compiler follows
    //    the call. ─────────────────────────────────────────────────────────

    shown: Dataset [ contents = { app.project(app.fStatus, app.fAssignee, app.fLabel, app.query, app.sortOn, app.sortDir, app.groupBy, app.groupRev) } ],

    issuesOf() -> Issue[] { return db.read(["issues"]) ?? [] },

    project(byStatus: string, byAssignee: string, byLabel: string, query: string, sortOn: string, sortDir: string, grouping: string, groupClock: number) -> object {
        let rows = this.issuesOf()
        if (byStatus != "" || byAssignee != "" || byLabel != "") {
            rows = rows.filter((it) =>
                (byStatus == "" || it.status == byStatus) &&
                (byAssignee == "" || it.assignee == byAssignee) &&
                (byLabel == "" || (it.labels ?? []).includes(byLabel)))
            }
        // the query NARROWS like any other filter (a tracker searches by
        // hiding what doesn't match, not by bolding what does); the scan is
        // timed and the number rides out with the value — pure, no clocks
        let searchMs = 0
        if (query.trim() != "") {
            const t0 = trkNow()
            const needle = query.trim().toLowerCase()
            const hay = ((this as any)._hay ??= new WeakMap())
            rows = rows.filter((it) => {
                let h = hay.get(it)
                if (h == null || (h as any).u != it.updated) {
                    h = ({ u: it.updated, s: (it.title + "\n" + (it.description ?? "") + "\n" + (it.labels ?? []).join(" ") + "\n" + (it.assignee ?? "")).toLowerCase() })
                    hay.set(it, h)
                    }
                return (h as any).s.includes(needle)
                })
            searchMs = Math.max(0, Math.round((trkNow() - t0) * 10) / 10)
            }
        // Every comparator is ASCENDING — least-interesting first: oldest,
        // lowest priority, A→Z. `desc` then reverses, uniformly, with no key
        // carrying a special case (so a new sort field inherits the rule).
        const RANK = ({ P0: 3, P1: 2, P2: 1, P3: 0 })
        const asc = sortOn == "priority" ? (a, b) => RANK[a.priority] - RANK[b.priority] || a.updated - b.updated
            : sortOn == "title" ? (a, b) => (a.title < b.title ? -1 : a.title > b.title ? 1 : 0)
            : (a, b) => a.updated - b.updated
        rows = [...rows].sort(sortDir == "desc" ? (a, b) => asc(b, a) : asc)
        if (grouping != "status") return ({ rows: rows, total: rows.length, searchMs: searchMs })
        const order = ["open", "in-progress", "blocked", "closed"]
        const collapsed = this.collapsedSet()
        const out = []
        for (const st of order) {
            const members = rows.filter((it) => it.status == st)
            if (members.length == 0) continue
            out.push(({ kind: "hdr", id: "hdr:" + st, status: st, count: members.length }))
            if (!collapsed.includes(st)) out.push(...members)
            }
        return ({ rows: out, total: rows.length, searchMs: searchMs })
        },

    counts: object = { app.countStatuses() },

    closedSeries: Dataset [ contents = { app.closedPerDay() } ],
    closedPerDay() -> object {
        const DAY = 86400000
        let maxU = 0
        const issues = this.issuesOf()
        for (const it of issues) if ((it.updated ?? 0) > maxU) maxU = it.updated
        const today = Math.floor(maxU / DAY)
        const days = new Array(14).fill(0)
        for (const it of issues) {
            const c = it.closedAt
            if (c == null) continue
            const d = today - Math.floor(c / DAY)
            if (d >= 0 && d < 14) days[13 - d] = days[13 - d] + 1
            }
        return ({ days: days, peak: Math.max(1, ...days) })
        },
    countStatuses() -> object {
        const c = ({ open: 0, "in-progress": 0, blocked: 0, closed: 0 })
        for (const it of this.issuesOf()) (c as any)[it.status] = ((c as any)[it.status] ?? 0) + 1
        return c
        },

    shownTotal: number = { (app.shown.value.total ?? 0) },

    workload: Dataset [ contents = { app.workloadOf() } ],
    workloadOf() -> object {
        const m = new Map()
        let un = 0
        for (const it of this.issuesOf()) {
            if (("" + it.status) == "closed") continue
            const a = it.assignee
            if (a == null) un = un + 1
            else m.set(a, (m.get(a) ?? 0) + 1)
            }
        const top = [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6)
        const peak = Math.max(1, un, ...top.map((e) => e[1]))
        // peak rides ON EACH ROW (a row's cursor sees its own record, not
        // the root) — the view-model fact lands where the view reads it
        const rows = top.map((e) => ({ name: e[0], n: e[1], peak: peak }))
        return ({ rows: [...rows, ({ name: "", n: un, peak: peak })] })
        },

    // ── SEARCH — one more filter on the projection: the query NARROWS the
    //    list (typing hides the non-matches; clearing restores). Enter and
    //    the omnibox arrows walk the narrowed rows; Enter opens the walked
    //    row's detail. ────────────────────────────────────────────────────

    query: string = "",

    stepHit(d: number) {
        const rows = (this.shown.value.rows ?? [])
        if (rows.length == 0) return
        let j = this.selected != null ? rows.indexOf(this.selected) : (d > 0 ? -1 : rows.length)
        do { j = j + d } while (j >= 0 && j < rows.length && (rows[j] as any).kind == "hdr")
        if (j < 0 || j >= rows.length) return
        this.takeSelection([rows[j]])
        this.list.showRow(j)
        this.list.activeIndex = j
        this.list.active = rows[j]
        },

    enterHit() {
        if (this.selected == null) this.stepHit(1)
        if (this.selected != null) this.openDetail()
        },

    // ── SELECTION — held on the App, as RECORDS ───────────────────────────
    //
    // The Table's selection binds down to these slots, and every verb that
    // needs "what is selected" reads them here — so selection survives any
    // re-projection, because a record is the same record however the list
    // is currently arranged.

    selected: object = null,
    selection: array = null,

    takeSelection(sel: object) {
        const clean = sel == null ? null : (sel as any).filter((r) => r.kind != "hdr")
        selection = clean != null && (clean as any).length > 0 ? clean : null
        if (clean != null && (clean as any).length > 1) editing = false
        selected = selection != null ? (selection as any)[(selection as any).length - 1] : null
        if (selection == null) this.closeDetail()
        // The editor follows the selection: which issue is open is DERIVED from
        // it, so the draft has to move with it or the open row shows another
        // issue's fields. (It did, before this: only click/Enter reseeded, so
        // arrowing left the first issue's text in every row you opened after.)
        // NOTE — an in-flight edit is discarded here, and equally when you open
        // a different issue. That is a real gap, not a decision: the draft is
        // one slot, so there is nowhere to keep an edit you have navigated away
        // from. Fixing it means a draft PER ISSUE (or a dirty guard), which is
        // its own piece of work.
        else if (editing && (clean as any).length == 1) this.seedDraft()
        },

    selCount: number = { (selection ?? []).length },

    // ── THE DETAIL DRAFT — a working copy; Save commits, Cancel is honest ──

    draft: Dataset { { "it": null } },
    editing: boolean = false,
    creating: boolean = false,
    draftRev: number = 0,

    // Seed the working copy from the CURRENT record — a copy, so edits never
    // reach the truth until Save. Every path that changes which issue is open
    // goes through here, which is the whole point: the draft must follow the
    // expanded row or the editor shows one issue's fields inside another
    // issue's row. (It did. Arrow travel moved the selection and the expansion
    // followed, but only click/Enter reseeded, so walking the list left the
    // first issue's text sitting in every row you opened after it.)

    seedDraft() {
        if (selected == null) return
        draft.set(["it"], ({ ...(selected as any), labels: [...((selected as any).labels ?? [])] }))
        draftRev = draftRev + 1
        },

    openDetail() {
        if (selected == null || selCount != 1) return
        creating = false
        this.seedDraft()
        editing = true
        setTimeout(() => this.revealOpen(), 380)
        },

    newIssue() {
        this.takeSelection(null)
        creating = true
        const maxId = this.issuesOf().reduce((m, it) => Math.max(m, (it as any).id), 0)
        draft.set(["it"], ({ id: maxId + 1, title: "", description: "", status: "open", priority: "P2", labels: [], assignee: null, created: 1735689600000, updated: 1735689600000, comments: 0 }))
        draftRev = draftRev + 1
        editing = true
        setTimeout(() => Focus.focus(this.creator.card.col.titleF as any), 0)
        },

    closeDetail() { editing = false; creating = false },

    // best effort: once the card has sprung open, scroll so its full extent
    // sits inside the pane — top-aligned when it cannot all fit

    revealOpen() {
        const rows = (this.shown.value.rows ?? [])
        const idx = rows.findIndex((r) => ("" + (r as any).id) == ("" + this.expandedId))
        if (idx < 0) return
        const inst = this.list.children.find((c) => (c as any).isTableRow && (c as any).exp)
        if (inst == null) return
        const top = (inst as any).y
        const bottom = top + (inst as any).targetH
        const viewTop = this.list.scrollY
        const viewBottom = viewTop + this.list.height
        if (bottom > viewBottom) this.list.scrollTo(Math.min(top - 8, bottom - this.list.height + 8))
        else if (top < viewTop) this.list.scrollTo(top - 8)
        },

    draftDirty: boolean = { app.draftRev >= 0 && app.editing && app.draftDiffers(app.draftRev) },
    draftDiffers(dr: number) -> boolean {
        const d = draft.value.it
        if (d == null) return false
        if (creating) return true
        const t = this.issuesOf().find((it) => (it as any).id == (d as any).id)
        if (t == null) return true
        return (d as any).title != (t as any).title || (d as any).description != (t as any).description ||
            (d as any).status != (t as any).status || (d as any).priority != (t as any).priority ||
            (d as any).assignee != (t as any).assignee ||
            JSON.stringify((d as any).labels) != JSON.stringify((t as any).labels)
        },

    commitDraft() {
        const d = draft.value.it
        if (d == null) return
        if (creating) {
            const rec0 = ({ ...(d as any) })
            db.insert(["issues"], 0, rec0)
            const rec = this.issuesOf()[0]
            this.takeSelection([rec])
            creating = false
            editing = false
            return
            }
        const issues = this.issuesOf()
        const i = issues.findIndex((it) => (it as any).id == (d as any).id)
        if (i < 0) return
        db.set(["issues", i, "title"], (d as any).title)
        db.set(["issues", i, "description"], (d as any).description)
        db.set(["issues", i, "status"], (d as any).status)
        db.set(["issues", i, "priority"], (d as any).priority)
        db.set(["issues", i, "assignee"], (d as any).assignee)
        db.set(["issues", i, "labels"], [...((d as any).labels ?? [])])
        const up2 = ((d as any).updated ?? 0) + 1
        db.set(["issues", i, "updated"], up2)
        db.set(["issues", i, "closedAt"], ("" + (d as any).status) == "closed" ? up2 : null)
        editing = false
        },

    setDraftField(field: string, v: object) {
        draft.set(["it", field], v)
        draftRev = draftRev + 1
        },

    // ── MUTATION VERBS — every write to the truth lives here ──────────────
    //
    // Each verb writes `db` and keeps the derived display fields honest
    // (closedAt). That is all a verb does — there is nothing to notify, because
    // every projection already read `db`. Nothing else in the file mutates
    // data; everything else derives.

    // the people who actually hold work — the truth decides who is listed

    assignees() -> array {
        return [...new Set(this.issuesOf().map((it) => (it as any).assignee).filter((a) => a != null))].sort()
        },

    // No confirmation dialog: the undo toast is the safety net, and a modal
    // in front of it taxes every delete to save the rare one.

    deleteSelection() {
        if (selection == null) return
        this.performDelete()
        },

    performDelete() {
        const sel = selection ?? []
        const ids = (sel as any).map((r) => (r as any).id)
        const issues = this.issuesOf()
        const removed = []
        for (const id of ids) {
            const i = issues.findIndex((it) => (it as any).id == id)
            if (i >= 0) removed.push(({ index: i, rec: issues[i] }))
            }
        removed.sort((a, b) => (b as any).index - (a as any).index)
        for (const r of removed) db.removeAt(["issues"], (r as any).index)
        ;(this as any)._undo = removed
        this.takeSelection(null)
        this.toast.show((removed as any).length == 1 ? "Deleted 1 issue" : "Deleted " + (removed as any).length + " issues")
        },

    undoDelete() {
        const u = (this as any)._undo
        if (u == null) return
        const back = [...(u as any)].sort((a, b) => (a as any).index - (b as any).index)
        for (const r of back) db.insert(["issues"], Math.min((r as any).index, this.issuesOf().length), (r as any).rec)
        ;(this as any)._undo = null
        this.takeSelection((back as any).map((r) => (r as any).rec))
        this.toast.hide()
        },

    bulkSet(field: string, v: object) {
        const sel = selection ?? []
        const issues = this.issuesOf()
        for (const r of sel as any) {
            const i = issues.findIndex((it) => (it as any).id == (r as any).id)
            if (i < 0) continue
            if (field == "label") {
                const ls = [...(((issues[i] as any).labels) ?? [])]
                if (!ls.includes(v)) ls.push(v)
                db.set(["issues", i, "labels"], ls)
                } else {
                db.set(["issues", i, field], v)
                }
            const up = ((issues[i] as any).updated ?? 0) + 1
            db.set(["issues", i, "updated"], up)
            if (field == "status") db.set(["issues", i, "closedAt"], v == "closed" ? up : null)
            }
        },

    // ── the shared MENUS (one instance each — the record-driven door) ──────

    facetMenu: Menu [ width = 190 ],

    openFacet(anchor: View, field: string) {
        const cur = draft.value.it != null ? (draft.value.it as any)[field] : null
        const m = this.facetMenu as any
        if (field == "assignee") {
            m.items = [({ id: "null", label: "Unassigned", checked: cur == null }), ({ id: "d", divider: true }),
                ...this.assignees().map((p) => ({ id: p, label: p, icon: "PersonIcon", props: ({ name: p }), checked: cur == p }))]
            }
        else {
            const opts = field == "status" ? ["open", "in-progress", "blocked", "closed"] : ["P0", "P1", "P2", "P3"]
            m.items = opts.map((o) => ({ id: "" + o,
                label: field == "status" ? trkStatusLabel("" + o) : "" + o,
                checked: cur == o }))
            }
        m.picked = (id) => app.setDraftField(field, id == "null" ? null : id)
        m.openFor(anchor)
        },

    addLabelMenu: Menu [ width = 190 ],

    openAddLabel(anchor: View) {
        const have = draft.value.it != null ? ((draft.value.it as any).labels ?? []) : []
        const m = this.addLabelMenu as any
        m.items = TRK_LABELS.filter((l) => !have.includes(l)).map((l) => ({ id: l, label: l }))
        m.picked = (id) => {
            const ls = [...(((draft.value.it as any).labels) ?? [])]
            ls.push(id)
            app.setDraftField("labels", ls)
            }
        m.openFor(anchor)
        },

    bulkMenu: Menu [ width = 210 ],

    openBulk(anchor: View) {
        const m = this.bulkMenu as any
        m.items = [
            ({ id: "s:open", label: "Set open" }),
            ({ id: "s:in-progress", label: "Set in-progress" }),
            ({ id: "s:blocked", label: "Set blocked" }),
            ({ id: "s:closed", label: "Set closed" }),
            ({ divider: true }),
            ...TRK_LABELS.slice(0, 8).map((l) => ({ id: "l:" + l, label: "Label: " + l })),
            ({ divider: true }),
            ({ id: "delete", label: "Delete…" }),
        ]
        m.picked = (id) => {
            if (id.startsWith("s:")) app.bulkSet("status", id.slice(2))
            else if (id.startsWith("l:")) app.bulkSet("label", id.slice(2))
            else if (id == "delete") app.deleteSelection()
            }
        m.openFor(anchor)
        },

    ctx: ContextMenu [
        items = { [
            ({ id: "s:open", label: "Set open" }),
            ({ id: "s:in-progress", label: "Set in-progress" }),
            ({ id: "s:blocked", label: "Set blocked" }),
            ({ id: "s:closed", label: "Set closed" }),
            ({ divider: true }),
            ({ id: "delete", label: "Delete…" }),
        ] } ],

    rowMenu(row: View, e: PointerEvent) {
        const rec = (row as TableRow).member()
        if (selection == null || !(selection as any).some((r) => (r as any).id == (rec as any).id)) this.takeSelection([rec])
        const m = this.ctx as any
        m.picked = (id) => {
            if (id.startsWith("s:")) app.bulkSet("status", id.slice(2))
            else if (id == "delete") app.deleteSelection()
            }
        m.open(row, e)
        },

    sortMenu: Menu [ width = 190 ],

    openSort(anchor: View) {
        const m = this.sortMenu as any
        m.items = [
            ({ id: "updated", label: "Updated", checked: app.sortOn == "updated" }),
            ({ id: "priority", label: "Priority", checked: app.sortOn == "priority" }),
            ({ id: "title", label: "Title", checked: app.sortOn == "title" }),
        ]
        m.picked = (id) => app.setSort(id)
        m.openFor(anchor)
        },

    gaugeMenu: Menu [ width = 230 ],

    openGauge(anchor: View) {
        const n = this.issuesOf().length
        const m = this.gaugeMenu as any
        m.items = [
            ({ id: "10000", label: "10,000 issues", checked: n == 10000 }),
            ({ id: "100000", label: "100,000 issues", checked: n == 100000 }),
            ({ id: "1000000", label: "1,000,000 issues", checked: n == 1000000 }),
        ]
        m.picked = (id) => app.regenerate(parseInt(id))
        m.openFor(anchor)
        },

    appearanceMenu: Menu [ width = 190,
        items = { [
            ({ id: "light", label: "Light", icon: "SunIcon", checked: app.themeMode == "light" }),
            ({ id: "auto", label: "System", icon: "AutoIcon", checked: app.themeMode == "auto" }),
            ({ id: "dark", label: "Dark", icon: "MoonIcon", checked: app.themeMode == "dark" }),
        ] },
        picked(id: string) { app.themeMode = id }
        ],

    dlg: Dialog [ ],

    // ⌘K claims the omnibox from anywhere; Escape backs out by layers

    keys: Keys [
        onKeyDown(e: KeyEvent) {
            // ⌘K or "/" reach the search field from anywhere — but "/" is a
            // character, so it only counts when nothing is taking text
            if ((e.meta || e.ctrl) && e.code == "KeyK") { Focus.focus(app.bar.omni as any) }
            // Escape unwinds the INNERMOST layer first: the open editor, then
            // a selection, then the query, then the facet filters. Anything
            // else and a keystroke meant for the thing in front of you lands
            // on something behind it.
            else if (e.key == "Escape") {
                if (app.editing) app.closeDetail()
                else if (app.selCount > 0) app.takeSelection(null)
                else if (app.query != "") { app.query = ""; app.bar.omni.text = ""; app.rearranged() }
                else if (app.fStatus != "" || app.fAssignee != "" || app.fLabel != "") app.clearAll()
                }
            },

        // "/" moves focus on key UP, not down: a printable shortcut handled on
        // the way down would still be delivered as text to the field it just
        // focused, and the search box would open holding a stray "/".

        onKeyUp(e: KeyEvent) {
            if (e.key == "/" && !app.typing()) Focus.focus(app.bar.omni as any)
            }
        ],

    // ── THE BAR — brand · search · scale · appearance ─────────────────────

    bar: View [ x = 0, y = 0, width = { app.width }, height = { app.barH }, fill = { theme.surface },
        hair: View [ x = 0, y = { app.barH - 1 }, width = { parent.width }, height = 1, fill = { theme.line } ],

        brand: View [ x = 24, y = 17, height = 22,
            layout: SimpleLayout [ axis = x, spacing = 5 ],
            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                textFill = { gradient("90deg", theme.accent, trkTeal()) }, text = "Declare",
                onClick() { app.navigate("apps/homepage/homepage.declare") }
                ],
            Text [ fontSize = 18, fontWeight = semibold, letterSpacing = { -0.02 * fontSize }, wrap = false,
                visible = { !app.compact }, text = "Tracker" ]
            ],

        // the omnibox: search-as-you-type over the data; Enter jumps to the
        // first hit, arrows cycle, the count keeps score

        omni: TextInput [ y = 12, height = 32,
            x = { app.compact ? 96 : 210 },
            width = { Math.min(380, Math.max(110, parent.views.x - this.x - 16)) },
            placeholder = { app.compact ? "Search" : "Search issues…   ⌘K" },
            onInput(t: string) { app.query = "" + t; app.rearranged() },
            onEnter() { app.enterHit() },
            onKeyDown(e: KeyEvent) {
                if (e.key == "ArrowDown") app.stepHit(1)
                else if (e.key == "ArrowUp") app.stepHit(-1)
                }
            ],

        hitCount: Text [ y = center, fontSize = 11, wrap = false, visible = { app.query != "" },
            x = { parent.omni.x + parent.omni.width - this.width - 10 },
            textColor = { theme.textFaint },
            text = { app.shownTotal + " match" + (app.shownTotal == 1 ? "" : "es") } ],

        views: Segmented [ y = 12,
            x = { app.width - this.width - 100 },
            segMin = 62,
            value = { app.issuesOf().length >= 1000000 ? "1M" : app.issuesOf().length >= 100000 ? "100k" : "10k" },
            input(v: object) { app.regenerate(("" + v) == "1M" ? 1000000 : ("" + v) == "100k" ? 100000 : 10000) },
            choices = { [ ({ id: "10k", label: "10K" }), ({ id: "100k", label: "100K" }), ({ id: "1M", label: "1M" }) ] }
            ],

        appear: Control [ y = 12, height = 32, width = 54, cornerRadius = 8, tip = "Appearance",
            x = { app.width - this.width - 14 },
            fill = { hot || down ? theme.control : null },
            stroke = { stroke(1, theme.line) },
            g: IconHost [ x = 9, y = center, iconSize = 15,
                kind = { app.themeMode == "light" ? "SunIcon" : app.themeMode == "dark" ? "MoonIcon" : "AutoIcon" } ],
            arrow: ChevronIcon [ iconSize = 12, ink = { theme.textMuted },
                x = { parent.width - 18 }, y = { (parent.height - this.height) / 2 } ],
            press() { app.appearanceMenu.openFor(this) },
            onClick() { if (!disabled) press() }
            ]
        ],

    // ── the TOOLBAR: filters on the left, actions on the right ────────────

    // The tools row wraps into two — chips (countless), then acts — instead of
    // letting the clusters collide in the middle. It wraps when they WOULD
    // collide, which is a measurement, not a breakpoint: the left group's
    // content, the right group's content, and the margins between and around
    // them. A fixed width cannot know this, because both groups size to their
    // own text — a long assignee name or a wider locale moves the meeting point
    // without moving the window.

    tools: View [ x = 0, y = { app.barH }, width = { app.width },
        wrap: boolean = { app.compact
            || this.chips.contentWidth + this.acts.contentWidth + 64 > app.width },
        height = { this.wrap ? 96 : 56 }, fill = { theme.bg },
        hairB: View [ x = 0, y = { parent.height - 1 }, width = { parent.width }, height = 1, fill = { theme.line } ],

        // wrapped, the strip keeps every filter reachable by scrolling sideways
        // (the phone chip-row idiom) instead of spilling off-screen

        chips: View [ x = 24, y = 14, height = 28,
            width = { parent.wrap ? app.width - 32 : this.contentWidth },
            scrolls = { parent.wrap ? "x" : "none" }, clip = true,
            layout: SimpleLayout [ axis = x, spacing = 8 ],
            Chip [ facet = "status", value = "open", count = { (app.counts as any).open ?? 0 }, on = { app.fStatus == "open" } ],
            Chip [ facet = "status", value = "in-progress", count = { (app.counts as any)["in-progress"] ?? 0 }, on = { app.fStatus == "in-progress" } ],
            Chip [ facet = "status", value = "blocked", count = { (app.counts as any).blocked ?? 0 }, on = { app.fStatus == "blocked" } ],
            Chip [ facet = "status", value = "closed", count = { (app.counts as any).closed ?? 0 }, on = { app.fStatus == "closed" } ],
            gap1: View [ width = 6, height = 1 ],
            assigneeBtn: Control [ height = 28, cornerRadius = 8,
                width = { this.t.width + 36 },   // 26 as before, plus the mark that left the label string
                fill = { app.fAssignee != "" ? theme.controlSelected : hot ? theme.control : null },
                t: Text [ x = 13, y = center, fontSize = 12.5, wrap = false,
                    fontWeight = { app.fAssignee != "" ? "semibold" : "normal" },
                    textColor = { app.fAssignee != "" ? theme.text : theme.textMuted },
                    text = { app.fAssignee != "" ? "@" + app.fAssignee : "Assignee" } ],
                c: ChevronIcon [ iconSize = 11, ink = { theme.textMuted }, y = center, x = { parent.width - 15 } ],
                press() { app.openAssigneeFilter(this) },
                onClick() { if (!disabled) press() }
                ],
            labelBtn: Control [ height = 28, cornerRadius = 8,
                width = { this.t.width + 36 },   // 26 as before, plus the mark that left the label string
                fill = { app.fLabel != "" ? theme.controlSelected : hot ? theme.control : null },
                t: TextLabel [ x = 13, fontSize = 12.5, wrap = false,
                    fontWeight = { app.fLabel != "" ? "semibold" : "normal" },
                    textColor = { app.fLabel != "" ? theme.text : theme.textMuted },
                    text = { app.fLabel != "" ? app.fLabel : "Label" } ],
                c: ChevronIcon [ iconSize = 11, ink = { theme.textMuted }, y = center, x = { parent.width - 15 } ],
                press() { app.openLabelFilter(this) },
                onClick() { if (!disabled) press() }
                ]
            ],

        acts: View [ height = 30,
            y = { parent.wrap ? 54 : 13 },
            x = { parent.wrap ? 16 : app.width - this.contentWidth - 24 },
            layout: SimpleLayout [ axis = x, spacing = 4 ],
            groupCheck: Checkbox [ y = 3, height = 24, size = 15, fontSize = 12.5, x = 0,
                label = "Grouped",
                textColor = { theme.textMuted },
                checked = { app.groupBy == "status" },
                input(v: object) { app.groupBy = v ? "status" : "none"; app.rearranged() }
                ],
            gapSort: View [ width = 8, height = 1 ],
            sortBtn: Control [ height = 28, cornerRadius = 8, y = 1,
                width = { this.t.width + 36 },   // 26 as before, plus the mark that left the label string
                fill = { hot ? theme.control : null },
                t: Text [ x = 13, y = center, fontSize = 12.5, wrap = false, textColor = { theme.textMuted },
                    text = { "Sort: " + app.sortOn.charAt(0).toUpperCase() + app.sortOn.slice(1) } ],
                c: ChevronIcon [ iconSize = 11, ink = { theme.textMuted }, y = center, x = { parent.width - 15 } ],
                press() { app.openSort(this) },
                onClick() { if (!disabled) press() }
                ],
            dirBtn: Control [ height = 28, width = 28, cornerRadius = 8, y = 1, tip = "Toggle sort direction",
                fill = { hot || down ? theme.control : null },
                t: ArrowIcon [ iconSize = 13, ink = { theme.textMuted },
                    x = { (parent.width - this.width) / 2 }, y = { (parent.height - this.height) / 2 },
                    dir = { app.sortDir == "desc" ? "down" : "up" } ],
                press() { app.toggleSortDir() },
                onClick() { if (!disabled) press() }
                ],
            gapNew: View [ width = 16, height = 1 ],
            newBtn: Control [ height = 30, cornerRadius = 8,
                pressedFill: number = 0x3557C7,      // the accent, one step deeper
                width = { this.t.width + 30 },
                fill = { hot || down ? this.pressedFill : theme.accent },
                shadow = { shadow(0, 1, 3, 0x00000030) },
                t: Text [ x = 15, y = center, fontSize = 12.5, fontWeight = semibold, wrap = false,
                    textColor = { theme.accentText }, text = "New issue" ],
                press() { app.newIssue() },
                onClick() { if (!disabled) press() }
                ]
            ]
        ],

    openAssigneeFilter(anchor: View) {
        const m = this.facetMenu as any
        const names = this.assignees()
        m.items = [({ id: "", label: "Anyone", checked: app.fAssignee == "" }), ({ id: "d", divider: true }),
            ...names.map((p) => ({ id: p, label: p, icon: "PersonIcon", props: ({ name: p }), checked: app.fAssignee == p }))]
        m.picked = (id) => { app.fAssignee = id; app.rearranged() }
        m.openFor(anchor)
        },

    openLabelFilter(anchor: View) {
        const m = this.facetMenu as any
        m.items = [({ id: "", label: "any label", checked: app.fLabel == "" }),
            ...TRK_LABELS.map((l) => ({ id: l, label: l, checked: app.fLabel == l }))]
        m.picked = (id) => { app.fLabel = id; app.rearranged() }
        m.openFor(anchor)
        },

    // ── THE LIST — a windowed Table over the projection ───────────────────
    //
    // `virtualize = true` is the whole virtualization story: the runtime
    // windows, recycles, and measures rows (including one springing open
    // into the editor card) with no further instruction from this file.

    contentY: number = { app.barH + app.tools.height },
    mainW: number = { Math.min(app.width - (app.railOn ? app.railW : 0), 1460) },

    // which row is OPEN IN PLACE: an issue edits where it lives — the
    // row's height springs open and the kernel's measured ladder carries
    // the animation through the windowed list

    expandedId: number = { app.editing && !app.creating && app.selCount == 1 && app.selected != null ? ((app.selected as any).id ?? -1) : -1 },

    // THE LIST. Rows over the projection; every hard thing about scale is
    // someone else's honest work. The empty state says why it is empty.

    creatorH: number = { app.creating ? 356 : 0 },

    list: Table [ x = 0,
        y = { app.contentY + app.creatorH },
        width = { app.mainW },
        height = { app.height - app.contentY - app.creatorH - 32 },
        datapath = { app.shown.value },
        selects = "multi",
        selected = { app.selected },
        selection = { app.selection },
        input(sel: object) { app.takeSelection(sel) },
        deleteRequested() { app.deleteSelection() },
        activateRequested() { app.openDetail() },
        IssueRow [ datapath = :rows[], virtualize = true ]
        ],

    // ── THE RAIL: an instrument, not a sidebar. Every number below is a
    //    live derivation off the one truth; every row is also a filter. ─────

    rail: View [ visible = { app.railOn }, clip = true,
        x = { app.width - app.railW },
        y = { app.contentY },
        width = { app.railW },
        height = { app.height - app.contentY - 32 },
        scrolls = y,
        edge: View [ x = 0, y = 0, width = 1, height = { Math.max(parent.height, parent.contentHeight) }, fill = { theme.line } ],

        col: View [ x = 20, y = 20, width = { parent.width - 40 },
            layout: SimpleLayout [ axis = y, spacing = 22 ],

            hero: View [ width = { parent.width }, height = 66,
                n: Roll [ x = 0, y = 0, fontSize = 38, fontWeight = bold, letterSpacing = -1,
                    textFill = { gradient("90deg", theme.accent, trkTeal()) },
                    n = { app.shownTotal } ],
                cap: Text [ x = 2, y = 48, fontSize = 11.5, wrap = false, textColor = { theme.textFaint },
                    text = { app.shownTotal == app.issuesOf().length
                        ? "issues · nothing filtered out"
                        : "matching · of " + app.issuesOf().length.toLocaleString() + " issues" } ]
                ],

            byStatus: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 2 ],
                cap: Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 0.6, wrap = false,
                    textColor = { theme.textFaint }, text = "BY STATUS" ],
                gap: View [ width = 1, height = 6 ],
                dist: View [ width = { parent.width }, height = 6, cornerRadius = 3, clip = true,
                    s1: View [ x = 0, y = 0, height = 6, fill = { trkStatusColor("open") },
                        width = { parent.width * ((app.counts as any).open ?? 0) / Math.max(1, app.issuesOf().length) } ],
                    s2: View [ y = 0, height = 6, fill = { trkStatusColor("in-progress") },
                        x = { this.parent.s1.width },
                        width = { parent.width * ((app.counts as any)["in-progress"] ?? 0) / Math.max(1, app.issuesOf().length) } ],
                    s3: View [ y = 0, height = 6, fill = { trkStatusColor("blocked") },
                        x = { this.parent.s2.x + this.parent.s2.width },
                        width = { parent.width * ((app.counts as any).blocked ?? 0) / Math.max(1, app.issuesOf().length) } ],
                    s4: View [ y = 0, height = 6, fill = { trkStatusColor("closed") },
                        x = { this.parent.s3.x + this.parent.s3.width },
                        width = { Math.max(0, parent.width - this.parent.s3.x - this.parent.s3.width) } ]
                    ],
                gap2: View [ width = 1, height = 8 ],
                r1: RailStat [ width = { parent.width }, facet = "status", value = "open", cap = "Open",
                    n = { (app.counts as any).open ?? 0 }, peak = { app.issuesOf().length }, tint = { trkStatusColor("open") },
                    on = { app.fStatus == "open" },
                    ic: StatusIcon [ x = 8, y = 8, s = "open" ]
                    ],
                r2: RailStat [ width = { parent.width }, facet = "status", value = "in-progress", cap = "In Progress",
                    n = { (app.counts as any)["in-progress"] ?? 0 }, peak = { app.issuesOf().length }, tint = { trkStatusColor("in-progress") },
                    on = { app.fStatus == "in-progress" },
                    ic: StatusIcon [ x = 8, y = 8, s = "in-progress" ]
                    ],
                r3: RailStat [ width = { parent.width }, facet = "status", value = "blocked", cap = "Blocked",
                    n = { (app.counts as any).blocked ?? 0 }, peak = { app.issuesOf().length }, tint = { trkStatusColor("blocked") },
                    on = { app.fStatus == "blocked" },
                    ic: StatusIcon [ x = 8, y = 8, s = "blocked" ]
                    ],
                r4: RailStat [ width = { parent.width }, facet = "status", value = "closed", cap = "Closed",
                    n = { (app.counts as any).closed ?? 0 }, peak = { app.issuesOf().length }, tint = { trkStatusColor("closed") },
                    on = { app.fStatus == "closed" },
                    ic: StatusIcon [ x = 8, y = 8, s = "closed" ]
                    ]
                ],

            work: View [ width = { parent.width },
                datapath = { app.workload.value },
                layout: SimpleLayout [ axis = y, spacing = 2 ],
                cap: Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 0.6, wrap = false,
                    textColor = { theme.textFaint }, text = "WORKLOAD · OPEN WORK" ],
                gap: View [ width = 1, height = 6 ],
                RailStat [ datapath = :rows[], width = { parent.width },
                    facet = "assignee",
                    value = { "" + (:name ?? "") },
                    cap = { ("" + (:name ?? "")) == "" ? "Unassigned" : "" + :name },
                    n = { (:n ?? 0) + 0 },
                    peak = { (:peak ?? 1) + 0 },
                    hueName = { "" + (:name ?? "") },
                    on = { app.fAssignee != "" && app.fAssignee == ("" + (:name ?? "")) },
                    av: Avatar [ x = 4, y = 4, width = 20, height = 20, cornerRadius = 10, name = { "" + (:name ?? "") } ]
                    ]
                ],

            closed14: View [ width = { parent.width },
                datapath = { app.closedSeries.value },
                cap: Text [ x = 0, y = 0, fontSize = 11, fontWeight = semibold, letterSpacing = 0.6, wrap = false,
                    textColor = { theme.textFaint }, text = "CLOSED · LAST 14 DAYS" ],
                bars: View [ x = 0, y = 22, width = { parent.width }, height = 40,
                    pk: number = { Math.max(1, (:peak ?? 1) + 0) },
                    layout: SimpleLayout [ axis = x, spacing = 3 ],
                    View [ datapath = :days[], width = { (this.parent.width - 39) / 14 },
                        height = 40,
                        b: View [ x = 0, cornerRadius = 1.5,
                            width = { parent.width },
                            y = { 40 - Math.max(2, 38 * ((this.$data("") as any) + 0) / this.parent.parent.pk) },
                            height = { Math.max(2, 38 * ((this.$data("") as any) + 0) / this.parent.parent.pk) },
                            fill = { trkStatusColor("closed") } ]
                        ]
                    ]
                ],

            perf: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 8 ],
                cap: Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 0.6, wrap = false,
                    textColor = { theme.textFaint }, text = "PERFORMANCE" ],
                l1: View [ width = { parent.width }, height = 16,
                    a: Text [ x = 0, y = 0, fontSize = 11.5, wrap = false, textColor = { theme.textMuted }, text = "Initial load" ],
                    b: Text [ y = 0, fontSize = 11.5, wrap = false, textAlign = right, width = 70, x = { parent.width - 70 },
                        textColor = { theme.text }, text = { app.loadMs + " ms" } ]
                    ],
                l2: View [ width = { parent.width }, height = 16,
                    a: Text [ x = 0, y = 0, fontSize = 11.5, wrap = false, textColor = { theme.textMuted }, text = "Ingest" ],
                    b: Text [ y = 0, fontSize = 11.5, wrap = false, textAlign = right, width = 70, x = { parent.width - 70 },
                        textColor = { theme.text }, text = { app.adoptMs + " ms" } ]
                    ],
                l3: View [ width = { parent.width }, height = 16, visible = { app.query != "" },
                    a: Text [ x = 0, y = 0, fontSize = 11.5, wrap = false, textColor = { theme.textMuted }, text = "Last search" ],
                    b: Text [ y = 0, fontSize = 11.5, wrap = false, textAlign = right, width = 70, x = { parent.width - 70 },
                        textColor = { theme.text }, text = { (app.shown.value.searchMs ?? 0) + " ms" } ]
                    ]
                ],

            keys: View [ width = { parent.width },
                layout: SimpleLayout [ axis = y, spacing = 6 ],
                cap: Text [ fontSize = 11, fontWeight = semibold, letterSpacing = 0.6, wrap = false,
                    textColor = { theme.textFaint }, text = "KEYBOARD" ],
                k1: View [ width = { parent.width }, height = 18,
                    k: Text [ x = 0, y = 1, fontSize = 10.5, textColor = { theme.textMuted }, text = "⌘K" ],
                    v: Text [ x = 44, y = 1, fontSize = 11.5, wrap = false, textColor = { theme.textFaint }, text = "Search" ]
                    ],
                k2: View [ width = { parent.width }, height = 18,
                    k: Text [ x = 0, y = 1, fontSize = 10.5, textColor = { theme.textMuted }, text = "↵" ],
                    v: Text [ x = 44, y = 1, fontSize = 11.5, wrap = false, textColor = { theme.textFaint }, text = "Open selected row" ]
                    ],
                k3: View [ width = { parent.width }, height = 18,
                    k: Text [ x = 0, y = 1, fontSize = 10.5, textColor = { theme.textMuted }, text = "⌫" ],
                    v: Text [ x = 44, y = 1, fontSize = 11.5, wrap = false, textColor = { theme.textFaint }, text = "Delete selection" ]
                    ],
                k4: View [ width = { parent.width }, height = 18,
                    k: Text [ x = 0, y = 1, fontSize = 10.5, textColor = { theme.textMuted }, text = "esc" ],
                    v: Text [ x = 44, y = 1, fontSize = 11.5, wrap = false, textColor = { theme.textFaint }, text = "Close · clear" ]
                    ],
                tail: View [ width = 1, height = 8 ]
                ]
            ]
        ],

    creator: View [ visible = { app.creating }, x = 24, clip = true,
        y = { app.contentY + 8 },
        width = { app.mainW - 48 },
        height = 340,
        fill = { theme.surface }, cornerRadius = 10,
        stroke = { stroke(1, theme.line) },
        shadow = { shadow(0, 4, 16, 0x00000018) },
        card: EditorCard [ x = 0, y = 0, width = { parent.width } ]
        ],

    // ── the FOOTER — the quiet ledger line: how many, how many shown ──────

    foot: View [ x = 0, width = { app.width }, height = 32,
        y = { app.height - 32 },
        fill = { theme.surface },
        hair: View [ x = 0, y = 0, width = { parent.width }, height = 1, fill = { theme.line } ],
        stats: Text [ x = 24, y = center, fontSize = 11.5, wrap = false, textColor = { theme.textFaint },
            text = { app.issuesOf().length.toLocaleString() + " issues   ·   " + app.shownTotal.toLocaleString() + " shown" } ],
        perf: Text [ y = center, fontSize = 10.5, wrap = false, visible = { app.booted && !app.railOn },
            x = { app.width - this.width - 16 },
            textColor = { theme.textFaint },
            text = { "load " + app.loadMs + " ms · adopt " + app.adoptMs + " ms" } ]
        ],

    empty: View [ visible = { app.booted && app.shownTotal == 0 }, width = 280,
        x = { (app.mainW - 280) / 2 },
        pop: number = 0,
        Spring [ attribute = pop, to = { app.booted && app.shownTotal == 0 ? 1 : 0 }, stiffness = 220, damping = 26 ],
        opacity = { this.pop },
        y = { app.contentY + 120 + (1 - this.pop) * 14 },
        layout: SimpleLayout [ axis = y, spacing = 12 ],
        ring: View [ x = 122, width = 36, height = 36, cornerRadius = 18,
            stroke = { stroke(2, theme.line) },
            g: Text [ x = 0, y = center, width = 36, textAlign = center, fontSize = 15, textColor = { theme.textFaint }, text = "?" ]
            ],
        cap: Text [ width = 280, textAlign = center, fontSize = 14.5, fontWeight = semibold,
            text = { app.issuesOf().length == 0 ? "No issues yet" : "No issues match" } ],
        sub: Text [ width = 280, textAlign = center, fontSize = 12.5, textColor = { theme.textMuted },
            text = { app.issuesOf().length == 0
                ? "Create the first one — N is waiting."
                : "Try a different search, or clear the filters." } ],
        clear: Control [ x = 90, height = 30, cornerRadius = 8, width = 100,
            visible = { app.issuesOf().length > 0 },
            fill = { hot || down ? theme.control : null },
            stroke = { stroke(1, theme.line) },
            t: TextLabel [ x = 0, width = 100, textAlign = center, fontSize = 12.5, textColor = { theme.textMuted }, text = "Clear all" ],
            press() { app.clearAll() },
            onClick() { if (!disabled) press() }
            ]
        ],

    bulk: View [ height = 44, cornerRadius = 12,
        visible = { app.selCount > 1 || this.lift > 0.02 },

        // the bar inverts to the tooltip surface; its interior inks are its
        // own facts, named here where they are used

        inkLine: number = 0x666B72,      // dividers on the dark surface
        inkHover: number = 0x3A4048,     // button hover wash
        inkDanger: number = 0xFF9D9D,    // destructive label at rest
        lift: number = 0,
        Spring [ attribute = lift, to = { app.selCount > 1 ? 1 : 0 }, stiffness = 260, damping = 26 ],
        opacity = { lift },
        width = { this.row.contentWidth + 32 },
        x = { (app.mainW - this.width) / 2 },
        y = { app.height - 92 + (1 - this.lift) * 20 },
        fill = { theme.tooltipBg },
        shadow = { shadow(0, 8, 28, 0x00000050) },
        row: View [ x = 16, y = 8, height = 28,
            layout: SimpleLayout [ axis = x, spacing = 14 ],
            cnt: View [ height = 28, width = { this.t.width + this.l.width + 6 },
                t: Roll [ x = 0, y = center, fontSize = 13, fontWeight = semibold,
                    textColor = { theme.tooltipText }, n = { app.selCount } ],
                l: Text [ y = center, fontSize = 13, wrap = false, x = { this.parent.t.width + 6 },
                    textColor = { theme.tooltipText }, text = "selected" ]
                ],
            div1: View [ width = 1, height = 20, y = 4, fill = { app.bulk.inkLine } ],
            act: Control [ height = 28, cornerRadius = 7, width = { this.t.width + 20 },
                fill = { hot ? app.bulk.inkHover : null },
                t: Text [ x = 10, y = center, fontSize = 12.5, wrap = false,
                    textColor = { theme.tooltipText }, text = "Set status ▾" ],
                press() { app.openBulk(this) },
                onClick() { if (!disabled) press() }
                ],
            del: Control [ height = 28, cornerRadius = 7, width = { this.t.width + 20 },
                fill = { hot || down ? trkRed() : null },
                t: TextLabel [ x = 10, fontSize = 12.5, fontWeight = semibold, wrap = false,
                    textColor = { this.parent.hot || this.parent.down ? trkWhite() : app.bulk.inkDanger }, text = "Delete…" ],
                press() { app.deleteSelection() },
                onClick() { if (!disabled) press() }
                ],
            div2: View [ width = 1, height = 20, y = 4, fill = { app.bulk.inkLine } ],
            clr: Control [ height = 28, cornerRadius = 7, width = 28,
                fill = { hot ? app.bulk.inkHover : null },
                t: Text [ x = 0, y = center, width = 28, textAlign = center, fontSize = 13,
                    textColor = { theme.tooltipText }, text = "×" ],
                press() { app.takeSelection(null) },
                onClick() { if (!disabled) press() }
                ]
            ]
        ],

    toast: Toast [ x = { (app.width - this.width) / 2 },
        y = { app.height - 84 + (1 - this.lift) * 20 } ],

    // the ENTRY SCREEN — honest states for the one fetch

    entry: View [ visible = { !app.booted }, x = 0, y = 0, width = { app.width }, height = { app.height },
        fill = { theme.bg },
        col: View [ x = { (app.width - 220) / 2 }, y = { app.height * 0.38 }, width = 220,
            layout: SimpleLayout [ axis = y, spacing = 10 ],
            Text [ fontSize = 22, fontWeight = semibold, textAlign = center, width = 220,
                textFill = { gradient("90deg", theme.accent, 0x37B6A9) }, text = "Tracker" ],
            Text [ fontSize = 12.5, textAlign = center, width = 220, textColor = { theme.textMuted },
                text = { app.src.failed ? "Could not load issues.json" : "Loading issues…" } ]
            ]
        ]
    ]
