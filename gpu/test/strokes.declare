// render=gpu stroke check: an icon drawn large, and caps and joins side by side.

App [ fill = white,
    SunIcon [ x = 20, y = 20, width = 160, ink = #445566, weight = 12 ],
    View [ x = 220, y = 20, width = 300, height = 160,
        draw(d: DrawContext) {
            d.lineWidth = 16
            d.strokeStyle = "#cc3344"
            d.lineCap = "butt";   d.beginPath(); d.moveTo(20, 30);  d.lineTo(120, 30);  d.stroke()
            d.lineCap = "round";  d.beginPath(); d.moveTo(20, 80);  d.lineTo(120, 80);  d.stroke()
            d.lineCap = "square"; d.beginPath(); d.moveTo(20, 130); d.lineTo(120, 130); d.stroke()
            d.lineJoin = "round"; d.beginPath(); d.moveTo(170, 140); d.lineTo(220, 30); d.lineTo(270, 140); d.stroke()
            }
        ]
    ]
